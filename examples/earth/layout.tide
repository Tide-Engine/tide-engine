// Made by tools/towns.mjs: where each town is, and its buildings. Run it again
// rather than editing this.

// Straight up at a town's middle, from the planet's center
float3 Up(int town)
{
    switch (town)
    {
        case 0: return float3(0.173183739, 0.743144810, -0.646330535);
        case 1: return float3(-0.459212482, 0.207911685, -0.863653064);
        case 2: return float3(0.414518774, -0.469471574, -0.779596448);
        case 3: return float3(0.609669924, 0.788010776, 0.0856835172);
        case 4: return float3(0.847531497, 0.0348994955, 0.529596448);
        case 5: return float3(0.527282119, -0.615661502, 0.585606098);
        case 6: return float3(-0.0275011789, 0.615661502, 0.787530720);
        case 7: return float3(-0.739073813, 0.104528464, 0.665465057);
        case 8: return float3(-0.457525641, -0.669130623, 0.585606098);
        case 9: return float3(-0.392877430, 0.913545430, 0.105271190);
    }
    return float3(0, 1, 0);
}

