// The planet, worked out for every pixel: what a pixel's ray from the eye
// meets, the ground (meadows, forests, the roads, the towns' squares and ring
// roads) or the air beside it or space. Everything is drawn around an eye at
// the origin, with the world moved the other way.

// Where the towns and the roads are, for the frag (Look fills it once)
local singleton Atlas
{
    float3[10] towns;
    float3[10] easts;
    float3[10] norths;
    float3[11] froms;
    float3[11] tos;
    bool made;
}

// A ball around the eye: each pixel of it is a ray
struct Around
{
    float3 position;
}

// What the planet's frag needs of this frame
struct Sky
{
    float3 center;  // From the eye to the planet's center
    float height;   // The eye's height above the ground
    float3 sun;     // Towards the sun
    float pixel;    // Radians across a pixel
}

// A corner of a shape, with which way it faces
struct Corner
{
    float3 position;
    float3 normal;
}

// One of a shape: where, and its color
struct Placed
{
    float4x4 transform;
    Color paint;
}

const float AIR = 260;   // How thick the glow of the air looks

Color Mix(Color a, Color b, float t)
{
    return Color(Math.Lerp(a.r, b.r, t), Math.Lerp(a.g, b.g, t), Math.Lerp(a.b, b.b, t), 1);
}

// Integrate the thin stripe over a pixel, then lose unresolved dashes gradually.
float Marking(float across, float along, float wide)
{
    float soft = Math.Max(wide, 0.05);
    float stripe = Math.Saturate((0.12 + soft * 0.5 - across) / soft);
    float dash = Math.SmoothStep(0.25 - soft * 0.4, 0.25 + soft * 0.4, Math.Sin(along * 0.8));
    return stripe * dash * (1 - Math.SmoothStep(0.4, 1.6, wide));
}

// All geometry uses the same spherical surface as Planet, including at the
// horizon. A sunken polygonal depth mesh left bases visible through the ground.
bool Underground(float3 point, Sky sky)
{
    float distance = Math.Length(point);
    var ray = point / Math.Max(distance, 0.0001);
    float b = Math.Dot(ray, sky.center);
    float near = sky.height * (2 * R + sky.height);
    float disc = b * b - near;
    return b > 0 && disc > 0 && near / (b + Math.Sqrt(Math.Max(disc, 0))) < distance - 0.02;
}

float Grain(float3 n, float wide)
{
    float fine = Math.Saturate(1 - wide / 3);
    // An octave whose coverage is zero contributes nothing. Keep the same
    // frequencies, weights and arithmetic when it is visible.
    float medium = wide < 3 ? Math.Simplex(n * 4000) : 0;
    float tiny = wide < 1 ? Math.Simplex(n * 20000) : 0;
    return Math.Simplex(n * 900) * 0.5 + medium * 0.3 * fine + tiny * 0.2 * Math.Saturate(1 - wide);
}

Color Grass(float3 n, float wide, float grain)
{
    float forest = Math.Simplex(n * 7) * 0.6 + Math.Simplex(n * 19) * 0.3 + Math.Simplex(n * 61) * 0.1;
    var meadow = Color(0.40 + grain * 0.05, 0.62 + grain * 0.06, 0.32, 1);
    var woods = Color(0.18 + grain * 0.03, 0.40 + grain * 0.05, 0.24, 1);
    mut var ground = Mix(meadow, woods, Math.SmoothStep(0.05, 0.3, forest));
    // Dry grassland in places, and snow toward the poles
    float dry = Math.Simplex(n * 3 + float3(5, 0, 0)) * 0.7 + Math.Simplex(n * 11) * 0.3;
    ground = Mix(ground, Color(0.66 + grain * 0.04, 0.62 + grain * 0.04, 0.38, 1), Math.SmoothStep(0.25, 0.5, dry) * (1 - Math.SmoothStep(0.05, 0.3, forest)));
    float cold = Math.Abs(n.y) + grain * 0.03;
    ground = Mix(ground, Color(0.92, 0.94, 0.97, 1), Math.SmoothStep(0.9, 0.94, cold));
    // Flowers in the meadows, close up
    if (wide < 0.3 && forest < 0.0 && Math.Simplex(n * 30000) > 0.9 && Math.Simplex(n * 260) > 0.35) ground = Color(0.95, 0.85, 0.35, 1);
    return ground;
}

Color Paving(float2 at, float wide)
{
    var tile = at / 1.5;
    var cell = Math.Floor(tile);
    var within = tile - cell;
    float shade = (Math.Hash(int2(cell)) % 100) / 100.0 * 0.08 - 0.04;
    bool grout = (within.x < 0.06 || within.y < 0.06) && wide < 0.4;
    return grout ? Color(0.54, 0.50, 0.45, 1) : Color(0.74 + shade, 0.68 + shade, 0.60 + shade, 1);
}

// The ground at a place: meadows and forests, the roads, the towns. `wide` is
// how many metres a pixel covers there, so nothing finer than that shows.
Color Ground(float3 n, float wide, Atlas atlas)
{
    var tarmac = Color(0.22, 0.23, 0.25, 1);
    var kerb = Color(0.60, 0.60, 0.62, 1);
    var line = Color(0.92, 0.88, 0.62, 1);
    float soft = Math.Max(wide, 0.05);
    // The towns' 130 m caps are disjoint: a pixel can belong to at most one.
    // A chord is shorter than its surface arc, so this conservative bound
    // avoids sqrt/asin for every town on the rest of the planet.
    mut int town = -1;
    mut float distance = 0;
    mut var at = float2(0);
    for (var candidate = 0; candidate < 10; candidate++)
    {
        var delta = n - atlas.towns[candidate];
        float reach = (TOWN + 20) / R + 0.00001;
        if (Math.Dot(delta, delta) > reach * reach) continue;
        float d = 2 * Math.Asin(Math.Min(Math.Length(delta) * 0.5, 1)) * R;
        if (d > TOWN + 20) continue;
        town = candidate;
        distance = d;
        at = float2(Math.Dot(n, atlas.easts[candidate]), Math.Dot(n, atlas.norths[candidate])) * R;
        break;
    }
    // A plaza interior covers everything beneath it.
    if (town >= 0 && soft < PLAZA && distance <= PLAZA - soft) return Paving(at, wide);
    // Accumulate the road layers and how much natural ground remains visible.
    // Fully opaque asphalt needs none of the procedural meadow underneath.
    mut var ground = Color(0, 0, 0, 1);
    mut float unpainted = 1;
    // The roads between the towns, a dashed line down the middle
    for (var road = 0; road < 11; road++)
    {
        var a = atlas.froms[road];
        var b = atlas.tos[road];
        var c = Math.Normalize(Math.Cross(a, b));
        // |sin(angle)| <= |angle|: reject distant road planes before any
        // curved distance or arc-end calculation. The exact test stays below.
        float side = Math.Dot(n, c);
        if (Math.Abs(side) * R > ROAD + soft) continue;
        if (Math.Dot(Math.Cross(a, n), c) < 0 || Math.Dot(Math.Cross(n, b), c) < 0) continue;
        float across = Math.Abs(Math.Asin(Math.Clamp(side, -1, 1))) * R;
        if (across > ROAD + soft) continue;
        mut var paint = across < ROAD - 1.2 ? tarmac : kerb;
        if (wide < 1.6 && across < 0.12 + soft * 0.5)
        {
            float along = Math.Atan2(Math.Dot(Math.Cross(a, n), c), Math.Dot(a, n)) * R;
            paint = Mix(paint, line, Marking(across, along, wide));
        }
        float coverage = Math.SmoothStep(ROAD + soft, ROAD - soft, across);
        ground = Mix(ground, paint, coverage);
        unpainted *= 1 - coverage;
    }
    mut float grain = 0;
    if (unpainted > 0)
    {
        grain = Grain(n, wide);
        var grass = Grass(n, wide, grain);
        ground = Color(ground.r + grass.r * unpainted, ground.g + grass.g * unpainted, ground.b + grass.b * unpainted, 1);
    }
    // The local town's ground, ring road and square.
    if (town >= 0)
    {
        if (unpainted <= 0) grain = Grain(n, wide);
        // Mown lawns in town, lighter than the country
        ground = Mix(ground, Color(0.56 + grain * 0.04, 0.68 + grain * 0.04, 0.44, 1), Math.SmoothStep(TOWN + 8, TOWN - 4, distance) * 0.85);
        float ring = Math.Abs(distance - RING);
        if (ring < ROAD + soft)
        {
            mut var paint = ring < ROAD - 1.2 ? tarmac : kerb;
            if (wide < 1.6 && ring < 0.12 + soft * 0.5)
                paint = Mix(paint, line, Marking(ring, Math.Atan2(at.x, at.y) * RING, wide));
            ground = Mix(ground, paint, Math.SmoothStep(ROAD + soft, ROAD - soft, ring));
        }
        if (distance < PLAZA + soft)
        {
            // Paved in stones a little apart, each its own shade
            var paving = Paving(at, wide);
            ground = Mix(ground, paving, Math.SmoothStep(PLAZA + soft, PLAZA - soft, distance));
        }
    }
    return ground;
}

frag Planet(Around around, out Color color, Sky sky, Atlas atlas)
{
    float3 d = Math.Normalize(this.world);
    float b = Math.Dot(d, sky.center);
    // |center|² - R², kept from the eye's height rather than lost subtracting two big numbers
    float near = sky.height * (2 * R + sky.height);
    float disc = b * b - near;
    var air = Color(0.42, 0.66, 1.0);
    // Sky work has no contribution to an opaque ground pixel.
    if (b <= 0 || disc <= 0)
    {
        // Stars where no planet is, and the air's glow over the ground
        var grid = d * 400;
        var cell = Math.Floor(grid);
        int h = Math.Hash(int3(cell));
        var spot = float3((h % 89) / 89.0, (h % 97) / 97.0, (h % 83) / 83.0) * 0.6 + float3(0.2, 0.2, 0.2);
        float star = h % 1000 < 12 ? (0.25 + (h % 7) * 0.1) * Math.Saturate(1 - Math.Length(grid - cell - spot) / 0.12) : 0;
        color = Color(0.086 + star, 0.086 + star, 0.094 + star * 1.1, 1);
        float over = b > 0 ? Math.Sqrt(Math.Max(R * R - disc, 0)) - R : sky.height;
        var closest = b > 0 ? d * b - sky.center : -sky.center;
        float glow = Math.Exp(-Math.Max(over, 0) / AIR) * Math.Saturate(Math.Dot(Math.Normalize(closest), sky.sun) + 0.5);
        color = Mix(color, air, Math.Saturate(glow) * 0.95);
        return;
    }
    float t = near / (b + Math.Sqrt(disc));
    float3 n = Math.Normalize(d * t - sky.center);
    float wide = t * sky.pixel / Math.Max(Math.Dot(n, -d), 0.12);
    var surface = Ground(n, wide, atlas);
    float lit = Math.Dot(n, sky.sun);
    float shade = 0.45 + 0.55 * Math.Saturate(lit);
    var ground = Color(surface.r * shade, surface.g * shade, surface.b * shade, 1);
    // The air between the eye and the ground, more of it far off
    float haze = Math.Saturate(1 - Math.Exp(-t / 2500)) * 0.55 * Math.Saturate(1 - sky.height / 1500);
    color = Mix(ground, air, haze);
}

// What's on the planet: walkers, cars, trees, lit from the sun
frag Lit(Corner corner, out Color color, Placed placed, Instance instance, Sky sky)
{
    if (Underground(this.world, sky)) this.Discard();
    // Opaque coverage avoids sorting transparent trunks and crowns. At full
    // coverage every pixel stays; at the outer edge none remain to pop in.
    float coverage = Math.Frac(52.9829189 * Math.Frac(Math.Dot(this.position, float2(0.06711056, 0.00583715))));
    if (placed.paint.a <= coverage) this.Discard();
    var normal = instance.Normal(corner.normal);
    float lit = Math.Max(Math.Dot(normal, sky.sun), 0) * 0.6 + 0.4;
    color = Color(placed.paint.r * lit, placed.paint.g * lit, placed.paint.b * lit, 1);
}

// A glow, brightest in its middle, added to what's behind it: a town on the globe, sparks
frag Glow(Corner corner, out Color color, Placed placed, Sky sky)
{
    if (Underground(this.world, sky)) this.Discard();
    float r = Math.Length(corner.position.xy);
    mut float glow = Math.Saturate(1 - r);
    glow = glow * glow * (0.4 + 0.6 * glow);
    color = Color(placed.paint.r * glow, placed.paint.g * glow, placed.paint.b * glow, 1);
}

// A soft shadow under something, darkening the ground
frag Shade(Corner corner, out Color color, Placed placed, Sky sky)
{
    if (Underground(this.world, sky)) this.Discard();
    float r = Math.Length(corner.position.xy);
    color = Color(0, 0, 0, Math.Saturate(1 - r) * placed.paint.a);
}

// A building: walls with rows of windows, and a roof
struct Tower
{
    float4x4 transform;
    float3 size;
    Color paint;
}

frag Wall(Corner corner, out Color color, Tower tower, Instance instance, Sky sky)
{
    if (Underground(this.world, sky)) this.Discard();
    var normal = instance.Normal(corner.normal);
    var p = (corner.position + float3(0.5, 0.5, 0.5)) * tower.size;
    mut var paint = tower.paint;
    if (Math.Abs(corner.normal.y) < 0.5)
    {
        // Across the wall and up it, in metres
        float u = Math.Abs(corner.normal.x) > 0.5 ? p.z : p.x;
        float floor = p.y - Math.Floor(p.y / 3.2) * 3.2;
        float bay = u - Math.Floor(u / 2.8) * 2.8;
        bool window = floor > 1.1 && floor < 2.6 && bay > 0.6 && bay < 2.2 && p.y > 1;
        if (window) paint = Color(0.55, 0.68, 0.78, 1);
        if (p.y < 0.4) paint = Color(paint.r * 0.6, paint.g * 0.6, paint.b * 0.6, 1);
    }
    else
    {
        paint = Color(paint.r * 0.7, paint.g * 0.7, paint.b * 0.7, 1);
    }
    float lit = Math.Max(Math.Dot(normal, sky.sun), 0) * 0.55 + 0.4;
    color = Color(paint.r * lit, paint.g * lit, paint.b * lit, 1);
}
