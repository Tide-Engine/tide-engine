// Earth: everyone who opens the page is a little walker in one of twelve
// cities around one planet at its real size, with the townsfolk and the cars
// in the streets, which everyone there sees doing the same. The world is
// sharded: each region of the planet can be a server of its own.
//
// The match is this file, the cities city.tide. globe.tide draws the planet,
// shapes.tide what's on it, show.tide the rest.

settings
{
    title = "Earth";
    maxPlayers = 64;
    shards = true;
    reach = 1_000;   // Metres: a whole city, from any part of it
}

const double RADIUS = 6_371_000d;   // The Earth's, in metres
const float WALK = 5;               // Metres a second
const float STROLL = 1.4;           // ...a townsperson's
const float BODY = 0.45;            // A walker's radius
const float JUMP = 5;               // How fast a jump leaves the ground
const float GRAVITY = 15;
const int WAVE = 90;                // Ticks a wave lasts
const int PEOPLE = 8;               // Townsfolk in each city
const int CARS = 6;                 // ...and cars
const float CAR = 2.3;              // Half a car's length
const int COLORS = 8;

scene Main { }

component Walker
{
    [Position] double3 position;  // From the Earth's center, for the shards
    int city = -1;                // Where it is: -1 until its player picks a city
    float2 at;                    // Metres east and north of the city's middle
    float2 velocity;
    float facing;                 // Radians clockwise from north
    float height;                 // Off the ground, jumping
    float rise;
    int color;
    int waving;                   // Ticks of a wave left
    int moves;                    // The last city change its player asked for
    int fives;                    // High fives
    int fived;                    // Ticks until it can high-five again
    local float stride;           // This machine's: how far along its step it is
}

// A walker nobody plays: one of the townsfolk
component Person
{
    float2 goal;
    float rest;     // Seconds it stands before it goes on
    float stuck;    // Seconds it hasn't got nearer its goal
}

component Car
{
    [Position] double3 position;
    int city;
    float turn;     // Round the ring road, radians clockwise from north
    float lane;     // Metres from the city's middle
    float way;      // 1 clockwise, -1 the other way
    float speed;
    int color;
}

singleton Roster
{
    Map<PlayerID, Entity> walkers;
    int online;
    int next;
    bool seeded;
}

event HighFive { }   // Sent to each walker of the two, for what's shown

input Controls
{
    [Clamp(-1, 1)] float2 move;   // East and north
    bool jump;
    bool wave;
    int city;
    int moves;                    // Counts the cities asked for: one the walker hasn't had takes it there

    Sample(Devices devices, Pilot pilot)
    {
        city = pilot.city;
        moves = pilot.moves;
        if (!pilot.walking) return;
        var keys = devices.keyboard;
        mut var push = float2(0, 0);
        if (keys.d.pressed || keys.rightArrow.pressed) push.x += 1;
        if (keys.a.pressed || keys.leftArrow.pressed) push.x -= 1;
        if (keys.w.pressed || keys.upArrow.pressed) push.y += 1;
        if (keys.s.pressed || keys.downArrow.pressed) push.y -= 1;
        push += devices.gamepad.leftStick;
        // Ahead is the way the camera looks
        var ahead = float2(Math.Sin(pilot.look), Math.Cos(pilot.look));
        var right = float2(ahead.y, -ahead.x);
        move = ahead * push.y + right * push.x;
        if (pilot.going) move += pilot.toward;
        jump = keys.space.pressed || devices.gamepad.buttonSouth.pressed || pilot.jumping > 0;
        wave = keys.e.pressed || devices.gamepad.buttonWest.pressed || pilot.waving > 0;
    }
}

event(PlayerJoined joined) Arrive(mut Roster roster)
{
    // Over the north pole, unseen, until its player picks a city
    roster.walkers[joined.player] = Spawn(
        Walker { position = double3(0, RADIUS, 0), color = roster.next % COLORS },
        Owner { player = joined.player });
    roster.next += 1;
    roster.online += 1;
}

event(PlayerLeft left) Depart(mut Roster roster)
{
    if (roster.walkers.TryGet(left.player, out var walker))
    {
        walker.Destroy();
        roster.walkers.Remove(left.player);
    }
    roster.online -= 1;
}

// The townsfolk and the cars of every city, once
system Seed(mut Roster roster)
{
    if (roster.seeded) return;
    roster.seeded = true;
    for (var city = 0; city < CITIES; city++)
    {
        for (var i = 0; i < PEOPLE; i++)
        {
            var turn = Random.NextFloat(0, Math.TAU);
            var at = Clear(city, float2(Math.Sin(turn), Math.Cos(turn)) * Random.NextFloat(PLAZA, RING - ROAD - 4), BODY);
            Spawn(Walker { position = Place(city, at, 0), city = city, at = at, facing = turn, color = 100 + Random.NextInt(6) },
                  Person { goal = at, rest = Random.NextFloat(0, 4) });
        }
        for (var i = 0; i < CARS; i++)
        {
            float way = i % 2 == 0 ? 1 : -1;
            float lane = RING + way * 3;
            float turn = i * Math.TAU / CARS;
            Spawn(Car { position = Place(city, float2(Math.Sin(turn), Math.Cos(turn)) * lane, 0), city = city, turn = turn,
                        lane = lane, way = way, speed = 10, color = Random.NextInt(COLORS) });
        }
    }
}

// A walker going `toward` (at most 1 long, east and north), and jumping
void Step(mut Walker walker, float2 toward, float speed, bool jump, float dt)
{
    var want = toward * speed;
    mut var change = want - walker.velocity;
    float most = 30 * dt;
    if (Math.Length(change) > most) change = Math.Normalize(change) * most;
    walker.velocity += change;
    walker.at = Clear(walker.city, walker.at + walker.velocity * dt, BODY);
    if (Math.Length(walker.velocity) > 0.3) walker.facing = Math.Atan2(walker.velocity.x, walker.velocity.y);
    if (jump && walker.height <= 0) walker.rise = JUMP;
    walker.rise -= GRAVITY * dt;
    walker.height = Math.Max(walker.height + walker.rise * dt, 0);
    if (walker.height <= 0) walker.rise = 0;
    if (walker.waving > 0) walker.waving -= 1;
    if (walker.fived > 0) walker.fived -= 1;
    walker.position = Place(walker.city, walker.at, walker.height);
}

system Walk(mut Walker walker, Controls input, Time time, without Person)
{
    // A newer request than the last it took: never one a shard guesses before its player's input arrives, which is 0
    if (input.moves > walker.moves && input.city >= 0 && input.city < CITIES)
    {
        // To the square of the town its player picked, a few steps from the fountain and facing it, where everyone arrives
        walker.moves = input.moves;
        walker.city = input.city;
        var turn = Random.NextFloat(0, Math.TAU);
        walker.at = Clear(walker.city, float2(Math.Sin(turn), Math.Cos(turn)) * Random.NextFloat(FOUNTAIN + 4, FOUNTAIN + 9), BODY);
        walker.velocity = float2(0, 0);
        walker.facing = turn + Math.PI;
        walker.height = 0;
        walker.position = Place(walker.city, walker.at, 0);
        return;
    }
    if (walker.city < 0) return;
    if (input.wave && walker.waving == 0) walker.waving = WAVE;
    Step(walker, input.move, WALK, input.jump, time.dt);
}

// The townsfolk stroll from place to place, and wave back
system Stroll(mut Walker walker, mut Person person, Time time, query (Walker other, without Person) players)
{
    mut var toward = float2(0, 0);
    if (person.rest > 0)
    {
        person.rest -= time.dt;
    }
    else
    {
        var way = person.goal - walker.at;
        float far = Math.Length(way);
        person.stuck += time.dt;
        if (far < 1.5 || person.stuck > 8)
        {
            var turn = Random.NextFloat(0, Math.TAU);
            person.goal = float2(Math.Sin(turn), Math.Cos(turn)) * Random.NextFloat(PLAZA * 0.5, EDGE - 40);
            person.rest = Random.NextFloat(1, 6);
            person.stuck = 0;
        }
        else
        {
            toward = way / far;
        }
    }
    foreach (var row in players)
    {
        if (row.other.city == walker.city && row.other.waving > WAVE - 5 && Math.Length(row.other.at - walker.at) < 12 && walker.waving == 0)
        {
            walker.waving = WAVE;
            walker.facing = Math.Atan2(row.other.at.x - walker.at.x, row.other.at.y - walker.at.y);
            person.rest = 2;
        }
    }
    Step(walker, toward, STROLL, false, time.dt);
}

// Walkers bump each other aside, and out of the cars' way, and two waving at each other high-five
system Bump(mut Walker walker, query (Walker other) walkers, query (Car car) cars)
{
    if (walker.city < 0) return;
    foreach (var row in cars)
    {
        if (row.car.city != walker.city) continue;
        // Out of the car's box, the shorter way: its length along the ring, its width across it
        var middle = float2(Math.Sin(row.car.turn), Math.Cos(row.car.turn)) * row.car.lane;
        var along = float2(Math.Cos(row.car.turn), -Math.Sin(row.car.turn));
        var across = float2(along.y, -along.x);
        var off = walker.at - middle;
        float u = Math.Dot(off, along);
        float v = Math.Dot(off, across);
        float longways = CAR + BODY - Math.Abs(u);
        float sideways = 1.0 + BODY - Math.Abs(v);
        if (longways > 0 && sideways > 0)
        {
            if (sideways < longways) walker.at += across * ((v < 0 ? -1 : 1) * sideways);
            else walker.at += along * ((u < 0 ? -1 : 1) * longways);
        }
    }
    foreach (var row in walkers)
    {
        if (row.entity == this || row.other.city != walker.city) continue;
        var apart = walker.at - row.other.at;
        float d = Math.Length(apart);
        if (d < BODY * 2 && d > 0.0001) walker.at += apart / d * ((BODY * 2 - d) * 0.5);
        if (d < 2.2 && walker.waving > 0 && row.other.waving > 0 && walker.fived == 0)
        {
            walker.fives += 1;
            walker.fived = WAVE * 2;
            this.Send(HighFive { });
        }
    }
    walker.position = Place(walker.city, walker.at, walker.height);
}

// Cars go round the ring road, and stop for whoever's in front of them
system Drive(mut Car car, Time time, query (Walker walker) walkers, query (Car other) cars)
{
    float look = 9 / car.lane; // Radians ahead that it watches
    mut bool blocked = false;
    foreach (var row in walkers)
    {
        if (row.walker.city != car.city) continue;
        float r = Math.Length(row.walker.at);
        if (Math.Abs(r - car.lane) > 2.6) continue;
        float ahead = Ahead(car, Math.Atan2(row.walker.at.x, row.walker.at.y));
        if (ahead > 0 && ahead < look) blocked = true;
    }
    foreach (var row in cars)
    {
        if (row.entity == this || row.other.city != car.city || row.other.lane != car.lane) continue;
        float ahead = Ahead(car, row.other.turn);
        if (ahead > 0 && ahead < look * 1.1) blocked = true;
    }
    float want = blocked ? 0 : 11;
    car.speed += Math.Clamp(want - car.speed, -14 * time.dt, 4 * time.dt);
    car.turn += car.way * car.speed * time.dt / car.lane;
    if (car.turn > Math.TAU) car.turn -= Math.TAU;
    if (car.turn < 0) car.turn += Math.TAU;
    car.position = Place(car.city, float2(Math.Sin(car.turn), Math.Cos(car.turn)) * car.lane, 0);
}

// How far round the ring a turn is ahead of a car, the way it goes, from -π to π
float Ahead(Car car, float turn)
{
    mut float d = (turn - car.turn) * car.way;
    if (d > Math.PI) d -= Math.TAU;
    if (d < -Math.PI) d += Math.TAU;
    return d;
}
