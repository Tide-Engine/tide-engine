// Original procedural geometry, informed by Pollen Robotics' MicroDuck photos.
// Photo reference: https://pollen-robotics.com/microduck/press-kit/
// No upstream meshes, mesh vertices, image textures or other art are included.
// Joint/site anchors are from the Apache-2.0 MJCF in upstream/robot_walk.xml.
// Enclosure extents are visual estimates, not source CAD or collision bounds.
// All dimensions below are metres in each body's ORIGINAL MJCF source frame;
// the caller removes principalRotation from the Newton body's world rotation.

struct MicroduckCachedPart
{
    List<Vertex3> vertices;
    List<int> triangles;
    bool made;
}

// Machine-local drawing data, built lazily for the two palettes and 15 bodies.
// Pass this explicitly from a view; it is never part of the match's state.
local singleton MicroduckMeshes
{
    List<MicroduckCachedPart> parts;
}

struct MicroduckGeometry
{
    List<Vertex3> vertices;
    List<int> triangles;
    quaternion worldRotation;
    float3 offset;
    quaternion rotation;
}

Color MicroduckSurface(Color paint, float3 normal, quaternion worldRotation)
{
    // The ordinary Draw meshes are unlit. Bake a soft studio key and sky fill
    // into their vertex colors once, using the first rendered pose. This
    // stylized lighting stays on the casings as their cached meshes articulate.
    var world = Math.Rotate(worldRotation, normal);
    var key = Math.Max(Math.Dot(world, Math.Normalize(float3(-0.45, 0.85, -0.6))), 0);
    var fill = Math.Max(world.y, 0);
    mut var result = paint * (0.57 + key * 0.33 + fill * 0.10);
    result.a = paint.a;
    return result;
}

void MicroduckVertex(mut MicroduckGeometry geometry, float3 position, float3 normal, Color paint)
{
    var turnedNormal = Math.Rotate(geometry.rotation, normal);
    geometry.vertices.Add(Vertex3 {
        position = geometry.offset + Math.Rotate(geometry.rotation, position),
        color = MicroduckSurface(paint, turnedNormal, geometry.worldRotation)
    });
}

void MicroduckTriangle(mut MicroduckGeometry geometry, int a, int b, int c)
{
    geometry.triangles.Add(a);
    geometry.triangles.Add(b);
    geometry.triangles.Add(c);
}

void MicroduckQuad(mut MicroduckGeometry geometry, float3 a, float3 b, float3 c, float3 d,
                   float3 normal, Color paint)
{
    var first = geometry.vertices.count;
    MicroduckVertex(geometry, a, normal, paint);
    MicroduckVertex(geometry, b, normal, paint);
    MicroduckVertex(geometry, c, normal, paint);
    MicroduckVertex(geometry, d, normal, paint);
    MicroduckTriangle(geometry, first, first + 1, first + 2);
    MicroduckTriangle(geometry, first, first + 2, first + 3);
}

float MicroduckCaseCoordinate(int step, float half, float bevel)
{
    if (step == 0) return -half;
    if (step == 1) return -half + bevel * 0.35;
    if (step == 2) return -half + bevel;
    if (step == 3) return half - bevel;
    if (step == 4) return half - bevel * 0.35;
    return half;
}

void MicroduckCase(mut MicroduckGeometry geometry, float3 center, float3 size,
                   quaternion rotation, float bevel, Color paint)
{
    // Six rounded face grids: flat panels with short, smoothly shaded edges.
    // Their shape is authored here, independently of the source robot's CAD.
    var half = size * 0.5;
    var inner = half - float3(bevel);
    for (int face = 0; face < 6; face += 1)
    {
        var axis = face / 2;
        var sign = face % 2 == 0 ? 1.0 : -1.0;
        var normal = axis == 0 ? float3(sign, 0, 0) :
                     axis == 1 ? float3(0, sign, 0) : float3(0, 0, sign);
        var across = axis == 0 ? float3(0, 0, -sign) :
                     axis == 1 ? float3(1, 0, 0) : float3(sign, 0, 0);
        var up = axis == 1 ? float3(0, 0, -sign) : float3(0, 1, 0);
        var width = Math.Dot(Math.Abs(across), half);
        var height = Math.Dot(Math.Abs(up), half);
        var first = geometry.vertices.count;
        for (int y = 0; y < 6; y += 1)
        {
            for (int x = 0; x < 6; x += 1)
            {
                var point = normal * half +
                            across * MicroduckCaseCoordinate(x, width, bevel) +
                            up * MicroduckCaseCoordinate(y, height, bevel);
                var nearest = Math.Clamp(point, -inner, inner);
                var roundNormal = Math.Normalize(point - nearest);
                MicroduckVertex(geometry,
                    center + Math.Rotate(rotation, nearest + roundNormal * bevel),
                    Math.Rotate(rotation, roundNormal), paint);
                if (x < 5 && y < 5)
                {
                    var at = first + y * 6 + x;
                    MicroduckTriangle(geometry, at, at + 1, at + 7);
                    MicroduckTriangle(geometry, at, at + 7, at + 6);
                }
            }
        }
    }
}

void MicroduckCase(mut MicroduckGeometry geometry, float3 center, float3 size,
                   float bevel, Color paint)
{
    MicroduckCase(geometry, center, size, quaternion.identity, bevel, paint);
}

void MicroduckBeam(mut MicroduckGeometry geometry, float3 start, float3 end,
                   float width, float depth, Color paint)
{
    var delta = end - start;
    var length = Math.Length(delta);
    var direction = delta / length;
    var up = Math.Abs(direction.z) > 0.95 ? float3(0, 1, 0) : float3(0, 0, 1);
    var turn = quaternion.LookRotation(direction, up);
    MicroduckCase(geometry, (start + end) * 0.5, float3(width, depth, length),
                  turn, Math.Min(width, depth) * 0.2, paint);
}

void MicroduckAxle(mut MicroduckGeometry geometry, float3 center, float3 axis,
                   float radius, float depth, Color paint)
{
    // This authored cylinder uses the supplied axis, rather than Draw's local Y.
    var up = Math.Abs(axis.y) > 0.95 ? float3(1, 0, 0) : float3(0, 1, 0);
    var across = Math.Normalize(Math.Cross(up, axis));
    var vertical = Math.Cross(axis, across);
    for (int step = 0; step < 24; step += 1)
    {
        var angle = step * Math.TAU / 24;
        var next = (step + 1) * Math.TAU / 24;
        var a = across * Math.Cos(angle) + vertical * Math.Sin(angle);
        var b = across * Math.Cos(next) + vertical * Math.Sin(next);
        var first = geometry.vertices.count;
        MicroduckVertex(geometry, center + a * radius - axis * depth * 0.5, a, paint);
        MicroduckVertex(geometry, center + b * radius - axis * depth * 0.5, b, paint);
        MicroduckVertex(geometry, center + b * radius + axis * depth * 0.5, b, paint);
        MicroduckVertex(geometry, center + a * radius + axis * depth * 0.5, a, paint);
        MicroduckTriangle(geometry, first, first + 1, first + 2);
        MicroduckTriangle(geometry, first, first + 2, first + 3);
        for (int side = -1; side <= 1; side += 2)
        {
            var cap = center + axis * (side * depth * 0.5);
            var at = geometry.vertices.count;
            MicroduckVertex(geometry, cap, axis * side, paint);
            MicroduckVertex(geometry, cap + a * radius, axis * side, paint);
            MicroduckVertex(geometry, cap + b * radius, axis * side, paint);
            if (side == 1) MicroduckTriangle(geometry, at, at + 1, at + 2);
            else MicroduckTriangle(geometry, at, at + 2, at + 1);
        }
    }
}

void MicroduckScrew(mut MicroduckGeometry geometry, float3 center, float3 axis)
{
    MicroduckAxle(geometry, center, axis, 0.00165, 0.0008, Color(0.58, 0.60, 0.59));
    MicroduckAxle(geometry, center + axis * 0.00045, axis, 0.00065, 0.0002, Color(0.08, 0.09, 0.09));
}

void MicroduckHub(mut MicroduckGeometry geometry, float3 center, float3 axis,
                  float radius, Color paint)
{
    var black = Color(0.055, 0.063, 0.067);
    MicroduckAxle(geometry, center, axis, radius, 0.004, paint);
    MicroduckAxle(geometry, center + axis * 0.0022, axis, radius * 0.43, 0.0007, black);
    var up = Math.Abs(axis.y) > 0.95 ? float3(1, 0, 0) : float3(0, 1, 0);
    var across = Math.Normalize(Math.Cross(up, axis));
    var vertical = Math.Cross(axis, across);
    for (int bolt = 0; bolt < 4; bolt += 1)
    {
        var angle = bolt * Math.PI * 0.5;
        var offset = (across * Math.Cos(angle) + vertical * Math.Sin(angle)) * radius * 0.7;
        MicroduckAxle(geometry, center + axis * 0.0024 + offset, axis,
                      0.00115, 0.0005, black);
    }
}

float2 MicroduckProfilePoint(List<float2> profile, int index, bool reverse)
{
    var wrapped = (index + profile.count) % profile.count;
    return profile[reverse ? profile.count - 1 - wrapped : wrapped];
}

void MicroduckPlate(mut MicroduckGeometry geometry, List<float2> profile,
                    float3 center, float depth, float bevel, Color paint, bool smooth)
{
    // A convex, chamfered XY outline extruded along Z. Both mirrored leg
    // profiles retain outward triangle winding and their own articulated frame.
    mut float area = 0;
    mut float2 middle = float2(0);
    for (int i = 0; i < profile.count; i += 1)
    {
        var a = profile[i];
        var b = profile[(i + 1) % profile.count];
        area += a.x * b.y - a.y * b.x;
        middle += a;
    }
    middle /= profile.count;
    var reverse = area < 0;
    for (int i = 0; i < profile.count; i += 1)
    {
        var previous = MicroduckProfilePoint(profile, i - 1, reverse);
        var a = MicroduckProfilePoint(profile, i, reverse);
        var b = MicroduckProfilePoint(profile, i + 1, reverse);
        var next = MicroduckProfilePoint(profile, i + 2, reverse);
        var edge = b - a;
        var outward = Math.Normalize(float2(edge.y, -edge.x));
        var before = a - previous;
        var after = next - b;
        var normalA = Math.Normalize(outward + Math.Normalize(float2(before.y, -before.x)));
        var normalB = Math.Normalize(outward + Math.Normalize(float2(after.y, -after.x)));
        var insetA = a - normalA * bevel;
        var insetB = b - normalB * bevel;
        var sideNormal = float3(outward, 0);
        if (smooth)
        {
            var first = geometry.vertices.count;
            MicroduckVertex(geometry, center + float3(a, -depth * 0.5 + bevel), float3(normalA, 0), paint);
            MicroduckVertex(geometry, center + float3(b, -depth * 0.5 + bevel), float3(normalB, 0), paint);
            MicroduckVertex(geometry, center + float3(b, depth * 0.5 - bevel), float3(normalB, 0), paint);
            MicroduckVertex(geometry, center + float3(a, depth * 0.5 - bevel), float3(normalA, 0), paint);
            MicroduckTriangle(geometry, first, first + 1, first + 2);
            MicroduckTriangle(geometry, first, first + 2, first + 3);
        }
        else
            MicroduckQuad(geometry,
                center + float3(a, -depth * 0.5 + bevel),
                center + float3(b, -depth * 0.5 + bevel),
                center + float3(b, depth * 0.5 - bevel),
                center + float3(a, depth * 0.5 - bevel), sideNormal, paint);
        for (int side = -1; side <= 1; side += 2)
        {
            var cap = side * depth * 0.5;
            var inner = cap - side * bevel;
            var first = geometry.vertices.count;
            var normal = Math.Normalize(sideNormal + float3(0, 0, side));
            MicroduckVertex(geometry, center + float3(a, inner), normal, paint);
            MicroduckVertex(geometry, center + float3(b, inner), normal, paint);
            MicroduckVertex(geometry, center + float3(insetB, cap), normal, paint);
            MicroduckVertex(geometry, center + float3(insetA, cap), normal, paint);
            if (side == 1)
            {
                MicroduckTriangle(geometry, first, first + 1, first + 2);
                MicroduckTriangle(geometry, first, first + 2, first + 3);
            }
            else
            {
                MicroduckTriangle(geometry, first, first + 2, first + 1);
                MicroduckTriangle(geometry, first, first + 3, first + 2);
            }
            var at = geometry.vertices.count;
            MicroduckVertex(geometry, center + float3(middle, cap), float3(0, 0, side), paint);
            MicroduckVertex(geometry, center + float3(insetA, cap), float3(0, 0, side), paint);
            MicroduckVertex(geometry, center + float3(insetB, cap), float3(0, 0, side), paint);
            if (side == 1) MicroduckTriangle(geometry, at, at + 1, at + 2);
            else MicroduckTriangle(geometry, at, at + 2, at + 1);
        }
    }
}

void MicroduckPlate(mut MicroduckGeometry geometry, List<float2> profile,
                    float3 center, float depth, float bevel, Color paint)
{
    MicroduckPlate(geometry, profile, center, depth, bevel, paint, false);
}

List<float2> MicroduckSoleOutline(float length, float width)
{
    var x = length * 0.5;
    var y = width * 0.5;
    var corner = 0.006;
    return [float2(-x + corner, -y), float2(x - corner, -y),
            float2(x, -y + corner), float2(x, y - corner),
            float2(x - corner, y), float2(-x + corner, y),
            float2(-x, y - corner), float2(-x, -y + corner)];
}

void MicroduckTrunk(mut MicroduckGeometry geometry, Color cream, Color accent)
{
    var black = Color(0.09, 0.10, 0.105);
    MicroduckCase(geometry, float3(0.004, 0, -0.004), float3(0.034, 0.052, 0.027), 0.003, black);
    MicroduckCase(geometry, float3(-0.020, 0, 0.021), float3(0.080, 0.070, 0.041), 0.008, cream);
    MicroduckCase(geometry, float3(-0.020, 0, 0.001), float3(0.066, 0.061, 0.004), 0.0015, accent);
    // A rear battery panel, case seam and cooling slots make the torso a case.
    MicroduckCase(geometry, float3(-0.059, 0, 0.020), float3(0.003, 0.046, 0.024), 0.001, black);
    MicroduckCase(geometry, float3(-0.061, 0, 0.020), float3(0.001, 0.001, 0.025), 0.0003, Color(0.42, 0.43, 0.40));
    for (int side = -1; side <= 1; side += 2)
    {
        for (int slot = 0; slot < 4; slot += 1)
            MicroduckCase(geometry, float3(-0.039 + slot * 0.007, side * 0.0351, 0.021),
                          float3(0.002, 0.001, 0.011), 0.0003, Color(0.25, 0.27, 0.26));
        MicroduckScrew(geometry, float3(0.009, side * 0.034, 0.031), float3(0, side, 0));
        MicroduckScrew(geometry, float3(-0.046, side * 0.034, 0.011), float3(0, side, 0));
    }
    MicroduckCase(geometry, float3(0.024, 0, 0.031), float3(0.014, 0.030, 0.017), 0.003, black);
}

void MicroduckHipYaw(mut MicroduckGeometry geometry, Color cream)
{
    var black = Color(0.105, 0.115, 0.12);
    MicroduckCase(geometry, float3(0, 0.003, 0.0125), float3(0.024, 0.029, 0.024), 0.002, black);
    MicroduckHub(geometry, float3(0, 0, -0.0015), float3(0, 0, -1), 0.009, cream);
    MicroduckHub(geometry, float3(0, 0.018, 0.0125), float3(0, 1, 0), 0.0095, cream);
    MicroduckCase(geometry, float3(-0.013, 0.004, 0.0125), float3(0.003, 0.026, 0.021),
                  0.001, Color(0.52, 0.54, 0.52));
}

void MicroduckHipRoll(mut MicroduckGeometry geometry, Color cream)
{
    MicroduckBeam(geometry, float3(0, 0, -0.002), float3(0.025, 0, -0.0185),
                  0.016, 0.009, cream);
    MicroduckHub(geometry, float3(0, 0, 0.002), float3(0, 0, 1), 0.0085, Color(0.60, 0.62, 0.60));
    MicroduckHub(geometry, float3(0.025, 0, -0.0185), float3(1, 0, 0), 0.009, cream);
}

void MicroduckThigh(mut MicroduckGeometry geometry, bool left, Color cream)
{
    var sign = left ? 1.0 : -1.0;
    var black = Color(0.105, 0.115, 0.12);
    var knee = float3(sign * 0.022, 0.0357771, -0.004);
    MicroduckCase(geometry, float3(0, 0.009, 0.0125), float3(0.022, 0.028, 0.025), 0.002, black);
    MicroduckCase(geometry, knee + float3(0, -0.009, 0.0165), float3(0.022, 0.028, 0.025), 0.002, black);
    List<float2> cover = [
        float2(sign * -0.013, -0.005), float2(sign * 0.012, -0.009),
        float2(sign * 0.039, 0.019), float2(sign * 0.030, 0.042),
        float2(sign * 0.014, 0.046), float2(sign * -0.012, 0.013)
    ];
    MicroduckPlate(geometry, cover, float3(0, 0, 0.028), 0.006, 0.0018, cream);
    MicroduckHub(geometry, float3(0, 0, -0.004), float3(0, 0, -1), 0.009, Color(0.53, 0.55, 0.54));
    MicroduckScrew(geometry, float3(0, 0, 0.0312), float3(0, 0, 1));
    MicroduckScrew(geometry, float3(knee.x, knee.y, 0.0312), float3(0, 0, 1));
}

void MicroduckShin(mut MicroduckGeometry geometry, bool left, Color cream)
{
    var ankle = left ? float3(0, 0.042, -0.026) : float3(-0.042, 0, -0.026);
    var along = left ? float3(0, 1, 0) : float3(-1, 0, 0);
    var across = left ? float3(1, 0, 0) : float3(0, 1, 0);
    var metal = Color(0.57, 0.59, 0.56);
    MicroduckBeam(geometry, float3(0, 0, 0.004), ankle + float3(0, 0, 0.023), 0.012, 0.005, metal);
    for (int side = -1; side <= 1; side += 2)
        MicroduckBeam(geometry, across * (side * 0.006),
                      ankle + across * (side * 0.006) + float3(0, 0, 0.016),
                      0.003, 0.005, metal);
    var size = left ? float3(0.023, 0.028, 0.025) : float3(0.028, 0.023, 0.025);
    MicroduckCase(geometry, ankle - along * 0.010 + float3(0, 0, 0.0145), size,
                  0.002, Color(0.095, 0.105, 0.11));
    MicroduckHub(geometry, float3(0, 0, 0.005), float3(0, 0, 1), 0.0085, cream);
    MicroduckCase(geometry, ankle - along * 0.011 + float3(0, 0, 0.0275),
                  left ? float3(0.008, 0.010, 0.001) : float3(0.010, 0.008, 0.001),
                  0.0003, Color(0.73, 0.75, 0.71));
}

void MicroduckFoot(mut MicroduckGeometry geometry, bool left, Color cream, Color accent)
{
    var sign = left ? -1.0 : 1.0;
    // The source foot site's +Y is up, its plane is y=-.0238146, and its
    // centre is z=-.0140852. Fore/aft X is mirrored between the two ankles.
    geometry.offset = float3(sign * 0.005, -0.0193146, -0.0140852);
    geometry.rotation = quaternion.AxisAngle(float3(1, 0, 0), -Math.PI / 2);
    MicroduckPlate(geometry, MicroduckSoleOutline(0.072, 0.043), float3(0),
                   0.009, 0.0025, Color(0.24, 0.27, 0.27));
    MicroduckPlate(geometry, MicroduckSoleOutline(0.071, 0.042), float3(0, 0, 0.0055),
                   0.004, 0.0012, cream);
    MicroduckPlate(geometry, MicroduckSoleOutline(0.067, 0.038), float3(0, 0, 0.008),
                   0.002, 0.0006, accent);
    geometry.offset = float3(0);
    geometry.rotation = quaternion.identity;
    List<float2> bracket = [
        float2(-0.026, -0.011), float2(0.023, -0.011), float2(0.013, -0.003),
        float2(0.007, 0.008), float2(-0.007, 0.008), float2(-0.013, -0.003)
    ];
    for (int side = -1; side <= 1; side += 2)
    {
        var z = -0.0140852 + side * 0.017;
        MicroduckPlate(geometry, bracket, float3(0, 0, z), 0.0035, 0.0008, accent);
        MicroduckHub(geometry, float3(0, 0, z + side * 0.002), float3(0, 0, side),
                      0.0063, Color(0.56, 0.58, 0.55));
    }
    MicroduckCase(geometry, float3(sign * 0.027, -0.0108, -0.0140852),
                  float3(0.011, 0.0012, 0.027), 0.0004, cream);
}

void MicroduckNeck(mut MicroduckGeometry geometry, Color cream)
{
    var black = Color(0.085, 0.095, 0.10);
    MicroduckCase(geometry, float3(0, -0.011, 0.0145), float3(0.020, 0.027, 0.025), 0.0018, black);
    MicroduckCase(geometry, float3(0, -0.039, 0.0145), float3(0.020, 0.027, 0.025), 0.0018, black);
    for (int side = -1; side <= 1; side += 2)
    {
        var z = 0.0145 + side * 0.014;
        MicroduckBeam(geometry, float3(0, -0.003, z), float3(0, -0.047, z),
                      0.008, 0.0025, Color(0.47, 0.50, 0.48));
        MicroduckHub(geometry, float3(0, 0, z), float3(0, 0, side), 0.008, cream);
        MicroduckHub(geometry, float3(0, -0.05, z), float3(0, 0, side), 0.008, cream);
        MicroduckCase(geometry, float3(0, -0.025, z), float3(0.018, 0.006, 0.0025),
                      0.0007, Color(0.60, 0.62, 0.59));
        MicroduckScrew(geometry, float3(-0.006, -0.025, z + side * 0.0016), float3(0, 0, side));
        MicroduckScrew(geometry, float3(0.006, -0.025, z + side * 0.0016), float3(0, 0, side));
    }
    // Two small cable runs, deliberately restrained compared with the linkage.
    MicroduckBeam(geometry, float3(-0.0105, -0.010, 0.006), float3(-0.0105, -0.040, 0.006),
                  0.0018, 0.0018, Color(0.045, 0.05, 0.055));
    MicroduckCase(geometry, float3(-0.0108, -0.011, 0.014), float3(0.002, 0.005, 0.004),
                  0.0005, cream);
    MicroduckCase(geometry, float3(-0.0108, -0.039, 0.014), float3(0.002, 0.005, 0.004),
                  0.0005, cream);
}

void MicroduckHead(mut MicroduckGeometry geometry, Color cream, Color accent)
{
    // In this link +X is up and -Z is forward at home. For the authored head
    // alone, use a convenient drawing frame: X across, Y up and Z forward.
    geometry.rotation = quaternion(0.70710678, 0.70710678, 0, 0);
    List<float2> hood = [
        float2(-0.042, -0.004), float2(0.042, -0.004), float2(0.042, 0.012),
        float2(0.039, 0.027), float2(0.032, 0.038), float2(0.020, 0.045),
        float2(0, 0.048), float2(-0.020, 0.045), float2(-0.032, 0.038),
        float2(-0.039, 0.027), float2(-0.042, 0.012)
    ];
    MicroduckPlate(geometry, hood, float3(0, 0, 0.0285), 0.085, 0.003, cream, true);
    List<float2> face = [
        float2(-0.038, -0.002), float2(0.038, -0.002), float2(0.038, 0.013),
        float2(0.035, 0.026), float2(0.028, 0.035), float2(0.018, 0.041),
        float2(0, 0.044), float2(-0.018, 0.041), float2(-0.028, 0.035),
        float2(-0.035, 0.026), float2(-0.038, 0.013)
    ];
    MicroduckPlate(geometry, face, float3(0, 0, 0.0713), 0.0018, 0.0005, Color(0.25, 0.28, 0.28));
    // A thin two-piece jaw, with the original mouth tip's forward projection.
    MicroduckCase(geometry, float3(0, -0.006, 0.030), float3(0.085, 0.003, 0.092), 0.0012, accent);
    MicroduckCase(geometry, float3(0, -0.00809334, 0.0767), float3(0.082, 0.0014, 0.002),
                  0.0005, Color(0.055, 0.065, 0.065));
    MicroduckCase(geometry, float3(0, -0.011, 0.030), float3(0.086, 0.0055, 0.0954766), 0.0022, cream);
    // Camera and ToF positions are the source sites, expressed in this frame.
    var camera = float3(-0.0000913778, 0.0155, 0.0733);
    MicroduckAxle(geometry, camera, float3(0, 0, 1), 0.0125, 0.0035, Color(0.72, 0.68, 0.56));
    MicroduckAxle(geometry, camera + float3(0, 0, 0.0021), float3(0, 0, 1),
                  0.0072, 0.0025, Color(0.035, 0.045, 0.05));
    MicroduckAxle(geometry, camera + float3(0, 0, 0.0035), float3(0, 0, 1),
                  0.0049, 0.0008, Color(0.055, 0.09, 0.105));
    MicroduckAxle(geometry, camera + float3(-0.0013, 0.0015, 0.004), float3(0, 0, 1),
                  0.0012, 0.0002, Color(0.32, 0.41, 0.42));
    MicroduckCase(geometry, float3(0.0224086, 0.0135, 0.0733), float3(0.008, 0.0045, 0.002),
                  0.0007, Color(0.025, 0.035, 0.04));
    for (int side = -1; side <= 1; side += 2)
    {
        MicroduckHub(geometry, float3(side * 0.0425, 0.004, -0.003), float3(side, 0, 0), 0.006, accent);
        for (int slot = 0; slot < 3; slot += 1)
            MicroduckCase(geometry, float3(side * 0.0414, 0.012 + slot * 0.005, 0.006),
                          float3(0.001, 0.002, 0.013), 0.0003, Color(0.27, 0.29, 0.28));
    }
}

MicroduckCachedPart MicroduckMakePart(int index, int seat, quaternion firstRotation)
{
    var cream = Color(0.91, 0.90, 0.84);
    var accent = seat == 0 ? Color(0.66, 0.56, 0.37) : Color(0.36, 0.53, 0.55);
    mut MicroduckGeometry geometry = MicroduckGeometry {
        worldRotation = firstRotation, rotation = quaternion.identity
    };
    if (index == 0) MicroduckTrunk(geometry, cream, accent);
    else if (index == 1 || index == 10) MicroduckHipYaw(geometry, cream);
    else if (index == 2 || index == 11) MicroduckHipRoll(geometry, cream);
    else if (index == 3 || index == 12) MicroduckThigh(geometry, index == 3, cream);
    else if (index == 4 || index == 13) MicroduckShin(geometry, index == 4, cream);
    else if (index == 5 || index == 14) MicroduckFoot(geometry, index == 5, cream, accent);
    else if (index == 6) MicroduckNeck(geometry, cream);
    else if (index == 7)
    {
        MicroduckBeam(geometry, float3(0), float3(0, 0.0186931, -0.0145),
                      0.015, 0.010, Color(0.52, 0.54, 0.51));
        MicroduckHub(geometry, float3(0, 0, 0.002), float3(0, 0, 1), 0.008, cream);
    }
    else if (index == 8)
    {
        MicroduckCase(geometry, float3(-0.004, 0, 0.0145), float3(0.027, 0.023, 0.024),
                      0.002, Color(0.085, 0.095, 0.10));
        MicroduckHub(geometry, float3(-0.0179, 0, 0.0145), float3(-1, 0, 0), 0.0075, cream);
    }
    else if (index == 9) MicroduckHead(geometry, cream, accent);
    return MicroduckCachedPart {
        vertices = geometry.vertices, triangles = geometry.triangles, made = true
    };
}

void MicroduckRobotPart(float3 position, quaternion originalRotation, int index, int seat,
                        mut MicroduckMeshes meshes)
{
    if (index < 0 || index >= 15) return;
    var palette = seat == 0 ? 0 : 1;
    var slot = palette * 15 + index;
    while (meshes.parts.count < 30) meshes.parts.Add(MicroduckCachedPart { });
    if (!meshes.parts[slot].made)
        meshes.parts[slot] = MicroduckMakePart(index, palette, originalRotation);
    // Stable local list handles let Draw retain the geometry between frames.
    // Warm draws only read the cached mesh and place it on the current joint.
    Draw.Mesh(meshes.parts[slot].vertices, meshes.parts[slot].triangles,
              float4x4.TRS(position, originalRotation, float3(1)));
}
