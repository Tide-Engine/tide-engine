string DuckJointName(int jointIndex)
{
    switch (jointIndex)
    {
        case 0: return "left_hip_yaw";
        case 1: return "left_hip_roll";
        case 2: return "left_hip_pitch";
        case 3: return "left_knee";
        case 4: return "left_ankle";
        case 5: return "neck_pitch";
        case 6: return "head_pitch";
        case 7: return "head_yaw";
        case 8: return "head_roll";
        case 9: return "right_hip_yaw";
        case 10: return "right_hip_roll";
        case 11: return "right_hip_pitch";
        case 12: return "right_knee";
        case 13: return "right_ankle";
    }
    return "";
}

string DuckBodyName(int bodyIndex)
{
    switch (bodyIndex)
    {
        case 0: return "trunk_base";
        case 1: return "yaw2roll";
        case 2: return "hip_l";
        case 3: return "upper_leg_left";
        case 4: return "leg";
        case 5: return "ankle_left";
        case 6: return "neck";
        case 7: return "neck_pitch";
        case 8: return "yaw_roll_motion";
        case 9: return "jaw_soft";
        case 10: return "bearing_roll";
        case 11: return "hip_l_2";
        case 12: return "upper_leg_right";
        case 13: return "leg_2";
        case 14: return "ankle_right";
    }
    return "";
}
