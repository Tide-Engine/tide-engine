// How Alley is lit. The engine has no lighting built in, so everything here
// is a mesh whose corners have a normal, drawn through a frag that lights each
// pixel from it: a lamp over the players' left shoulders, a cool light from
// the far right, the room's own glow, a shine where the lamp reflects, and
// the dark of the room for what's far. Shadows are flat discs on the lane,
// one for each thing, where the lamp's light would leave them.
using Box3D;

// A corner of a mesh: where it is, which way its face looks, and its paint.
struct Corner
{
    float3 position;
    float3 normal;
    Color color = Color.white;
    float mark; // A pin's stripe, or how much of its paint is its own light
}

// The meshes, made once: a pin, a ball and a crate to draw at every body's
// place, the scenery, which never moves, as one mesh where it is, and a flat
// square for what's painted on the lane.
local singleton Models
{
    List<Corner> pin;
    List<int> pinFaces;
    List<Corner> ball;
    List<int> ballFaces;
    List<Corner> cube;
    List<int> cubeFaces;
    List<Corner> scenery;
    List<int> sceneryFaces;
    List<Corner> plate;
    List<int> plateFaces;
    bool made;
}

// What the frags read of the camera and of the room.
local singleton Room
{
    float3 eye;  // Where the camera is, for what shines
    float low;   // How far gravity has let go, 0 to 1: the room's light cools
    float goal;  // The goal's light: 1 as something goes through it, fading
}

// Something flat on the lane: a shadow, a player's place on the line, a dot
// of the way a ball would go. One of a list, all drawn at once.
struct Decal
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.black;
    float square; // From a disc, 0, to a square, 1
    float ring;   // Only its rim, this much of its radius wide, when it's above 0
}

// A spark: a small cube that glows. One of a list too.
struct Mote
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
}

// Where the lamp is, from anywhere.
float3 Lamp()
{
    return Math.Normalize(float3(-0.45, 0.8, -0.4));
}

// A surface's paint in the room's light.
Color Lit(Color paint, float3 normal, float3 world, Room room, float gloss)
{
    float3 lamp = Lamp();
    float3 toEye = Math.Normalize(room.eye - world);
    float direct = Math.Max(Math.Dot(normal, lamp), 0);
    float fill = Math.Max(Math.Dot(normal, Math.Normalize(float3(0.6, 0.2, 0.75))), 0);
    float sky = 0.34 + 0.16 * normal.y;
    float shine = Math.Pow(Math.Max(Math.Dot(normal, Math.Normalize(lamp + toEye)), 0), 26) * gloss;
    float rim = Math.Pow(1 - Math.Max(Math.Dot(normal, toEye), 0), 3) * 0.14;
    float3 base = float3(paint.r, paint.g, paint.b);
    // The room's light is cooler while gravity is low
    float3 cool = float3(0.5, 0.72, 1);
    mut float3 lit = base * (sky + direct * 0.68) + base * cool * (fill * 0.26) + float3(shine) + cool * rim;
    lit = lit * (float3(1) + (cool - float3(0.9)) * (room.low * 0.5));
    // What's far sinks into the dark of the room
    float far = Math.Saturate((Math.Distance(room.eye, world) - 17) / 30) * 0.6;
    lit = lit + (float3(0.086, 0.086, 0.094) - lit) * far;
    return Color(lit.x, lit.y, lit.z, paint.a);
}

// The scenery: the lane's boards run its length, each a little unlike the
// next, and what's marked glows by its own light. The goal's glow is brighter
// while something goes through it.
frag LaneLook(Corner corner, mut Color color, Pixel pixel, Room room)
{
    if (corner.mark > 0.5)
    {
        float lift = corner.mark > 1.5 ? 0.55 + room.goal * 0.9 : 0.85;
        color = Color(corner.color.r * lift, corner.color.g * lift, corner.color.b * lift, 1);
        return;
    }
    mut Color paint = corner.color;
    if (corner.normal.y > 0.5 && pixel.world.y > -0.05)
    {
        float across = (pixel.world.x + LANE_WIDTH / 2) / 0.375;
        float tone = 0.94 + (Math.Hash(int2(int(Math.Floor(across)), 3)) % 100) * 0.0012;
        float seam = Math.Abs(Math.Frac(across) - 0.5) > 0.47 ? 0.84 : 1;
        paint = Color(paint.r * tone * seam, paint.g * tone * seam, paint.b * tone * seam, 1);
    }
    color = Lit(paint, corner.normal, pixel.world, room, corner.normal.y > 0.5 ? 0.5 : 0);
}

// Anything of one color: the bar, a kingpin's head, a ball that waits.
frag Solid(Corner corner, mut Color color, Instance instance, Pixel pixel, Room room)
{
    color = Lit(corner.color, Math.Normalize(Math.Rotate(instance.transform, corner.normal)), pixel.world, room, 0.7);
}

// A pin reads its entity's component: whose color it is, and the flash a
// hit left, which is a local field. One nobody has painted is white with a
// red stripe, and a painted one is its player's color with a white stripe.
frag PinLook(Corner corner, mut Color color, Instance instance, Pixel pixel, Room room, Target target)
{
    Color seat = SeatColor(target.last);
    mut Color paint = target.last < 0 ? (corner.mark > 0.5 ? Color(0.86, 0.2, 0.26) : Color(0.95, 0.95, 0.93))
                : (corner.mark > 0.5 ? Color.white : seat);
    paint = Mix(paint, Color.white, target.hit);
    color = Lit(paint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)), pixel.world, room, 0.9);
}

// A crate has a frame around each face, a shade darker.
frag CrateLook(Corner corner, mut Color color, Instance instance, Pixel pixel, Room room, Target target)
{
    float3 at = float3(Math.Abs(corner.position.x), Math.Abs(corner.position.y), Math.Abs(corner.position.z));
    // The middle one of the three is how near the face's edge this is
    float edge = at.x + at.y + at.z - Math.Max(at.x, Math.Max(at.y, at.z)) - Math.Min(at.x, Math.Min(at.y, at.z));
    mut Color paint = target.last < 0 ? Color(0.63, 0.65, 0.72) : SeatColor(target.last);
    float tone = edge > 0.4 ? 0.72 : edge > 0.36 ? 0.86 : 1;
    paint = Mix(Color(paint.r * tone, paint.g * tone, paint.b * tone, 1), Color.white, target.hit);
    color = Lit(paint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)), pixel.world, room, 0.25);
}

// A ball has a white band around it, so that its spin shows.
frag BallLook(Corner corner, mut Color color, Instance instance, Pixel pixel, Room room, Ball ball)
{
    Color paint = Math.Abs(corner.position.y) < 0.2 ? Color.white : SeatColor(ball.seat);
    color = Lit(paint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)), pixel.world, room, 1.1);
}

// What's flat on the lane: a disc or a square that fades at its edge, or a
// ring. Past the lane's sides there's nothing to be on.
frag DecalLook(Corner corner, mut Color color, Decal decal, Pixel pixel)
{
    if (Math.Abs(pixel.world.x) > LANE_WIDTH / 2 || pixel.world.z > LANE_END || pixel.world.z < LANE_START) pixel.Discard();
    float2 at = float2(corner.position.x, corner.position.z) * 2;
    float round = Math.Length(at);
    float boxy = Math.Max(Math.Abs(at.x), Math.Abs(at.y));
    float far = round + (boxy - round) * decal.square;
    mut float shown = Math.Saturate((1 - far) * 2.4);
    if (decal.ring > 0) shown = shown * Math.Saturate((far - (1 - decal.ring) + 0.12) * 8);
    color = Color(decal.tint.r, decal.tint.g, decal.tint.b, decal.tint.a * shown * shown);
}

frag MoteLook(Corner corner, mut Color color, Mote mote)
{
    color = mote.tint;
}

// A box's six faces, four corners each, added to a mesh.
void AddBox(mut List<Corner> corners, mut List<int> faces, float3 center, float3 size, Color color, float mark)
{
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        float way = face % 2 == 0 ? 1 : -1;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        var first = corners.count;
        for (var i = 0; i < 4; i++)
        {
            float a = i == 0 || i == 3 ? -0.5 : 0.5;
            float b = i < 2 ? -0.5 : 0.5;
            corners.Add(Corner { position = center + (normal * 0.5 + across * a + up * b) * size, normal = normal, color = color,
                                 mark = mark });
        }
        faces.Add(first);
        faces.Add(first + 1);
        faces.Add(first + 2);
        faces.Add(first);
        faces.Add(first + 2);
        faces.Add(first + 3);
    }
}

// A shape turned around the y axis: rings of 16 corners, one for each point
// of its outline, which is a radius and a height. A ring's face looks the way
// the outline leans there. The rings from `from` to `to` are marked.
void AddTurned(mut List<Corner> corners, mut List<int> faces, List<float2> outline, int from, int to)
{
    var first = corners.count;
    for (var ring = 0; ring < outline.count; ring++)
    {
        var before = outline[Math.Max(ring - 1, 0)];
        var after = outline[Math.Min(ring + 1, outline.count - 1)];
        // Along the outline, and square to it: out, and up or down
        var lean = Math.Normalize(float2(after.y - before.y, before.x - after.x));
        for (var step = 0; step <= 16; step++)
        {
            float around = step * Math.TAU / 16;
            var spoke = float3(Math.Cos(around), 0, Math.Sin(around));
            corners.Add(Corner { position = spoke * outline[ring].x + float3(0, outline[ring].y, 0),
                                 normal = Math.Normalize(spoke * lean.x + float3(0, lean.y, 0)),
                                 mark = ring >= from && ring <= to ? 1 : 0 });
            if (ring == outline.count - 1 || step == 16) continue;
            int at = first + ring * 17 + step;
            faces.Add(at);
            faces.Add(at + 17);
            faces.Add(at + 1);
            faces.Add(at + 1);
            faces.Add(at + 17);
            faces.Add(at + 18);
        }
    }
}

void MakeModels(mut Models models)
{
    models.made = true;
    // A pin, as bowling's are: a belly, a neck with a stripe around it and a
    // head, inside the capsule that Box3D knocks over
    List<float2> pin = [float2(0, -0.45), float2(0.09, -0.45), float2(0.125, -0.4), float2(0.155, -0.27), float2(0.16, -0.12),
                        float2(0.14, 0.02), float2(0.095, 0.14), float2(0.075, 0.2), float2(0.073, 0.26), float2(0.093, 0.33),
                        float2(0.098, 0.38), float2(0.07, 0.43), float2(0, 0.45)];
    AddTurned(models.pin, models.pinFaces, pin, 6, 8);
    // A ball: a half circle, turned
    mut List<float2> ball = [];
    for (var i = 0; i <= 12; i++)
        ball.Add(float2(Math.Sin(i * Math.PI / 12), -Math.Cos(i * Math.PI / 12)));
    AddTurned(models.ball, models.ballFaces, ball, 99, 99);
    AddBox(models.cube, models.cubeFaces, float3(0), float3(1), Color.white, 0);
    models.plate = [Corner { position = float3(-0.5, 0, -0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(0.5, 0, -0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(0.5, 0, 0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(-0.5, 0, 0.5), normal = float3(0, 1, 0) }];
    models.plateFaces = [0, 1, 2, 0, 2, 3];

    // The lane, with a light along each side; the line the players stand
    // behind, and arrows down the lane to aim by; and the goal past its far
    // end, a gate of light that what scores falls through
    var middle = (LANE_START + LANE_END) / 2;
    var length = LANE_END - LANE_START;
    var wood = Color(0.3, 0.33, 0.4);
    AddBox(models.scenery, models.sceneryFaces, float3(0, -0.5, middle), float3(LANE_WIDTH, 1, length), wood, 0);
    for (var side = -1; side <= 1; side += 2)
        AddBox(models.scenery, models.sceneryFaces, float3(side * (LANE_WIDTH / 2 - 0.05), 0.005, middle), float3(0.07, 0.012, length),
               AMBER, 1);
    AddBox(models.scenery, models.sceneryFaces, float3(0, 0.005, 1.25), float3(LANE_WIDTH - 0.3, 0.012, 0.07), Color(0.75, 0.77, 0.82), 1);
    for (var i = -2; i <= 2; i++)
        AddBox(models.scenery, models.sceneryFaces, float3(i * 0.9, 0.005, 3.4 - Math.Abs(i) * 0.35), float3(0.1, 0.012, 0.55),
               Color(0.42, 0.45, 0.52), 1);
    AddBox(models.scenery, models.sceneryFaces, float3(0, 0.005, LANE_END - 0.09), float3(LANE_WIDTH, 0.014, 0.18), ROSE, 2);
    for (var side = -1; side <= 1; side += 2)
        AddBox(models.scenery, models.sceneryFaces, float3(side * (LANE_WIDTH / 2 + 0.25), 1.3, LANE_END + 0.25), float3(0.22, 4.6, 0.22),
               ROSE, 2);
    AddBox(models.scenery, models.sceneryFaces, float3(0, 3.6, LANE_END + 0.25), float3(LANE_WIDTH + 0.72, 0.22, 0.22), ROSE, 2);
}
