// What makes Alley feel alive is this machine's own: sparks where a ball
// lands, numbers that float up from the goal, a camera that shakes. None of
// it is in the match. The match says what happens in it with events, and this
// machine's handlers of them add an effect here. Each hears an event once,
// however often this machine runs its tick again, and a `verified` one waits
// until the server has confirmed it: a score is never shown for a pin this
// machine only predicted falling.
using Box3D;

// Something small that flies, glows, fades and is gone, over the lane.
struct Spark
{
    float3 position;
    float3 velocity;
    Color color = Color.white;
    float age;
    float life = 0.5;
    float size = 0.06;
    float weight; // How much of gravity pulls it
}

// What a target was worth, floating up from where it went through the goal.
struct Label
{
    float3 at;
    Color color = Color.white;
    float age;
    float life = 1.4;
    int seat;
    int amount;
    bool mine;
}

// A piece of the paper thrown over the screen, in its pixels.
struct Bit
{
    float2 position;
    float2 velocity;
    Color color = Color.white;
    float age;
    float life = 1.5;
    float size = 6;
    float angle;
    float spin;
}

// How long ago the match said things, for the words over the lane (hud.tide).
local singleton Flow
{
    int winner = -1;     // Who took the round that ended last: a seat, or -1 for nobody
    int round;
    int best;
    float since = 100;   // Seconds since a round ended...
    bool papered;        // ...and its winner's paper was thrown
    int set;             // The round that was set up last...
    float begun = 100;   // ...and how long ago
    float lifted = 100;  // Seconds since gravity let go, or took hold again
    float played;        // Seconds since this machine's player first threw
}

void Shake(mut Fx fx, float amount)
{
    fx.trauma = Math.Min(1, fx.trauma + amount);
}

void Flash(mut Fx fx, Color color, float amount)
{
    if (amount < fx.flash) return;
    fx.flash = amount;
    fx.flashColor = color;
}

// Sparks thrown every way but down.
void Burst(mut Fx fx, float3 at, int count, float speed, Color color)
{
    if (fx.sparks.count > 500) return;
    for (var i = 0; i < count; i++)
    {
        var way = fx.random.NextFloat3Direction();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        fx.sparks.Add(Spark { position = at, velocity = float3(way.x, Math.Abs(way.y) + 0.3, way.z) * speed * (0.4 + pace),
                              color = color, life = 0.3 + long * 0.4, size = 0.07, weight = 1 });
    }
}

// Paper thrown over the screen.
void Paper(mut Fx fx, float2 at, int count, float speed, Color color)
{
    if (fx.paper.count > 400) return;
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var big = fx.random.NextFloat();
        var tone = fx.random.NextFloat();
        var angle = turn * Math.TAU;
        fx.paper.Add(Bit { position = at, velocity = float2(Math.Cos(angle), Math.Sin(angle) - 0.7) * speed * (0.25 + pace),
                           color = tone < 0.25 ? Color.white : Shade(color, 0.7 + tone * 0.5), life = 1.2 + long * 1.2,
                           size = 4 + big * 5, angle = angle, spin = (turn - 0.5) * 24 });
    }
}

// A ball hit this target: it flashes, which its view lets fade, and sparks
// fly in the color it was just painted.
local event(Struck) Knocked(Body body, mut Target target, mut Fx fx)
{
    target.hit = 1;
    Burst(fx, body.position, 4, 3.2, Mix(SeatColor(target.last), Color.white, 0.45));
}

// This machine's own ball leaves its hand: the camera feels it.
local event(Spawned) Thrown(Ball ball, mut Fx fx)
{
    if (ball.seat == fx.seat) Shake(fx, 0.06);
}

// Something went through the goal: once that's certain, the goal lights up,
// and what it was worth floats up from where it went, in the color of whoever
// painted it, whose score jumps.
local event(verified Through through) Tally(mut Fx fx, mut Room room)
{
    room.goal = 1;
    if (through.seat < 0) return;
    var color = SeatColor(through.seat);
    var at = float3(Math.Clamp(through.at.x, -LANE_WIDTH / 2, LANE_WIDTH / 2), 0.5, LANE_END - 0.3);
    fx.pops[through.seat] = 1;
    // What a player scores in one go is one number: the bar sends pins through by the dozen
    mut var counted = false;
    for (var i = 0; i < fx.labels.count && !counted; i++)
    {
        mut var label = fx.labels[i];
        if (label.seat != through.seat || label.age > 0.35) continue;
        label.amount += through.worth;
        label.at = (label.at + at) * 0.5;
        label.age = Math.Min(label.age, 0.12);
        fx.labels[i] = label;
        counted = true;
    }
    if (!counted) fx.labels.Add(Label { at = at, color = color, seat = through.seat, amount = through.worth, mine = through.seat == fx.seat });
    Burst(fx, at, through.worth >= 5 ? 18 : 6, 4.5, Mix(color, Color.white, 0.4));
    if (through.worth < 5) return;
    // A kingpin
    Burst(fx, at, 14, 6, GOLD);
    Shake(fx, 0.3);
}

local event(Lifted lifted) Floated(mut Fx fx, mut Flow flow)
{
    flow.lifted = 0;
    Shake(fx, lifted.low ? 0.3 : 0.5);
    Flash(fx, lifted.low ? TEAL : Color.white, 0.16);
}

local event(Swept) BarOff(mut Fx fx)
{
    Shake(fx, 0.25);
}

// Who took a round is only said once it's certain.
local event(verified RoundOver over) RoundTold(mut Flow flow)
{
    flow.winner = over.winner;
    flow.round = over.round;
    flow.best = over.best;
    flow.since = 0;
    flow.papered = false;
}

local event(RoundSet set) RoundShown(mut Flow flow)
{
    flow.set = set.round;
    flow.begun = 0;
}

// Gravity as the match has it, for the room's light and for what falls here.
// While it's low, motes rise off the lane.
[Stage(Layers.Camera, 5)]
view Weigh(Lane lane, mut Room room, mut Flow flow, mut Fx fx)
{
    room.low = Math.Saturate(room.low + (lane.low ? 1 : -1) * fx.dt * 3);
    flow.since += fx.dt;
    flow.begun += fx.dt;
    flow.lifted += fx.dt;
    if (fx.thrown) flow.played += fx.dt;
    if (!lane.low || fx.sparks.count > 300 || fx.random.NextFloat() > fx.dt * 40) return;
    var across = fx.random.NextFloat(-LANE_WIDTH / 2, LANE_WIDTH / 2);
    var along = fx.random.NextFloat(1, LANE_END);
    fx.sparks.Add(Spark { position = float3(across, 0.05, along), velocity = float3(0, 0.7, 0), color = Fade(TEAL, 0.7),
                          life = 2.2, size = 0.035 });
}

// The sparks, each a small cube that glows: they fall, bounce off the lane
// and fade. All of them are one draw, added to what's behind them.
[Stage(Layers.Effects)]
view Sparks(mut Fx fx, Room room, Models models)
{
    var pull = -10 + room.low * 8.4;
    fx.motes.Clear();
    mut var i = 0;
    while (i < fx.sparks.count)
    {
        mut var spark = fx.sparks[i];
        spark.age += fx.dt;
        if (spark.age >= spark.life)
        {
            fx.sparks.RemoveAt(i);
            continue;
        }
        spark.velocity.y += pull * spark.weight * fx.dt;
        spark.position += spark.velocity * fx.dt;
        var over = Math.Abs(spark.position.x) < LANE_WIDTH / 2 && spark.position.z > LANE_START && spark.position.z < LANE_END;
        if (over && spark.position.y < 0.03 && spark.velocity.y < 0)
        {
            spark.position.y = 0.03;
            spark.velocity = float3(spark.velocity.x * 0.6, -spark.velocity.y * 0.4, spark.velocity.z * 0.6);
        }
        fx.sparks[i] = spark;
        var left = 1 - spark.age / spark.life;
        fx.motes.Add(Mote { transform = float4x4.TRS(spark.position, quaternion.identity, float3(spark.size * (0.4 + 0.6 * left))),
                            tint = Fade(spark.color, left * 1.6) });
        i++;
    }
    Draw.Blend(Blend.Add)
    {
        Draw3D.Instanced(models.cube, models.cubeFaces, fx.motes, MoteLook);
    }
}
