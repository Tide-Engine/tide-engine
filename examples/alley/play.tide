// Alley, as one machine shows it: the camera, the lane and what's on it.
// Views read the match and never change it: what they write is this machine's
// own (Hand, Fx, Room, and the local fields of a target and a ball). The
// light is in light.tide, the sparks and the numbers in effects.tide, the
// scores and the buttons in hud.tide, and the lobby in lobby.tide.
using Box3D;

// The docs site's colors, and a few more for eight players.
const Color BACK = Color(0.086, 0.086, 0.094);
const Color RAISED = Color(0.17, 0.175, 0.19);
const Color LINE = Color(0.24, 0.25, 0.27);
const Color QUIET = Color(0.64, 0.64, 0.68);
const Color INK = Color(0.93, 0.93, 0.95);
const Color AMBER = Color(0.98, 0.75, 0.14);
const Color TEAL = Color(0.18, 0.83, 0.75);
const Color ROSE = Color(0.98, 0.44, 0.52);
const Color BLUE = Color(0.47, 0.72, 1);
const Color VIOLET = Color(0.66, 0.58, 1);
const Color GREEN = Color(0.4, 0.92, 0.56);
const Color ORANGE = Color(1, 0.55, 0.2);
const Color LIME = Color(0.78, 0.92, 0.3);
const Color PLAIN = Color(0.86, 0.87, 0.9); // What nobody has painted
const Color GOLD = Color(1, 0.86, 0.36);    // A kingpin's head

// What draws over what, whichever file a view is in.
enum Layers { Camera, Pieces, Lane, Effects, Hud, Menu }

// How far over the lane what's flat on it is drawn, so that the lane, which
// is in the same place, doesn't show through it.
const float ON_LANE = 0.006;

// Where this machine's player points on the lane, and the spin they've set,
// which its input sends.
local singleton Hand
{
    float2 target = float2(0, 12);
    float spin;
    bool known;   // Not before the pointer was ever on this window
    bool playing; // No lobby or menu is up: the player's hands are on the ball
}

// What this machine's drawing keeps from frame to frame. None of it is the
// match's.
local singleton Fx
{
    float dt;        // Seconds this frame's effects move on by: a stall isn't a leap
    float beat;      // Radians, for what pulses: always under a full turn
    int seat = -1;   // This machine's player's, once it has a bowler
    float2 mine;     // ...and where on the screen its place on the line is
    bool thrown;     // The player has found out how
    bool spun;       // ...and that a ball can curve
    float trauma;    // How hard the camera shakes, 0 to 1
    float flash;     // The whole screen lit, fading
    Color flashColor = Color.white;
    Random random;   // What rolls the effects: this machine's own
    List<float> pops;     // Each seat's score, just counted up: 1, fading
    List<Decal> decals;   // What's flat on the lane this frame: shadows and marks, the later over the earlier
    List<Spark> sparks;
    List<Mote> motes;     // ...as they're drawn
    List<Label> labels;
    List<Bit> paper;      // In the screen's pixels, over everything
}

Color SeatColor(int seat)
{
    return seat == 0 ? AMBER : seat == 1 ? TEAL : seat == 2 ? ROSE : seat == 3 ? BLUE
         : seat == 4 ? VIOLET : seat == 5 ? GREEN : seat == 6 ? ORANGE : seat == 7 ? LIME : PLAIN;
}

string SeatName(int seat)
{
    return seat == 0 ? "AMBER" : seat == 1 ? "TEAL" : seat == 2 ? "ROSE" : seat == 3 ? "BLUE"
         : seat == 4 ? "VIOLET" : seat == 5 ? "GREEN" : seat == 6 ? "ORANGE" : "LIME";
}

Color Shade(Color color, float light)
{
    return Color(Math.Saturate(color.r * light), Math.Saturate(color.g * light), Math.Saturate(color.b * light), color.a);
}

Color Fade(Color color, float alpha)
{
    return Color(color.r, color.g, color.b, color.a * Math.Saturate(alpha));
}

Color Mix(Color from, Color to, float t)
{
    return from + (to - from) * Math.Saturate(t);
}

float2 Turned(float2 offset, float angle)
{
    var c = Math.Cos(angle);
    var s = Math.Sin(angle);
    return float2(offset.x * c - offset.y * s, offset.x * s + offset.y * c);
}

float EaseOut(float t)
{
    var left = 1 - Math.Saturate(t);
    return 1 - left * left * left;
}

// Past its end and back, like something that lands.
float EaseBack(float t)
{
    var left = Math.Saturate(t) - 1;
    return 1 + left * left * (2.70158 * left + 1.70158);
}

// The shadow of something that reaches from `a` to `b` and is `radius` thick:
// where the lamp's light would leave it on the lane, fainter the higher it is.
void Shadow(mut Fx fx, float3 a, float3 b, float radius, float square)
{
    var height = (a.y + b.y) * 0.5;
    if (height < -0.4 || height > 9) return;
    var lamp = Lamp();
    var from = float3(a.x - a.y * lamp.x / lamp.y, 0, a.z - a.y * lamp.z / lamp.y);
    var to = float3(b.x - b.y * lamp.x / lamp.y, 0, b.z - b.y * lamp.z / lamp.y);
    var along = to - from;
    var reach = Math.Length(along);
    var wide = radius * 2.6;
    fx.decals.Add(Decal { transform = float4x4.TRS((from + to) * 0.5 + float3(0, ON_LANE, 0),
                                                 quaternion.AxisAngle(float3(0, 1, 0), reach > 0.01 ? Math.Atan2(along.x, along.z) : 0),
                                                 float3(wide, 1, reach + wide)),
                          tint = Color(0, 0, 0.02, 0.52 * Math.Saturate(1 - height / 8)), square = square });
}

// A mark painted on the lane: a disc, or a ring.
void Mark(mut Fx fx, float3 at, float size, Color tint, float ring)
{
    fx.decals.Add(Decal { transform = float4x4.TRS(float3(at.x, ON_LANE, at.z), quaternion.identity, float3(size, 1, size)),
                          tint = tint, ring = ring });
}

// The camera, behind the players and above them, looking down the lane: from
// higher up in a tall window, where the lane has to fit its width. And where
// the pointer is on the lane: a ray from the camera through its pixel, down
// to the height a ball rolls at.
[Stage(Layers.Camera)]
view Look(Devices devices, mut Hand hand, mut Fx fx, mut Models models, mut Room room)
{
    if (!models.made) MakeModels(models);
    while (fx.pops.count < SEATS) fx.pops.Add(0);
    fx.dt = Math.Min(Frame.dt, 0.05);
    fx.beat += fx.dt * 3;
    if (fx.beat > Math.TAU) fx.beat -= Math.TAU;
    fx.trauma = Math.Max(0, fx.trauma - fx.dt * 1.8);
    fx.flash = Math.Max(0, fx.flash - fx.dt * 2.4);
    room.goal = Math.Max(0, room.goal - fx.dt * 1.6);
    for (var seat = 0; seat < SEATS; seat++)
        fx.pops[seat] = Math.Max(0, fx.pops[seat] - fx.dt * 2.2);
    fx.decals.Clear();
    fx.seat = -1;

    // Near enough that the pins are worth looking at: the players' places on
    // the line are under the window's bottom edge, but in an upright window,
    // which has the height to show the lane whole
    var screen = float2(Screen.width, Screen.height);
    var shape = screen.x / screen.y;
    var wide = Math.Saturate((shape - 0.94) / 0.66);
    var tall = Math.Saturate((0.94 - shape) / 0.44);
    var eye = float3(0, 6.5 - wide * 1.3 + tall * 6, -1.5 - wide * 1.1 - tall * 3);
    var at = float3(0, 0.2 * wide, 9.4 + wide * 0.1 - tall * 1.4);
    var fov = 47 - wide * 5 + tall * 3;
    var turned = quaternion.LookRotation(Math.Normalize(at - eye), float3(0, 1, 0));
    Draw3D.SetCamera(eye, turned, fov);

    var pixel = Screen.Flip(devices.pointer.position);
    var from = Draw3D.ScreenRayOrigin(pixel);
    var along = Draw3D.ScreenRayDirection(pixel);
    if (Math.LengthSq(devices.pointer.delta) > 0 || devices.pointer.press.pressed) hand.known = true;
    if (hand.known)
    {
        // A pixel over the lane's far end is as far down the lane as it gets
        float reach = along.y < -0.02 ? Math.Min((BALL - from.y) / along.y, 80) : 80;
        hand.target = float2(from.x + along.x * reach, from.z + along.z * reach);
    }
    if (hand.playing && (devices.pointer.press.pressed || devices.keyboard.space.pressed)) fx.thrown = true;
    var keys = devices.keyboard;
    float turn = (keys.d.pressed || keys.rightArrow.pressed ? 1 : 0) - (keys.a.pressed || keys.leftArrow.pressed ? 1 : 0);
    if (hand.playing && turn != 0)
    {
        hand.spin = Math.Clamp(hand.spin + turn * fx.dt * 1.5, -1, 1);
        fx.spun = true;
    }

    // It shakes when something big happens, which the pointer's place is worked out without
    var wobble = fx.beat * 23;
    var shake = float3(Math.Sin(wobble) + Math.Sin(wobble * 0.62 + 1.3) * 0.6,
                       Math.Sin(wobble * 0.89 + 2.1) + Math.Sin(wobble * 0.54 + 0.4) * 0.6, 0) * (fx.trauma * fx.trauma * 0.22);
    room.eye = eye + shake;
    Draw3D.SetCamera(room.eye, turned, fov);

    // The room behind the lane: the goal's light, where the lane ends
    Draw2D.Clear(BACK);
    var end = Draw3D.WorldToScreen(float3(0, -1, LANE_END + 1));
    Draw2D.Screen()
    {
        Draw2D.Shape(Shape { center = float2(end.x, end.y), size = float2(screen.x * 0.5, screen.y * 0.16), ellipse = true,
                             color = Fade(ROSE, 0.1 + room.goal * 0.16), soft = Math.Max(screen.x, screen.y) * 0.28 });
    }
    Draw3D.Mesh(models.scenery, models.sceneryFaces, float4x4.identity, LaneLook);
}

// The goal is lit while something falls through it.
[Stage(Layers.Pieces)]
view Goals(Goal goal, mut Room room)
{
    if (goal.inside > 0) room.goal = Math.Max(room.goal, 0.7);
}

// A view sees a body where the last step left it, blended between ticks, and
// gliding to where the server says it is when this machine guessed otherwise.
// Instances of one mesh drawn in a row are one draw, each with its own
// transform and its own entity's `Target`.
[Stage(Layers.Pieces)]
view Pins(Body body, mut Target target, Models models, mut Fx fx, with Capsule)
{
    target.hit = Math.Max(0, target.hit - fx.dt * 4);
    Draw3D.Mesh(models.pin, models.pinFaces, float4x4.TRS(body.position, body.rotation, float3(1)), PinLook);
    var up = Math.Rotate(body.rotation, float3(0, 1, 0));
    Shadow(fx, body.position - up * 0.3, body.position + up * 0.34, 0.15, 0);
}

// A kingpin's head is its third shape, a sphere at an offset from its body.
// It's gold: a kingpin is worth five.
[Stage(Layers.Pieces, 1)]
view Heads(Body body, Sphere sphere, Models models, with Target)
{
    var at = body.position + Math.Rotate(body.rotation, sphere.offset);
    Draw.Tint(GOLD)
    {
        Draw3D.Mesh(models.ball, models.ballFaces, float4x4.TRS(at, body.rotation, float3(sphere.radius)), Solid);
    }
}

[Stage(Layers.Pieces, 2)]
view Crates(Body body, Box box, mut Target target, Models models, mut Fx fx, without Capsule)
{
    target.hit = Math.Max(0, target.hit - fx.dt * 4);
    Draw3D.Mesh(models.cube, models.cubeFaces, float4x4.TRS(body.position, body.rotation, box.size), CrateLook);
    var ahead = Math.Rotate(body.rotation, float3(0, 0, 1));
    Shadow(fx, body.position - ahead * 0.02, body.position + ahead * 0.02, box.size.x * 0.52, 0.8);
}

// A ball, and the streak it leaves on the lane: `rolled`, a local field, is
// where its last mark was.
[Stage(Layers.Pieces, 3)]
view Balls(Body body, Sphere sphere, mut Ball ball, Models models, mut Fx fx)
{
    Draw3D.Mesh(models.ball, models.ballFaces, float4x4.TRS(body.position, body.rotation, float3(sphere.radius)), BallLook);
    Shadow(fx, body.position, body.position, sphere.radius * 0.85, 0);
    if (!ball.rolling)
    {
        ball.rolling = true;
        ball.rolled = body.position;
    }
    else if (Math.Distance(body.position, ball.rolled) > 0.45 && fx.sparks.count < 500)
    {
        ball.rolled = body.position;
        if (body.position.y < BALL + 0.3)
            fx.sparks.Add(Spark { position = float3(body.position.x, 0.05, body.position.z), color = Fade(SeatColor(ball.seat), 0.6),
                                  life = 0.45, size = 0.11 });
    }
}

[Stage(Layers.Pieces, 4)]
view Bars(Body body, Box box, Sweeper sweeper, Models models, mut Fx fx)
{
    Draw.Tint(sweeper.sweeping ? Mix(ROSE, Color.white, 0.3) : Shade(ROSE, 0.7))
    {
        Draw3D.Mesh(models.cube, models.cubeFaces, float4x4.TRS(body.position, body.rotation, box.size), Solid);
    }
    Shadow(fx, body.position - float3(box.size.x * 0.45, 0, 0), body.position + float3(box.size.x * 0.45, 0, 0), 0.3, 0.9);
}

// Each player's place on the line: a ring in their color, and the ball
// they'd throw next, which grows back after a throw.
[Stage(Layers.Pieces, 5)]
view Bowlers(Bowler bowler, Models models, mut Fx fx)
{
    var way = Math.Normalize(float3(bowler.aim.x, 0, bowler.aim.y));
    var ready = 1 - bowler.reload / float(RELOAD);
    var color = SeatColor(bowler.seat);
    var at = Stand(bowler.seat) + way * 0.7;
    Draw.Tint(color)
    {
        Draw3D.Mesh(models.ball, models.ballFaces, float4x4.TRS(at, quaternion.identity, float3(BALL * (0.4 + 0.6 * ready))), Solid);
    }
    Shadow(fx, at, at, BALL * (0.4 + 0.6 * ready) * 0.85, 0);
    Mark(fx, Stand(bowler.seat), 0.62, Fade(color, 0.9), 0.3);
}

// This machine's player's own has dots down the lane, the way their ball
// would go, bent by the spin they've set, and a ring where they point: both
// follow the pointer as it is this frame, ahead of the match's tick. `with
// ownership` picks the entities this machine's player owns.
[Stage(Layers.Pieces, 6)]
view Mine(Bowler bowler, Hand hand, Lane lane, mut Fx fx, with ownership)
{
    fx.seat = bowler.seat;
    var from = Stand(bowler.seat);
    var place = Draw3D.WorldToScreen(from + float3(0, 0.2, -0.75));
    fx.mine = float2(place.x, place.y);
    var pulse = 0.5 + 0.5 * Math.Sin(fx.beat * 2);
    Mark(fx, from, 0.86 + (fx.thrown ? 0 : 0.14 * pulse), Color.white, 0.2);
    if (!hand.known || !hand.playing || lane.phase != Phase.Play) return;
    var way = Way(bowler.seat, hand.target);
    var side = float3(way.z, 0, -way.x);
    var color = Mix(SeatColor(bowler.seat), Color.white, 0.55);
    // What the lane's grip makes of the spin: about this far across, by how
    // far down the lane the ball is
    for (var i = 1; i <= 15; i++)
    {
        var far = 0.9 + i * 0.85;
        var at = from + way * far + side * (hand.spin * 0.006 * far * far);
        Mark(fx, at, 0.27 - i * 0.006, Fade(color, 1 - i * 0.05), 0);
    }
    Mark(fx, float3(hand.target.x, 0, Math.Max(hand.target.y, 3)), 0.7, Fade(Color.white, 0.8), 0.22);
}

// The shadows and the marks, all at once, flat on the lane: after what stands
// on it, which they're under. They read depth and write none, so what's in
// front hides them, and where two overlap the later one goes over the other.
[Stage(Layers.Lane)]
view Decals(Fx fx, Models models)
{
    Draw.Depth(Depth.Read)
    {
        Draw3D.Instanced(models.plate, models.plateFaces, fx.decals, DecalLook);
    }
}
