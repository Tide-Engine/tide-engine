// Alley, as one machine shows it: the camera, the lane and what's on it, the
// scores and the menu. Views read the match and never change it: what they
// write is this machine's own (Hand, Fx, Models, Menu, and a target's `hit`).
//
// The engine has no lighting, so everything here is a mesh whose corners have
// a normal, drawn through a frag that lights each pixel from it.
using Box3D;

// The docs site's colors, and a few more for eight players.
const Color BACK = Color(0.086, 0.086, 0.094);
const Color LINE = Color(0.24, 0.25, 0.27);
const Color QUIET = Color(0.64, 0.64, 0.68);
const Color AMBER = Color(0.98, 0.75, 0.14);
const Color TEAL = Color(0.18, 0.83, 0.75);
const Color ROSE = Color(0.98, 0.44, 0.52);
const Color BLUE = Color(0.47, 0.72, 1);
const Color VIOLET = Color(0.66, 0.58, 1);
const Color GREEN = Color(0.4, 0.92, 0.56);
const Color ORANGE = Color(1, 0.55, 0.2);
const Color LIME = Color(0.78, 0.92, 0.3);
const Color PLAIN = Color(0.86, 0.87, 0.9); // What nobody has painted

// A corner of a mesh: where it is, which way its face looks, and its paint.
struct Corner
{
    float3 position;
    float3 normal;
    Color color = Color.white;
}

// The meshes, made once: a cube, a ball and a pin to draw at every body's
// place, and the scenery, which never moves, as one mesh where it is.
local singleton Models
{
    List<Corner> cube;
    List<int> cubeFaces;
    List<Corner> ball;
    List<int> ballFaces;
    List<Corner> pin;
    List<int> pinFaces;
    List<Corner> scenery;
    List<int> sceneryFaces;
    bool made;
}

// Where this machine's player points on the lane, and the spin they've set,
// which its input sends.
local singleton Hand
{
    float2 target = float2(0, 12);
    float spin;
    bool known; // Not before the pointer was ever on this window
}

local singleton Fx
{
    int seat = -1; // This machine's player's, once it has a bowler
    bool thrown;   // The player has found out how
}

local singleton Menu
{
    bool open;
    string code;
}

Color SeatColor(int seat)
{
    return seat == 0 ? AMBER : seat == 1 ? TEAL : seat == 2 ? ROSE : seat == 3 ? BLUE
         : seat == 4 ? VIOLET : seat == 5 ? GREEN : seat == 6 ? ORANGE : seat == 7 ? LIME : PLAIN;
}

Color Mix(Color from, Color to, float t)
{
    return from + (to - from) * Math.Saturate(t);
}

// A face's paint in the lane's light: a lamp over the players' left
// shoulders, and the room's own glow, a little brighter from above.
Color Light(Color paint, float3 normal)
{
    float lamp = Math.Max(Math.Dot(normal, Math.Normalize(float3(-0.45, 0.8, -0.4))), 0);
    float light = 0.3 + 0.12 * normal.y + 0.62 * lamp;
    return Color(paint.r * light, paint.g * light, paint.b * light, paint.a);
}

// Once for each pixel: its normal, turned into the world by the draw's
// transform, against the light.
frag Shade(Corner corner, mut Color color, Instance instance)
{
    color = Light(corner.color, Math.Normalize(Math.Rotate(instance.transform, corner.normal)));
}

// A target reads its entity's component: whose color it is, and the flash a
// hit left, which is a local field.
frag ShadeTarget(Corner corner, mut Color color, Instance instance, Target target)
{
    Color paint = Mix(SeatColor(target.last), Color.white, target.hit);
    color = Light(paint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)));
}

// A ball has a white band around it, so that its spin shows.
frag ShadeBall(Corner corner, mut Color color, Instance instance, Ball ball)
{
    Color paint = Math.Abs(corner.position.y) < 0.22 ? Color.white : SeatColor(ball.seat);
    color = Light(paint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)));
}

// A box's six faces, four corners each, added to a mesh.
void AddBox(mut List<Corner> corners, mut List<int> faces, float3 center, float3 size, Color color)
{
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        float way = face % 2 == 0 ? 1 : -1;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        var first = corners.count;
        for (var i = 0; i < 4; i++)
        {
            float a = i == 0 || i == 3 ? -0.5 : 0.5;
            float b = i < 2 ? -0.5 : 0.5;
            corners.Add(Corner { position = center + (normal * 0.5 + across * a + up * b) * size, normal = normal, color = color });
        }
        faces.Add(first);
        faces.Add(first + 1);
        faces.Add(first + 2);
        faces.Add(first);
        faces.Add(first + 2);
        faces.Add(first + 3);
    }
}

// A ball of rings, pulled apart at its middle by `straight` along y: a sphere
// when that's 0, and a capsule otherwise.
void AddCapsule(mut List<Corner> corners, mut List<int> faces, float radius, float straight, Color color)
{
    var first = corners.count;
    for (var ring = 0; ring <= 13; ring++)
    {
        // Rings 0 to 6 are the top half, 7 to 13 the bottom: two at the middle
        float down = (ring < 7 ? ring : ring - 1) * Math.PI / 12;
        float lift = ring < 7 ? straight / 2 : -straight / 2;
        for (var step = 0; step <= 16; step++)
        {
            float around = step * Math.TAU / 16;
            var normal = float3(Math.Sin(down) * Math.Cos(around), Math.Cos(down), Math.Sin(down) * Math.Sin(around));
            corners.Add(Corner { position = normal * radius + float3(0, lift, 0), normal = normal, color = color });
            if (ring == 13 || step == 16) continue;
            int at = first + ring * 17 + step;
            faces.Add(at);
            faces.Add(at + 17);
            faces.Add(at + 1);
            faces.Add(at + 1);
            faces.Add(at + 17);
            faces.Add(at + 18);
        }
    }
}

// The camera, behind the players and above them, looking down the lane, and
// where the pointer is on the lane: a ray from the camera through its pixel,
// down to the height a ball rolls at.
view Look(Devices devices, mut Hand hand, mut Fx fx, mut Models models)
{
    if (!models.made)
    {
        models.made = true;
        AddBox(models.cube, models.cubeFaces, float3(0), float3(1), Color.white);
        AddCapsule(models.ball, models.ballFaces, 1, 0, Color.white);
        AddCapsule(models.pin, models.pinFaces, PIN_RADIUS, PIN_HEIGHT - 2 * PIN_RADIUS, Color.white);
        AddBox(models.pin, models.pinFaces, float3(0, 0.03 - PIN_HEIGHT / 2, 0), float3(0.3, 0.06, 0.3), Color.white);
        // The lane, the line the players stand behind, and the goal's posts and bar past the far end
        var middle = (LANE_START + LANE_END) / 2;
        AddBox(models.scenery, models.sceneryFaces, float3(0, -0.5, middle), float3(LANE_WIDTH, 1, LANE_END - LANE_START), Color(0.2, 0.21, 0.24));
        AddBox(models.scenery, models.sceneryFaces, float3(0, 0, 1.1), float3(LANE_WIDTH, 0.02, 0.08), QUIET);
        for (var i = 1; i < 6; i++)
            AddBox(models.scenery, models.sceneryFaces, float3(0, 0, 1.1 + i * 2.6), float3(0.06, 0.012, 0.9), LINE);
        AddBox(models.scenery, models.sceneryFaces, float3(-LANE_WIDTH / 2 - 0.5, -1.5, LANE_END + 0.4), float3(0.3, 5, 0.3), QUIET);
        AddBox(models.scenery, models.sceneryFaces, float3(LANE_WIDTH / 2 + 0.5, -1.5, LANE_END + 0.4), float3(0.3, 5, 0.3), QUIET);
        AddBox(models.scenery, models.sceneryFaces, float3(0, -4, LANE_END + 0.4), float3(LANE_WIDTH + 1.3, 0.3, 0.3), QUIET);
    }
    Draw2D.Clear(BACK);
    Draw3D.SetCamera(float3(0, 7.4, -6.4), quaternion.Euler(float3(0.54, 0, 0)), 50);
    Draw3D.Mesh(models.scenery, models.sceneryFaces, float4x4.identity, Shade);
    fx.seat = -1;

    var screen = Screen.Flip(devices.pointer.position);
    var from = Draw3D.ScreenRayOrigin(screen);
    var along = Draw3D.ScreenRayDirection(screen);
    if (Math.LengthSq(devices.pointer.delta) > 0 || devices.pointer.press.pressed) hand.known = true;
    if (hand.known)
    {
        // A pixel over the lane's far end is as far down the lane as it gets
        float reach = along.y < -0.02 ? Math.Min((BALL - from.y) / along.y, 80) : 80;
        hand.target = float2(from.x + along.x * reach, from.z + along.z * reach);
    }
    if (devices.pointer.press.pressed || devices.keyboard.space.pressed) fx.thrown = true;
    var keys = devices.keyboard;
    float turn = (keys.d.pressed || keys.rightArrow.pressed ? 1 : 0) - (keys.a.pressed || keys.leftArrow.pressed ? 1 : 0);
    hand.spin = Math.Clamp(hand.spin + turn * Math.Min(Frame.dt, 0.05) * 1.5, -1, 1);
}

// The goal lights up while something falls through it.
view Goals(Goal goal, Models models)
{
    if (goal.inside <= 0) return;
    Draw.Tint(ROSE)
    {
        Draw3D.Mesh(models.cube, models.cubeFaces,
                    float4x4.TRS(float3(0, -4, LANE_END + 0.4), quaternion.identity, float3(LANE_WIDTH + 1.4, 0.4, 0.4)), Shade);
    }
}

// A view sees a body where the last step left it, blended between ticks, and
// gliding to where the server says it is when this machine guessed otherwise.
// Instances of one mesh drawn in a row are one draw, each with its own
// transform and its own entity's `Target`.
view Pins(Body body, mut Target target, Models models, with Capsule)
{
    target.hit = Math.Max(0, target.hit - Frame.dt * 4);
    Draw3D.Mesh(models.pin, models.pinFaces, float4x4.TRS(body.position, body.rotation, float3(1)), ShadeTarget);
}

// A kingpin's head is its third shape, a sphere at an offset from its body.
view Heads(Body body, Sphere sphere, Models models, with Target)
{
    var at = body.position + Math.Rotate(body.rotation, sphere.offset);
    Draw3D.Mesh(models.ball, models.ballFaces, float4x4.TRS(at, body.rotation, float3(sphere.radius)), Shade);
}

view Crates(Body body, Box box, mut Target target, Models models, without Capsule)
{
    target.hit = Math.Max(0, target.hit - Frame.dt * 4);
    Draw3D.Mesh(models.cube, models.cubeFaces, float4x4.TRS(body.position, body.rotation, box.size), ShadeTarget);
}

view Balls(Body body, Sphere sphere, Models models, with Ball)
{
    Draw3D.Mesh(models.ball, models.ballFaces, float4x4.TRS(body.position, body.rotation, float3(sphere.radius)), ShadeBall);
}

view Bars(Body body, Box box, Models models, with Sweeper)
{
    Draw.Tint(ROSE)
    {
        Draw3D.Mesh(models.cube, models.cubeFaces, float4x4.TRS(body.position, body.rotation, box.size), Shade);
    }
}

// Each player's place on the line: the ball they'd throw next, in their
// color, which grows back after a throw.
view Bowlers(Bowler bowler, Models models)
{
    var way = Math.Normalize(float3(bowler.aim.x, 0, bowler.aim.y));
    var ready = 1 - bowler.reload / float(RELOAD);
    Draw.Tint(SeatColor(bowler.seat))
    {
        Draw3D.Mesh(models.ball, models.ballFaces,
                    float4x4.TRS(Stand(bowler.seat) + way * 0.7, quaternion.identity, float3(BALL * (0.4 + 0.6 * ready))), Shade);
    }
}

// This machine's player's own has a line down the lane, the way their ball
// would go: it follows the pointer as it is this frame, ahead of the match's
// tick. `with ownership` picks the entities this machine's player owns.
view Mine(Bowler bowler, Hand hand, Models models, mut Fx fx, with ownership)
{
    fx.seat = bowler.seat;
    var at = Stand(bowler.seat);
    var way = Way(bowler.seat, hand.target);
    if (!hand.known) return;
    var turned = quaternion.LookRotation(way, float3(0, 1, 0));
    Draw3D.Mesh(models.cube, models.cubeFaces,
                float4x4.TRS(at + way * 5 + float3(0, 0.02 - at.y, 0), turned, float3(0.05, 0.02, 7)), Shade);
}

string Place(int seat)
{
    return seat == 0 ? "Amber" : seat == 1 ? "Teal" : seat == 2 ? "Rose" : seat == 3 ? "Blue"
         : seat == 4 ? "Violet" : seat == 5 ? "Green" : seat == 6 ? "Orange" : "Lime";
}

// The scores are read `verified`: what the server has confirmed, never a pin
// this machine only predicted falling. Each bowler has its player's, and the
// query goes through them all.
view Scores(verified Lane sure, Fx fx, query (verified Bowler bowler) bowlers)
{
    Draw2D.SetScreen();
    var slot = float(Screen.width) / SEATS;
    foreach (var entry in bowlers)
    {
        var seat = entry.bowler.seat;
        var middle = (seat + 0.5) * slot;
        Draw2D.Text($"{entry.bowler.score}", float2(middle, 16), 22, SeatColor(seat), Anchor.MiddleCenter, Font.Bold);
        if (seat == fx.seat) Draw2D.Text("you", float2(middle, 35), 12, Color.white, Anchor.MiddleCenter);
    }
    Draw2D.Text($"{sure.through} through the goal", float2(Screen.width - 10, 50), 13, QUIET, Anchor.UpperRight);
}

view Hud(Lane lane, Session session, Devices devices, Fx fx, mut Hand hand, mut Menu menu, query (Sweeper sweeper) bars)
{
    Draw2D.SetScreen();
    var width = float(Screen.width);
    var height = float(Screen.height);
    if (lane.phase != Phase.Play)
        Draw2D.Text("Cleared!", float2(width / 2, height * 0.42), 30, Color.white, Anchor.MiddleCenter, Font.Bold);
    if (!fx.thrown)
        Draw2D.Text("Point down the lane, and hold to throw", float2(width / 2, height - 122), 15, Color.white, Anchor.MiddleCenter);
    // A match that's open says where: friends join it by this code
    if (session.room != "")
        Draw2D.Text($"Room {session.room}", float2(10, 50), 13, QUIET);

    mut var resting = false;
    foreach (var entry in bars)
    {
        if (entry.sweeper.sweeping || entry.sweeper.rest > 0) resting = true;
    }
    // A panel behind the controls, which are over the lane. The bottom right
    // corner is the engine's stats' (the `stats` setting)
    Draw2D.RoundRect(float2(95, height - 42), float2(186, 80), 8, Color(0.086, 0.086, 0.094, 0.8));
    GUI.SetTheme(GUITheme { radius = 6 });
    var keys = devices.keyboard;
    GUI.Slider(Rect(8, height - 76, 174, 30), "Spin", hand.spin, -1, 1);
    if (GUI.Button(Rect(8, height - 38, 54, 30), lane.low ? "Heavy" : "Float") || keys.g.down) Send(Float { });
    GUI.Disabled(resting)
    {
        if (GUI.Button(Rect(68, height - 38, 54, 30), "Sweep") || (keys.s.down && !resting)) Send(Sweep { });
    }
    if (GUI.Button(Rect(128, height - 38, 54, 30), "Menu")) menu.open = true;
    if (keys.r.down) Send(Rebuild { });
    GUILayout.Modal(Anchor.MiddleCenter, menu.open)
    {
        // Others join this machine's match by its room's code, or this
        // machine joins theirs
        if (session.server && !session.open)
        {
            if (GUILayout.Button("Invite friends")) Session.Open();
        }
        else if (session.room != "")
        {
            GUILayout.Label($"Room {session.room}");
            if (GUILayout.Button("Copy the code")) Clipboard.Copy(session.room);
        }
        GUILayout.Horizontal()
        {
            GUILayout.TextField("Code", menu.code);
            if (GUILayout.Button("Join") && menu.code != "")
            {
                Session.Join(menu.code.Trim().ToUpper());
                menu.open = false;
            }
        }
        if (GUILayout.Button("Reset the game"))
        {
            Send(Rebuild { });
            menu.open = false;
        }
        if (GUILayout.Button("Back")) menu.open = false;
    }
}

// Before the match's world has arrived, there's nothing of it to draw.
view Waiting(Session session)
{
    if (session.state == SessionState.Connected) return;
    Draw2D.SetScreen();
    Draw2D.Text(session.state == SessionState.Connecting ? "Joining..." : "Not in a match",
                float2(Screen.width, Screen.height) * 0.5, 18, QUIET, Anchor.MiddleCenter);
}

// A ball hit this target: each machine hears the match say so once, however
// often it predicts the tick.
local event(Struck) Flash(mut Target target)
{
    target.hit = 1;
}

// A match this machine was in ended, or couldn't be joined: on to one of its own.
local event(Disconnected gone) Alone()
{
    if (gone.reason != DisconnectReason.Left) Session.Start(Main);
}
