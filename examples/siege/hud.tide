// Over the map, in the screen's pixels: the scores, the words when a round
// ends or gravity turns, and what to do first. None of it shows while the
// lobby or the menu is up (lobby.tide).
using Box2D;

const float SCORES = 48; // The height of the scores' row, which the camera keeps the ceiling under

// How much of the screen's bottom right corner the game leaves to the engine's
// stats (the `stats` setting): their one line, which is the frame rate, and in
// a match another machine runs, the ping too.
float StatsCorner(Session session)
{
    return session.server ? 100 : 196;
}

// A crown, for whoever leads and for a king's worth: its middle at `at`.
void Crown(float2 at, float size, Color color)
{
    Draw2D.RoundRect(at + float2(0, size * 0.25), float2(size * 1.5, size * 0.45), size * 0.12, color);
    for (var i = -1; i <= 1; i++)
        Draw2D.Circle(at + float2(i * size * 0.55, -size * 0.2), size * 0.28, color);
}

// Gravity turned over shows all over the screen: its edges glow while it
// lasts. And whatever just lit the whole screen fades here.
[Stage(Layers.Hud)]
view Glare(Siege siege, Fx fx)
{
    Draw2D.SetScreen();
    var screen = float2(Screen.width, Screen.height);
    Draw.Blend(Blend.Add)
    {
        if (siege.flip > 0)
        {
            var shown = Math.Saturate(siege.flip / 30.0) * (0.8 + 0.2 * Math.Sin(fx.beat * 2));
            Draw2D.Shape(Shape { center = screen * 0.5, size = screen, color = Fade(ROSE, 0.3 * shown),
                                 soft = -Math.Min(screen.x, screen.y) * 0.3 });
        }
        if (fx.flash > 0) Draw2D.Rect(screen * 0.5, screen, Fade(fx.flashColor, fx.flash));
    }
}

// The scores are read `verified`: what the server has confirmed, never a
// crate this machine only predicted falling. Each cannon has its seat's, and
// the query goes through them all. This machine's player's is marked, and
// whoever leads wears a crown.
[Stage(Layers.Hud, 10)]
view Scores(verified Siege sure, Fx fx, Lobby lobby, query (verified Cannon cannon) cannons)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None) return;
    // Side by side in the screen's middle, as wide as a narrow one lets them be
    var slot = Math.Min(Screen.width / SEATS, 112);
    var first = (Screen.width - slot * SEATS) * 0.5;
    mut var best = 0;
    mut var leader = -1;
    foreach (var entry in cannons)
    {
        if (entry.cannon.score == best) leader = -1; // Nobody leads a tie
        if (entry.cannon.score <= best) continue;
        best = entry.cannon.score;
        leader = entry.cannon.seat;
    }
    foreach (var entry in cannons)
    {
        var seat = entry.cannon.seat;
        var manned = Manned(sure, seat);
        var mine = seat == fx.seat;
        var color = manned || sure.bots ? SeatColor(seat) : Shade(SeatColor(seat), 0.45);
        var middle = float2(first + (seat + 0.5) * slot, SCORES * 0.5);
        var wide = Math.Min(slot - 8, 96);
        var pop = Popped(fx, seat);
        Draw2D.Shape(Shape { center = middle, size = float2(wide, SCORES - 8), radius = 10,
                             color = mine ? Color(0.21, 0.215, 0.235) : Color(0.115, 0.118, 0.13, 0.9),
                             outline = mine ? 1.5 : 0, outlineColor = Fade(Color.white, 0.75) });
        var number = $"{entry.cannon.score}";
        var size = Math.Round(22 * (1 + 0.35 * pop));
        var across = Draw2D.MeasureText(number, size, Font.Bold).x;
        var left = middle.x - (across + 16) * 0.5;
        if (seat == leader) Crown(float2(left + 5, middle.y - 6), 7, GOLD);
        else Draw2D.Circle(float2(left + 5, middle.y - 6), 5, color);
        Draw2D.Text(number, float2(left + 16, middle.y - 6), size, pop > 0 ? Mix(color, Color.white, pop) : color,
                    Anchor.MiddleLeft, Font.Bold);
        Draw2D.Text(mine ? "YOU" : manned ? "PLAYER" : sure.bots ? "BOT" : "OFF", middle + float2(0, 12), 10,
                    mine ? Color.white : Fade(QUIET, manned ? 1 : 0.7), Anchor.MiddleCenter, mine ? Font.Bold : Font.Regular);
    }
}

// A band across the screen, in a color, with a line of words and a smaller
// one under it: open for `open`, from 0 to 1.
void Band(float2 middle, float open, bool big, Color tint, string words, string under)
{
    var screen = float2(Screen.width, Screen.height);
    var tall = (big ? 84 : 60) * open;
    Draw.Blend(Blend.Add)
    {
        Draw2D.Shape(Shape { center = middle, size = float2(screen.x + 80, tall), color = Fade(tint, 0.25 * open), soft = 40 });
    }
    Draw2D.Shape(Shape { center = middle, size = float2(screen.x + 80, tall), color = Shade(tint, 0.95), color2 = Shade(tint, 0.7) });
    Draw2D.Rect(middle - float2(0, tall * 0.5 + 4), float2(screen.x, 2 * open), Fade(Color.white, 0.85));
    Draw2D.Rect(middle + float2(0, tall * 0.5 + 4), float2(screen.x, 2 * open), Fade(Color.white, 0.85));
    Draw.Tint(Fade(Color.white, Math.Saturate(open * 1.5 - 0.5)))
    {
        var size = big ? 30 : 20;
        // As big as fits
        var fit = Math.Min(1, (screen.x - 24) / Math.Max(1, Draw2D.MeasureText(words, size, Font.Bold).x));
        Draw2D.Text(words, middle - float2(0, under == "" ? 0 : (big ? 9 : 7)), Math.Floor(size * fit), BACK, Anchor.MiddleCenter, Font.Bold);
        if (under != "") Draw2D.Text(under, middle + float2(0, big ? 21 : 15), big ? 14 : 12, Fade(BACK, 0.8), Anchor.MiddleCenter);
    }
}

// The words over the map: who took a round, which round starts, and gravity
// while it's turned over. A round's winner is the server's to say, so it comes
// from a `verified` event's handler (effects.tide); how long gravity stays up
// is read as this machine predicts it, to answer the shot at once.
[Stage(Layers.Hud, 20)]
view Words(Siege siege, Session session, Lobby lobby, mut Flow flow, mut Fx fx)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None) return;
    var screen = float2(Screen.width, Screen.height);
    var big = screen.x >= 640 && screen.y >= 420;
    var middle = float2(screen.x * 0.5, SCORES + (screen.y - SCORES) * 0.3);

    if (flow.since < 2.7)
    {
        var open = EaseOut(flow.since / 0.2) * (1 - EaseOut((flow.since - 2.4) / 0.3));
        var mine = flow.winner >= 0 && flow.winner == fx.seat;
        var tint = flow.winner < 0 ? QUIET : SeatColor(flow.winner);
        var words = flow.winner < 0 ? $"ROUND {flow.round} IS OVER" : mine ? $"YOU TAKE ROUND {flow.round}"
                  : $"{SeatName(flow.winner)} TAKES ROUND {flow.round}";
        var under = flow.winner < 0 ? "Nobody scored" : flow.best == 1 ? "with 1 point" : $"with {flow.best} points";
        Band(middle, open, big, tint, words, under);
        if (!flow.papered && flow.winner >= 0)
        {
            flow.papered = true;
            Paper(fx, float2(screen.x * 0.3, middle.y), mine ? 40 : 18, 420, tint);
            Paper(fx, float2(screen.x * 0.7, middle.y), mine ? 40 : 18, 420, tint);
        }
    }
    else if (flow.begun < 1.3 && flow.built > 0 && siege.phase == Phase.Play)
    {
        var shown = Math.Saturate(flow.begun * 6) * Math.Saturate((1.3 - flow.begun) * 3);
        var size = Math.Round((big ? 54 : 36) * (1 + 0.3 * Math.Max(0, 1 - flow.begun * 6)) * 0.5) * 2;
        Draw.Tint(Fade(Color.white, shown))
        {
            Draw2D.Text($"ROUND {flow.built}", middle + float2(0, 3), size, Fade(BACK, 0.7), Anchor.MiddleCenter, Font.Bold);
            Draw2D.Text($"ROUND {flow.built}", middle, size, Color.white, Anchor.MiddleCenter, Font.Bold);
        }
    }

    if (siege.flip > 0 && flow.since >= 2.7)
    {
        // Under the scores, out of the towers' way: the words, and a bar that runs out
        var at = float2(screen.x * 0.5, SCORES + 24);
        var enter = EaseBack(flow.flipped / 0.25);
        var left = siege.flip / float(FLIP_TICKS);
        Draw2D.Shape(Shape { center = at, size = float2(176, 34) * enter, radius = 17, color = Color(0.12, 0.09, 0.1, 0.94),
                             outline = 1.5, outlineColor = ROSE });
        if (enter > 0.9)
        {
            Draw2D.Text("GRAVITY IS UP", at - float2(0, 4), 13, ROSE, Anchor.MiddleCenter, Font.Bold);
            Draw2D.RoundRect(at + float2(-70 + 70 * left, 10), float2(140 * left, 3), 1.5, ROSE);
        }
    }

    // The match's host left, and another machine is taking it over
    if (session.state == SessionState.Connecting)
    {
        var at = float2(screen.x * 0.5, SCORES + 62);
        Draw2D.Shape(Shape { center = at, size = float2(Math.Min(screen.x - 16, 300), 34), radius = 17, color = Color(0.1, 0.1, 0.11, 0.94),
                             outline = 1.5, outlineColor = LINE });
        Draw2D.Text("The host left. Finding the match again...", at, 12, INK, Anchor.MiddleCenter);
    }
}

// What to do first, until the player has done it: aim and fire, and then the
// orb, which nothing else says is there to be shot.
[Stage(Layers.Hud, 30)]
view Hints(Siege siege, Session session, Devices devices, Fx fx, Flow flow, Lobby lobby)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None || fx.seat < 0 || siege.phase != Phase.Play) return;
    var screen = float2(Screen.width, Screen.height);
    mut var words = "";
    if (!fx.fired) words = devices.touchscreen.connected ? "Touch where to aim, and hold to fire" : "Point where to aim, and hold to fire";
    else if (!flow.turned && flow.played > 4 && flow.played < 16) words = "Shoot the orb to turn gravity over";
    if (words == "") return;
    var wide = Draw2D.MeasureText(words, 14).x + 28;
    // In the screen's middle: on a wide one, as far left as leaves the bottom
    // right corner to the stats, and on a narrow one, above them
    var at = screen.x < 520 ? float2(screen.x * 0.5, screen.y - 68)
           : float2(Math.Min(screen.x * 0.5, screen.x - StatsCorner(session) - wide * 0.5), screen.y - 30);
    var bob = Math.Sin(fx.beat * 2) * 2;
    Draw2D.Shape(Shape { center = at + float2(0, bob), size = float2(wide, 30), radius = 15, color = Color(0.1, 0.1, 0.11, 0.92),
                         outline = 1.5, outlineColor = LINE });
    Draw2D.Text(words, at + float2(0, bob), 14, INK, Anchor.MiddleCenter);
}

// The way to the menu, and the room this machine is in, for whoever asks.
// The bottom right corner is the engine's stats'.
[Stage(Layers.Hud, 40)]
view Corner(Session session, Devices devices, mut Lobby lobby)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None) return;
    var bottom = Screen.height;
    if (session.room != "")
    {
        // Beside the button, and narrow enough to leave the stats their corner
        Draw2D.Text("ROOM", float2(102, bottom - 39), 10, QUIET, Anchor.MiddleLeft, Font.Bold);
        Draw2D.Text(session.room, float2(102, bottom - 23), 14, INK, Anchor.MiddleLeft, Font.Bold);
    }
    var pressed = Pill(Rect(8, bottom - 52, 84, 44), "MENU", INK, false, true);
    if (pressed || devices.keyboard.escape.down)
    {
        lobby.page = Page.Room;
        lobby.resume = true;
    }
    if (devices.keyboard.r.down && session.state == SessionState.Connected) Send(Rebuild { });
}

// Paper for a round's winner, over everything but the menu.
[Stage(Layers.Hud, 50)]
view Confetti(mut Fx fx)
{
    Draw2D.SetScreen();
    mut var i = 0;
    while (i < fx.paper.count)
    {
        mut var bit = fx.paper[i];
        bit.age += fx.dt;
        if (bit.age >= bit.life)
        {
            fx.paper.RemoveAt(i);
            continue;
        }
        bit.velocity.y += 620 * fx.dt;
        bit.velocity = bit.velocity * Math.Max(0, 1 - bit.drag * fx.dt);
        bit.position += bit.velocity * fx.dt;
        bit.angle += bit.spin * fx.dt;
        fx.paper[i] = bit;
        // It turns over as it falls
        var flat = Math.Abs(Math.Sin(bit.angle * 1.7));
        Draw2D.Rect(bit.position, float2(bit.size, bit.size * (0.25 + 0.75 * flat)), bit.angle,
                    Fade(bit.color, (1 - bit.age / bit.life) * 3));
        i++;
    }
}
