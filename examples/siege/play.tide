// Siege, as one machine shows it: the camera and the pieces. Views read the
// match and never change it: what they write is this machine's own (Pointer,
// Fx, and the local fields of a crate and a shot). The sparks and the numbers
// are in effects.tide, the scores in hud.tide, and the lobby in lobby.tide.
using Box2D;

// The docs site's colors.
const Color BACK = Color(0.086, 0.086, 0.094);
const Color PANEL = Color(0.125, 0.127, 0.14);
const Color RAISED = Color(0.17, 0.175, 0.19);
const Color LINE = Color(0.24, 0.25, 0.27);
const Color QUIET = Color(0.64, 0.64, 0.68);
const Color INK = Color(0.93, 0.93, 0.95);
const Color AMBER = Color(0.98, 0.75, 0.14);
const Color TEAL = Color(0.18, 0.83, 0.75);
const Color ROSE = Color(0.98, 0.44, 0.52);
const Color BLUE = Color(0.47, 0.72, 1);
const Color STONE = Color(0.56, 0.57, 0.62); // A crate nobody has painted
const Color GOLD = Color(1, 0.86, 0.36);     // A king's crown

// What draws over what, whichever file a view is in.
enum Layers { Camera, Scenery, Pieces, Shots, Effects, Hud, Menu }

// Where this machine's pointer is on the map, which its input sends.
local singleton Pointer
{
    float2 world;
    bool known;   // Not before the pointer was ever on this window
    bool playing; // No lobby or menu is up: the player's hands are on the cannon
}

// What this machine's drawing keeps from frame to frame. None of it is the
// match's.
local singleton Fx
{
    float dt;        // Seconds this frame's effects move on by: a stall isn't a leap
    float beat;      // Radians, for what pulses: always under a full turn
    float meter;     // How many pixels a meter of the map is, in this window
    float2 low;      // The corners of what the camera shows, in meters
    float2 high;
    int seat = -1;   // This machine's player's, once it has a cannon
    bool fired;      // The player has found the trigger
    float trauma;    // How hard the camera shakes, 0 to 1
    float2 shake;    // Where that puts it this frame, in meters
    float flash;     // The whole screen lit, fading
    Color flashColor = Color.white;
    float pull = -10; // Gravity as the match has it, for what falls here
    Random random;   // What rolls the effects: this machine's own
    float4 pops;     // Each seat's score, just counted up: 1, fading
    List<Bit> bits;
    List<Bit> paper; // In the screen's pixels, over everything
    List<Label> labels;
}

Color SeatColor(int seat)
{
    return seat == 0 ? AMBER : seat == 1 ? TEAL : seat == 2 ? ROSE : seat == 3 ? BLUE : STONE;
}

string SeatName(int seat)
{
    return seat == 0 ? "AMBER" : seat == 1 ? "TEAL" : seat == 2 ? "ROSE" : "BLUE";
}

Color Shade(Color color, float light)
{
    return Color(Math.Saturate(color.r * light), Math.Saturate(color.g * light), Math.Saturate(color.b * light), color.a);
}

Color Fade(Color color, float alpha)
{
    return Color(color.r, color.g, color.b, color.a * Math.Saturate(alpha));
}

Color Mix(Color from, Color to, float t)
{
    return from + (to - from) * Math.Saturate(t);
}

float2 Turned(float2 offset, float angle)
{
    var c = Math.Cos(angle);
    var s = Math.Sin(angle);
    return float2(offset.x * c - offset.y * s, offset.x * s + offset.y * c);
}

float EaseOut(float t)
{
    var left = 1 - Math.Saturate(t);
    return 1 - left * left * left;
}

// Past its end and back, like something that lands.
float EaseBack(float t)
{
    var left = Math.Saturate(t) - 1;
    return 1 + left * left * (2.70158 * left + 1.70158);
}

// The camera shows the whole map whatever the window's shape: a wide one sees
// more of the sides, where crates fall off, and a tall one further down the
// pit. The ceiling stays under the scores' row. It shakes when something big
// lands, which the pointer's place on the map is worked out without.
[Stage(Layers.Camera)]
view Look(Devices devices, mut Pointer pointer, mut Fx fx)
{
    fx.dt = Math.Min(Frame.dt, 0.05);
    fx.beat += fx.dt * 3;
    if (fx.beat > Math.TAU) fx.beat -= Math.TAU;
    fx.trauma = Math.Max(0, fx.trauma - fx.dt * 1.8);
    fx.flash = Math.Max(0, fx.flash - fx.dt * 2.4);
    fx.pops = Math.Max(fx.pops - float4(fx.dt * 2.2), float4(0));
    var wobble = fx.beat * 23;
    fx.shake = float2(Math.Sin(wobble) + Math.Sin(wobble * 0.62 + 1.3) * 0.6,
                      Math.Sin(wobble * 0.89 + 2.1) + Math.Sin(wobble * 0.54 + 0.4) * 0.6) * (fx.trauma * fx.trauma * 0.45);

    Draw2D.Clear(BACK);
    var width = Screen.width;
    var height = Screen.height;
    var half = Math.Max(9.3, 11.4 * height / width);
    // A window taller than the map has the map nearer its middle
    var spare = Math.Max(0, 2 * half - 24.5);
    var top = CEILING + SCORES * 2 * half / height + spare * 0.3;
    var center = float2(0, top - half);
    Draw2D.SetCamera(center, half);
    fx.meter = height / (2 * half);
    fx.low = center - float2(half * width / height, half);
    fx.high = center + float2(half * width / height, half);
    fx.seat = -1;

    pointer.world = Draw2D.ScreenToWorld(Screen.Flip(devices.pointer.position));
    if (Math.LengthSq(devices.pointer.delta) > 0 || devices.pointer.press.pressed) pointer.known = true;
    if (pointer.playing && (devices.pointer.press.pressed || devices.keyboard.space.pressed)) fx.fired = true;
    Draw2D.SetCamera(center + fx.shake, half);

    // The room behind the map: a dot every two meters, and the pit's glow
    // along the bottom, where what falls is gone
    for (var x = Math.Ceil(fx.low.x / 2) * 2; x < fx.high.x; x += 2)
    {
        for (var y = Math.Ceil(fx.low.y / 2) * 2; y < Math.Min(fx.high.y, CEILING); y += 2)
            Draw2D.Circle(float2(x, y), Math.Max(0.05, 0.8 / fx.meter), Color(1, 1, 1, 0.05));
    }
    Draw2D.Shape(Shape { center = float2(center.x, fx.low.y + 1.6), size = float2(fx.high.x - fx.low.x + 2, 3.4),
                         color = Fade(ROSE, 0), color2 = Fade(ROSE, 0.16) });
}

// While gravity is turned over, arrows climb the map's sides.
[Stage(Layers.Scenery)]
view Risen(Siege siege, Fx fx)
{
    if (siege.flip <= 0) return;
    var shown = Math.Saturate(siege.flip / 30.0);
    var climb = fx.beat / Math.TAU * 3;
    // Beside the islands, or as near the window's sides as shows
    var across = Math.Min(11.6, Screen.width / (2 * fx.meter) - 0.8);
    Draw.Blend(Blend.Add)
    {
        for (var side = -1; side <= 1; side += 2)
        {
            for (var i = 0; i < 5; i++)
            {
                var at = float2(side * across, Math.Frac((i * 3 + climb) / 15) * 15);
                var color = Fade(ROSE, shown * 0.6 * Math.Sin(at.y / 15 * Math.PI));
                Draw2D.Line(at + float2(-0.5, -0.4), at, 0.16, color);
                Draw2D.Line(at + float2(0.5, -0.4), at, 0.16, color);
            }
        }
    }
}

// A view sees a body where the last step left it, blended between ticks, and
// gliding to where the server says it is when this machine guessed otherwise.
[Stage(Layers.Scenery)]
view Islands(Body body, Box box, Fx fx, with Ground)
{
    if (body.position.y > CEILING)
    {
        // The ceiling is drawn to the window's top, under the scores
        var over = fx.high.y - CEILING + 1;
        Draw2D.Rect(float2(0, CEILING + over / 2), float2(box.size.x, over), Color(0.155, 0.16, 0.175));
        Draw2D.Rect(float2(0, CEILING + 0.07), float2(box.size.x, 0.14), LINE);
        return;
    }
    Draw2D.Shape(Shape { center = body.position, size = box.size, radius = 0.22, color = Color(0.25, 0.26, 0.285),
                         color2 = Color(0.15, 0.155, 0.17) });
    Draw2D.RoundRect(body.position + float2(0, box.size.y / 2 - 0.08), float2(box.size.x - 0.1, 0.16), 0.08, Color(0.36, 0.37, 0.4));
}

[Stage(Layers.Scenery)]
view Bridges(Body body, Box box, with Bridge)
{
    Draw2D.Shape(Shape { center = body.position, size = box.size, radius = 0.2, color = Color(0.72, 0.72, 0.76),
                         color2 = Color(0.46, 0.46, 0.5), outline = 0.06, outlineColor = Color(0.3, 0.3, 0.33) });
    Draw2D.Circle(body.position + float2(-box.size.x / 2 + 0.3, 0), 0.07, BACK);
    Draw2D.Circle(body.position + float2(box.size.x / 2 - 0.3, 0), 0.07, BACK);
}

[Stage(Layers.Scenery)]
view Orbs(Body body, Circle circle, Orb orb, Siege siege, Fx fx)
{
    var live = orb.rest <= 0;
    var up = siege.flip > 0;
    var pulse = 0.5 + 0.5 * Math.Sin(fx.beat);
    var color = up ? ROSE : live ? Color.white : LINE;
    Draw.Blend(Blend.Add)
    {
        if (live || up)
            Draw2D.Shape(Shape { center = body.position, size = float2(circle.radius * 2), ellipse = true,
                                 color = Fade(color, (up ? 0.34 : 0.12) + pulse * 0.1 + orb.inside * 0.12), soft = up ? 2.2 : 1.3 });
    }
    Draw2D.Circle(body.position, circle.radius, Color(0.1, 0.1, 0.11, 0.85));
    Draw2D.WireCircle(body.position, circle.radius, 0.11, color);
    // While it rests, an arc fills up around it
    if (!live && !up)
        Draw2D.Arc(body.position, circle.radius, Math.PI / 2, -Math.TAU * (1 - orb.rest / float(ORB_REST)), 0.11, QUIET);
    // Two arrows: what's down goes up
    var lift = up ? 0.12 * pulse : live ? 0.05 * pulse : 0;
    for (var i = 0; i < 2; i++)
    {
        var tip = body.position + float2(0, 0.42 - i * 0.42 + lift);
        Draw2D.Line(tip + float2(-0.34, -0.3), tip, 0.1, color);
        Draw2D.Line(tip + float2(0.34, -0.3), tip, 0.1, color);
    }
}

// A crate is the color of whoever's shot painted it last, lighter at its top,
// and white for a moment after a shot landed on it. `hit` is a local field:
// this view lets it fade.
[Stage(Layers.Pieces)]
view Crates(Body body, Box box, mut Crate crate, Fx fx)
{
    crate.hit = Math.Max(0, crate.hit - fx.dt * 4);
    var color = Mix(SeatColor(crate.last), Color.white, crate.hit);
    Draw2D.Shape(Shape { center = body.position, size = box.size - float2(0.04), rotation = body.angle, radius = 0.1,
                         color = Mix(color, Color.white, 0.12), color2 = Shade(color, 0.7), outline = 0.07,
                         outlineColor = Shade(color, 0.45) });
    // A square one is a crate, with a frame on it
    if (Math.Abs(box.size.x - box.size.y) < 0.05 && box.size.x > 0.9)
        Draw2D.Shape(Shape { center = body.position, size = box.size * 0.58, rotation = body.angle, radius = 0.07,
                             color = Fade(color, 0), outline = 0.05, outlineColor = Fade(Shade(color, 0.5), 0.55) });
}

// A king's head is its second shape, a circle at an offset from its body. It
// wears a crown: it's worth five.
[Stage(Layers.Pieces)]
view Kings(Body body, Circle circle, Crate crate)
{
    var paint = SeatColor(crate.last);
    Draw2D.Transform(body.position, body.angle)
    {
        var head = circle.offset;
        Draw2D.Circle(head, circle.radius, Mix(paint, Color.white, 0.82));
        Draw2D.WireCircle(head, circle.radius, 0.07, Shade(paint, 0.45));
        Draw2D.Circle(head + float2(-0.12, 0), 0.05, BACK);
        Draw2D.Circle(head + float2(0.12, 0), 0.05, BACK);
        Draw2D.RoundRect(head + float2(0, circle.radius - 0.01), float2(0.5, 0.13), 0.04, GOLD);
        for (var i = -1; i <= 1; i++)
            Draw2D.Circle(head + float2(i * 0.18, circle.radius + 0.1), 0.08, GOLD);
    }
}

[Stage(Layers.Pieces)]
view Bumpers(Body body, Circle circle, with Bumper)
{
    Draw2D.Shape(Shape { center = body.position, size = float2(circle.radius * 2), ellipse = true, color = Color(0.2, 0.21, 0.235),
                         color2 = Color(0.13, 0.135, 0.15), outline = 0.09, outlineColor = QUIET });
    // Three studs, so that its turning shows
    for (var i = 0; i < 3; i++)
        Draw2D.Circle(body.position + Turned(float2(circle.radius - 0.3, 0), body.angle + i * Math.TAU / 3), 0.09, QUIET);
}

[Stage(Layers.Pieces)]
view Cannons(Body body, Cannon cannon, Siege siege)
{
    var color = SeatColor(cannon.seat);
    var pivot = Pivot(body.position, cannon.hangs);
    var aim = Math.Normalize(cannon.aim);
    var recoil = cannon.reload / float(RELOAD) * 0.3;
    // One that nobody has, with the bots off, is out of the game
    var lit = Manned(siege, cannon.seat) || siege.bots ? 1.0 : 0.5;
    var tip = pivot + aim * (MUZZLE - 0.25 - recoil);
    Draw2D.Shape(Shape { center = body.position, size = float2(1.1, 0.74), radius = 0.18, color = Shade(color, 0.5 * lit),
                         color2 = Shade(color, 0.3 * lit), outline = 0.07, outlineColor = Shade(color, 0.2) });
    Draw2D.Line(pivot, tip, 0.52, Shade(color, 0.25));
    Draw2D.Line(pivot, tip, 0.38, Shade(color, 0.72 * lit));
    Draw2D.Line(tip - aim * 0.06, tip, 0.52, Shade(color, 0.42 * lit));
    Draw2D.Circle(pivot, 0.5, Shade(color, 0.25));
    Draw2D.Circle(pivot, 0.42, Shade(color, lit));
    Draw2D.Circle(pivot + float2(-0.12, 0.13), 0.12, Fade(Color.white, 0.4 * lit));
}

// This machine's player's cannon has a ring, and shows where its next shot
// goes: the dots follow the pointer as it is this frame, ahead of the match's
// tick. `with ownership` picks the entities this machine's player owns.
[Stage(Layers.Shots)]
view Mine(Body body, Cannon cannon, Pointer pointer, Siege siege, mut Fx fx, with ownership)
{
    fx.seat = cannon.seat;
    var color = SeatColor(cannon.seat);
    var pivot = Pivot(body.position, cannon.hangs);
    var pulse = 0.5 + 0.5 * Math.Sin(fx.beat * 2);
    Draw2D.WireCircle(pivot, 0.72 + (fx.fired ? 0 : 0.1 * pulse), 0.1, Color.white);
    // Never smaller than text is read at, however small the map is drawn
    var size = Math.Max(0.62, 12 / fx.meter);
    // On the island under a cannon that stands on one, and beside one that
    // hangs, on the side the map's middle isn't: the scores are over it
    var tag = cannon.hangs ? body.position + float2(Math.Sign(body.position.x) * (0.9 + size * 1.1), 0)
            : body.position - float2(0, 0.5 + size * 0.7);
    Draw2D.Text("YOU", tag, size, Color.white, Anchor.MiddleCenter, Font.Bold);
    if (!pointer.known || !pointer.playing || siege.phase != Phase.Play) return;
    var aim = Aimed(pivot, pointer.world, cannon.hangs);
    var speed = Power(pivot, pointer.world);
    var from = pivot + aim * MUZZLE;
    var gravity = siege.flip > 0 ? 7.0 : -10.0;
    var dot = Math.Max(0.11, 1.6 / fx.meter);
    for (var i = 1; i <= 14; i++)
    {
        var t = i * 0.055;
        var at = from + aim * (speed * t) + float2(0, 0.5 * gravity * t * t);
        if (at.y > CEILING - 0.2 || at.y < fx.low.y) break;
        Draw2D.Circle(at, dot * (1 - i * 0.03), Fade(Mix(color, Color.white, 0.6), 0.9 - i * 0.055));
    }
    // Where the player points
    var reach = Math.Max(0.34, 5 / fx.meter);
    Draw2D.WireCircle(pointer.world, reach, Math.Max(0.07, 1.2 / fx.meter), Fade(Color.white, 0.75));
    Draw2D.Circle(pointer.world, reach * 0.22, Fade(Color.white, 0.75));
}

// A shot glows in its player's color, and leaves a tail: a puff every so far
// along its way, which `puffed`, a local field, keeps the last of.
[Stage(Layers.Shots)]
view Shots(Body body, Circle circle, mut Ball ball, mut Fx fx)
{
    var color = SeatColor(ball.seat);
    var moved = Math.Distance(body.position, ball.puffed);
    if (!ball.flying || moved > 3)
    {
        // Its first frame, or it came back in by the map's other side
        ball.flying = true;
        ball.puffed = body.position;
    }
    else if (moved > 0.3 && fx.bits.count < 700)
    {
        ball.puffed = body.position;
        fx.bits.Add(Bit { position = body.position, color = Fade(color, 0.55), life = 0.3, size = circle.radius * 0.85,
                          kind = BitKind.Glow });
    }
    Draw.Blend(Blend.Add)
    {
        Draw2D.Shape(Shape { center = body.position, size = float2(circle.radius * 2), ellipse = true,
                             color = Fade(color, 0.45), soft = 0.5 });
    }
    Draw2D.Circle(body.position, circle.radius, Color.white);
    Draw2D.WireCircle(body.position, circle.radius, 0.09, color);
}

// Where a shot landed: a ring that spreads as far as it shoved.
[Stage(Layers.Effects)]
view Rings(Blast blast)
{
    var t = blast.age / float(BLAST_TICKS);
    var color = SeatColor(blast.seat);
    Draw.Blend(Blend.Add)
    {
        Draw2D.Shape(Shape { center = blast.at, size = float2(1.2), ellipse = true,
                             color = Fade(color, 0.55 * (1 - t) * (1 - t)), soft = REACH * 0.5 });
        Draw2D.WireCircle(blast.at, REACH * (0.2 + 0.8 * Math.Sqrt(t)), 0.22 * (1 - t), Fade(color, 1 - t));
        Draw2D.Circle(blast.at, 0.5 * (1 - t) * (1 - t), Fade(Color.white, 1 - t * 3));
    }
}
