// What makes Siege feel alive is this machine's own: sparks, debris, numbers
// that float up, a camera that shakes. None of it is in the match. The match
// says what happens in it with events, and this machine's handlers of them
// add an effect here. Each hears an event once, however often this machine
// runs its tick again, and a `verified` one waits until the server has
// confirmed it: a score is never shown for a crate this machine only
// predicted falling.
using Box2D;

enum BitKind { Spark, Chunk, Glow }

// Something small that flies, fades and is gone. In meters on the map, or in
// pixels for the paper thrown over the screen.
struct Bit
{
    float2 position;
    float2 velocity;
    Color color = Color.white;
    float age;
    float life = 0.4;
    float size = 0.1;
    float angle;
    float spin;
    float weight; // How much of gravity pulls it
    float drag;
    BitKind kind;
}

// What a crate was worth, floating up from where it left the map.
struct Label
{
    float2 position;
    Color color = Color.white;
    float age;
    float life = 1.3;
    int amount;
    bool mine;
}

// How long ago the match said things, for the words over the map (hud.tide).
local singleton Flow
{
    int winner = -1;     // Who took the round that ended last: a seat, or -1 for nobody
    int round;
    int best;
    float since = 100;   // Seconds since a round ended...
    bool papered;        // ...and its winner's paper was thrown
    int built;           // The round that was built last...
    float begun = 100;   // ...and how long ago
    float flipped = 100; // Seconds since gravity turned over
    bool turned;         // It ever did, while this machine watched
    float played;        // Seconds since this machine's player first fired
}

void Shake(mut Fx fx, float amount)
{
    fx.trauma = Math.Min(1, fx.trauma + amount);
}

void Flash(mut Fx fx, Color color, float amount)
{
    if (amount < fx.flash) return;
    fx.flash = amount;
    fx.flashColor = color;
}

// Sparks thrown around `toward`, within `spread` radians of it.
void Sparks(mut Fx fx, float2 at, float2 toward, float spread, int count, float speed, Color color)
{
    if (fx.bits.count > 700) return;
    var middle = Math.Atan2(toward.y, toward.x);
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var angle = middle + (turn - 0.5) * spread;
        fx.bits.Add(Bit { position = at, velocity = float2(Math.Cos(angle), Math.Sin(angle)) * speed * (0.35 + pace * 0.9),
                          color = color, life = 0.18 + long * 0.3, size = 0.07, weight = 0.5, drag = 2.4, kind = BitKind.Spark });
    }
}

// Pieces thrown every way, which fall.
void Chunks(mut Fx fx, float2 at, int count, float speed, Color color)
{
    if (fx.bits.count > 700) return;
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var big = fx.random.NextFloat();
        var tone = fx.random.NextFloat();
        var angle = turn * Math.TAU;
        fx.bits.Add(Bit { position = at, velocity = float2(Math.Cos(angle), Math.Sin(angle) + 0.4) * speed * (0.3 + pace),
                          color = Shade(color, 0.6 + tone * 0.6), life = 0.5 + long * 0.6, size = 0.1 + big * 0.14,
                          angle = angle, spin = (turn - 0.5) * 18, weight = 1, drag = 0.6, kind = BitKind.Chunk });
    }
}

// Paper thrown over the screen, in its pixels.
void Paper(mut Fx fx, float2 at, int count, float speed, Color color)
{
    if (fx.paper.count > 400) return;
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var big = fx.random.NextFloat();
        var tone = fx.random.NextFloat();
        var angle = turn * Math.TAU;
        fx.paper.Add(Bit { position = at, velocity = float2(Math.Cos(angle), Math.Sin(angle) - 0.7) * speed * (0.25 + pace),
                           color = tone < 0.25 ? Color.white : Shade(color, 0.7 + tone * 0.5), life = 1.2 + long * 1.2,
                           size = 4 + big * 5, angle = angle, spin = (turn - 0.5) * 24, weight = 1, drag = 1.3,
                           kind = BitKind.Chunk });
    }
}

void Pop(mut Fx fx, int seat)
{
    if (seat == 0) fx.pops.x = 1;
    if (seat == 1) fx.pops.y = 1;
    if (seat == 2) fx.pops.z = 1;
    if (seat == 3) fx.pops.w = 1;
}

float Popped(Fx fx, int seat)
{
    return seat == 0 ? fx.pops.x : seat == 1 ? fx.pops.y : seat == 2 ? fx.pops.z : fx.pops.w;
}

// A shot landed on this crate: it flashes, which its view lets fade.
local event(Struck) Lit(mut Crate crate)
{
    crate.hit = 1;
}

// A shot leaves its cannon: a flash at the muzzle, and sparks the way it
// goes. A body that's just spawned hasn't moved yet: its impulse says where to.
local event(Spawned) Fired(Body body, Ball ball, mut Fx fx)
{
    var way = Math.Normalize(body.impulse);
    var color = SeatColor(ball.seat);
    Sparks(fx, body.position, way, 0.8, 5, 9, Mix(color, Color.white, 0.5));
    fx.bits.Add(Bit { position = body.position, color = Fade(Color.white, 0.8), life = 0.09, size = 0.5, kind = BitKind.Glow });
    if (ball.seat == fx.seat) Shake(fx, 0.07);
}

// Where it lands, its blast goes off: sparks and debris in its player's
// color, and the camera feels it, more for this machine's own.
local event(Spawned) Burst(Blast blast, mut Fx fx)
{
    var color = SeatColor(blast.seat);
    Sparks(fx, blast.at, float2(0, 1), Math.TAU, 10, 10, Mix(color, Color.white, 0.45));
    Chunks(fx, blast.at, 6, 5.5, color);
    Shake(fx, blast.seat == fx.seat ? 0.2 : 0.1);
}

// A crate left the map: once that's certain, what it was worth floats up from
// where it went, in the color of whoever painted it, and their score jumps.
local event(verified Dropped dropped) Tally(mut Fx fx)
{
    if (dropped.seat < 0) return;
    var color = SeatColor(dropped.seat);
    // Where it left: over the pit's floor, or as low as shows over the buttons
    var at = float2(Math.Clamp(dropped.at.x, fx.low.x + 1.4, fx.high.x - 1.4),
                    Math.Max(fx.low.y + 78 / Math.Max(fx.meter, 1), FLOOR + 1.2));
    fx.labels.Add(Label { position = at, color = color, amount = dropped.worth, mine = dropped.seat == fx.seat });
    Sparks(fx, at - float2(0, 1.2), float2(0, 1), 1.6, dropped.worth >= 5 ? 16 : 6, 9, Mix(color, Color.white, 0.4));
    Pop(fx, dropped.seat);
    if (dropped.worth < 5) return;
    // A king
    Chunks(fx, at - float2(0, 1.2), 12, 8, GOLD);
    Shake(fx, 0.3);
}

local event(Flipped) Upturned(mut Fx fx, mut Flow flow)
{
    flow.flipped = 0;
    flow.turned = true;
    Shake(fx, 0.55);
    Flash(fx, ROSE, 0.3);
}

// Who took a round is only said once it's certain.
local event(verified RoundOver over) RoundTold(mut Flow flow)
{
    flow.winner = over.winner;
    flow.round = over.round;
    flow.best = over.best;
    flow.since = 0;
    flow.papered = false;
}

local event(RoundBuilt built) RoundShown(mut Flow flow)
{
    flow.built = built.round;
    flow.begun = 0;
}

// Gravity as the match has it, for what falls here.
[Stage(Layers.Camera, 5)]
view Weigh(Siege siege, mut Fx fx, mut Flow flow)
{
    // A machine that joined while it was turned over heard no event
    if (siege.flip > 0) flow.turned = true;
    flow.since += fx.dt;
    flow.begun += fx.dt;
    flow.flipped += fx.dt;
    if (fx.fired) flow.played += fx.dt;
    fx.pull = siege.flip > 0 ? 7.0 : -10.0;
}

// The sparks and the debris, on the map: each moves on, fades and goes.
// Chunks are solid, and what glows is added to what's under it.
[Stage(Layers.Effects, 10)]
view Bits(mut Fx fx)
{
    var thin = 1.3 / Math.Max(fx.meter, 1);
    mut var i = 0;
    while (i < fx.bits.count)
    {
        mut var bit = fx.bits[i];
        bit.age += fx.dt;
        if (bit.age >= bit.life)
        {
            fx.bits.RemoveAt(i);
            continue;
        }
        bit.velocity.y += fx.pull * bit.weight * fx.dt;
        bit.velocity = bit.velocity * Math.Max(0, 1 - bit.drag * fx.dt);
        bit.position += bit.velocity * fx.dt;
        bit.angle += bit.spin * fx.dt;
        fx.bits[i] = bit;
        var left = 1 - bit.age / bit.life;
        if (bit.kind == BitKind.Chunk)
            Draw2D.Rect(bit.position, float2(Math.Max(bit.size, thin * 1.5)), bit.angle, Fade(bit.color, left * 2));
        i++;
    }
    Draw.Blend(Blend.Add)
    {
        foreach (var bit in fx.bits)
        {
            var left = 1 - bit.age / bit.life;
            if (bit.kind == BitKind.Spark)
                Draw2D.Line(bit.position - bit.velocity * 0.035, bit.position, Math.Max(bit.size, thin), Fade(bit.color, left * 1.5));
            else if (bit.kind == BitKind.Glow)
                Draw2D.Shape(Shape { center = bit.position, size = float2(bit.size * 2 * left), ellipse = true,
                                     color = Fade(bit.color, left), soft = bit.size * 0.6 });
        }
    }
}

// What a crate was worth, rising from where it left the map. This machine's
// own are bigger.
[Stage(Layers.Effects, 20)]
view Labels(mut Fx fx)
{
    mut var i = 0;
    while (i < fx.labels.count)
    {
        mut var label = fx.labels[i];
        label.age += fx.dt;
        if (label.age >= label.life)
        {
            fx.labels.RemoveAt(i);
            continue;
        }
        fx.labels[i] = label;
        var t = label.age / label.life;
        var size = Math.Max(label.mine ? 1.3 : 1, (label.mine ? 22 : 16) / Math.Max(fx.meter, 1)) * (label.amount >= 5 ? 1.35 : 1)
                 * (0.6 + 0.4 * EaseBack(t * 5));
        var at = label.position + float2(0, EaseOut(t) * 2.4);
        var shown = Math.Saturate((1 - t) * 3);
        Draw2D.Text($"+{label.amount}", at + float2(0.06, -0.06), size, Fade(BACK, shown * 0.8), Anchor.MiddleCenter, Font.Bold);
        Draw2D.Text($"+{label.amount}", at, size, Fade(Mix(label.color, Color.white, label.mine ? 0.35 : 0.1), shown),
                    Anchor.MiddleCenter, Font.Bold);
        i++;
    }
}
