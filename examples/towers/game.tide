// Towers: four plinths side by side, and a race to build the tallest tower.
// Bricks come down one at a time. A player steers and turns the one that's
// falling, and once it touches anything it's a body like any other: it
// leans, slides and falls with whatever it's on. The first tower that stands
// over the finish line for three seconds takes the round. This file is the
// match, which every machine runs the same way. What a machine shows of it is
// in play.tide, effects.tide and hud.tide, and which match it's in is
// lobby.tide's to say. bots.tide is how a tower nobody steers gets built.
//
// Everything that's solid is Box2D's (the box2d package): the game spawns
// bodies, pushes them and reads where they are.
using Box2D;

settings { title = "Towers"; appId = "dev.tide.towers"; maxPlayers = 4; hostMigration = true; stats = true; }

// The world, in meters. A brick's cell is one meter, the plinths' tops start
// at y = 0, and the world's middle is x = 0.
const int SEATS = 4;           // Plinths, and the most players
const float PITCH = 11;        // From one plinth's middle to the next
const float PLINTH = 6;        // A plinth's width: six cells
const float DEPTH = 80;        // How far down a plinth goes, so that it can rise and sink
const float GROUND = -7;       // The ground between the plinths
const float FALLEN = -1.5;     // A brick under this is off its tower...
const float SPILL = 1.5;       // ...and so is one further than this past its plinth's side
const float FINISH = 40;       // The line to build over
const int HOLD = 180;          // ...and to stay over: three seconds
const int LIMIT = 5400;        // After a minute and a half of a round, the line comes down...
const float LOWER = 0.004;     // ...this far a tick, a meter every four seconds...
const float LOWEST = 12;       // ...and no lower than this

const float DROP = 9;          // How far over its tower a brick appears
const float FALL = 3.2;        // A falling brick's speed, in meters a second
const float FAST = 18;         // ...and while its player asks for more
const float EASE = 1.2;        // ...and for the last of its way, once it has touched something
const int EASED = 20;          // Ticks it comes down at that speed
const int REACH = 8;           // How far from its plinth's middle a brick is steered, in half cells
const float SLACK = 0.1;       // How much smaller a falling brick's sensor is than the brick: it slides down beside a wall it only just clears
const float GRIP = 1;          // A brick's friction
const float STEADY = 2;        // ...and how fast its spin dies by itself
const float SET_DEPTH = 10;    // A brick this far under its tower's top is set solid

const int PAUSE = 14;          // Ticks from a brick landing to the next
const int STUN = 40;           // ...and more for each brick that fell off the tower
const int STUN_MOST = 180;
const int RUBBLE = 360;        // A fallen brick lies on the ground for six seconds

const int GUST = 8;            // Ticks a gust blows
const float WIND = 1.3;        // What it gives a brick at the top of its tower each tick: an impulse
const float WIND_DEPTH = 3;    // How far down the tower it's felt
const int QUAKE = 80;          // Ticks a plinth shakes: four times there and back
const float SHAKE = 1.2;       // ...and how fast at the most, in meters a second
const float RISE = 2.5;        // How fast a plinth rises under a player who joined late
const float SINK = 14;         // ...and sinks once the round is over

const int OVER = 420;          // Ticks from a round's end to the next
const int STANDS = 170;        // The winner's tower stands for these, then goes too
const float CRUMBLE = 0.8;     // How fast what was set solid is let go, from the bottom up: meters a tick

enum Phase { Play, Over, Clear }

// The seven bricks. Each is four cells: one box, or two side by side.
enum Kind { I, O, T, L, J, S, Z }

// What a tower earns on its way up: a wind against the tallest of the others,
// all of its own bricks set solid, and every other plinth shaken.
enum Power { None, Gust, Cement, Quake }

// A box of a brick, in cells, around its body's place.
struct Part
{
    float2 size;
    float2 offset;
}

Part First(Kind kind)
{
    switch (kind)
    {
        case Kind.I: return Part { size = float2(4, 1) };
        case Kind.O: return Part { size = float2(2, 2) };
        case Kind.S: return Part { size = float2(2, 1), offset = float2(-0.5, 0) };
        case Kind.Z: return Part { size = float2(2, 1), offset = float2(0.5, 0) };
    }
    return Part { size = float2(3, 1) }; // T, L and J: a bar of three
}

// The second box, of no size for a brick that's one.
Part Second(Kind kind)
{
    switch (kind)
    {
        case Kind.T: return Part { size = float2(1, 1), offset = float2(0, 1) };
        case Kind.L: return Part { size = float2(1, 1), offset = float2(1, 1) };
        case Kind.J: return Part { size = float2(1, 1), offset = float2(-1, 1) };
        case Kind.S: return Part { size = float2(2, 1), offset = float2(0.5, 1) };
        case Kind.Z: return Part { size = float2(2, 1), offset = float2(-0.5, 1) };
    }
    return Part { };
}

// The middle of a brick's cell, by its number from 0 to 3, around its body's place.
float2 Cell(Kind kind, int index)
{
    var first = First(kind);
    var count = int(first.size.x * first.size.y);
    var part = index < count ? first : Second(kind);
    var i = index < count ? index : index - count;
    var wide = int(part.size.x);
    return part.offset + float2(i % wide, i / wide) - (part.size - float2(1)) * 0.5;
}

// A falling brick turns by quarters, clockwise: where that leaves a cell.
float2 Turned(float2 cell, int quarter)
{
    return quarter == 0 ? cell : quarter == 1 ? float2(cell.y, -cell.x) : quarter == 2 ? float2(-cell.x, -cell.y) : float2(-cell.y, cell.x);
}

float Angle(int quarter)
{
    return quarter == 0 ? 0.0 : quarter == 1 ? -Math.PI / 2 : quarter == 2 ? Math.PI : Math.PI / 2;
}

// Where a brick's highest corner is.
float Peak(float2 position, float angle, Kind kind)
{
    var s = Math.Sin(angle);
    var c = Math.Cos(angle);
    var half = 0.5 * (Math.Abs(s) + Math.Abs(c));
    mut var peak = -1000.0;
    for (var i = 0; i < 4; i++)
    {
        var cell = Cell(kind, i);
        peak = Math.Max(peak, position.y + cell.x * s + cell.y * c + half);
    }
    return peak;
}

// The column a brick starts in, in half cells from its plinth's middle: a
// brick whose body is the middle of a cell is half a cell off the plinth's
// middle, so that its cells are over the plinth's.
int Start(Kind kind)
{
    return kind == Kind.I || kind == Kind.O ? 0 : -1;
}

// Every tower is dealt the same bricks in the same order: each seven are the
// seven kinds, shuffled by the match's seed and the round.
Kind Dealt(int seed, int round, int index)
{
    mut List<int> bag = [0, 1, 2, 3, 4, 5, 6];
    for (var i = 6; i > 0; i--)
    {
        var other = Math.Hash(int4(seed, round, index / 7, i)) % (i + 1);
        var held = bag[i];
        bag[i] = bag[other];
        bag[other] = held;
    }
    return Kind(bag[index % 7]);
}

float Home(int seat)
{
    return (seat - (SEATS - 1) * 0.5) * PITCH;
}

// Whose plinth a place is over.
int Lot(float x)
{
    return Math.Clamp(int(Math.Floor(x / PITCH + SEATS * 0.5)), 0, SEATS - 1);
}

int Of(int4 values, int seat)
{
    return seat == 0 ? values.x : seat == 1 ? values.y : seat == 2 ? values.z : values.w;
}

float Of(float4 values, int seat)
{
    return seat == 0 ? values.x : seat == 1 ? values.y : seat == 2 ? values.z : values.w;
}

int4 Put(int4 values, int seat, int value)
{
    return int4(seat == 0 ? value : values.x, seat == 1 ? value : values.y, seat == 2 ? value : values.z, seat == 3 ? value : values.w);
}

float4 Put(float4 values, int seat, float value)
{
    return float4(seat == 0 ? value : values.x, seat == 1 ? value : values.y, seat == 2 ? value : values.z, seat == 3 ? value : values.w);
}

// A plinth, and what's the seat's on it: a player who takes the seat goes on
// from its tower and its wins.
component Seat
{
    int index;
    float home;        // Its middle, across
    float base;        // Its top, which rises under a player who joined late
    float top;         // Its tower's: the highest brick at rest on it
    int above;         // Ticks its tower has stood over the finish line
    int wins;
    int built = -1;    // The round it was last made ready for
    int dealt;         // Bricks it was dealt this round
    int serials;       // ...and ever: each falling brick has a number of its own
    Kind next;         // The brick that comes after the one that's falling
    bool busy;         // A brick of its own is falling
    int wait;          // Ticks until its next one
    int lost;          // Bricks that fell off this round
    int marks;         // How many quarters of the way up it has been
    Power power;       // What it has earned, and not used
    bool arrived;      // A player just took it, in the middle of a round
    bool lifted;       // It rose for one already, this round
    float lift;        // Meters it still has to rise
    // While nobody steers its bricks, it builds by itself (bots.tide). The
    // engine seeds `dice` from the match's seed.
    Random dice;
    int think;         // Ticks until it uses what it earned
}

// The brick that's falling, which its player steers. It's a kinematic body of
// sensors: it goes where it's put, stops nothing, and hears what it touches.
component Falling
{
    int seat;
    int serial;        // Its number, which its player's input names
    float home;        // Its plinth's middle
    int column;        // Where it is, in half cells from there
    int quarter;       // How it's turned, in quarter turns clockwise
    int wantColumn;    // Where it's going, and how it's to be turned
    int wantQuarter;
    bool bot;          // Nobody steers it: it follows what bots.tide planned
    int hurry;         // ...and falls fast from this tick of its fall
    int age;
    float2 free;       // Where it was, and how, before this tick moved it
    int freeColumn;
    int freeQuarter;
    int touching;      // Shapes its sensors are in
    int eased;         // Ticks left of coming down slowly, since it first touched something...
    int since;         // ...in this tick
    float speed;       // ...at this speed
    bool landed;       // It touched again: it's a brick from the next tick on
    // This machine's own, for the view: where it's drawn across and how
    // turned, on its way to where it is. Nothing of them is in the match.
    local bool drawn;
    local float across;
    local float turned;
}

// What a body is the shape of: a falling brick's, and a landed one's.
component Piece { Kind kind; }

// The brick's second box is on its body.
component Fitted { }

// A brick that landed: a dynamic body, until it's set solid.
component Brick
{
    int seat;          // Whose it is: who put it there
    int born;          // The tick it landed in
    bool down;         // It fell off its tower
    int rubble;        // Ticks until it's cleared from the ground
    bool set;          // It's set solid: a kinematic body, which goes where its plinth does
    // This machine's own, for the view: how lit it is, just landed
    local float lit;
}

component Ground { }

singleton Towers
{
    Phase phase = Phase.Clear; // The first tick starts the first round
    int round;
    int built;           // Rounds started ever, which a new game doesn't count again from 1
    int timer;
    int clock;           // Ticks this round has been played
    float line = FINISH; // Where the line is: it comes down on a round that goes on long
    int winner = -1;     // The seat whose tower took the round, while it's over
    bool bots = true;    // Towers nobody steers are built by themselves
    float4 tops;         // Each tower's top, by seat, as the last tick left it
    float4 sways;        // How fast each plinth moves across this tick, and up
    float4 rises;
    int4 gusts;          // Ticks left of the wind against each
    int4 winds;          // ...and which way it blows, -1 or 1
    int4 quakes;         // Ticks left of each plinth's shaking
    int4 sets;           // The towers whose bricks all set solid this tick
    List<Entity> plinths;      // By seat
    Map<PlayerID, int> seats;  // Each player's
}

scene Main { }

// What a player does is where they want their brick and how turned, not which
// keys they hold: another machine's guess of it stays where it was last, and a
// press that's lost on the way changes nothing. `serial` says which brick
// that's about, so that the next one doesn't start where the last was sent.
input Controls
{
    [Absolute] bool hands;      // No lobby or menu is up on this machine
    [Absolute] int serial;
    [Absolute, Clamp(-REACH, REACH)] int column;
    [Absolute, Clamp(0, 3)] int quarter;
    bool drop;

    Sample(Devices devices, Hand hand)
    {
        hands = hand.playing;
        serial = hand.serial;
        column = hand.column;
        quarter = hand.quarter;
        drop = hand.playing && hand.drop;
    }
}

// Sent to a plinth: a player took its seat, its falling brick landed, a brick
// of its tower fell off, it used what it earned, its tower took the round.
event Seated { }
event Placed { }
event Dropped { }
event Spent { }
event Won { }

// What happens in the match, said for whoever shows it: nothing in the match
// handles these, so they cost it nothing. Each machine's handlers of them are
// in effects.tide.
event Landed { float2 at; int seat; float speed; }
event Lost { float2 at; int seat; }
event Earned { int seat; Power power; }
event Struck { int seat; Power power; int target; }
event RoundOver { int round; int winner; }
event RoundBuilt { int round; }

// What the buttons ask of the match.
command Use { }
command Rebuild { }
command Bots { }

// The player who has a seat, or no player.
PlayerID Sitter(Towers towers, int seat)
{
    foreach (var entry in towers.seats)
    {
        if (entry.value == seat) return entry.key;
    }
    return default;
}

// What stays from round to round: the ground, and the plinths. A plinth is a
// kinematic body: it goes where its velocity takes it, whatever stands on it.
event(Spawned) Build(mut Towers towers, with Main)
{
    Spawn(Body { type = BodyType.Static, position = float2(0, GROUND - 0.5) }, Box { size = float2(400, 1), friction = GRIP }, Ground);
    for (var seat = 0; seat < SEATS; seat++)
    {
        var plinth = Spawn(Body { type = BodyType.Kinematic, position = float2(Home(seat), -DEPTH / 2) },
                           Box { size = float2(PLINTH, DEPTH), friction = GRIP }, Seat { index = seat, home = Home(seat) });
        towers.plinths.Add(plinth);
    }
}

// A player takes the first seat nobody has. Owner ties its plinth to them, and
// the bricks it's dealt from then on.
event(PlayerJoined joined) Sit(mut Towers towers)
{
    if (towers.seats.Has(joined.player)) return;
    for (var seat = 0; seat < SEATS; seat++)
    {
        if (Sitter(towers, seat) != default) continue;
        towers.seats[joined.player] = seat;
        towers.plinths[seat].Add(Owner { player = joined.player });
        towers.plinths[seat].Send(Seated { });
        return;
    }
}

event(PlayerLeft left) Stand(mut Towers towers)
{
    if (!towers.seats.TryGet(left.player, out var seat)) return;
    towers.plinths[seat].Remove(Owner);
    towers.seats.Remove(left.player);
}

// A falling brick goes where its player wants it, half a cell at a time, and
// turns by quarters. `controls` is the input of the player who owns it. This
// runs before the package's systems, so the step that moves it is this tick's.
//
// It falls by its body's velocity, and is put across and turned by having its
// body written. Before any of that, where it is now is kept: nothing was
// touching it there.
//
// Once it has landed it's a brick: a dynamic body where the falling one last
// was free, and the falling one goes. A body's type is read when it's made,
// so it's another body.
[Before(PhysicsStages.Step)]
system Steer(Controls controls, mut Falling falling, mut Body body, Piece piece, Towers towers, Time time)
{
    if (towers.phase != Phase.Play || body.position.y < GROUND - 6)
    {
        if (towers.phase == Phase.Play) towers.plinths[falling.seat].Send(Placed { });
        this.Destroy();
        return;
    }
    // It touched something while it came down slowly, or it's still in what
    // it first touched, a tick after it was put back
    if (falling.landed || (falling.eased > 0 && falling.touching > 0 && time.tick > falling.since + 1))
    {
        var part = First(piece.kind);
        Spawn(Body { position = falling.free, angle = Angle(falling.freeQuarter), velocity = float2(0, -EASE), angularDamping = STEADY },
              Box { size = part.size, offset = part.offset, friction = GRIP }, Piece { kind = piece.kind },
              Brick { seat = falling.seat, born = time.tick });
        towers.plinths[falling.seat].Send(Placed { });
        Send(Landed { at = falling.free, seat = falling.seat, speed = falling.speed });
        this.Destroy();
        return;
    }
    falling.free = body.position;
    falling.freeColumn = falling.column;
    falling.freeQuarter = falling.quarter;
    falling.age += 1;
    mut var fast = falling.bot && falling.age > falling.hurry && falling.column == falling.wantColumn;
    if (!falling.bot && controls.serial == falling.serial)
    {
        falling.wantColumn = controls.column;
        falling.wantQuarter = controls.quarter;
        fast = controls.drop;
    }
    if (falling.quarter != falling.wantQuarter)
    {
        falling.quarter = falling.wantQuarter;
        body.angle = Angle(falling.quarter);
    }
    if (falling.column != falling.wantColumn && falling.age % 2 == 0)
    {
        falling.column += falling.wantColumn > falling.column ? 1 : -1;
        body.position.x = falling.home + falling.column * 0.5;
    }
    if (falling.eased > 0) falling.eased -= 1;
    var speed = falling.eased > 0 ? -EASE : fast ? -FAST : -FALL;
    if (body.velocity.y != speed) body.velocity = float2(0, speed);
}

// The package sends Touched to a sensor's entity for each shape that comes
// into it, and Parted for each that leaves. The first thing a falling brick
// touches stops it short: it's put back where it was a tick before, as it
// was, and comes down from there slowly, so that it lands softly however
// fast it fell. What it touches then is where it lands.
event(Touched) Touch(mut Falling falling, mut Body body, Time time)
{
    falling.touching += 1;
    if (falling.eased > 0)
    {
        if (time.tick != falling.since) falling.landed = true;
        return;
    }
    falling.eased = EASED;
    falling.since = time.tick;
    falling.speed = -body.velocity.y;
    falling.column = falling.freeColumn;
    falling.quarter = falling.freeQuarter;
    body.position = falling.free;
    body.angle = Angle(falling.freeQuarter);
    body.velocity = float2(0, -EASE);
}

event(Parted) Away(mut Falling falling)
{
    falling.touching -= 1;
}

// The package gives an entity one Box, and five of the seven bricks are two.
// So the second goes on the body here, with the package's own function, where
// the package puts on the first: in its stage, once the body is made and
// before the step. A falling brick's are sensors, a little smaller than the
// brick.
[Stage(PhysicsStages.Step, 4)]
system Fit(Body body, Box box, Piece piece, mut Physics physics, without Fitted)
{
    var second = Second(piece.kind);
    if (second.size.x > 0)
    {
        var size = box.sensor ? second.size - float2(SLACK) : second.size;
        physics.shapes += AttachBox(body.id, Box { size = size, offset = second.offset, friction = box.friction, sensor = box.sensor });
    }
    this.Add(Fitted);
}

// A plinth moves by its velocity: it shakes in a quake, rises under a player
// who joined late, and sinks once the round is over, the winner's last. And a
// new round makes its seat ready. How fast it moves is left in Towers, for
// the bricks that are set solid on it.
[Before(PhysicsStages.Step)]
system Move(mut Seat seat, mut Body body, mut Towers towers, Time time)
{
    mut var velocity = float2(0, 0);
    if (towers.phase == Phase.Play && seat.built != towers.built)
    {
        seat.built = towers.built;
        seat.above = 0;
        seat.dealt = 0;
        seat.next = Dealt(time.seed, towers.round, 0);
        seat.busy = false;
        seat.wait = 30 + seat.index * 6;
        seat.lost = 0;
        seat.marks = 0;
        seat.power = Power.None;
        seat.arrived = false;
        seat.lifted = false;
        seat.lift = 0;
        if (towers.round == 1) seat.wins = 0;
        body.position = float2(seat.home, -DEPTH / 2);
        this.Snap();
    }
    else if (towers.phase == Phase.Over)
    {
        var stands = seat.index == towers.winner && towers.timer > OVER - STANDS;
        if (!stands && body.position.y > -DEPTH / 2 + GROUND - 3) velocity.y = -SINK;
    }
    else if (towers.phase == Phase.Play)
    {
        if (seat.arrived)
        {
            // Up to the lowest of the other players' towers, once a round
            seat.arrived = false;
            mut var lowest = 1000.0;
            foreach (var entry in towers.seats)
            {
                if (entry.value != seat.index) lowest = Math.Min(lowest, Of(towers.tops, entry.value));
            }
            var rise = Math.Floor(Math.Min(lowest, FINISH * 0.6) - seat.top);
            if (lowest < 1000 && rise >= 1 && !seat.lifted)
            {
                seat.lift = rise;
                seat.lifted = true;
                seat.marks = Math.Max(seat.marks, int((seat.top + rise) * 4 / FINISH));
            }
        }
        var quake = Of(towers.quakes, seat.index);
        if (quake > 0) velocity.x = SHAKE * Math.Sin((QUAKE - quake) * Math.TAU / 20);
        else if (body.position.x != seat.home) body.position.x = seat.home;
        if (seat.lift > 0)
        {
            velocity.y = RISE;
            seat.lift -= RISE * time.dt;
        }
    }
    if (body.velocity.x != velocity.x || body.velocity.y != velocity.y) body.velocity = velocity;
    var carries = towers.phase == Phase.Play;
    towers.sways = Put(towers.sways, seat.index, carries ? velocity.x : 0.0);
    towers.rises = Put(towers.rises, seat.index, carries ? velocity.y : 0.0);
}

// What's done to bricks before the step. One that's set solid goes where its
// plinth does: it's a kinematic body, so it's given the plinth's velocity. A
// gust pushes the loose ones near the top of the tower it's against, with an
// impulse each tick it blows: more, the nearer the top. This looks at every
// brick and writes a few, so it takes Body to read and puts the ones it
// changed back through the World.
[Before(PhysicsStages.Step)]
system Push(Body body, Piece piece, Brick brick, Towers towers, mut World world)
{
    if (brick.down) return;
    var lot = Lot(body.position.x);
    if (brick.set)
    {
        var velocity = float2(Of(towers.sways, lot), Of(towers.rises, lot));
        if (body.velocity.x == velocity.x && body.velocity.y == velocity.y) return;
        mut var carried = body;
        carried.velocity = velocity;
        world.Set<Body>(this, carried);
        return;
    }
    if (Of(towers.gusts, lot) <= 0 || Math.Abs(body.position.x - Home(lot)) > PLINTH) return;
    var depth = Of(towers.tops, lot) - Peak(body.position, body.angle, piece.kind);
    if (depth > WIND_DEPTH) return;
    mut var pushed = body;
    pushed.impulse.x += Of(towers.winds, lot) * WIND * (1 - Math.Max(depth, 0) / WIND_DEPTH);
    world.Set<Body>(this, pushed);
}

// How high each tower stands: its highest brick that's at rest over its
// plinth. The query goes through every brick, for each plinth. A tower that's
// a quarter of the way further up than it has been earns something.
[After(PhysicsStages.Step)]
system Measure(mut Seat seat, Body body, Towers towers, query (Body at, Piece piece, Brick brick) bricks)
{
    seat.base = body.position.y + DEPTH / 2;
    mut var top = seat.base;
    foreach (var entry in bricks)
    {
        if (entry.brick.down || entry.at.position.y + 2.5 < top || Math.Abs(entry.at.position.x - seat.home) > PLINTH / 2 + 1) continue;
        if (!entry.brick.set && Math.LengthSq(entry.at.velocity) > 0.16) continue;
        top = Math.Max(top, Peak(entry.at.position, entry.at.angle, entry.piece.kind));
    }
    seat.top = top;
    if (towers.phase != Phase.Play) return;
    seat.above = top >= towers.line ? seat.above + 1 : 0;
    if (seat.marks < 3 && top >= FINISH * (seat.marks + 1) / 4)
    {
        seat.marks += 1;
        seat.power = Power(seat.marks);
        seat.think = 50 + seat.dice.NextInt(140);
        Send(Earned { seat = seat.index, power = seat.power });
    }
}

// A brick that's under the plinths' tops, or well to the side of every
// plinth, is off its tower: whoever put it there waits longer for their next
// one, and it lies where it falls a while before it's cleared. An entity
// that's destroyed takes its body with it.
//
// A brick at rest that's deep enough under its tower's top is set solid, as
// if its mortar had: a tower only ever leans and comes down from its top
// part. Cement sets all of a tower at once. A brick that's set is a
// kinematic body in the dynamic one's place, and when the round is over a
// dynamic one again, from the bottom of its tower up: what comes down then is
// all of it.
[After(PhysicsStages.Step)]
system Tend(Body body, Piece piece, mut Brick brick, Towers towers)
{
    if (towers.phase == Phase.Clear)
    {
        this.Destroy();
        return;
    }
    if (brick.down)
    {
        brick.rubble -= 1;
        if (brick.rubble <= 0 && towers.phase == Phase.Play) this.Destroy();
        return;
    }
    var part = First(piece.kind);
    var lot = Lot(body.position.x);
    if (brick.set)
    {
        var since = OVER - towers.timer - (lot == towers.winner ? STANDS : 0);
        if (towers.phase != Phase.Over || body.position.y > since * CRUMBLE) return;
        Spawn(Body { position = body.position, angle = body.angle, angularDamping = STEADY },
              Box { size = part.size, offset = part.offset, friction = GRIP }, Piece { kind = piece.kind },
              Brick { seat = brick.seat, born = brick.born });
        this.Destroy();
        return;
    }
    var aside = Math.Abs(body.position.x - Home(lot)) - PLINTH / 2;
    if (body.position.y < FALLEN || aside > SPILL)
    {
        brick.down = true;
        brick.rubble = RUBBLE;
        if (towers.phase != Phase.Play) return;
        towers.plinths[brick.seat].Send(Dropped { });
        Send(Lost { at = body.position, seat = brick.seat });
        return;
    }
    if (towers.phase != Phase.Play || aside > 1 || Math.LengthSq(body.velocity) > 0.04 || Math.Abs(body.spin) > 0.2) return;
    if (Of(towers.sets, lot) <= 0 && body.position.y > Of(towers.tops, lot) - SET_DEPTH) return;
    Spawn(Body { type = BodyType.Kinematic, position = body.position, angle = body.angle },
          Box { size = part.size, offset = part.offset, friction = GRIP }, Piece { kind = piece.kind },
          Brick { seat = brick.seat, born = brick.born, set = true });
    this.Destroy();
}

// A seat is dealt its next brick once the last has landed and its wait is
// over. `controls` is the input of the player who has the seat: while their
// lobby or menu is up, or with nobody there, the tower builds by itself.
[After(PhysicsStages.Step)]
system Deal(Controls controls, mut Seat seat, Towers towers, Time time, query (Body at, Piece piece, Brick brick) bricks)
{
    if (towers.phase != Phase.Play || seat.built != towers.built) return;
    var player = Sitter(towers, seat.index);
    var hands = player != default && controls.hands;
    if (!hands && !towers.bots) return;
    if (!hands && seat.power != Power.None)
    {
        seat.think -= 1;
        if (seat.think <= 0) this.Send(Spent { });
    }
    if (seat.busy) return;
    if (seat.wait > 0)
    {
        seat.wait -= 1;
        return;
    }
    var kind = seat.next;
    seat.dealt += 1;
    seat.next = Dealt(time.seed, towers.round, seat.dealt);
    seat.serials += 1;
    seat.busy = true;
    var serial = seat.serials * SEATS + seat.index;
    var first = First(kind);
    var at = float2(seat.home + Start(kind) * 0.5, Math.Ceil(seat.top) + DROP);
    if (hands)
    {
        Spawn(Body { type = BodyType.Kinematic, position = at, velocity = float2(0, -FALL) },
              Box { size = first.size - float2(SLACK), offset = first.offset, sensor = true }, Piece { kind = kind },
              Falling { seat = seat.index, serial = serial, home = seat.home, column = Start(kind), wantColumn = Start(kind), free = at,
                        freeColumn = Start(kind) },
              Owner { player = player });
        return;
    }
    // For the plan: how high the tower stands in each of the plinth's six
    // columns, and whether the brick that's on top there lies askew
    mut List<float> heights = [0, 0, 0, 0, 0, 0];
    mut List<bool> askew = [false, false, false, false, false, false];
    foreach (var entry in bricks)
    {
        if (entry.brick.down || Math.Abs(entry.at.position.x - seat.home) > PLINTH / 2 + 2) continue;
        var s = Math.Sin(entry.at.angle);
        var c = Math.Cos(entry.at.angle);
        var half = 0.5 * (Math.Abs(s) + Math.Abs(c));
        for (var i = 0; i < 4; i++)
        {
            var cell = Cell(entry.piece.kind, i);
            var column = int(Math.Floor(entry.at.position.x + cell.x * c - cell.y * s - seat.home + PLINTH / 2));
            var height = entry.at.position.y + cell.x * s + cell.y * c + half - seat.base;
            if (column < 0 || column >= 6 || height <= heights[column]) continue;
            heights[column] = height;
            askew[column] = Math.Abs(s * c) > 0.1;
        }
    }
    // No two towers are built alike: each seat is so careful, and so quick, for a round
    var temper = Math.Hash(int3(time.seed, towers.round, seat.index));
    var plan = Think(kind, heights, askew, temper % 100 * 0.003, seat.dice);
    Spawn(Body { type = BodyType.Kinematic, position = at, velocity = float2(0, -FALL) },
          Box { size = first.size - float2(SLACK), offset = first.offset, sensor = true }, Piece { kind = kind },
          Falling { seat = seat.index, serial = serial, home = seat.home, column = Start(kind), wantColumn = plan.column,
                    wantQuarter = plan.quarter, bot = true, hurry = 20 + temper / 100 % 30 + seat.dice.NextInt(30), free = at,
                    freeColumn = Start(kind) });
}

event(Seated) Arrive(mut Seat seat, Towers towers)
{
    seat.arrived = towers.phase == Phase.Play;
}

event(Placed) Next(mut Seat seat)
{
    seat.busy = false;
    seat.wait = Math.Max(seat.wait, PAUSE);
}

event(Dropped) Stall(mut Seat seat)
{
    seat.lost += 1;
    seat.wait = Math.Min(seat.wait + STUN, STUN_MOST);
}

event(Won) Win(mut Seat seat)
{
    seat.wins += 1;
}

// A seat uses what it earned. The gust is against the tallest of the other
// towers, and blows away from this one.
event(Spent) Spend(mut Seat seat, mut Towers towers)
{
    if (seat.power == Power.None || towers.phase != Phase.Play) return;
    var power = seat.power;
    seat.power = Power.None;
    mut var target = seat.index;
    if (power == Power.Gust)
    {
        mut var tallest = -1000.0;
        for (var other = 0; other < SEATS; other++)
        {
            if (other == seat.index || Of(towers.tops, other) <= tallest) continue;
            tallest = Of(towers.tops, other);
            target = other;
        }
        towers.gusts = Put(towers.gusts, target, GUST);
        towers.winds = Put(towers.winds, target, target > seat.index ? 1 : -1);
    }
    else if (power == Power.Quake)
    {
        for (var other = 0; other < SEATS; other++)
        {
            if (other != seat.index) towers.quakes = Put(towers.quakes, other, QUAKE);
        }
    }
    else
    {
        towers.sets = Put(towers.sets, seat.index, 1);
    }
    Send(Struck { seat = seat.index, power = power, target = target });
}

// The rounds. A tower that has stood over the line long enough takes the
// round, the tallest if there are several; the plinths sink, and everything
// comes down; then all of it goes, and the next round starts. A round that
// goes on long ends all the same: the line comes down to the towers.
[After(PhysicsStages.Step)]
system Rounds(mut Towers towers, query (Seat seat) seats)
{
    mut var winner = -1;
    mut var tallest = 0.0;
    foreach (var entry in seats)
    {
        towers.tops = Put(towers.tops, entry.seat.index, entry.seat.top);
        if (entry.seat.above < HOLD || entry.seat.top <= tallest) continue;
        tallest = entry.seat.top;
        winner = entry.seat.index;
    }
    towers.gusts = Math.Max(towers.gusts - int4(1), int4(0));
    towers.quakes = Math.Max(towers.quakes - int4(1), int4(0));
    towers.sets = int4(0);
    if (towers.phase == Phase.Play)
    {
        towers.clock += 1;
        towers.line = Math.Max(FINISH - Math.Max(towers.clock - LIMIT, 0) * LOWER, LOWEST);
        if (winner < 0) return;
        towers.phase = Phase.Over;
        towers.timer = OVER;
        towers.winner = winner;
        towers.plinths[winner].Send(Won { });
        Send(RoundOver { round = towers.round, winner = winner });
        return;
    }
    if (towers.phase == Phase.Over)
    {
        towers.timer -= 1;
        if (towers.timer <= 0) towers.phase = Phase.Clear;
        return;
    }
    towers.round += 1;
    towers.built += 1;
    towers.phase = Phase.Play;
    towers.clock = 0;
    towers.line = FINISH;
    towers.winner = -1;
    towers.gusts = int4(0);
    towers.quakes = int4(0);
    Send(RoundBuilt { round = towers.round });
}

// A player uses what their tower earned.
command(Use use, PlayerID sender) UsePower(Towers towers)
{
    if (towers.seats.TryGet(sender, out var seat)) towers.plinths[seat].Send(Spent { });
}

// The New game button: a first round again, with nobody's wins.
command(Rebuild rebuild, PlayerID sender) Reset(mut Towers towers)
{
    towers.phase = Phase.Clear;
    towers.round = 0;
}

command(Bots bots, PlayerID sender) Idle(mut Towers towers)
{
    towers.bots = !towers.bots;
}
