// Over the world, in the screen's pixels: how high everyone is, the brick
// that comes next, what a tower has earned, the words when something happens,
// and what to do first. None of it shows while the lobby or the menu is up
// (lobby.tide).
using Box2D;

const float HEADROOM = 48; // The height of the row along the top, which the camera keeps the brick under
const float FOOT = 62;     // ...and of the buttons along the bottom, which it keeps the tower's top over

// How much of the screen's bottom right corner the game leaves to the engine's
// stats (the `stats` setting): their one line, which is the frame rate, and in
// a match another machine runs, the ping too.
float StatsCorner(Session session)
{
    return session.server ? 100 : 196;
}

// A crown, for whoever leads: its middle at `at`.
void Crown(float2 at, float size, Color color)
{
    Draw2D.RoundRect(at + float2(0, size * 0.25), float2(size * 1.5, size * 0.45), size * 0.12, color);
    for (var i = -1; i <= 1; i++)
        Draw2D.Circle(at + float2(i * size * 0.55, -size * 0.2), size * 0.28, color);
}

// A brick drawn small, on the screen: its four cells around `at`, `cell`
// pixels each. The screen's y goes down, so a cell that's up is drawn up.
void Icon(Kind kind, float2 at, float cell, Color color)
{
    // Around the middle of what it covers, not its body's place
    mut var low = float2(10, 10);
    mut var high = float2(-10, -10);
    for (var i = 0; i < 4; i++)
    {
        low = Math.Min(low, Cell(kind, i));
        high = Math.Max(high, Cell(kind, i));
    }
    var middle = (low + high) * 0.5;
    for (var i = 0; i < 4; i++)
    {
        var place = Cell(kind, i) - middle;
        Draw2D.Shape(Shape { center = at + float2(place.x, -place.y) * cell, size = float2(cell - 1), radius = cell * 0.18,
                             color = Mix(color, Color.white, 0.12), color2 = Shade(color, 0.72), outline = 1, outlineColor = Shade(color, 0.45) });
    }
}

string PowerName(Power power)
{
    return power == Power.Gust ? "GUST" : power == Power.Cement ? "CEMENT" : power == Power.Quake ? "QUAKE" : "";
}

Color PowerColor(Power power)
{
    return power == Power.Gust ? TEAL : power == Power.Cement ? STONE : ROSE;
}

// Whatever just lit the whole screen fades here, and the wind against this
// machine's player's tower blows across it.
[Stage(Layers.Hud)]
view Glare(Fx fx, Flow flow)
{
    Draw2D.SetScreen();
    var screen = float2(Screen.width, Screen.height);
    Draw.Blend(Blend.Add)
    {
        if (flow.wind > 0)
        {
            for (var i = 0; i < 9; i++)
            {
                var along = Math.Frac(i * 0.37 + (1 - flow.wind) * (1.4 + i * 0.13));
                var x = flow.windWay > 0 ? along * (screen.x + 160) - 80 : screen.x + 80 - along * (screen.x + 160);
                var y = HEADROOM + (screen.y - HEADROOM - 60) * Math.Frac(i * 0.618 + 0.1);
                Draw2D.Line(float2(x, y), float2(x - flow.windWay * (50 + i * 9), y), 2, Fade(TEAL, flow.wind * 0.5));
            }
        }
        if (fx.flash > 0) Draw2D.Rect(screen * 0.5, screen, Fade(fx.flashColor, fx.flash));
    }
}

// The row along the top: each tower's height, as the server has confirmed it,
// with this machine's player's marked and a crown on whoever is highest. The
// heights are on the plinths' seats, so the query goes through them all.
[Stage(Layers.Hud, 10)]
view Chips(verified Towers sure, Fx fx, Flow flow, Lobby lobby, query (verified Seat seat) seats)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None && WATCH != 2) return;
    // Side by side in the screen's middle, as wide as a narrow one lets them be
    var slot = Math.Min(Screen.width / SEATS, 112);
    var first = (Screen.width - slot * SEATS) * 0.5;
    mut var best = 0.5;
    mut var leader = -1;
    foreach (var entry in seats)
    {
        if (entry.seat.top <= best) continue;
        best = entry.seat.top;
        leader = entry.seat.index;
    }
    foreach (var entry in seats)
    {
        var seat = entry.seat.index;
        var manned = Sitter(sure, seat) != default;
        var mine = seat == fx.seat;
        var color = manned || sure.bots ? SeatColor(seat) : Shade(SeatColor(seat), 0.45);
        var middle = float2(first + (seat + 0.5) * slot, HEADROOM * 0.5);
        var wide = Math.Min(slot - 8, 96);
        var pop = Math.Saturate(1 - Of(flow.earned, seat) * 2);
        Draw2D.Shape(Shape { center = middle, size = float2(wide, HEADROOM - 8), radius = 10,
                             color = mine ? Color(0.21, 0.215, 0.235) : Color(0.115, 0.118, 0.13, 0.9),
                             outline = mine ? 1.5 : 0, outlineColor = Fade(Color.white, 0.75) });
        var number = $"{int(Math.Max(entry.seat.top, 0))}";
        var size = Math.Round(22 * (1 + 0.3 * pop));
        var across = Draw2D.MeasureText(number, size, Font.Bold).x + Draw2D.MeasureText("m", 12, Font.Bold).x + 2;
        var left = middle.x - (across + 16) * 0.5;
        if (seat == leader) Crown(float2(left + 5, middle.y - 6), 7, GOLD);
        else Draw2D.Circle(float2(left + 5, middle.y - 6), 5, color);
        Draw2D.Text(number, float2(left + 16, middle.y - 6), size, pop > 0 ? Mix(color, Color.white, pop) : color,
                    Anchor.MiddleLeft, Font.Bold);
        Draw2D.Text("m", float2(left + across + 16, middle.y - 3), 12, Fade(color, 0.8), Anchor.MiddleRight, Font.Bold);
        // Its wins, a pip each, beside who has it
        var who = mine ? "YOU" : manned ? "PLAYER" : sure.bots ? "BOT" : "OFF";
        Draw2D.Text(who, middle + float2(0, 12), 10, mine ? Color.white : Fade(QUIET, manned ? 1 : 0.7), Anchor.MiddleCenter,
                    mine ? Font.Bold : Font.Regular);
        for (var i = 0; i < Math.Min(entry.seat.wins, 5); i++)
            Draw2D.Circle(float2(middle.x + wide * 0.5 - 8 - i * 6, middle.y + 12), 2, GOLD);
    }
}

// The race, down the screen's left side: the finish line at the top, the
// plinths' tops at the bottom, and a mark for each tower where it stands.
// It says who's ahead while only one tower is in sight.
[Stage(Layers.Hud, 12)]
view Race(Towers towers, Fx fx, Lobby lobby, query (Seat seat) seats)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None && WATCH != 2) return;
    var top = HEADROOM + 26;
    var bottom = Screen.height - 76;
    if (bottom - top < 80) return;
    var x = 14.0;
    Draw2D.RoundRect(float2(x, (top + bottom) * 0.5), float2(6, bottom - top + 6), 3, Color(0.115, 0.118, 0.13, 0.9));
    Draw2D.RoundRect(float2(x, top), float2(16, 3), 1.5, GOLD);
    Draw2D.Text("FINISH", float2(x + 12, top), 9, GOLD, Anchor.MiddleLeft, Font.Bold);
    // The quarters, where a tower earns something
    for (var i = 1; i < 4; i++)
        Draw2D.Rect(float2(x, bottom - (bottom - top) * i / 4), float2(10, 1), LINE);
    foreach (var entry in seats)
    {
        var mine = entry.seat.index == fx.seat;
        var y = bottom - (bottom - top) * Math.Saturate(entry.seat.top / FINISH);
        var color = SeatColor(entry.seat.index);
        var out = mine ? 0.0 : 3.0 + entry.seat.index * 1.5;
        if (mine)
        {
            Draw2D.Shape(Shape { center = float2(x + 10, y), size = float2(22, 12), radius = 6, color = color, outline = 1.5,
                                 outlineColor = Color.white });
        }
        else
        {
            Draw2D.Circle(float2(x + out, y), 4.5, Shade(color, 0.35));
            Draw2D.Circle(float2(x + out, y), 3.5, color);
        }
        // Over the line: how long it has to stand there still
        if (entry.seat.above > 0 && towers.phase == Phase.Play)
            Draw2D.Arc(float2(x + (mine ? 10 : out), y), 9, Math.PI / 2, -Math.TAU * entry.seat.above / HOLD, 2, Color.white);
    }
}

// What this machine's player's seat is dealt next, and what its tower has
// earned: a button, which sends a command when it's pressed. `with ownership`
// picks the plinth this machine's player owns.
[Stage(Layers.Hud, 14)]
view Tray(Seat seat, Session session, Devices devices, Towers towers, Fx fx, Lobby lobby, with ownership)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None && WATCH != 2) return;
    var screen = float2(Screen.width, Screen.height);
    var at = float2(screen.x - 38, HEADROOM + 36);
    Draw2D.Shape(Shape { center = at, size = float2(60, 56), radius = 10, color = Color(0.115, 0.118, 0.13, 0.9), outline = 1,
                         outlineColor = LINE });
    Draw2D.Text("NEXT", at - float2(0, 19), 9, QUIET, Anchor.MiddleCenter, Font.Bold);
    Icon(seat.next, at + float2(0, 6), 11, SeatColor(seat.index));
    // The wait for the next brick, when bricks fell off: a ring that runs out
    if (!seat.busy && seat.wait > PAUSE && towers.phase == Phase.Play)
    {
        var middle = float2(screen.x * 0.5, HEADROOM + 40);
        Draw2D.Circle(middle, 17, Color(0.1, 0.1, 0.11, 0.9));
        Draw2D.Arc(middle, 14, Math.PI / 2, -Math.TAU * Math.Saturate(seat.wait / float(STUN_MOST)), 4, ROSE);
        Draw2D.Text("WAIT", middle + float2(0, 28), 10, ROSE, Anchor.MiddleCenter, Font.Bold);
    }
    if (seat.power == Power.None || towers.phase != Phase.Play) return;
    var color = PowerColor(seat.power);
    var wide = Math.Min(150, screen.x - 96 - StatsCorner(session) - 12);
    var rect = Rect(96 + (screen.x - 96 - StatsCorner(session) - wide) * 0.5, screen.y - 52, wide, 44);
    var pulse = 0.5 + 0.5 * Math.Sin(fx.beat * 2);
    Draw.Blend(Blend.Add)
    {
        Draw2D.Shape(Shape { center = Middle(rect), size = float2(rect.width, rect.height), radius = 12, color = Fade(color, 0.2 + pulse * 0.2),
                             soft = 10 });
    }
    if (Pill(rect, PowerName(seat.power), color, true, true) || devices.keyboard.e.down || devices.keyboard.enter.down) Send(Use { });
}

// A band across the screen, in a color, with a line of words and a smaller
// one under it: open for `open`, from 0 to 1.
void Band(float2 middle, float open, bool big, Color tint, string words, string under)
{
    var screen = float2(Screen.width, Screen.height);
    var tall = (big ? 84 : 60) * open;
    Draw.Blend(Blend.Add)
    {
        Draw2D.Shape(Shape { center = middle, size = float2(screen.x + 80, tall), color = Fade(tint, 0.25 * open), soft = 40 });
    }
    Draw2D.Shape(Shape { center = middle, size = float2(screen.x + 80, tall), color = Shade(tint, 0.95), color2 = Shade(tint, 0.7) });
    Draw2D.Rect(middle - float2(0, tall * 0.5 + 4), float2(screen.x, 2 * open), Fade(Color.white, 0.85));
    Draw2D.Rect(middle + float2(0, tall * 0.5 + 4), float2(screen.x, 2 * open), Fade(Color.white, 0.85));
    Draw.Tint(Fade(Color.white, Math.Saturate(open * 1.5 - 0.5)))
    {
        var size = big ? 30 : 20;
        // As big as fits
        var fit = Math.Min(1, (screen.x - 24) / Math.Max(1, Draw2D.MeasureText(words, size, Font.Bold).x));
        Draw2D.Text(words, middle - float2(0, under == "" ? 0 : (big ? 9 : 7)), Math.Floor(size * fit), BACK, Anchor.MiddleCenter, Font.Bold);
        if (under != "") Draw2D.Text(under, middle + float2(0, big ? 21 : 15), big ? 14 : 12, Fade(BACK, 0.8), Anchor.MiddleCenter);
    }
}

// The words over the world: who took a round, which round starts, and what
// was just used against whom. A round's winner is the server's to say, so it
// comes from a `verified` event's handler (effects.tide).
[Stage(Layers.Hud, 20)]
view Words(Towers towers, Session session, Lobby lobby, mut Flow flow, mut Fx fx)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None && WATCH != 2) return;
    var screen = float2(Screen.width, Screen.height);
    var big = screen.x >= 640 && screen.y >= 420;
    var middle = float2(screen.x * 0.5, HEADROOM + (screen.y - HEADROOM) * 0.3);

    if (flow.since < 3.2)
    {
        var open = EaseOut(flow.since / 0.2) * (1 - EaseOut((flow.since - 2.9) / 0.3));
        var mine = flow.winner >= 0 && flow.winner == fx.seat;
        var tint = SeatColor(flow.winner);
        var words = mine ? $"YOU TAKE ROUND {flow.round}" : $"{SeatName(flow.winner)} TAKES ROUND {flow.round}";
        Band(middle, open, big, tint, words, "First over the line");
        if (!flow.papered)
        {
            flow.papered = true;
            Paper(fx, float2(screen.x * 0.3, middle.y), mine ? 40 : 18, 420, tint);
            Paper(fx, float2(screen.x * 0.7, middle.y), mine ? 40 : 18, 420, tint);
        }
    }
    else if (flow.begun < 1.3 && flow.built > 0 && towers.phase == Phase.Play)
    {
        var shown = Math.Saturate(flow.begun * 6) * Math.Saturate((1.3 - flow.begun) * 3);
        var size = Math.Round((big ? 54 : 36) * (1 + 0.3 * Math.Max(0, 1 - flow.begun * 6)) * 0.5) * 2;
        Draw.Tint(Fade(Color.white, shown))
        {
            Draw2D.Text($"ROUND {flow.built}", middle + float2(0, 3), size, Fade(BACK, 0.7), Anchor.MiddleCenter, Font.Bold);
            Draw2D.Text($"ROUND {flow.built}", middle, size, Color.white, Anchor.MiddleCenter, Font.Bold);
        }
    }

    if (flow.cast < 2.2 && flow.since >= 3.2 && flow.striker >= 0)
    {
        // Under the top row: who used what, against whom
        var at = float2(screen.x * 0.5, HEADROOM + 24);
        var enter = EaseBack(flow.cast / 0.25) * Math.Saturate((2.2 - flow.cast) * 4);
        var color = PowerColor(flow.struck);
        var who = flow.striker == fx.seat ? "YOU" : SeatName(flow.striker);
        var what = flow.struck == Power.Gust ? (flow.target == fx.seat ? $"{who}: A GUST AT YOU" : $"{who}: A GUST AT {SeatName(flow.target)}")
                 : flow.struck == Power.Quake ? (flow.striker == fx.seat ? "YOU SHAKE THE OTHERS" : $"{who} SHAKES THE REST")
                 : (flow.striker == fx.seat ? "YOUR TOWER IS SET" : $"{who}'S TOWER IS SET");
        var wide = Draw2D.MeasureText(what, 13, Font.Bold).x + 30;
        Draw2D.Shape(Shape { center = at, size = float2(wide, 30) * enter, radius = 15, color = Color(0.1, 0.1, 0.11, 0.94), outline = 1.5,
                             outlineColor = color });
        if (enter > 0.9) Draw2D.Text(what, at, 13, color, Anchor.MiddleCenter, Font.Bold);
    }

    // The match's host left, and another machine is taking it over
    if (session.state == SessionState.Connecting)
    {
        var at = float2(screen.x * 0.5, HEADROOM + 62);
        Draw2D.Shape(Shape { center = at, size = float2(Math.Min(screen.x - 16, 300), 34), radius = 17, color = Color(0.1, 0.1, 0.11, 0.94),
                             outline = 1.5, outlineColor = LINE });
        Draw2D.Text("The host left. Finding the match again...", at, 12, INK, Anchor.MiddleCenter);
    }
}

// What to do first, until the player has done it.
[Stage(Layers.Hud, 30)]
view Hints(Towers towers, Session session, Devices devices, Fx fx, Lobby lobby)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None && WATCH != 2 || fx.seat < 0 || towers.phase != Phase.Play || fx.steered) return;
    var screen = float2(Screen.width, Screen.height);
    var words = devices.touchscreen.connected ? "Drag to move, tap to turn, swipe down to drop" : "Drag or arrows to move, tap or up to turn";
    var wide = Draw2D.MeasureText(words, 13).x + 28;
    // In the screen's middle: on a wide one, as far left as leaves the bottom
    // right corner to the stats, and on a narrow one, above them
    var at = screen.x < 520 ? float2(screen.x * 0.5, screen.y - 72)
           : float2(Math.Min(screen.x * 0.5, screen.x - StatsCorner(session) - wide * 0.5), screen.y - 30);
    var bob = Math.Sin(fx.beat * 2) * 2;
    Draw2D.Shape(Shape { center = at + float2(0, bob), size = float2(Math.Min(wide, screen.x - 12), 30), radius = 15, color = Color(0.1, 0.1, 0.11, 0.92),
                         outline = 1.5, outlineColor = LINE });
    Draw2D.Text(words, at + float2(0, bob), 13, INK, Anchor.MiddleCenter);
}

// The way to the menu, and the room this machine is in, for whoever asks.
// The bottom right corner is the engine's stats'.
[Stage(Layers.Hud, 40)]
view Corner(Session session, Devices devices, mut Lobby lobby)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None && WATCH != 2) return;
    var bottom = Screen.height;
    if (session.room != "")
    {
        // Over the button, out of the way of what the tower earned
        Draw2D.Text($"ROOM {session.room}", float2(10, bottom - 62), 10, QUIET, Anchor.MiddleLeft, Font.Bold);
    }
    var pressed = Pill(Rect(8, bottom - 52, 84, 44), "MENU", INK, false, true);
    if (pressed || devices.keyboard.escape.down)
    {
        lobby.page = Page.Room;
        lobby.resume = true;
    }
    if (devices.keyboard.r.down && session.state == SessionState.Connected) Send(Rebuild { });
}

// Paper for a round's winner, over everything but the menu.
[Stage(Layers.Hud, 50)]
view Confetti(mut Fx fx)
{
    Draw2D.SetScreen();
    mut var i = 0;
    while (i < fx.paper.count)
    {
        mut var bit = fx.paper[i];
        bit.age += fx.dt;
        if (bit.age >= bit.life)
        {
            fx.paper.RemoveAt(i);
            continue;
        }
        bit.velocity.y += 620 * fx.dt;
        bit.velocity = bit.velocity * Math.Max(0, 1 - bit.drag * fx.dt);
        bit.position += bit.velocity * fx.dt;
        bit.angle += bit.spin * fx.dt;
        fx.paper[i] = bit;
        // It turns over as it falls
        var flat = Math.Abs(Math.Sin(bit.angle * 1.7));
        Draw2D.Rect(bit.position, float2(bit.size, bit.size * (0.25 + 0.75 * flat)), bit.angle,
                    Fade(bit.color, (1 - bit.age / bit.life) * 3));
        i++;
    }
}
