// Which match this machine is in is this file's to say: the lobby the game
// opens on, the room a player hosts or joins, and the menu back to both from
// a match.
//
// The lobby is drawn over a live match. `Main` is the match's scene, so a
// match of this machine's own starts with the program, closed, with the bots
// building all four towers: that's what's behind the title. Playing alone is closing
// the lobby, hosting is opening that match to others (Session.Open), and
// joining leaves it for someone else's (Session.Join). Nothing of the lobby is
// in the match: it's a local singleton, and a view over the others.
//
// A machine that was told which match to be in has no lobby in its way: with
// `--host` or `--join <code>` on its command line, or `?host` or
// `?join=<code>` in its page's address, the session is open or joining by the
// first frame, and the lobby starts closed.
using Box2D;

enum Page
{
    None,  // Playing: no page is up
    Title, // The game's name, and the three ways in
    Join,  // A room's code to type, and the wait to be let in
    Room   // The room and who's in it: the host's lobby, and the menu from a match
}

local singleton Lobby
{
    bool started;      // The first frame decided where this machine starts
    Page page = Page.Title;
    bool resume;       // The room's page came up from a match, not from the title
    string code;       // What's typed into the Join page's field
    string message;    // What became of the last match, for the page it left this machine on
    bool joining;      // This machine asked to join a room, and isn't in it yet
    float shown;       // How far the page has faded in, 0 to 1
    float turn;        // How far round the spinner is, in turns
    float copied = 10; // Seconds since the room's code was copied
    // What the pages show of the match, left here each frame by a view that reads it
    int manned;        // The seats players have, a bit each
    int mine = -1;     // This machine's player's
    int players;
    bool bots = true;
}

float2 Middle(Rect rect)
{
    return float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
}

// A button of the game's own: a control, whose input the GUI handles (the
// pointer's, the keyboard's and a gamepad's alike), drawn here. A solid one is
// the page's main way on. Returns whether it was pressed.
bool Pill(Rect rect, string label, Color tint, bool solid, bool enabled)
{
    mut var pill = GUIControl { };
    GUI.Disabled(!enabled)
    {
        pill = GUI.Control(rect);
    }
    var over = pill.hovered || pill.focused;
    var center = Middle(rect) + float2(0, pill.pressed && pill.hovered ? 1.5 : 0);
    var size = float2(rect.width, rect.height);
    var radius = Math.Min(rect.height * 0.5, 12);
    var faint = enabled ? 1.0 : 0.4;
    if (solid)
    {
        var fill = over ? Mix(tint, Color.white, 0.28) : tint;
        Draw2D.Shape(Shape { center = center + float2(0, 3), size = size, radius = radius, color = Fade(Shade(tint, 0.4), faint) });
        Draw2D.Shape(Shape { center = center, size = size, radius = radius, color = Fade(fill, faint),
                             color2 = Fade(Shade(fill, 0.86), faint), outline = pill.focused ? 2.5 : 0.0,
                             outlineColor = Color.white });
        Draw2D.Text(label, center, rect.height >= 50 ? 20 : 15, Fade(BACK, faint), Anchor.MiddleCenter, Font.Bold);
        return pill.clicked;
    }
    Draw2D.Shape(Shape { center = center, size = size, radius = radius,
                         color = Fade(over ? Color(0.225, 0.23, 0.25) : RAISED, 0.97 * faint),
                         outline = pill.focused ? 2.2 : 1.5,
                         outlineColor = pill.focused ? Color.white : Fade(over ? tint : LINE, faint) });
    Draw2D.Text(label, center, 14, Fade(tint, faint), Anchor.MiddleCenter, Font.Bold);
    return pill.clicked;
}

// Who's in the match, for the room's page: the lobby's views run with no
// match too, so they don't read it themselves.
[Stage(Layers.Camera, 10)]
view Roster(Towers towers, Session session, mut Lobby lobby)
{
    lobby.manned = 0;
    lobby.mine = -1;
    lobby.players = 0;
    foreach (var entry in towers.seats)
    {
        lobby.manned |= 1 << entry.value;
        lobby.players += 1;
        if (entry.key == session.player) lobby.mine = entry.value;
    }
    lobby.bots = towers.bots;
}

// A seat's row on the room's page: its color, and who has it.
void SeatRow(Lobby lobby, int seat, float2 at, float wide)
{
    var manned = (lobby.manned >> seat & 1) == 1;
    var mine = seat == lobby.mine;
    var color = manned || lobby.bots ? SeatColor(seat) : Shade(SeatColor(seat), 0.45);
    Draw2D.Shape(Shape { center = at + float2(wide * 0.5, 0), size = float2(wide, 28), radius = 8,
                         color = mine ? Color(0.21, 0.215, 0.235) : Color(0.14, 0.143, 0.157),
                         outline = mine ? 1.5 : 0.0, outlineColor = Fade(Color.white, 0.7) });
    Draw2D.Circle(at + float2(15, 0), 6, color);
    Draw2D.Text(SeatName(seat), at + float2(29, 0), 12, color, Anchor.MiddleLeft, Font.Bold);
    Draw2D.Text(mine ? "YOU" : manned ? "PLAYER" : lobby.bots ? "BOT" : "EMPTY", at + float2(wide - 10, 0), 11,
                mine ? Color.white : Fade(QUIET, manned ? 1 : 0.7), Anchor.MiddleRight, mine ? Font.Bold : Font.Regular);
}

// The lobby's pages, over whatever the match's views drew. It runs with no
// match too, as while one is being joined.
[Stage(Layers.Menu)]
view Pages(Session session, Devices devices, Fx fx, mut Lobby lobby, mut Hand hand)
{
    if (!lobby.started)
    {
        // A machine told to host or to join is on its way into that match:
        // no lobby. Any other opens on the title.
        lobby.started = true;
        lobby.joining = !session.server && session.state == SessionState.Connecting;
        lobby.page = lobby.joining ? Page.Join : session.server && session.open ? Page.None : Page.Title;
    }
    // The player's hands are on their brick with no page up, and once the
    // pointer that pressed the page's last button is let go. A key that
    // clicked it is the GUI's until it's let go, so it's never read here.
    hand.playing = lobby.page == Page.None && session.state == SessionState.Connected
        && (hand.playing || !devices.pointer.press.pressed);
    lobby.copied += fx.dt;
    lobby.turn = Math.Frac(lobby.turn + fx.dt * 0.8);
    if (lobby.page == Page.None || WATCH != 0)
    {
        lobby.shown = 0;
        return;
    }

    Draw2D.SetScreen();
    var screen = float2(Screen.width, Screen.height);
    var middle = screen * 0.5;
    // The whole screen is the page's: a click between two buttons doesn't
    // turn a brick. And it's a menu, though a match goes on behind it: the arrows and
    // a gamepad move between its buttons.
    GUI.ClaimPointer(Rect(0, 0, screen.x, screen.y));
    GUI.Navigate();
    lobby.shown = Math.Min(1, lobby.shown + fx.dt * 7);
    var short = screen.y < 470;
    var wide = Math.Min(screen.x - 32, 340);
    var left = middle.x - wide * 0.5;
    var gap = short ? 8.0 : 12.0;
    var connected = session.state == SessionState.Connected;

    // The match goes on behind the page, dimmed, and darker where the page's words are
    Draw2D.Rect(middle, screen, Fade(BACK, 0.62 * lobby.shown));
    Draw2D.Shape(Shape { center = middle, size = float2(wide - 60, Math.Min(screen.y, 420) - 160), radius = 40,
                         color = Fade(Color(0.04, 0.04, 0.045), 0.85 * lobby.shown), soft = 110 });

    Draw.Tint(Fade(Color.white, lobby.shown))
    {
        if (lobby.page == Page.Title)
        {
            var title = short ? 50.0 : 68.0;
            var main = short ? 52.0 : 60.0;
            var row = short ? 44.0 : 48.0;
            var total = 30 + title + (short ? 24 : 36) + main + gap + row + gap + row + 30;
            mut var y = Math.Max(8, (screen.y - total) * 0.45);

            // Four bricks, a color for each seat, and the name
            for (var seat = 0; seat < SEATS; seat++)
            {
                var color = SeatColor(seat);
                var at = float2(middle.x + (seat - 1.5) * 26, y + 12 + Math.Sin(fx.beat + seat * 1.3) * 2);
                Draw2D.Shape(Shape { center = at, size = float2(20), rotation = (seat - 1.5) * 0.14, radius = 4,
                                     color = Mix(color, Color.white, 0.12), color2 = Shade(color, 0.7), outline = 1.5,
                                     outlineColor = Shade(color, 0.45) });
            }
            y += 30;
            Draw2D.Text("TOWERS", float2(middle.x, y + title * 0.5 + 3), title, Color(0.03, 0.03, 0.035), Anchor.MiddleCenter, Font.Bold);
            Draw2D.Text("TOWERS", float2(middle.x, y + title * 0.5), title, Color.white, Anchor.MiddleCenter, Font.Bold);
            y += title;
            Draw2D.Text("Stack the bricks. Be first over the line.", float2(middle.x, y + (short ? 8 : 12)), 13, QUIET, Anchor.MiddleCenter);
            y += short ? 24 : 36;

            var play = Pill(Rect(left, y, wide, main), "PLAY", AMBER, true, connected);
            y += main + gap;
            var host = Pill(Rect(left, y, wide, row), "HOST A ROOM", INK, false, connected);
            y += row + gap;
            var join = Pill(Rect(left, y, wide, row), "JOIN A ROOM", INK, false, true);
            y += row;
            if (lobby.message != "") Draw2D.Text(lobby.message, float2(middle.x, y + 18), 13, ROSE, Anchor.MiddleCenter);
            else Draw2D.Text("Up to four players, in a room.", float2(middle.x, y + 18), 12, Fade(QUIET, 0.8), Anchor.MiddleCenter);

            if (play)
            {
                // A game of its own, from its start: the bots had every tower meanwhile
                if (lobby.players <= 1) Send(Rebuild { });
                lobby.page = Page.None;
                lobby.message = "";
            }
            if (host)
            {
                Session.Open();
                lobby.page = Page.Room;
                lobby.resume = false;
                lobby.message = "";
            }
            if (join)
            {
                lobby.page = Page.Join;
                lobby.message = "";
            }
        }
        else if (lobby.page == Page.Join)
        {
            var busy = lobby.joining && session.state == SessionState.Connecting;
            var row = 50.0;
            var total = 34 + 26 + row + 34 + 48;
            mut var y = Math.Max(8, (screen.y - total) * 0.42);
            Draw2D.Text(busy ? "JOINING" : "JOIN A ROOM", float2(middle.x, y + 14), 26, Color.white, Anchor.MiddleCenter, Font.Bold);
            y += 34;
            if (busy)
            {
                var room = session.room != "" ? session.room : lobby.code.Trim().Substring(0, 12);
                Draw2D.Text(room == "" ? "Waiting for the match" : $"Room {room}", float2(middle.x, y + 8), 14, QUIET, Anchor.MiddleCenter);
                y += 26;
                Draw2D.Arc(float2(middle.x, y + row * 0.5), 16, lobby.turn * Math.TAU, Math.TAU * 0.7, 4, AMBER);
                y += row + 34;
                if (Pill(Rect(middle.x - 90, y, 180, 48), "CANCEL", INK, false, true))
                {
                    // Back to a match of this machine's own
                    lobby.joining = false;
                    Session.Start(Main);
                }
            }
            else
            {
                Draw2D.Text("Type the code of your friend's room.", float2(middle.x, y + 8), 13, QUIET, Anchor.MiddleCenter);
                y += 26;
                // The code is typed into a field of the GUI's, in the page's colors: its frame is drawn here, under it
                var frame = Rect(left, y, wide - 108, row);
                Draw2D.Shape(Shape { center = Middle(frame), size = float2(frame.width, frame.height), radius = 12,
                                     color = Color(0.06, 0.06, 0.066), outline = 1.5, outlineColor = LINE });
                // ...and says when Enter ended the typing, which joins as the button does
                mut var entered = false;
                GUI.Theme(GUITheme { text = INK, field = Color(0.06, 0.06, 0.066), fieldHot = Color(0.08, 0.08, 0.09), accent = AMBER,
                                     radius = 9 })
                {
                    GUI.TextField(Rect(frame.x + 4, frame.y + 4, frame.width - 8, frame.height - 8), "", lobby.code, out entered);
                }
                // A room's code is capitals, however it's typed
                lobby.code = lobby.code.ToUpper();
                var code = lobby.code.Trim();
                var go = Pill(Rect(left + wide - 100, y, 100, row), "JOIN", AMBER, true, code != "") || (entered && code != "");
                y += row;
                if (lobby.message != "") Draw2D.Text(lobby.message, float2(middle.x, y + 17), 13, ROSE, Anchor.MiddleCenter);
                else Draw2D.Text("Six letters and digits, like K7QF2M.", float2(middle.x, y + 17), 12, Fade(QUIET, 0.8), Anchor.MiddleCenter);
                y += 34;
                var back = Pill(Rect(middle.x - 90, y, 180, 48), "BACK", INK, false, true);
                if (go)
                {
                    lobby.message = "";
                    lobby.joining = true;
                    Session.Join(code);
                }
                if (back)
                {
                    lobby.page = Page.Title;
                    lobby.message = "";
                }
            }
        }
        else
        {
            // The room: its code to pass on, who's in it, and the ways on
            var alone = session.server && !session.open;
            var main = short ? 50.0 : 56.0;
            var total = 72 + 64 + gap + main + gap + 44 + gap + 44;
            mut var y = Math.Max(8, (screen.y - total) * 0.42);
            mut var invite = false;
            mut var copy = false;
            if (alone)
            {
                Draw2D.Text("PLAYING ALONE", float2(left + 2, y + 8), 11, QUIET, Anchor.MiddleLeft, Font.Bold);
                invite = Pill(Rect(left, y + 20, wide, 44), "INVITE FRIENDS", AMBER, false, connected);
            }
            else
            {
                Draw2D.Text(session.server ? "YOUR ROOM" : "ROOM", float2(left + 2, y + 8), 11, QUIET, Anchor.MiddleLeft, Font.Bold);
                Draw2D.Shape(Shape { center = float2(middle.x, y + 42), size = float2(wide, 46), radius = 12, color = Color(0.06, 0.06, 0.066),
                                     outline = 1.5, outlineColor = Fade(AMBER, 0.7) });
                if (session.room != "")
                {
                    Draw2D.Text(session.room, float2(left + 16, y + 42), 30, Color.white, Anchor.MiddleLeft, Font.Bold);
                    copy = Pill(Rect(left + wide - 91, y + 20, 90, 44), lobby.copied < 1.5 ? "COPIED" : "COPY", AMBER, false, true);
                }
                else
                {
                    Draw2D.Arc(float2(left + 26, y + 42), 9, lobby.turn * Math.TAU, Math.TAU * 0.7, 3, AMBER);
                    Draw2D.Text("Opening a room...", float2(left + 46, y + 42), 14, QUIET, Anchor.MiddleLeft);
                }
            }
            y += 72;
            // Two seats a row
            var cell = (wide - 8) * 0.5;
            for (var seat = 0; seat < SEATS; seat++)
                SeatRow(lobby, seat, float2(left + (seat % 2) * (cell + 8), y + 14 + (seat / 2) * 34), cell);
            y += 64 + gap;

            var play = Pill(Rect(left, y, wide, main), lobby.resume ? "RESUME" : "PLAY", AMBER, true, connected);
            y += main + gap;
            var fresh = Pill(Rect(left, y, cell, 44), "NEW GAME", INK, false, connected);
            var bots = Pill(Rect(left + cell + 8, y, cell, 44), lobby.bots ? "BOTS: ON" : "BOTS: OFF", INK, false, connected);
            y += 44 + gap;
            var leave = Pill(Rect(left, y, wide, 44), alone ? "BACK TO THE TITLE" : "LEAVE THE ROOM", ROSE, false, true);

            if (invite) Session.Open();
            if (copy)
            {
                Clipboard.Copy(session.room);
                lobby.copied = 0;
            }
            if (play || devices.keyboard.escape.down) lobby.page = Page.None;
            if (fresh)
            {
                Send(Rebuild { });
                lobby.page = Page.None;
            }
            if (bots) Send(Bots { });
            if (leave)
            {
                // Out of the room, and into a match of this machine's own. The
                // room's match goes on without it: another player's machine
                // takes it over (the hostMigration setting).
                if (!alone) Session.Start(Main);
                lobby.page = Page.Title;
                lobby.message = "";
            }
        }
    }
}

// In a room that was joined: the lobby is done.
local event(Connected) Arrived(mut Lobby lobby)
{
    if (!lobby.joining) return;
    lobby.joining = false;
    lobby.page = Page.None;
}

// A match this machine was in ended, or one it asked for couldn't be joined:
// back to the lobby, on a match of its own, with a line that says why.
local event(Disconnected gone) BackToLobby(mut Lobby lobby)
{
    if (gone.reason == DisconnectReason.Left) return;
    lobby.message = gone.reason == DisconnectReason.Failed ? (lobby.joining ? "No room has that code." : "Couldn't reach the room.")
                  : gone.reason == DisconnectReason.Refused ? "That room is full, or closed."
                  : gone.reason == DisconnectReason.TimedOut ? (lobby.joining ? "That room didn't answer." : "Lost the connection to the room.")
                  : gone.reason == DisconnectReason.Kicked ? (gone.message != "" ? gone.message : "The host sent you out of the room.")
                  : "The match ended.";
    lobby.started = true;
    lobby.page = lobby.joining ? Page.Join : Page.Title;
    lobby.joining = false;
    Session.Start(Main);
}
