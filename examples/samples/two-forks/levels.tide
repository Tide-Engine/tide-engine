// The levels. A plan is a character a tile, rows from the north:
//
//   ~  water            .  grass
//   #  a coal grill     =  a gas grill     o  a pedal     ^  a rock
//   i  ice              +  embers: hot while both chefs stand on pedals
//   n e s w             the first chef, by the way they face (the fork is on the next tile that way)
//   N E S W             the second chef
//   --                  a sausage lying west to east
//   |  over  |          a sausage lying north to south
//
// Each is checked by the game's test (test/two_forks_test.c), with the game's
// own rules: two chefs can cook it, and neither can alone, whatever they do.
// The first three were laid out by hand, each to show one thing. The others
// were found: tools/mine.mjs makes up small boards by the thousand, keeps the
// ones that take both chefs, and takes away every tile they can do without,
// and these are the ones picked from what it kept.
// The first added three share walking ground: the chefs clear each other's body
// and fork, change places, and take turns at the same grill.
// Later kitchens develop the coast's handoffs, the fields' gas valves, the
// mountains' ice and partner stoppers, and the crater's shared bellows.

const int LEVELS = 24;

string Plan(int level)
{
    switch (level)
    {
        case 0:
            return "~~~~~##~/"
                 + "~~~~~##~/"
                 + "e.--~.../"
                 + "~~~~~.../"
                 + "~~~~~N..";
        case 1:
            return "~~~~S/"
                 + "~~~~./"
                 + "e.|#./"
                 + "..|#./"
                 + "~~~~#/"
                 + "~~~~.";
        case 2:
            return "~~~~==/"
                 + "e.--==/"
                 + "~~~~oW/"
                 + "~~~~~.";
        case 3:
            return "|n/"
                 + "|E/"
                 + "##";
        case 4:
            return ".N~=/"
                 + "--==/"
                 + "~~on";
        case 5:
            return "n^~~~/"
                 + "--~.#/"
                 + "~#N.~";
        case 6:
            return "e~~~/"
                 + ".--~/"
                 + "~#~~/"
                 + "~#--/"
                 + "~##W/"
                 + "~~#~";
        case 7:
            return "~~.~~/"
                 + "#.w|~/"
                 + "N#.|#";
        case 8:
            return "E#n~~/"
                 + "...~#/"
                 + "--~~~";
        case 9:
            return "~.e#/"
                 + "--S#";
        case 10:
            return "###~/"
                 + "||e~/"
                 + "||.W";
        case 11:
            return "~~E/"
                 + "#n./"
                 + "#--";
        case 12:
            return "~#--/"
                 + "#W../"
                 + "~~n~";
        case 13:
            return "n.--/"
                 + "--##/"
                 + "E~.#/"
                 + "~~~#";
        case 14:
            return "o.=s/"
                 + "#--./"
                 + "~~S~";
        case 15:
            return "~~#--/"
                 + "~^==./"
                 + "=Wo.n";
        case 16:
            return "o.S~#/"
                 + "|=~=#/"
                 + "|n~~~";
        case 17:
            return "|.e~/"
                 + "|~~~/"
                 + "##iN/"
                 + "##i~";
        case 18:
            return "~~W.~/"
                 + "~##--/"
                 + "#~ii~/"
                 + "~~e~~";
        case 19:
            return "~#i~~/"
                 + "iiie#/"
                 + "--~S~";
        case 20:
            return "e.|++~/"
                 + "~o|++~/"
                 + "~~~~oW";
        case 21:
            return "~wo+/"
                 + "--+~/"
                 + "Soo~";
        case 22:
            return "~S++/"
                 + "|oon/"
                 + "|o~~";
        case 23:
            return "~~^~/"
                 + "~~o~/"
                 + "o--+/"
                 + "sS~+";
    }
    return "";
}

string Name(int level)
{
    switch (level)
    {
        case 0: return "Pass it over";
        case 1: return "Over the coals";
        case 2: return "Hold the gas";
        case 3: return "Too many cooks";
        case 4: return "One burner";
        case 5: return "Neighbours";
        case 6: return "Two for dinner";
        case 7: return "The narrows";
        case 8: return "Passing place";
        case 9: return "Fork etiquette";
        case 10: return "Shared table";
        case 11: return "The landing";
        case 12: return "Around the pier";
        case 13: return "Double delivery";
        case 14: return "Cold storage";
        case 15: return "Valve courtyard";
        case 16: return "Trading shifts";
        case 17: return "First frost";
        case 18: return "The chute";
        case 19: return "Human brake";
        case 20: return "Two bellows";
        case 21: return "Hot corners";
        case 22: return "Pressure dance";
        case 23: return "Chimney work";
    }
    return "";
}

// What a level is there to show, said while it's new.
string Hint(int level)
{
    switch (level)
    {
        case 0: return "Push it along its length and it slides: over the water it goes. Across it, it rolls.";
        case 1: return "Whatever lands on a grill is cooked on the side that's down. Twice burns it!";
        case 2: return "A chef on the pedal cuts the gas. Step off, and what's lying on it is cooked.";
        case 3: return "A turn sweeps the fork round: it pushes at the corner, and again beside you.";
        case 4: return "One burner can do a whole side, a half at a time.";
        case 8: return "Share the walking space. Let your partner through before you take their place.";
        case 9: return "Your fork needs room to turn. Park it out of your partner's way.";
        case 10: return "Two sausages share one grill. Make room for the next cook.";
        case 11: return "Clear the landing for your partner, then trade places.";
        case 12: return "The two halves reach the coals at different times. Find a way around.";
        case 13: return "Two deliveries share a kitchen. Leave your partner room to work.";
        case 14: return "Park on the valve to keep the gas cold. Light it only when dinner is ready.";
        case 15: return "Each half needs a turn at the burner. Keep the valve and the corners clear.";
        case 16: return "Trade the valve and the fork. Neither cook can do every job at once.";
        case 17: return "With both halves on ice, a sausage glides until a non-ice tile or something stops it.";
        case 18: return "A glide still rolls the sausage on every tile it crosses. Plan which side lands.";
        case 19: return "Your partner's body or fork can stop a sliding sausage. Put the brake in place.";
        case 20: return "Embers heat only while BOTH cooks stand on pedals. Stepping on lights what's already there.";
        case 21: return "Heat both halves one at a time. Step off a pedal before moving a cooked side.";
        case 22: return "Share the pedals and the walking space. Keep the heat off while you change places.";
        case 23: return "The upper pedal is a job of its own. Take turns delivering and firing the grill.";
    }
    return "";
}
