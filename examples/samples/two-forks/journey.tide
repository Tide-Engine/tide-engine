// The shared journey. A camp is a kitchen; bridges need any two kitchens
// in their region and both chefs on the brass plates. Third kitchens earn
// optional travel routes. Neither travel nor testing skips count as cooking.

int Region(int level)
{
    if (level < 3) return 0;
    if (level == 3 || level == 4 || level == 8) return 1;
    if (level == 5 || level == 6 || level == 9) return 2;
    return 3;
}

string RegionName(int region)
{
    switch (region)
    {
        case 0: return "Saltwater Coast";
        case 1: return "Golden Fields";
        case 2: return "Highland Pass";
    }
    return "Ember Crater";
}

int TravelRegion(int2 tile)
{
    return tile.y < 4 ? (tile.x < 6 ? 1 : 2) : (tile.x < 6 ? 0 : 3);
}

int RegionSolved(int done, int region)
{
    mut var count = 0;
    for (var i = 0; i < LEVELS; i++)
    {
        if (Region(i) == region && (done & (1 << i)) != 0) count += 1;
    }
    return count;
}

int2 RouteCamp(int level)
{
    switch (level)
    {
        case 0: return int2(1, 8);
        case 1: return int2(3, 6);
        case 2: return int2(5, 8);
        case 3: return int2(1, 1);
        case 4: return int2(3, 2);
        case 5: return int2(7, 1);
        case 6: return int2(9, 2);
        case 7: return int2(8, 7);
        case 8: return int2(5, 1);
        case 9: return int2(11, 1);
    }
    return int2(11, 7);
}

bool RouteOpen(int done, int level)
{
    if (level < 0 || level >= LEVELS) return false;
    var region = Region(level);
    if (region == 0) return true;
    if (region == 1) return RegionSolved(done, 0) >= 2;
    if (region == 2) return RegionSolved(done, 1) >= 2 || RegionSolved(done, 0) == 3;
    return RegionSolved(done, 2) >= 2 || RegionSolved(done, 1) == 3;
}

int StepsApart(int2 a, int2 b)
{
    return Math.Abs(a.x - b.x) + Math.Abs(a.y - b.y);
}

bool TogetherAt(Board board, int2 at)
{
    var first = StepsApart(board.chefs[0].at, at);
    var second = StepsApart(board.chefs[1].at, at);
    return first <= 2 && second <= 2 && Math.Min(first, second) <= 1;
}

int CampAt(Board board, int who)
{
    for (var i = 0; i < LEVELS; i++)
    {
        if (Same(board.chefs[who].at, RouteCamp(i))) return i;
    }
    return -1;
}

bool CanEnter(Kitchen kitchen, int level)
{
    return kitchen.travelling && RouteOpen(kitchen.done, level) && TogetherAt(kitchen.board, RouteCamp(level));
}

int NearbyCamp(Kitchen kitchen)
{
    mut var chosen = -1;
    mut var nearest = 100;
    for (var i = 0; i < LEVELS; i++)
    {
        if (!CanEnter(kitchen, i)) continue;
        var distance = StepsApart(kitchen.board.chefs[0].at, RouteCamp(i)) + StepsApart(kitchen.board.chefs[1].at, RouteCamp(i));
        if (distance >= nearest) continue;
        nearest = distance;
        chosen = i;
    }
    return chosen;
}

int GateRegion(int gate) { return gate; }

int2 GatePlate(int gate, int which)
{
    if (gate == 0) return int2(which == 0 ? 1 : 5, 5);
    if (gate == 1) return int2(which == 0 ? 1 : 5, 0);
    return int2(which == 0 ? 7 : 11, 3);
}

int2 GateBridge(int gate)
{
    if (gate == 0) return int2(3, 4);
    if (gate == 1) return int2(6, 2);
    return int2(9, 4);
}

int2 TravelDock(int route)
{
    return route == 0 ? int2(5, 6) : int2(5, 2);
}

int2 TravelReturnDock(int route)
{
    return route == 0 ? int2(7, 2) : int2(8, 5);
}

string TravelName(int route)
{
    return route == 0 ? "Coastal ferry" : "Cliffside rope";
}

bool TravelUnlocked(int done, int route)
{
    return route >= 0 && route < 2 && RegionSolved(done, route) == 3;
}

int NearbyTravel(Kitchen kitchen)
{
    if (!kitchen.travelling) return -1;
    for (var route = 0; route < 2; route++)
    {
        if (TravelUnlocked(kitchen.done, route) && (TogetherAt(kitchen.board, TravelDock(route)) || TogetherAt(kitchen.board, TravelReturnDock(route)))) return route;
    }
    return -1;
}

void LayRoute(mut Kitchen kitchen)
{
    kitchen.board = Board { size = int2(W, H), chefs = kitchen.campers };
    for (var y = 0; y < H; y++)
    {
        for (var x = 0; x < W; x++)
        {
            if (x == 6 || y == 4) continue;
            kitchen.board.tiles[y * W + x] = Tile.Grass;
        }
    }
    // Trim a few outside corners; the paths inside each region have room
    // to sidestep a partner and park the two forks.
    int2[8] rocks = [int2(0, 0), int2(0, 3), int2(0, 8), int2(5, 3),
                     int2(7, 0), int2(11, 0), int2(7, 8), int2(11, 8)];
    foreach (var at in rocks) kitchen.board.tiles[at.y * W + at.x] = Tile.Rock;
    for (var gate = 0; gate < 3; gate++)
    {
        for (var which = 0; which < 2; which++)
        {
            var at = GatePlate(gate, which);
            kitchen.board.tiles[at.y * W + at.x] = Tile.Pedal;
        }
        var bridge = GateBridge(gate);
        kitchen.board.tiles[bridge.y * W + bridge.x] = (kitchen.bridges & (1 << gate)) != 0 ? Tile.Grass : Tile.Rock;
    }
    kitchen.layout += 1;
}

void ReturnToMap(mut Kitchen kitchen)
{
    if (!kitchen.journeyStarted)
    {
        kitchen.campers[0] = Chef { at = int2(1, 7), facing = EAST, spin = EAST };
        kitchen.campers[1] = Chef { at = int2(4, 7), facing = WEST, spin = WEST };
        kitchen.journeyStarted = true;
    }
    kitchen.travelling = true;
    LayRoute(kitchen);
    kitchen.laid = true;
    kitchen.moves = 0;
    kitchen.cleared = 0;
    kitchen.past.Clear();
    kitchen.grips[0] = Grip { };
    kitchen.grips[1] = Grip { };
}

bool OpenBridges(mut Kitchen kitchen)
{
    mut var changed = false;
    for (var gate = 0; gate < 3; gate++)
    {
        if ((kitchen.bridges & (1 << gate)) != 0 || RegionSolved(kitchen.done, GateRegion(gate)) < 2) continue;
        var first = GatePlate(gate, 0);
        var second = GatePlate(gate, 1);
        var a = kitchen.board.chefs[0].at;
        var b = kitchen.board.chefs[1].at;
        if (!(Same(a, first) && Same(b, second) || Same(a, second) && Same(b, first))) continue;
        kitchen.bridges |= 1 << gate;
        changed = true;
    }
    if (changed) LayRoute(kitchen);
    return changed;
}

command(EnterKitchen enter, PlayerID sender) EnterCamp(mut Kitchen kitchen)
{
    if (!kitchen.hands.Has(sender) || !CanEnter(kitchen, enter.level)) return;
    kitchen.campers = kitchen.board.chefs;
    Open(kitchen, enter.level);
    Send(Laid { });
}

command(BackToMap back, PlayerID sender) LeaveCamp(mut Kitchen kitchen)
{
    if (!kitchen.hands.Has(sender) || kitchen.travelling || back.level != kitchen.level) return;
    ReturnToMap(kitchen);
    Send(Laid { });
}

command(Traverse travel, PlayerID sender) TakeRoute(mut Kitchen kitchen)
{
    if (!kitchen.hands.Has(sender) || NearbyTravel(kitchen) != travel.route || travel.route < 0 || travel.route > 1) return;
    var ferry = travel.route == 0;
    var returning = TogetherAt(kitchen.board, TravelReturnDock(travel.route));
    if (returning)
    {
        kitchen.campers[0] = Chef { at = ferry ? int2(5, 6) : int2(5, 2), facing = NORTH, spin = NORTH };
        kitchen.campers[1] = Chef { at = ferry ? int2(4, 7) : int2(4, 3), facing = WEST, spin = WEST };
    }
    else
    {
        kitchen.campers[0] = Chef { at = ferry ? int2(7, 2) : int2(8, 5), facing = NORTH, spin = NORTH };
        kitchen.campers[1] = Chef { at = ferry ? int2(9, 3) : int2(10, 5), facing = NORTH, spin = NORTH };
    }
    ReturnToMap(kitchen);
    Send(Laid { });
}
