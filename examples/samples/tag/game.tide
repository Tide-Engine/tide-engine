using Rooms;

settings { title = "Tag"; maxPlayers = 8; hostMigration = true; }

// ---------------------------------------------------------------- the rules

const float YARD = 6;            // Half the yard's side, in world units
const float BODY = 0.5;          // A kid's radius
const float ACCEL = 27;          // How hard a kid pushes off the grass
const float DRAG = 5;            // ...and how fast the grass slows them
const float IT_BOOST = 1.12;     // Whoever's it runs this much harder
const float DASH = 7;            // The speed a dash adds, all at once
const float COOLDOWN = 1.4;      // Seconds between dashes
const float COUNT = 0.8;         // Seconds whoever was just caught stands and counts
const float NO_BACK = 1.8;       // Seconds whoever caught them can't be caught back
const float TOO_LONG = 15;       // Seconds as it before it moves on by itself: a kid who's away holds nobody up
const float SAFE_TIME = 2;       // Seconds nobody can catch a kid who just walked in
const float REACH = 0.06;        // How near a touch counts, past the two bodies
const int ROUND = 60;            // Seconds until the bell
const int CHEER = 5;             // Seconds the bell's result shows
const int MIN_KIDS = 4;          // Bots fill the yard up to this many
const int COLORS = 8;
const float SPIN = 1.2;          // The roundabout's turn, in radians a second
const float SPIN_RADIUS = 1.4;
const float SAND_RADIUS = 1.55;
const float PUDDLE_RADIUS = 1.45;
const float TREE_RADIUS = 0.7;

// The yard's things. The roundabout is in the middle, and the oak and the
// boulder are in nobody's way but whoever runs into them.
float2 Sand() { return float2(-3.3, -3.3); }
float2 Puddle() { return float2(3.3, 3.3); }
float2 Oak() { return float2(-3.7, 3.6); }
float2 Rock() { return float2(3.7, -3.6); }

scene Main { }

// ------------------------------------------------------------ the match

component Kid
{
    [Position] float2 position;
    float2 velocity;
    float2 facing = float2(0, -1);
    int color;
    float itTime;     // Seconds as it, this round: the least wins
    int wins;
    int round;        // The round that time is of
    bool bot;
    float cooldown;   // Seconds until the next dash
    float burst;      // Seconds this dash still shows for
    float wish;       // A dash asked for a moment early waits this long
    float safe;       // Seconds nobody can catch them for, as they walk in
}

// What a kid is trying to do this tick: a player's input, or a bot's mind.
component Drive
{
    float2 move;
    bool dash;
}

// How far the others are in a kid's way this tick, worked out before anyone is moved.
component Nudge
{
    float2 slide;
}

component Brain
{
    Random random;
    float2 heading;
    float think;      // Seconds until it looks again
    float veer = 1;   // Which way round it runs from whoever's it
}

singleton Roster
{
    Map<PlayerID, Entity> bodies;
    List<Entity> bots;
    int taken; // A bit for each color in the yard
}

singleton Recess
{
    Entity it;       // Who's it
    Entity tagger;   // Who caught them: no tag-backs, for a moment
    int since;       // The tick of that catch
    int round;
    int ends;        // The tick the bell rings at
    bool cheering;   // The bell rang: its result shows, and nobody's caught
    int winners;     // A bit for each color that took the round
    int until;       // The tick the next round starts at
    float fair;      // The kids' time as it, on average: what one who walks in late starts with
    Random random;
}

event Tagged { float2 at; int caught; }   // For what's shown
event Dashed { float2 at; float2 way; }   // For what's shown
event Rang { int winners; }               // For what's shown
event Won { }                             // Sent to each kid who took the round

// This machine's pointer, turned into a stick by the views.
local singleton Pad
{
    float2 stick;
    float2 target;
    bool steer;
    bool onButton;
    float dashHold;
}

input Controls
{
    [Clamp(-1, 1)] float2 move;
    bool dash;

    Sample(Devices devices, Pad pad, Lobby lobby)
    {
        if (!lobby.playing) return;
        var keys = devices.keyboard;
        if (keys.d.pressed || keys.rightArrow.pressed) move.x += 1;
        if (keys.a.pressed || keys.leftArrow.pressed) move.x -= 1;
        if (keys.w.pressed || keys.upArrow.pressed) move.y += 1;
        if (keys.s.pressed || keys.downArrow.pressed) move.y -= 1;
        move += devices.gamepad.leftStick + pad.stick;
        dash = keys.space.pressed || keys.leftShift.pressed || keys.enter.pressed
            || devices.gamepad.buttonSouth.pressed || pad.dashHold > 0;
    }
}

int PickColor(mut Roster roster)
{
    for (var i = 0; i < COLORS; i++)
    {
        if ((roster.taken & (1 << i)) == 0)
        {
            roster.taken |= 1 << i;
            return i;
        }
    }
    return 0;
}

// Where a kid walks in: each color has a place of its own around the
// roundabout, so nobody starts on top of anybody.
float2 Start(int color)
{
    var turn = color * Math.TAU * 0.375 + 0.4;
    return float2(Math.Cos(turn), Math.Sin(turn)) * 2.7;
}

event(PlayerJoined joined) Enter(mut Roster roster, Recess recess)
{
    var color = PickColor(roster);
    var spot = Start(color);
    roster.bodies[joined.player] = Spawn(
        Kid { position = spot, facing = Math.Normalize(spot), color = color, safe = SAFE_TIME,
              itTime = recess.fair, round = recess.round },
        Drive, Nudge,
        Owner { player = joined.player });
}

event(PlayerLeft left) Leave(mut Roster roster)
{
    roster.bodies[left.player].Destroy();
    roster.bodies.Remove(left.player);
}

event(Destroyed) FreeColor(Kid kid, mut Roster roster)
{
    roster.taken &= ~(1 << kid.color);
}

// Nobody plays tag alone: bots stand in until there are players enough.
system Balance(mut Roster roster, Recess recess)
{
    var wanted = Math.Max(0, MIN_KIDS - roster.bodies.count);
    if (roster.bots.count < wanted)
    {
        var color = PickColor(roster);
        var spot = Start(color);
        var bot = Spawn(
            Kid { position = spot, facing = Math.Normalize(spot), color = color, bot = true, safe = SAFE_TIME,
                  itTime = recess.fair, round = recess.round },
            Drive, Nudge, Brain);
        roster.bots.Add(bot);
    }
    else if (roster.bots.count > wanted)
    {
        var last = roster.bots.count - 1;
        roster.bots[last].Destroy();
        roster.bots.RemoveAt(last);
    }
}

// The round's clock. At the bell, whoever was it the least takes the round,
// and everyone level with them does too.
system Bell(mut Recess recess, Time time, query (Kid kid) all)
{
    if (recess.ends == 0) recess.ends = time.tick + time.tickRate * ROUND;
    if (recess.cheering)
    {
        if (time.tick < recess.until) return;
        recess.cheering = false;
        recess.winners = 0;
        recess.round += 1; // Every kid sees it in Count, and starts over
        recess.ends = time.tick + time.tickRate * ROUND;
        recess.it = default; // Someone else starts as it: Chase picks
        recess.tagger = default;
        return;
    }
    if (time.tick < recess.ends) return;

    mut var least = -1.0;
    foreach (var row in all)
    {
        if (least < 0 || row.kid.itTime < least) least = row.kid.itTime;
    }
    if (least < 0)
    {
        recess.ends = time.tick + time.tickRate * ROUND; // An empty yard rings for nobody
        return;
    }
    mut var winners = 0;
    foreach (var row in all)
    {
        if (row.kid.itTime > least + 0.05) continue;
        winners |= 1 << row.kid.color;
        row.entity.Send(Won { });
    }
    recess.cheering = true;
    recess.winners = winners;
    recess.until = time.tick + time.tickRate * CHEER;
    Send(Rang { winners = winners });
}

event(Won) Cheer(mut Kid kid)
{
    kid.wins += 1;
}

system Steer(Controls input, mut Drive drive, with Owner)
{
    drive.move = input.move;
    drive.dash = input.dash.down;
}

// Away from the fence, the harder the nearer: a kid that only backs off ends
// up in a corner.
float2 OffTheFence(float2 at)
{
    var margin = 1.7;
    mut var way = float2(0);
    var x = Math.Abs(at.x) - (YARD - margin);
    var y = Math.Abs(at.y) - (YARD - margin);
    if (x > 0) way.x = (at.x > 0 ? -1.0 : 1.0) * (x / margin) * 1.8;
    if (y > 0) way.y = (at.y > 0 ? -1.0 : 1.0) * (y / margin) * 1.8;
    return way;
}

// A bot that's it goes for whoever's nearest, a little ahead of them. One that
// isn't runs from whoever is, and round them rather than straight back. It
// looks a few times a second, and not too carefully.
system Think(Kid me, mut Drive drive, mut Brain brain, Recess recess, Time time, query (Kid body) others)
{
    drive.dash = false;
    var amIt = this == recess.it;
    var noBack = (time.tick - recess.since) * time.dt < NO_BACK;
    mut var seen = false;
    mut var itAt = float2(0);
    mut var any = false;
    mut var prey = float2(0);
    mut var near = 1000.0;
    foreach (var other in others)
    {
        if (other.entity == this) continue;
        if (other.entity == recess.it)
        {
            seen = true;
            itAt = other.body.position;
        }
        if (!amIt || other.body.safe > 0) continue;
        if (noBack && other.entity == recess.tagger) continue;
        var gap = Math.Distance(other.body.position, me.position);
        if (gap >= near) continue;
        near = gap;
        any = true;
        prey = other.body.position + other.body.velocity * Math.Min(gap * 0.12, 0.4);
    }

    var from = me.position - itAt;
    var far = Math.Length(from);
    var chased = !amIt && seen && far < 5;
    brain.think -= time.dt;
    if (brain.think <= 0)
    {
        brain.think = brain.random.NextFloat(0.1, 0.3);
        if (brain.random.NextInt(14) == 0) brain.veer = -brain.veer;
        mut var way = float2(0);
        mut var pace = 1.0;
        if (amIt)
        {
            way = any ? Math.Normalize(prey - me.position) : Math.Normalize(float2(0) - me.position) * 0.5;
            way += brain.random.NextFloat2Direction() * 0.3;
        }
        else if (chased)
        {
            var away = far > 0.001 ? from / far : float2(1, 0);
            way = away + float2(-away.y, away.x) * (brain.veer * 0.7) + OffTheFence(me.position);
            way += brain.random.NextFloat2Direction() * 0.25;
        }
        else
        {
            // Nobody's after it: a stroll, back towards the middle of the yard
            way = brain.heading + brain.random.NextFloat2Direction() * 0.8 - me.position * 0.06 + OffTheFence(me.position);
            pace = 0.45;
        }
        brain.heading = Math.Normalize(way) * pace;
    }
    drive.move = brain.heading;

    if (me.cooldown > 0) return;
    if (amIt && any && near < 2.4 && Math.Dot(Math.Normalize(prey - me.position), me.facing) > 0.85)
    {
        drive.dash = brain.random.NextInt(10) == 0;
    }
    else if (chased && far < 1.7)
    {
        drive.dash = brain.random.NextInt(14) == 0;
    }
}

// The fence, the oak and the boulder: nobody walks through them.
void KeepOut(mut Kid kid, float2 center, float radius)
{
    var apart = kid.position - center;
    var gap = Math.Length(apart);
    var room = radius + BODY;
    if (gap >= room || gap < 0.0001) return;
    var away = apart / gap;
    kid.position = center + away * room;
    var into = Math.Dot(kid.velocity, away);
    if (into < 0) kid.velocity -= away * into;
}

void KeepIn(mut Kid kid)
{
    KeepOut(kid, Oak(), TREE_RADIUS);
    KeepOut(kid, Rock(), TREE_RADIUS);
    var edge = YARD - BODY;
    if (kid.position.x > edge) { kid.position.x = edge; kid.velocity.x = Math.Min(kid.velocity.x, 0); }
    if (kid.position.x < -edge) { kid.position.x = -edge; kid.velocity.x = Math.Max(kid.velocity.x, 0); }
    if (kid.position.y > edge) { kid.position.y = edge; kid.velocity.y = Math.Min(kid.velocity.y, 0); }
    if (kid.position.y < -edge) { kid.position.y = -edge; kid.velocity.y = Math.Max(kid.velocity.y, 0); }
}

system Move(mut Kid kid, Drive drive, Recess recess, Time time)
{
    var dt = time.dt;
    kid.cooldown = Math.Max(0, kid.cooldown - dt);
    kid.burst = Math.Max(0, kid.burst - dt);
    kid.safe = Math.Max(0, kid.safe - dt);
    kid.wish = drive.dash ? 0.25 : Math.Max(0, kid.wish - dt);

    // Whoever was just caught stands and counts, so the others get away.
    var it = this == recess.it;
    var counting = it && (time.tick - recess.since) * time.dt < COUNT;
    mut var want = counting ? float2(0) : drive.move;
    var push = Math.Length(want);
    if (push > 1) want = want / push;
    if (push > 0.05) kid.facing = Math.Normalize(want);

    // Sand is slow going. The puddle is fast, and there's no turning on it.
    mut var accel = it ? ACCEL * IT_BOOST : ACCEL;
    mut var drag = DRAG;
    if (Math.Distance(kid.position, Sand()) < SAND_RADIUS) accel *= 0.6;
    if (Math.Distance(kid.position, Puddle()) < PUDDLE_RADIUS)
    {
        accel *= 0.3;
        drag *= 0.22;
    }
    kid.velocity += want * (accel * dt);
    if (kid.wish > 0 && kid.cooldown <= 0 && !counting)
    {
        kid.velocity += kid.facing * DASH;
        kid.cooldown = COOLDOWN;
        kid.burst = 0.25;
        kid.wish = 0;
        Send(Dashed { at = kid.position, way = kid.facing });
    }
    kid.velocity = kid.velocity * Math.Max(0, 1 - drag * dt);

    // The roundabout takes whoever's on it round with it.
    if (Math.LengthSq(kid.position) < SPIN_RADIUS * SPIN_RADIUS)
    {
        var c = Math.Cos(SPIN * dt);
        var s = Math.Sin(SPIN * dt);
        kid.position = float2(kid.position.x * c - kid.position.y * s, kid.position.x * s + kid.position.y * c);
    }
    kid.position += kid.velocity * dt;
    KeepIn(kid);
}

// Whoever's it catches the nearest kid they touch, who's it from then on. With
// nobody it (a round just started, or they left), someone is picked, and so is
// someone else when one kid has been it too long.
system Chase(mut Recess recess, Time time, query (Kid kid) all)
{
    mut var count = 0;
    mut var total = 0.0;
    mut var found = false;
    mut var at = float2(0);
    foreach (var row in all)
    {
        count += 1;
        total += row.kid.itTime;
        if (row.entity != recess.it) continue;
        found = true;
        at = row.kid.position;
    }
    recess.fair = count > 0 ? total / count : 0;
    if (count == 0)
    {
        recess.it = default;
        return;
    }
    var waited = (time.tick - recess.since) * time.dt;
    var stuck = found && !recess.cheering && waited >= TOO_LONG && count > 1;
    if (!found || stuck)
    {
        mut var choice = recess.random.NextInt(stuck ? count - 1 : count);
        mut var next = recess.it;
        foreach (var row in all)
        {
            if (stuck && row.entity == recess.it) continue;
            if (choice == 0) next = row.entity;
            choice -= 1;
        }
        recess.tagger = stuck ? recess.it : default;
        recess.it = next;
        recess.since = time.tick;
        return;
    }
    if (recess.cheering || waited < COUNT) return;

    mut var caught = false;
    mut var who = recess.it;
    mut var color = 0;
    mut var where = at;
    mut var near = BODY * 2 + REACH;
    foreach (var row in all)
    {
        if (row.entity == recess.it || row.kid.safe > 0) continue;
        if (waited < NO_BACK && row.entity == recess.tagger) continue;
        var gap = Math.Distance(row.kid.position, at);
        if (gap >= near) continue;
        near = gap;
        caught = true;
        who = row.entity;
        color = row.kid.color;
        where = (row.kid.position + at) * 0.5;
    }
    if (!caught) return;
    recess.tagger = recess.it;
    recess.it = who;
    recess.since = time.tick;
    Send(Tagged { at = where, caught = color });
}

// Every kid looks at every other, as they all are now: each takes its own half
// of the way apart, so nobody's turn comes first.
system Crowd(Kid me, mut Nudge nudge, query (Kid body) others)
{
    nudge.slide = float2(0);
    foreach (var other in others)
    {
        if (other.entity == this) continue;
        var apart = me.position - other.body.position;
        var gap = Math.Length(apart);
        if (gap >= BODY * 2 || gap < 0.0001) continue;
        nudge.slide += apart / gap * ((BODY * 2 - gap) * 0.5);
    }
}

system Settle(mut Kid kid, Nudge nudge)
{
    kid.position += nudge.slide;
    KeepIn(kid);
}

system Count(mut Kid kid, Recess recess, Time time)
{
    if (kid.round != recess.round)
    {
        kid.round = recess.round;
        kid.itTime = 0;
    }
    if (this == recess.it && !recess.cheering) kid.itTime += time.dt;
}

// ------------------------------------------------- what this machine shows
//
// The match is flat: a kid is a place in the yard. What's drawn of it is 3D,
// with the yard's `y` as the world's `z`: an island in the sky, with the yard
// on it and a schoolhouse behind. The engine has no lighting built in, so
// everything is a mesh whose corners have a normal, drawn through a frag that
// lights each pixel from it and paints it: grass, water, wood, brick, stone
// and leaves are all worked out a pixel at a time, from noise. Shadows are a
// shadow map, the frame is drawn with four samples a pixel, and it reaches
// the window through a few passes that add the glow around what's bright and
// blur what's far from the middle, as a photograph of a model would be.

enum Layers { Camera, Gather, Lamp, Scene, Pieces, Marks, Air, Show, Hud }

const float LAMP_SPAN = 31;                  // Meters across what the sun's image sees
const int LAMP_PIXELS = 2048;                // Pixels across it
const float LAMP_AWAY = 40;                  // How far from the yard's middle it looks from,
const float LAMP_FAR = 80;                   // and how far it sees
const float LAMP_SOFT = 1.3 / LAMP_PIXELS;   // How far apart a pixel's four looks at it are: they blend a shadow's edge
const float ON_FLOOR = 0.03;                 // How far over the grass what's flat on it is drawn
const float DECK = 0.16;                     // How high the roundabout's deck is
const float ISLAND = 11.2;                   // The island's radius
const float KID = 1.3;                       // How much bigger than life a kid is drawn
const float GLOW_FROM = 0.8;                 // How bright a pixel is before it glows

// What a solid is made of, which its frag paints it by.
const float PLAIN = 0;
const float WOOD = 1;
const float STONE = 2;
const float LEAF = 3;
const float BRICK = 4;
const float ROOF = 5;
const float GLASS = 6;
const float CLOUD = 7;

asset Clip tagClip = "sfx/tag.wav";
asset Clip dashClip = "sfx/dash.wav";
asset Clip bellClip = "sfx/bell.wav";
asset Clip itClip = "sfx/it.wav";
asset Clip winClip = "sfx/win.wav";
asset Clip splashClip = "sfx/splash.wav";
asset Clip birdsClip = "sfx/birds.wav";

// A corner of a mesh: where it is, and which way its face looks.
struct Corner
{
    float3 position;
    float3 normal;
}

// The meshes, made once: a box, a ball, a roll and a cone to draw wherever
// something is, a flat square for what's painted on the ground, and a blade
// of grass.
local singleton Models
{
    List<Corner> cube;
    List<int> cubeFaces;
    List<Corner> ball;
    List<int> ballFaces;
    List<Corner> roll;
    List<int> rollFaces;
    List<Corner> cone;
    List<int> coneFaces;
    List<Corner> plate;
    List<int> plateFaces;
    List<Corner> blade;
    List<int> bladeFaces;
    bool made;
}

// Something that's drawn: a box, a ball, a roll or a cone, where it is, how
// big, and its paint. One of a list, all drawn at once, and once more into
// the sun's image, for their shadows.
struct Solid
{
    float4x4 transform = float4x4.identity;
    float3 size = float3(1);   // What the transform scales it by, which its frag needs for a squashed ball's normals
    Color tint = Color.white;
    float gloss;               // How much it shines
    float glow;                // How much of its paint is its own light
    float kind;                // What it's made of: PLAIN, WOOD, STONE...
}

// A blade of grass. There are thousands, drawn at once, and the wind bends
// each on the GPU.
struct Blade
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.green;
    float phase;
}

// Something flat on the ground: a ring round a kid, the red under whoever's it.
struct Decal
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.black;
    float ring;       // Only its rim, this much of its radius wide, when it's above 0
    float arc = 1;    // How much of the way round it goes, from 0 to 1
}

// A spark: a small cube that glows.
struct Mote
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
}

struct Spark
{
    float3 position;
    float3 velocity;
    float age;
    float life = 0.4;
    float size = 0.1;
    float weight = 1;
    bool paper;       // A piece of paper: lit, with a shadow, and it tumbles
    Color tone = Color.white;
}

struct Popup
{
    string text;
    float3 position;
    float age;
    Color tone = Color.white;
}

// What never moves, made once: the island, the fence, the trees, the school.
local singleton Scenery
{
    List<Solid> ground;
    List<Solid> boxes;
    List<Solid> balls;
    List<Solid> rolls;
    List<Solid> cones;
    List<Blade> grass;
    bool made;
}

// What moves, made again every frame, and this machine's own effects.
local singleton Fx
{
    List<Solid> boxes;
    List<Solid> balls;
    List<Solid> rolls;
    List<Solid> decks;
    List<Solid> clouds;
    List<Decal> decals;
    List<Mote> motes;
    List<Spark> sparks;
    List<Popup> popups;
    float dt;
    float beat;       // Radians, wrapped, for what pulses
    float time;       // Seconds, wrapped once an hour, for what drifts
    float shake;
    float clock;      // Seconds, wrapped: which hint shows
    int round = -1;   // The round this machine last saw start
    float call;       // Seconds the call to run still shows
    bool wasIt;       // This machine's kid was it, last frame
    bool wasWet;      // ...and in the puddle
    float alarm;      // Seconds "YOU'RE IT!" still shows
    Sound birds;      // The yard's air, which goes on
    Random random;
}

// What the frags read of the camera and the hour.
local singleton Room
{
    float3 eye;
    float beat;
    float time;
}

// What the sun sees: how far, along each pixel of its image.
local singleton Shadow
{
    RenderTarget map;
    DepthTexture depth;
    float4x4 toLamp;
    bool made;
}

// The frame, drawn with four samples a pixel, and what it goes through on its
// way to the window.
local singleton Lens
{
    RenderTarget scene;   // The yard
    RenderTarget half;    // ...at half the size, blurred: what's out of focus
    RenderTarget halfB;
    RenderTarget bright;  // Its bright parts at a quarter of the size, blurred: the glow
    RenderTarget spread;
    Texture soft;
    Texture glow;
    float2 pixel;         // A logical pixel, as a part of the screen
    bool made;
}

// One pass of a blur: which way it goes, and how far.
struct BlurStep
{
    float2 along;
}

local singleton Layout
{
    float middle;  // The yard's middle on the screen, down from its top
    float2 button; // The DASH button, in the screen's pixels
    float reach = 30;
}

local singleton Me
{
    Entity self;
    int color = -1;
}

Color Tone(int index)
{
    switch (index)
    {
        case 0: return Color(0.93, 0.3, 0.28);
        case 1: return Color(0.25, 0.52, 0.95);
        case 2: return Color(0.98, 0.75, 0.14);
        case 3: return Color(0.2, 0.66, 0.33);
        case 4: return Color(0.93, 0.45, 0.75);
        case 5: return Color(0.18, 0.76, 0.76);
        case 6: return Color(0.96, 0.55, 0.2);
        case 7: return Color(0.62, 0.45, 0.9);
    }
    return Color.gray;
}

string ColorName(int index)
{
    switch (index)
    {
        case 0: return "RED";
        case 1: return "BLUE";
        case 2: return "YELLOW";
        case 3: return "GREEN";
        case 4: return "PINK";
        case 5: return "TEAL";
        case 6: return "ORANGE";
        case 7: return "VIOLET";
    }
    return "SOMEONE";
}

// ---------------------------------------------------------------- the light

// Where the sun is, from anywhere: over the camera's left shoulder, so that
// shadows fall away from it and to the right.
float3 Lamp()
{
    return Math.Normalize(float3(-0.55, 0.72, -0.42));
}

// Where a pixel is in the sun's image, a uv from its top left corner, and how
// far from the sun it is there, from 0 to 1: what a frag compares with what
// the sun saw. A pixel looks from a little off its surface, along its normal,
// the more the more the surface slants from the sun: compared as it is, a
// surface is in its own shadow, in stripes. What's outside the image is lit.
float3 FromLamp(float3 world, float3 normal, float4x4 toLamp)
{
    float facing = Math.Dot(normal, Lamp());
    float slant = Math.Sqrt(Math.Saturate(1 - facing * facing));
    float step = LAMP_SPAN / LAMP_PIXELS;
    float4 clip = Math.Mul(toLamp, float4(world + normal * (step * (1.2 + 3.0 * slant)), 1));
    if (Math.Max(Math.Abs(clip.x), Math.Abs(clip.y)) > 1) return float3(0.5, 0.5, 0);
    return float3(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5, clip.z * 0.5 + 0.5);
}

// How much of the sun the clouds overhead let through at a place: they drift.
float CloudShade(float2 at, float time)
{
    float cover = Math.Perlin(at * 0.085 + float2(time * 0.035, time * 0.02));
    return 1 - Math.Saturate((cover - 0.12) * 2.4) * 0.42;
}

// A surface's paint in the yard's light. `sun` is how much of the sun gets to
// it, from 0, in shadow, to 1: its frag asks the sun's image.
Color Lit(Color paint, float3 normal, float3 world, float3 eye, float gloss, float sun)
{
    float3 lamp = Lamp();
    float3 toEye = Math.Normalize(eye - world);
    float direct = Math.Max(Math.Dot(normal, lamp), 0);
    float fill = Math.Max(Math.Dot(normal, Math.Normalize(float3(0.6, 0.3, 0.7))), 0);
    float sky = 0.38 + 0.16 * normal.y;
    float shine = Math.Pow(Math.Max(Math.Dot(normal, Math.Normalize(lamp + toEye)), 0), 30) * gloss * sun;
    float rim = Math.Pow(1 - Math.Max(Math.Dot(normal, toEye), 0), 3) * 0.08;
    float3 base = float3(paint.r, paint.g, paint.b);
    float3 warm = float3(1.0, 0.94, 0.82);    // The sun's own color,
    float3 cool = float3(0.62, 0.77, 1.0);    // the sky's, which is what the shade is lit by,
    float3 grass = float3(0.42, 0.62, 0.34);  // and the light the grass sends back up
    float under = Math.Max(-normal.y, 0) * 0.22;
    float3 lit = base * cool * sky + base * warm * (direct * sun * 0.86) + base * cool * (fill * 0.13) + base * grass * under
               + float3(shine) + cool * rim;
    return Color(lit.x, lit.y, lit.z, paint.a);
}

bool Is(float kind, float which)
{
    return Math.Abs(kind - which) < 0.5;
}

// The ground's paint at a place: grass mown in stripes and worn to earth where
// feet turn, the path to the school's door, the sand, the mud round the
// puddle, what's chalked, and the rock at the island's rim. `past` is how far
// past the puddle's edge the place is.
Color GroundPaint(float2 at, float past)
{
    float far = Math.Length(at);
    float reach = Math.Max(Math.Abs(at.x), Math.Abs(at.y));
    float wide = Math.Perlin(at * 0.55);
    float mid = Math.Perlin(at * 2.3 + float2(7.7, 1.3));
    float fine = Math.Perlin(at * 9.0);
    float stripe = Math.Frac((at.x + YARD) / 3.0) < 0.5 ? 0.0 : 1.0;
    mut float3 paint = float3(0.31, 0.58, 0.25) + float3(0.05, 0.06, 0.03) * stripe;
    if (reach > YARD + 0.2) paint = float3(0.25, 0.5, 0.22); // Past the fence, it's left long
    paint = paint * (1 + wide * 0.1 + mid * 0.08 + fine * 0.06);
    paint = paint + float3(0.08, 0.06, -0.02) * Math.Saturate(wide * 1.6); // Where the sun has bleached it
    mut float gloss = 0;

    float3 earth = float3(0.55, 0.42, 0.29) * (0.92 + fine * 0.08);
    if (reach < YARD)
    {
        // Worn bare round the roundabout, where everyone pushes off
        float worn = Math.Saturate(1 - Math.Abs(far - (SPIN_RADIUS + 0.3)) / 0.36 + mid * 0.5);
        paint = paint + (earth - paint) * (worn * 0.85);
    }
    if (at.y > YARD + 0.3 && at.y < 7.8 && Math.Abs(at.x - 0.8 + mid * 0.14) < 0.55)
    {
        float2 pebbles = Math.Cellular(at * 6);
        paint = float3(0.72, 0.68, 0.62) * (0.78 + pebbles.x * 0.38);
    }

    float sand = Math.Distance(at, Sand());
    if (sand < SAND_RADIUS + 0.05)
    {
        float dune = Math.Perlin(float2(at.x * 1.2 + at.y * 2.6, at.y * 0.8));
        paint = float3(0.95, 0.84, 0.6) * (0.93 + dune * 0.06 + Math.Perlin(at * 30) * 0.035);
    }
    if (past < 0.34)
    {
        float mud = Math.Saturate(1 - past / 0.34);
        paint = paint + (float3(0.36, 0.28, 0.2) - paint) * (mud * 0.85);
        gloss = mud * 0.9;
    }

    // Chalk: a ring round the roundabout, and a hopscotch
    mut float chalk = 0;
    if (Math.Abs(far - (SPIN_RADIUS + 0.62)) < 0.035) chalk = 0.6;
    float2 hop = float2(at.x + 2.0, at.y + 5.3) / 0.8;
    if (hop.x > 0 && hop.x < 5 && hop.y > 0 && hop.y < 1)
    {
        float across = Math.Frac(hop.x);
        float line = Math.Min(Math.Min(across, 1 - across), Math.Min(hop.y, 1 - hop.y)) * 0.8;
        if (line < 0.035) chalk = 0.6;
    }
    paint = paint + (float3(1) - paint) * (chalk * (0.75 + fine * 0.25));

    float rim = Math.Saturate((far - (ISLAND - 0.75) + mid * 0.4) / 0.5);
    paint = paint + (float3(0.5, 0.46, 0.42) * (0.9 + fine * 0.1) - paint) * rim;
    return Color(paint.x, paint.y, paint.z, gloss);
}

// The island: its top is the ground's paint and the puddle's water, and its
// side is rock in layers, with the turf's edge along its top.
frag GroundLook(Corner corner, out Color color, Solid solid, Room room, Shadow shadow)
{
    float3 seen = FromLamp(this.world, corner.normal, shadow.toLamp);
    float2 at = float2(this.world.x, this.world.z);
    float sun = (shadow.depth.Compare(seen.xy + float2(-LAMP_SOFT, -LAMP_SOFT), seen.z) + shadow.depth.Compare(seen.xy + float2(LAMP_SOFT, -LAMP_SOFT), seen.z)
               + shadow.depth.Compare(seen.xy + float2(-LAMP_SOFT, LAMP_SOFT), seen.z) + shadow.depth.Compare(seen.xy + float2(LAMP_SOFT, LAMP_SOFT), seen.z)) * 0.25
              * CloudShade(at, room.time);
    if (corner.normal.y < 0.5)
    {
        float layers = Math.Perlin(float2(this.world.y * 2.4 + Math.Perlin(at * 0.4) * 0.9, 0.5));
        float2 cracks = Math.Cellular(float2(Math.Atan2(this.world.z, this.world.x) * 9, this.world.y * 1.3));
        float deep = Math.Saturate(-this.world.y / 2.4);
        float tone = (0.84 + layers * 0.16) * (0.82 + Math.Saturate(cracks.y - cracks.x) * 0.36) * (1 - deep * 0.45);
        mut Color side = Color(0.52 * tone, 0.43 * tone, 0.36 * tone);
        if (this.world.y > -0.16 + Math.Perlin(at * 3) * 0.06) side = solid.tint;
        color = Lit(side, corner.normal, this.world, room.eye, 0, sun);
        return;
    }

    float wet = Math.Distance(at, Puddle()) - Math.Perlin(at * 1.3) * 0.13;
    if (wet < PUDDLE_RADIUS)
    {
        // Water: the sky in it, the sun's glint off its ripples, and rings that move out from its middle
        float2 flow = at * 2.4 + float2(room.time * 0.33, room.time * 0.21);
        float tiltX = Math.Perlin(flow + float2(0.12, 0)) - Math.Perlin(flow - float2(0.12, 0));
        float tiltZ = Math.Perlin(flow + float2(0, 0.12)) - Math.Perlin(flow - float2(0, 0.12));
        float shallow = Math.Saturate(wet / PUDDLE_RADIUS);
        float ring = Math.Sin(wet * 13 - room.time * 2.4) * shallow * 0.1;
        float2 out = (at - Puddle()) / Math.Max(Math.Distance(at, Puddle()), 0.001);
        float3 normal = Math.Normalize(float3(-tiltX * 0.8 - out.x * ring, 1, -tiltZ * 0.8 - out.y * ring));
        float3 toEye = Math.Normalize(room.eye - this.world);
        float mirror = 0.1 + 0.9 * Math.Pow(1 - Math.Max(Math.Dot(normal, toEye), 0), 4);
        float3 body = float3(0.4, 0.56, 0.5) + (float3(0.13, 0.36, 0.52) - float3(0.4, 0.56, 0.5)) * (1 - shallow * shallow);
        float3 above = float3(0.5, 0.72, 0.96) + float3(0.3, 0.2, 0.04) * Math.Saturate(normal.x * 3 + 0.3);
        float glint = Math.Pow(Math.Max(Math.Dot(normal, Math.Normalize(Lamp() + toEye)), 0), 160) * 3 * sun;
        float3 water = body * (0.42 + 0.58 * sun) * (1 - mirror) + above * (mirror * (0.7 + 0.3 * sun)) + float3(glint);
        color = Color(water.x, water.y, water.z, 1);
        return;
    }
    Color paint = GroundPaint(at, wet - PUDDLE_RADIUS);
    color = Lit(Color(paint.r, paint.g, paint.b, 1), corner.normal, this.world, room.eye, paint.a, sun);
}

// Anything that stands: lit, and painted as what it's made of.
frag Plain(Corner corner, out Color color, Solid solid, Instance instance, Room room, Shadow shadow)
{
    float3 normal = Math.Normalize(Math.Rotate(instance.transform, corner.normal / (solid.size * solid.size)));
    float3 seen = FromLamp(this.world, normal, shadow.toLamp);
    float sun = (shadow.depth.Compare(seen.xy + float2(-LAMP_SOFT, -LAMP_SOFT), seen.z) + shadow.depth.Compare(seen.xy + float2(LAMP_SOFT, -LAMP_SOFT), seen.z)
               + shadow.depth.Compare(seen.xy + float2(-LAMP_SOFT, LAMP_SOFT), seen.z) + shadow.depth.Compare(seen.xy + float2(LAMP_SOFT, LAMP_SOFT), seen.z)) * 0.25
              * CloudShade(float2(this.world.x, this.world.z), room.time);
    float3 local = corner.position * solid.size;
    mut float3 paint = float3(solid.tint.r, solid.tint.g, solid.tint.b);
    mut float gloss = solid.gloss;
    mut float glow = solid.glow;
    if (Is(solid.kind, CLOUD))
    {
        // A cloud is lit by the sky more than by the sun, and has no shadow on it
        float top = 0.78 + 0.22 * normal.y;
        float3 puff = float3(0.82, 0.88, 0.98) + (float3(1, 1, 1) - float3(0.82, 0.88, 0.98)) * Math.Saturate(Math.Dot(normal, Lamp()) * 0.7 + 0.45);
        color = Color(puff.x * top, puff.y * top, puff.z * top, 1);
        return;
    }
    if (Is(solid.kind, WOOD))
    {
        // Its grain runs along its longest side
        float along = solid.size.x >= solid.size.y && solid.size.x >= solid.size.z ? local.x : (solid.size.y >= solid.size.z ? local.y : local.z);
        float across = local.x + local.y + local.z - along;
        float grain = Math.Perlin(float2(along * 1.6, across * 28));
        float knots = Math.Perlin(float2(along * 0.7 + 3.1, across * 6 + 9.7));
        paint = paint * (0.9 + grain * 0.1 + knots * 0.08);
    }
    else if (Is(solid.kind, STONE))
    {
        float2 specks = Math.Cellular(float2(this.world.x + this.world.y * 0.7, this.world.z - this.world.y * 0.4) * 3.4);
        float mottle = Math.Perlin(this.world * 1.7);
        paint = paint * (0.88 + mottle * 0.12) + float3(0.06) * Math.Saturate(1 - specks.x * 2.4);
        paint = paint * (0.8 + Math.Saturate((specks.y - specks.x) * 4) * 0.2); // Cracks between its grains
    }
    else if (Is(solid.kind, LEAF))
    {
        float mottle = Math.Perlin(this.world * 3.4) * 0.6 + Math.Perlin(this.world * 9) * 0.4;
        paint = paint * (1 + mottle * 0.24);
        // Light comes through leaves: the side away from the sun isn't as dark
        glow = Math.Max(-Math.Dot(normal, Lamp()), 0) * 0.2;
    }
    else if (Is(solid.kind, BRICK))
    {
        float across = Math.Abs(normal.x) > 0.5 ? this.world.z : this.world.x;
        float row = Math.Floor(this.world.y / 0.2);
        float shift = row - Math.Floor(row * 0.5) * 2 > 0.5 ? 0.5 : 0.0;
        float2 brick = float2(across / 0.5 + shift, this.world.y / 0.2);
        float tone = 0.84 + (Math.Hash(int2(int(Math.Floor(brick.x)), int(row))) % 16) * 0.02;
        paint = paint * tone * (0.95 + Math.Perlin(float2(across, this.world.y) * 14) * 0.05);
        if (Math.Frac(brick.x) < 0.06 || Math.Frac(brick.y) < 0.15) paint = float3(0.86, 0.82, 0.76);
    }
    else if (Is(solid.kind, ROOF))
    {
        // Tiles, in rows down the slope: which way the slope runs depends on the face
        float slope = Math.Abs(corner.normal.y) > 0.5 ? local.z : local.y;
        float row = Math.Floor(slope / 0.26);
        float shift = row - Math.Floor(row * 0.5) * 2 > 0.5 ? 0.5 : 0.0;
        float2 tile = float2(local.x / 0.3 + shift, slope / 0.26);
        float tone = 0.82 + (Math.Hash(int2(int(Math.Floor(tile.x)), int(row))) % 16) * 0.022;
        paint = paint * tone * (0.74 + 0.26 * Math.Frac(tile.y));
        if (Math.Frac(tile.x) < 0.06) paint = paint * 0.78;
    }
    else if (Is(solid.kind, GLASS))
    {
        float3 toEye = Math.Normalize(room.eye - this.world);
        float mirror = Math.Pow(1 - Math.Max(Math.Dot(normal, toEye), 0), 3);
        paint = paint + (float3(0.75, 0.88, 1) - paint) * (0.25 + mirror * 0.6);
        gloss = 3;
    }
    Color lit = Lit(Color(paint.x, paint.y, paint.z, 1), normal, this.world, room.eye, gloss, sun);
    color = Color(lit.r + paint.x * glow, lit.g + paint.y * glow, lit.b + paint.z * glow, 1);
}

// The roundabout's deck: six slices in two colors, inside a steel rim, with
// its paint worn off where feet go. It's painted by where the pixel is on the
// deck's own mesh, so it turns with it.
frag DeckLook(Corner corner, out Color color, Solid solid, Instance instance, Room room, Shadow shadow)
{
    float3 normal = Math.Normalize(Math.Rotate(instance.transform, corner.normal / (solid.size * solid.size)));
    float3 seen = FromLamp(this.world, normal, shadow.toLamp);
    float sun = (shadow.depth.Compare(seen.xy + float2(-LAMP_SOFT, -LAMP_SOFT), seen.z) + shadow.depth.Compare(seen.xy + float2(LAMP_SOFT, -LAMP_SOFT), seen.z)
               + shadow.depth.Compare(seen.xy + float2(-LAMP_SOFT, LAMP_SOFT), seen.z) + shadow.depth.Compare(seen.xy + float2(LAMP_SOFT, LAMP_SOFT), seen.z)) * 0.25
              * CloudShade(float2(this.world.x, this.world.z), room.time);
    mut Color paint = solid.tint;
    float2 on = float2(corner.position.x, corner.position.z);
    float far = Math.Length(on);
    if (corner.normal.y > 0.5 && far < 0.92)
    {
        float around = Math.Atan2(on.y, on.x) / Math.TAU + 0.5;
        float slice = Math.Floor(around * 6);
        bool odd = slice - Math.Floor(slice * 0.5) * 2 > 0.5;
        paint = odd ? Color(0.93, 0.33, 0.3) : Color(0.98, 0.8, 0.25);
        float worn = Math.Saturate(Math.Perlin(on * 5) * 1.6 - 0.25 + (1 - Math.Abs(far - 0.6) * 4) * 0.3);
        paint = Color(paint.r + (0.56 - paint.r) * worn * 0.5, paint.g + (0.58 - paint.g) * worn * 0.5, paint.b + (0.62 - paint.b) * worn * 0.5);
        if (Math.Abs(far - 0.55) < 0.012) paint = Color(paint.r * 0.8, paint.g * 0.8, paint.b * 0.8);
    }
    color = Lit(paint, normal, this.world, room.eye, 0.6, sun);
}

// The wind bends a blade from its foot, more the higher up it, each in its own time.
vert Sway(mut Corner corner, Blade blade, Room room)
{
    float gust = Math.Sin(room.time * 1.7 + blade.phase) * 0.2 + Math.Sin(room.time * 3.3 + blade.phase * 1.7) * 0.07;
    corner.position.x += corner.position.y * corner.position.y * gust;
}

// A blade: darker at its foot, in the yard's light and its shadows.
frag BladeLook(Corner corner, out Color color, Blade blade, Room room, Shadow shadow)
{
    float3 up = float3(0, 1, 0);
    float3 seen = FromLamp(this.world, up, shadow.toLamp);
    float sun = (shadow.depth.Compare(seen.xy + float2(-LAMP_SOFT, -LAMP_SOFT), seen.z) + shadow.depth.Compare(seen.xy + float2(LAMP_SOFT, LAMP_SOFT), seen.z)) * 0.5
              * CloudShade(float2(this.world.x, this.world.z), room.time);
    float tall = 0.6 + 0.55 * corner.position.y;
    color = Lit(Color(blade.tint.r * tall, blade.tint.g * tall, blade.tint.b * tall, 1), up, this.world, room.eye, 0, sun);
}

// What's flat on the ground: a disc that fades at its edge, a ring, or part of
// one, going round from the top.
frag DecalLook(Corner corner, out Color color, Decal decal)
{
    float2 at = float2(corner.position.x, corner.position.z) * 2;
    float far = Math.Length(at);
    mut float shown = Math.Saturate((1 - far) * 8);
    if (decal.ring > 0) shown = shown * Math.Saturate((far - (1 - decal.ring)) * 8);
    if (decal.ring < 0) shown = Math.Saturate(1 - far) * Math.Saturate(1 - far); // A soft blot: the dark under a kid
    if (decal.arc < 1)
    {
        mut float around = Math.Atan2(at.x, at.y) / Math.TAU;
        if (around < 0) around += 1;
        if (around > decal.arc) shown = 0;
    }
    color = Color(decal.tint.r, decal.tint.g, decal.tint.b, decal.tint.a * shown);
}

frag MoteLook(Corner corner, out Color color, Mote mote)
{
    color = mote.tint;
}

// The frame at half the size: each pixel is four of the frame's.
frag Halve(Vertex vertex, out Color color, Texture source, Lens lens)
{
    Color sum = source.Sample(vertex.uv + float2(-0.5, -0.5) * lens.pixel) + source.Sample(vertex.uv + float2(0.5, -0.5) * lens.pixel)
              + source.Sample(vertex.uv + float2(-0.5, 0.5) * lens.pixel) + source.Sample(vertex.uv + float2(0.5, 0.5) * lens.pixel);
    color = Color(sum.r * 0.25, sum.g * 0.25, sum.b * 0.25, 1);
}

// What's bright in it, and nothing else: what glows.
frag Brights(Vertex vertex, out Color color, Texture source)
{
    Color seen = source.Sample(vertex.uv);
    float light = Math.Max(seen.r, Math.Max(seen.g, seen.b)) * 0.5 + (seen.r * 0.3 + seen.g * 0.5 + seen.b * 0.2) * 0.5;
    float kept = Math.Saturate((light - GLOW_FROM) / (1 - GLOW_FROM));
    color = Color(seen.r * kept, seen.g * kept, seen.b * kept, 1);
}

// One pass of a blur, along a line: five looks, weighted as a bell.
frag Blur(Vertex vertex, out Color color, Texture source, BlurStep step)
{
    float2 near = step.along * 1.3846;
    float2 far = step.along * 3.2308;
    Color sum = source.Sample(vertex.uv) * 0.227
              + (source.Sample(vertex.uv + near) + source.Sample(vertex.uv - near)) * 0.3162
              + (source.Sample(vertex.uv + far) + source.Sample(vertex.uv - far)) * 0.0703;
    color = Color(sum.r, sum.g, sum.b, 1);
}

// The frame, to the window: sharp across the yard and blurred at its top and
// its bottom, as a camera close to a model sees it, with the glow
// around what's bright, a little more color, and darker corners.
frag Finish(Vertex vertex, out Color color, Texture source, Lens lens)
{
    Color sharp = source.Sample(vertex.uv);
    Color soft = lens.soft.Sample(vertex.uv);
    Color glow = lens.glow.Sample(vertex.uv);
    float away = Math.Saturate(Math.Max((0.17 - vertex.uv.y) / 0.17, (vertex.uv.y - 0.86) / 0.14));
    float blur = away * away * (3 - 2 * away) * 0.92;
    mut float3 seen = float3(sharp.r + (soft.r - sharp.r) * blur, sharp.g + (soft.g - sharp.g) * blur, sharp.b + (soft.b - sharp.b) * blur);
    seen = seen + float3(glow.r, glow.g, glow.b) * 0.5;
    float gray = seen.x * 0.3 + seen.y * 0.55 + seen.z * 0.15;
    seen = float3(gray) + (seen - float3(gray)) * 1.16;
    seen = seen * 1.05 - float3(0.018);
    float2 off = vertex.uv - float2(0.5);
    float edge = 1 - Math.Dot(off, off) * 0.6;
    color = Color(seen.x * edge, seen.y * edge, seen.z * edge, 1);
}

// --------------------------------------------------------------- the meshes

// A box's six faces, four corners each, added to a mesh.
void AddBox(mut List<Corner> corners, mut List<int> faces)
{
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        float way = face % 2 == 0 ? 1 : -1;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        var first = corners.count;
        for (var i = 0; i < 4; i++)
        {
            float a = i == 0 || i == 3 ? -0.5 : 0.5;
            float b = i < 2 ? -0.5 : 0.5;
            corners.Add(Corner { position = normal * 0.5 + across * a + up * b, normal = normal });
        }
        faces.Add(first);
        faces.Add(first + 1);
        faces.Add(first + 2);
        faces.Add(first);
        faces.Add(first + 2);
        faces.Add(first + 3);
    }
}

// A ball of radius 1: rings of corners from its bottom to its top.
void AddBall(mut List<Corner> corners, mut List<int> faces, int rings, int around)
{
    for (var ring = 0; ring <= rings; ring++)
    {
        float tilt = ring * Math.PI / rings;
        for (var step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            var out = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
            corners.Add(Corner { position = out, normal = out });
            if (ring == rings || step == around) continue;
            int at = ring * (around + 1) + step;
            faces.Add(at);
            faces.Add(at + around + 1);
            faces.Add(at + 1);
            faces.Add(at + 1);
            faces.Add(at + around + 1);
            faces.Add(at + around + 2);
        }
    }
}

// A roll of radius 1, 1 high, or a cone when its top has no radius: its side,
// and a lid at each end that has one.
void AddRoll(mut List<Corner> corners, mut List<int> faces, int around, float top)
{
    var lean = Math.Normalize(float2(1, 1 - top)); // How far a cone's side leans back
    for (var step = 0; step <= around; step++)
    {
        float turn = step * Math.TAU / around;
        var out = float3(Math.Cos(turn), 0, Math.Sin(turn));
        var normal = float3(out.x * lean.x, lean.y, out.z * lean.x);
        corners.Add(Corner { position = out - float3(0, 0.5, 0), normal = normal });
        corners.Add(Corner { position = out * top + float3(0, 0.5, 0), normal = normal });
        if (step == around) continue;
        int at = step * 2;
        faces.Add(at);
        faces.Add(at + 1);
        faces.Add(at + 2);
        faces.Add(at + 2);
        faces.Add(at + 1);
        faces.Add(at + 3);
    }
    for (var lid = 0; lid < 2; lid++)
    {
        float way = lid == 0 ? 1 : -1;
        float wide = lid == 0 ? top : 1;
        if (wide <= 0) continue;
        var middle = corners.count;
        corners.Add(Corner { position = float3(0, way * 0.5, 0), normal = float3(0, way, 0) });
        for (var step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            corners.Add(Corner { position = float3(Math.Cos(turn) * wide, way * 0.5, Math.Sin(turn) * wide), normal = float3(0, way, 0) });
            if (step == around) continue;
            // Seen from outside, a triangle's corners go clockwise
            faces.Add(middle);
            faces.Add(middle + 1 + step + (lid == 0 ? 1 : 0));
            faces.Add(middle + 1 + step + (lid == 0 ? 0 : 1));
        }
    }
}

void MakeModels(mut Models models)
{
    models.made = true;
    AddBox(models.cube, models.cubeFaces);
    AddBall(models.ball, models.ballFaces, 14, 20);
    AddRoll(models.roll, models.rollFaces, 32, 1);
    AddRoll(models.cone, models.coneFaces, 20, 0);
    models.plate = [Corner { position = float3(-0.5, 0, -0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(0.5, 0, -0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(0.5, 0, 0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(-0.5, 0, 0.5), normal = float3(0, 1, 0) }];
    models.plateFaces = [0, 2, 1, 0, 3, 2];
    // A blade of grass: a foot 1 wide, and a tip 1 up
    models.blade = [Corner { position = float3(-0.5, 0, 0), normal = float3(0, 1, 0) },
                    Corner { position = float3(0.5, 0, 0), normal = float3(0, 1, 0) },
                    Corner { position = float3(0, 1, 0), normal = float3(0, 1, 0) }];
    models.bladeFaces = [0, 1, 2];
}

// A box, a ball, a roll or a cone, somewhere. A ball's size is its radii, a
// roll's and a cone's its radius, its height and its radius, and a box's its
// sides.
Solid Piece(float3 at, quaternion turn, float3 size, Color tint, float gloss)
{
    return Solid { transform = float4x4.TRS(at, turn, size), size = size, tint = tint, gloss = gloss };
}

// ...of something that's painted as what it is.
Solid Made(float3 at, quaternion turn, float3 size, Color tint, float gloss, float kind)
{
    return Solid { transform = float4x4.TRS(at, turn, size), size = size, tint = tint, gloss = gloss, kind = kind };
}

// Where a place in the yard is in the world: the yard's `y` is the world's `z`.
float3 Up(float2 at, float height)
{
    return float3(at.x, height, at.y);
}

// A mark painted on the ground: a disc, a ring, part of one, or with a ring
// under 0 a soft blot.
void Mark(mut Fx fx, float3 at, float size, Color tint, float ring, float arc)
{
    fx.decals.Add(Decal { transform = float4x4.TRS(at, quaternion.identity, float3(size, 1, size)), tint = tint, ring = ring, arc = arc });
}

// A tree: a trunk, and leaves in balls, or in cones for a fir.
void AddTree(mut Scenery scenery, float3 at, float size, bool fir, int seed)
{
    var none = quaternion.identity;
    mut var dice = Random(seed);
    var bark = Color(0.46, 0.32, 0.22);
    if (fir)
    {
        scenery.rolls.Add(Made(at + float3(0, 0.4 * size, 0), none, float3(0.14, 0.8, 0.14) * size, bark, 0.1, WOOD));
        for (var i = 0; i < 4; i++)
        {
            var shade = 0.85 + i * 0.07;
            scenery.cones.Add(Made(at + float3(0, (1.05 + i * 0.62) * size, 0), none, float3(1.0 - i * 0.2, 1.15, 1.0 - i * 0.2) * size,
                                   Color(0.13 * shade, 0.42 * shade, 0.26 * shade), 0.1, LEAF));
        }
        return;
    }
    scenery.rolls.Add(Made(at + float3(0, 0.8 * size, 0), none, float3(0.17, 1.6, 0.17) * size, bark, 0.1, WOOD));
    scenery.balls.Add(Made(at + float3(0, 2.2, 0) * size, none, float3(1.0, 0.9, 1.0) * size, Color(0.24, 0.55, 0.27), 0.15, LEAF));
    for (var i = 0; i < 4; i++)
    {
        var way = dice.NextFloat2Direction() * dice.NextFloat(0.45, 0.7);
        var shade = dice.NextFloat(0.85, 1.2);
        scenery.balls.Add(Made(at + float3(way.x, 2.0 + dice.NextFloat(0, 0.9), way.y) * size, none, float3(dice.NextFloat(0.5, 0.72)) * size,
                               Color(0.24 * shade, 0.56 * shade, 0.27 * shade), 0.15, LEAF));
    }
}

// The island and what stands on it: the ground, a picket fence, the oak in
// its planter, the boulder, the sandbox's timber, the schoolhouse behind the
// yard with the bell in its tower, the slide and the swings' frame, trees,
// lamps, flowers, and grass.
void MakeScenery(mut Scenery scenery)
{
    scenery.made = true;
    var none = quaternion.identity;
    var up = float3(0, 1, 0);
    scenery.ground.Add(Piece(float3(0, -1.3, 0), none, float3(ISLAND, 2.6, ISLAND), Color(0.28, 0.52, 0.24), 0));

    // The fence: posts, two rails a side, and pickets between the posts
    var white = Color(0.97, 0.95, 0.9);
    var edge = YARD + 0.22;
    for (var side = 0; side < 4; side++)
    {
        var alongX = side < 2;
        float far = side % 2 == 0 ? edge : -edge;
        for (var i = 0; i < 2; i++)
        {
            var height = 0.2 + i * 0.24;
            scenery.boxes.Add(Made(alongX ? float3(0, height, far) : float3(far, height, 0), none,
                                   alongX ? float3(edge * 2, 0.06, 0.05) : float3(0.05, 0.06, edge * 2), white, 0.2, WOOD));
        }
        for (var i = -24; i <= 24; i++)
        {
            float along = i * edge / 24;
            var post = i % 4 == 0;
            var tall = post ? 0.7 : 0.54;
            var wide = post ? 0.15 : 0.11;
            var thin = post ? 0.15 : 0.045;
            scenery.boxes.Add(Made(alongX ? float3(along, tall * 0.5, far) : float3(far, tall * 0.5, along), none,
                                   alongX ? float3(wide, tall, thin) : float3(thin, tall, wide), white, 0.2, WOOD));
            if (post) scenery.balls.Add(Piece(alongX ? float3(along, tall + 0.05, far) : float3(far, tall + 0.05, along), none, float3(0.095), white, 0.4));
        }
    }

    // The oak: a stone planter the size of what stops a kid, and the tree in it
    var oak = Up(Oak(), 0);
    scenery.rolls.Add(Made(oak + float3(0, 0.17, 0), none, float3(TREE_RADIUS, 0.34, TREE_RADIUS), Color(0.74, 0.72, 0.68), 0.2, STONE));
    scenery.rolls.Add(Piece(oak + float3(0, 0.19, 0), none, float3(TREE_RADIUS - 0.1, 0.34, TREE_RADIUS - 0.1), Color(0.36, 0.26, 0.2), 0));
    AddTree(scenery, oak + float3(0, 0.2, 0), 1.0, false, 3);

    // The boulder, and the smaller ones beside it
    var rock = Up(Rock(), 0);
    var gray = Color(0.62, 0.62, 0.66);
    scenery.balls.Add(Made(rock + float3(0, 0.25, 0), quaternion.Euler(float3(0.2, 0.6, 0.1)), float3(TREE_RADIUS, 0.6, TREE_RADIUS * 0.9), gray, 0.25, STONE));
    scenery.balls.Add(Made(rock + float3(0.42, 0.14, -0.38), quaternion.Euler(float3(0.4, 0.2, 0.3)), float3(0.3, 0.26, 0.34), Color(0.55, 0.55, 0.6), 0.25, STONE));
    scenery.balls.Add(Made(rock + float3(-0.45, 0.1, 0.36), none, float3(0.24, 0.18, 0.22), Color(0.68, 0.67, 0.7), 0.25, STONE));

    // The sandbox: timber round it, and two heaps someone left
    var sand = Up(Sand(), 0);
    for (var i = 0; i < 16; i++)
    {
        float turn = (i + 0.5) * Math.TAU / 16;
        var out = float3(Math.Cos(turn), 0, Math.Sin(turn));
        scenery.boxes.Add(Made(sand + out * (SAND_RADIUS + 0.1) + float3(0, 0.1, 0), quaternion.LookRotation(float3(-out.z, 0, out.x), up),
                               float3(0.2, 0.24, (SAND_RADIUS + 0.2) * Math.TAU / 16 + 0.02), i % 2 == 0 ? Color(0.72, 0.52, 0.32) : Color(0.66, 0.47, 0.29), 0.1, WOOD));
    }
    scenery.balls.Add(Piece(sand + float3(-0.55, 0, 0.5), none, float3(0.42, 0.16, 0.42), Color(0.93, 0.82, 0.58), 0));
    scenery.balls.Add(Piece(sand + float3(0.5, 0, -0.45), none, float3(0.3, 0.11, 0.3), Color(0.93, 0.82, 0.58), 0));

    // The schoolhouse: brick, under a tiled roof that's a box on its edge, with
    // a door, two windows, and a tower on the roof for the bell
    var school = float3(0.8, 0, 8.9);
    var brick = Color(0.74, 0.36, 0.29);
    var tiles = Color(0.36, 0.4, 0.5);
    var pitched = quaternion.AxisAngle(float3(1, 0, 0), Math.PI * 0.25);
    scenery.boxes.Add(Made(school + float3(0, 1.2, 0), none, float3(5.2, 2.4, 2.4), brick, 0.05, BRICK));
    scenery.boxes.Add(Made(school + float3(0, 2.4, 0), pitched, float3(5.18, 2.05, 2.05), tiles, 0.3, ROOF));
    scenery.boxes.Add(Made(school + float3(0, 0.06, 0), none, float3(5.4, 0.12, 2.6), Color(0.7, 0.68, 0.64), 0.1, STONE));
    scenery.boxes.Add(Made(school + float3(0, 0.8, -1.22), none, float3(0.9, 1.6, 0.06), white, 0.2, WOOD));
    scenery.boxes.Add(Made(school + float3(0, 0.76, -1.25), none, float3(0.72, 1.48, 0.06), Color(0.16, 0.5, 0.52), 0.5, WOOD));
    scenery.balls.Add(Piece(school + float3(0.25, 0.76, -1.3), none, float3(0.045), Color(0.98, 0.78, 0.25), 2));
    scenery.boxes.Add(Made(school + float3(0, 0.07, -1.5), none, float3(1.3, 0.14, 0.5), Color(0.7, 0.68, 0.64), 0.1, STONE));
    for (var i = 0; i < 2; i++)
    {
        var window = school + float3(i == 0 ? -1.55 : 1.55, 1.35, -1.22);
        scenery.boxes.Add(Made(window, none, float3(1.16, 1.0, 0.05), white, 0.2, WOOD));
        scenery.boxes.Add(Made(window - float3(0, 0, 0.02), none, float3(1.0, 0.84, 0.05), Color(0.36, 0.52, 0.66), 2, GLASS));
        scenery.boxes.Add(Made(window - float3(0, 0, 0.04), none, float3(0.05, 0.84, 0.04), white, 0.2, WOOD));
        scenery.boxes.Add(Made(window - float3(0, 0, 0.04), none, float3(1.0, 0.05, 0.04), white, 0.2, WOOD));
        scenery.boxes.Add(Made(window - float3(0, 0.56, 0.05), none, float3(1.26, 0.07, 0.14), white, 0.2, WOOD));
    }
    var tower = school + float3(1.6, 3.85, 0);
    scenery.boxes.Add(Made(tower, none, float3(0.9, 0.14, 0.9), white, 0.2, WOOD));
    for (var i = 0; i < 4; i++)
    {
        scenery.boxes.Add(Made(tower + float3(i % 2 == 0 ? 0.36 : -0.36, 0.45, i < 2 ? 0.36 : -0.36), none, float3(0.09, 0.8, 0.09), white, 0.2, WOOD));
    }
    scenery.boxes.Add(Made(tower + float3(0, 0.86, 0), none, float3(0.96, 0.08, 0.96), white, 0.2, WOOD));
    scenery.boxes.Add(Made(tower + float3(0, 0.9, 0), pitched, float3(1.04, 0.74, 0.74), tiles, 0.3, ROOF));

    // The slide, west of the yard
    var slide = float3(-8.9, 0, 0.3);
    var blue = Color(0.22, 0.47, 0.9);
    var yellow = Color(0.98, 0.78, 0.2);
    scenery.boxes.Add(Piece(slide + float3(0, 1.3, 1.0), none, float3(1.0, 0.08, 1.0), blue, 0.6));
    for (var i = 0; i < 4; i++)
    {
        scenery.rolls.Add(Piece(slide + float3(i % 2 == 0 ? 0.44 : -0.44, 0.9, i < 2 ? 1.44 : 0.56), none, float3(0.045, 1.8, 0.045), blue, 0.8));
    }
    var chute = Math.Normalize(float3(0, 1.2, 2.4));
    var slanted = quaternion.LookRotation(chute, up);
    scenery.boxes.Add(Piece(slide + float3(0, 0.72, -0.7), slanted, float3(0.8, 0.05, 2.7), yellow, 0.5));
    scenery.boxes.Add(Piece(slide + float3(0.42, 0.82, -0.7), slanted, float3(0.06, 0.24, 2.7), yellow, 0.5));
    scenery.boxes.Add(Piece(slide + float3(-0.42, 0.82, -0.7), slanted, float3(0.06, 0.24, 2.7), yellow, 0.5));
    var ladder = quaternion.LookRotation(Math.Normalize(float3(0, 1.3, -0.55)), up);
    scenery.boxes.Add(Piece(slide + float3(0.3, 0.65, 1.78), ladder, float3(0.06, 0.06, 1.45), blue, 0.8));
    scenery.boxes.Add(Piece(slide + float3(-0.3, 0.65, 1.78), ladder, float3(0.06, 0.06, 1.45), blue, 0.8));
    for (var i = 0; i < 4; i++)
    {
        scenery.boxes.Add(Piece(slide + float3(0, 0.2 + i * 0.3, 1.97 - i * 0.127), none, float3(0.6, 0.05, 0.08), blue, 0.8));
    }

    // The swings' frame, east of it: the swings themselves move (Turning)
    var swings = float3(8.9, 0, 0);
    var red = Color(0.9, 0.3, 0.27);
    scenery.rolls.Add(Piece(swings + float3(0, 2.3, 0), quaternion.AxisAngle(float3(1, 0, 0), Math.PI * 0.5), float3(0.055, 2.9, 0.055), red, 0.9));
    for (var i = 0; i < 4; i++)
    {
        float lean = i % 2 == 0 ? 0.3 : -0.3;
        scenery.rolls.Add(Piece(swings + float3(Math.Sin(lean) * 1.17, 1.13, i < 2 ? 1.4 : -1.4), quaternion.AxisAngle(float3(0, 0, 1), -lean),
                                float3(0.055, 2.42, 0.055), red, 0.9));
    }

    // Trees round the yard, tall ones behind it, and lamps by the near corners
    AddTree(scenery, float3(-8.2, 0, 4.7), 1.15, false, 11);
    AddTree(scenery, float3(-8.5, 0, -4.4), 0.9, false, 12);
    AddTree(scenery, float3(8.3, 0, 4.5), 1.05, false, 13);
    AddTree(scenery, float3(8.6, 0, -4.2), 0.85, true, 14);
    AddTree(scenery, float3(-4.7, 0, 8.6), 1.3, false, 15);
    AddTree(scenery, float3(5.9, 0, 8.2), 1.2, true, 16);
    AddTree(scenery, float3(-6.9, 0, 7.3), 1.1, true, 17);
    AddTree(scenery, float3(-2.6, 0, 9.9), 0.95, true, 18);
    AddTree(scenery, float3(4.4, 0, 9.7), 1.0, false, 19);
    for (var i = 0; i < 2; i++)
    {
        var lamp = float3(i == 0 ? -7.5 : 7.5, 0, -7.4);
        var iron = Color(0.2, 0.22, 0.26);
        scenery.rolls.Add(Piece(lamp + float3(0, 1.3, 0), none, float3(0.06, 2.6, 0.06), iron, 0.8));
        scenery.rolls.Add(Piece(lamp + float3(0, 0.1, 0), none, float3(0.17, 0.2, 0.17), iron, 0.8));
        scenery.rolls.Add(Piece(lamp + float3(0, 2.92, 0), none, float3(0.2, 0.06, 0.2), iron, 0.8));
        var globe = Piece(lamp + float3(0, 2.72, 0), none, float3(0.19), Color(1, 0.93, 0.72), 1);
        scenery.balls.Add(Solid { transform = globe.transform, size = globe.size, tint = globe.tint, gloss = 1, glow = 0.9 });
    }

    // What grows outside the fence: bushes, stones and flowers
    mut var dice = Random(7);
    for (var i = 0; i < 26; i++)
    {
        var way = dice.NextFloat2Direction();
        var at = way * dice.NextFloat(8.9, ISLAND - 0.7);
        if (at.y > 6.5 && Math.Abs(at.x - 0.8) < 3.4) continue; // The school's
        if (Math.Abs(at.y - 0.3) < 2.6 && Math.Abs(at.x) > 7.6) continue; // The slide's and the swings'
        var shade = dice.NextFloat(0.85, 1.15);
        if (dice.NextInt(3) == 0)
        {
            scenery.balls.Add(Made(Up(at, 0.1), quaternion.Euler(float3(dice.NextFloat(0, 1), dice.NextFloat(0, 6), 0)),
                                   float3(dice.NextFloat(0.2, 0.42), dice.NextFloat(0.16, 0.28), dice.NextFloat(0.2, 0.4)),
                                   Color(0.6 * shade, 0.6 * shade, 0.64 * shade), 0.25, STONE));
            continue;
        }
        var big = dice.NextFloat(0.3, 0.55);
        scenery.balls.Add(Made(Up(at, big * 0.6), none, float3(big, big * 0.85, big), Color(0.22 * shade, 0.52 * shade, 0.27 * shade), 0.1, LEAF));
        scenery.balls.Add(Made(Up(at + dice.NextFloat2Direction() * big * 0.8, big * 0.4), none, float3(big * 0.7), Color(0.27 * shade, 0.58 * shade, 0.29 * shade), 0.1, LEAF));
    }
    for (var i = 0; i < 150; i++)
    {
        var at = dice.NextFloat2Direction() * dice.NextFloat(6.6, ISLAND - 0.5);
        if (Math.Max(Math.Abs(at.x), Math.Abs(at.y)) < YARD + 0.45) continue;
        if (at.y > 7.4 && Math.Abs(at.x - 0.8) < 2.9) continue;
        var kind = dice.NextInt(4);
        var petal = kind == 0 ? Color(1, 1, 1) : kind == 1 ? Color(1, 0.85, 0.25) : kind == 2 ? Color(0.98, 0.5, 0.7) : Color(0.95, 0.35, 0.3);
        scenery.balls.Add(Piece(Up(at, 0.2), none, float3(0.075, 0.06, 0.075), petal, 0.2));
        scenery.balls.Add(Piece(Up(at, 0.215), none, float3(0.03), Color(0.98, 0.78, 0.2), 0.2));
    }

    // Grass: long outside the fence, and tufts in the yard where nothing's worn it away
    for (var i = 0; i < 7000; i++)
    {
        var at = dice.NextFloat2Direction() * (Math.Sqrt(dice.NextFloat()) * (ISLAND - 0.25));
        var inside = Math.Max(Math.Abs(at.x), Math.Abs(at.y)) < YARD + 0.1;
        if (inside && dice.NextInt(7) != 0) continue;
        if (inside && (Math.Length(at) < SPIN_RADIUS + 0.9 || Math.Distance(at, Sand()) < SAND_RADIUS + 0.3
            || Math.Distance(at, Puddle()) < PUDDLE_RADIUS + 0.45 || Math.Distance(at, Oak()) < 0.8 || Math.Distance(at, Rock()) < 0.8)) continue;
        if (at.y > 7.5 && at.y < 10.3 && Math.Abs(at.x - 0.8) < 2.8) continue; // Under the school
        if (at.y > YARD && at.y < 7.8 && Math.Abs(at.x - 0.8) < 0.7) continue;  // Its path
        var tall = inside ? dice.NextFloat(0.1, 0.19) : dice.NextFloat(0.22, 0.5);
        var shade = dice.NextFloat(0.8, 1.25);
        scenery.grass.Add(Blade { transform = float4x4.TRS(Up(at, 0), quaternion.AxisAngle(up, dice.NextFloat(0, Math.TAU)), float3(dice.NextFloat(0.07, 0.12), tall, 1)),
                                  tint = Color(0.3 * shade, 0.6 * shade, 0.24 * shade), phase = at.x * 0.7 + at.y * 0.45 + dice.NextFloat(0, 1.5) });
    }
}

local event(Tagged tag) ShowTag(mut Fx fx)
{
    var at = Up(tag.at, 0.75);
    fx.popups.Add(Popup { text = "TAG!", position = at + float3(0, 1.2, 0), tone = Tone(tag.caught) });
    for (var i = 0; i < 20; i++)
    {
        var way = fx.random.NextFloat3Direction() * fx.random.NextFloat(1.5, 5);
        fx.sparks.Add(Spark { position = at, velocity = float3(way.x, Math.Abs(way.y) + 1, way.z), life = fx.random.NextFloat(0.35, 0.7),
                              size = fx.random.NextFloat(0.1, 0.2), tone = i % 2 == 0 ? Tone(tag.caught) : Color.white });
    }
    fx.shake = Math.Max(fx.shake, 0.25);
    Audio.Play(tagClip, 0.8, fx.random.NextFloat(0.94, 1.08));
}

local event(Dashed dash) ShowDash(mut Fx fx)
{
    for (var i = 0; i < 6; i++)
    {
        var way = fx.random.NextFloat2Direction() * 0.8 - dash.way * 2;
        fx.sparks.Add(Spark { position = Up(dash.at - dash.way * 0.3, 0.12), velocity = float3(way.x, fx.random.NextFloat(0.5, 1.6), way.y), life = 0.45,
                              size = fx.random.NextFloat(0.1, 0.2), weight = 0.3, tone = Color(0.9, 0.95, 0.8) });
    }
    Audio.Play(dashClip, 0.3, fx.random.NextFloat(0.9, 1.2));
}

// The bell: it rings, and paper in the winners' colors comes down over the yard.
local event(Rang rang) ShowBell(mut Fx fx, Me me)
{
    for (var i = 0; i < 110; i++)
    {
        mut var color = fx.random.NextInt(COLORS);
        for (var tries = 0; tries < COLORS && (rang.winners & (1 << color)) == 0; tries++)
        {
            color = (color + 1) % COLORS;
        }
        var from = float3(fx.random.NextFloat(-YARD, YARD), fx.random.NextFloat(4, 9), fx.random.NextFloat(-YARD, YARD));
        var way = float3(fx.random.NextFloat(-1, 1), fx.random.NextFloat(-1, 0), fx.random.NextFloat(-1, 1));
        fx.sparks.Add(Spark { position = from, velocity = way, life = fx.random.NextFloat(3, 4.5),
                              size = fx.random.NextFloat(0.12, 0.2), weight = 0.16, paper = true, tone = Tone(color) });
    }
    Audio.Play(bellClip, 0.75);
    if (me.color >= 0 && (rang.winners & (1 << me.color)) != 0) Audio.Play(winClip, 0.6);
}

// A frame starts: the meshes, the island and the targets are made, once, and
// what the views after this one fill is emptied.
[Stage(Layers.Camera, -1)]
view Begin(mut Fx fx, mut Models models, mut Scenery scenery, mut Lens lens, mut Room room)
{
    if (!models.made) MakeModels(models);
    if (!scenery.made) MakeScenery(scenery);
    if (!lens.made)
    {
        lens.made = true;
        lens.scene = RenderTarget.Window(samples: 4);
        lens.half = RenderTarget.Window(0.5);
        lens.halfB = RenderTarget.Window(0.5);
        lens.bright = RenderTarget.Window(0.25);
        lens.spread = RenderTarget.Window(0.25);
        lens.soft = lens.half.color;
        lens.glow = lens.bright.color;
    }
    lens.pixel = float2(1 / Screen.width, 1 / Screen.height);
    fx.dt = Math.Min(Frame.dt, 0.05);
    fx.beat += fx.dt * 3;
    if (fx.beat > Math.TAU) fx.beat -= Math.TAU;
    fx.time += fx.dt;
    if (fx.time > 3600) fx.time -= 3600;
    room.beat = fx.beat;
    room.time = fx.time;
    fx.shake = Math.Max(0, fx.shake - fx.dt);
    fx.clock += fx.dt;
    if (fx.clock > 8) fx.clock -= 8;
    fx.boxes.Clear();
    fx.balls.Clear();
    fx.rolls.Clear();
    fx.decks.Clear();
    fx.clouds.Clear();
    fx.decals.Clear();

    fx.birds.clip = birdsClip;
    fx.birds.loop = true;
    fx.birds.volume = 0.3;
    fx.birds.playing = true;
}

// Where a ray from the camera meets the yard.
float2 OnGround(float3 origin, float3 way)
{
    if (Math.Abs(way.y) < 0.00001) return float2(0);
    var hit = origin + way * (-origin.y / way.y);
    return float2(hit.x, hit.z);
}

// The camera, over the yard and tilted down at it, always from the same side,
// so that up on the screen is the same way in the yard for every player. It
// shows the whole yard, between the scores and the hints, in a window of any
// shape, and sways a little, as someone holding it would. Then the pointer:
// the mouse, held, and fingers steer towards where they point in the yard,
// and the right button, a second finger and the DASH button dash.
[Stage(Layers.Camera)]
view Look(Devices devices, Fx fx, mut Room room, mut Layout layout, mut Pad pad, mut Me me, Lens lens, Lobby lobby)
{
    var screen = float2(Screen.width, Screen.height);
    var top = 102.0;
    var bottom = 46.0;
    var tall = Math.Max(screen.y - top - bottom, 80);
    layout.middle = top + tall * 0.5;
    layout.reach = Math.Clamp(Math.Min(screen.x, screen.y) * 0.08, 22, 32);
    layout.button = float2(screen.x - layout.reach - 8, screen.y - bottom - layout.reach - 4);

    var pitch = 0.9;
    var fov = 30.0;
    var half = Math.Tan(Math.Radians(fov) * 0.5);
    var span = YARD + 0.75;
    var back = Math.Max(span / (half * screen.x / screen.y), span * Math.Sin(pitch) * 1.12 / half * (screen.y / tall));
    // The yard's middle is between the scores and the hints, not the window's
    var lift = (top - bottom) * 0.5 * (2 * half * back / screen.y) / Math.Sin(pitch);
    var focus = float3(0, 0, lift + 0.4);
    var sway = Math.Sin(fx.time * 0.23) * 0.03;
    var from = float3(Math.Sin(sway) * -Math.Cos(pitch), Math.Sin(pitch) + Math.Sin(fx.time * 0.31) * 0.006, -Math.Cos(pitch) * Math.Cos(sway));
    var eye = focus + from * back;
    var turned = quaternion.LookRotation(Math.Normalize(focus - eye), float3(0, 1, 0));
    var wobble = fx.beat * 23;
    var jolt = float3(Math.Sin(wobble) + Math.Sin(wobble * 0.62 + 1.3) * 0.6, Math.Sin(wobble * 0.89 + 2.1) + Math.Sin(wobble * 0.54 + 0.4) * 0.6, 0)
             * (fx.shake * fx.shake * 0.02 * back);
    room.eye = eye + jolt;
    lens.scene.SetCamera(room.eye, turned, fov);
    Audio.SetListener(float3(0, 6, -6), quaternion.identity);

    me.self = default;
    me.color = -1;
    pad.steer = false;
    pad.stick = float2(0);
    if (!lobby.playing) { pad.dashHold = 0; return; }
    mut var dash = false;
    var mouse = devices.mouse;
    var mouseAt = Screen.Flip(mouse.position);
    if (mouse.left.down) pad.onButton = Math.Distance(mouseAt, layout.button) < layout.reach;
    if (mouse.left.pressed)
    {
        if (pad.onButton)
        {
            dash = true;
        }
        else
        {
            pad.steer = true;
            pad.target = OnGround(lens.scene.ScreenRayOrigin(mouseAt), lens.scene.ScreenRayDirection(mouseAt));
        }
    }
    if (mouse.right.pressed) dash = true;
    foreach (var touch in devices.touchscreen.touches)
    {
        if (!touch.press.pressed) continue;
        if (pad.steer || Math.Distance(Screen.Flip(touch.startPosition), layout.button) < layout.reach * 1.4)
        {
            dash = true;
            continue;
        }
        pad.steer = true;
        var at = Screen.Flip(touch.position);
        pad.target = OnGround(lens.scene.ScreenRayOrigin(at), lens.scene.ScreenRayDirection(at));
    }
    pad.dashHold = dash ? 0.1 : Math.Max(0, pad.dashHold - fx.dt);
}

// A kid, of balls: shoes, a shirt in its color, hands, a head, and a cap with
// its peak out the front. It bobs as it runs and leans into a dash, whoever's
// it reaches out, with red on the ground under them and a red gem over their
// head, and one that runs through the puddle kicks water up.
void AddKid(mut Fx fx, Kid kid, bool mine, bool it, float counted)
{
    var flat = kid.position;
    var floor = Math.LengthSq(flat) < SPIN_RADIUS * SPIN_RADIUS ? DECK : 0.0;
    var ground = Up(flat, floor + ON_FLOOR);
    var pace = Math.Min(Math.Length(kid.velocity) / 5, 1);
    Mark(fx, ground, 1.5, Color(0, 0, 0, 0.42), -1, 1); // The dark right under them, which the sun's shadow is too far off to be
    if (it)
    {
        var pulse = 0.75 + Math.Sin(fx.beat * 3) * 0.25;
        Mark(fx, ground, 2.6, Color(1, 0.2, 0.15, 0.55 * pulse), 0, 1);
        if (counted < 1) Mark(fx, ground, 2.2, Color(1, 1, 1, 0.95), 0.14, 1 - counted); // Just caught: they count
    }
    if (mine)
    {
        // Your own has a ring around it, and a second one that fills up as the dash comes back
        var filled = 1 - Math.Saturate(kid.cooldown / COOLDOWN);
        Mark(fx, ground, 1.6, Color(1, 1, 1, 0.6), 0.12, 1);
        if (filled < 1) Mark(fx, ground, 1.95, Color(1, 1, 1, 0.9), 0.1, filled);
    }
    if (pace > 0.35 && Math.Distance(flat, Puddle()) < PUDDLE_RADIUS - 0.1 && fx.random.NextFloat() < fx.dt * 26)
    {
        var way = fx.random.NextFloat2Direction() * fx.random.NextFloat(0.4, 1.6);
        fx.sparks.Add(Spark { position = Up(flat, 0.1), velocity = float3(way.x, fx.random.NextFloat(2, 4.2), way.y), life = 0.5,
                              size = fx.random.NextFloat(0.06, 0.12), weight = 0.8, tone = Color(0.75, 0.9, 1) });
    }
    if (kid.safe > 0 && Math.Frac(kid.safe * 5) < 0.4) return; // Blinks while nobody can catch it

    var way = Math.Normalize(kid.facing);
    var front = float3(way.x, 0, way.y);
    var side = float3(-way.y, 0, way.x);
    var up = float3(0, 1, 0);
    var dashing = Math.Saturate(kid.burst / 0.25);
    var turn = quaternion.LookRotation(Math.Normalize(front + up * (-0.5 * dashing - 0.12 * pace)), up); // Leaning into it
    var phase = (flat.x + flat.y) * 5;
    var bob = Math.Abs(Math.Sin(phase)) * 0.1 * pace;
    var stride = Math.Sin(phase) * pace * 0.22;
    var at = Up(flat, floor);
    var big = KID;
    var tone = Tone(kid.color);
    var shade = Color(tone.r * 0.68, tone.g * 0.68, tone.b * 0.68);
    var skin = Color(0.99, 0.81, 0.66);
    var dark = Color(0.17, 0.16, 0.22);

    fx.balls.Add(Piece(at + (side * 0.17 + front * stride + up * (0.09 + Math.Max(Math.Sin(phase), 0) * 0.08 * pace)) * big, turn, float3(0.12, 0.09, 0.18) * big, dark, 0.4));
    fx.balls.Add(Piece(at + (up * (0.09 + Math.Max(-Math.Sin(phase), 0) * 0.08 * pace) - side * 0.17 - front * stride) * big, turn, float3(0.12, 0.09, 0.18) * big, dark, 0.4));
    var chest = at + (up * (0.5 + bob) + front * (pace * 0.06 + dashing * 0.12)) * big;
    fx.balls.Add(Piece(chest, turn, float3(0.31, 0.36, 0.28 + dashing * 0.06) * big, tone, 0.35));
    fx.balls.Add(Piece(chest - (front * 0.25 - up * 0.04) * big, turn, float3(0.2, 0.22, 0.13) * big, shade, 0.3)); // A satchel
    var reaching = it && counted >= 1;
    if (reaching)
    {
        fx.balls.Add(Piece(chest + (front * 0.38 + up * 0.14 + side * 0.2) * big, turn, float3(0.095 * big), skin, 0.3));
        fx.balls.Add(Piece(chest + (front * 0.38 + up * 0.14 - side * 0.2) * big, turn, float3(0.095 * big), skin, 0.3));
    }
    else
    {
        fx.balls.Add(Piece(chest + (side * 0.36 - front * stride * 0.8) * big, turn, float3(0.095 * big), skin, 0.3));
        fx.balls.Add(Piece(chest + (front * stride * 0.8 - side * 0.36) * big, turn, float3(0.095 * big), skin, 0.3));
    }
    var head = at + (up * (1.03 + bob) + front * (pace * 0.12 + dashing * 0.2)) * big;
    fx.balls.Add(Piece(head, turn, float3(0.27 * big), skin, 0.4));
    fx.balls.Add(Piece(head + (up * 0.09 - front * 0.02) * big, turn, float3(0.285, 0.21, 0.285) * big, shade, 0.5));
    fx.balls.Add(Piece(head + (up * 0.1 + front * 0.25) * big, turn, float3(0.17, 0.035, 0.15) * big, shade, 0.5));
    fx.balls.Add(Piece(head + (front * 0.24 + side * 0.1 - up * 0.03) * big, turn, float3(0.045 * big), dark, 1.5));
    fx.balls.Add(Piece(head + (front * 0.24 - side * 0.1 - up * 0.03) * big, turn, float3(0.045 * big), dark, 1.5));
    if (!it) return;
    var gem = Piece(head + up * (0.72 + Math.Sin(fx.beat * 2) * 0.06), quaternion.Euler(float3(0.62, fx.beat * 2, 0.79)), float3(0.26),
                    Color(1, 0.25, 0.2), 0.8);
    fx.boxes.Add(Solid { transform = gem.transform, size = gem.size, tint = gem.tint, gloss = gem.gloss, glow = 0.7 });
}

[Stage(Layers.Gather)]
view Others(Kid kid, Recess recess, Time time, mut Fx fx, without ownership)
{
    var it = this == recess.it;
    AddKid(fx, kid, false, it, it ? (time.tick - recess.since) * time.dt / COUNT : 1);
}

[Stage(Layers.Gather)]
view Mine(Kid kid, Recess recess, Time time, mut Fx fx, mut Me me, mut Pad pad, with ownership)
{
    me.self = this;
    me.color = kid.color;
    var it = this == recess.it;
    AddKid(fx, kid, true, it, it ? (time.tick - recess.since) * time.dt / COUNT : 1);
    var wet = Math.Distance(kid.position, Puddle()) < PUDDLE_RADIUS - 0.1;
    if (wet && !fx.wasWet) Audio.Play(splashClip, 0.55);
    fx.wasWet = wet;
    if (!pad.steer) return;
    var way = pad.target - kid.position;
    var far = Math.Length(way);
    if (far > 0.15) pad.stick = way / far * Math.Min(1, far / 0.8);
}

// What moves by itself: the roundabout turns with the match's clock, as
// whoever's on it does, the swings swing, the bell rings while a round is
// cheered, and clouds go by behind the island.
[Stage(Layers.Gather)]
view Turning(Time time, Recess recess, mut Fx fx)
{
    var none = quaternion.identity;
    var up = float3(0, 1, 0);
    var steel = Color(0.72, 0.75, 0.8);
    var turn = time.tick * time.dt * SPIN;
    var facing = quaternion.LookRotation(float3(Math.Cos(turn), 0, Math.Sin(turn)), up);
    fx.decks.Add(Piece(float3(0, DECK * 0.5, 0), facing, float3(SPIN_RADIUS, DECK, SPIN_RADIUS), Color(0.34, 0.36, 0.42), 0.5));
    fx.rolls.Add(Piece(float3(0, DECK + 0.3, 0), none, float3(0.11, 0.6, 0.11), steel, 1.2));
    fx.balls.Add(Piece(float3(0, DECK + 0.64, 0), none, float3(0.15), Color(0.93, 0.33, 0.3), 1.2));
    for (var i = 0; i < 3; i++)
    {
        var spoke = turn + i * Math.TAU / 3;
        var out = float3(Math.Cos(spoke), 0, Math.Sin(spoke));
        var along = float3(-out.z, 0, out.x);
        var rim = out * (SPIN_RADIUS - 0.1);
        // A handle: two posts and a bar between them
        fx.rolls.Add(Piece(rim + along * 0.22 + up * (DECK + 0.24), none, float3(0.035, 0.48, 0.035), steel, 1.2));
        fx.rolls.Add(Piece(rim - along * 0.22 + up * (DECK + 0.24), none, float3(0.035, 0.48, 0.035), steel, 1.2));
        fx.boxes.Add(Piece(rim + up * (DECK + 0.49), quaternion.LookRotation(along, up), float3(0.06, 0.06, 0.5), steel, 1.2));
    }

    // The swings: two chains and a seat each, from the frame's bar
    for (var i = 0; i < 2; i++)
    {
        var swung = Math.Sin(fx.time * 1.9 + i * 2.1) * (0.32 - i * 0.1);
        var pivot = float3(8.9, 2.3, i == 0 ? 0.62 : -0.62);
        var down = float3(Math.Sin(swung), -Math.Cos(swung), 0);
        var hung = quaternion.AxisAngle(float3(0, 0, 1), swung);
        fx.boxes.Add(Piece(pivot + down * 0.8 + float3(0, 0, 0.22), hung, float3(0.02, 1.6, 0.02), steel, 1));
        fx.boxes.Add(Piece(pivot + down * 0.8 - float3(0, 0, 0.22), hung, float3(0.02, 1.6, 0.02), steel, 1));
        fx.boxes.Add(Piece(pivot + down * 1.6, hung, float3(0.26, 0.05, 0.56), i == 0 ? Color(0.22, 0.47, 0.9) : Color(0.98, 0.78, 0.2), 0.6));
    }

    // The bell, in the school's tower
    var swing = recess.cheering ? Math.Sin(fx.beat * 6) * 0.4 : Math.Sin(fx.time * 0.9) * 0.03;
    var hook = float3(2.4, 4.6, 8.9);
    var hang = float3(Math.Sin(swing), -Math.Cos(swing), 0);
    var tilted = quaternion.AxisAngle(float3(0, 0, 1), swing);
    var gold = Color(0.98, 0.78, 0.25);
    fx.balls.Add(Piece(hook + hang * 0.22, tilted, float3(0.2, 0.22, 0.2), gold, 2.5));
    fx.rolls.Add(Piece(hook + hang * 0.36, tilted, float3(0.25, 0.07, 0.25), gold, 2.5));
    fx.balls.Add(Piece(hook + hang * 0.42 + float3(Math.Sin(swing * 1.6) * 0.06, 0, 0), none, float3(0.06), Color(0.5, 0.4, 0.2), 1));

    // Clouds, behind the island and to its sides, going round it slowly
    for (var i = 0; i < 7; i++)
    {
        var around = 0.5 + i * 0.36 + fx.time * 0.004 + Math.Sin(i * 1.7) * 0.1;
        var far = 15.5 + Math.Frac(i * 0.37) * 5;
        var at = float3(Math.Cos(around) * far, -2.2 + Math.Frac(i * 0.61) * 3.4, Math.Sin(around) * far);
        var big = 1.5 + Math.Frac(i * 0.83) * 1.3;
        fx.clouds.Add(Made(at, none, float3(big * 1.5, big * 0.75, big), Color.white, 0, CLOUD));
        fx.clouds.Add(Made(at + float3(big * 1.1, big * 0.15, 0.3), none, float3(big, big * 0.6, big * 0.8), Color.white, 0, CLOUD));
        fx.clouds.Add(Made(at + float3(-big * 1.15, -big * 0.05, -0.2), none, float3(big * 0.9, big * 0.5, big * 0.75), Color.white, 0, CLOUD));
        fx.clouds.Add(Made(at + float3(big * 0.2, big * 0.45, 0.1), none, float3(big * 0.8, big * 0.6, big * 0.7), Color.white, 0, CLOUD));
    }
}

// The bell's paper: each piece falls, tumbling, and lies where it lands. It's
// lit like everything else, so it has a shadow.
[Stage(Layers.Gather)]
view Paper(mut Fx fx)
{
    mut var i = 0;
    while (i < fx.sparks.count)
    {
        mut var spark = fx.sparks[i];
        if (!spark.paper)
        {
            i++;
            continue;
        }
        spark.age += fx.dt;
        if (spark.age >= spark.life)
        {
            fx.sparks.RemoveAt(i);
            continue;
        }
        if (spark.position.y > 0.03)
        {
            spark.velocity.y -= 18 * spark.weight * fx.dt;
            spark.velocity.x += Math.Sin(spark.age * 5 + spark.size * 60) * fx.dt * 2;
            spark.position += spark.velocity * fx.dt;
        }
        fx.sparks[i] = spark;
        var left = Math.Saturate((spark.life - spark.age) * 2);
        var lying = spark.position.y <= 0.03;
        var tumble = lying ? quaternion.identity : quaternion.Euler(float3(spark.age * 7, spark.age * 5 + spark.size * 40, spark.age * 3));
        fx.boxes.Add(Piece(float3(spark.position.x, Math.Max(spark.position.y, 0.02), spark.position.z), tumble,
                           float3(spark.size, 0.015, spark.size * 0.7) * left, spark.tone, 0.3));
        i++;
    }
}

// The sun's image: everything that casts a shadow, drawn through a camera
// where the sun is, into a target that keeps how far the sun sees along each
// of its pixels, and nothing else.
[Stage(Layers.Lamp)]
view Cast(Fx fx, Scenery scenery, Models models, mut Shadow shadow)
{
    if (!shadow.made)
    {
        shadow.made = true;
        shadow.map = RenderTarget(LAMP_PIXELS, LAMP_PIXELS, 1, Format.Depth);
        shadow.depth = shadow.map.depth;
    }
    // The sun looks along its light from far off, and sees a box with no perspective
    var turned = quaternion.LookRotation(-Lamp(), float3(0, 1, 0));
    var lamp = float4x4.TRS(Math.Mul(turned, float3(0, 1.5, -LAMP_AWAY)), turned, float3(1));
    var sees = float4x4.Ortho(LAMP_SPAN, LAMP_SPAN, 0, LAMP_FAR);
    shadow.map.Clear(Color.white);
    shadow.map.SetCamera(lamp, sees);
    shadow.toLamp = shadow.map.WorldToClip();
    shadow.map.Instanced(models.cube, models.cubeFaces, scenery.boxes);
    shadow.map.Instanced(models.ball, models.ballFaces, scenery.balls);
    shadow.map.Instanced(models.roll, models.rollFaces, scenery.rolls);
    shadow.map.Instanced(models.cone, models.coneFaces, scenery.cones);
    shadow.map.Instanced(models.cube, models.cubeFaces, fx.boxes);
    shadow.map.Instanced(models.ball, models.ballFaces, fx.balls);
    shadow.map.Instanced(models.roll, models.rollFaces, fx.rolls);
    shadow.map.Instanced(models.roll, models.rollFaces, fx.decks);
}

// The frame starts here: the sky, the clouds, and the island.
[Stage(Layers.Scene)]
view Sky(Fx fx, Models models, Scenery scenery, Lens lens)
{
    var screen = float2(Screen.width, Screen.height);
    lens.scene.Clear(Color(0.45, 0.7, 0.94));
    lens.scene.Screen()
    {
        lens.scene.Shape(Shape { center = screen * 0.5, size = screen, color = Color(0.33, 0.6, 0.92), color2 = Color(0.68, 0.85, 0.97) });
        // The sun's haze, up and to the left, where the light comes from
        lens.scene.Shape(Shape { center = float2(screen.x * 0.16, screen.y * 0.1), size = float2(screen.y * 1.5), ellipse = true,
                                 color = Color(1, 0.95, 0.8, 0.3), soft = screen.y * 0.7 });
    }
    lens.scene.Instanced(models.ball, models.ballFaces, fx.clouds, Plain);
    lens.scene.Instanced(models.roll, models.rollFaces, scenery.ground, GroundLook);
}

// Everything that stands on the island: each shape's are one draw, and so is
// the grass.
[Stage(Layers.Pieces)]
view Pieces(Fx fx, Models models, Scenery scenery, Lens lens)
{
    lens.scene.Instanced(models.cube, models.cubeFaces, scenery.boxes, Plain);
    lens.scene.Instanced(models.ball, models.ballFaces, scenery.balls, Plain);
    lens.scene.Instanced(models.roll, models.rollFaces, scenery.rolls, Plain);
    lens.scene.Instanced(models.cone, models.coneFaces, scenery.cones, Plain);
    lens.scene.Instanced(models.cube, models.cubeFaces, fx.boxes, Plain);
    lens.scene.Instanced(models.ball, models.ballFaces, fx.balls, Plain);
    lens.scene.Instanced(models.roll, models.rollFaces, fx.rolls, Plain);
    lens.scene.Instanced(models.roll, models.rollFaces, fx.decks, DeckLook);
    lens.scene.Cull(Cull.None)
    {
        lens.scene.Instanced(models.blade, models.bladeFaces, scenery.grass, Sway, BladeLook);
    }
}

// What's flat on the ground, over it. It reads depth and writes none: what's
// in front hides it, and it hides nothing.
[Stage(Layers.Marks)]
view Marks(Fx fx, Models models, Lens lens)
{
    lens.scene.Depth(Depth.Read)
    {
        lens.scene.Instanced(models.plate, models.plateFaces, fx.decals, DecalLook);
    }
}

// The sparks, each a small cube that glows: they fly, fall and fade. All of
// them are one draw, added to what's behind them.
[Stage(Layers.Air)]
view Glow(mut Fx fx, Models models, Lens lens)
{
    fx.motes.Clear();
    mut var i = 0;
    while (i < fx.sparks.count)
    {
        mut var spark = fx.sparks[i];
        if (spark.paper)
        {
            i++;
            continue;
        }
        spark.age += fx.dt;
        if (spark.age >= spark.life)
        {
            fx.sparks.RemoveAt(i);
            continue;
        }
        spark.velocity.y -= 18 * spark.weight * fx.dt;
        spark.velocity = spark.velocity * Math.Max(0, 1 - 2 * fx.dt);
        spark.position += spark.velocity * fx.dt;
        if (spark.position.y < 0.05 && spark.velocity.y < 0)
        {
            spark.position.y = 0.05;
            spark.velocity = float3(spark.velocity.x * 0.6, -spark.velocity.y * 0.4, spark.velocity.z * 0.6);
        }
        fx.sparks[i] = spark;
        var left = 1 - spark.age / spark.life;
        fx.motes.Add(Mote { transform = float4x4.TRS(spark.position, quaternion.identity, float3(spark.size * (0.4 + 0.6 * left))),
                            tint = Color(spark.tone.r, spark.tone.g, spark.tone.b, Math.Min(left * 1.6, 1)) });
        i++;
    }
    lens.scene.Blend(Blend.Add),
    lens.scene.Depth(Depth.Read),
    lens.scene.Cull(Cull.None)
    {
        lens.scene.Instanced(models.cube, models.cubeFaces, fx.motes, MoteLook);
    }
}

// The frame, to the window. It's halved and blurred for what's out of focus,
// its bright parts are blurred again at a quarter of the size for the glow
// around them, and one frag puts the three together.
[Stage(Layers.Show)]
view Show(Lens lens)
{
    Draw.Blit(lens.scene.color, lens.halfB, Halve);
    Draw.Blit(lens.halfB.color, lens.half, Blur, BlurStep { along = float2(lens.pixel.x * 2, 0) });
    Draw.Blit(lens.half.color, lens.halfB, Blur, BlurStep { along = float2(0, lens.pixel.y * 2) });
    Draw.Blit(lens.halfB.color, lens.spread, Brights);
    Draw.Blit(lens.spread.color, lens.bright, Blur, BlurStep { along = float2(lens.pixel.x * 4, 0) });
    Draw.Blit(lens.bright.color, lens.spread, Blur, BlurStep { along = float2(0, lens.pixel.y * 4) });
    Draw.Blit(lens.spread.color, lens.bright, Blur, BlurStep { along = float2(lens.pixel.x * 8, 0) });
    Draw.Blit(lens.halfB.color, lens.half, Blur, BlurStep { along = float2(lens.pixel.x * 3, lens.pixel.y * 3) });
    Draw.Blit(lens.scene.color, Draw.window, Finish);
}

// Who's it, and which kid is this machine's, over everything: the tree hides
// neither.
[Stage(Layers.Hud)]
view Tags(Kid kid, Recess recess, Me me, Lens lens)
{
    Draw.SetScreen();
    var it = this == recess.it;
    var mine = this == me.self;
    if (!it && !mine) return;
    var floor = Math.LengthSq(kid.position) < SPIN_RADIUS * SPIN_RADIUS ? DECK : 0.0;
    var place = lens.scene.WorldToScreen(Up(kid.position, floor + (it ? 2.55 : 1.85)));
    var at = float2(place.x, place.y);
    var label = it ? (mine ? "YOU'RE IT" : "IT") : "YOU";
    Draw.Text(label, at + float2(1, 1.5), 13, Color(0, 0, 0, 0.55), Anchor.LowerCenter, Font.Bold);
    Draw.Text(label, at, 13, it ? Color(1, 0.42, 0.36) : Color.white, Anchor.LowerCenter, Font.Bold);
}

[Stage(Layers.Hud, 1)]
view Hud(Recess recess, Time time, Me me, Layout layout, mut Fx fx, Lens lens, query (Kid kid) all)
{
    Draw.SetScreen();
    var center = Screen.width * 0.5;
    var middle = float2(center, layout.middle);
    var quiet = Color(0.86, 0.9, 0.95);
    var ink = Color(0.1, 0.13, 0.2);
    var gold = Color(0.98, 0.78, 0.2);
    var red = Color(1, 0.42, 0.36);

    // What was said over the yard: "TAG!", where it happened
    mut var p = 0;
    while (p < fx.popups.count)
    {
        mut var popup = fx.popups[p];
        popup.age += fx.dt;
        if (popup.age >= 1.1)
        {
            fx.popups.RemoveAt(p);
            continue;
        }
        popup.position.y += fx.dt * 1.2;
        fx.popups[p] = popup;
        var place = lens.scene.WorldToScreen(popup.position);
        var shown = Math.Saturate((1.1 - popup.age) * 3);
        var size = 26 * (0.75 + Math.Saturate(popup.age * 8) * 0.25);
        Draw.Text(popup.text, float2(place.x + 1.5, place.y + 2), size, Color(0, 0, 0, 0.6 * shown), Anchor.MiddleCenter, Font.Bold);
        Draw.Text(popup.text, float2(place.x, place.y), size, Color(popup.tone.r, popup.tone.g, popup.tone.b, shown), Anchor.MiddleCenter, Font.Bold);
        p++;
    }

    // The scores' board, and over it the clock: a bar that runs down to the bell.
    mut var count = 0;
    mut var players = 0;
    mut var least = 100000.0;
    mut var itColor = -1;
    foreach (var row in all)
    {
        count += 1;
        if (!row.kid.bot) players += 1;
        least = Math.Min(least, row.kid.itTime);
        if (row.entity == recess.it) itColor = row.kid.color;
    }
    var slot = Math.Min(72, (Screen.width - 12) / Math.Max(count, 1));
    var ticks = recess.cheering ? 0 : Math.Max(0, recess.ends - time.tick);
    var left = ticks * 1.0 / (time.tickRate * ROUND);
    var seconds = (ticks + time.tickRate - 1) / time.tickRate;
    var wide = Math.Min(170, Screen.width - 210);
    var hurry = !recess.cheering && seconds <= 10;
    Draw.RoundRect(float2(center, 74), float2(Math.Max(slot * count + 16, wide + 16), 62), 14, Color(ink.r, ink.g, ink.b, 0.72));
    Draw.RoundRect(float2(center, 26), float2(wide, 22), 11, Color(ink.r, ink.g, ink.b, 0.72));
    if (left > 0.02)
    {
        Draw.RoundRect(float2(center - (wide - 6) * (1 - left) * 0.5, 26), float2((wide - 6) * left, 16), 8,
                       hurry ? red : Color(0.38, 0.72, 0.36));
    }
    Draw.Text($"{seconds}", float2(center, 26), 15, Color.white, Anchor.MiddleCenter, Font.Bold);

    // A chip for each kid: its color, its seconds as it, and the rounds it took.
    mut var x = (Screen.width - slot * count) * 0.5;
    foreach (var row in all)
    {
        var mid = x + slot * 0.5;
        var dot = float2(mid - 12, 65);
        var it = row.entity == recess.it;
        var whole = int(row.kid.itTime);
        if (row.kid.itTime <= least + 0.05) Draw.Circle(dot, 13, gold);
        Draw.Circle(dot, 10.5, ink);
        Draw.Circle(dot, 8.5, Tone(row.kid.color));
        Draw.Text($"{whole}s", float2(mid + 3, 65), 18, it ? red : Color.white, Anchor.MiddleLeft, Font.Bold);
        if (it) Draw.Text("IT", float2(mid, 79), 10, red, Anchor.UpperCenter, Font.Bold);
        else if (row.entity == me.self) Draw.Text("YOU", float2(mid, 79), 10, Color.white, Anchor.UpperCenter, Font.Bold);
        else if (row.kid.bot) Draw.Text("bot", float2(mid, 79), 10, quiet, Anchor.UpperCenter);
        var pips = Math.Min(row.kid.wins, 5);
        for (var i = 0; i < pips; i++)
        {
            Draw.Circle(float2(mid - (pips - 1) * 3.5 + i * 7, 96), 2.4, gold);
        }
        x += slot;
    }

    // A round starts with a call, and being caught is said out loud.
    var mineIt = me.self != default && me.self == recess.it;
    if (fx.round != recess.round)
    {
        fx.round = recess.round;
        fx.call = 1.3;
    }
    if (mineIt && !fx.wasIt)
    {
        fx.alarm = 1.4;
        Audio.Play(itClip, 0.6);
    }
    fx.wasIt = mineIt;
    fx.call = Math.Max(0, fx.call - fx.dt);
    fx.alarm = Math.Max(0, fx.alarm - fx.dt);
    if (fx.alarm > 0 || fx.call > 0)
    {
        var word = fx.alarm > 0 ? "YOU'RE IT!" : "RUN!";
        var showing = fx.alarm > 0 ? fx.alarm : fx.call;
        var shown = Math.Saturate(showing * 2.5);
        var size = Math.Min(44, Screen.width * 0.11) * (1.25 - Math.Saturate(showing - 0.9));
        var at = middle - float2(0, layout.middle * 0.3);
        Draw.Text(word, at + float2(2, 3), size, Color(0, 0, 0, 0.5 * shown), Anchor.MiddleCenter, Font.Bold);
        Draw.Text(word, at, size, fx.alarm > 0 ? Color(1, 0.42, 0.36, shown) : Color(1, 1, 1, shown), Anchor.MiddleCenter, Font.Bold);
    }

    // What's going on, and how to play, which a narrow window gets in smaller letters.
    var under = Screen.height - 40;
    var letters = Math.Min(1, Screen.width / 370);
    Draw.RoundRect(float2(center, under + 16), float2(Math.Min(Screen.width - 8, 420 * letters), 42), 12, Color(ink.r, ink.g, ink.b, 0.72));
    if (recess.cheering)
    {
        Draw.Text("Whoever was it the least takes the round", float2(center, under), 12.5 * letters, Color.white, Anchor.UpperCenter);
    }
    else if (players < 2 && fx.clock > 5)
    {
        Draw.Text("Bots fill in until friends join your room", float2(center, under), 12.5 * letters, Color.white, Anchor.UpperCenter);
    }
    else if (mineIt)
    {
        Draw.Text("You're it! Touch someone to pass it on", float2(center, under), 12.5 * letters, red, Anchor.UpperCenter, Font.Bold);
    }
    else if (itColor >= 0)
    {
        Draw.Text($"{ColorName(itColor)} is it. Whoever's it the least by the bell wins!", float2(center, under), 12.5 * letters,
                  Color.white, Anchor.UpperCenter);
    }
    Draw.Text("Move: WASD, arrows or press and hold. Dash: Space or the button",
              float2(center, under + 18), 11.5 * letters, quiet, Anchor.UpperCenter);

    if (!recess.cheering) return;
    mut var took = 0;
    mut var first = -1;
    for (var i = 0; i < COLORS; i++)
    {
        if ((recess.winners & (1 << i)) == 0) continue;
        took += 1;
        if (first < 0) first = i;
    }
    var mineWon = me.color >= 0 && (recess.winners & (1 << me.color)) != 0;
    var word = mineWon ? "YOU WIN!" : (took == 1 ? $"{ColorName(first)} WINS!" : "A DRAW!");
    var tone = mineWon ? Tone(me.color) : (took == 1 ? Tone(first) : Color.white);
    var big = Math.Min(44, Screen.width * 0.098);
    var box = Draw.MeasureText(word, big, Font.Bold);
    Draw.RoundRect(middle + float2(0, 8), box + float2(32, 48), 16, Color(ink.r, ink.g, ink.b, 0.88));
    Draw.Text(word, middle, big, tone, Anchor.MiddleCenter, Font.Bold);
    Draw.Text("The bell! Next round in a moment", middle + float2(0, box.y * 0.5 + 12), 13, Color.white, Anchor.MiddleCenter);
}

// The DASH button fills up again as the dash comes back.
[Stage(Layers.Hud, 2)]
view Button(Kid kid, Layout layout, with ownership)
{
    Draw.SetScreen();
    var ready = kid.cooldown <= 0;
    var filled = 1 - Math.Saturate(kid.cooldown / COOLDOWN);
    Draw.Circle(layout.button, layout.reach, Color(0.1, 0.13, 0.2, 0.72));
    Draw.Circle(layout.button, layout.reach - 4, ready ? Tone(kid.color) : Color(0.3, 0.33, 0.4));
    Draw.Arc(layout.button, layout.reach, -Math.PI * 0.5, Math.TAU * filled, 4, Color.white);
    Draw.Text("DASH", layout.button, layout.reach * 0.43, ready ? Color(0.1, 0.08, 0.08) : Color(0.7, 0.72, 0.78),
              Anchor.MiddleCenter, Font.Bold);
}

// The menu's button goes in the top right corner here: the bottom of the
// screen is the hints'.
override Rect Rooms.MenuButton(float2 screen)
{
    return Rect(screen.x - 92, 8, 84, 36);
}
