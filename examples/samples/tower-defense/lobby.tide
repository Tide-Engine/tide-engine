// The sample games share the same room flow. Their match keeps running behind
// these local pages; only this machine's controls wait while a page is open.
enum SampleLobbyPage { Playing, Title, Join, Room }

local singleton SampleLobby
{
    bool initialized;
    SampleLobbyPage page = SampleLobbyPage.Title;
    bool playing;
    bool joining;
    bool resume;
    string code;
    string message;
    float copied = 10;
}

bool SampleLobbyButton(Rect rect, string label, bool primary, bool enabled)
{
    mut var control = GUIControl { };
    GUI.Disabled(!enabled) { control = GUI.Control(rect); }
    var lit = control.hovered || control.focused;
    var accent = Color(0.42, 0.88, 0.80);
    var fill = primary ? (lit ? Color(0.61, 0.96, 0.87) : accent)
                       : (lit ? Color(0.19, 0.24, 0.28) : Color(0.12, 0.16, 0.20));
    var alpha = enabled ? 1.0 : 0.4;
    var center = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
    Draw.Shape(Shape { center = center, size = float2(rect.width, rect.height), radius = 10,
                         color = Color(fill.r, fill.g, fill.b, alpha), outline = control.focused ? 2.0 : 1.0,
                         outlineColor = control.focused ? Color.white : Color(0.32, 0.41, 0.46, alpha) });
    Draw.Text(label, center, 15, primary ? Color(0.04, 0.09, 0.11, alpha) : Color(0.91, 0.95, 0.96, alpha),
                Anchor.MiddleCenter, Font.Bold);
    return control.clicked;
}

// Every game's views run between Begin and Pages. Their playing gates suppress
// commands immediately; claims also hide the page's presses from input samples.
view SampleLobbyBegin(Session session, Devices devices, mut SampleLobby lobby)
{
    if (!lobby.initialized)
    {
        lobby.initialized = true;
        lobby.joining = !session.server && session.state == SessionState.Connecting;
        lobby.page = lobby.joining ? SampleLobbyPage.Join
                   : (session.server && session.open || !session.server && session.state == SessionState.Connected)
                     ? SampleLobbyPage.Playing : SampleLobbyPage.Title;
    }
    if (devices.keyboard.escape.down)
    {
        if (lobby.page == SampleLobbyPage.Playing)
        {
            lobby.page = SampleLobbyPage.Room;
            lobby.resume = true;
        }
        else if (lobby.page == SampleLobbyPage.Room) lobby.page = SampleLobbyPage.Playing;
        else if (lobby.page == SampleLobbyPage.Join)
        {
            if (lobby.joining) Session.Start(Main);
            lobby.joining = false;
            lobby.page = SampleLobbyPage.Title;
            lobby.message = "";
        }
    }
    // The press that closed a page must be let go before it can play the game.
    var held = devices.pointer.press.pressed || devices.keyboard.space.pressed || devices.keyboard.enter.pressed
            || devices.gamepad.buttonSouth.pressed;
    lobby.playing = lobby.page == SampleLobbyPage.Playing && session.state == SessionState.Connected
                 && (lobby.playing || !held);
    if (lobby.page != SampleLobbyPage.Playing)
    {
        GUI.ClaimPointer(Rect(0, 0, Screen.width, Screen.height));
        GUI.ClaimKeyboard();
    }
}

view SampleLobbyPages(Session session, Devices devices, mut SampleLobby lobby)
{
    Draw.SetScreen();
    Draw.SetClip();
    Draw.SetTransform();
    Draw.SetTint();
    Draw.SetBlend(Blend.Alpha);
    lobby.copied += Math.Min(Frame.dt, 0.1);
    if (lobby.page == SampleLobbyPage.Playing)
    {
        if (SampleLobbyButton(Rect(Screen.width - 92, 8, 84, 44), "MENU", false, true))
        {
            lobby.page = SampleLobbyPage.Room;
            lobby.resume = true;
            lobby.playing = false;
        }
        return;
    }

    GUI.Navigate();
    var screen = float2(Screen.width, Screen.height);
    var middle = screen * 0.5;
    var wide = Math.Min(screen.x - 32, 340);
    var left = middle.x - wide * 0.5;
    var connected = session.state == SessionState.Connected;
    var quiet = Color(0.70, 0.77, 0.81);
    var accent = Color(0.42, 0.88, 0.80);
    Draw.Rect(middle, screen, Color(0.025, 0.045, 0.06, 0.86));

    if (lobby.page == SampleLobbyPage.Title)
    {
        var y = Math.Max(16, (screen.y - 280) * 0.42);
        var titleSize = Math.Min(34.0, (wide - 12) / Math.Max(Draw.MeasureText(SampleTitle, 34, Font.Bold).x, 1) * 34);
        Draw.Text(SampleTitle, float2(middle.x, y + 18), titleSize, Color.white, Anchor.MiddleCenter, Font.Bold);
        Draw.Text("Play alone, or share a room with friends.", float2(middle.x, y + 50), 13, quiet, Anchor.MiddleCenter);
        var play = SampleLobbyButton(Rect(left, y + 76, wide, 52), "PLAY", true, connected);
        var host = SampleLobbyButton(Rect(left, y + 140, wide, 48), "HOST A ROOM", false, connected);
        var join = SampleLobbyButton(Rect(left, y + 200, wide, 48), "JOIN A ROOM", false, true);
        if (lobby.message != "") Draw.Text(lobby.message, float2(middle.x, y + 268), 12, Color(1, 0.61, 0.62), Anchor.MiddleCenter);
        if (play)
        {
            lobby.page = SampleLobbyPage.Playing;
            lobby.message = "";
        }
        if (host)
        {
            Session.Open();
            lobby.page = SampleLobbyPage.Room;
            lobby.resume = false;
            lobby.message = "";
        }
        if (join)
        {
            lobby.page = SampleLobbyPage.Join;
            lobby.message = "";
        }
    }
    else if (lobby.page == SampleLobbyPage.Join)
    {
        var y = Math.Max(16, (screen.y - 230) * 0.42);
        var busy = lobby.joining && session.state == SessionState.Connecting;
        Draw.Text(busy ? "JOINING" : "JOIN A ROOM", float2(middle.x, y + 14), 26, Color.white, Anchor.MiddleCenter, Font.Bold);
        if (busy)
        {
            Draw.Text($"Room {lobby.code.Trim()}", float2(middle.x, y + 80), 16, quiet, Anchor.MiddleCenter);
            if (SampleLobbyButton(Rect(left, y + 140, wide, 48), "CANCEL", false, true))
            {
                lobby.joining = false;
                lobby.page = SampleLobbyPage.Title;
                Session.Start(Main);
            }
        }
        else
        {
            mut var entered = false;
            GUI.Theme(GUITheme { text = Color.white, field = Color(0.08, 0.12, 0.16), fieldHot = Color(0.12, 0.17, 0.21),
                                 accent = accent, radius = 8 })
            {
                GUI.TextField(Rect(left, y + 56, wide - 108, 50), "", lobby.code, out entered);
            }
            lobby.code = lobby.code.ToUpper();
            var code = lobby.code.Trim();
            var go = SampleLobbyButton(Rect(left + wide - 100, y + 56, 100, 50), "JOIN", true, code != "")
                  || (entered && code != "");
            Draw.Text(lobby.message != "" ? lobby.message : "Type the code your friend is hosting.",
                        float2(middle.x, y + 125), 12, lobby.message != "" ? Color(1, 0.61, 0.62) : quiet, Anchor.MiddleCenter);
            var back = SampleLobbyButton(Rect(left, y + 160, wide, 48), "BACK", false, true);
            if (go)
            {
                lobby.message = "";
                lobby.joining = true;
                Session.Join(code);
            }
            if (back) lobby.page = SampleLobbyPage.Title;
        }
    }
    else
    {
        var y = Math.Max(16, (screen.y - 260) * 0.42);
        var alone = session.server && !session.open;
        Draw.Text(alone ? "PLAYING ALONE" : session.server ? "YOUR ROOM" : "ROOM", float2(middle.x, y + 14),
                    24, Color.white, Anchor.MiddleCenter, Font.Bold);
        if (alone)
        {
            if (SampleLobbyButton(Rect(left, y + 50, wide, 48), "INVITE FRIENDS", false, connected)) Session.Open();
        }
        else
        {
            Draw.Text(session.room != "" ? session.room : "Opening a room...", float2(left + 4, y + 74),
                        session.room != "" ? 30 : 16, accent, Anchor.MiddleLeft, Font.Bold);
            if (SampleLobbyButton(Rect(left + wide - 100, y + 50, 100, 48), lobby.copied < 1.5 ? "COPIED" : "COPY", false, session.room != ""))
            {
                Clipboard.Copy(session.room);
                lobby.copied = 0;
            }
        }
        var play = SampleLobbyButton(Rect(left, y + 126, wide, 52), lobby.resume ? "RESUME" : "PLAY", true, connected);
        var leave = SampleLobbyButton(Rect(left, y + 190, wide, 48), alone ? "BACK TO TITLE" : "LEAVE THE ROOM", false, true);
        if (play) lobby.page = SampleLobbyPage.Playing;
        if (leave)
        {
            if (!alone) Session.Start(Main);
            lobby.page = SampleLobbyPage.Title;
            lobby.message = "";
        }
    }
}

local event(Connected) SampleLobbyArrived(mut SampleLobby lobby)
{
    if (!lobby.joining) return;
    lobby.joining = false;
    lobby.page = SampleLobbyPage.Playing;
    lobby.playing = false;
}

local event(Disconnected gone) SampleLobbyDisconnected(mut SampleLobby lobby)
{
    if (gone.reason == DisconnectReason.Left) return;
    lobby.message = gone.reason == DisconnectReason.Failed ? (lobby.joining ? "No room has that code." : "Couldn't reach the room.")
                  : gone.reason == DisconnectReason.Refused ? "That room is full, or closed."
                  : gone.reason == DisconnectReason.TimedOut ? (lobby.joining ? "That room didn't answer." : "Lost the connection to the room.")
                  : gone.reason == DisconnectReason.Kicked ? (gone.message != "" ? gone.message : "The host sent you out of the room.")
                  : "The match ended.";
    lobby.initialized = true;
    lobby.page = lobby.joining ? SampleLobbyPage.Join : SampleLobbyPage.Title;
    lobby.joining = false;
    lobby.playing = false;
    Session.Start(Main);
}
