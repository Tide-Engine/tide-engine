// This machine's side of playing: which device aims, and the menus over the
// arena. The menus' buttons and cards are controls: the views here draw them
// from shapes, and the GUI handles their input, the pointer's, the keyboard's
// and a gamepad's alike.
local singleton Canvas
{
    float2 screenHalf;
    float scale = 1;
    float band = 78;  // Pixels above and under the arena, for the score and the keys
    bool gamepadAim;
    bool touchAim;
    bool handsOn; // A mouse, a keyboard or a gamepad was used: until then, a touchscreen is all there may be
}

local singleton DuelMenu
{
    string code;
    string message;
    int pickMatch = -1;
    int pickRound = -1;
    int picked = -1;
    int rematch = -1;
    int asked = -1; // The match a button last sent a command for, so it's sent once
    float turn;     // How far round the spinner is, in turns
}

string CardName(Card card)
{
    switch (card)
    {
        case Card.Vitality: return "VITALITY";
        case Card.RapidFire: return "RAPID FIRE";
        case Card.Scatter: return "SCATTER";
        case Card.Ricochet: return "RICOCHET";
        case Card.HeavyShot: return "HEAVY SHOT";
        case Card.SwiftFeet: return "SWIFT FEET";
        case Card.Featherweight: return "FEATHERWEIGHT";
        case Card.Mortar: return "MORTAR";
    }
    return "UPGRADE";
}

string CardEffect(Card card)
{
    switch (card)
    {
        case Card.Vitality: return "+35 max health";
        case Card.RapidFire: return "22% shorter reload";
        case Card.Scatter: return "+1 pellet a shot";
        case Card.Ricochet: return "+1 wall bounce";
        case Card.HeavyShot: return "30% stronger hits";
        case Card.SwiftFeet: return "15% faster movement";
        case Card.Featherweight: return "Shots drop 60% less";
        case Card.Mortar: return "45% stronger hits";
    }
    return "";
}

string CardFlavor(Card card)
{
    switch (card)
    {
        case Card.Vitality: return "Stay in the fight.";
        case Card.RapidFire: return "Keep the pressure on.";
        case Card.Scatter: return "15% less damage a pellet.";
        case Card.Ricochet: return "Find another angle.";
        case Card.HeavyShot: return "12% longer reload.";
        case Card.SwiftFeet: return "Be a moving target.";
        case Card.Featherweight: return "And fly 15% faster.";
        case Card.Mortar: return "Shots drop 60% faster.";
    }
    return "";
}

// A card's picture, from a few shapes in a box 100 across around (0, 0), which
// a transform puts at `at`, `size` across.
void CardIcon(Card card, float2 at, float size, Color color)
{
    var light = Mix(color, Color.white, 0.55);
    Draw2D.Transform(at, 0, size / 100)
    {
        if (card == Card.Vitality)
        {
            // A heart
            Draw2D.RoundRect(float2(0, 7), float2(47, 47), 7, Math.PI * 0.25, color);
            Draw2D.Circle(float2(-17, -12), 23.5, color);
            Draw2D.Circle(float2(17, -12), 23.5, color);
            Draw2D.Circle(float2(-20, -19), 7, Fade(Color.white, 0.75));
        }
        else if (card == Card.RapidFire)
        {
            // Three shots, one after another
            for (var i = 0; i < 3; i++)
            {
                var row = float2((i == 1 ? 10 : -6), (i - 1) * 27);
                Draw2D.Line(row + float2(-40, 0), row + float2(-14, 0), 5, Fade(color, 0.45));
                Draw2D.Line(row + float2(-2, 0), row + float2(26, 0), 15, color);
                Draw2D.Circle(row + float2(24, 0), 4.5, light);
            }
        }
        else if (card == Card.Scatter)
        {
            // Shots that fan out
            var from = float2(-34, 0);
            for (var i = -1; i <= 1; i++)
            {
                var way = float2(Math.Cos(i * 0.5), Math.Sin(i * 0.5));
                Draw2D.Line(from + way * 22, from + way * 52, 5, Fade(color, 0.45));
                Draw2D.Circle(from + way * 68, 10.5, color);
                Draw2D.Circle(from + way * 68, 4.5, light);
            }
            Draw2D.Circle(from, 11, color);
        }
        else if (card == Card.Ricochet)
        {
            // A shot that comes back off a wall
            Draw2D.RoundRect(float2(38, 0), float2(10, 84), 4, Fade(color, 0.6));
            Draw2D.Line(float2(-38, 32), float2(28, 2), 7, Fade(color, 0.5));
            Draw2D.Line(float2(28, 2), float2(-20, -30), 7, color);
            Draw2D.Circle(float2(-22, -31), 12, color);
            Draw2D.Circle(float2(-22, -31), 5, light);
            Draw2D.Circle(float2(30, 2), 7, Color.white);
        }
        else if (card == Card.HeavyShot)
        {
            // One big shot
            Draw2D.WireCircle(float2(0), 42, 5, Fade(color, 0.55));
            Draw2D.Circle(float2(0), 29, color);
            Draw2D.Circle(float2(-9, -10), 9, light);
        }
        else if (card == Card.SwiftFeet)
        {
            // Onwards
            for (var i = 0; i < 2; i++)
            {
                var tip = float2(i * 34 - 2, 0);
                var tint = i == 0 ? Fade(color, 0.55) : color;
                Draw2D.Line(tip + float2(-26, -27), tip, 12, tint);
                Draw2D.Line(tip + float2(-26, 27), tip, 12, tint);
            }
        }
        else if (card == Card.Featherweight)
        {
            // A shot that flies straight, over the arc it would have dropped along
            for (var i = 0; i < 5; i++)
            {
                var along = i / 4.0;
                Draw2D.Circle(float2(-36 + 62 * along, 4 + 34 * along * along), 3.6, Fade(color, 0.4));
            }
            Draw2D.Line(float2(-38, -12), float2(8, -12), 6, Fade(color, 0.5));
            Draw2D.Line(float2(12, -12), float2(34, -12), 16, color);
            Draw2D.Circle(float2(32, -12), 5, light);
        }
        else
        {
            // A shell lobbed high
            for (var i = 0; i < 5; i++)
            {
                var along = i / 5.0;
                Draw2D.Circle(float2(-38 + 70 * along, 24 - 220 * along * (1 - along)), (3.5 + i * 0.8),
                     Fade(color, 0.35 + along * 0.4));
            }
            Draw2D.Circle(float2(30, 22), 17, color);
            Draw2D.Circle(float2(25, 16), 6, light);
        }
    }
}

float2 Middle(Rect rect)
{
    return float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
}

// A button of the duel's own, which its view writes its label over: a control,
// whose input the GUI handles, drawn here. It's lit under the pointer and with
// the focus, which also shows as a light outline. Returns whether it was
// clicked.
bool Pill(Rect rect, Color color, bool bold, bool enabled)
{
    mut var pill = GUIControl { };
    GUI.Disabled(!enabled)
    {
        pill = GUI.Control(rect);
    }
    var over = pill.hovered || pill.focused;
    var held = pill.pressed && pill.hovered;
    var center = Middle(rect) + float2(0, held ? 1.5 : 0);
    var size = float2(rect.width, rect.height);
    var radius = Math.Min(rect.height * 0.5, 13);
    if (bold)
    {
        // One that can't be pressed is faint, all of it
        Draw.Tint(Fade(Color.white, enabled ? 1 : 0.4))
        {
            GlowBox(center, size, radius, over ? 22 : 12, Fade(color, over ? 0.5 : 0.22));
            Panel(center, size, radius, Shade(color, over ? 0.42 : 0.24), Shade(color, over ? 0 : -0.14),
                  pill.focused ? 2.4 : 1.6, pill.focused ? Color.white : Shade(color, 0.6));
        }
    }
    else
    {
        if (over) GlowBox(center, size, radius, 14, Fade(color, 0.3));
        // One that can't be pressed is darker, and still hides what's behind it
        Panel(center, size, radius, Color(0.15, 0.19, 0.32, 0.96) * (enabled ? 1 : 0.62),
              Color(0.075, 0.1, 0.19, 0.96) * (enabled ? 1 : 0.62), pill.focused ? 2.2 : 1.5,
              pill.focused ? UI_INK : over ? color : Color(0.3, 0.39, 0.58) * (enabled ? 1 : 0.6));
    }
    return pill.clicked;
}

[Stage(PaintStages.Prepare, 20)]
view RememberAimDevice(Devices devices, mut Canvas canvas)
{
    var pad = devices.gamepad;
    var keys = devices.keyboard;
    var padUsed = Math.Abs(pad.leftStick.x) > 0.15 || Math.LengthSq(pad.rightStick) > 0.04
               || pad.buttonSouth.pressed || pad.rightTrigger > 0.4
               || pad.leftTrigger > 0.4 || pad.leftShoulder.pressed;
    var mouseUsed = Math.LengthSq(devices.mouse.delta) > 0
                 || devices.mouse.left.down || devices.mouse.right.down;
    var keyboardUsed = keys.a.down || keys.d.down || keys.leftArrow.down || keys.rightArrow.down
                    || keys.space.down || keys.w.down || keys.upArrow.down
                    || keys.leftShift.down || keys.rightShift.down;
    if (padUsed || mouseUsed || keyboardUsed) canvas.handsOn = true;
    if (padUsed)
    {
        canvas.gamepadAim = true;
        canvas.touchAim = false;
    }
    if (mouseUsed || keyboardUsed)
    {
        canvas.gamepadAim = false;
        canvas.touchAim = false;
    }
    foreach (var touch in devices.touchscreen.touches)
    {
        if (!touch.press.pressed) continue;
        canvas.gamepadAim = false;
        canvas.touchAim = true;
    }
}

// Where a match starts: nobody plays until someone here says how. Behind it,
// the fighters duel by themselves.
[Stage(PaintStages.Menu)]
view PaintMenu(Duel duel, Session session, Devices devices, Fx fx, mut DuelMenu menu)
{
    if (!duel.attract) return;
    Draw2D.SetScreen();
    // A menu, though a match goes on behind it: the arrows and a gamepad move between its buttons
    GUI.Navigate();
    var screen = float2(Screen.width, Screen.height);
    var middle = screen * 0.5;
    var short = screen.y < 470;
    var wide = Math.Min(screen.x - 28, 360);
    var left = middle.x - wide * 0.5;
    var busy = session.state == SessionState.Connecting;
    var hosting = session.server && session.room != "";
    var title = short ? 44 : 88;
    var gap = short ? 7 : 12;
    var playHeight = short ? 38 : 54;
    var rowHeight = short ? 32 : 42;
    var under = short ? 6 : 34;
    var total = title + under + playHeight + gap + rowHeight + gap + rowHeight + 26;
    mut var y = Math.Max(6, (screen.y - total) * 0.5);

    Draw2D.Rect(middle, screen, Color(0.012, 0.018, 0.05, 0.24));
    Inset(middle, screen, 0, Math.Max(screen.x, screen.y) * 0.3, Color(0, 0.004, 0.02, 0.45));
    GlowBox(float2(middle.x, y + total * 0.5), float2(wide - 40, total - 90), 40, 100, Color(0.012, 0.018, 0.05, 0.8));

    var titleAt = float2(middle.x, y + title * 0.5);
    y += title + under;
    var play = Rect(left, y, wide, playHeight);
    y += playHeight + gap;
    var invite = Rect(left, y, wide, rowHeight);
    y += rowHeight + gap;
    var frame = Rect(left, y, wide - 94, rowHeight);
    var field = Rect(frame.x + 3, frame.y + 3, frame.width - 6, frame.height - 6);
    var join = Rect(left + wide - 88, y, 88, rowHeight);
    var note = float2(middle.x, y + rowHeight + 15);
    var copy = Rect(invite.x + invite.width - 78, invite.y + 5, 72, invite.height - 10);

    var playNow = Pill(play, UI_BLUE, true, !busy);
    mut var inviteNow = false;
    mut var copyNow = false;
    if (hosting)
    {
        Panel(Middle(invite), float2(invite.width, invite.height), 13, Color(0.1, 0.085, 0.1, 0.96),
              Color(0.07, 0.06, 0.09, 0.96), 1.5, Fade(UI_ORANGE, 0.75));
        copyNow = Pill(copy, UI_ORANGE, false, true);
    }
    else
    {
        inviteNow = Pill(invite, UI_ORANGE, false, !busy && session.server && !session.open);
    }
    // The room's code is typed into a field of the GUI's, in the menu's colors:
    // its frame is drawn here, under it
    Panel(Middle(frame), float2(frame.width, frame.height), 13, FIELD_INK, FIELD_INK, 1.5, Color(0.3, 0.39, 0.58));
    GUI.Theme(GUITheme { text = UI_INK, field = FIELD_INK, fieldHot = Color(0.07, 0.09, 0.17), accent = UI_BLUE, radius = 10 })
    {
        GUI.Disabled(busy)
        {
            GUI.TextField(field, "", menu.code);
        }
    }
    var joinNow = Pill(join, UI_INK, false, !busy && menu.code.Trim() != "");

    // The title, with each side's color off to its side
    var bob = Math.Sin(fx.now * 1.6) * 2;
    Draw2D.Text("DUEL", titleAt + float2(-4, 2 + bob), title, Fade(UI_BLUE, 0.9), Anchor.MiddleCenter, Font.Bold);
    Draw2D.Text("DUEL", titleAt + float2(4, -2 + bob), title, Fade(UI_ORANGE, 0.9), Anchor.MiddleCenter, Font.Bold);
    Draw2D.Text("DUEL", titleAt + float2(0, bob), title, Color.white, Anchor.MiddleCenter, Font.Bold);
    if (!short) Draw2D.Text("FIRST TO FIVE ROUNDS WINS", titleAt + float2(0, title * 0.5 + 12), 11, UI_MUTED, Anchor.MiddleCenter);

    Draw2D.Text("PRACTICE", Middle(play) + float2(0, short ? 0 : -7), short ? 15 : 19, UI_OUTLINE, Anchor.MiddleCenter);
    if (!short) Draw2D.Text("against a bot", Middle(play) + float2(0, 12), 11, Fade(UI_OUTLINE, 0.72), Anchor.MiddleCenter);
    if (hosting)
    {
        Draw2D.Text("ROOM", float2(invite.x + 16, invite.y + invite.height * 0.5), 10, UI_MUTED, Anchor.MiddleLeft);
        Draw2D.Text(session.room, float2(invite.x + 56, invite.y + invite.height * 0.5), 20, UI_INK, Anchor.MiddleLeft);
        Draw2D.Text("COPY", Middle(copy), 11, UI_INK, Anchor.MiddleCenter);
    }
    else
    {
        Draw2D.Text(session.server && session.open ? "OPENING A ROOM..." : "INVITE A FRIEND", Middle(invite), short ? 12 : 14,
              Fade(UI_INK, busy ? 0.4 : 1), Anchor.MiddleCenter);
    }
    Draw2D.Text("JOIN", Middle(join), short ? 12 : 14, Fade(UI_INK, !busy && menu.code.Trim() != "" ? 1 : 0.4), Anchor.MiddleCenter);
    if (busy) Draw2D.Text("Connecting...", note, 11, UI_MUTED, Anchor.MiddleCenter);
    else if (menu.message != "") Draw2D.Text(menu.message, note, 11, UI_ORANGE, Anchor.MiddleCenter);
    else if (hosting) Draw2D.Text("Send the code to a friend. You duel when they join.", note, 11, UI_MUTED, Anchor.MiddleCenter);
    else Draw2D.Text("Got a friend's code? Type it there and join.", note, 11, UI_MUTED, Anchor.MiddleCenter);

    // With no button chosen, Enter and a gamepad's south button are PRACTICE's
    var start = devices.keyboard.enter.down || devices.gamepad.buttonSouth.down || devices.gamepad.start.down;
    if ((playNow || start) && !busy && menu.asked != duel.match)
    {
        Send(Practice { match = duel.match });
        menu.asked = duel.match;
    }
    if (inviteNow)
    {
        menu.message = "";
        Session.Open();
    }
    if (copyNow) Clipboard.Copy(session.room);
    if (joinNow)
    {
        menu.message = "";
        Session.Join(menu.code.Trim().ToUpper());
    }
}

// In a match, the way out of it: back to the menu from practice, and with two
// players, leaving.
[Stage(PaintStages.Menu, 5)]
view PaintCorner(Duel duel, Session session, Devices devices, mut DuelMenu menu)
{
    if (duel.attract || duel.phase == Phase.Draft || duel.phase == Phase.Finished) return;
    Draw2D.SetScreen();
    var slim = Screen.height < 640 && Screen.width >= 720;
    var two = duel.bluePlayer != default && duel.orangePlayer != default;
    // In the top right corner: on a low screen, under the health bar that's there.
    // The bottom right one is the engine's, for its stats (the `stats` setting).
    var rect = slim ? Rect(Screen.width - 82, 37, 64, 24)
                    : Rect(Screen.width - 84, Screen.width < 720 ? 6 : 11, 68, 26);
    var pressed = Pill(rect, UI_INK, false, session.state == SessionState.Connected);
    Draw2D.Text(two ? "LEAVE" : "MENU", Middle(rect), 10, UI_INK, Anchor.MiddleCenter);
    if (session.room != "" && Screen.width >= 720 && !slim)
    {
        var room = "ROOM " + session.room;
        Draw2D.Text(room, float2(rect.x - 12, rect.y + 7), 11, UI_MUTED, Anchor.UpperRight);
    }
    if (two)
    {
        if (pressed) Session.Start(Main);
    }
    else if ((pressed || devices.keyboard.escape.down) && menu.asked != duel.match)
    {
        Send(ToMenu { match = duel.match });
        menu.asked = duel.match;
    }
}

// One of the three cards to pick from, drawn around (0, 0) as it is when it
// has landed: the draft puts it in its place, turns it and fades it with the
// draw settings (PaintDraft).
void DraftCard(Card card, int slot, float2 size, bool lit, bool rows)
{
    var accent = CardColor(card);
    var top = -size.y * 0.5;
    var left = -size.x * 0.5;
    if (rows)
    {
        // A strip: its picture, then its name and what it does
        var spot = float2(left + size.y * 0.5 + 2, 0);
        var text = left + size.y + 10;
        var tight = size.y < 62;
        if (lit) GlowBox(float2(0), size, 12, 20, Fade(accent, 0.4));
        Panel(float2(0), size, 12, Color(0.105, 0.135, 0.235, 0.98), Color(0.05, 0.065, 0.13, 0.98),
              lit ? 2.2 : 1.4, lit ? accent : Shade(accent, -0.5));
        Oval(spot, float2(size.y * 0.38), Color(0.06, 0.08, 0.15), Color(0.03, 0.04, 0.09), 1.5, Fade(accent, 0.7));
        CardIcon(card, spot, size.y * 0.5, accent);
        Draw2D.Text(CardName(card), float2(text, tight ? -15 : -19), tight ? 13 : 16, UI_INK);
        Draw2D.Text(CardEffect(card), float2(text, tight ? 1 : 2), tight ? 10 : 12, Mix(accent, Color.white, 0.45));
        Panel(float2(left + size.x - 22, 0), float2(24, 24), 6, Color(0.14, 0.18, 0.3), Color(0.08, 0.1, 0.19), 1.3,
              lit ? accent : Color(0.3, 0.39, 0.58));
        Draw2D.Text($"{slot + 1}", float2(left + size.x - 22, 0), 12, UI_INK, Anchor.MiddleCenter);
        return;
    }

    var badge = float2(0, top + size.y * 0.27);
    var badgeSize = Math.Min(54, size.y * 0.17);
    var pick = float2(0, top + size.y - 34);
    var roomy = size.y >= 290;
    var name = badge.y + badgeSize + (roomy ? 34 : 24);
    GlowBox(float2(0, 12), size - float2(30, 20), 18, 34, Color(0, 0.004, 0.02, 0.55));
    if (lit) GlowBox(float2(0), size, 18, 30, Fade(accent, 0.42));
    Panel(float2(0), size, 18, Color(0.11, 0.14, 0.245, 0.985), Color(0.045, 0.058, 0.118, 0.985),
          lit ? 2.6 : 1.5, lit ? accent : Shade(accent, -0.5));
    Draw2D.RoundRect(float2(0, top + 9), float2(size.x - 44, 4), 2, Fade(accent, lit ? 1 : 0.7));
    Glow(badge, badgeSize * 0.6, badgeSize * 1.1, Fade(accent, lit ? 0.3 : 0.16));
    Oval(badge, float2(badgeSize), Color(0.065, 0.085, 0.16), Color(0.03, 0.04, 0.09), 2, Fade(accent, 0.8));
    CardIcon(card, badge, badgeSize * 1.25, accent);
    Draw2D.Text(CardName(card), float2(0, name), size.x < 200 ? 16 : 20, UI_INK, Anchor.MiddleCenter);
    Draw2D.Text(CardEffect(card), float2(0, name + 28), size.x < 200 ? 12 : 14, Mix(accent, Color.white, 0.45), Anchor.MiddleCenter);
    if (roomy) Draw2D.Text(CardFlavor(card), float2(0, name + 50), 12, UI_MUTED, Anchor.MiddleCenter);

    // Its button, with the key that picks it
    Panel(pick, float2(size.x - 40, 38), 11, lit ? Shade(accent, 0.3) : Color(0.15, 0.19, 0.32),
          lit ? Shade(accent, -0.1) : Color(0.08, 0.105, 0.2), 1.5, lit ? Shade(accent, 0.6) : Color(0.3, 0.39, 0.58));
    Draw2D.RoundRect(pick + float2(-size.x * 0.5 + 44, 0), float2(22, 22), 6, Color(0.03, 0.04, 0.09, 0.85));
    Draw2D.Text($"{slot + 1}", pick + float2(-size.x * 0.5 + 44, 0), 12, UI_INK, Anchor.MiddleCenter);
    Draw2D.Text("PICK", pick + float2(8, 0), 13, lit ? UI_OUTLINE : UI_INK, Anchor.MiddleCenter);
}

// The round's loser picks an upgrade: a card by a click or a tap, by its
// number, or with the arrows or a gamepad and Enter. Each card is a control.
[Stage(PaintStages.Menu, 10)]
view PaintDraft(Fighter fighter, Duel duel, Session session, Devices devices, Flow flow,
    mut DuelMenu menu, mut Fx fx, with ownership)
{
    if (duel.attract || duel.phase != Phase.Draft || fighter.side != duel.draftSide)
    {
        menu.pickMatch = -1;
        menu.pickRound = -1;
        menu.picked = -1;
        return;
    }
    Draw2D.SetScreen();
    var screen = float2(Screen.width, Screen.height);
    var middle = screen * 0.5;
    // The whole screen is the draft's: a click between two cards isn't a shot
    GUI.ClaimPointer(Rect(0, 0, screen.x, screen.y));
    GUI.Navigate();
    // The round's result has the screen first
    var age = flow.age - 1;
    if (age < 0) return;

    var color = FighterColor(fighter.side);
    var online = session.state == SessionState.Connected;
    var pending = menu.pickMatch == duel.match && menu.pickRound == duel.round;
    var rows = screen.x < 700 || screen.y < 430;
    var tiny = screen.y < 300;
    var gap = rows ? (tiny ? 5 : 9) : 18;
    mut var size = float2(0);
    mut var first = float2(0);
    mut var stride = float2(0);
    if (rows)
    {
        var head = tiny ? 30 : 68;
        var foot = tiny ? 6 : 26;
        size = float2(Math.Min(screen.x - 24, 470), Math.Clamp((screen.y - head - foot - gap * 2) / 3, 38, 100));
        first = float2(middle.x, head + (screen.y - head - foot - size.y * 3 - gap * 2) * 0.5 + size.y * 0.5);
        stride = float2(0, size.y + gap);
    }
    else
    {
        size = float2(Math.Min(244, (screen.x - 56 - gap * 2) / 3), Math.Min(330, screen.y - 176));
        first = float2(middle.x - size.x - gap, middle.y + 24);
        stride = float2(size.x + gap, 0);
    }

    // A card's number picks it, whichever card the keys are on
    var keys = devices.keyboard;
    mut var chosen = -1;
    if (keys.digit1.down) chosen = 0;
    if (keys.digit2.down) chosen = 1;
    if (keys.digit3.down) chosen = 2;
    // The pointer, the arrows and a gamepad are the GUI's to follow: a card is
    // lit while one of them is on it. Once one is picked, they're done.
    mut var lit = -1;
    GUI.Disabled(!online || pending)
    {
        for (var slot = 0; slot < 3; slot++)
        {
            var at = first + stride * slot;
            var card = GUI.Control(Rect(at.x - size.x * 0.5, at.y - size.y * 0.5, size.x, size.y));
            if (card.hovered && lit < 0) lit = slot;
            if (card.focused) lit = slot; // The keys' card, when the pointer rests on another
            if (card.clicked) chosen = slot;
        }
    }
    if (chosen >= 0 && online && !pending && age > 0.25)
    {
        this.Send(ChooseCard { round = duel.round, slot = chosen });
        menu.pickMatch = duel.match;
        menu.pickRound = duel.round;
        menu.picked = chosen;
        Confetti(fx, first + stride * chosen, 30, 520, CardColor(Offer(duel, chosen)));
    }
    var waiting = menu.pickMatch == duel.match && menu.pickRound == duel.round;

    // The draft fades in over the fight, and its cards with it
    Draw.Tint(Fade(Color.white, EaseOut(age / 0.25)))
    {
        Draw2D.Rect(middle, screen, Color(0.012, 0.018, 0.05, 0.74));
        Inset(middle, screen, 0, Math.Max(screen.x, screen.y) * 0.4, Color(0, 0.004, 0.02, 0.5));
        for (var slot = 0; slot < 3; slot++)
        {
            // Each card comes up a moment after the one before it, the outer ones
            // turning upright as they land. The one that's lit lifts, and once one
            // is picked the others go faint.
            var come = (age - 0.05 - slot * 0.07) / 0.36;
            if (come <= 0) continue;
            var bright = waiting ? menu.picked == slot : lit == slot;
            var short = 1 - EaseBack(come); // How far it has left to come: under 0 for a moment, as it goes past
            var at = first + stride * slot + float2(0, short * 46 - (bright && !rows ? 9 : 0));
            var shown = Math.Saturate(come * 2) * (waiting && menu.picked != slot ? 0.3 : 1);
            Draw.Tint(Fade(Color.white, shown)),
            Draw2D.Transform(at, short * (slot - 1) * (rows ? 0.03 : 0.1))
            {
                DraftCard(Offer(duel, slot), slot, size, bright, rows);
            }
        }

        var heading = rows ? first.y - size.y * 0.5 - (tiny ? 16 : 44) : first.y - size.y * 0.5 - 62;
        Draw2D.Text(screen.x < 520 ? "PICK AN UPGRADE" : "CHOOSE YOUR UPGRADE", float2(middle.x, heading), rows ? (tiny ? 15 : 20) : 28,
              color, Anchor.MiddleCenter);
        if (!tiny)
        {
            Draw2D.Text(screen.x < 520 ? "It stays for the match." : "You lost the round, so you grow stronger. It stays for the match.",
                  float2(middle.x, heading + (rows ? 22 : 30)), rows ? 11 : 13, UI_MUTED, Anchor.MiddleCenter);
            var last = first.y + stride.y * 2 + size.y * 0.5 + (rows ? 14 : 28);
            var note = !online ? "Reconnecting. Your match will resume." : waiting ? "Locked in." : rows ? "Tap a card, or press 1, 2 or 3."
                     : devices.gamepad.connected ? "Pick a card with the d-pad, or click one." : "Click a card, or press 1, 2 or 3.";
            // Low on the screen, it keeps clear of the bottom right corner, where the stats are
            var half = Draw2D.MeasureText(note, 12).x * 0.5;
            var at = last > screen.y - 44 ? Math.Min(middle.x, screen.x - StatsCorner(session) - half) : middle.x;
            Draw2D.Text(note, float2(at, last), 12, UI_MUTED, Anchor.MiddleCenter);
        }
    }
}

[Stage(PaintStages.Menu, 10)]
view PaintResult(Duel duel, Session session, Devices devices, Flow flow, mut DuelMenu menu, mut Fx fx)
{
    if (duel.attract || duel.phase != Phase.Finished)
    {
        menu.rematch = -1;
        return;
    }
    Draw2D.SetScreen();
    var screen = float2(Screen.width, Screen.height);
    var middle = screen * 0.5;
    GUI.ClaimPointer(Rect(0, 0, screen.x, screen.y));
    GUI.Navigate();
    var age = flow.age - 0.9;
    if (age < 0) return;

    var blueWon = duel.scoreBlue >= WINS;
    var tint = blueWon ? UI_BLUE : UI_ORANGE;
    var winner = blueWon ? duel.bluePlayer : duel.orangePlayer;
    var two = duel.bluePlayer != default && duel.orangePlayer != default;
    var online = session.state == SessionState.Connected;
    var big = screen.x >= 620 && screen.y >= 420;
    var enter = EaseOut(age / 0.3);
    // Paper for the winner, now and then
    if (Math.Floor(fx.now * 2.2) != Math.Floor((fx.now - fx.dt) * 2.2) || age < fx.dt * 1.5)
    {
        var place = fx.random.NextFloat();
        Confetti(fx, float2(screen.x * (0.15 + place * 0.7), screen.y * 0.3), 26, 460, tint);
    }

    var wide = Math.Min(screen.x - 32, 300);
    var again = Rect(middle.x - wide * 0.5, middle.y + (big ? 62 : 40), wide, big ? 50 : 40);
    var leave = Rect(middle.x - wide * 0.5, again.y + again.height + 10, wide, big ? 40 : 34);
    var waiting = menu.rematch == duel.match;
    var words = SideName(blueWon ? 0 : 1) + " WINS";
    var size = Math.Round((big ? 64 : 38) * (1 + 0.4 * Math.Max(0, 1 - age * 6)) * 0.5) * 2;
    var at = middle + float2(0, big ? -66 : -52);
    mut var againNow = false;
    mut var leaveNow = false;
    // All of it fades in over the fight, its buttons too
    Draw.Tint(Fade(Color.white, enter))
    {
        Draw2D.Rect(middle, screen, Color(0.012, 0.018, 0.05, 0.72));
        Inset(middle, screen, 0, Math.Max(screen.x, screen.y) * 0.3, Fade(Shade(tint, -0.55), 0.42));
        GlowBox(middle + float2(0, -10), float2(Math.Min(screen.x, 560), 150), 60, 120, Fade(tint, 0.13));
        againNow = Pill(again, tint, true, online && !waiting);
        leaveNow = Pill(leave, UI_INK, false, online);

        Draw2D.Text(winner == session.player ? "VICTORY" : two ? "DEFEAT" : "THE BOT TAKES IT", at + float2(0, big ? -52 : -34),
              big ? 13 : 11, UI_MUTED, Anchor.MiddleCenter);
        Draw2D.Text(words, at + float2(-4, 3), size, Shade(tint, -0.5), Anchor.MiddleCenter, Font.Bold);
        Draw2D.Text(words, at, size, Mix(tint, Color.white, 0.3), Anchor.MiddleCenter, Font.Bold);
        Draw2D.Text($"{duel.scoreBlue}  -  {duel.scoreOrange}", middle + float2(0, big ? 4 : -6), big ? 26 : 20, UI_INK, Anchor.MiddleCenter);
        Draw2D.Text(waiting ? "STARTING..." : "PLAY AGAIN", Middle(again), big ? 17 : 14, Fade(UI_OUTLINE, online && !waiting ? 1 : 0.5), Anchor.MiddleCenter);
        Draw2D.Text(two ? "LEAVE" : "BACK TO THE MENU", Middle(leave), big ? 13 : 12, Fade(UI_INK, online ? 1 : 0.4), Anchor.MiddleCenter);
        if (!online) Draw2D.Text("Reconnecting before the rematch...", float2(middle.x, leave.y + leave.height + 16), 11, UI_MUTED, Anchor.MiddleCenter);
    }

    // With no button chosen, Enter, Space and a gamepad's south button are PLAY AGAIN's
    var start = devices.keyboard.enter.down || devices.keyboard.space.down || devices.gamepad.buttonSouth.down;
    if ((againNow || start) && online && !waiting && age > 0.3)
    {
        Send(Rematch { match = duel.match });
        menu.rematch = duel.match;
    }
    if (leaveNow && two) Session.Start(Main);
    else if (leaveNow && menu.asked != duel.match)
    {
        Send(ToMenu { match = duel.match });
        menu.asked = duel.match;
    }
}

// Joining another machine's match, or finding this one again after its host left.
[Stage(PaintStages.Menu, 20)]
view PaintConnecting(Session session, mut DuelMenu menu)
{
    if (session.state != SessionState.Connecting) return;
    Draw2D.SetScreen();
    GUI.Navigate();
    var screen = float2(Screen.width, Screen.height);
    var middle = screen * 0.5;
    menu.turn = Math.Frac(menu.turn + Frame.dt * 0.72);
    if (session.player == default)
    {
        // No match is behind it yet: only the backdrop, which BeginFrame draws with no match too
        var wide = Math.Min(screen.x - 24, 380);
        var back = Rect(middle.x - 95, middle.y + 22, 190, 40);
        Draw2D.Rect(middle, screen, Color(0.012, 0.018, 0.05, 0.6));
        GlowBox(middle + float2(0, 10), float2(wide - 30, 130), 20, 40, Color(0, 0.004, 0.02, 0.6));
        Panel(middle, float2(wide, 170), 18, Color(0.11, 0.14, 0.245, 0.98), Color(0.045, 0.058, 0.118, 0.98), 1.5,
              Color(0.3, 0.39, 0.58));
        Draw2D.Arc(middle + float2(-wide * 0.5 + 40, -42), 11, menu.turn * Math.TAU, Math.TAU * 0.7, 3.2, UI_BLUE);
        var backNow = Pill(back, UI_INK, false, true);
        Draw2D.Text("CONNECTING", float2(middle.x - wide * 0.5 + 64, middle.y - 54), 22, UI_INK);
        Draw2D.Text(menu.code == "" ? "Waiting for the match" : "Room " + menu.code.Trim().ToUpper().Substring(0, 12),
                    float2(middle.x - wide * 0.5 + 64, middle.y - 24), 13, UI_MUTED);
        Draw2D.Text("BACK TO THE MENU", Middle(back), 12, UI_INK, Anchor.MiddleCenter);
        if (backNow) Session.Start(Main);
    }
    else
    {
        // After the words, and clear of the bottom right corner, where the stats are
        var back = Rect(164, screen.y - 37, 152, 30);
        Panel(float2(middle.x, screen.y - 22), float2(screen.x + 4, 46), 0, Color(0.05, 0.065, 0.13, 0.96),
              Color(0.03, 0.04, 0.09, 0.96), 1.5, Color(0.3, 0.39, 0.58));
        Draw2D.Arc(float2(26, screen.y - 22), 8, menu.turn * Math.TAU, Math.TAU * 0.7, 2.6, UI_BLUE);
        var backNow = Pill(back, UI_INK, false, true);
        Draw2D.Text("Reconnecting...", float2(44, screen.y - 29), 13, UI_MUTED);
        Draw2D.Text("BACK TO THE MENU", Middle(back), 11, UI_INK, Anchor.MiddleCenter);
        if (backNow) Session.Start(Main);
    }
}

local event(Connected) ResetSubmittedActions(mut DuelMenu menu)
{
    menu.pickMatch = -1;
    menu.pickRound = -1;
    menu.rematch = -1;
    menu.asked = -1;
}

local event(Disconnected gone) ReturnToMenu(mut DuelMenu menu)
{
    if (gone.reason == DisconnectReason.Left) return;
    menu.message = gone.reason == DisconnectReason.Refused ? "That room is full, or its build differs."
                   : gone.reason == DisconnectReason.TimedOut ? "That room didn't answer."
                   : gone.reason == DisconnectReason.Kicked ? gone.message
                   : "Couldn't join that room.";
    Session.Start(Main);
}
