// What makes the duel feel alive is this machine's own: sparks, rings, trails,
// a camera that shakes. None of it is in the match. The match says what
// happens in it, and this machine's handlers of that add an effect here
// (heard.tide).
enum PaintStages { Prepare, Arena, Platforms, Fighters, Bullets, Effects, Light, Hud, Menu, Overlay }

enum BitKind { Streak, Dot, Puff, Chunk, Shell }

// Something small that flies, fades and is gone.
struct Bit
{
    float2 position;
    float2 velocity;
    Color color = Color.white;
    float age;
    float life = 0.4;
    float size = 3;
    float gravity;
    float drag;
    float spin;
    BitKind kind;
}

// A ring that grows.
struct Wave
{
    float2 center;
    Color color = Color.white;
    float age;
    float life = 0.4;
    float from;
    float to = 40;
    float width = 3;
}

// A piece of a shot's trail.
struct Streak
{
    float2 from;
    float2 to;
    Color color = Color.white;
    float age;
    float life = 0.26;
    float width = 7;
}

// A number that floats up from a hit.
struct Label
{
    float2 position;
    Color color = Color.white;
    float age;
    float life = 0.9;
    int amount;
}

local singleton Fx
{
    float dt;        // Seconds this frame's effects move on by
    float now;       // Seconds of frames drawn, which never go back
    Random random;   // What rolls the effects: this machine's own, as nothing of them is the match's
    float trauma;    // How hard the camera shakes, 0 to 1
    float calm = 1;  // How much of that shows: less while the fight is only the menu's scenery
    float2 shake;    // Where that puts it this frame
    float kick;      // A zoom that eases back
    float flash;     // The whole screen lit, fading
    Color flashColor = Color.white;
    float hurt;      // The screen's edges lit when this machine's fighter is hit
    List<Bit> bits;
    List<Bit> confetti; // In the screen's pixels, over the menus
    List<Wave> waves;
    List<Streak> streaks;
    List<Label> labels;
}

// A corner of the backdrop's quad, from (0, 0) to (1, 1).
struct Corner
{
    float2 position;
}

// What the backdrop's frag reads.
local singleton Sky
{
    List<Corner> quad;
    List<int> faces;
    float4 view;   // Half the screen in pixels, pixels per arena unit, seconds
    float2 look;   // The camera's offset
    float4 shock;  // A ring of light through the floor: where, how old, how strong
    float4 shock2;
}

// What the arena is seen through. It isn't drawn into the window but into a
// target that's always the window's size, so that what's bright in it can
// spill over what's next to it (PaintLight): its bright parts go to smaller
// targets, are blurred there, and are added to the arena as it reaches the
// window. The score, the keys and the menus are drawn into the window
// afterwards, with none of that light on their text.
local singleton Lens
{
    RenderTarget scene;  // The arena
    RenderTarget bright; // Its bright parts, a quarter of the size...
    RenderTarget spread; // ...blurred across here, and down again into `bright`
    RenderTarget wide;   // Those again at an eighth of the size, for light that reaches further...
    RenderTarget wider;  // ...blurred the same way
    bool made;
    Texture glow;  // What the frag that composes the frame adds to the arena: the light close to what's bright
    Texture haze;  // ...and the light far around it
    float2 pixel;  // One of the screen's pixels, as textures count: 1 over its size
    float2 along;  // From one sample of a blur to the next
}

float EaseOut(float t)
{
    var left = 1 - Math.Saturate(t);
    return 1 - left * left * left;
}

// Past its end and back, like something that lands.
float EaseBack(float t)
{
    var left = Math.Saturate(t) - 1;
    return 1 + left * left * (2.70158 * left + 1.70158);
}

void Shake(mut Fx fx, float amount)
{
    fx.trauma = Math.Min(1, fx.trauma + amount);
}

void Flash(mut Fx fx, Color color, float amount)
{
    if (amount < fx.flash) return;
    fx.flash = amount;
    fx.flashColor = color;
}

void Shock(mut Sky sky, float2 at, float strength)
{
    // The older of the two rings makes room
    if (sky.shock.w * Math.Max(0, 1 - sky.shock.z) <= sky.shock2.w * Math.Max(0, 1 - sky.shock2.z))
        sky.shock = float4(at, 0, strength);
    else
        sky.shock2 = float4(at, 0, strength);
}

void Ripple(mut Fx fx, float2 at, float from, float to, float width, float life, Color color)
{
    fx.waves.Add(Wave { center = at, color = color, life = life, from = from, to = to, width = width });
}

// Sparks thrown around `toward`, within `spread` radians of it.
void Burst(mut Fx fx, float2 at, float2 toward, float spread, int count, float speed, Color color)
{
    if (fx.bits.count > 900) return;
    var middle = Math.Atan2(toward.y, toward.x);
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var thick = fx.random.NextFloat();
        var angle = middle + (turn - 0.5) * spread;
        fx.bits.Add(Bit { position = at, velocity = float2(Math.Cos(angle), Math.Sin(angle)) * speed * (0.3 + pace * 0.9),
                          color = color, life = 0.16 + long * 0.3, size = 2 + thick * 1.8,
                          gravity = 520, drag = 2.6, kind = BitKind.Streak });
    }
}

// Pieces thrown every way, which fall and bounce.
void Chunks(mut Fx fx, float2 at, float2 push, int count, float speed, Color color)
{
    if (fx.bits.count > 900) return;
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var big = fx.random.NextFloat();
        var tone = fx.random.NextFloat();
        var round = fx.random.NextFloat();
        var angle = turn * Math.TAU;
        fx.bits.Add(Bit { position = at + float2(Math.Cos(angle), Math.Sin(angle)) * 6,
                          velocity = float2(Math.Cos(angle), Math.Sin(angle)) * speed * (0.25 + pace) + push,
                          color = Shade(color, tone * 0.7 - 0.25), life = 0.6 + long * 0.9, size = 3 + big * 5.5,
                          gravity = 1000, drag = 0.6, spin = (turn - 0.5) * 22,
                          kind = round < 0.45 ? BitKind.Dot : BitKind.Chunk });
    }
}

// Soft puffs that drift and thin out.
void Dust(mut Fx fx, float2 at, float2 drift, int count, float size, Color color)
{
    if (fx.bits.count > 900) return;
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var angle = turn * Math.TAU;
        fx.bits.Add(Bit { position = at, velocity = float2(Math.Cos(angle), Math.Sin(angle) * 0.5 + 0.35) * (20 + pace * 55) + drift,
                          color = color, life = 0.3 + long * 0.35, size = size * (0.7 + pace * 0.6), drag = 3,
                          kind = BitKind.Puff });
    }
}

// Paper thrown over the screen, in its pixels.
void Confetti(mut Fx fx, float2 at, int count, float speed, Color color)
{
    if (fx.confetti.count > 500) return;
    for (var i = 0; i < count; i++)
    {
        var turn = fx.random.NextFloat();
        var pace = fx.random.NextFloat();
        var long = fx.random.NextFloat();
        var big = fx.random.NextFloat();
        var tone = fx.random.NextFloat();
        var angle = turn * Math.TAU;
        fx.confetti.Add(Bit { position = at, velocity = float2(Math.Cos(angle), Math.Sin(angle) - 0.6) * speed * (0.2 + pace),
                              color = tone < 0.25 ? Color.white : Shade(color, tone * 0.6 - 0.2),
                              life = 1.1 + long * 1.3, size = 4 + big * 5, gravity = 620, drag = 1.3,
                              spin = (turn - 0.5) * 26, kind = BitKind.Chunk });
    }
}

// The frame's clock, camera and backdrop, before anything else draws. It's
// this machine's, so it goes on with no match, while one is being joined.
[Stage(PaintStages.Prepare)]
view BeginFrame(mut Canvas canvas, mut Fx fx, mut Sky sky, mut Lens lens)
{
    if (!lens.made)
    {
        // The window's size, whatever it becomes, at the display's own pixels: nothing here resizes them
        lens.scene = RenderTarget.Screen();
        lens.bright = RenderTarget.Screen(0.25);
        lens.spread = RenderTarget.Screen(0.25);
        lens.wide = RenderTarget.Screen(0.125);
        lens.wider = RenderTarget.Screen(0.125);
        lens.made = true;
    }
    var scene = lens.scene;
    // A frame after a stall is a step, not a leap
    fx.dt = Math.Min(Frame.dt, 0.05);
    fx.now += fx.dt;

    fx.trauma = Math.Max(0, fx.trauma - fx.dt * 1.7);
    var shake = fx.trauma * fx.trauma * 15 * fx.calm;
    fx.shake = float2(Math.Sin(fx.now * 71) + Math.Sin(fx.now * 43.7 + 1.3) * 0.6,
                      Math.Sin(fx.now * 63 + 2.1) + Math.Sin(fx.now * 38.3 + 0.4) * 0.6) * shake;
    fx.kick = Math.Max(0, fx.kick - fx.dt * 5) * Math.Max(0, 1 - fx.dt * 6);
    fx.flash = Math.Max(0, fx.flash - fx.dt * 2.2);
    fx.hurt = Math.Max(0, fx.hurt - fx.dt * 1.9);

    var screen = float2(Screen.width, Screen.height);
    canvas.screenHalf = screen * 0.5;
    // Room above and under the arena for the score and the keys
    canvas.band = Math.Clamp(screen.y * 0.14, 54, 100);
    canvas.scale = Math.Max(0.1, Math.Min((screen.x - 32) / ARENA_WIDTH, (screen.y - canvas.band * 2) / ARENA_HEIGHT));

    if (sky.quad.count == 0)
    {
        sky.quad = [Corner { position = float2(0, 0) }, Corner { position = float2(1, 0) },
                    Corner { position = float2(1, 1) }, Corner { position = float2(0, 1) }];
        sky.faces = [0, 1, 2, 0, 2, 3];
    }
    sky.view = float4(canvas.screenHalf, canvas.scale, fx.now);
    sky.look = fx.shake;
    sky.shock.z += fx.dt * 1.35;
    sky.shock2.z += fx.dt * 1.35;
    scene.Clear(UI_BACKGROUND);
    scene.SetScreen();
    scene.Mesh(sky.quad, sky.faces, PlaceSky, PaintSky);

    // The arena's camera, and the window's too: what's drawn there over a fighter finds it with the same one
    var zoom = 1 + fx.kick * 0.035 * fx.calm;
    scene.SetCamera(fx.shake, screen.y * 0.5 / (canvas.scale * zoom));
    Draw2D.SetCamera(fx.shake, screen.y * 0.5 / (canvas.scale * zoom));
}

vert PlaceSky(mut Corner corner, Sky sky)
{
    corner.position = corner.position * sky.view.xy * 2;
}

// Night air with each side's light in it, lamps that drift far off, and a
// floor of dots that light travels through when something big happens.
frag PaintSky(Corner corner, out Color color, Sky sky, Pixel pixel)
{
    var half = sky.view.xy;
    var scale = sky.view.z;
    var time = sky.view.w;
    var across = pixel.position / (half * 2);
    // Arena units from its middle, y up. What's far moves less with the camera.
    var here = float2(pixel.position.x - half.x, half.y - pixel.position.y) / scale + sky.look * 0.55;
    var side = here.x / (ARENA_WIDTH * 0.5);
    var rise = here.y / (ARENA_HEIGHT * 0.5);

    var top = Color(0.085, 0.07, 0.21);
    var bottom = Color(0.02, 0.032, 0.085);
    mut var paint = bottom + (top - bottom) * Math.Saturate(0.5 + rise * 0.5);

    // Each side's light, from where its fighter starts
    var blue = Math.Saturate(1 - Math.Length(float2(side + 0.9, rise + 0.7) * float2(0.55, 0.72)));
    var orange = Math.Saturate(1 - Math.Length(float2(side - 0.9, rise + 0.7) * float2(0.55, 0.72)));
    paint = paint + Color(0.08, 0.34, 0.7) * (blue * blue * 0.5) + Color(0.72, 0.27, 0.08) * (orange * orange * 0.42);

    // Lamps far off, and haze that drifts between them
    var first = float2(Math.Sin(time * 0.05) * 260 - 150, Math.Cos(time * 0.04) * 60 + 130);
    var second = float2(Math.Cos(time * 0.045) * 240 + 190, Math.Sin(time * 0.055) * 70 + 60);
    var lamp = Math.Saturate(1 - Math.Length(here + sky.look * 0.3 - first) / 300);
    var lamp2 = Math.Saturate(1 - Math.Length(here + sky.look * 0.3 - second) / 240);
    paint = paint + Color(0.3, 0.14, 0.5) * (lamp * lamp * 0.32) + Color(0.1, 0.3, 0.48) * (lamp2 * lamp2 * 0.24);
    var haze = Math.Sin(here.x * 0.007 + time * 0.13) * Math.Sin(here.y * 0.009 - time * 0.09)
             + Math.Sin((here.x + here.y) * 0.0045 + time * 0.06);
    paint = paint + Color(0.09, 0.05, 0.17) * (haze * 0.16 + 0.12);

    // Beams of light that lean across the room
    var lean = here.x * 0.9 + here.y * 0.5;
    var beam = Math.Saturate(Math.Sin(lean * 0.011 + time * 0.07) * Math.Sin(lean * 0.0043 - time * 0.03));
    paint = paint + Color(0.22, 0.3, 0.6) * (beam * beam * 0.1 * Math.Saturate(0.6 + rise * 0.5));

    // Dots, lit by the rings that pass
    var reach = Math.Length(here - sky.shock.xy) - sky.shock.z * 900;
    var reach2 = Math.Length(here - sky.shock2.xy) - sky.shock2.z * 900;
    var ring = Math.Exp(-reach * reach / 2400) * sky.shock.w * Math.Saturate(1 - sky.shock.z)
             + Math.Exp(-reach2 * reach2 / 2400) * sky.shock2.w * Math.Saturate(1 - sky.shock2.z);
    var cell = Math.Frac(here / 30 + 0.5) - 0.5;
    var dot = Math.Saturate((1.3 + ring * 1.6 - Math.Length(cell) * 30) * scale);
    var breath = 0.5 + 0.5 * Math.Sin(time * 0.8 + here.x * 0.012 + here.y * 0.016);
    paint = paint + Color(0.4, 0.54, 0.9) * (dot * (0.16 + breath * 0.1 + ring)) + Color(0.5, 0.62, 1) * (ring * 0.07);

    // Motes that rise through the room, one to a cell of a wider grid, each in its own place there
    var drift = (here + float2(Math.Sin(time * 0.3 + here.y * 0.01) * 12, -time * 14)) / 110;
    var home = Math.Floor(drift);
    var luck = Math.Hash(int2(home)) / 2147483648.0; // 0 to 1, the same for a cell on every GPU
    var place = float2(luck, Math.Frac(luck * 57.3)) * 0.7 + 0.15;
    var mote = Math.Saturate((1.5 + luck - Math.Length(Math.Frac(drift) - place) * 110) * scale);
    paint = paint + Color(0.55, 0.66, 1) * (mote * Math.Step(0.45, luck) * (0.2 + 0.2 * Math.Sin(time * 1.3 + luck * 40)));

    // Darker past the arena's walls, and towards the screen's corners
    var past = Math.Max(Math.Abs(here.x) - ARENA_WIDTH * 0.5, Math.Max(-here.y - ARENA_HEIGHT * 0.5 + 10, here.y - ARENA_HEIGHT * 0.5));
    paint = paint * (1 - 0.4 * Math.Saturate(past / 24 + 0.5));
    var corner2 = across - 0.5;
    paint = paint * (1 - Math.Dot(corner2, corner2) * 0.75);
    color = Color(paint.r, paint.g, paint.b, 1);
}

// The effects' pieces move on each frame, whatever else there is: they're this
// machine's, so they fall and fade with no match too, while one is being joined.
[Stage(PaintStages.Effects)]
view MoveBits(mut Fx fx)
{
    mut var i = 0;
    while (i < fx.bits.count)
    {
        mut var bit = fx.bits[i];
        bit.age += fx.dt;
        if (bit.age >= bit.life)
        {
            fx.bits[i] = fx.bits[fx.bits.count - 1];
            fx.bits.RemoveAt(fx.bits.count - 1);
            continue;
        }
        bit.velocity.y -= bit.gravity * fx.dt;
        bit.velocity = bit.velocity * Math.Max(0, 1 - bit.drag * fx.dt);
        bit.position += bit.velocity * fx.dt;
        fx.bits[i] = bit;
        i++;
    }
}

// Those that fall land on the platforms, and bounce. The platforms are the
// match's, so this view only runs in one: it goes through them with a query.
[Stage(PaintStages.Effects, 1)]
view BounceBits(mut Fx fx, query (Platform box) platforms)
{
    for (var i = 0; i < fx.bits.count; i++)
    {
        mut var bit = fx.bits[i];
        if (bit.kind != BitKind.Chunk && bit.kind != BitKind.Shell && !(bit.kind == BitKind.Dot && bit.gravity > 0)) continue;
        foreach (var entry in platforms)
        {
            var offset = bit.position - entry.box.center;
            var inside = entry.box.half + bit.size * 0.5 - Math.Abs(offset);
            if (inside.x <= 0 || inside.y <= 0) continue;
            if (inside.x < inside.y)
            {
                bit.position.x += (offset.x < 0 ? -1 : 1) * inside.x;
                bit.velocity.x *= -0.5;
            }
            else
            {
                bit.position.y += (offset.y < 0 ? -1 : 1) * inside.y;
                bit.velocity.y *= -0.42;
                bit.velocity.x *= 0.72;
                bit.spin *= 0.6;
            }
        }
        fx.bits[i] = bit;
    }
}

// A bit that's light rather than a thing: a spark, or a flash where a shot
// left its gun or ended.
bool Glows(Bit bit)
{
    return bit.kind == BitKind.Streak || bit.kind == BitKind.Dot && bit.gravity == 0;
}

// The effects go over everything in the arena, which drew before them.
[Stage(PaintStages.Effects, 2)]
view PaintEffects(mut Fx fx, mut Sky sky, Lens lens)
{
    var scene = lens.scene;
    // What's thrown first, where MoveBits and BounceBits left it: dust, pieces
    // and shells, which cover what's behind them
    foreach (var bit in fx.bits)
    {
        if (Glows(bit)) continue; // With the light, below
        var along = bit.age / bit.life;
        var left = 1 - along;
        if (bit.kind == BitKind.Puff)
        {
            scene.Circle(bit.position, bit.size * (0.45 + along * 0.9), Fade(bit.color, left * left));
        }
        else if (bit.kind == BitKind.Dot)
        {
            scene.Circle(bit.position, bit.size * 0.5 * Math.Min(1, left * 3), Fade(bit.color, Math.Min(1, left * 2.5)));
        }
        else if (bit.kind == BitKind.Shell)
        {
            scene.RoundRect(bit.position, float2(bit.size * 2.3, bit.size), 1, bit.spin * bit.age, Fade(bit.color, Math.Min(1, left * 4)));
        }
        else
        {
            scene.RoundRect(bit.position, float2(bit.size), bit.size * 0.28, bit.spin * bit.age, Fade(bit.color, Math.Min(1, left * 3)));
        }
    }

    // Then the light, which adds to what's under it rather than covering it:
    // trails, rings, sparks and flashes are brighter where they cross
    Draw.Blend(Blend.Add)
    {
        mut var t = 0;
        while (t < fx.streaks.count)
        {
            mut var streak = fx.streaks[t];
            streak.age += fx.dt;
            if (streak.age >= streak.life)
            {
                fx.streaks[t] = fx.streaks[fx.streaks.count - 1];
                fx.streaks.RemoveAt(fx.streaks.count - 1);
                continue;
            }
            fx.streaks[t] = streak;
            var left = 1 - streak.age / streak.life;
            GlowLineOn(scene, streak.from, streak.to, streak.width * left * 0.5, 9, Fade(streak.color, 0.2 * left));
            scene.Line(streak.from, streak.to, streak.width * left, Fade(streak.color, 0.6 * left));
            t++;
        }

        mut var w = 0;
        while (w < fx.waves.count)
        {
            mut var wave = fx.waves[w];
            wave.age += fx.dt;
            if (wave.age >= wave.life)
            {
                fx.waves[w] = fx.waves[fx.waves.count - 1];
                fx.waves.RemoveAt(fx.waves.count - 1);
                continue;
            }
            fx.waves[w] = wave;
            var along = wave.age / wave.life;
            var radius = wave.from + (wave.to - wave.from) * EaseOut(along);
            scene.WireCircle(wave.center, radius, Math.Max(0.6, wave.width * (1 - along)), Fade(wave.color, (1 - along) * (1 - along)));
            w++;
        }

        foreach (var bit in fx.bits)
        {
            if (!Glows(bit)) continue;
            var left = 1 - bit.age / bit.life;
            if (bit.kind == BitKind.Dot)
            {
                scene.Circle(bit.position, bit.size * 0.5 * left, Fade(bit.color, Math.Min(1, left * 2.5)));
                continue;
            }
            var speed = Math.Length(bit.velocity);
            var tail = bit.position - bit.velocity * (Math.Min(speed * 0.045, 22) / Math.Max(speed, 1));
            GlowLineOn(scene, tail, bit.position, bit.size * left * 0.5, 7, Fade(bit.color, 0.3 * left));
            scene.Line(tail, bit.position, bit.size * left, Fade(Mix(bit.color, Color.white, left * 0.6), Math.Min(1, left * 2)));
        }
    }

    // Numbers, over everything in the arena
    mut var l = 0;
    while (l < fx.labels.count)
    {
        mut var label = fx.labels[l];
        label.age += fx.dt;
        if (label.age >= label.life)
        {
            fx.labels[l] = fx.labels[fx.labels.count - 1];
            fx.labels.RemoveAt(fx.labels.count - 1);
            continue;
        }
        fx.labels[l] = label;
        l++;
        var along = label.age / label.life;
        var size = 15 + Math.Min(label.amount, 90) * 0.12 + 7 * Math.Max(0, 1 - along * 6);
        var at = label.position + float2(0, 34 * EaseOut(along));
        var text = $"{label.amount}";
        var alpha = Math.Saturate((1 - along) * 3);
        scene.Text(text, at + float2(1.5, -1.5), size, Fade(UI_BACKGROUND, alpha * 0.8), Anchor.MiddleCenter);
        scene.Text(text, at, size, Fade(label.color, alpha), Anchor.MiddleCenter);
    }

    if (sky.shock.z > 1) sky.shock.w = 0;
    if (sky.shock2.z > 1) sky.shock2.w = 0;
}

// How bright a color has to be before it spills, and how much of it does:
// close to what's bright, and far around it.
const float GLOW_FROM = 0.62;
const float GLOW_NEAR = 0.9;
const float GLOW_FAR = 1.4;

// The arena's bright parts, at a quarter of its size: each pixel is what it
// covers of the arena, sampled three times across and three down so nothing
// small falls between two samples, and what's left of that above GLOW_FROM.
// White is brighter than a color as strong, so a shot's core spills more
// than a fighter's side.
frag Brights(Vertex vertex, out Color color, Texture source, Lens lens)
{
    mut var sum = Color(0, 0, 0, 0);
    for (var y = -1; y <= 1; y++)
    {
        for (var x = -1; x <= 1; x++) sum = sum + source.Sample(vertex.uv + float2(x, y) * lens.pixel * 1.33);
    }
    var seen = sum * (1.0 / 9);
    var light = Math.Max(seen.r, Math.Max(seen.g, seen.b)) * 0.5 + (seen.r * 0.3 + seen.g * 0.5 + seen.b * 0.2) * 0.5;
    var kept = Math.Saturate((light - GLOW_FROM) / (1 - GLOW_FROM));
    color = Color(seen.r * kept, seen.g * kept, seen.b * kept, 1);
}

// A blur along one axis, as wide as nine pixels of its target, in five
// samples: each of the outer four is between two pixels and reads both.
frag Blur(Vertex vertex, out Color color, Texture source, Lens lens)
{
    var near = lens.along * 1.3846;
    var far = lens.along * 3.2308;
    var sum = source.Sample(vertex.uv) * 0.227
            + (source.Sample(vertex.uv + near) + source.Sample(vertex.uv - near)) * 0.3162
            + (source.Sample(vertex.uv + far) + source.Sample(vertex.uv - far)) * 0.0703;
    color = Color(sum.r, sum.g, sum.b, 1);
}

// A target half the size of its source: each of its pixels is between four of
// the source's, and reads them all at once.
frag Halve(Vertex vertex, out Color color, Texture source)
{
    color = source.Sample(vertex.uv);
}

// The frame: the arena as it was drawn, and its light over it. Light adds
// less to what's bright already, so a fighter keeps its shading under its own
// glow, and the dark around it takes all of it.
frag Lit(Vertex vertex, out Color color, Texture source, Lens lens)
{
    var arena = source.Sample(vertex.uv, Filter.Point);
    var glow = lens.glow.Sample(vertex.uv) * GLOW_NEAR + lens.haze.Sample(vertex.uv) * GLOW_FAR;
    color = Color(arena.r + glow.r * (1 - arena.r), arena.g + glow.g * (1 - arena.g), arena.b + glow.b * (1 - arena.b), 1);
}

// The arena goes to the window, with the light of its bright parts: blurred
// at a quarter of the screen's size for what's close to them, and again at an
// eighth for what's far. Six small passes and one over the screen. A Blit
// replaces what's there, so the frag that composes the frame reads the arena
// and its light, and writes their sum.
[Stage(PaintStages.Light)]
view PaintLight(mut Lens lens)
{
    lens.pixel = float2(1 / Screen.width, 1 / Screen.height);
    Draw.Blit(lens.scene.color, lens.bright, Brights);
    // A step of a blur is a pixel of its target, which is four of the screen's here
    lens.along = float2(lens.pixel.x * 4, 0);
    Draw.Blit(lens.bright.color, lens.spread, Blur);
    lens.along = float2(0, lens.pixel.y * 4);
    Draw.Blit(lens.spread.color, lens.bright, Blur);
    // ...and eight there
    Draw.Blit(lens.bright.color, lens.wide, Halve);
    lens.along = float2(lens.pixel.x * 8, 0);
    Draw.Blit(lens.wide.color, lens.wider, Blur);
    lens.along = float2(0, lens.pixel.y * 8);
    Draw.Blit(lens.wider.color, lens.wide, Blur);

    lens.glow = lens.bright.color;
    lens.haze = lens.wide.color;
    Draw.Blit(lens.scene.color, Draw.window, Lit);
}

// Light over the whole screen, after the menus: a flash, a hit's red edges,
// and paper for the winner.
[Stage(PaintStages.Overlay)]
view PaintOverlay(mut Fx fx)
{
    Draw2D.SetScreen();
    var screen = float2(Screen.width, Screen.height);

    mut var i = 0;
    while (i < fx.confetti.count)
    {
        mut var bit = fx.confetti[i];
        bit.age += fx.dt;
        if (bit.age >= bit.life || bit.position.y > screen.y + 20)
        {
            fx.confetti[i] = fx.confetti[fx.confetti.count - 1];
            fx.confetti.RemoveAt(fx.confetti.count - 1);
            continue;
        }
        // Down is +y on the screen
        bit.velocity.y += bit.gravity * fx.dt;
        bit.velocity = bit.velocity * Math.Max(0, 1 - bit.drag * fx.dt);
        bit.position += bit.velocity * fx.dt;
        fx.confetti[i] = bit;
        i++;
        var left = 1 - bit.age / bit.life;
        // Paper turns as it falls, so it's seen from its side now and then
        var turned = Math.Abs(Math.Sin(bit.spin * bit.age * 0.5)) * 0.8 + 0.2;
        Draw2D.RoundRect(bit.position, float2(bit.size * 1.5, bit.size * turned), 1.5, bit.spin * bit.age * 0.3,
               Fade(bit.color, Math.Min(1, left * 3)));
    }

    // Both are light: they add to the screen, and darken nothing
    Draw.Blend(Blend.Add)
    {
        if (fx.hurt > 0.01)
            Inset(screen * 0.5, screen, 0, Math.Min(screen.x, screen.y) * 0.2, Color(1, 0.14, 0.2, fx.hurt * 0.3));
        if (fx.flash > 0.01)
            Draw2D.Rect(screen * 0.5, screen, Fade(fx.flashColor, fx.flash * fx.calm));
    }
}
