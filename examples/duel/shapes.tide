// The duel is drawn with the engine's shapes: round rects, circles, ellipses,
// thick lines and arcs, with smooth edges at any size, in the order they're
// written, text among them. Most of it is a `Draw2D` call. These are the few
// shapes the game draws again and again that take a `Shape` to say: a fill
// that goes from one color to another under an outline, and edges that fade
// into a glow or a shadow.
Color Fade(Color color, float alpha)
{
    return Color(color.r, color.g, color.b, color.a * alpha);
}

Color Mix(Color from, Color to, float amount)
{
    return from + (to - from) * Math.Saturate(amount);
}

// A color made lighter (above 0) or darker (under 0), its alpha kept.
Color Shade(Color color, float amount)
{
    var to = amount > 0 ? Color.white : Color.black;
    var mixed = color + (to - color) * Math.Saturate(Math.Abs(amount));
    return Color(mixed.r, mixed.g, mixed.b, color.a);
}

// A box whose fill goes from `top` to `bottom`, with an outline.
void Panel(float2 center, float2 size, float radius, Color top, Color bottom, float outline, Color edge)
{
    Draw2D.Shape(Shape { center = center, size = size, radius = radius, color = top, color2 = bottom,
                         outline = outline, outlineColor = edge });
}

// An ellipse, the same way.
void Oval(float2 center, float2 radii, Color top, Color bottom, float outline, Color edge)
{
    Draw2D.Shape(Shape { center = center, size = radii * 2, ellipse = true, color = top, color2 = bottom,
                         outline = outline, outlineColor = edge });
}

// Light that fades over `spread` from a disc's edge.
void Glow(float2 center, float radius, float spread, Color color)
{
    Draw2D.Shape(Shape { center = center, size = float2(radius * 2), radius = radius, color = color, soft = spread });
}

void GlowLine(float2 from, float2 to, float width, float spread, Color color)
{
    // A pill as long as the line and its round ends, turned along it
    var along = to - from;
    Draw2D.Shape(Shape { center = (from + to) * 0.5, size = float2(Math.Length(along) + width, width),
                         radius = width * 0.5, rotation = Math.Atan2(along.y, along.x), color = color, soft = spread });
}

void GlowBox(float2 center, float2 size, float radius, float spread, Color color)
{
    Draw2D.Shape(Shape { center = center, size = size, radius = radius, color = color, soft = spread });
}

void GlowOval(float2 center, float2 radii, float spread, Color color)
{
    Draw2D.Shape(Shape { center = center, size = radii * 2, ellipse = true, color = color, soft = spread });
}

// Clear in the middle, and `color` over `spread` inwards from the box's edge.
void Inset(float2 center, float2 size, float radius, float spread, Color color)
{
    Draw2D.Shape(Shape { center = center, size = size, radius = radius, color = color, soft = -spread });
}

// Text with its middle at `center`, on the screen, where y goes down.
void Write(string text, float2 center, float size, Color color)
{
    Draw2D.Text(text, center - Draw2D.MeasureText(text, size) * 0.5, size, color);
}

// The same, drawn twice a little apart: the engine's font is a light one,
// and a title wants weight.
void WriteBold(string text, float2 center, float size, Color color)
{
    var apart = Math.Max(0.5, size * 0.012);
    Write(text, center + float2(-apart, 0), size, color);
    Write(text, center + float2(apart, 0), size, color);
}

// The same in the arena, where y goes up.
void WriteUp(string text, float2 center, float size, Color color)
{
    var half = Draw2D.MeasureText(text, size) * 0.5;
    Draw2D.Text(text, center + float2(-half.x, half.y), size, color);
}
