// Sumo, as one machine shows it: the camera, the ring and what's on it.
// Views read the match and never change it: what they write is this machine's
// own (Hand, Fx, Room, Ground, Shadow, and a ball's local fields). The light is in
// light.tide, the sparks and the numbers in effects.tide, the scores and the
// controls in hud.tide, and the menu is the rooms package's.
using Box3D;
using Rooms;

// The docs site's colors, and a few more for eight players.
const Color BACK = Color(0.086, 0.086, 0.094);
const Color RAISED = Color(0.17, 0.175, 0.19);
const Color LINE = Color(0.24, 0.25, 0.27);
const Color QUIET = Color(0.64, 0.64, 0.68);
const Color INK = Color(0.93, 0.93, 0.95);
const Color AMBER = Color(0.98, 0.75, 0.14);
const Color TEAL = Color(0.18, 0.83, 0.75);
const Color ROSE = Color(0.98, 0.44, 0.52);
const Color BLUE = Color(0.47, 0.72, 1);
const Color VIOLET = Color(0.66, 0.58, 1);
const Color GREEN = Color(0.4, 0.92, 0.56);
const Color ORANGE = Color(1, 0.55, 0.2);
const Color LIME = Color(0.78, 0.92, 0.3);
const Color PLAIN = Color(0.86, 0.87, 0.9);
const Color GOLD = Color(1, 0.86, 0.36);

// What draws over what, whichever file a view is in. The lamp's image is
// drawn before anything goes to the window, as everything there asks it where
// the shadows are.
enum Layers { Camera, Gather, Lamp, Floor, Marks, Pieces, Effects, Hud }

// How far over the floor what's flat on it is drawn, so that the floor, which
// is in the same place, doesn't show through it.
const float ON_FLOOR = 0.03;

// What this machine's player does with the pointer, which its input sends:
// a stick, from where the pointer went down to where it is now, and the
// charge button (hud.tide reads both).
local singleton Hand
{
    float2 stick;
    bool charge;
    bool playing;    // No lobby or menu is up: the player's hands are on their ball
    bool live;       // A round is on: there's something to drive
    bool dragging;   // The mouse's button is down...
    float2 from;     // ...since here, in the devices' pixels
}

// What this machine's drawing keeps from frame to frame. None of it is the
// match's.
local singleton Fx
{
    float dt;        // Seconds this frame's effects move on by: a stall isn't a leap
    float beat;      // Radians, for what pulses: always under a full turn
    int seat = -1;   // This machine's player's
    bool here;       // Their ball is in the ring,
    float3 mine;     // where,
    float charge;    // how far it's wound up,
    bool winding;
    int cooldown;    // and how long until it can charge again
    float peril;     // How near the rim it is, 0 to 1
    float radius = RING; // Where the floor ends
    float3 focus;    // What the camera looks at
    float span = 24; // ...and how many meters around it are in view
    float trauma;    // How hard the camera shakes, 0 to 1
    float flash;     // The whole screen lit, fading
    Color flashColor = Color.white;
    Random random;   // What rolls the effects: this machine's own
    List<Solid> tiles;    // What's drawn this frame, for the window and for the lamp: the floor's tiles,
    List<Solid> solids;   // the crates,
    List<Solid> gems;     // the pickups that are boxes,
    List<Solid> orbs;     // and the ones that are balls;
    List<Solid> rounds;   // the players' balls, for the lamp alone;
    List<Decal> decals;   // and what's flat on the floor, the later over the earlier
    List<float> pops;     // Each seat's score, just counted up: 1, fading
}

Color SeatColor(int seat)
{
    return seat == 0 ? AMBER : seat == 1 ? TEAL : seat == 2 ? ROSE : seat == 3 ? BLUE
         : seat == 4 ? VIOLET : seat == 5 ? GREEN : seat == 6 ? ORANGE : seat == 7 ? LIME : PLAIN;
}

string SeatName(int seat)
{
    return seat == 0 ? "AMBER" : seat == 1 ? "TEAL" : seat == 2 ? "ROSE" : seat == 3 ? "BLUE"
         : seat == 4 ? "VIOLET" : seat == 5 ? "GREEN" : seat == 6 ? "ORANGE" : "LIME";
}

Color Shade(Color color, float light)
{
    return Color(Math.Saturate(color.r * light), Math.Saturate(color.g * light), Math.Saturate(color.b * light), color.a);
}

Color Fade(Color color, float alpha)
{
    return Color(color.r, color.g, color.b, color.a * Math.Saturate(alpha));
}

Color Mix(Color from, Color to, float t)
{
    return from + (to - from) * Math.Saturate(t);
}

float EaseOut(float t)
{
    var left = 1 - Math.Saturate(t);
    return 1 - left * left * left;
}

// Past its end and back, like something that lands.
float EaseBack(float t)
{
    var left = Math.Saturate(t) - 1;
    return 1 + left * left * (2.70158 * left + 1.70158);
}

// A mark painted on the floor: a disc, a ring, or part of one.
void Mark(mut Fx fx, float3 at, float size, Color tint, float ring, float arc)
{
    fx.decals.Add(Decal { transform = float4x4.TRS(float3(at.x, ON_FLOOR, at.z), quaternion.identity, float3(size, 1, size)),
                          tint = tint, ring = ring, arc = arc });
}

// A frame starts: what the views after this one fill is emptied, and what
// fades moves on.
[Stage(Layers.Camera, -1)]
view Begin(mut Fx fx, mut Models models, mut Room room, mut Ground ground)
{
    if (!models.made) MakeModels(models);
    while (fx.pops.count < SEATS) fx.pops.Add(0);
    fx.dt = Math.Min(Frame.dt, 0.05);
    fx.beat += fx.dt * 3;
    if (fx.beat > Math.TAU) fx.beat -= Math.TAU;
    room.beat = fx.beat;
    fx.trauma = Math.Max(0, fx.trauma - fx.dt * 1.8);
    fx.flash = Math.Max(0, fx.flash - fx.dt * 2.4);
    for (var seat = 0; seat < SEATS; seat++)
        fx.pops[seat] = Math.Max(0, fx.pops[seat] - fx.dt * 2.2);
    fx.tiles.Clear();
    fx.solids.Clear();
    fx.gems.Clear();
    fx.orbs.Clear();
    fx.rounds.Clear();
    fx.decals.Clear();
    for (var i = 0; i < 15; i++)
        for (var j = 0; j < 15; j++)
            ground.floor[i, j] = Color(0, 0, 0, 0);
    fx.here = false;
    fx.winding = false;
    fx.charge = 0;
    fx.cooldown = 0;
    fx.peril = 0;
}

// Which seat is this machine's player's, where the floor ends, and whether a
// round is on: not while the ring is counted in, nor in the last moments
// before it's cleared, when the input sends nothing (game.tide).
[Stage(Layers.Camera)]
view Edge(Ring ring, Session session, mut Fx fx, mut Hand hand)
{
    fx.radius = ring.radius;
    fx.seat = ring.players.TryGet(session.player, out var seat) ? seat : -1;
    hand.live = ring.phase == Phase.Play || (ring.phase == Phase.Over && ring.timer > 45);
}

// This machine's player's ball, for the camera and the controls: `with
// ownership` picks the entities this machine's player owns.
[Stage(Layers.Camera)]
view Mine(Body body, Ball ball, Ring ring, mut Fx fx, with ownership)
{
    fx.here = true;
    fx.mine = body.position;
    fx.charge = ball.charge;
    fx.winding = ball.winding;
    fx.cooldown = ball.cooldown;
    var rim = Math.Min(ring.radius, ring.next) + 1.5;
    fx.peril = Math.Saturate((Math.Length(float2(body.position.x, body.position.z)) - (rim - 4.5)) / 3.5);
}

// The camera, over the ring and tilted down at it, always from the same
// side, so that up on the screen is the same way in the ring for every
// player. It shows the whole ring when a ball is still big enough to find at
// that size, and as much of it as that takes otherwise, around this
// machine's player's ball and towards the middle, where the others are.
[Stage(Layers.Camera, 1)]
view Look(mut Fx fx, mut Room room)
{
    var screen = float2(Screen.width, Screen.height);
    var pitch = 1.15;
    var fov = 34.0;
    var half = Math.Tan(Math.Radians(fov) * 0.5);
    // The ring whole, or as much of it as leaves a ball 20 pixels across
    var whole = fx.radius + 4;
    var most = BALL * Math.Min(screen.x, screen.y / Math.Sin(pitch)) / 20;
    var span = Math.Min(whole, Math.Max(most, 8));
    mut var want = float3(0);
    var flat = float3(fx.mine.x, 0, fx.mine.z);
    var far = Math.Length(flat);
    // With no ball of this machine's in the ring, it looks at the middle, where one is about to land
    if (fx.here && span < whole && far > span * 0.4) want = flat * (1 - span * 0.4 / far);
    var ease = 1 - Math.Exp(-fx.dt * 5);
    fx.focus += (want - fx.focus) * ease;
    fx.span += (span - fx.span) * ease;
    var back = Math.Max(fx.span / (half * screen.x / screen.y), fx.span * Math.Sin(pitch) * 1.12 / half);
    var eye = fx.focus + float3(0, Math.Sin(pitch), -Math.Cos(pitch)) * back;
    var turned = quaternion.LookRotation(Math.Normalize(fx.focus - eye), float3(0, 1, 0));

    // It shakes when something big happens
    var wobble = fx.beat * 23;
    var shake = float3(Math.Sin(wobble) + Math.Sin(wobble * 0.62 + 1.3) * 0.6,
                       Math.Sin(wobble * 0.89 + 2.1) + Math.Sin(wobble * 0.54 + 0.4) * 0.6, 0) * (fx.trauma * fx.trauma * 0.014 * back);
    room.eye = eye + shake;
    Draw.SetCamera(room.eye, turned, fov);
}

// The floor's tiles, each into the list that's drawn at once, and into the
// grid the floor's paint is read from: there, about to go, or neither.
[Stage(Layers.Gather)]
view Tiles(Tile tile, Ring ring, mut Fx fx, mut Ground ground)
{
    var going = tile.reach > ring.next;
    var falling = tile.reach > ring.radius;
    ground.floor[int(Math.Round(tile.at.x / TILE)) + 7, int(Math.Round(tile.at.y / TILE)) + 7] = Color(1, going ? 1 : 0, 0, 1);
    // One that's about to drop shudders
    var shudder = falling ? Math.Sin(fx.beat * 31 + tile.at.x) * 0.04 : 0.0;
    fx.tiles.Add(Solid { transform = float4x4.TRS(float3(tile.at.x, -0.5 + shudder, tile.at.y), quaternion.identity, float3(TILE, 1, TILE)),
                         tint = going ? ROSE : AMBER });
}

// Every crate, plank, keg and fallen tile: one box each, in a list. A view
// sees a body where the last step left it, blended between ticks, and gliding
// to where the server says it is when this machine guessed otherwise.
[Stage(Layers.Gather)]
view Crates(Body body, Box box, Crate crate, Time time, mut Fx fx)
{
    // Rubble shrinks away in its last moments
    var left = crate.until == 0 ? 1.0 : Math.Saturate((crate.until - time.tick) / 14.0);
    var shade = 0.88 + crate.tone * 0.07;
    var tint = crate.kind == Kind.Keg ? ROSE : crate.kind == Kind.Plank ? Color(0.56, 0.47, 0.37)
             : crate.kind == Kind.Slab ? Color(0.25, 0.27, 0.33) : Color(0.47 * shade, 0.49 * shade, 0.56 * shade);
    fx.solids.Add(Solid { transform = float4x4.TRS(body.position, body.rotation, box.size * left), tint = tint, kind = int(crate.kind) });
}

// A ball, for the lamp, and the marks under it: a ring in its color, the
// charge it's winding up, and the time until it can charge again. A ball
// that's bursting leaves sparks behind it: `trailed`, a local field, is where
// the last one was.
[Stage(Layers.Gather)]
view Rings(Body body, mut Ball ball, mut Fx fx, mut Air air)
{
    ball.flash = Math.Max(0, ball.flash - fx.dt * 5);
    fx.rounds.Add(Solid { transform = float4x4.TRS(body.position, quaternion.identity, float3(ball.radius)) });
    if (body.position.y > 4 || body.position.y < 0.3) return;
    var color = SeatColor(ball.seat);
    var mine = ball.seat == fx.seat;
    Mark(fx, body.position, ball.radius * 2 + 0.9, Fade(mine ? Color.white : color, mine ? 0.9 : 0.6), 0.16, 1);
    if (ball.winding) Mark(fx, body.position, ball.radius * 2 + 1.4 + ball.charge * 1.6, Fade(Mix(color, Color.white, ball.charge), 0.9), 0.14, 1);
    else if (ball.cooldown > 0) Mark(fx, body.position, ball.radius * 2 + 1.5, Fade(color, 0.7), 0.1, 1 - ball.cooldown / float(COOLDOWN));
    if (ball.dash == 0)
    {
        ball.trailing = false;
        return;
    }
    if (ball.trailing && Math.Distance(body.position, ball.trailed) < 0.5) return;
    ball.trailing = true;
    ball.trailed = body.position;
    if (air.sparks.count < 600)
        air.sparks.Add(Spark { position = body.position - float3(0, ball.radius * 0.6, 0), color = Fade(Mix(color, Color.white, 0.3), 0.8),
                               life = 0.4, size = 0.22 });
}

// The lamp's image: everything that casts a shadow, drawn through a camera
// where the lamp is, into a target that keeps how far the lamp sees along each
// of its pixels, and nothing else. There's no frag: no color goes anywhere
// there. The boxes are one draw and the balls another, each mesh's lists one
// after the other.
[Stage(Layers.Lamp)]
view Cast(Fx fx, Models models, mut Shadow shadow)
{
    if (!shadow.made)
    {
        shadow.made = true;
        shadow.map = RenderTarget(LAMP_PIXELS, LAMP_PIXELS, 1, Format.DepthOnly);
        shadow.depth = shadow.map.depth;
    }
    // The lamp looks along its light from far off, and sees a box with no
    // perspective, as a sun's light has none
    var turned = quaternion.LookRotation(-Lamp(), float3(0, 1, 0));
    var lamp = float4x4.TRS(Math.Mul(turned, float3(0, LAMP_RAISED, -LAMP_AWAY)), turned, float3(1));
    var sees = float4x4.Ortho(LAMP_SPAN, LAMP_SPAN, 0, LAMP_FAR);
    // What takes the world to the lamp's image, for the frags: a camera looks
    // along its +z, and clip space along -z, so it's the projection, after z
    // turned around, after the lamp's own transform undone
    shadow.toLamp = Math.Mul(sees, Math.Mul(float4x4.TRS(float3(0), quaternion.identity, float3(1, 1, -1)), Math.Inverse(lamp)));

    shadow.map.Clear(Color.white);
    shadow.map.SetCamera(lamp, sees);
    shadow.map.Instanced(models.cube, models.cubeFaces, fx.tiles);
    shadow.map.Instanced(models.cube, models.cubeFaces, fx.solids);
    shadow.map.Instanced(models.cube, models.cubeFaces, fx.gems);
    shadow.map.Instanced(models.ball, models.ballFaces, fx.rounds);
    shadow.map.Instanced(models.ball, models.ballFaces, fx.orbs);
}

// The window's frame starts here, with the floor: everything before this
// went into the lamp's image.
[Stage(Layers.Floor)]
view Floor(Fx fx, Models models)
{
    Draw.Clear(BACK);
    Draw.Instanced(models.cube, models.cubeFaces, fx.tiles, TileLook);
}

// What's flat on the floor, all at once, over it and under what stands on
// it. It reads depth and writes none: what's in front hides it, and it hides
// nothing.
[Stage(Layers.Marks)]
view Decals(Fx fx, Models models)
{
    Draw.Depth(Depth.Read)
    {
        Draw.Instanced(models.plate, models.plateFaces, fx.decals, DecalLook);
    }
}

// The crates, all in one draw.
[Stage(Layers.Pieces)]
view Solids(Fx fx, Models models)
{
    Draw.Instanced(models.cube, models.cubeFaces, fx.solids, CrateLook);
}

// The balls. Instances of one mesh drawn in a row are one draw, each with its
// own transform and its own entity's `Ball`.
[Stage(Layers.Pieces, 1)]
view Balls(Body body, Ball ball, Models models)
{
    Draw.Mesh(models.ball, models.ballFaces, float4x4.TRS(body.position, body.rotation, float3(ball.radius)), BallLook);
}

// A pickup turns over the floor, with a ring under it. What it is shows in
// its shape: a heavy ball's is a ball, pale and bigger than its ring looks,
// and a shock's a box on its corner, teal.
[Stage(Layers.Gather)]
view Beacons(Body body, Pickup pickup, mut Fx fx)
{
    var heavy = pickup.power == Power.Heavy;
    Mark(fx, float3(pickup.at.x, 0, pickup.at.y), 2.3 + Math.Sin(fx.beat * 2) * 0.25, Fade(heavy ? PLAIN : TEAL, 0.85), 0.14, 1);
    var at = body.position + float3(0, Math.Sin(fx.beat * 2 + pickup.at.x) * 0.15, 0);
    if (heavy)
        fx.orbs.Add(Solid { transform = float4x4.TRS(at, quaternion.Euler(float3(0.4, fx.beat, 0)), float3(0.52 + Math.Sin(fx.beat * 4) * 0.05)),
                            tint = PLAIN });
    else
        fx.gems.Add(Solid { transform = float4x4.TRS(at, quaternion.Euler(float3(0.62, fx.beat * 2, 0.79)), float3(0.66)), tint = TEAL });
}

// The pickups, each shape's in one draw.
[Stage(Layers.Pieces, 2)]
view Pickups(Fx fx, Models models)
{
    Draw.Instanced(models.ball, models.ballFaces, fx.orbs, Plain);
    Draw.Instanced(models.cube, models.cubeFaces, fx.gems, Plain);
}
