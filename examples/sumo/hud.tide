// Over the lane, in the screen's pixels: the scores, the words when a round
// ends or gravity lets go, what to do first, and the controls. None of it
// shows while the lobby or the menu is up (lobby.tide).
using Box3D;

const float SCORES = 48; // The height of the scores' row

// How much of the screen's bottom right corner the game leaves to the engine's
// stats (the `stats` setting): their one line, which is the frame rate, and in
// a match another machine runs, the ping too.
float StatsCorner(Session session)
{
    return session.server ? 100 : 196;
}

// Whether the window is too narrow for the controls in one row beside the
// stats' corner: they then go in a row above it.
bool Narrow(Session session)
{
    return Screen.width < 496 + StatsCorner(session);
}

// A crown, for whoever leads: its middle at `at`.
void Crown(float2 at, float size, Color color)
{
    Draw2D.RoundRect(at + float2(0, size * 0.25), float2(size * 1.5, size * 0.45), size * 0.12, color);
    for (var i = -1; i <= 1; i++)
        Draw2D.Circle(at + float2(i * size * 0.55, -size * 0.2), size * 0.28, color);
}

// Low gravity shows all over the screen: its edges glow while it lasts. And
// whatever just lit the whole screen fades here.
[Stage(Layers.Hud)]
view Glare(Fx fx, Room room)
{
    Draw2D.SetScreen();
    var screen = float2(Screen.width, Screen.height);
    Draw.Blend(Blend.Add)
    {
        if (room.low > 0)
            Draw2D.Shape(Shape { center = screen * 0.5, size = screen, color = Fade(TEAL, 0.22 * room.low * (0.85 + 0.15 * Math.Sin(fx.beat))),
                                 soft = -Math.Min(screen.x, screen.y) * 0.3 });
        if (fx.flash > 0) Draw2D.Rect(screen * 0.5, screen, Fade(fx.flashColor, fx.flash));
    }
}

// The scores are read `verified`: what the server has confirmed, never a pin
// this machine only predicted falling. Each bowler has its player's, and the
// query goes through them all: side by side in the order of their seats, this
// machine's player's marked, and a crown for whoever leads.
[Stage(Layers.Hud, 10)]
view Scores(verified Lane sure, Fx fx, Lobby lobby, query (verified Bowler bowler) bowlers)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None) return;
    mut var seats = 0;
    mut var count = 0;
    mut var best = 0;
    mut var leader = -1;
    foreach (var entry in bowlers)
    {
        seats |= 1 << entry.bowler.seat;
        count += 1;
        if (entry.bowler.score == best) leader = -1; // Nobody leads a tie
        if (entry.bowler.score <= best) continue;
        best = entry.bowler.score;
        leader = entry.bowler.seat;
    }
    if (count == 0) return;
    var slot = Math.Min(Screen.width / count, 108);
    var first = (Screen.width - slot * count) * 0.5;
    var narrow = slot < 64;
    foreach (var entry in bowlers)
    {
        var seat = entry.bowler.seat;
        // Its place in the row: how many seats before it are taken
        mut var place = 0;
        for (var before = 0; before < seat; before++)
            place += seats >> before & 1;
        var mine = seat == fx.seat;
        var color = SeatColor(seat);
        var middle = float2(first + (place + 0.5) * slot, SCORES * 0.5);
        var pop = fx.pops[seat];
        Draw2D.Shape(Shape { center = middle, size = float2(Math.Min(slot - 6, 96), SCORES - 8), radius = 10,
                             color = mine ? Color(0.21, 0.215, 0.235, 0.96) : Color(0.115, 0.118, 0.13, 0.9),
                             outline = mine ? 1.5 : 0.0, outlineColor = Fade(Color.white, 0.75) });
        var number = $"{entry.bowler.score}";
        var size = Math.Round((narrow ? 18 : 22) * (1 + 0.35 * pop));
        var across = Draw2D.MeasureText(number, size, Font.Bold).x;
        var dot = narrow ? 4.0 : 5.0;
        var left = middle.x - (across + dot * 2 + 6) * 0.5;
        var row = mine || !narrow ? middle.y - 6 : middle.y;
        if (seat == leader) Crown(float2(left + dot, row), dot * 1.4, GOLD);
        else Draw2D.Circle(float2(left + dot, row), dot, color);
        Draw2D.Text(number, float2(left + dot * 2 + 6, row), size, pop > 0 ? Mix(color, Color.white, pop) : color,
                    Anchor.MiddleLeft, Font.Bold);
        if (mine) Draw2D.Text("YOU", middle + float2(0, 12), 10, Color.white, Anchor.MiddleCenter, Font.Bold);
        else if (!narrow) Draw2D.Text(SeatName(seat), middle + float2(0, 12), 9, Fade(QUIET, 0.8), Anchor.MiddleCenter);
    }
    // What's left of the round: beside the scores where there's room, and under them otherwise
    if (sure.phase != Phase.Play) return;
    var beside = first > 76;
    Draw2D.Text($"{sure.standing} LEFT", float2(Screen.width - 12, beside ? SCORES * 0.5 : SCORES + 10), 11, QUIET,
                Anchor.MiddleRight, Font.Bold);
}

// A band across the screen, in a color, with a line of words and a smaller
// one under it: open for `open`, from 0 to 1.
void Band(float2 middle, float open, bool big, Color tint, string words, string under)
{
    var screen = float2(Screen.width, Screen.height);
    var tall = (big ? 84 : 60) * open;
    Draw.Blend(Blend.Add)
    {
        Draw2D.Shape(Shape { center = middle, size = float2(screen.x + 80, tall), color = Fade(tint, 0.25 * open), soft = 40 });
    }
    Draw2D.Shape(Shape { center = middle, size = float2(screen.x + 80, tall), color = Shade(tint, 0.95), color2 = Shade(tint, 0.7) });
    Draw2D.Rect(middle - float2(0, tall * 0.5 + 4), float2(screen.x, 2 * open), Fade(Color.white, 0.85));
    Draw2D.Rect(middle + float2(0, tall * 0.5 + 4), float2(screen.x, 2 * open), Fade(Color.white, 0.85));
    Draw.Tint(Fade(Color.white, Math.Saturate(open * 1.5 - 0.5)))
    {
        var size = big ? 30 : 20;
        // As big as fits
        var fit = Math.Min(1, (screen.x - 24) / Math.Max(1, Draw2D.MeasureText(words, size, Font.Bold).x));
        Draw2D.Text(words, middle - float2(0, under == "" ? 0 : (big ? 9 : 7)), Math.Floor(size * fit), BACK, Anchor.MiddleCenter, Font.Bold);
        if (under != "") Draw2D.Text(under, middle + float2(0, big ? 21 : 15), big ? 14 : 12, Fade(BACK, 0.8), Anchor.MiddleCenter);
    }
}

// The words over the lane: who took a round, which round starts, and gravity
// while it's low. A round's winner is the server's to say, so it comes from a
// `verified` event's handler (effects.tide).
[Stage(Layers.Hud, 20)]
view Words(Lane lane, Session session, Lobby lobby, mut Flow flow, mut Fx fx)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None) return;
    var screen = float2(Screen.width, Screen.height);
    var big = screen.x >= 640 && screen.y >= 420;
    var middle = float2(screen.x * 0.5, SCORES + (screen.y - SCORES) * 0.3);

    if (flow.since < 2.4)
    {
        var open = EaseOut(flow.since / 0.2) * (1 - EaseOut((flow.since - 2.1) / 0.3));
        var mine = flow.winner >= 0 && flow.winner == fx.seat;
        var tint = flow.winner < 0 ? QUIET : SeatColor(flow.winner);
        var words = flow.winner < 0 ? "CLEARED!" : mine ? $"YOU TAKE ROUND {flow.round}" : $"{SeatName(flow.winner)} TAKES ROUND {flow.round}";
        var under = flow.winner < 0 ? "Nobody scored" : flow.best == 1 ? "with 1 point" : $"with {flow.best} points";
        Band(middle, open, big, tint, words, under);
        if (!flow.papered && flow.winner >= 0)
        {
            flow.papered = true;
            Paper(fx, float2(screen.x * 0.3, middle.y), mine ? 40 : 18, 420, tint);
            Paper(fx, float2(screen.x * 0.7, middle.y), mine ? 40 : 18, 420, tint);
        }
    }
    else if (flow.begun < 1.3 && flow.set > 0 && lane.phase == Phase.Play)
    {
        var shown = Math.Saturate(flow.begun * 6) * Math.Saturate((1.3 - flow.begun) * 3);
        var size = Math.Round((big ? 54 : 36) * (1 + 0.3 * Math.Max(0, 1 - flow.begun * 6)) * 0.5) * 2;
        Draw.Tint(Fade(Color.white, shown))
        {
            Draw2D.Text($"ROUND {flow.set}", middle + float2(0, 3), size, Fade(BACK, 0.7), Anchor.MiddleCenter, Font.Bold);
            Draw2D.Text($"ROUND {flow.set}", middle, size, Color.white, Anchor.MiddleCenter, Font.Bold);
        }
    }

    if (lane.low && flow.since >= 2.4)
    {
        // Under the scores: it stays until someone presses Heavy
        var at = float2(screen.x * 0.5, SCORES + 34);
        var enter = EaseBack(flow.lifted / 0.25);
        Draw2D.Shape(Shape { center = at, size = float2(150, 28) * enter, radius = 14, color = Color(0.08, 0.12, 0.12, 0.94),
                             outline = 1.5, outlineColor = TEAL });
        if (enter > 0.9) Draw2D.Text("LOW GRAVITY", at, 13, TEAL, Anchor.MiddleCenter, Font.Bold);
    }

    // The match's host left, and another machine is taking it over
    if (session.state == SessionState.Connecting)
    {
        var at = float2(screen.x * 0.5, SCORES + 70);
        Draw2D.Shape(Shape { center = at, size = float2(Math.Min(screen.x - 16, 300), 34), radius = 17, color = Color(0.1, 0.1, 0.11, 0.94),
                             outline = 1.5, outlineColor = LINE });
        Draw2D.Text("The host left. Finding the match again...", at, 12, INK, Anchor.MiddleCenter);
    }
}

// What a target was worth, rising from where it went through the goal, and
// which place on the line is this machine's player's. They're words, so
// they're drawn on the screen, where the camera puts their place on the lane.
[Stage(Layers.Hud, 25)]
view Tags(Lobby lobby, mut Fx fx)
{
    Draw2D.SetScreen();
    mut var i = 0;
    while (i < fx.labels.count)
    {
        mut var label = fx.labels[i];
        label.age += fx.dt;
        if (label.age >= label.life)
        {
            fx.labels.RemoveAt(i);
            continue;
        }
        fx.labels[i] = label;
        i++;
        if (lobby.page != Page.None) continue;
        var t = label.age / label.life;
        var place = Draw3D.WorldToScreen(label.at + float3(0, EaseOut(t) * 1.6, 0));
        var size = Math.Round((label.mine ? 26 : 18) * (label.amount >= 5 ? 1.3 : 1) * (0.6 + 0.4 * EaseBack(t * 5)));
        var shown = Math.Saturate((1 - t) * 3);
        Draw2D.Text($"+{label.amount}", float2(place.x + 1.5, place.y + 2), size, Fade(BACK, shown * 0.85), Anchor.MiddleCenter, Font.Bold);
        Draw2D.Text($"+{label.amount}", float2(place.x, place.y), size, Fade(Mix(label.color, Color.white, label.mine ? 0.35 : 0.1), shown),
                    Anchor.MiddleCenter, Font.Bold);
    }
    if (lobby.page != Page.None || fx.seat < 0) return;
    Draw2D.Text("YOU", fx.mine + float2(1, 1.5), 12, Fade(BACK, 0.8), Anchor.MiddleCenter, Font.Bold);
    Draw2D.Text("YOU", fx.mine, 12, Color.white, Anchor.MiddleCenter, Font.Bold);
}

// What to do first, until the player has done it: throw, and then spin.
[Stage(Layers.Hud, 30)]
view Hints(Lane lane, Session session, Devices devices, Fx fx, Flow flow, Lobby lobby)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None || fx.seat < 0 || lane.phase != Phase.Play) return;
    var screen = float2(Screen.width, Screen.height);
    mut var words = "";
    if (!fx.thrown) words = devices.touchscreen.connected ? "Touch down the lane, and hold to throw" : "Point down the lane, and hold to throw";
    else if (!fx.spun && flow.played > 4 && flow.played < 16) words = "Set a spin to curve the ball";
    if (words == "") return;
    var wide = Draw2D.MeasureText(words, 14).x + 28;
    // Over the controls, out of the pins' way
    var at = float2(screen.x * 0.5, screen.y - (Narrow(session) ? 130 : 80) + Math.Sin(fx.beat * 2) * 2);
    Draw2D.Shape(Shape { center = at, size = float2(wide, 30), radius = 15, color = Color(0.1, 0.1, 0.11, 0.92),
                         outline = 1.5, outlineColor = LINE });
    Draw2D.Text(words, at, 14, INK, Anchor.MiddleCenter);
}

// The spin's slider: a control, whose input the GUI handles, drawn here. While
// the pointer holds it, the spin is where the pointer is along it, and it
// rests in the middle when it's let go near there. The ball on it turns the
// way a thrown one would curve.
void SpinSlider(Rect rect, Devices devices, mut Hand hand, mut Fx fx)
{
    var slider = GUI.Control(rect);
    var span = rect.width - 76;
    var start = rect.x + 58;
    if (slider.pressed)
    {
        var along = (Screen.Flip(devices.pointer.position).x - start) / Math.Max(span, 1) * 2 - 1;
        hand.spin = Math.Abs(along) < 0.08 ? 0 : Math.Clamp(along, -1, 1);
        fx.spun = true;
    }
    var middle = Middle(rect);
    var lit = slider.hovered || slider.pressed || slider.focused;
    Draw2D.Shape(Shape { center = middle, size = float2(rect.width, rect.height), radius = 12, color = Fade(RAISED, 0.97),
                         outline = slider.focused ? 2.2 : 1.5, outlineColor = slider.focused ? Color.white : lit ? AMBER : LINE });
    Draw2D.Text("SPIN", float2(rect.x + 12, middle.y), 11, QUIET, Anchor.MiddleLeft, Font.Bold);
    Draw2D.RoundRect(float2(start + span * 0.5, middle.y), float2(span, 4), 2, Color(0.08, 0.08, 0.09));
    Draw2D.RoundRect(float2(start + span * 0.5, middle.y), float2(2, 12), 1, LINE);
    var knob = float2(start + span * (hand.spin * 0.5 + 0.5), middle.y);
    // What's between the middle and the knob is lit
    Draw2D.RoundRect(float2((start + span * 0.5 + knob.x) * 0.5, middle.y), float2(Math.Abs(knob.x - start - span * 0.5), 4), 2, AMBER);
    Draw2D.Circle(knob, 11, slider.pressed ? Color.white : INK);
    Draw2D.Circle(knob, 8, AMBER);
    Draw2D.Line(knob + Turned(float2(-6, 0), hand.spin * 1.2), knob + Turned(float2(6, 0), hand.spin * 1.2), 3, Color.white);
}

// The controls. Each button is a control too (lobby.tide): solid, so that it
// reads over the lane, and as tall as a finger needs. Float and Sweep are
// commands: the match handles them. The bottom right corner is the engine's
// stats', so a narrow window has its controls in a row above it.
[Stage(Layers.Hud, 40)]
view Controls(Lane lane, Session session, Devices devices, mut Hand hand, mut Fx fx, mut Lobby lobby,
    query (Sweeper sweeper) bars)
{
    Draw2D.SetScreen();
    if (lobby.page != Page.None) return;
    var screen = float2(Screen.width, Screen.height);
    mut var rest = 0.0;
    foreach (var entry in bars)
    {
        if (entry.sweeper.sweeping) rest = 1;
        else if (entry.sweeper.rest > 0) rest = entry.sweeper.rest / float(SWEEP_REST);
    }
    var narrow = Narrow(session);
    var bottom = screen.y - 52;
    var row = narrow ? bottom - 50 : bottom;
    var left = narrow ? 8.0 : 100.0;
    var buttons = narrow ? Math.Min(84, (screen.x - 28) * 0.24) : 88.0;
    var slide = narrow ? screen.x - 28 - buttons * 2 : 200.0;
    var keys = devices.keyboard;

    SpinSlider(Rect(left, row, slide, 44), devices, hand, fx);
    var floats = Rect(left + slide + 6, row, buttons, 44);
    var sweeps = Rect(left + slide + 12 + buttons, row, buttons, 44);
    var lift = Pill(floats, lane.low ? "HEAVY" : "FLOAT", TEAL, lane.low, true);
    var sweep = Pill(sweeps, "SWEEP", ROSE, false, rest <= 0);
    // The bar's rest, running out along its button
    if (rest > 0) Draw2D.RoundRect(float2(sweeps.x + 8 + (sweeps.width - 16) * (1 - rest) * 0.5, sweeps.y + 38),
                                   float2((sweeps.width - 16) * (1 - rest), 3), 1.5, Fade(ROSE, 0.8));

    if (session.room != "" && narrow)
    {
        // Beside the Menu button, and narrow enough to leave the stats their corner
        Draw2D.Text("ROOM", float2(102, screen.y - 39), 10, QUIET, Anchor.MiddleLeft, Font.Bold);
        Draw2D.Text(session.room, float2(102, screen.y - 23), 14, INK, Anchor.MiddleLeft, Font.Bold);
    }
    else if (session.room != "")
    {
        // Over the Menu button
        Draw2D.Text($"ROOM {session.room}", float2(12, bottom - 8), 12, INK, Anchor.LowerLeft, Font.Bold);
    }
    var menu = Pill(Rect(8, bottom, 84, 44), "MENU", INK, false, true);
    if (menu || keys.escape.down)
    {
        lobby.page = Page.Room;
        lobby.resume = true;
    }
    if (session.state != SessionState.Connected) return;
    if (lift || keys.g.down) Send(Float { });
    if (sweep || (keys.s.down && rest <= 0)) Send(Sweep { });
    if (keys.r.down) Send(Rebuild { });
}

// Paper for a round's winner, over everything but the menu.
[Stage(Layers.Hud, 50)]
view Confetti(mut Fx fx)
{
    Draw2D.SetScreen();
    mut var i = 0;
    while (i < fx.paper.count)
    {
        mut var bit = fx.paper[i];
        bit.age += fx.dt;
        if (bit.age >= bit.life)
        {
            fx.paper.RemoveAt(i);
            continue;
        }
        bit.velocity.y += 620 * fx.dt;
        bit.velocity = bit.velocity * Math.Max(0, 1 - 1.3 * fx.dt);
        bit.position += bit.velocity * fx.dt;
        bit.angle += bit.spin * fx.dt;
        fx.paper[i] = bit;
        // It turns over as it falls
        var flat = Math.Abs(Math.Sin(bit.angle * 1.7));
        Draw2D.Rect(bit.position, float2(bit.size, bit.size * (0.25 + 0.75 * flat)), bit.angle,
                    Fade(bit.color, (1 - bit.age / bit.life) * 3));
        i++;
    }
}
