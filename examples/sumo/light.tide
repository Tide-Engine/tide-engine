// How Sumo is lit. The engine has no lighting built in, so everything here is
// a mesh whose corners have a normal, drawn through a frag that lights each
// pixel from it: a lamp over the camera's left shoulder, a cool light from the
// far right, the sky's own glow, a shine where the lamp reflects, and the dark
// of the drop for what's far.
//
// Shadows are the things themselves, flattened onto the floor along the
// lamp's light and drawn in the floor's own paint, darker: a tower's shadow
// is as long as the tower is high, and falls across the tiles behind it.
using Box3D;

// A corner of a mesh: where it is, which way its face looks, and its paint.
struct Corner
{
    float3 position;
    float3 normal;
    Color color = Color.white;
    float mark;
}

// The meshes, made once: a box and a ball to draw at every body's place, and
// a flat square for what's painted on the floor.
local singleton Models
{
    List<Corner> cube;
    List<int> cubeFaces;
    List<Corner> ball;
    List<int> ballFaces;
    List<Corner> plate;
    List<int> plateFaces;
    bool made;
}

// What the frags read of the camera and of the ring.
local singleton Room
{
    float3 eye;     // Where the camera is, for what shines
    float beat;     // Radians, for what pulses
}

// The floor, a cell a tile: whether it's there (red), and whether it's about
// to fall (green). A frag reads it as a texture, so the floor's paint and the
// shadows that fall on it know where the floor ends.
local singleton Ground
{
    Grid2<Color> floor = Grid2(15, 15);
}

// A box that's drawn: a crate, a plank, a keg, a tile. One of a list, all
// drawn at once, and once more, flattened, for their shadows.
struct Solid
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
    float kind;   // What it's painted as: a Kind's number
    float low;    // It's under the floor, where nothing has a shadow
}

// Something flat on the floor: a ring around a ball, a blast's edge.
struct Decal
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.black;
    float ring;   // Only its rim, this much of its radius wide, when it's above 0
    float arc = 1;  // How much of the way round it goes, from 0 to 1
}

// A spark: a small cube that glows. One of a list too.
struct Mote
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
}

// Where the lamp is, from anywhere.
float3 Lamp()
{
    return Math.Normalize(float3(-0.5, 0.8, -0.34));
}

// What takes a thing to its shadow: every point slides along the lamp's
// light until it's on the floor, a hair over it.
float4x4 Flatten()
{
    float3 lamp = Lamp();
    float across = lamp.x / lamp.y;
    float along = lamp.z / lamp.y;
    float lift = 0.012;
    return float4x4(float4(1, 0, 0, 0), float4(-across, 0, -along, 0), float4(0, 0, 1, 0), float4(across * lift, lift, along * lift, 1));
}

// A surface's paint in the ring's light.
Color Lit(Color paint, float3 normal, float3 world, Room room, float gloss)
{
    float3 lamp = Lamp();
    float3 toEye = Math.Normalize(room.eye - world);
    float direct = Math.Max(Math.Dot(normal, lamp), 0);
    float fill = Math.Max(Math.Dot(normal, Math.Normalize(float3(0.6, 0.25, 0.7))), 0);
    float sky = 0.36 + 0.16 * normal.y;
    float shine = Math.Pow(Math.Max(Math.Dot(normal, Math.Normalize(lamp + toEye)), 0), 26) * gloss;
    float rim = Math.Pow(1 - Math.Max(Math.Dot(normal, toEye), 0), 3) * 0.12;
    float3 base = float3(paint.r, paint.g, paint.b);
    float3 cool = float3(0.5, 0.72, 1);
    mut float3 lit = base * (sky + direct * 0.7) + base * cool * (fill * 0.24) + float3(shine) + cool * rim;
    // What's deep under the floor sinks into the dark
    float deep = Math.Saturate((-2 - world.y) / 14);
    lit = lit + (float3(0.086, 0.086, 0.094) - lit) * deep;
    return Color(lit.x, lit.y, lit.z, paint.a);
}

// The floor's paint at a place: its tile's own tone, a seam around each
// tile, a line of light along an edge with nothing past it, and the rose a
// tile turns before it falls. Its alpha is whether there's a floor there.
// `here` is the floor's grid at that place, and `sides` whether there's a
// tile to its left, its right, below it and above it: a frag reads those,
// as only a frag samples a grid.
Color FloorPaint(float3 world, Color here, float4 sides, float beat)
{
    float2 cell = float2(world.x, world.z) / TILE + float2(7.5);
    float2 inside = float2(Math.Frac(cell.x), Math.Frac(cell.y));
    int2 tile = int2(int(Math.Floor(cell.x)), int(Math.Floor(cell.y)));
    float tone = 0.9 + (Math.Hash(tile) % 12) * 0.012;
    mut float3 paint = float3(0.25, 0.27, 0.33) * tone;
    // The seam around the tile
    float edge = Math.Min(Math.Min(inside.x, 1 - inside.x), Math.Min(inside.y, 1 - inside.y)) * TILE;
    if (edge < 0.05) paint = paint * 0.72;
    // A cross of studs, so that the floor's speed shows under a ball
    float2 stud = float2(Math.Abs(inside.x - 0.5), Math.Abs(inside.y - 0.5)) * TILE;
    if (Math.Max(stud.x, stud.y) < 0.09) paint = paint * 1.25;
    // Where the floor ends: a line of light along the edge, by which side has no tile
    mut float open = 0;
    if (inside.x * TILE < 0.22 && sides.x < 0.5) open = 1;
    if ((1 - inside.x) * TILE < 0.22 && sides.y < 0.5) open = 1;
    if (inside.y * TILE < 0.22 && sides.z < 0.5) open = 1;
    if ((1 - inside.y) * TILE < 0.22 && sides.w < 0.5) open = 1;
    float3 amber = float3(0.98, 0.75, 0.14);
    float3 rose = float3(0.98, 0.44, 0.52);
    // A tile that's about to go
    float going = here.g * (0.55 + 0.45 * Math.Sin(beat * 4));
    paint = paint + (rose * 0.8 - paint) * going * 0.7;
    if (open > 0) paint = here.g > 0 ? rose * 1.2 : amber * 1.15;
    return Color(paint.x, paint.y, paint.z, here.r);
}

// A tile: its top is the floor's paint, and its sides are dark, with the
// edge's light along their top.
frag TileLook(Corner corner, mut Color color, Solid solid, Pixel pixel, Room room, Ground ground)
{
    if (corner.normal.y > 0.5)
    {
        float2 uv = (float2(pixel.world.x, pixel.world.z) / TILE + float2(7.5)) / 15;
        float step = 1.0 / 15;
        float4 sides = float4(ground.floor.Sample(uv - float2(step, 0), Filter.Point).r, ground.floor.Sample(uv + float2(step, 0), Filter.Point).r,
                              ground.floor.Sample(uv - float2(0, step), Filter.Point).r, ground.floor.Sample(uv + float2(0, step), Filter.Point).r);
        Color paint = FloorPaint(pixel.world, ground.floor.Sample(uv, Filter.Point), sides, room.beat);
        color = Lit(Color(paint.r, paint.g, paint.b, 1), corner.normal, pixel.world, room, 0.35);
        // What glows is its own light
        if (paint.r > 0.9) color = Color(paint.r, paint.g, paint.b, 1);
        return;
    }
    float down = -pixel.world.y;
    mut Color side = Color(0.13, 0.14, 0.17);
    if (down < 0.12) side = solid.tint;
    color = Lit(side, corner.normal, pixel.world, room, 0);
    if (down < 0.12) color = Color(solid.tint.r, solid.tint.g, solid.tint.b, 1);
}

// A crate has a frame around each face, a shade darker, and a keg a band.
frag CrateLook(Corner corner, mut Color color, Solid solid, Instance instance, Pixel pixel, Room room)
{
    float3 at = float3(Math.Abs(corner.position.x), Math.Abs(corner.position.y), Math.Abs(corner.position.z));
    // The middle one of the three is how near the face's edge this is
    float edge = at.x + at.y + at.z - Math.Max(at.x, Math.Max(at.y, at.z)) - Math.Min(at.x, Math.Min(at.y, at.z));
    mut float tone = edge > 0.44 ? 0.66 : edge > 0.39 ? 0.84 : 1;
    if (solid.kind > 1.5 && solid.kind < 2.5 && at.y < 0.14) tone = 1.9;
    if (solid.kind > 2.5)
    {
        // A tile that fell keeps the floor's look
        tone = 1;
    }
    Color paint = Color(solid.tint.r * tone, solid.tint.g * tone, solid.tint.b * tone, 1);
    color = Lit(paint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)), pixel.world, room, 0.25);
}

// A shadow: the floor's paint where it falls, darker, and nothing where
// there's no floor to fall on. Whatever is under the floor casts none: its
// corners are all put in one place, which draws nothing.
vert ShadowDrop(mut Corner corner, Solid solid)
{
    if (solid.low > 0.5) corner.position = float3(0);
}

frag ShadowLook(Corner corner, mut Color color, Solid solid, Pixel pixel, Room room, Ground ground)
{
    float2 uv = (float2(pixel.world.x, pixel.world.z) / TILE + float2(7.5)) / 15;
    float step = 1.0 / 15;
    float4 sides = float4(ground.floor.Sample(uv - float2(step, 0), Filter.Point).r, ground.floor.Sample(uv + float2(step, 0), Filter.Point).r,
                          ground.floor.Sample(uv - float2(0, step), Filter.Point).r, ground.floor.Sample(uv + float2(0, step), Filter.Point).r);
    Color paint = FloorPaint(pixel.world, ground.floor.Sample(uv, Filter.Point), sides, room.beat);
    if (paint.a < 0.5) pixel.Discard();
    Color lit = Lit(Color(paint.r, paint.g, paint.b, 1), float3(0, 1, 0), pixel.world, room, 0);
    color = Color(lit.r * 0.46, lit.g * 0.47, lit.b * 0.54, 1);
}

// A ball: its player's color, with a white band around it and a dark cap at
// each end, so that its roll shows. A heavy one is dark, with its color in
// the band. It glows as it winds up, and flashes when it's hit.
frag BallLook(Corner corner, mut Color color, Instance instance, Pixel pixel, Room room, Ball ball)
{
    Color seat = SeatColor(ball.seat);
    float band = Math.Abs(corner.position.y);
    mut Color paint = band < 0.2 ? Color.white : band > 0.82 ? Shade(seat, 0.45) : seat;
    if (ball.heavy > 0) paint = band < 0.2 ? seat : band > 0.82 ? Color(0.5, 0.52, 0.58) : Color(0.16, 0.17, 0.2);
    paint = Mix(paint, Color.white, Math.Saturate(ball.flash + ball.charge * (0.35 + 0.25 * Math.Sin(room.beat * 14))));
    color = Lit(paint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)), pixel.world, room, ball.heavy > 0 ? 1.6 : 1.0);
}

// Anything of one color, lit: a pickup.
frag Plain(Corner corner, mut Color color, Solid solid, Instance instance, Pixel pixel, Room room)
{
    color = Lit(solid.tint, Math.Normalize(Math.Rotate(instance.transform, corner.normal)), pixel.world, room, 0.9);
}

// What's flat on the floor: a disc that fades at its edge, a ring, or part of
// one, going round from the top.
frag DecalLook(Corner corner, mut Color color, Decal decal, Pixel pixel, Ground ground)
{
    if (ground.floor.Sample((float2(pixel.world.x, pixel.world.z) / TILE + float2(7.5)) / 15, Filter.Point).r < 0.5) pixel.Discard();
    float2 at = float2(corner.position.x, corner.position.z) * 2;
    float far = Math.Length(at);
    mut float shown = Math.Saturate((1 - far) * 8);
    if (decal.ring > 0) shown = shown * Math.Saturate((far - (1 - decal.ring)) * 8);
    if (decal.arc < 1)
    {
        mut float around = Math.Atan2(at.x, at.y) / Math.TAU;
        if (around < 0) around += 1;
        if (around > decal.arc) shown = 0;
    }
    color = Color(decal.tint.r, decal.tint.g, decal.tint.b, decal.tint.a * shown);
}

frag MoteLook(Corner corner, mut Color color, Mote mote)
{
    color = mote.tint;
}

// A box's six faces, four corners each, added to a mesh.
void AddBox(mut List<Corner> corners, mut List<int> faces, float3 center, float3 size, Color color, float mark)
{
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        float way = face % 2 == 0 ? 1 : -1;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        var first = corners.count;
        for (var i = 0; i < 4; i++)
        {
            float a = i == 0 || i == 3 ? -0.5 : 0.5;
            float b = i < 2 ? -0.5 : 0.5;
            corners.Add(Corner { position = center + (normal * 0.5 + across * a + up * b) * size, normal = normal, color = color,
                                 mark = mark });
        }
        faces.Add(first);
        faces.Add(first + 1);
        faces.Add(first + 2);
        faces.Add(first);
        faces.Add(first + 2);
        faces.Add(first + 3);
    }
}

// A ball: rings of corners from its bottom to its top.
void AddBall(mut List<Corner> corners, mut List<int> faces, int rings, int around)
{
    for (var ring = 0; ring <= rings; ring++)
    {
        float tilt = ring * Math.PI / rings;
        for (var step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            var out = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
            corners.Add(Corner { position = out, normal = out });
            if (ring == rings || step == around) continue;
            int at = ring * (around + 1) + step;
            faces.Add(at);
            faces.Add(at + around + 1);
            faces.Add(at + 1);
            faces.Add(at + 1);
            faces.Add(at + around + 1);
            faces.Add(at + around + 2);
        }
    }
}

void MakeModels(mut Models models)
{
    models.made = true;
    AddBox(models.cube, models.cubeFaces, float3(0), float3(1), Color.white, 0);
    AddBall(models.ball, models.ballFaces, 14, 20);
    models.plate = [Corner { position = float3(-0.5, 0, -0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(0.5, 0, -0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(0.5, 0, 0.5), normal = float3(0, 1, 0) },
                    Corner { position = float3(-0.5, 0, 0.5), normal = float3(0, 1, 0) }];
    models.plateFaces = [0, 1, 2, 0, 2, 3];
}
