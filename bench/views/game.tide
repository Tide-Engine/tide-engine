// Views that run once for each of many entities (bench/views/main.c times
// each one): over a component of many fields that they read a few of, as a
// query's rows and as a view's own parameter, against the same over a small
// component; and a helper each run hands a big local singleton's lists to read
// while it adds to another's (a far crowd, as a battle of thousands keeps it).

const int COUNT = 20000;

scene Main { }

// About as wide as a fighter in a battle of thousands: 75 lanes.
component Wide
{
    float3 position;
    float yaw;
    float4 rows;
    float pitch;
    float spare0; float spare1; float spare2; float spare3; float spare4; float spare5; float spare6; float spare7; float spare8; float spare9;
    float spare10; float spare11; float spare12; float spare13; float spare14; float spare15; float spare16; float spare17; float spare18; float spare19;
    float spare20; float spare21; float spare22; float spare23; float spare24; float spare25; float spare26; float spare27; float spare28; float spare29;
    float spare30; float spare31; float spare32; float spare33; float spare34; float spare35; float spare36; float spare37; float spare38; float spare39;
    float spare40; float spare41; float spare42; float spare43; float spare44; float spare45; float spare46; float spare47; float spare48; float spare49;
    float spare50; float spare51; float spare52; float spare53; float spare54; float spare55; float spare56; float spare57; float spare58; float spare59;
    float spare60; float spare61; float spare62; float spare63; float spare64; float spare65;
    local float feetYaw;
    local float4x4 placed;
    local bool picked;
}

// As a soldier is: a few numbers a frame draws between two ticks, among many
// that are what the tick has (counts, kinds, flags): 80 lanes, 16 of them blended
component Mixed
{
    float3 position;
    float3 velocity;
    float yaw; float pitch; float lean; float aim;
    float4 pose;
    float reach; float stride;
    int kit0; int kit1; int kit2; int kit3; int kit4; int kit5; int kit6; int kit7; int kit8; int kit9;
    int kit10; int kit11; int kit12; int kit13; int kit14; int kit15; int kit16; int kit17; int kit18; int kit19;
    int kit20; int kit21; int kit22; int kit23; int kit24; int kit25; int kit26; int kit27; int kit28; int kit29;
    int kit30; int kit31; int kit32; int kit33; int kit34; int kit35; int kit36; int kit37; int kit38; int kit39;
    int kit40; int kit41; int kit42; int kit43; int kit44; int kit45; int kit46; int kit47; int kit48; int kit49;
    int kit50; int kit51; int kit52; int kit53; int kit54; int kit55; int kit56; int kit57; int kit58; int kit59;
    bool down; bool armed; bool holstered; bool sprinting;
}

component Small
{
    float3 position;
    float pitch;
}

struct Item
{
    float4x4 transform;
    float4 rows;
}

// Each row's bones, read a few at a time
local singleton Skins
{
    bool made;
    List<float4x4> skins;
    List<float4x4> hips;
    List<float4> spineOn;
    List<float4> spineAt;
}

// What each far one adds
local singleton Crowd
{
    List<Item> items;
}

local singleton Sink
{
    float total;
}

event(Spawned) Setup(with Main)
{
    for (int i = 0; i < COUNT; i++)
    {
        Spawn(Small { position = float3(i, 0, 0) });
        if (i % 4 == 0) Spawn(Mixed { position = float3(i, 0, 0), kit3 = i });
        Spawn(Wide { position = float3(i, 0, 0), rows = float4(i % 400, i % 400 + 1, (i * 7) % 400, (i * 7) % 400 + 1) });
    }
}

system MoveWide(mut Wide w)
{
    w.pitch += 0.01;
    w.position.x += 0.01;
}

system MoveMixed(mut Mixed m)
{
    m.position.x += 0.01;
    m.yaw += 0.01;
    m.kit7 += 1;
}

system MoveSmall(mut Small s)
{
    s.pitch += 0.01;
}

[Before(PitchWide)]
view Prepare(mut Skins skins)
{
    if (skins.made) return;
    skins.made = true;
    for (int i = 0; i < 25905; i++) skins.skins.Add(float4x4.identity);
    for (int i = 0; i < 471; i++)
    {
        skins.hips.Add(float4x4.identity);
        skins.spineOn.Add(float4(i, 0, 0, 1));
        skins.spineAt.Add(float4(0, i, 0, 1));
    }
}

view PitchWide(Wide w, mut Sink sink)
{
    sink.total += w.pitch * 0;
}

view PitchSmall(Small s, mut Sink sink)
{
    sink.total += s.pitch * 0;
}

view QueryWide(mut Sink sink, query (Wide w) all)
{
    foreach (var row in all) sink.total += row.w.pitch * 0;
}

view QuerySmall(mut Sink sink, query (Small s) all)
{
    foreach (var row in all) sink.total += row.s.pitch * 0;
}

float3 Shift(List<float4x4> hipsAt, List<float4> spineOn, List<float4> spineAt, float4 rows)
{
    var legs = int(Math.Floor(rows.x));
    var arm = int(Math.Floor(rows.z));
    var on = Math.Lerp(spineOn[arm], spineOn[int(rows.w)], rows.z - arm);
    var at = Math.Lerp(spineAt[arm], spineAt[int(rows.w)], rows.z - arm);
    return Math.Mul(hipsAt[legs], float4(on.x, on.y, on.z, 1)).xyz + hipsAt[int(rows.y)].c3.xyz - at.xyz;
}

void KeepFar(mut Crowd crowd, Skins skins, Wide w)
{
    mut var rows = w.rows;
    rows.x += Shift(skins.hips, skins.spineOn, skins.spineAt, w.rows).x * 0;
    crowd.items.Add(Item { transform = float4x4.TRS(w.position, quaternion.Euler(0, w.feetYaw, 0), float3(1)), rows = rows });
}

view Far(mut Wide w, mut Crowd crowd, Skins skins)
{
    w.feetYaw = w.yaw;
    if (skins.made) KeepFar(crowd, skins, w);
}

[After(Far)]
view DrawCrowd(mut Crowd crowd)
{
    crowd.items.Clear();
}

// A far man's place worked out for each row and kept in its local fields, in
// order and in a parallel loop (bench_views <frames> <alpha> threads hands the
// frame's loops the pool): what a crowd's view does before it draws.
float4x4 Place(float3 at, float yaw, float pitch)
{
    mut var lean = 0.0;
    for (int i = 0; i < 6; i++) lean += Math.Sin(yaw * (i + 1) + pitch) * 0.01;
    return float4x4.TRS(at, quaternion.Euler(lean, yaw, 0), float3(1));
}

[After(DrawCrowd)]
view PlaceEach(query (mut Wide w) all)
{
    foreach (var row in all) row.w.placed = Place(row.w.position, row.w.yaw, row.w.pitch);
}

[After(PlaceEach)]
view PlaceAtOnce(query (mut Wide w) all)
{
    parallel (var row in all) row.w.placed = Place(row.w.position, row.w.yaw, row.w.pitch);
}

// One row in 400 acted on, each read whole: a guard on a local field turns the
// rest away before they're copied and blended (FewGuarded), where the same
// test through a call copies every row first (FewPlain).
float AllOf(Wide w)
{
    return w.pitch + w.spare65 + w.rows.x;
}

[After(PlaceAtOnce)]
view Pick(mut Wide w)
{
    w.picked = w.rows.x < 1;
}

[After(Pick)]
view FewGuarded(Wide w, mut Sink sink)
{
    if (!w.picked) return;
    sink.total += AllOf(w) * 0;
}

bool Same(bool value) { return value; }

[After(FewGuarded)]
view FewPlain(Wide w, mut Sink sink)
{
    if (!Same(w.picked)) return;
    sink.total += AllOf(w) * 0;
}


// Every field of it read, so the row is copied whole whatever a C compiler can see through
float Mass(Mixed m)
{
    var kit = m.kit0 + m.kit1 + m.kit2 + m.kit3 + m.kit4 + m.kit5 + m.kit6 + m.kit7 + m.kit8 + m.kit9 + m.kit10 + m.kit11 + m.kit12 + m.kit13 + m.kit14 + m.kit15 + m.kit16 + m.kit17 + m.kit18 + m.kit19 + m.kit20 + m.kit21 + m.kit22 + m.kit23 + m.kit24 + m.kit25 + m.kit26 + m.kit27 + m.kit28 + m.kit29 + m.kit30 + m.kit31 + m.kit32 + m.kit33 + m.kit34 + m.kit35 + m.kit36 + m.kit37 + m.kit38 + m.kit39 + m.kit40 + m.kit41 + m.kit42 + m.kit43 + m.kit44 + m.kit45 + m.kit46 + m.kit47 + m.kit48 + m.kit49 + m.kit50 + m.kit51 + m.kit52 + m.kit53 + m.kit54 + m.kit55 + m.kit56 + m.kit57 + m.kit58 + m.kit59;
    return m.position.x + m.position.y + m.position.z + m.velocity.x + m.velocity.y + m.velocity.z + m.yaw + m.pitch + m.lean + m.aim
        + m.pose.x + m.pose.y + m.pose.z + m.pose.w + m.reach + m.stride + kit + (m.down || m.armed || m.holstered || m.sprinting ? 1 : 0);
}

// A row read whole (its value copied): every lane gathered, and of the tick
// before only what blends (5,000 rows)
[After(FewPlain)]
view MixedWhole(Mixed m, mut Sink sink)
{
    var all = m;
    sink.total += Mass(all) * 0;
}

// MixedWhole again, with the rows' memory already read this frame
[After(MixedWhole)]
view MixedWarm(Mixed m, mut Sink sink)
{
    var all = m;
    sink.total += Mass(all) * 0;
}
