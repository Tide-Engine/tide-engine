  "phase_instrumentation": "Three tide_time_now_ns readings bracket tide_run_systems and tide_apply_commands in tide_world_tick_on. The host collects producer and dispatch phase medians for ticks after the ten warmup ticks, independently of the normal whole-tick measurement.",
  "baseline_generated_game_sha256": "10a9c7d5c1b67d3b9901bb266717e4e7d0d138168b7c54a80694fb7b2d4f12bd",
  "baseline_host_sha256": "f4bbbb13557c67927170b8781d38f0e639d865e67f00613bc8b8e60bf4a79082",
  "reproduction": [
    "cmake --build --preset release --target versus_events",
