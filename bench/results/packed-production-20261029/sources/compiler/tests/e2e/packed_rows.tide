scene Main { }
component Body { int id; float value; }
component Marker { int id; }
[Sparse] component Frozen { }
singleton Observed { int ordered; int first; int shared; }
event Nudge { }

event(Spawned) Setup(with Main)
{
    for (var i = 0; i < 4103; i++)
    {
        if (i % 5 != 0) Spawn(Body { id = i, value = float(i) }, Frozen);
        else Spawn(Body { id = i, value = float(i) });
    }
}

void Bump(mut Body body, float amount) { body.value += amount; }
void Forward(mut Body body, float amount) { Bump(body, amount); }
system Pure(mut Body body, Time time, without Frozen)
{
    Forward(body, time.dt);
    body.value = Math.Min(body.value, 5000);
}

[After(Pure)]
system Shared(Body body, mut Observed seen, without Frozen) { seen.shared += body.id; }

extern void Record(int id);
void ThroughC(int id) { Record(id); }
[After(Shared)]
system External(Body body, without Frozen) { ThroughC(body.id); }

[After(External)]
system IndirectQueue(mut Body body, without Frozen)
{
    Emit(body.id);
    body.value += 0;
}
void Emit(int id) { if (id == 0) Spawn(Marker { id = id }); }

[After(IndirectQueue)]
system Queued(Body body, Time time)
{
    if ((body.id + time.tick) % 7 == 0) this.Add(Frozen);
    else if ((body.id + time.tick) % 11 == 0) this.Remove(Frozen);
    if (body.id == time.tick) this.Send(Nudge { });
}
event(Nudge nudge) NudgeBody(mut Body body) { body.value += 2; }

[After(Queued)]
system Query(mut Observed seen, query (Body body) bodies)
{
    seen.ordered = 0;
    seen.first = -1;
    foreach (var row in bodies)
    {
        seen.ordered = seen.ordered * 31 + row.body.id;
        if (seen.first < 0) seen.first = row.body.id;
    }
}
