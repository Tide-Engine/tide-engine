file(READ "${GAME_C}" code)
foreach(name Pure)
    if(NOT code MATCHES "static void tide_packed_task_${name}\\(")
        message(FATAL_ERROR "Numeric helper system ${name} did not get a packed wrapper")
    endif()
endforeach()
foreach(name Shared External IndirectQueue Queued Query)
    if(code MATCHES "static void tide_packed_task_${name}\\(")
        message(FATAL_ERROR "Order-sensitive system ${name} got a packed wrapper")
    endif()
endforeach()
