struct tt_Render3D_1MeshVertex {
    vec3 m_position;
    vec3 m_normal;
    vec2 m_uv;
    vec4 m_color;
    vec4 m_tangent;
};
mat3 tide_normals(mat4 m) {
    vec3 a = cross(m[1].xyz, m[2].xyz);
    vec3 b = cross(m[2].xyz, m[0].xyz);
    vec3 c = cross(m[0].xyz, m[1].xyz);
    if (dot(m[0].xyz, a) < 0.0) {
        return mat3(-a, -b, -c);
    }
    return mat3(a, b, c);
}
void main() {
