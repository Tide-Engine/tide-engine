+            || position.x >= block->minimum.x + size || position.y >= block->minimum.y + size
+            || position.z >= block->minimum.z + size) continue;
+        if (!chosen || block->spacing < chosen->spacing) { chosen = block; chosen_slot = slot; }
+    }
+    if (!chosen) {
+        puts("enclosure diagnostics: CPU receiver has no containing block");
+        return true;
+    }
