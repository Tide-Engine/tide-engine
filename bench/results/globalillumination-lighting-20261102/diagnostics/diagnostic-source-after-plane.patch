+    const float spacing = chosen->spacing;
+    const tide_list block_probes = chosen->probes;
+    printf("enclosure diagnostics receiver(%g,%g,%g) block%d minimum(%g,%g,%g) spacing%g\n",
+        (double)receiver.x, (double)receiver.y, (double)receiver.z, chosen_slot,
+        (double)minimum.x, (double)minimum.y, (double)minimum.z, (double)spacing);
