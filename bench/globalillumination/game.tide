// The primary room stays identical as separated buildings are added around it.
// Scene construction is match state; benchmark animation is local rendering.
using Render3D;
scene Main;
asset Mesh3D box = "../../docs/examples/assets/render3d/cube.obj";
asset Mesh3D ball = "../../docs/examples/assets/render3d/sphere.obj";

singleton Workload
{
    bool district;
    int buildings = 64;
    bool built;
}

local singleton Controls
{
    bool enabled;
    int updates;
    bool quick;
    bool debug;
    bool overview;
    bool travel;
    bool movingLight;
    bool validationView;
    bool lightBuilt;
    float seconds;
}

int DistrictColumns(int count)
{
    mut int columns = 1;
    while (columns * columns < count) columns++;
    return columns;
}

float3 BuildingOffset(int index, int columns)
{
    int row = index / columns;
    mut int column = index % columns;
    if (row % 2 == 1) column = columns - 1 - column;
    return float3(float(column * 24), 0, float(row * 24));
}

void BuildRoom(float3 origin)
{
    Spawn(MeshRenderer { mesh = box }, Material { baseColor = Color(0.85, 0.85, 0.85), roughness = 0.85 },
        Transform { localPosition = origin + float3(0, -0.15, 0), localScale = float3(8, 0.3, 8) });
    Spawn(MeshRenderer { mesh = box }, Material { baseColor = Color(0.85, 0.85, 0.85), roughness = 0.85 },
        Transform { localPosition = origin + float3(0, 3, 4.15), localScale = float3(8, 6, 0.3) });
    Spawn(MeshRenderer { mesh = box }, Material { baseColor = Color(0.85, 0.1, 0.07), roughness = 0.9 },
        Transform { localPosition = origin + float3(-4.15, 3, 0), localScale = float3(0.3, 6, 8) });
    Spawn(MeshRenderer { mesh = box }, Material { baseColor = Color(0.05, 0.6, 0.8), roughness = 0.9 },
        Transform { localPosition = origin + float3(4.15, 3, 0), localScale = float3(0.3, 6, 8) });
    Spawn(MeshRenderer { mesh = box }, Material { baseColor = Color(0.9, 0.9, 0.9), roughness = 0.8 },
        Transform { localPosition = origin + float3(-1.35, 1.4, 0.7), localScale = float3(1.7, 2.8, 1.7),
            localRotation = quaternion.Euler(0, -18deg, 0) });
    Spawn(MeshRenderer { mesh = ball }, Material { baseColor = Color(0.9, 0.9, 0.9), roughness = 0.65 },
        Transform { localPosition = origin + float3(1.3, 1, -0.6), localScale = float3(1) });
    Spawn(MeshRenderer { mesh = box }, Material { emission = float3(6, 4.5, 2.5), roughness = 1 },
        Transform { localPosition = origin + float3(0, 5.6, 1), localScale = float3(3, 0.08, 2) });
}

// Host options are applied after world initialization and before its first
// tick. Build here, rather than in the Main Spawned handler during init.
system Build(mut Workload workload)
{
    if (workload.built) return;
    workload.built = true;
    int count = workload.district ? Math.Clamp(workload.buildings, 1, 256) : 1;
    int columns = DistrictColumns(count);
    for (var index = 0; index < count; index++) BuildRoom(BuildingOffset(index, columns));
}

[Before(Render3D.Stages.Prepare)]
view Configure(mut Controls controls, Workload workload, mut Render3D.Renderer renderer, mut GlobalIllumination.Environment environment)
{
    renderer.camera = Camera {
        position = float3(0, 3.2, -10.5),
        rotation = quaternion.LookRotation(float3(0, -0.5, 11), float3(0, 1, 0)),
        verticalFov = 47deg, near = 0.1, far = 50
    };
    int count = workload.district ? Math.Clamp(workload.buildings, 1, 256) : 1;
    int columns = DistrictColumns(count);
    mut float coverageDistance = 48;
    if (controls.overview && !controls.validationView)
    {
        int rows = (count + columns - 1) / columns;
        float extent = float(Math.Max(columns, rows) * 24);
        float3 center = float3(float(columns - 1) * 12, 1.8, float(rows - 1) * 12);
        float3 position = center + float3(0, extent * 0.85, -extent * 0.9);
        renderer.camera = Camera {
            position = position,
            rotation = quaternion.LookRotation(center - position, float3(0, 1, 0)),
            verticalFov = 47deg, near = 0.1, far = extent * 4 + 50
        };
        // This deliberately requests the district's whole visible working set.
        // The ordinary nearby/travel camera keeps the production default 48.
        coverageDistance = extent * 2 + 16;
    }
    else if (controls.travel && !controls.validationView)
    {
        float along = Math.Min(controls.seconds * 12, float(count - 1) * 24);
        int first = int(Math.Floor(along / 24));
        int next = Math.Min(first + 1, count - 1);
        float fraction = along / 24 - float(first);
        float3 origin = BuildingOffset(first, columns) * (1 - fraction) + BuildingOffset(next, columns) * fraction;
        renderer.camera.position += origin;
    }
    if (!controls.lightBuilt)
    {
        controls.lightBuilt = true;
        local Spawn(PointLight { intensity = float3(95, 80, 65), range = 18, castShadows = true },
            Transform { localPosition = float3(0, 5.2, 0.5) });
    }
    renderer.background = Color(0.025, 0.03, 0.04);
    renderer.exposure = 0.85;
    renderer.ambientIrradiance = float3(0);
    renderer.shadowResolution = controls.quick ? 32 : 512;
    renderer.maxShadowMaps = 6;
    environment.settings = GlobalIllumination.Settings {
        enabled = controls.enabled, probeSpacing = 1.5, maxProbes = 512,
        updatesPerFrame = controls.updates, intensity = 1,
        viewDistance = coverageDistance,
        debug = controls.debug && !controls.validationView
    };
}

[Before(Render3D.Stages.Prepare)]
view AnimateLight(mut local PointLight light, mut local Transform transform, Controls controls)
{
    float time = controls.movingLight && !controls.validationView ? controls.seconds : 0;
    transform.localPosition = float3(Math.Sin(time * 0.8) * 2, 5.2, 0.5);
    light.intensity = float3(95, 80, 65) * (1 + Math.Sin(time * 1.1) * 0.25);
}
