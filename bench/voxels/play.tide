// Voxels to play: the chunks this machine has, drawn, the ground past them,
// and a player's own eyes. voxels.tide is the game; this only draws it and
// keeps this machine's own state.
//
// A chunk's faces are a mesh made once, on a worker, from the chunk's blocks
// as they were, and made again when a block of it changes: the frame never
// waits for one. Past the chunks the server sent, the ground is drawn from the
// dimension's seed alone, which every machine has: the same hills the server
// would make there, with nothing sent for them.

settings { title = "Voxels"; }

const int FAR = 96;         // Squares of far ground each way from its middle...
const int FAR_STEP = 8;     // ...each this many cells across
const float SUNK = 5;       // How far the far ground is drawn below where it is, to stay under the chunks'

struct Built
{
    List<Vertex3> vertices;
    List<int> indices;
    int version;
}

// A chunk's faces as a worker made them, until the chunk's own view takes them: a task can't reach a chunk's
// local fields, so it leaves them here
struct Ready
{
    Entity chunk;
    Built built;
    int frame;      // The frame it came in
}

local singleton Meshing
{
    List<Ready> ready;
    int frame;
}

local singleton Sight
{
    int dimension;
    float3 eye;
    bool has;               // This machine's player has an avatar
    int drawn;              // Chunks drawn this frame, and those waiting for a mesh
    int waiting;
    // The ground past the chunks, of one dimension around one place
    Mesh<Vertex3> far;
    int farDimension = -1;
    float3 farMiddle;
    bool farMaking;
    bool farMade;
}

Color Tone(Block block)
{
    if (block == Block.Stone) return Color(0.5, 0.5, 0.52);
    if (block == Block.Dirt) return Color(0.47, 0.33, 0.2);
    if (block == Block.Grass) return Color(0.36, 0.62, 0.25);
    if (block == Block.Sand) return Color(0.84, 0.78, 0.55);
    if (block == Block.Water) return Color(0.2, 0.42, 0.8);
    if (block == Block.Wood) return Color(0.4, 0.28, 0.14);
    if (block == Block.Leaves) return Color(0.2, 0.5, 0.2);
    return Color(0.75, 0.6, 0.35);
}

// A block's color in less light: a side that faces away from the sky
Color Shade(Color tone, float light)
{
    return Color(tone.r * light, tone.g * light, tone.b * light);
}

// A square of two triangles from a corner along two edges, drawn from the side `across` cross `up` points to
void Face(mut List<Vertex3> vertices, mut List<int> indices, float3 corner, float3 across, float3 up, Color color)
{
    var first = vertices.count;
    vertices.Add(Vertex3 { position = corner, color = color });
    vertices.Add(Vertex3 { position = corner + across, color = color });
    vertices.Add(Vertex3 { position = corner + across + up, color = color });
    vertices.Add(Vertex3 { position = corner + up, color = color });
    indices.Add(first);
    indices.Add(first + 1);
    indices.Add(first + 2);
    indices.Add(first);
    indices.Add(first + 2);
    indices.Add(first + 3);
}

// A chunk's faces: each side of a block that has air beside it. Past the chunk's edge reads as air, so the
// sides on its edge are all there.
local worker Built Faces(Grid3<Block> blocks, int version)
{
    mut List<Vertex3> vertices = [];
    mut List<int> indices = [];
    for (var z = 0; z < SIZE; z++)
        for (var y = 0; y < SIZE; y++)
            for (var x = 0; x < SIZE; x++)
            {
                var block = blocks[int3(x, y, z)];
                if (block == Block.Air) continue;
                var tone = Tone(block);
                var at = float3(x, y, z);
                if (blocks[int3(x + 1, y, z)] == Block.Air) Face(vertices, indices, at + float3(1, 0, 0), float3(0, 1, 0), float3(0, 0, 1), Shade(tone, 0.8));
                if (blocks[int3(x - 1, y, z)] == Block.Air) Face(vertices, indices, at, float3(0, 0, 1), float3(0, 1, 0), Shade(tone, 0.8));
                if (blocks[int3(x, y + 1, z)] == Block.Air) Face(vertices, indices, at + float3(0, 1, 0), float3(0, 0, 1), float3(1, 0, 0), tone);
                if (blocks[int3(x, y - 1, z)] == Block.Air) Face(vertices, indices, at, float3(1, 0, 0), float3(0, 0, 1), Shade(tone, 0.5));
                if (blocks[int3(x, y, z + 1)] == Block.Air) Face(vertices, indices, at + float3(0, 0, 1), float3(1, 0, 0), float3(0, 1, 0), Shade(tone, 0.65));
                if (blocks[int3(x, y, z - 1)] == Block.Air) Face(vertices, indices, at, float3(0, 1, 0), float3(1, 0, 0), Shade(tone, 0.65));
            }
    return Built { vertices = vertices, indices = indices, version = version };
}

// Makes a chunk's faces, off the frame, from its blocks as they are now
async void Remesh(mut Meshing meshing, Chunk chunk, Entity self, int version)
{
    var built = await Faces(chunk.blocks, version);
    meshing.ready.Add(Ready { chunk = self, built = built, frame = meshing.frame });
}

// The ground from a seed alone, a square every FAR_STEP cells, around a middle
local worker Built Ground3(int seed, int middleX, int middleZ)
{
    mut List<Vertex3> vertices = [];
    mut List<int> indices = [];
    for (var gz = -FAR; gz < FAR; gz++)
        for (var gx = -FAR; gx < FAR; gx++)
        {
            var x = gx * FAR_STEP;
            var z = gz * FAR_STEP;
            var a = Ground(seed, middleX + x, middleZ + z);
            var b = Ground(seed, middleX + x + FAR_STEP, middleZ + z);
            var c = Ground(seed, middleX + x + FAR_STEP, middleZ + z + FAR_STEP);
            var d = Ground(seed, middleX + x, middleZ + z + FAR_STEP);
            var high = Math.Max(Math.Max(a, b), Math.Max(c, d));
            var tone = high <= SEA ? Tone(Block.Water) : high <= SEA + 1 ? Tone(Block.Sand) : Tone(Block.Grass);
            var first = vertices.count;
            vertices.Add(Vertex3 { position = float3(x, Math.Max(a, SEA) + 1, z), color = tone });
            vertices.Add(Vertex3 { position = float3(x, Math.Max(d, SEA) + 1, z + FAR_STEP), color = tone });
            vertices.Add(Vertex3 { position = float3(x + FAR_STEP, Math.Max(c, SEA) + 1, z + FAR_STEP), color = tone });
            vertices.Add(Vertex3 { position = float3(x + FAR_STEP, Math.Max(b, SEA) + 1, z), color = tone });
            indices.Add(first);
            indices.Add(first + 1);
            indices.Add(first + 2);
            indices.Add(first);
            indices.Add(first + 2);
            indices.Add(first + 3);
        }
    return Built { vertices = vertices, indices = indices };
}

async void MakeFar(mut Sight sight, int dimension, int seed, float3 middle)
{
    sight.farMaking = true;
    var built = await Ground3(seed, int(middle.x), int(middle.z));
    sight.far = Mesh(built.vertices, built.indices);
    sight.farDimension = dimension;
    sight.farMiddle = middle;
    sight.farMade = true;
    sight.farMaking = false;
}

// This machine's player's eyes
view Eyes(Avatar avatar, mut Sight sight, with ownership)
{
    sight.has = true;
    sight.dimension = avatar.dimension;
    sight.eye = avatar.position + float3(0, 1.6, 0);
    sight.drawn = 0;
    sight.waiting = 0;
    Draw.Clear(avatar.dimension == 0 ? Color(0.55, 0.72, 0.92) : Color(0.42, 0.26, 0.4));
    Draw.SetCamera(sight.eye, quaternion.Euler(float3(avatar.pitch, avatar.yaw, 0)), 75);
    Cursor.Lock();
}

// The ground past the chunks: made again when the player has gone a way from its middle, or changed dimension
view Beyond(Dimension dimension, mut Sight sight)
{
    if (!sight.has || dimension.number != sight.dimension) return;
    var flat = float3(sight.eye.x, 0, sight.eye.z);
    var stale = sight.farDimension != dimension.number || Math.Distance(flat, sight.farMiddle) > FAR * FAR_STEP * 0.25;
    if (stale && !sight.farMaking)
    {
        var middle = float3(Math.Floor(flat.x / FAR_STEP) * FAR_STEP, 0, Math.Floor(flat.z / FAR_STEP) * FAR_STEP);
        MakeFar(sight, dimension.number, dimension.seed, middle);
    }
    if (sight.farMade && sight.farDimension == dimension.number) Draw.Mesh(sight.far, float4x4.Translate(sight.farMiddle - float3(0, SUNK, 0)));
}

// Faces nobody took go: their chunk went while they were made
view Sweep(mut Meshing meshing)
{
    meshing.frame += 1;
    for (var i = meshing.ready.count - 1; i >= 0; i--)
    {
        if (meshing.frame - meshing.ready[i].frame > 4) meshing.ready.RemoveAt(i);
    }
}

// Each chunk of the player's dimension, once it has a mesh
view Chunks(mut Chunk chunk, mut Sight sight, mut Meshing meshing)
{
    if (chunk.meshing)
    {
        for (var i = 0; i < meshing.ready.count; i++)
        {
            if (meshing.ready[i].chunk != this) continue;
            var built = meshing.ready[i].built;
            chunk.blank = built.indices.count == 0;
            if (!chunk.blank) chunk.mesh = Mesh(built.vertices, built.indices);
            chunk.drawn = built.version;
            chunk.meshing = false;
            meshing.ready.RemoveAt(i);
            break;
        }
    }
    if (!sight.has || chunk.stage != Stage.Made || chunk.dimension != sight.dimension) return;
    if (!chunk.meshing && chunk.drawn != chunk.edits + 1)
    {
        chunk.meshing = true;
        Remesh(meshing, chunk, this, chunk.edits + 1);
    }
    if (chunk.drawn == 0)
    {
        sight.waiting += 1;
        return;
    }
    if (chunk.blank) return;
    sight.drawn += 1;
    Draw.Mesh(chunk.mesh, float4x4.Translate(float3(chunk.at.x * SIZE, chunk.at.y * SIZE, chunk.at.z * SIZE)));
}

// The other players, a box each
view Others(Avatar avatar, Sight sight, without ownership)
{
    if (avatar.dimension != sight.dimension) return;
    Draw.Cube(avatar.position + float3(0, 0.9, 0), float3(0.6, 1.8, 0.6), Color(0.95, 0.75, 0.2));
}

view Panel(Devices devices, Sight sight, mut Travel travel)
{
    if (devices.keyboard.h.down) travel.hops += 1;
    Draw.SetScreen();
    var middle = float2(Screen.width, Screen.height) * 0.5;
    Draw.Rect(middle, float2(12, 2), Color.white);
    Draw.Rect(middle, float2(2, 12), Color.white);
    Draw.Text($"Dimension {sight.dimension}   {int(sight.eye.x)}, {int(sight.eye.y)}, {int(sight.eye.z)}   chunks {sight.drawn} (+{sight.waiting})",
              float2(16, 14), 14, Color.white);
    Draw.Text("WASD and the mouse to move, space to jump, click to dig, right click to build, H for the other dimension",
              float2(16, Screen.height - 24), 12, Color.white);
}
