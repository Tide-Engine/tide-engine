// Four rendering paths over the same model, fragment and screen coverage.
// The host selects count/mode/time; no match simulation or playback clock is timed.
local scene Main { }

enum Stages { Prepare, Objects }

struct Corner
{
    float3 position;
    float3 normal;
    Color color;
}

// Experiment only: four influences from the unchanged benchmark fixture.
// A resident 60 Hz palette table replaces per-character CPU pose capture.
struct GpuCorner
{
    float3 position;
    float3 normal;
    Color color;
    int4 joints;
    float4 weights;
}

local singleton GpuClip
{
    List<GpuCorner> vertices;
    List<int> indices;
    List<float4x4> palettes;
    int bones;
    int frames;
}

asset SkinnedMesh<Corner> character = "model.gltf";
asset Mesh<Corner> staticCharacter = "model.gltf";

local singleton Workload
{
    int count = 1;
    int mode;
    float seconds;
    bool ready;
    int columns;
    int rows;
    float scale;
    Pose sharedPose;
}

component Character { int index; }

frag Lit(Corner corner, out Color color)
{
    color = corner.color * (0.65 + 0.35 * Math.Abs(corner.normal.z));
    color.a = 1;
}

float4x4 ClipMatrix(List<float4x4> palettes, int bones, int joint, int first, int next, float alpha)
{
    var a = palettes[first * bones + joint];
    var b = palettes[next * bones + joint];
    return float4x4(Math.Lerp(a.c0, b.c0, alpha), Math.Lerp(a.c1, b.c1, alpha),
                   Math.Lerp(a.c2, b.c2, alpha), Math.Lerp(a.c3, b.c3, alpha));
}

vert GpuSkin(mut GpuCorner corner, GpuClip clip, local Character item, Workload work)
{
    float phase = Math.Frac(work.seconds + float(item.index) / float(work.count)) * float(clip.frames);
    int first = int(Math.Floor(phase));
    int next = (first + 1) % clip.frames;
    float alpha = phase - float(first);
    var a = ClipMatrix(clip.palettes, clip.bones, corner.joints.x, first, next, alpha);
    var b = ClipMatrix(clip.palettes, clip.bones, corner.joints.y, first, next, alpha);
    var c = ClipMatrix(clip.palettes, clip.bones, corner.joints.z, first, next, alpha);
    var d = ClipMatrix(clip.palettes, clip.bones, corner.joints.w, first, next, alpha);
    var skin = a * corner.weights.x + b * corner.weights.y + c * corner.weights.z + d * corner.weights.w;
    corner.position = Math.Mul(skin, float4(corner.position, 1)).xyz;
    // Match the ordinary skinned shader's cofactor normal transform.
    var x = Math.Cross(skin.c1.xyz, skin.c2.xyz);
    var y = Math.Cross(skin.c2.xyz, skin.c0.xyz);
    var z = Math.Cross(skin.c0.xyz, skin.c1.xyz);
    float sign = Math.Dot(skin.c0.xyz, x) < 0 ? -1 : 1;
    corner.normal = Math.Normalize(Math.Mul(float3x3(x, y, z), corner.normal) * sign);
}

frag GpuLit(GpuCorner corner, out Color color)
{
    color = corner.color * (0.65 + 0.35 * Math.Abs(corner.normal.z));
    color.a = 1;
}

[Stage(Stages.Prepare)]
view Prepare(mut Workload work)
{
    Draw.Clear(Color(0.035, 0.045, 0.06));
    Draw.SetCamera(float4x4.Translate(float3(0, 0, -5)), float4x4.Ortho(160.0 / 9.0, 10, 0.1, 100));
    Draw.SetCull(Cull.None);

    work.count = Math.Max(work.count, 1);
    work.columns = 1;
    while (work.columns * work.columns < work.count) work.columns++;
    work.rows = (work.count + work.columns - 1) / work.columns;
    work.scale = 4 / Math.Sqrt(float(work.count));
    if (work.mode == 2) work.sharedPose = character.animations.move.Sample(work.seconds, Playback.Loop);

    // The host runs this setup frame outside timing after resetting local state.
    // Spawns settle after that frame, so every measured frame has exactly count.
    if (!work.ready)
    {
        for (int i = 0; i < work.count; i++) local Spawn(Character { index = i });
        work.ready = true;
    }
}

[Stage(Stages.Objects)]
view Show(local Character item, Workload work, GpuClip clip)
{
    int i = item.index;
    float x = (float(i % work.columns) + 0.5) * (160.0 / 9.0 / float(work.columns)) - 80.0 / 9.0;
    float y = (float(i / work.columns) + 0.5) * (10.0 / float(work.rows)) - 5;
    var transform = float4x4.TRS(float3(x, y, 0), quaternion.identity, float3(work.scale));
    if (work.mode == 0) Draw.Mesh(staticCharacter, transform, Lit);
    else if (work.mode == 1) Draw.SkinnedMesh(character, transform, Lit);
    else if (work.mode == 2) Draw.SkinnedMesh(character, transform, work.sharedPose, Lit);
    else if (work.mode == 4) Draw.Mesh(clip.vertices, clip.indices, transform, GpuSkin, GpuLit);
    else
    {
        var pose = character.animations.move.Sample(work.seconds + float(i) / float(work.count), Playback.Loop);
        Draw.SkinnedMesh(character, transform, pose, Lit);
    }
}
