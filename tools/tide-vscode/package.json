{
  "name": "tide",
  "displayName": "Tide",
  "description": "The Tide language: errors as you type, completion, go to definition, rename, formatting and more, from tidels; and a graph editor for .tidegraph files",
  "version": "0.0.0",
  "publisher": "tide-engine",
  "icon": "icon.png",
  "homepage": "https://tide-engine.dev",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:tide",
    "onCustomEditor:tide.graph",
    "workspaceContains:**/*.tidegraph",
    "onDebugResolve:tide",
    "onDebugInitialConfigurations",
    "onDebugDynamicConfigurations:tide"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, nothing from the workspace runs: the language server is the tidels that comes with tide (or one your user settings name outside the workspace), never the workspace's build/tools/tidels or one its settings name, and games don't run or debug, as running one runs its code.",
      "restrictedConfigurations": [
        "tide.server.path",
        "tide.path"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tide",
        "aliases": [
          "Tide",
          "tide"
        ],
        "extensions": [
          ".tide",
          ".tprefab",
          ".tweaks"
        ],
        "icon": {
          "light": "./icons/tide.svg",
          "dark": "./icons/tide.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json",
        "extensions": [
          ".tidegraph"
        ]
      }
    ],
    "grammars": [
      {
        "language": "tide",
        "scopeName": "source.tide",
        "path": "./syntaxes/tide.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "tide.graph",
        "displayName": "Tide Graph",
        "selector": [
          {
            "filenamePattern": "*.tidegraph"
          }
        ],
        "priority": "default"
      }
    ],
    "breakpoints": [
      {
        "language": "tide"
      }
    ],
    "debuggers": [
      {
        "type": "tide",
        "label": "Tide",
        "languages": [
          "tide"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "game": {
                "type": "string",
                "description": "The game's folder, as tide run takes it. Default: the active .tide file's game.",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The game's arguments, as tide run passes them (--host, --join <code>, --seed <n>).",
                "default": []
              }
            }
          },
          "attach": {
            "properties": {
              "project": {
                "type": "string",
                "description": "The Unity project whose editor to attach to. Default: the one the active file or the open folder is in."
              },
              "processId": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "The Unity editor's process ID. Default: the project's editor, or one picked from those running."
              },
              "target": {
                "type": "string",
                "enum": [
                  "unity",
                  "game"
                ],
                "enumDescriptions": [
                  "The Unity editor running the project",
                  "The game Tide: Run (tide run) plays"
                ],
                "default": "unity",
                "description": "What to attach to."
              },
              "game": {
                "type": "string",
                "description": "With \"target\": \"game\", the game's folder. Default: the active .tide file's game.",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tide",
            "request": "attach",
            "name": "Attach to Unity (Tide)"
          },
          {
            "type": "tide",
            "request": "launch",
            "name": "Debug Tide game",
            "game": "${workspaceFolder}"
          },
          {
            "type": "tide",
            "request": "attach",
            "name": "Attach to Tide game (tide run)",
            "target": "game",
            "game": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Tide: Attach to Unity",
            "description": "Debug the Tide game the Unity editor runs, stopping at breakpoints in .tide files",
            "body": {
              "type": "tide",
              "request": "attach",
              "name": "Attach to Unity (Tide)"
            }
          },
          {
            "label": "Tide: Debug Tide game",
            "description": "Build the game to debug (tide build) and run it under the debugger",
            "body": {
              "type": "tide",
              "request": "launch",
              "name": "Debug Tide game",
              "game": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Tide: Attach to Tide game (tide run)",
            "description": "Debug the game Tide: Run plays, which goes on reloading as files are saved",
            "body": {
              "type": "tide",
              "request": "attach",
              "name": "Attach to Tide game (tide run)",
              "target": "game",
              "game": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Tide",
      "properties": {
        "tide.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The language server to run. Empty: the open folder's `build/tools/tidels` when it's Tide itself, else `tidels` from `PATH`, or from where tide is installed. `~` is your home folder; `${workspaceFolder}` and relative paths are the folder whose settings set it, or for user and workspace settings, the first open folder; `${workspaceFolder:name}` is the open folder of that name. In Restricted Mode, only your user settings count, and never for a server in the workspace."
        },
        "tide.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `tide` that **Tide: Run**, **Tide: Run on the Web** and **Tide: Run on Android** run. Empty: `tide` from `PATH`, or from where tide is installed. `~` is your home folder; `${workspaceFolder}` and relative paths are the folder whose settings set it, or for user and workspace settings, the game's folder; `${workspaceFolder:name}` is the open folder of that name."
        },
        "tide.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Nothing",
            "The name of each message",
            "Each message, whole"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Shows what VS Code and the language server say to each other in the **Tide Trace** output, for reporting a problem with the server."
        }
      }
    },
    "commands": [
      {
        "command": "tide.restartServer",
        "title": "Restart Language Server",
        "category": "Tide"
      },
      {
        "command": "tide.run",
        "title": "Run",
        "category": "Tide",
        "icon": "$(play)"
      },
      {
        "command": "tide.runWeb",
        "title": "Run on the Web",
        "category": "Tide",
        "icon": "$(globe)"
      },
      {
        "command": "tide.runAndroid",
        "title": "Run on Android",
        "category": "Tide",
        "icon": "$(device-mobile)"
      },
      {
        "command": "tide.openDevTools",
        "title": "Game Developer Tools",
        "category": "Tide",
        "icon": "$(tools)"
      },
      {
        "command": "tide.convertToGraph",
        "title": "Convert to Tide Graph",
        "category": "Tide"
      },
      {
        "command": "tide.showAsTide",
        "title": "Show as Tide",
        "category": "Tide",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "tide.run",
          "when": "resourceLangId == tide && isWorkspaceTrusted"
        },
        {
          "command": "tide.runWeb",
          "when": "resourceLangId == tide && isWorkspaceTrusted"
        },
        {
          "command": "tide.runAndroid",
          "when": "resourceLangId == tide && isWorkspaceTrusted"
        }
      ],
      "editor/title": [
        {
          "command": "tide.openDevTools",
          "when": "activeWebviewPanelId == 'simpleBrowser.view' && tide.gamePage",
          "group": "navigation"
        },
        {
          "command": "tide.showAsTide",
          "when": "activeCustomEditorId == 'tide.graph'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "tide.openDevTools",
          "when": "tide.gamePage"
        },
        {
          "command": "tide.convertToGraph",
          "when": "resourceExtname == .tide"
        },
        {
          "command": "tide.showAsTide",
          "when": "resourceExtname == .tidegraph || activeCustomEditorId == 'tide.graph'"
        }
      ],
      "explorer/context": [
        {
          "command": "tide.convertToGraph",
          "when": "resourceExtname == .tide",
          "group": "7_modification"
        },
        {
          "command": "tide.showAsTide",
          "when": "resourceExtname == .tidegraph",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "tide.convertToGraph",
          "when": "resourceExtname == .tide",
          "group": "7_modification"
        }
      ]
    },
    "semanticTokenModifiers": [
      {
        "id": "local",
        "description": "A local field of a match component or singleton: this machine's, outside the match"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tide",
        "scopes": {
          "property.local": [
            "variable.other.property.local.tide",
            "variable.other.property.tide"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[tide]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=out/extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
