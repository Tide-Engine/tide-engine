// Built-in types and groups.
enum Voxel : byte { Air, Stone }
view Show(Devices devices)
{
    Keyboard keyboard = devices.keyboard;
    Mouse mouse = devices.mouse;
    Gamepad pad = devices.gamepad;
    Button jump = keyboard.space;
    Dpad dpad = pad.dpad;
    float4x4 world = default;
    float2x3 wrong = default;
    int2x2 alsoWrong = default;
    Draw.Rect(0, 0, 1, 1, Color.white);
    Vertex corner = default;
    Draw.Mesh([corner], [0, 0, 0], cells, Filter.Point);
    Draw.Text("DUEL", corner.position, 88, Color.white, Anchor.MiddleCenter, Font.Bold);
    Vertex3 corner3 = default;
    Draw.Mesh([corner3], [0, 0, 0], world, cells, Filter.Bilinear, Wrap.Repeat);
    Shape panel = default;
    Draw.Shape(panel);
    Random dice = Random(7);
    var roll = dice.NextInt(6);
    DrawUI(Draw.list);
    Draw.Blend(Blend.Add),
    Draw.Clip(Rect(0, 0, 4, 4))
    {
        Draw.SetTint(Color.red);
    }
    Draw.Depth(Depth.Read)
    {
        Draw.SetDepth(Depth.None);
    }
    Draw.Cull(Cull.None)
    {
        Draw.SetCull(Cull.Front);
    }
    Draw.Stencil(StencilTest.Equal, 1)
    {
        Draw.SetStencil(StencilTest.Always, 2, StencilOp.Replace);
    }
    if (GUI.Button("Copy")) Clipboard.Copy("x");
    GUIControl card = GUI.Control(Rect(0, 0, 1, 1));
    GUITheme look = default;
    GUI.SetTheme(look);
    if (!Cursor.locked) Cursor.Lock();
    float step = Frame.dt;
}

// Operators that aren't what they look like.
void Operators(string text)
{
    int value = Parse(text)!;
    bool not = !true;
    int either = true ? 1 : 2;
    switch (value)
    {
        case 1:
            break;
        default:
            break;
    }
}

// Escapes.
void Escapes()
{
    string good = "quote \" slash \\ line \n";
    string bad = "tab \t";
    string braces = $"{{ {value:F2} }}";
    string lone = $"a } b";
    string badValue = $"tab \t {value}";
    char letter = 'a';
    char quote = '\'';
    char tab = '\t';
    char wrong = '\q';
    bool same = letter == 'é' && quote != '"';
    char brace = '{';
}

