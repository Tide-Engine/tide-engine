// Defaults, arguments by name, and a shared name written with its parameters' types.
float Strike(float base, float multiplier = 1, bool crit = false)
{
    return crit ? base * multiplier * 2 : base * multiplier;
}
float Strikes(bool on)
{
    return Strike(10, crit: true)
        + 1;
}
float StrikesOn(bool on)
{
    return Strike(base: 1, multiplier: on ? 2 : 3);
}
system Advance(mut Body body, with Player) { }
system Advance(mut Body body, with Enemy) { }
[After(Advance(Body, with Player))]
system Settle(mut Body body) { }

