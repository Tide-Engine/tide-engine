}
view Bake(mut Mesh mesh) { var local = mesh.local; }

// Fields that are a T?: a value or nothing.
struct Wish
{
    string? wished;
    List<int>? wishes = null;
    Combat.Stats? granted;
    float3? toward = float3(0, 1, 0);
}
void Grant(mut Wish wish) { wish.wished = null; var count = wish.wishes ?? []; if (wish.granted is Combat.Stats stats) { } }

// Frags and verts: their words start a declaration, and are names anywhere else.
frag Shade(BoxVertex vertex, out Color color, Box box)
{
    color = box.wood.Sample(vertex.uv) * box.tint;
    if (this.position.x < 10) this.Discard();
}
vert Wave(mut BoxVertex vertex, out FromLamp lamp, Time time, Instance instance) { }
float Blend(float frag, float vert)
{
    float both = frag + vert;
    frag = both;
    return vert * both;
}
view Boxes(with Box, Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Wave, Shade);
    Draw.Cube(float3(0, 0, 5), float3(1), Color.red);
}

// Local filesystem APIs and binary values.
async void SaveBytes(List<byte> bytes) fails IOError
{
    var root = Application.persistentDataPath;
    Directory.CreateDirectory(root)!;
    try File.WriteAllBytes(Path.Combine(root, "save.bin"), bytes);
    try await Storage.Flush();
    fail IOError.OutOfSpace;
}

// JSON as a struct, and text as bytes, pieces and numbers.
struct LobbyInfo
{
    [Json("max_players")] int maxPlayers;
}

string Answer(string text)
{
    var info = Json.Read<LobbyInfo>(text) ?? LobbyInfo { };
    var all = Json.Read<List<LobbyInfo>>(text.ToBytes()) ?? [];
    if (int.TryParse(text.Split(",")[0], out var count)) return Json.Write(all);
    return string.FromBytes(text.ToBytes()) ?? Json.Write(info);
}

// A query is a second entity set in a system header, and a normal name elsewhere.
system BulletHits(Body shot, query (Body body, with Fighter, without Ghost) fighters, Time time)
{
    foreach (var fighter in fighters) { var target = fighter.entity; }
}
system QueriesAcrossLines(
    Body shot,
    query (
        Body body,
        with Fighter,
        without Ghost
    ) fighters,
    Time time)
{
    foreach (var fighter in fighters) { var target = fighter.body; }
}
