override frag Effects.Glow(Corner vertex, out Color color) { }
struct Probed
{
    float health;
    virtual bool IsGone() { return health <= 0; }
    virtual mut void Drain(float amount) { health -= amount; }
}
system Words(mut local Toast toast)
{
    var virtual = 1;
    var override = virtual + 1;
}

