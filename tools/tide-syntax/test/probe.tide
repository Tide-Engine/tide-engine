// Loops' headers.
system Loops(Field field)
{
    parallel (var at in field.cells by 2 offset o) { }
    foreach (var tick in Both(Ticks(), Ticks())) { int in = 1; }
}

// The World, and a type in <> after a method's name.
system Track(Seeker seeker, mut World world)
{
    var target = world.Get<Health>(seeker.target);
    if (world.Has<Combat.Stats>(seeker.target) && target.value < 3 && seeker.range > (2)) return;
    world.Set<Health>(seeker.target, target);
    var lookup = seeker.range < target.value;
}

// Ownership: a word of its own right after with and without, a name anywhere else.
view Mine(Body body, with ownership) { }
view Rest(Body body, with Owner, without ownership) { }
view Flagged(with ownership.Flag, with Game.ownership) { }
int Owned(int ownership) { return ownership; }

// Local fields: `local` before a field of a match component or singleton, a name anywhere else.
component Mesh
{
    local List<Vertex3> verts;
    local float fade = 1;
    local Combat.Stats stats;
    local int? picked;
    int local;
}
view Bake(mut Mesh mesh) { var local = mesh.local; }

// Frags and verts: their words start a declaration, and are names anywhere else.
frag Shade(BoxVertex vertex, mut Color color, Box box, Pixel pixel)
{
    color = box.wood.Sample(vertex.uv) * box.tint;
    if (pixel.position.x < 10) pixel.Discard();
}
vert Wave(mut BoxVertex vertex, Time time, Instance instance) { }
float Blend(float frag, float vert)
{
    float both = frag + vert;
    frag = both;
    return vert * both;
}
view Boxes(with Box, Models models)
{
    Draw3D.Mesh(models.crate, models.faces, float4x4.identity, Wave, Shade);
    Draw3D.Cube(float3(0, 0, 5), float3(1), Color.red);
}

// Local filesystem APIs and binary values.
async void SaveBytes(List<byte> bytes) fails IOError
{
    var root = Application.persistentDataPath;
    Directory.CreateDirectory(root)!;
    try File.WriteAllBytes(Path.Combine(root, "save.bin"), bytes);
    try await Storage.Flush();
    fail IOError.OutOfSpace;
}

// A query is a second entity set in a system header, and a normal name elsewhere.
system BulletHits(Body shot, query (Body body, with Fighter, without Ghost) fighters, Time time)
{
    foreach (var fighter in fighters) { var target = fighter.entity; }
}
system QueriesAcrossLines(
    Body shot,
    query (
        Body body,
        with Fighter,
        without Ghost
    ) fighters,
    Time time)
{
    foreach (var fighter in fighters) { var target = fighter.body; }
}
int query(int value) { return value; }
int QueryName(int query) { return query; }
void CallQuery() { var answer = query(1); }

// verified: a word of its own before a view's parameter, after with and without, and before a local handler's event; a name anywhere else.
view HealthBar(Health health, verified Health confirmed, mut verified Combat.Armor armor) { }
view Corpses(Body body, with verified Dead, without verified Combat.Ghost) { }
view ConfirmedAcrossLines(
    verified Body sure,
    mut verified Mesh baked,
    without verified Dead)
{
}
local event(verified Died died) ShowDeath(Body body, mut Toast toast) { }
local event(verified Combat.Died) CountDeath(mut Toast toast) { }
local event(verified) HearVerified(mut Toast toast) { }
view Trusted(verified trust, with verified) { }
int Checked(Stats? verified) { if (verified is Stats checked) return Twice(verified, verified); }
struct Proof
{
    bool verified;
    mut void Prove(bool proven) { verified = proven; }
}
void Proving()
{
    mut verified tally = default;
    verified = tally;
}
