// Attributes side by side.
[After(Steer)] [Before(Fade)]
system Both() { }
[After(Steer), Before(Fade)] system SameLine() { }
[Stage(RenderStages.Objects, -10), Before(RenderStages.UI)] view DrawObjects() { }

input Aim
{
    [Clamp(float2(0, -5), float2(10, 5))] float2 aim;
    [Min(1)] [Max(3)] int gear = 1;
}

// Built-in types and groups.
enum Voxel : byte { Air, Stone }
view Show(Devices devices)
{
    Keyboard keyboard = devices.keyboard;
    Mouse mouse = devices.mouse;
    Gamepad pad = devices.gamepad;
    Button jump = keyboard.space;
    Dpad dpad = pad.dpad;
    float4x4 world = default;
    float2x3 wrong = default;
    int2x2 alsoWrong = default;
    Draw2D.Rect(0, 0, 1, 1, Color.white);
    Vertex corner = default;
    Draw2D.Mesh([corner], [0, 0, 0], cells, Filter.Point);
    Vertex3 corner3 = default;
    Shape panel = default;
    Draw2D.Shape(panel);
    Random dice = Random(7);
    var roll = dice.NextInt(6);
    DrawUI(Draw2D.list);
    if (GUI.Button("Copy")) Clipboard.Copy("x");
    if (!Cursor.locked) Cursor.Lock();
    float step = Frame.dt;
}

// Operators that aren't what they look like.
void Operators(string text)
{
    int value = Parse(text)!;
    bool not = !true;
    int either = true ? 1 : 2;
    switch (value)
    {
        case 1:
            break;
        default:
            break;
    }
}

// Escapes.
void Escapes()
{
    string good = "quote \" slash \\ line \n";
    string bad = "tab \t";
    string braces = $"{{ {value:F2} }}";
    string lone = $"a } b";
    string badValue = $"tab \t {value}";
}

