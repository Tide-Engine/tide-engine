{
  "about": "How Box3D's components are in a Unity project, which tide unity reads (compiler/cli/unity_mapping.h). Native fields are the package's own without saying",
  "components": {
    "Box3D.Body": {
      "hidden": [
        "position",
        "rotation",
        "stepPosition",
        "stepRotation",
        "stepVelocity",
        "stepAngularVelocity",
        "stepBullet",
        "stepAsleep",
        "stepType",
        "stepGravityScale",
        "stepLinearDamping",
        "stepAngularDamping"
      ]
    },
    "Box3D.Box": {
      "scaled": {
        "size": "absScale",
        "offset": "scale"
      },
      "shape": {
        "box": "size",
        "center": "offset"
      }
    },
    "Box3D.Sphere": {
      "scaled": {
        "radius": "largestScale",
        "offset": "scale"
      },
      "shape": {
        "sphere": "radius",
        "center": "offset"
      }
    },
    "Box3D.Capsule": {
      "scaled": {
        "radius": "largestScaleXZ",
        "height": "scaleY",
        "offset": "scale"
      },
      "shape": {
        "capsule": "radius",
        "height": "height",
        "center": "offset"
      }
    },
    "Box3D.MeshCollider": {
      "scaled": {
        "scale": "scale",
        "offset": "scale"
      },
      "placed": "offset",
      "mesh": {
        "vertices": "vertices",
        "indices": "indices"
      }
    },
    "Box3D.HullCollider": {
      "scaled": {
        "scale": "scale",
        "offset": "scale"
      },
      "placed": "offset",
      "mesh": {
        "vertices": "vertices"
      }
    },
    "Box3D.HeightFieldCollider": {
