        "torque"
      ]
    }
  },
  "sourceAbout": "Added to a Unity project's game: a body starts where its entity's Transform (Unity's placement) is, and the Transform follows the body; a part that names no body is one of the nearest body above it",
  "source": [
    "namespace Box3D",
    "{",
    "    // A body whose entity has Tide's Transform (in Unity, every one): it starts where the Transform places it, whatever",
    "    // its position said, and the Transform follows it after each step, so Unity shows the body where it is. A body's",
    "    // place is the world's: one under an entity that turns isn't turned with it.",
    "    [Stage(PhysicsStages.Step, 0)]",
    "    system StartAtTransform(mut Body body, Transform transform)",
    "    {",
    "        if (body.id != 0) return;",
    "        body.position = transform.position;",
    "        body.rotation = transform.localRotation;",
    "    }",
    "",
    "    [Stage(PhysicsStages.Step, 19)]",
    "    system FollowTransform(Body body, mut Transform transform)",
    "    {",
    "        transform.position = body.position;",
    "        transform.localRotation = body.rotation;",
    "    }",
    "",
    "    // A part that names no body is a part of the nearest entity above it with one, as a collider on a Rigidbody's",
    "    // child is in Unity: tide unity bakes its shapes' offsets where its GameObject is on that body.",
    "    [Stage(PhysicsStages.Step, 0)]",
    "    system PartOfTheBodyAbove(mut Part part, World world)",
    "    {",
    "        if (part.of != default) return;",
    "        mut var above = world.Parent(this);",
    "        while (above != default && !world.Has<Body>(above)) above = world.Parent(above);",
    "        part.of = above;",
    "    }",
    "}"
  ]
}
