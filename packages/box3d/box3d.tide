// Box3D, Erin Catto's 3D physics engine (box3d/, as it came, with the changes
// box3d/TIDE.md lists), for a match: bodies and their shapes are components,
// and every tick steps them.
//
// Box3D's state lives in an arena, whose resident pages (Physics.state) the
// match keeps after each step. Before a tick C's world is either at that
// state already or its pages are restored. Joins and layout migrations use
// a canonical image and its geometry. Everything that changes Box3D's world
// happens in these systems, from what the components say: code that wants a
// body to move writes its component.

namespace Box3D;

// Where the package's systems are in a tick: all of them are one stage, in
// the order they're written in here. A system of a game's that has to write
// into this tick's step says so with [Before(PhysicsStages.Step)]: it then
// runs before any of these, so what it writes into a body is what this tick
// steps from. Any other runs after them, as a package's files compile before
// the game's, and what it writes is the next tick's: but for the ones written
// above a system that's before the stage, which the default order then has
// before it too. [After(PhysicsStages.Step)] holds a system after.
enum PhysicsStages
{
    Step
}

enum BodyType
{
    Static,
    Kinematic,
    Dynamic
}

// A rigid body. Its place and speeds are Box3D's after each step, and a system
// that writes them moves the body: the next step starts from what they say.
// How it's to be (its type, how gravity pulls on it, how it slows and whether
// it's a bullet) is what code says, when it's spawned or later: the next step
// has it that way.
//
// Whether it's asleep is Box3D's after each step too: at rest, and stepped no
// more until something wakes it. A system that writes `asleep` puts the body
// to sleep or wakes it, at the next step, and one spawned with it starts
// asleep. Box3D sleeps and wakes bodies an island at a time, the bodies that
// touch each other, so a body that's put to sleep takes what it touches with
// it, and one that's woken wakes what it fell asleep with. What code puts to
// sleep in a tick is asleep as that tick's step starts, whatever else it wrote
// into it or into the others that tick.
//
// Where it is and how it's turned are said to be that, for views: when the
// server corrects where this machine had a body, they see it get there over a
// few frames, turning the short way. It changes nothing of the match.
component Body
{
    long id; // Box3D's own handle: 0 until the body's first step
    BodyType type = BodyType.Dynamic;
    [Position] float3 position;
    [Rotation] quaternion rotation = quaternion.identity;
    float3 velocity;
    float3 angularVelocity; // Around each axis, in radians a second
    float3 impulse; // Given to the body at the next step, once
    float3 angularImpulse; // The same, around
    float gravityScale = 1;
    float linearDamping;
    float angularDamping;
    // The package's own: where the last step left the body, which is how
    // what's written since is told, without asking Box3D
    float3 stepPosition;
    quaternion stepRotation = quaternion.identity;
    float3 stepVelocity;
    float3 stepAngularVelocity;
    bool bullet;
    // The package's own: what Box3D has of how the body is to be, which is how
    // a type, a scale, a damping or a bullet that's written later is told
    bool stepBullet;
    bool asleep; // At rest, and not stepped until something wakes it: never so for a static body
    // The package's own: whether the last step left it asleep, which is how
    // an `asleep` that code wrote since is told
    bool stepAsleep;
    BodyType stepType = BodyType.Dynamic;
    float stepGravityScale = 1;
    float stepLinearDamping;
    float stepAngularDamping;
    bool rewind; // Opt this body and all its shapes into bounded collider history
}

// A box on the entity's body, `size` wide, high and deep around `offset`.
component Box
{
    float3 size = float3(1, 1, 1);
    float3 offset;
    float density = 1000; // Water's, in kilograms a cubic meter
    float friction = 0.6;
    float bounce;
    bool sensor; // Bodies pass through it, and it sends Touched and Parted for the ones in it
}

// A sphere on the entity's body.
component Sphere
{
    float radius = 0.5;
    float3 offset;
    float density = 1000;
    float friction = 0.6;
    float bounce;
    bool sensor;
}

// A capsule on the entity's body, standing along its y: `height` from end to
// end, round ends included.
component Capsule
{
    float radius = 0.5;
    float height = 2;
    float3 offset;
    float density = 1000;
    float friction = 0.6;
    float bounce;
    bool sensor;
}

// The entity's shapes are on another entity's body: `of`'s. An entity has one
// shape of each kind at most, so a body of several boxes is a body and a part
// for each box past its first. A part is an entity of its own: destroying it
// takes its shapes off the body, and it's destroyed with the body. One whose
// `of` has no body when its shapes would be made is destroyed too.
component Part
{
    Entity of;
    // The package's own: Box3D's handles to the shapes made for this entity
    long box;
    long sphere;
    long capsule;
}

// The package's own: the entity's box, its sphere or its capsule is on its
// body in Box3D
[Sparse]
component BoxMade { }

[Sparse]
component SphereMade { }

[Sparse]
component CapsuleMade { }

// Two bodies started touching, or stopped: sent to each, with the other, once
// for each pair of their shapes. `part` is whose shape of this entity's it
// was, and `otherPart` whose of the other's: the entity itself, for a shape of
// its own, or the part the shape is on.
//
// A shape that's a sensor stops nothing, and sends them for what comes into it
// and leaves it, to its own entity and to the other's; two sensors say nothing
// of each other. `other` is no entity when the other one was destroyed while
// they touched: its parting still comes, from `default`. A part that was
// destroyed, on a body that stays, still says its body: the part is `default`.
event Touched
{
    Entity other;
    Entity part;
    Entity otherPart;
}

event Parted
{
    Entity other;
    Entity part;
    Entity otherPart;
}

// Two bodies met faster than Physics.hitSpeed: sent to each, with the other,
// once a step for each pair of their shapes, while they go on meeting that
// fast. `point` is where, `speed` how fast they closed on each other there,
// and `normal` the way this entity was pushed: from the other towards it.
event Hit
{
    Entity other;
    float3 point;
    float3 normal;
    float speed;
}

// What a ray or a shape that's cast met first: the body's entity, the part
// its shape is on (the entity itself, for a shape of its own), where, the
// shape's surface there, and how far along the way from 0 to 1.
struct RayHit
{
    Entity entity;
    Entity part;
    float3 point;
    float3 normal;
    float fraction;
}

singleton Physics
{
    float3 gravity = float3(0, -10, 0);
    int substeps = 4;
    // How the world steps, as Box3D has it unless a game says: how stiff two
    // bodies that touch are held apart, in cycles a second, how fast that
    // springing dies down (1 just stops it), and how fast two that overlap are
    // pushed apart at most, in meters a second
    float contactStiffness = 30;
    float contactDamping = 10;
    float contactSpeed = 3;
    float bounceSpeed = 1; // Slower than this, in meters a second, nothing bounces
    float hitSpeed = 1; // Faster than this, two bodies that meet are sent Hit
    bool sleeping = true; // Bodies at rest fall asleep
    int bodies; // Made so far
    int shapes;
    long stamp; // Which state `state` is, by all that was ever done to the world: what C's world is told apart by
    Resident state; // Box3D's whole state after the last step, as pages of the world's (tide/resident.h): C's alone
    bool moved; // The last tick stepped the world: nothing awake and nothing done to it, and it doesn't
    List<long> gone; // Bodies whose entities were destroyed, until the next step
    Map<long, Entity> owners; // Each body's entity
    List<long> goneShapes; // Parts' shapes whose entities were destroyed, until the next step
    Map<long, Entity> parts; // Each part's shape's entity
    Map<Entity, Sensors> sensors; // The sensors of each entity that has any

    float historyDt;
    float historyLimit;
    int historyTick;
    Map<long, bool> selected;
    List<Collider> pending;
    List<HistoryFrame> history;

    // A prepared, read-only scene: opted-in bodies at the presented time,
    // all other geometry at the current physics step. Invalid times fail.
    bool Rewind(ViewTime time, out Query query)
    {
        query = default;
        if (!time.valid || time.tick < 0 || !(time.alpha >= 0 && time.alpha <= 1) ||
            !(historyDt > 0) || !(historyLimit > 0)) return false;
        float age = (float(long(historyTick) - long(time.tick) + 1) - time.alpha) * historyDt;
        if (!(age >= 0 && age <= historyLimit)) return false;
        mut int upper = -1;
        mut int lower = -1;
        for (int i = 0; i < history.count; i++)
        {
            if (history[i].tick == time.tick) upper = i;
            if (history[i].tick == time.tick - 1) lower = i;
        }
        if (upper < 0 || (time.alpha < 1 && lower < 0)) return false;
        if (!Ready()) return false;
        mut List<Collider> scene = [];
        foreach (var owner in owners)
        {
            if (selected.Has(owner.key) || gone.Contains(owner.key)) continue;
            ReadColliders(owner.key, out var current);
            foreach (var record in current)
            {
                mut var collider = record;
                if (goneShapes.Contains(collider.shape)) continue;
                collider.entity = owner.value;
                collider.part = PartOf(parts, collider.shape, owner.value);
                scene.Add(collider);
            }
        }
        mut Map<long, Collider> previousShapes = default;
        if (time.alpha < 1)
            foreach (var before in history[lower].colliders) previousShapes[before.shape] = before;
        foreach (var record in history[upper].colliders)
        {
            mut var collider = record;
            // Despawned bodies remain in history; live bodies can opt out.
            if (owners.Has(collider.body) && !selected.Has(collider.body)) continue;
            if (time.alpha < 1 && previousShapes.TryGet(collider.shape, out var before) &&
                before.body == collider.body && before.snaps == collider.snaps)
                collider = BlendCollider(before, collider, time.alpha);
            scene.Add(collider);
        }
        // Native handle order also determines overlap order and equal-distance ties.
        SortScene(scene);
        BuildScene(scene, out var nodes);
        query = Query { colliders = scene, nodes = nodes };
        return true;
    }

    // Whether C has the match's world to ask: its resident pages are restored
    // when it doesn't, as before a tick. False for a match no step was taken in.
    bool Ready()
    {
        if (stamp == 0) return false;
        if (!FindWorld(stamp))
        {
            RebuildWorld(state);
        }
        return true;
    }

    RayHit Met(Found found)
    {
        Entity entity = owners[found.body];
        return RayHit { entity = entity, part = PartOf(parts, found.shape, entity), point = found.point, normal = found.normal,
                        fraction = found.fraction };
    }

    // The first thing on the way from one point to another: whether there's any,
    // and what. A ray says nothing of a shape it starts inside, and passes
    // through sensors.
    bool Raycast(float3 from, float3 to, out RayHit hit)
    {
        hit = default;
        if (!Ready()) return false;
        Found found = CastRay(stamp, from, to, gone, gone.count, goneShapes, goneShapes.count);
        if (found.body == 0) return false;
        hit = Met(found);
        return true;
    }

    // The first thing a shape meets that's moved from one place to another,
    // turned by `rotation` all the way: a box, a sphere or a capsule as one on a
    // body is, with its size and its offset. `hit.point` is where the two touch.
    // What the shape is in at `from` is met there, with a fraction of 0 and no
    // normal.
    bool Cast(Box shape, float3 from, quaternion rotation, float3 to, out RayHit hit)
    {
        hit = default;
        if (!Ready()) return false;
        Found found = CastBox(stamp, shape, from, rotation, to, gone, gone.count, goneShapes,
                              goneShapes.count);
        if (found.body == 0) return false;
        hit = Met(found);
        return true;
    }

    bool Cast(Sphere shape, float3 from, quaternion rotation, float3 to, out RayHit hit)
    {
        hit = default;
        if (!Ready()) return false;
        Found found = CastSphere(stamp, shape, from, rotation, to, gone, gone.count, goneShapes,
                                 goneShapes.count);
        if (found.body == 0) return false;
        hit = Met(found);
        return true;
    }

    bool Cast(Capsule shape, float3 from, quaternion rotation, float3 to, out RayHit hit)
    {
        hit = default;
        if (!Ready()) return false;
        Found found = CastCapsule(stamp, shape, from, rotation, to, gone, gone.count, goneShapes,
                                  goneShapes.count);
        if (found.body == 0) return false;
        hit = Met(found);
        return true;
    }

    // The entities of the bodies C found, in its order: their bodies' ids'.
    void Owners(List<long> bodies, out List<Entity> found)
    {
        found = [];
        for (int i = 0; i < bodies.count; i++) found.Add(owners[bodies[i]]);
    }

    // The entities whose bodies a shape at a place overlaps or touches: whether
    // there's any, and which, each once, in the order of their bodies' ids.
    bool Overlap(Box shape, float3 at, quaternion rotation, out List<Entity> found)
    {
        found = [];
        if (!Ready()) return false;
        OverlapBox(out var bodies, stamp, shape, at, rotation, gone, gone.count, goneShapes,
                   goneShapes.count);
        Owners(bodies, out found);
        return found.count > 0;
    }

    bool Overlap(Sphere shape, float3 at, quaternion rotation, out List<Entity> found)
    {
        found = [];
        if (!Ready()) return false;
        OverlapSphere(out var bodies, stamp, shape, at, rotation, gone, gone.count, goneShapes,
                      goneShapes.count);
        Owners(bodies, out found);
        return found.count > 0;
    }

    bool Overlap(Capsule shape, float3 at, quaternion rotation, out List<Entity> found)
    {
        found = [];
        if (!Ready()) return false;
        OverlapCapsule(out var bodies, stamp, shape, at, rotation, gone, gone.count, goneShapes,
                       goneShapes.count);
        Owners(bodies, out found);
        return found.count > 0;
    }

    // The entities whose bodies have a shape in an entity's sensors, as the last
    // step found them: whether there's any, and which, each once, in the order of
    // their bodies' ids. `sensor` is the entity the sensor shape is a component
    // of: a body's, or a part's. None, for an entity with no sensor.
    bool Inside(Entity sensor, out List<Entity> found)
    {
        found = [];
        if (sensors.count == 0 || !sensors.TryGet(sensor, out var heldSensors)) return false;
        if (!Ready()) return false;
        SensorBodies(out var bodies, stamp, heldSensors.box, heldSensors.sphere, heldSensors.capsule, gone, gone.count,
                     goneShapes, goneShapes.count);
        Owners(bodies, out found);
        return found.count > 0;
    }

}

// The package's own: what its systems and its questions pass to C and back
struct Contact
{
    long a;
    long b;
    long shapeA;
    long shapeB;
    bool began;
}

struct Strike
{
    long a;
    long b;
    float3 point;
    float3 normal;
    float speed;
}

struct Found
{
    long body;
    long shape;
    float3 point;
    float3 normal;
    float fraction;
}

// An entity's sensors: Box3D's handle to each of its shapes that is one
struct Sensors
{
    long box;
    long sphere;
    long capsule;
}

[NativeName("b3t_open")]
extern bool OpenWorld(mut Resident state);


[NativeName("b3t_gone")]
extern void RemoveBodies(List<long> bodies, int count);

[NativeName("b3t_gone_shapes")]
extern void RemoveShapes(List<long> shapes, int count);

[NativeName("b3t_body_shapes")]
extern int CountShapes(long body);

[NativeName("b3t_body_shape")]
extern long ShapeAt(int index);

[NativeName("b3t_made_count")]
extern int CountMade();

[NativeName("b3t_made_body")]
extern long MadeBody(int index);

[NativeName("b3t_made_entity")]
extern Entity MadeEntity(int index);

[NativeName("b3t_box")]
extern long AttachBox(long body, in Box box);

[NativeName("b3t_sphere")]
extern long AttachSphere(long body, in Sphere sphere);

[NativeName("b3t_capsule")]
extern long AttachCapsule(long body, in Capsule capsule);

[NativeName("b3t_step")]
extern long StepWorld(mut Resident state, float dt, int substeps, float3 gravity, float contactStiffness, float contactDamping, float contactSpeed,
                      float bounceSpeed, float hitSpeed, bool sleeping);


[NativeName("b3t_touches")]
extern int CountTouches(long stamp);

[NativeName("b3t_touch")]
extern Contact ReadTouch(int index);

[NativeName("b3t_hits")]
extern int CountHits();

[NativeName("b3t_hit")]
extern Strike ReadHit(int index);

[NativeName("b3t_find")]
extern bool FindWorld(long stamp);

[NativeName("b3t_rebuild")]
extern void RebuildWorld(in Resident state);

[NativeName("b3t_ray")]
extern Found CastRay(long stamp, float3 from, float3 to, List<long> gone, int goneCount, List<long> goneShapes, int goneShapeCount);

[NativeName("b3t_cast_box")]
extern Found CastBox(long stamp, in Box shape, float3 from, quaternion rotation, float3 to, List<long> gone, int goneCount,
                     List<long> goneShapes, int goneShapeCount);

[NativeName("b3t_cast_sphere")]
extern Found CastSphere(long stamp, in Sphere shape, float3 from, quaternion rotation, float3 to, List<long> gone, int goneCount,
                        List<long> goneShapes, int goneShapeCount);

[NativeName("b3t_cast_capsule")]
extern Found CastCapsule(long stamp, in Capsule shape, float3 from, quaternion rotation, float3 to, List<long> gone, int goneCount,
                         List<long> goneShapes, int goneShapeCount);

[NativeName("b3t_overlap_box")]
extern void OverlapBox(out List<long> bodies, long stamp, in Box shape, float3 at, quaternion rotation, List<long> gone,
                       int goneCount, List<long> goneShapes, int goneShapeCount);

[NativeName("b3t_overlap_sphere")]
extern void OverlapSphere(out List<long> bodies, long stamp, in Sphere shape, float3 at, quaternion rotation, List<long> gone,
                          int goneCount, List<long> goneShapes, int goneShapeCount);

[NativeName("b3t_overlap_capsule")]
extern void OverlapCapsule(out List<long> bodies, long stamp, in Capsule shape, float3 at, quaternion rotation, List<long> gone,
                           int goneCount, List<long> goneShapes, int goneShapeCount);

[NativeName("b3t_inside")]
extern void SensorBodies(out List<long> bodies, long stamp, long first, long second, long third, List<long> gone, int goneCount,
                         List<long> goneShapes, int goneShapeCount);

// C's world for this match, at the state the match is in: the one it has, or
// the state restored from its resident pages. Then what went since the last
// step goes from it: the parts of the bodies that went are destroyed with them, the shapes of the
// parts that went by themselves, and the bodies.
//
// Each of these systems says where it is in the stage, so that nothing a game
// orders its own systems by, naming the stage or one of these, can put them in
// another order: each rests on what the ones before it did to C's world.
[Stage(PhysicsStages.Step, 0)]
system Begin(mut Physics physics)
{
    OpenWorld(physics.state);
    if (physics.parts.count > 0)
    {
        for (int i = 0; i < physics.gone.count; i++)
        {
            int shapes = CountShapes(physics.gone[i]);
            for (int k = 0; k < shapes; k++)
            {
                long shape = ShapeAt(k);
                if (physics.parts.TryGet(shape, out var part))
                {
                    physics.parts.Remove(shape);
                    part.Destroy();
                }
            }
        }
    }
    RemoveShapes(physics.goneShapes, physics.goneShapes.count);
    physics.goneShapes.Clear();
    RemoveBodies(physics.gone, physics.gone.count);
    physics.gone.Clear();
}

// New bodies are made, and what code wrote into a body since the last step
// goes to Box3D.
//
// Every body is looked at every tick, and most ticks most have nothing
// written, so this and Leave are systems written in C: they go through the
// bodies' fields as the arrays the match keeps them in, and write the fields
// of the ones there's something to write for. A system written in Tide would
// copy each body out to look at it. It takes Physics to write, which keeps it
// on one thread: what it does to the world is noted in the order of its rows.
[Stage(PhysicsStages.Step, 1)]
[NativeName("b3t_enter")]
extern system Enter(mut Body body, mut Physics physics);

// The bodies Enter made are their entities' from here on: whose each body is,
// the match keeps in a map, which is Tide's to write. C says which it made,
// in the order it made them, so a tick that makes none asks once.
[Stage(PhysicsStages.Step, 2)]
system Own(mut Physics physics)
{
    int made = CountMade();
    for (int i = 0; i < made; i++)
    {
        physics.bodies += 1;
        physics.owners[MadeBody(i)] = MadeEntity(i);
    }
}

[Stage(PhysicsStages.Step, 3)]
system AttachBoxes(Body body, Box box, mut Physics physics, without BoxMade, without Part)
{
    long shape = AttachBox(body.id, box);
    if (shape != 0)
    {
        physics.shapes += 1;
        if (box.sensor)
        {
            mut var sensors = physics.sensors[this];
            sensors.box = shape;
            physics.sensors[this] = sensors;
        }
    }
    this.Add(BoxMade);
}

[Stage(PhysicsStages.Step, 4)]
system AttachSpheres(Body body, Sphere sphere, mut Physics physics, without SphereMade, without Part)
{
    long shape = AttachSphere(body.id, sphere);
    if (shape != 0)
    {
        physics.shapes += 1;
        if (sphere.sensor)
        {
            mut var sensors = physics.sensors[this];
            sensors.sphere = shape;
            physics.sensors[this] = sensors;
        }
    }
    this.Add(SphereMade);
}

[Stage(PhysicsStages.Step, 5)]
system AttachCapsules(Body body, Capsule capsule, mut Physics physics, without CapsuleMade, without Part)
{
    long shape = AttachCapsule(body.id, capsule);
    if (shape != 0)
    {
        physics.shapes += 1;
        if (capsule.sensor)
        {
            mut var sensors = physics.sensors[this];
            sensors.capsule = shape;
            physics.sensors[this] = sensors;
        }
    }
    this.Add(CapsuleMade);
}

// A part's shapes go on the body of the entity it names, which was made by
// now if it was spawned by the last tick: after the bodies' own, so a game
// with no part has its shapes made as it did. A part with no body to be on is
// destroyed.
[Stage(PhysicsStages.Step, 6)]
system AttachBoxParts(Box box, mut Part part, World world, mut Physics physics, without BoxMade)
{
    mut long shape = 0;
    if (world.TryGet<Body>(part.of, out var body)) shape = AttachBox(body.id, box);
    if (shape == 0)
    {
        this.Destroy();
        return;
    }
    part.box = shape;
    physics.shapes += 1;
    physics.parts[shape] = this;
    if (box.sensor)
    {
        mut var sensors = physics.sensors[this];
        sensors.box = shape;
        physics.sensors[this] = sensors;
    }
    this.Add(BoxMade);
}

[Stage(PhysicsStages.Step, 7)]
system AttachSphereParts(Sphere sphere, mut Part part, World world, mut Physics physics, without SphereMade)
{
    mut long shape = 0;
    if (world.TryGet<Body>(part.of, out var body)) shape = AttachSphere(body.id, sphere);
    if (shape == 0)
    {
        this.Destroy();
        return;
    }
    part.sphere = shape;
    physics.shapes += 1;
    physics.parts[shape] = this;
    if (sphere.sensor)
    {
        mut var sensors = physics.sensors[this];
        sensors.sphere = shape;
        physics.sensors[this] = sensors;
    }
    this.Add(SphereMade);
}

[Stage(PhysicsStages.Step, 8)]
system AttachCapsuleParts(Capsule capsule, mut Part part, World world, mut Physics physics, without CapsuleMade)
{
    mut long shape = 0;
    if (world.TryGet<Body>(part.of, out var body)) shape = AttachCapsule(body.id, capsule);
    if (shape == 0)
    {
        this.Destroy();
        return;
    }
    part.capsule = shape;
    physics.shapes += 1;
    physics.parts[shape] = this;
    if (capsule.sensor)
    {
        mut var sensors = physics.sensors[this];
        sensors.capsule = shape;
        physics.sensors[this] = sensors;
    }
    this.Add(CapsuleMade);
}

// The step, and Box3D's state after it into the match. It isn't named Step,
// so that a game's [Before(Step)] is an error and not a place in the middle of
// these, after what code wrote has gone to Box3D: the stage is what to name.
[Stage(PhysicsStages.Step, 9)]
system Simulate(Time time, mut Physics physics)
{
    long stamp = StepWorld(physics.state, time.dt, physics.substeps, physics.gravity, physics.contactStiffness, physics.contactDamping,
                           physics.contactSpeed, physics.bounceSpeed, physics.hitSpeed, physics.sleeping);
    physics.moved = stamp != physics.stamp;
    if (!physics.moved) return;
    physics.stamp = stamp;
}

// Where the step left each body that it moved, into the fields that say so.
[Stage(PhysicsStages.Step, 10)]
[NativeName("b3t_leave")]
extern system Leave(mut Body body, Physics physics);

// The entity a shape is on: a part's, or else its body's own, and none for a
// shape that's gone.
Entity PartOf(Map<long, Entity> parts, long shape, Entity owner)
{
    if (shape == 0) return default;
    if (parts.count > 0 && parts.TryGet(shape, out var part)) return part;
    return owner;
}

[Stage(PhysicsStages.Step, 10)]
system Report(Physics physics)
{
    int count = physics.moved ? CountTouches(physics.stamp) : 0;
    for (int i = 0; i < count; i++)
    {
        Contact contact = ReadTouch(i);
        Entity a = physics.owners[contact.a];
        Entity b = physics.owners[contact.b];
        Entity partA = PartOf(physics.parts, contact.shapeA, a);
        Entity partB = PartOf(physics.parts, contact.shapeB, b);
        if (contact.began)
        {
            a.Send(Touched { other = b, part = partA, otherPart = partB });
            b.Send(Touched { other = a, part = partB, otherPart = partA });
        }
        else
        {
            a.Send(Parted { other = b, part = partA, otherPart = partB });
            b.Send(Parted { other = a, part = partB, otherPart = partA });
        }
    }
    int hits = physics.moved ? CountHits() : 0;
    for (int i = 0; i < hits; i++)
    {
        Strike strike = ReadHit(i);
        Entity a = physics.owners[strike.a];
        Entity b = physics.owners[strike.b];
        a.Send(Hit { other = b, point = strike.point, normal = -strike.normal, speed = strike.speed });
        b.Send(Hit { other = a, point = strike.point, normal = strike.normal, speed = strike.speed });
    }
}

// An entity that goes takes its body with it, at the next step.
event(Destroyed) Remove(Body body, mut Physics physics)
{
    if (body.id != 0)
    {
        physics.gone.Add(body.id);
        physics.owners.Remove(body.id);
    }
    if (physics.sensors.count > 0) physics.sensors.Remove(this);
}

// A part that goes takes its shapes off its body, at the next step: the ones
// that didn't go with the body already.
event(Destroyed) RemovePart(Part part, mut Physics physics)
{
    if (part.box != 0 && physics.parts.Remove(part.box)) physics.goneShapes.Add(part.box);
    if (part.sphere != 0 && physics.parts.Remove(part.sphere)) physics.goneShapes.Add(part.sphere);
    if (part.capsule != 0 && physics.parts.Remove(part.capsule)) physics.goneShapes.Add(part.capsule);
    if (physics.sensors.count > 0) physics.sensors.Remove(this);
}

// ---------------------------------------------------------------------------
// Questions: what's in the world, asked without changing it. Each takes the
// Physics singleton, and can be asked from a system, a handler or a view.
//
// They see the world as the last step left it. What code wrote into a body
// since isn't there yet, nor a body that was spawned since, and an entity
// that was destroyed since is found no more.


// Immutable geometry records: local shape points and the body's pose.
struct Collider
{
    long body;
    long shape;
    Entity entity;
    Entity part;
    int snaps;
    float3 position;
    quaternion rotation;
    float3[8] points;
    int count;
    float radius;
    bool sensor;
}

struct HistoryFrame
{
    int tick;
    List<Collider> colliders;
}

struct SceneBounds { float3 min; float3 max; bool valid; }
struct SceneNode { float3 min; float3 max; int collider; int next; }
[NativeName("b3t_collider_bounds")]
extern SceneBounds ColliderBounds(in Collider collider);
// A detached read-only query scene. Preparing it never moves live bodies.
struct Query
{
    List<Collider> colliders;
    List<SceneNode> nodes;

    List<int> Candidates(SceneBounds bounds)
    {
        mut List<int> found = [];
        if (!bounds.valid) return found;
        mut int i = 0;
        while (i < nodes.count)
        {
            var node = nodes[i];
            if (node.max.x < bounds.min.x || node.min.x > bounds.max.x || node.max.y < bounds.min.y || node.min.y > bounds.max.y || node.max.z < bounds.min.z || node.min.z > bounds.max.z)
                i = node.next > i && node.next <= nodes.count ? node.next : i + 1;
            else
            {
                if (node.collider >= 0) found.Add(node.collider);
                i++;
            }
        }
        SortCandidates(found);
        return found;
    }


    bool Raycast(float3 from, float3 to, out RayHit hit)
    {
        return Raycast(from, to, out hit, default);
    }

    bool Raycast(float3 from, float3 to, out RayHit hit, Body ignore)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(SceneBounds { min = Math.Min(from, to), max = Math.Max(from, to), valid = true }))
        {
            var collider = colliders[index];
            if (collider.sensor || collider.body == ignore.id) continue;
            var met = SceneRay(collider, from, to);
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Cast(Box shape, float3 from, quaternion rotation, float3 to, out RayHit hit)
    {
        return Cast(shape, from, rotation, to, out hit, default);
    }

    bool Cast(Box shape, float3 from, quaternion rotation, float3 to, out RayHit hit, Body ignore)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(BoxBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (collider.sensor || collider.body == ignore.id) continue;
            var met = SceneCastBox(collider, shape, from, rotation, to);
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Box shape, float3 at, quaternion rotation, out List<Entity> found)
    {
        found = [];
        foreach (var index in Candidates(BoxBounds(shape, rotation, at, at)))
        {
            var collider = colliders[index];
            if (collider.sensor || found.Contains(collider.entity)) continue;
            if (SceneOverlapBox(collider, shape, at, rotation)) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Cast(Sphere shape, float3 from, quaternion rotation, float3 to, out RayHit hit)
    {
        return Cast(shape, from, rotation, to, out hit, default);
    }

    bool Cast(Sphere shape, float3 from, quaternion rotation, float3 to, out RayHit hit, Body ignore)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(SphereBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (collider.sensor || collider.body == ignore.id) continue;
            var met = SceneCastSphere(collider, shape, from, rotation, to);
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Sphere shape, float3 at, quaternion rotation, out List<Entity> found)
    {
        found = [];
        foreach (var index in Candidates(SphereBounds(shape, rotation, at, at)))
        {
            var collider = colliders[index];
            if (collider.sensor || found.Contains(collider.entity)) continue;
            if (SceneOverlapSphere(collider, shape, at, rotation)) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Cast(Capsule shape, float3 from, quaternion rotation, float3 to, out RayHit hit)
    {
        return Cast(shape, from, rotation, to, out hit, default);
    }

    bool Cast(Capsule shape, float3 from, quaternion rotation, float3 to, out RayHit hit, Body ignore)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(CapsuleBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (collider.sensor || collider.body == ignore.id) continue;
            var met = SceneCastCapsule(collider, shape, from, rotation, to);
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Capsule shape, float3 at, quaternion rotation, out List<Entity> found)
    {
        found = [];
        foreach (var index in Candidates(CapsuleBounds(shape, rotation, at, at)))
        {
            var collider = colliders[index];
            if (collider.sensor || found.Contains(collider.entity)) continue;
            if (SceneOverlapCapsule(collider, shape, at, rotation)) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Inside(Entity sensor, out List<Entity> found)
    {
        found = [];
        mut List<int> visitors = [];
        foreach (var volume in colliders)
        {
            if (!volume.sensor || volume.part != sensor) continue;
            foreach (var index in Candidates(ColliderBounds(volume)))
            {
                var collider = colliders[index];
                if (collider.sensor || collider.body == volume.body || visitors.Contains(index)) continue;
                if (SceneTouch(volume, collider)) visitors.Add(index);
            }
        }
        SortCandidates(visitors);
        foreach (var index in visitors)
        {
            var entity = colliders[index].entity;
            if (!found.Contains(entity)) found.Add(entity);
        }
        return found.count > 0;
    }
}


struct SceneLeaf { SceneBounds bounds; int collider; float key; }
struct SceneBranch { int first; int count; }
void BuildScene(List<Collider> colliders, out List<SceneNode> nodes)
{
    nodes = [];
    mut List<SceneLeaf> leaves = [];
    for (int i = 0; i < colliders.count; i++)
    {
        var bounds = ColliderBounds(colliders[i]);
        if (bounds.valid) leaves.Add(SceneLeaf { bounds = bounds, collider = i });
    }
    if (leaves.count == 0) return;
    mut var low = leaves[0].bounds.min;
    mut var high = leaves[0].bounds.max;
    foreach (var leaf in leaves)
    {
        low = Math.Min(low, leaf.bounds.min);
        high = Math.Max(high, leaf.bounds.max);
    }
    mut int axis = 0;
    mut float extent = high.x - low.x;
    if (high.y - low.y > extent) { axis = 1; extent = high.y - low.y; }
    if (high.z - low.z > extent) { axis = 2; extent = high.z - low.z; }
    for (int i = 0; i < leaves.count; i++)
    {
        mut var leaf = leaves[i];
        leaf.key = 0.5 * leaf.bounds.min.x + 0.5 * leaf.bounds.max.x;
        if (axis == 1) leaf.key = 0.5 * leaf.bounds.min.y + 0.5 * leaf.bounds.max.y;
        if (axis == 2) leaf.key = 0.5 * leaf.bounds.min.z + 0.5 * leaf.bounds.max.z;
        leaves[i] = leaf;
    }
    leaves.Sort(a, b) { return a.key < b.key || (a.key == b.key && a.collider < b.collider); }
    mut List<SceneBranch> branches = [SceneBranch { first = 0, count = leaves.count }];
    while (branches.count > 0)
    {
        var branch = branches[branches.count - 1];
        branches.RemoveAt(branches.count - 1);
        int first = branch.first;
        int count = branch.count;
        mut var node = SceneNode { min = leaves[first].bounds.min, max = leaves[first].bounds.max,
            collider = -1, next = nodes.count + count * 2 - 1 };
        for (int i = first + 1; i < first + count; i++)
        {
            node.min = Math.Min(node.min, leaves[i].bounds.min);
            node.max = Math.Max(node.max, leaves[i].bounds.max);
        }
        if (count == 1) node.collider = leaves[first].collider;
        else
        {
            int middle = count / 2;
            branches.Add(SceneBranch { first = first + middle, count = count - middle });
            branches.Add(SceneBranch { first = first, count = middle });
        }
        nodes.Add(node);
    }
}


void SortCandidates(mut List<int> candidates)
{
    candidates.Sort(a, b) { return a < b; }
}

[NativeName("b3t_box_bounds")]
extern SceneBounds BoxBounds(in Box shape, quaternion rotation, float3 from, float3 to);

[NativeName("b3t_sphere_bounds")]
extern SceneBounds SphereBounds(in Sphere shape, quaternion rotation, float3 from, float3 to);

[NativeName("b3t_capsule_bounds")]
extern SceneBounds CapsuleBounds(in Capsule shape, quaternion rotation, float3 from, float3 to);

[NativeName("b3t_read_colliders")]
extern void ReadColliders(long body, out List<Collider> colliders);
[NativeName("b3t_blend_collider")]
extern Collider BlendCollider(in Collider before, in Collider current, float alpha);
[NativeName("b3t_scene_ray")]
extern Found SceneRay(in Collider collider, float3 from, float3 to);
[NativeName("b3t_scene_touch")]
extern bool SceneTouch(in Collider a, in Collider b);
[NativeName("b3t_scene_cast_box")]
extern Found SceneCastBox(in Collider collider, in Box shape, float3 from, quaternion rotation, float3 to);
[NativeName("b3t_scene_overlap_box")]
extern bool SceneOverlapBox(in Collider collider, in Box shape, float3 at, quaternion rotation);
[NativeName("b3t_scene_cast_sphere")]
extern Found SceneCastSphere(in Collider collider, in Sphere shape, float3 from, quaternion rotation, float3 to);
[NativeName("b3t_scene_overlap_sphere")]
extern bool SceneOverlapSphere(in Collider collider, in Sphere shape, float3 at, quaternion rotation);
[NativeName("b3t_scene_cast_capsule")]
extern Found SceneCastCapsule(in Collider collider, in Capsule shape, float3 from, quaternion rotation, float3 to);
[NativeName("b3t_scene_overlap_capsule")]
extern bool SceneOverlapCapsule(in Collider collider, in Capsule shape, float3 at, quaternion rotation);

[Stage(PhysicsStages.Step, 11)]
system BeginHistory(Time time, mut Physics physics)
{
    if (!(time.maxRewind > 0))
    {
        if (physics.historyLimit > 0)
        {
            physics.historyLimit = 0;
            physics.historyDt = 0;
            physics.historyTick = 0;
            physics.selected.Clear();
            physics.pending = [];
            physics.history = [];
        }
        return;
    }
    physics.historyTick = time.tick + 1;
    physics.historyDt = time.dt;
    physics.historyLimit = time.maxRewind;
    physics.selected.Clear();
    physics.pending = [];
    // Keep the extra lower endpoint required by fractional timestamps.
    while (physics.history.count > 1 &&
           float(long(physics.historyTick) - long(physics.history[1].tick)) * time.dt > time.maxRewind)
        physics.history.RemoveAt(0);
}

[Stage(PhysicsStages.Step, 12)]
[NativeName("b3t_capture_history")]
extern system CaptureHistory(Body body, mut Physics physics);

[Stage(PhysicsStages.Step, 13)]
system EndHistory(mut Physics physics)
{
    if (!(physics.historyLimit > 0)) return;
    for (int i = 0; i < physics.pending.count; i++)
    {
        mut var collider = physics.pending[i];
        collider.part = PartOf(physics.parts, collider.shape, collider.entity);
        physics.pending[i] = collider;
        physics.selected[collider.body] = true;
    }
    physics.history.Add(HistoryFrame { tick = physics.historyTick, colliders = physics.pending });
}

[Stage(PhysicsStages.Step, 14)]
[NativeName("b3t_seal_history")]
extern system SealHistory(mut Physics physics);

void SortScene(mut List<Collider> scene)
{
    scene.Sort(a, b) { return a.body < b.body || (a.body == b.body && a.shape < b.shape); }
}
