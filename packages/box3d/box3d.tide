[Stage(PhysicsStages.Step, 22)]
system BeginHistory(Time time, mut Physics physics)
{
    if (!(time.maxRewind > 0))
    {
        if (physics.historyLimit > 0)
        {
            physics.historyLimit = 0;
            physics.historyDt = 0;
            physics.historyTick = 0;
            physics.selected.Clear();
            physics.pending = [];
    physics.pendingHulls = [];
            physics.pendingHulls = [];
            physics.history = [];
        }
        return;
    }
    physics.historyTick = time.tick + 1;
    physics.historyDt = time.dt;
    physics.historyLimit = time.maxRewind;
    physics.selected.Clear();
    physics.pending = [];
    physics.pendingHulls = [];
    // Keep the extra lower endpoint required by fractional timestamps.
    while (physics.history.count > 1 &&
           float(long(physics.historyTick) - long(physics.history[1].tick)) * time.dt > time.maxRewind)
        physics.history.RemoveAt(0);
}

[Stage(PhysicsStages.Step, 23)]
[NativeName("b3t_capture_history")]
extern system CaptureHistory(Body body, mut Physics physics);

[Stage(PhysicsStages.Step, 24)]
system EndHistory(mut Physics physics)
{
    if (!(physics.historyLimit > 0)) return;
    for (int i = 0; i < physics.pending.count; i++)
    {
        mut var collider = physics.pending[i];
        collider.part = PartOf(physics.parts, collider.shape, collider.entity);
        physics.pending[i] = collider;
        physics.selected[collider.body] = true;
    }
    physics.history.Add(HistoryFrame { tick = physics.historyTick, colliders = physics.pending, hulls = physics.pendingHulls });
}

[Stage(PhysicsStages.Step, 25)]
[NativeName("b3t_seal_history")]
extern system SealHistory(mut Physics physics);

void SortScene(mut List<Collider> scene)
{
    scene.Sort(a, b) { return a.body < b.body || (a.body == b.body && a.shape < b.shape); }
}

// ---------------------------------------------------------------------------
// Joints are entities with Joint and exactly one type's settings component.
// Anchors and rotations are local to the corresponding body's origin.
component Joint
{
    Entity a;
    Entity b;
    float3 anchorA;
    float3 anchorB;
    quaternion rotationA = quaternion.identity;
    quaternion rotationB = quaternion.identity;
    float constraintHertz = 60;
    float constraintDampingRatio = 2;
    bool enabled = true;
    bool collideConnected;
    [PerShard] long id; // The package's own native handle, zero before attachment
    float3 force; // Read back after the step, in newtons
    float3 torque; // Read back after the step, in newton meters
}

component DistanceJoint
{
    float length = 1;
    float lowerSpringForce = -1e12;
    float upperSpringForce = 1e12;
    float hertz = 0;
    float dampingRatio = 0;
    float minLength = 0;
    float maxLength = 1e6;
    float maxMotorForce = 0;
    float motorSpeed = 0;
    bool enableSpring = false;
    bool enableLimit = false;
    bool enableMotor = false;
}

component MotorJoint
{
    float3 linearVelocity = float3(0);
    float3 angularVelocity = float3(0);
    float maxVelocityForce = 0;
    float maxVelocityTorque = 0;
    float linearHertz = 0;
    float linearDampingRatio = 0;
    float maxSpringForce = 0;
    float angularHertz = 0;
    float angularDampingRatio = 0;
    float maxSpringTorque = 0;
}

component FilterJoint
{
    bool enabled = true;
}

component ParallelJoint
{
    float hertz = 1;
    float dampingRatio = 1;
    float maxTorque = 1e12;
}

component PrismaticJoint
{
    float hertz = 0;
    float dampingRatio = 0;
    float targetTranslation = 0;
    float lowerTranslation = 0;
    float upperTranslation = 0;
    float maxMotorForce = 0;
    float motorSpeed = 0;
    bool enableSpring = false;
    bool enableLimit = false;
    bool enableMotor = false;
}

component RevoluteJoint
{
    float targetAngle = 0;
    float hertz = 0;
    float dampingRatio = 0;
    float lowerAngle = 0;
    float upperAngle = 0;
    float maxMotorTorque = 0;
    float motorSpeed = 0;
    bool enableSpring = false;
    bool enableLimit = false;
    bool enableMotor = false;
}

component SphericalJoint
{
    float hertz = 0;
    float dampingRatio = 0;
    quaternion targetRotation = quaternion.identity;
    float coneAngle = 0;
    float lowerTwistAngle = 0;
    float upperTwistAngle = 0;
    float maxMotorTorque = 0;
    float3 motorVelocity = float3(0);
    bool enableSpring = false;
    bool enableConeLimit = false;
    bool enableTwistLimit = false;
    bool enableMotor = false;
}

component WeldJoint
{
    float linearHertz = 0;
    float angularHertz = 0;
    float linearDampingRatio = 0;
    float angularDampingRatio = 0;
}

component WheelJoint
{
    float suspensionHertz = 1;
    float suspensionDampingRatio = 0.7;
    float lowerSuspensionLimit = 0;
    float upperSuspensionLimit = 0;
    float maxSpinTorque = 0;
    float spinSpeed = 0;
    float steeringHertz = 1;
    float steeringDampingRatio = 0.7;
    float targetSteeringAngle = 0;
    float maxSteeringTorque = 0;
    float lowerSteeringLimit = 0;
    float upperSteeringLimit = 0;
    bool enableSuspensionSpring = true;
    bool enableSuspensionLimit = false;
    bool enableSpinMotor = false;
    bool enableSteering = false;
    bool enableSteeringLimit = false;
}

[NativeName("b3t_sync_distance_joint")]
extern bool SyncDistanceJoint(mut Joint joint, long a, long b, in DistanceJoint settings);

[NativeName("b3t_sync_motor_joint")]
extern bool SyncMotorJoint(mut Joint joint, long a, long b, in MotorJoint settings);

[NativeName("b3t_sync_filter_joint")]
extern bool SyncFilterJoint(mut Joint joint, long a, long b, in FilterJoint settings);

[NativeName("b3t_sync_parallel_joint")]
extern bool SyncParallelJoint(mut Joint joint, long a, long b, in ParallelJoint settings);

[NativeName("b3t_sync_prismatic_joint")]
extern bool SyncPrismaticJoint(mut Joint joint, long a, long b, in PrismaticJoint settings);

