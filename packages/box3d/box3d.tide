// C's world for this match, at the state the match is in: the one it has, or
// the state restored from its resident pages. Then what went since the last
// step goes from it: the parts of the bodies that went are destroyed with them, the shapes of the
// parts that went by themselves, and the bodies.
//
// Each of these systems says where it is in the stage, so that nothing a game
// orders its own systems by, naming the stage or one of these, can put them in
// another order: each rests on what the ones before it did to C's world.
[Stage(PhysicsStages.Step, 1)]
system Begin(World world, mut Physics physics)
{
    OpenWorld(physics.state);
    if (physics.topologyChanged) foreach (var entry in physics.owners)
    {
        if (!world.TryGet<Body>(entry.value, out var body) || body.id != entry.key || !Shards.Owns(entry.value))
        {
            if (!physics.gone.Contains(entry.key)) physics.gone.Add(entry.key);
            physics.owners.Remove(entry.key);
        }
    }
    // An entity that went to another shard takes its sensors with it
    if (physics.topologyChanged && physics.sensors.count > 0) foreach (var entry in physics.sensors)
    {
        if (!Shards.Owns(entry.key)) physics.sensors.Remove(entry.key);
    }
    if (physics.parts.count > 0)
    {
        for (int i = 0; i < physics.gone.count; i++)
        {
            int shapes = CountShapes(physics.gone[i]);
            for (int k = 0; k < shapes; k++)
            {
                long shape = ShapeAt(k);
                if (physics.parts.TryGet(shape, out var part))
                {
                    physics.parts.Remove(shape);
                    part.Destroy();
                }
            }
        }
    }
    RemoveShapes(physics.goneShapes, physics.goneShapes.count);
    physics.goneShapes.Clear();
    RemoveBodies(physics.gone, physics.gone.count);
    physics.gone.Clear();
}

// New bodies are made, and what code wrote into a body since the last step
// goes to Box3D.
//
// Every body is looked at every tick, and most ticks most have nothing
// written, so this and Leave are systems written in C: they go through the
// bodies' fields as the arrays the match keeps them in, and write the fields
// of the ones there's something to write for. A system written in Tide would
// copy each body out to look at it. It takes Physics to write, which keeps it
// on one thread: what it does to the world is noted in the order of its rows.
[Stage(PhysicsStages.Step, 4)]
[NativeName("b3t_enter")]
extern system Enter(mut Body body, mut Physics physics);

// The bodies Enter made are their entities' from here on: whose each body is,
// the match keeps in a map, which is Tide's to write. C says which it made,
// in the order it made them, so a tick that makes none asks once.
[Stage(PhysicsStages.Step, 5)]
system Own(mut Physics physics)
{
    int made = CountMade();
    for (int i = 0; i < made; i++)
    {
        physics.bodies += 1;
        physics.owners[MadeBody(i)] = MadeEntity(i);
    }
}

[Stage(PhysicsStages.Step, 5)]
system PrepareParts(mut Part part, World world)
{
    part.body = 0;
    if (world.TryGet<Body>(part.of, out var body)) part.body = body.id;
    if (part.body == 0) this.Destroy();
}

[Stage(PhysicsStages.Step, 2)]
[NativeName("b3t_begin_shapes")]
extern system BeginShapes(mut Physics physics);

long ColliderBody(World world, Entity entity)
{
    if (world.TryGet<Part>(entity, out var part))
    {
        if (world.TryGet<Body>(part.of, out var parent)) return parent.id;
        return 0;
    }
    if (world.TryGet<Body>(entity, out var body)) return body.id;
    return 0;
}

// A copy of another shard's body near this one's border, and when it was last seen
struct Copy
{
    long body;
    int tick;
}

[NativeName("b3t_copy")]
extern long CopyBody(long id, in Body body);

[NativeName("b3t_drop_copy")]
extern void DropCopy(long id);

// In a sharded world, the bodies other shards own near this one's border are
// here as ghosts, and Box3D has each as a copy this shard's bodies run into:
// kinematic (static for a static one), where its owner last had it and as
// fast, with its own box, sphere or capsule. In a world that isn't sharded,
// there are none, and these systems aren't there.
[Ghosts]
[Stage(PhysicsStages.Step, 3)]
system CopyBodies(Body body, World world, Time time, mut Physics physics)
{
    long had = physics.copies.TryGet(this, out var copy) ? copy.body : 0;
    long made = CopyBody(had, body);
    if (had != 0 && made != had) physics.copyOf.Remove(had);
    if (made != 0 && made != had)
    {
        if (world.TryGet<Box>(this, out var box)) AttachBox(made, box);
        if (world.TryGet<Sphere>(this, out var sphere)) AttachSphere(made, sphere);
        if (world.TryGet<Capsule>(this, out var capsule)) AttachCapsule(made, capsule);
        physics.copyOf[made] = this;
    }
    physics.copies[this] = Copy { body = made, tick = time.tick };
}

// A copy whose ghost went last tick, or that this shard owns now, goes
[Stage(PhysicsStages.Step, 2)]
system DropCopies(Time time, mut Physics physics)
{
    if (physics.copies.count == 0) return;
    foreach (var entry in physics.copies)
    {
        if (entry.value.tick >= time.tick - 1 && !Shards.Owns(entry.key)) continue;
        DropCopy(entry.value.body);
        physics.copyOf.Remove(entry.value.body);
        physics.copies.Remove(entry.key);
    }
}

[NativeName("b3t_drop_collider")]
extern void DropCollider(int index, mut Resident state);

[Stage(PhysicsStages.Step, 3)]
system PruneShapes(World world, mut Physics physics)
{
    if (!physics.topologyChanged) return;
    for (int i = 0; i < physics.colliders.count; i++)
    {
        long on = physics.colliders[i].body;
        if (on == 0) continue;
        Entity owner = physics.colliders[i].owner;
        int kind = physics.colliders[i].kind & 7;
        bool present = (kind == 0 && world.Has<Box>(owner)) || (kind == 1 && world.Has<Sphere>(owner)) ||
            (kind == 2 && world.Has<Capsule>(owner)) || (kind == 3 && world.Has<MeshCollider>(owner)) ||
            (kind == 4 && world.Has<HullCollider>(owner)) || (kind == 5 && world.Has<HeightFieldCollider>(owner));
        if (!present || ColliderBody(world, owner) != on) DropCollider(i, physics.state);
    }
}

[Stage(PhysicsStages.Step, 6)]
[NativeName("b3t_live_box")]
extern system AttachBoxes(Body body, mut Box shape, mut Physics physics, without Part);
[Stage(PhysicsStages.Step, 9)]
[NativeName("b3t_live_box_parts")]
extern system AttachBoxesParts(Part part, mut Box shape, mut Physics physics);

[Stage(PhysicsStages.Step, 7)]
[NativeName("b3t_live_sphere")]
extern system AttachSpheres(Body body, mut Sphere shape, mut Physics physics, without Part);
[Stage(PhysicsStages.Step, 10)]
[NativeName("b3t_live_sphere_parts")]
extern system AttachSpheresParts(Part part, mut Sphere shape, mut Physics physics);

[Stage(PhysicsStages.Step, 8)]
[NativeName("b3t_live_capsule")]
extern system AttachCapsules(Body body, mut Capsule shape, mut Physics physics, without Part);
[Stage(PhysicsStages.Step, 11)]
[NativeName("b3t_live_capsule_parts")]
extern system AttachCapsulesParts(Part part, mut Capsule shape, mut Physics physics);

[Stage(PhysicsStages.Step, 12)]
[NativeName("b3t_live_mesh")]
extern system AttachMeshes(Body body, mut MeshCollider shape, mut Physics physics, without Part);
[Stage(PhysicsStages.Step, 13)]
[NativeName("b3t_live_mesh_parts")]
extern system AttachMeshesParts(Part part, mut MeshCollider shape, mut Physics physics);

[Stage(PhysicsStages.Step, 14)]
[NativeName("b3t_live_hull")]
extern system AttachHulls(Body body, mut HullCollider shape, mut Physics physics, without Part);
[Stage(PhysicsStages.Step, 15)]
[NativeName("b3t_live_hull_parts")]
extern system AttachHullsParts(Part part, mut HullCollider shape, mut Physics physics);

[Stage(PhysicsStages.Step, 16)]
[NativeName("b3t_live_height")]
extern system AttachHeightFields(Body body, mut HeightFieldCollider shape, mut Physics physics, without Part);
[Stage(PhysicsStages.Step, 17)]
[NativeName("b3t_live_height_parts")]
extern system AttachHeightFieldsParts(Part part, mut HeightFieldCollider shape, mut Physics physics);


[NativeName("b3t_shape_changes")]
extern int CountShapeChanges();
[NativeName("b3t_shape_change")]
extern ShapeChange ReadShapeChange(int index);

[Stage(PhysicsStages.Step, 18)]
system RegisterShapes(mut Physics physics)
{
    for (int i = 0; i < CountShapeChanges(); i++)
    {
        var change = ReadShapeChange(i);
        if (change.before != 0) physics.parts.Remove(change.before);
        if (change.after != 0 && change.owner != physics.owners[change.body]) physics.parts[change.after] = change.owner;
        mut var sensors = physics.sensors[change.owner];
        long sensor = change.sensor ? change.after : 0;
        if (change.kind == 0) sensors.box = sensor;
        if (change.kind == 1) sensors.sphere = sensor;
        if (change.kind == 2) sensors.capsule = sensor;
        if (change.kind == 4) sensors.hull = sensor;
        if (sensors.box == 0 && sensors.sphere == 0 && sensors.capsule == 0 && sensors.hull == 0) physics.sensors.Remove(change.owner);
        else physics.sensors[change.owner] = sensors;
    }
}

[Stage(PhysicsStages.Step, 18)]
system RecordParts(mut Part part, Physics physics)
{
    var slots = physics.colliderIndex[this];
    part.box = slots.box > 0 ? physics.colliders[slots.box - 1].shape : 0;
    part.sphere = slots.sphere > 0 ? physics.colliders[slots.sphere - 1].shape : 0;
    part.capsule = slots.capsule > 0 ? physics.colliders[slots.capsule - 1].shape : 0;
    part.mesh = slots.mesh > 0 ? physics.colliders[slots.mesh - 1].shape : 0;
    part.hull = slots.hull > 0 ? physics.colliders[slots.hull - 1].shape : 0;
    part.heightField = slots.heightField > 0 ? physics.colliders[slots.heightField - 1].shape : 0;
}

[Stage(PhysicsStages.Step, 20)]
// The step isn't named Step: games name the phase, PhysicsStages.Step.
system Simulate(Time time, mut Physics physics)
{
    long stamp = StepWorld(physics.state, time.dt, physics.substeps, physics.gravity, physics.contactStiffness, physics.contactDamping,
                           physics.contactSpeed, physics.bounceSpeed, physics.hitSpeed, physics.sleeping);
    physics.moved = stamp != physics.stamp;
    if (!physics.moved) return;
    physics.stamp = stamp;
}

// Where the step left each body that it moved, into the fields that say so.
[Stage(PhysicsStages.Step, 21)]
[NativeName("b3t_leave")]
extern system Leave(mut Body body, Physics physics);

// Whose a body is: its entity's, or for a copy of another shard's body (in a
// sharded world), the entity it copies
Entity BodyOwner(Physics physics, long body)
{
    if (physics.owners.TryGet(body, out var owner)) return owner;
    return physics.copyOf[body];
}

// The entity a shape is on: a part's, or else its body's own, and none for a
// shape that's gone.
Entity PartOf(Map<long, Entity> parts, long shape, Entity owner)
{
    if (shape == 0) return default;
    if (parts.count > 0 && parts.TryGet(shape, out var part)) return part;
    return owner;
}

[Stage(PhysicsStages.Step, 21)]
system Report(Physics physics)
{
    int count = physics.moved ? CountTouches(physics.stamp) : 0;
    for (int i = 0; i < count; i++)
    {
        Contact contact = ReadTouch(i);
        Entity a = BodyOwner(physics, contact.a);
        Entity b = BodyOwner(physics, contact.b);
        Entity partA = PartOf(physics.parts, contact.shapeA, a);
        Entity partB = PartOf(physics.parts, contact.shapeB, b);
        // In a sharded world each side of a border tells its own entities, of a copy too: the copy's own shard tells it
        if (contact.began)
        {
            if (Shards.Owns(a)) a.Send(Touched { other = b, part = partA, otherPart = partB });
            if (Shards.Owns(b)) b.Send(Touched { other = a, part = partB, otherPart = partA });
        }
        else
        {
            if (Shards.Owns(a)) a.Send(Parted { other = b, part = partA, otherPart = partB });
            if (Shards.Owns(b)) b.Send(Parted { other = a, part = partB, otherPart = partA });
        }
    }
    int hits = physics.moved ? CountHits() : 0;
    for (int i = 0; i < hits; i++)
    {
        Strike strike = ReadHit(i);
        Entity a = BodyOwner(physics, strike.a);
        Entity b = BodyOwner(physics, strike.b);
        if (Shards.Owns(a)) a.Send(Hit { other = b, point = strike.point, normal = -strike.normal, speed = strike.speed });
        if (Shards.Owns(b)) b.Send(Hit { other = a, point = strike.point, normal = strike.normal, speed = strike.speed });
    }
}

// An entity that goes takes its body with it, at the next step.
event(Destroyed) Remove(Body body, mut Physics physics)
{
    if (body.id != 0)
    {
        physics.gone.Add(body.id);
        physics.owners.Remove(body.id);
    }
    if (physics.sensors.count > 0) physics.sensors.Remove(this);
}

// A part that goes takes its shapes off its body, at the next step: the ones
// that didn't go with the body already.
event(Destroyed) RemovePart(Part part, mut Physics physics)
{
    if (part.box != 0 && physics.parts.Remove(part.box)) physics.goneShapes.Add(part.box);
    if (part.sphere != 0 && physics.parts.Remove(part.sphere)) physics.goneShapes.Add(part.sphere);
    if (part.capsule != 0 && physics.parts.Remove(part.capsule)) physics.goneShapes.Add(part.capsule);
    if (part.mesh != 0 && physics.parts.Remove(part.mesh)) physics.goneShapes.Add(part.mesh);
    if (part.hull != 0 && physics.parts.Remove(part.hull)) physics.goneShapes.Add(part.hull);
    if (part.heightField != 0 && physics.parts.Remove(part.heightField)) physics.goneShapes.Add(part.heightField);
    if (physics.sensors.count > 0) physics.sensors.Remove(this);
}

// ---------------------------------------------------------------------------
// Questions: what's in the world, asked without changing it. Each takes the
// Physics singleton, and can be asked from a system, a handler or a view.
//
// They see the world as the last step left it. What code wrote into a body
// since isn't there yet, nor a body that was spawned since, and an entity
// that was destroyed since is found no more.


// Immutable geometry records: local shape points and the body's pose.
struct Collider
{
    long body;
    long shape;
    Entity entity;
    Entity part;
    int snaps;
    float3 position;
    quaternion rotation;
    float3[8] points;
    int count;
    float radius;
    bool sensor;
    int geometry; // One-based index in the accompanying hull geometry list
    long category;
    long mask;
}

struct HullGeometry
{
    float3[128] points;
    float4[128] planes;
    int count;
    int faces;
}

struct HistoryFrame
{
    int tick;
    List<Collider> colliders;
    List<HullGeometry> hulls;
}

struct SceneBounds { float3 min; float3 max; bool valid; }
struct SceneNode { float3 min; float3 max; int collider; int next; }
[NativeName("b3t_collider_bounds")]
extern SceneBounds ColliderBounds(in Collider collider);
// A detached read-only query scene. Preparing it never moves live bodies.
struct Query
{
    List<Collider> colliders;
    List<SceneNode> nodes;
    List<HullGeometry> hulls;

    bool RaycastAll(float3 from, float3 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return RaycastAll(from, to, out hits, default, includeSensors, filter);
    }

    bool RaycastAll(float3 from, float3 to, out List<RayHit> hits, Body ignore, bool includeSensors = false, QueryFilter filter = default)
    {
        mut List<SceneHit> found = [];
        foreach (var index in Candidates(SceneBounds { min = Math.Min(from, to), max = Math.Max(from, to), valid = true }))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || (!includeSensors && collider.sensor) || collider.body == ignore.id) continue;
            AddSceneHit(found, collider, (collider.geometry > 0 ? HullRay(collider, hulls[collider.geometry - 1], from, to) : SceneRay(collider, from, to)));
        }
        return FinishSceneHits(found, out hits);
    }

    bool CastAll(Box shape, float3 from, quaternion rotation, float3 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return CastAll(shape, from, rotation, to, out hits, default, includeSensors, filter);
    }

    bool CastAll(Box shape, float3 from, quaternion rotation, float3 to, out List<RayHit> hits, Body ignore, bool includeSensors = false, QueryFilter filter = default)
    {
        mut List<SceneHit> found = [];
        foreach (var index in Candidates(BoxBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || (!includeSensors && collider.sensor) || collider.body == ignore.id) continue;
            AddSceneHit(found, collider, (collider.geometry > 0 ? HullCastBox(collider, hulls[collider.geometry - 1], shape, from, rotation, to) : SceneCastBox(collider, shape, from, rotation, to)));
        }
        return FinishSceneHits(found, out hits);
    }

    bool CastAll(Sphere shape, float3 from, quaternion rotation, float3 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return CastAll(shape, from, rotation, to, out hits, default, includeSensors, filter);
    }

    bool CastAll(Sphere shape, float3 from, quaternion rotation, float3 to, out List<RayHit> hits, Body ignore, bool includeSensors = false, QueryFilter filter = default)
    {
        mut List<SceneHit> found = [];
        foreach (var index in Candidates(SphereBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || (!includeSensors && collider.sensor) || collider.body == ignore.id) continue;
            AddSceneHit(found, collider, (collider.geometry > 0 ? HullCastSphere(collider, hulls[collider.geometry - 1], shape, from, rotation, to) : SceneCastSphere(collider, shape, from, rotation, to)));
        }
        return FinishSceneHits(found, out hits);
    }

    bool CastAll(Capsule shape, float3 from, quaternion rotation, float3 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return CastAll(shape, from, rotation, to, out hits, default, includeSensors, filter);
    }

    bool CastAll(Capsule shape, float3 from, quaternion rotation, float3 to, out List<RayHit> hits, Body ignore, bool includeSensors = false, QueryFilter filter = default)
    {
        mut List<SceneHit> found = [];
        foreach (var index in Candidates(CapsuleBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || (!includeSensors && collider.sensor) || collider.body == ignore.id) continue;
            AddSceneHit(found, collider, (collider.geometry > 0 ? HullCastCapsule(collider, hulls[collider.geometry - 1], shape, from, rotation, to) : SceneCastCapsule(collider, shape, from, rotation, to)));
        }
        return FinishSceneHits(found, out hits);
    }

    List<int> Candidates(SceneBounds bounds)
    {
        mut List<int> found = [];
        if (!bounds.valid) return found;
        mut int i = 0;
        while (i < nodes.count)
        {
            var node = nodes[i];
            if (node.max.x < bounds.min.x || node.min.x > bounds.max.x || node.max.y < bounds.min.y || node.min.y > bounds.max.y || node.max.z < bounds.min.z || node.min.z > bounds.max.z)
                i = node.next > i && node.next <= nodes.count ? node.next : i + 1;
            else
            {
                if (node.collider >= 0) found.Add(node.collider);
                i++;
            }
        }
        SortCandidates(found);
        return found;
    }


    bool Raycast(float3 from, float3 to, out RayHit hit, QueryFilter filter = default)
    {
        return Raycast(from, to, out hit, default, filter);
    }

    bool Raycast(float3 from, float3 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(SceneBounds { min = Math.Min(from, to), max = Math.Max(from, to), valid = true }))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || collider.sensor || collider.body == ignore.id) continue;
            var met = (collider.geometry > 0 ? HullRay(collider, hulls[collider.geometry - 1], from, to) : SceneRay(collider, from, to));
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Cast(Box shape, float3 from, quaternion rotation, float3 to, out RayHit hit, QueryFilter filter = default)
    {
        return Cast(shape, from, rotation, to, out hit, default, filter);
    }

    bool Cast(Box shape, float3 from, quaternion rotation, float3 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(BoxBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || collider.sensor || collider.body == ignore.id) continue;
            var met = (collider.geometry > 0 ? HullCastBox(collider, hulls[collider.geometry - 1], shape, from, rotation, to) : SceneCastBox(collider, shape, from, rotation, to));
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Box shape, float3 at, quaternion rotation, out List<Entity> found, QueryFilter filter = default)
    {
        found = [];
        foreach (var index in Candidates(BoxBounds(shape, rotation, at, at)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || collider.sensor || found.Contains(collider.entity)) continue;
            if ((collider.geometry > 0 ? HullOverlapBox(collider, hulls[collider.geometry - 1], shape, at, rotation) : SceneOverlapBox(collider, shape, at, rotation))) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Cast(Sphere shape, float3 from, quaternion rotation, float3 to, out RayHit hit, QueryFilter filter = default)
    {
        return Cast(shape, from, rotation, to, out hit, default, filter);
    }

    bool Cast(Sphere shape, float3 from, quaternion rotation, float3 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(SphereBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || collider.sensor || collider.body == ignore.id) continue;
            var met = (collider.geometry > 0 ? HullCastSphere(collider, hulls[collider.geometry - 1], shape, from, rotation, to) : SceneCastSphere(collider, shape, from, rotation, to));
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Sphere shape, float3 at, quaternion rotation, out List<Entity> found, QueryFilter filter = default)
    {
        found = [];
        foreach (var index in Candidates(SphereBounds(shape, rotation, at, at)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || collider.sensor || found.Contains(collider.entity)) continue;
            if ((collider.geometry > 0 ? HullOverlapSphere(collider, hulls[collider.geometry - 1], shape, at, rotation) : SceneOverlapSphere(collider, shape, at, rotation))) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Cast(Capsule shape, float3 from, quaternion rotation, float3 to, out RayHit hit, QueryFilter filter = default)
    {
        return Cast(shape, from, rotation, to, out hit, default, filter);
    }

    bool Cast(Capsule shape, float3 from, quaternion rotation, float3 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(CapsuleBounds(shape, rotation, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || collider.sensor || collider.body == ignore.id) continue;
            var met = (collider.geometry > 0 ? HullCastCapsule(collider, hulls[collider.geometry - 1], shape, from, rotation, to) : SceneCastCapsule(collider, shape, from, rotation, to));
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && met.shape >= nearestShape)))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Capsule shape, float3 at, quaternion rotation, out List<Entity> found, QueryFilter filter = default)
    {
        found = [];
        foreach (var index in Candidates(CapsuleBounds(shape, rotation, at, at)))
        {
            var collider = colliders[index];
            if (!filter.Accepts(collider) || collider.sensor || found.Contains(collider.entity)) continue;
            if ((collider.geometry > 0 ? HullOverlapCapsule(collider, hulls[collider.geometry - 1], shape, at, rotation) : SceneOverlapCapsule(collider, shape, at, rotation))) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Inside(Entity sensor, out List<Entity> found)
    {
        found = [];
        mut List<int> visitors = [];
        foreach (var volume in colliders)
        {
            if (!volume.sensor || volume.part != sensor) continue;
            foreach (var index in Candidates(ColliderBounds(volume)))
            {
                var collider = colliders[index];
                if (collider.sensor || collider.body == volume.body || visitors.Contains(index)) continue;
                if ((volume.geometry > 0 || collider.geometry > 0 ? HullTouch(volume, hulls[volume.geometry - 1], collider, hulls[collider.geometry - 1]) : SceneTouch(volume, collider))) visitors.Add(index);
            }
        }
        SortCandidates(visitors);
        foreach (var index in visitors)
        {
            var entity = colliders[index].entity;
            if (!found.Contains(entity)) found.Add(entity);
        }
        return found.count > 0;
    }
}


// Temporary query results retain the collider key while sorting. Adjacent
// candidates of a mesh share that key, so only its nearest triangle is kept.
struct SceneHit { long shape; RayHit hit; }
void AddSceneHit(mut List<SceneHit> found, Collider collider, Found met)
{
    if (met.body == 0) return;
    var value = SceneHit { shape = met.shape, hit = RayHit { entity = collider.entity, part = collider.part,
        point = met.point, normal = met.normal, fraction = met.fraction } };
    var last = found.count - 1;
    if (last >= 0 && found[last].shape == met.shape)
    {
        if (met.fraction < found[last].hit.fraction) found[last] = value;
    }
    else found.Add(value);
}

bool FinishSceneHits(mut List<SceneHit> found, out List<RayHit> hits)
{
    found.Sort(a, b) { return a.hit.fraction < b.hit.fraction || (a.hit.fraction == b.hit.fraction &&
        a.shape < b.shape); }
    hits = [];
    foreach (var value in found) hits.Add(value.hit);
    return hits.count > 0;
}

struct SceneLeaf { SceneBounds bounds; int collider; float key; }
struct SceneBranch { int first; int count; }
void BuildScene(List<Collider> colliders, out List<SceneNode> nodes)
{
    nodes = [];
    mut List<SceneLeaf> leaves = [];
    for (int i = 0; i < colliders.count; i++)
    {
        var bounds = ColliderBounds(colliders[i]);
        if (bounds.valid) leaves.Add(SceneLeaf { bounds = bounds, collider = i });
    }
    if (leaves.count == 0) return;
    mut var low = leaves[0].bounds.min;
    mut var high = leaves[0].bounds.max;
    foreach (var leaf in leaves)
    {
        low = Math.Min(low, leaf.bounds.min);
        high = Math.Max(high, leaf.bounds.max);
    }
    mut int axis = 0;
    mut float extent = high.x - low.x;
    if (high.y - low.y > extent) { axis = 1; extent = high.y - low.y; }
    if (high.z - low.z > extent) { axis = 2; extent = high.z - low.z; }
    for (int i = 0; i < leaves.count; i++)
    {
        mut var leaf = leaves[i];
        leaf.key = 0.5 * leaf.bounds.min.x + 0.5 * leaf.bounds.max.x;
        if (axis == 1) leaf.key = 0.5 * leaf.bounds.min.y + 0.5 * leaf.bounds.max.y;
        if (axis == 2) leaf.key = 0.5 * leaf.bounds.min.z + 0.5 * leaf.bounds.max.z;
        leaves[i] = leaf;
    }
    leaves.Sort(a, b) { return a.key < b.key || (a.key == b.key && a.collider < b.collider); }
    mut List<SceneBranch> branches = [SceneBranch { first = 0, count = leaves.count }];
    while (branches.count > 0)
    {
        var branch = branches[branches.count - 1];
        branches.RemoveAt(branches.count - 1);
        int first = branch.first;
        int count = branch.count;
        mut var node = SceneNode { min = leaves[first].bounds.min, max = leaves[first].bounds.max,
            collider = -1, next = nodes.count + count * 2 - 1 };
        for (int i = first + 1; i < first + count; i++)
        {
            node.min = Math.Min(node.min, leaves[i].bounds.min);
            node.max = Math.Max(node.max, leaves[i].bounds.max);
        }
        if (count == 1) node.collider = leaves[first].collider;
        else
        {
            int middle = count / 2;
            branches.Add(SceneBranch { first = first + middle, count = count - middle });
            branches.Add(SceneBranch { first = first, count = middle });
        }
        nodes.Add(node);
    }
}


void SortCandidates(mut List<int> candidates)
{
    candidates.Sort(a, b) { return a < b; }
}

