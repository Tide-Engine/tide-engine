extern bool SyncRevoluteJoint(mut Joint joint, long a, long b, in RevoluteJoint settings);

[NativeName("b3t_sync_spherical_joint")]
extern bool SyncSphericalJoint(mut Joint joint, long a, long b, in SphericalJoint settings);

[NativeName("b3t_sync_weld_joint")]
extern bool SyncWeldJoint(mut Joint joint, long a, long b, in WeldJoint settings);

