// A remove/add can return an entity to exactly the same archetype and row.
// Its fresh Body still has id zero, so the old owner must be pruned.
[Stage(PhysicsStages.Step, 0)]
[NativeName("b3t_check_bodies")]
extern system CheckBodies(Body body, mut Physics physics);
