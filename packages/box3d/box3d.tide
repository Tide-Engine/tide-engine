[NativeName("b3t_collider_filter")]
extern void ApplyColliderFilter(int index, in CollisionFilter filter, bool present, mut Resident state);
[Stage(PhysicsStages.Step, 18)]
system FilterColliders(World world, mut Physics physics)
{
    if (!physics.topologyChanged) return;
    for (int i = 0; i < physics.colliders.count; i++)
    {
        if ((physics.colliders[i].kind & 64) == 0) continue;
        if (!world.Has<CollisionFilter>(physics.colliders[i].owner))
            ApplyColliderFilter(i, default, false, physics.state);
    }
}

