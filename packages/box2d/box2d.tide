[Stage(PhysicsStages.Step, 14)]
system AttachPartBoxes(mut Part part, Box shape, World world, mut Physics physics, without Body)
{
    Entity owner = part.of;
    if (!world.TryGet<Body>(owner, out var body)) return;
    var key = FixtureKey { entity = this, kind = 0 };
    mut var held = physics.fixtures[this];
    while (held.shapes.count < 6) held.shapes.Add(default);
    var previous = held.shapes[key.kind];
    var filter = world.Get<CollisionFilter>(this);
    mut var fixture = SyncBox(previous.state, body.id, shape, filter, world.Has<CollisionFilter>(this));
    if (fixture.id == previous.state.id && fixture.signature == previous.state.signature) return;
    ForgetFixture(previous, this, physics);
    if (fixture.id != 0)
    {
        FixtureShapes(fixture, out var shapes);
        foreach (long id in shapes)
        {
            if (owner != this) physics.parts[id] = this;
            physics.shapes += 1;
        }
        if (shape.sensor)
        {
            mut var sensors = physics.sensors[this];
            foreach (long id in shapes) sensors.shapes.Add(id);
            physics.sensors[this] = sensors;
        }
        held.shapes[key.kind] = Fixture { state = fixture, shapes = shapes };
    }
    else held.shapes[key.kind] = default;
    physics.fixtures[this] = held;
    part.box = fixture.id;
    this.Add(BoxMade);
}

[Stage(PhysicsStages.Step, 15)]
system AttachPartCircles(mut Part part, Circle shape, World world, mut Physics physics, without Body)
{
    Entity owner = part.of;
    if (!world.TryGet<Body>(owner, out var body)) return;
    var key = FixtureKey { entity = this, kind = 1 };
    mut var held = physics.fixtures[this];
    while (held.shapes.count < 6) held.shapes.Add(default);
    var previous = held.shapes[key.kind];
    var filter = world.Get<CollisionFilter>(this);
    mut var fixture = SyncCircle(previous.state, body.id, shape, filter, world.Has<CollisionFilter>(this));
    if (fixture.id == previous.state.id && fixture.signature == previous.state.signature) return;
    ForgetFixture(previous, this, physics);
    if (fixture.id != 0)
    {
        FixtureShapes(fixture, out var shapes);
        foreach (long id in shapes)
        {
            if (owner != this) physics.parts[id] = this;
            physics.shapes += 1;
        }
        if (shape.sensor)
        {
            mut var sensors = physics.sensors[this];
            foreach (long id in shapes) sensors.shapes.Add(id);
            physics.sensors[this] = sensors;
        }
        held.shapes[key.kind] = Fixture { state = fixture, shapes = shapes };
    }
    else held.shapes[key.kind] = default;
    physics.fixtures[this] = held;
    part.circle = fixture.id;
    this.Add(CircleMade);
}

[Stage(PhysicsStages.Step, 16)]
system RecordFixtures(mut Physics physics)
{
    int count = CountFixtureChanges();
    for (int i = 0; i < count; i++)
    {
        var change = ReadFixtureChange(i);
        mut var held = physics.fixtures[change.entity];
        while (held.shapes.count < 6) held.shapes.Add(default);
        ForgetFixture(held.shapes[change.kind], change.entity, physics);
        mut Fixture fixture = Fixture { state = change.state };
        if (fixture.state.id != 0)
        {
            FixtureShapes(fixture.state, out fixture.shapes);
            ReadFixtureSource(i, out fixture.source);
            physics.shapes += fixture.shapes.count;
            if (change.sensor)
            {
                mut var sensors = physics.sensors[change.entity];
                foreach (long id in fixture.shapes) sensors.shapes.Add(id);
                physics.sensors[change.entity] = sensors;
            }
        }
        held.shapes[change.kind] = fixture;
        physics.fixtures[change.entity] = held;
        if (change.kind == 0) change.entity.Add(BoxMade);
        if (change.kind == 1) change.entity.Add(CircleMade);
    }
}

// A body's parts go with it: the tick after an entity with a body was
// destroyed, each part looks whether the one it names is still there. In any
// other tick it's passed by.
[Stage(PhysicsStages.Step, 17)]
system DropParts(Part part, World world)
{
    // In a sharded world, one whose body is another shard's waits: it goes where its body is
    if ((!world.TryGet<Body>(part.of, out var body) || body.id == 0) && Shards.Owns(part.of)) this.Destroy();
}

// The step, and Box2D's state after it into the match. It isn't named Step,
// so that a game's [Before(Step)] is an error and not a place in the middle of
// these, after what code wrote has gone to Box2D: the stage is what to name.
[Stage(PhysicsStages.Step, 20)]
system Simulate(Time time, mut Physics physics)
{
    long stamp = StepWorld(time.dt, physics.substeps, physics.gravity, physics.contactStiffness, physics.contactDamping,
                           physics.contactSpeed, physics.bounceSpeed, physics.hitSpeed, physics.sleeping);
    physics.moved = stamp != physics.stamp;
    if (!physics.moved) return;
    physics.stamp = stamp;
    physics.size = WriteImage(out physics.image);
}

// Where the step left each body that it moved, into the fields that say so.
[Stage(PhysicsStages.Step, 21)]
[NativeName("b2t_leave")]
extern system Leave(mut Body body, Physics physics);

// Which of a body's shapes one is, as an entity: the part it's the shape of,
// or the body's own entity. A shape that's gone is no entity's.
Entity PartOf(Map<long, Entity> parts, long shape, Entity body)
{
    if (shape == 0) return default;
    if (parts.count > 0 && parts.TryGet(shape, out var part)) return part;
    return body;
}

// Whether two bodies push each other: both dynamic. A sharded world keeps the two
// on one shard while they touch, so each has its weight against the other; a
// copy of a static or kinematic body pushes as the body itself does
bool Pushing(World world, Entity a, Entity b)
{
    return world.Get<Body>(a).type == BodyType.Dynamic && world.Get<Body>(b).type == BodyType.Dynamic;
}

[Stage(PhysicsStages.Step, 21)]
system Report(Physics physics, World world)
{
    if (!physics.moved) return;
    int count = CountTouches(physics.stamp);
    for (int i = 0; i < count; i++)
    {
        Contact contact = ReadTouch(i);
        Entity a = BodyOwner(physics, contact.a);
        Entity b = BodyOwner(physics, contact.b);
        Entity partA = PartOf(physics.parts, contact.shapeA, a);
        Entity partB = PartOf(physics.parts, contact.shapeB, b);
        // In a sharded world each side of a border tells its own entities, of a copy too: the copy's own shard tells it
        if (contact.began)
        {
            if (Pushing(world, a, b)) Shards.Together(a, b);
            if (Shards.Owns(a)) a.Send(Touched { other = b, part = partA, otherPart = partB });
            if (Shards.Owns(b)) b.Send(Touched { other = a, part = partB, otherPart = partA });
        }
        else
        {
            Shards.Apart(a, b); // As many as touched, whatever they are now: one that wasn't is nothing
            if (Shards.Owns(a)) a.Send(Parted { other = b, part = partA, otherPart = partB });
            if (Shards.Owns(b)) b.Send(Parted { other = a, part = partB, otherPart = partA });
        }
    }
    int hits = CountHits();
    for (int i = 0; i < hits; i++)
    {
        Blow blow = ReadHit(i);
        Entity a = BodyOwner(physics, blow.a);
        Entity b = BodyOwner(physics, blow.b);
        Entity partA = PartOf(physics.parts, blow.shapeA, a);
        Entity partB = PartOf(physics.parts, blow.shapeB, b);
        if (Shards.Owns(a)) a.Send(Hit { other = b, part = partA, otherPart = partB, point = blow.point, normal = blow.normal, speed = blow.speed });
        if (Shards.Owns(b)) b.Send(Hit { other = a, part = partB, otherPart = partA, point = blow.point, normal = -blow.normal, speed = blow.speed });
    }
}

// An entity that goes takes its body with it, at the next step.
event(Destroyed) Remove(Body body, mut Physics physics)
{
    if (body.id != 0)
    {
        physics.gone.Add(body.id);
        physics.owners.Remove(body.id);
    }
    if (physics.sensors.count > 0) physics.sensors.Remove(this);
}

// Stored shape handles also hide despawned parts from queries before the step.
event(Destroyed) Shed(with Part, mut Physics physics)
{
    if (!physics.fixtures.TryGet(this, out var held)) return;
    for (int kind = 0; kind < 6; kind++)
    {
        foreach (long shape in held.shapes[kind].shapes)
        {
            physics.shed.Add(shape);
            physics.parts.Remove(shape);
        }
    }
    physics.sensors.Remove(this);
}

// ---------------------------------------------------------------------------
// Asking the world
//
// These ask something of the world and change nothing of it. Each takes the
// Physics of the code that asks, a system's, a handler's or a view's, and
// answers for the world as that Physics has it: as its last step left it. So
// a system before the step asks of the last tick's world, one after it of
// this tick's, and a view of the world it draws. What code wrote into a body
// since isn't in the answer, nor is a body that was spawned since: they're the
// next step's. An entity that was destroyed since isn't met any more.
//
// The answers are the same on every machine, as the world is.


// Immutable geometry records: local shape points and the body's pose.
struct Collider
{
    long body;
    long shape;
    Entity entity;
    Entity part;
    int snaps;
    float2 position;
    float angle;
    float2[8] points;
    int count;
    float radius;
    bool sensor;
    int kind;
    long category;
    long mask;
    int group;
}

struct HistoryFrame
{
    int tick;
    List<Collider> colliders;
}

struct SceneBounds { float2 min; float2 max; bool valid; }
struct SceneNode { float2 min; float2 max; int collider; int next; }
[NativeName("b2t_collider_bounds")]
extern SceneBounds ColliderBounds(in Collider collider);
// A detached read-only query scene. Preparing it never moves live bodies.
struct Query
{
    List<Collider> colliders;
    List<SceneNode> nodes;

    bool RaycastAll(float2 from, float2 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return RaycastAll(from, to, out hits, default, includeSensors, filter);
    }

    bool RaycastAll(float2 from, float2 to, out List<RayHit> hits, Body ignore, bool includeSensors = false, QueryFilter filter = default)
    {
        mut List<SceneHit> found = [];
        foreach (var index in Candidates(SceneBounds { min = Math.Min(from, to), max = Math.Max(from, to), valid = true }))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || (!includeSensors && collider.sensor) || collider.body == ignore.id) continue;
            AddSceneHit(found, collider, SceneRay(collider, from, to));
        }
        return FinishSceneHits(found, out hits);
    }

    bool CastAll(Box shape, float2 from, float angle, float2 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return CastAll(shape, from, angle, to, out hits, default, includeSensors, filter);
    }

    bool CastAll(Box shape, float2 from, float angle, float2 to, out List<RayHit> hits, Body ignore, bool includeSensors = false, QueryFilter filter = default)
    {
        mut List<SceneHit> found = [];
        foreach (var index in Candidates(BoxBounds(shape, angle, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || (!includeSensors && collider.sensor) || collider.body == ignore.id) continue;
            AddSceneHit(found, collider, SceneCastBox(collider, shape, from, angle, to));
        }
        return FinishSceneHits(found, out hits);
    }

    bool CastAll(Circle shape, float2 from, float angle, float2 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return CastAll(shape, from, angle, to, out hits, default, includeSensors, filter);
    }

    bool CastAll(Circle shape, float2 from, float angle, float2 to, out List<RayHit> hits, Body ignore, bool includeSensors = false, QueryFilter filter = default)
    {
        mut List<SceneHit> found = [];
        foreach (var index in Candidates(CircleBounds(shape, angle, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || (!includeSensors && collider.sensor) || collider.body == ignore.id) continue;
            AddSceneHit(found, collider, SceneCastCircle(collider, shape, from, angle, to));
        }
        return FinishSceneHits(found, out hits);
    }

    List<int> Candidates(SceneBounds bounds)
    {
        mut List<int> found = [];
        if (!bounds.valid) return found;
        mut int i = 0;
        while (i < nodes.count)
        {
            var node = nodes[i];
            if (node.max.x < bounds.min.x || node.min.x > bounds.max.x || node.max.y < bounds.min.y || node.min.y > bounds.max.y)
                i = node.next > i && node.next <= nodes.count ? node.next : i + 1;
            else
            {
                if (node.collider >= 0) found.Add(node.collider);
                i++;
            }
        }
        SortCandidates(found);
        return found;
    }


    bool Raycast(float2 from, float2 to, out RayHit hit, QueryFilter filter = default)
    {
        return Raycast(from, to, out hit, default, filter);
    }

    bool Raycast(float2 from, float2 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(SceneBounds { min = Math.Min(from, to), max = Math.Max(from, to), valid = true }))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || collider.sensor || collider.body == ignore.id) continue;
            var met = SceneRay(collider, from, to);
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && (met.shape & 0xFFFF_FFFFL) >= (nearestShape & 0xFFFF_FFFFL))))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Cast(Box shape, float2 from, float angle, float2 to, out RayHit hit, QueryFilter filter = default)
    {
        return Cast(shape, from, angle, to, out hit, default, filter);
    }

    bool Cast(Box shape, float2 from, float angle, float2 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(BoxBounds(shape, angle, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || collider.sensor || collider.body == ignore.id) continue;
            var met = SceneCastBox(collider, shape, from, angle, to);
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && (met.shape & 0xFFFF_FFFFL) >= (nearestShape & 0xFFFF_FFFFL))))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Box shape, float2 at, float angle, out List<Entity> found, QueryFilter filter = default)
    {
        found = [];
        foreach (var index in Candidates(BoxBounds(shape, angle, at, at)))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || collider.sensor || found.Contains(collider.entity)) continue;
            if (SceneOverlapBox(collider, shape, at, angle)) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Cast(Circle shape, float2 from, float angle, float2 to, out RayHit hit, QueryFilter filter = default)
    {
        return Cast(shape, from, angle, to, out hit, default, filter);
    }

    bool Cast(Circle shape, float2 from, float angle, float2 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
        hit = default;
        mut bool any = false;
        mut long nearestShape = 0;
        foreach (var index in Candidates(CircleBounds(shape, angle, from, to)))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || collider.sensor || collider.body == ignore.id) continue;
            var met = SceneCastCircle(collider, shape, from, angle, to);
            if (met.body == 0 || (any && (met.fraction > hit.fraction ||
                (met.fraction == hit.fraction && (met.shape & 0xFFFF_FFFFL) >= (nearestShape & 0xFFFF_FFFFL))))) continue;
            hit = RayHit { entity = collider.entity, part = collider.part, point = met.point,
                           normal = met.normal, fraction = met.fraction };
            nearestShape = met.shape;
            any = true;
        }
        return any;
    }

    bool Overlap(Circle shape, float2 at, float angle, out List<Entity> found, QueryFilter filter = default)
    {
        found = [];
        foreach (var index in Candidates(CircleBounds(shape, angle, at, at)))
        {
            var collider = colliders[index];
            if (!filter.Matches(collider) || collider.sensor || found.Contains(collider.entity)) continue;
            if (SceneOverlapCircle(collider, shape, at, angle)) found.Add(collider.entity);
        }
        return found.count > 0;
    }

    bool Inside(Entity sensor, out List<Entity> found)
    {
        found = [];
        mut List<int> visitors = [];
        foreach (var volume in colliders)
        {
            if (!volume.sensor || volume.part != sensor) continue;
            foreach (var index in Candidates(ColliderBounds(volume)))
            {
                var collider = colliders[index];
                if (collider.sensor || collider.body == volume.body || visitors.Contains(index)) continue;
                bool collide = volume.group != 0 && volume.group == collider.group ? volume.group > 0 :
                    (volume.category & collider.mask) != 0 && (collider.category & volume.mask) != 0;
                if (!collide) continue;
                if (SceneTouch(volume, collider)) visitors.Add(index);
            }
        }
        SortCandidates(visitors);
        foreach (var index in visitors)
        {
            var entity = colliders[index].entity;
            if (!found.Contains(entity)) found.Add(entity);
        }
        return found.count > 0;
    }
    bool CastAll(Capsule shape, float2 from, float angle, float2 to, out List<RayHit> hits, bool includeSensors = false, QueryFilter filter = default)
    {
        return CastAll(shape, from, angle, to, out hits, default, includeSensors, filter);
    }

