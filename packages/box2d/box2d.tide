// Additional native shapes. Polygon computes the convex hull of up to eight
// local vertices. A chain is one-sided, with its front to each edge's right.
component Capsule
{
    float2 a = float2(0, -0.5);
    float2 b = float2(0, 0.5);
    float radius = 0.5;
    float density = 1;
    float friction = 0.6;
    float bounce;
    bool sensor;
}
component Polygon
{
    List<float2> points;
    float radius;
    float density = 1;
    float friction = 0.6;
    float bounce;
    bool sensor;
}
component Segment
{
    float2 a = float2(-0.5, 0);
    float2 b = float2(0.5, 0);
    float friction = 0.6;
    float bounce;
    bool sensor;
}
component Chain
{
    List<float2> points;
    float friction = 0.6;
    float bounce;
    bool loop;
}
component CollisionFilter
{
    long category = 1;
    long mask = -1;
    int group;
}
struct FixtureKey { Entity entity; int kind; }
struct FixtureState { long id; long body; long signature; int kind; }
struct Fixture { FixtureState state; List<long> shapes; List<byte> source; }

Entity FixtureOwner(World world, Entity entity)
{
    if (world.Has<Body>(entity)) return entity;
    if (world.TryGet<Part>(entity, out var part)) return part.of;
    return default;
}
bool HasFixture(World world, FixtureKey key)
{
    if (key.kind == 0) return world.Has<Box>(key.entity);
    if (key.kind == 1) return world.Has<Circle>(key.entity);
    if (key.kind == 2) return world.Has<Capsule>(key.entity);
    if (key.kind == 3) return world.Has<Polygon>(key.entity);
    if (key.kind == 4) return world.Has<Segment>(key.entity);
    if (key.kind == 5) return world.Has<Chain>(key.entity);
    return false;
}
void ForgetFixture(Fixture fixture, Entity entity, mut Physics physics)
{
    foreach (long shape in fixture.shapes)
    {
        physics.parts.Remove(shape);
        mut var sensors = physics.sensors[entity];
        sensors.shapes.Remove(shape);
        if (sensors.shapes.count > 0) physics.sensors[entity] = sensors;
        else physics.sensors.Remove(entity);
    }
}

