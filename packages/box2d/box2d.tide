    }

    bool Cast(Capsule shape, float2 from, float angle, float2 to, out RayHit hit, QueryFilter filter = default)
    {
        return Cast(shape, from, angle, to, out hit, default, filter);
    }

    bool Cast(Capsule shape, float2 from, float angle, float2 to, out RayHit hit, Body ignore, QueryFilter filter = default)
    {
