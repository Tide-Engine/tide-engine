// Removes orphaned handles too, including removal of the Joint component.
[Stage(PhysicsStages.Step, 3)]
system RemoveJoints(World world, mut Physics physics)
{
    foreach (var entry in physics.joints)
    {
        if (!world.TryGet<Joint>(entry.value, out var joint) || joint.id != entry.key)
        {
            DropJoint(entry.key);
            physics.joints.Remove(entry.key);
        }
    }
}

[Stage(PhysicsStages.Step, 18)]
system SynchronizeJoints(mut Joint joint, World world, mut Physics physics)
{
    long old = joint.id;
    mut int count = 0;
    if (world.Has<DistanceJoint>(this)) count += 1;
    if (world.Has<MotorJoint>(this)) count += 1;
    if (world.Has<FilterJoint>(this)) count += 1;
    if (world.Has<PrismaticJoint>(this)) count += 1;
    if (world.Has<RevoluteJoint>(this)) count += 1;
    if (world.Has<WeldJoint>(this)) count += 1;
    if (world.Has<WheelJoint>(this)) count += 1;
    if (world.Has<MoverJoint>(this)) count += 1;
    if (world.Has<PogoJoint>(this)) count += 1;
    // In a sharded world, a joint whose bodies aren't both this shard's holds nothing until they are
    if (!Shards.Owns(joint.a) || !Shards.Owns(joint.b))
    {
        if (joint.id != 0)
        {
            DropJoint(joint.id);
            physics.joints.Remove(joint.id);
            joint.id = 0;
        }
        return;
    }
    if (count != 1 || !world.TryGet<Body>(joint.a, out var a) || !world.TryGet<Body>(joint.b, out var b))
    {
        DropJoint(joint.id);
        physics.joints.Remove(old);
        this.Destroy();
        return;
    }
    mut bool valid = false;
    if (world.TryGet<DistanceJoint>(this, out var distance)) valid = SyncDistanceJoint(joint, a.id, b.id, distance);
    else if (world.TryGet<MotorJoint>(this, out var motor)) valid = SyncMotorJoint(joint, a.id, b.id, motor);
    else if (world.TryGet<FilterJoint>(this, out var filter)) valid = SyncFilterJoint(joint, a.id, b.id, filter);
    else if (world.TryGet<PrismaticJoint>(this, out var prismatic)) valid = SyncPrismaticJoint(joint, a.id, b.id, prismatic);
    else if (world.TryGet<RevoluteJoint>(this, out var revolute)) valid = SyncRevoluteJoint(joint, a.id, b.id, revolute);
    else if (world.TryGet<WeldJoint>(this, out var weld)) valid = SyncWeldJoint(joint, a.id, b.id, weld);
    else if (world.TryGet<WheelJoint>(this, out var wheel)) valid = SyncWheelJoint(joint, a.id, b.id, wheel);
    else if (world.TryGet<MoverJoint>(this, out var mover)) valid = SyncMoverJoint(joint, a.id, b.id, mover);
    else if (world.TryGet<PogoJoint>(this, out var pogo)) valid = SyncPogoJoint(joint, a.id, b.id, pogo);
    if (old != joint.id) physics.joints.Remove(old);
    if (joint.id != 0) physics.joints[joint.id] = this;
    if (!valid) this.Destroy();
}

[Stage(PhysicsStages.Step, 21)]
system ReadJoints(mut Joint joint, Physics physics)
{
    if (physics.moved) ReadJoint(joint);
}



component WheelJoint
{
    float hertz = 1;
    float dampingRatio = 0.7;
    float lowerTranslation;
    float upperTranslation;
    float maxMotorTorque;
    float motorSpeed;
    bool enableSpring = true;
    bool enableLimit;
    bool enableMotor;
}
component MoverJoint { float2 linearVelocity; float2 maxVelocityForce; }
component PogoJoint
{
    float2 normal = float2(0, 1);
    float hertz = 1;
    float dampingRatio = 0.7;
    float restLength = 1;
    float maxTensionForce;
    float maxCompressionForce = 1e12;
    float impulse;
    float velocity;
}

