// C's world for this match, at the state the match is in: the one it has, or
// one made from the image. The bodies whose entities were destroyed since the
// last step go, and the shapes of the parts whose entities were.
//
// Each of these systems says where it is in the stage, so that nothing a game
// orders its own systems by, naming the stage or one of these, can put them in
// another order: each rests on what the ones before it did to C's world.
[Stage(PhysicsStages.Step, 2)]
system Begin(mut Physics physics, World world)
{
    if (!OpenWorld(physics.stamp))
    {
        RestoreWorld(physics.image, physics.size, physics.stamp);
    }
    physics.dropped = physics.gone.count;
    RemoveBodies(physics.gone, physics.gone.count);
    physics.gone.Clear();
    // Component removal and replacement follow the same path as despawning.
    if (physics.topologyChanged) foreach (var owner in physics.owners)
    {
        if (!world.TryGet<Body>(owner.value, out var body) || body.id != owner.key || !Shards.Owns(owner.value))
        {
            RemoveBodies([owner.key], 1);
            physics.owners.Remove(owner.key);
            physics.dropped += 1;
        }
    }
    if (physics.topologyChanged) foreach (var entry in physics.fixtures)
    {
        mut var held = entry.value;
        mut bool changed = false;
        mut bool any = false;
        for (int kind = 0; kind < 6; kind++)
        {
            var fixture = held.shapes[kind];
            if (fixture.state.id == 0) continue;
            if (!Shards.Owns(entry.key) || !HasFixture(world, FixtureKey { entity = entry.key, kind = kind }) ||
                !world.TryGet<Body>(FixtureOwner(world, entry.key), out var body) || body.id != fixture.state.body)
            {
                ForgetFixture(fixture, entry.key, physics);
                DropFixture(fixture.state);
                held.shapes[kind] = default;
                changed = true;
            }
            else any = true;
        }
        if (!any) physics.fixtures.Remove(entry.key);
        else if (changed) physics.fixtures[entry.key] = held;
    }
    // An entity that went to another shard takes its sensors with it
    if (physics.topologyChanged && physics.sensors.count > 0) foreach (var entry in physics.sensors)
    {
        if (!Shards.Owns(entry.key)) physics.sensors.Remove(entry.key);
    }
    RemoveShapes(physics.shed, physics.shed.count);
    physics.shed.Clear();
    BeginFixtureChanges(physics.topologyChanged);
}

// A copy of another shard's body near this one's border, and when it was last seen
struct Copy
{
    long body;
    int tick;
}

[NativeName("b2t_copy")]
extern long CopyBody(long id, in Body body);

[NativeName("b2t_copy_box")]
extern void CopyBox(long body, in Box shape);

[NativeName("b2t_copy_circle")]
extern void CopyCircle(long body, in Circle shape);

[NativeName("b2t_drop_copy")]
extern void DropCopy(long id);

// The box a body's shapes cover, by Box's handle
struct Span
{
    float2 lo;
    float2 hi;
}

[NativeName("b2t_span")]
extern Span BodySpan(long id);

[NativeName("b2t_copy_capsule")]
extern void CopyCapsule(long body, in Capsule shape);

[NativeName("b2t_copy_polygon")]
extern void CopyPolygon(long body, in Hull shape);

[NativeName("b2t_copy_segment")]
extern void CopySegment(long body, in Segment shape);

[NativeName("b2t_copy_chain")]
extern void CopyChain(long body, List<float2> points, int count, float friction, float bounce, bool loop);

// ...and a part whose shapes are on a copy, and when it was last seen
struct CopyPart
{
    Entity of;
    long body;
    int tick;
}

// The shapes an entity has, on a copy
void CopyShapes(World world, Entity entity, long body)
{
    if (world.TryGet<Box>(entity, out var box)) CopyBox(body, box);
    if (world.TryGet<Circle>(entity, out var circle)) CopyCircle(body, circle);
    if (world.TryGet<Capsule>(entity, out var capsule)) CopyCapsule(body, capsule);
    if (world.TryGet<Polygon>(entity, out var polygon)) CopyPolygon(body, PolygonShape(polygon));
    if (world.TryGet<Segment>(entity, out var segment)) CopySegment(body, segment);
    if (world.TryGet<Chain>(entity, out var chain)) CopyChain(body, chain.points, chain.points.count, chain.friction, chain.bounce, chain.loop);
}

// In a sharded world, the bodies other shards own near this one's border are
// here as copies, and Box2D has each as a copy this shard's bodies run into:
// kinematic (static for a static one), where its owner last had it and as
// fast, with its shapes. In a world that isn't sharded, every body is this
// shard's own, and these do nothing.
[Stage(PhysicsStages.Step, 3)]
system CopyBodies(World world, Time time, mut Physics physics, query (Body body) bodies)
{
    foreach (var row in bodies)
    {
        if (Shards.Owns(row.entity))
        {
            // A static body reaching past where it is, like a floor: every shard near any of it has a copy
            if (Shards.on && row.body.type == BodyType.Static && row.body.id != 0)
            {
                Span span = BodySpan(row.body.id);
                Shards.Spans(row.entity, (span.lo + span.hi) * 0.5, span.hi - span.lo);
            }
            continue;
        }
        long had = physics.copies.TryGet(row.entity, out var copy) ? copy.body : 0;
        long made = CopyBody(had, row.body);
        if (had != 0 && made != had) physics.copyOf.Remove(had);
        if (made != 0 && made != had)
        {
            CopyShapes(world, row.entity, made);
            physics.copyOf[made] = row.entity;
        }
        physics.copies[row.entity] = Copy { body = made, tick = time.tick };
    }
}

// A part another shard owns, on a body copied here: its shapes are on the copy
[Stage(PhysicsStages.Step, 4)]
system CopyParts(World world, Time time, mut Physics physics, query (Part part) parts)
{
    if (physics.copies.count == 0) return;
    foreach (var row in parts)
    {
        if (Shards.Owns(row.entity) || !physics.copies.TryGet(row.part.of, out var copy) || copy.body == 0) continue;
        if (!physics.copiedParts.TryGet(row.entity, out var on) || on.body != copy.body) CopyShapes(world, row.entity, copy.body);
        physics.copiedParts[row.entity] = CopyPart { of = row.part.of, body = copy.body, tick = time.tick };
    }
}

// A copy whose ghost went last tick, or that this shard owns now, goes, once
// Begin has Box2D's world
[Stage(PhysicsStages.Step, 3)]
system DropCopies(Time time, mut Physics physics)
{
    if (physics.copies.count == 0) return;
    // A copied part that went, or that this shard owns now: its body's copy is
    // made again, without it
    if (physics.copiedParts.count > 0) foreach (var entry in physics.copiedParts)
    {
        if (entry.value.tick >= time.tick - 1 && !Shards.Owns(entry.key)) continue;
        if (physics.copies.TryGet(entry.value.of, out var copy) && copy.body == entry.value.body)
        {
            DropCopy(copy.body);
            physics.copyOf.Remove(copy.body);
            physics.copies.Remove(entry.value.of);
        }
        physics.copiedParts.Remove(entry.key);
    }
    foreach (var entry in physics.copies)
    {
        if (entry.value.tick >= time.tick - 1 && !Shards.Owns(entry.key)) continue;
        DropCopy(entry.value.body);
        physics.copyOf.Remove(entry.value.body);
        physics.copies.Remove(entry.key);
    }
}

// Whose a body is: its entity's, or for a copy of another shard's body (in a
// sharded world), the entity it copies
Entity BodyOwner(Physics physics, long body)
{
    if (physics.owners.TryGet(body, out var owner)) return owner;
    return physics.copyOf[body];
}

// New bodies are made, and what code wrote into a body since the last step
// goes to Box2D.
//
// Every body is looked at every tick, and most ticks most have nothing
// written, so this and Leave are systems written in C: they go through the
// bodies' fields as the arrays the match keeps them in, and write the fields
// of the ones there's something to write for. A system written in Tide would
// copy each body out to look at it. It takes Physics to write, which keeps it
// on one thread: what it does to the world is noted in the order of its rows.
[Stage(PhysicsStages.Step, 4)]
[NativeName("b2t_enter")]
extern system Enter(mut Body body, mut Physics physics);

// The bodies Enter made are their entities' from here on: whose each body is,
// the match keeps in a map, which is Tide's to write. It runs for the bodies
// Enter ran for, in its order, and asks C of each whether it was made. It
// takes no component, so nothing is copied to ask.
[Stage(PhysicsStages.Step, 5)]
system Own(mut Physics physics, with Body)
{
    long made = TakeMade(this);
    if (made != 0)
    {
        physics.bodies += 1;
        physics.owners[made] = this;
    }
}

[Stage(PhysicsStages.Step, 6)]
[NativeName("b2t_attach_box_rows")]
extern system AttachBoxes(Body body, Box shape, mut Physics physics, without CollisionFilter);

[Stage(PhysicsStages.Step, 7)]
[NativeName("b2t_attach_filtered_box_rows")]
extern system AttachFilteredBoxes(Body body, Box shape, CollisionFilter filter, mut Physics physics);

[Stage(PhysicsStages.Step, 8)]
[NativeName("b2t_attach_circle_rows")]
extern system AttachCircles(Body body, Circle shape, mut Physics physics, without CollisionFilter);

[Stage(PhysicsStages.Step, 9)]
[NativeName("b2t_attach_filtered_circle_rows")]
extern system AttachFilteredCircles(Body body, Circle shape, CollisionFilter filter, mut Physics physics);

[Stage(PhysicsStages.Step, 10)]
system AttachCapsules(Capsule shape, World world, mut Physics physics)
{
    Entity owner = FixtureOwner(world, this);
    if (!world.TryGet<Body>(owner, out var body)) return;
    var key = FixtureKey { entity = this, kind = 2 };
    mut var held = physics.fixtures[this];
    while (held.shapes.count < 6) held.shapes.Add(default);
    var previous = held.shapes[key.kind];
    var filter = world.Get<CollisionFilter>(this);
    mut var fixture = SyncCapsule(previous.state, body.id, shape, filter, world.Has<CollisionFilter>(this));
    if (fixture.id == previous.state.id && fixture.signature == previous.state.signature) return;
    ForgetFixture(previous, this, physics);
    if (fixture.id != 0)
    {
        FixtureShapes(fixture, out var shapes);
        foreach (long id in shapes)
        {
            if (owner != this) physics.parts[id] = this;
            physics.shapes += 1;
        }
        if (shape.sensor)
        {
            mut var sensors = physics.sensors[this];
            foreach (long id in shapes) sensors.shapes.Add(id);
            physics.sensors[this] = sensors;
        }
        held.shapes[key.kind] = Fixture { state = fixture, shapes = shapes };
    }
    else held.shapes[key.kind] = default;
    physics.fixtures[this] = held;
}

[Stage(PhysicsStages.Step, 11)]
system AttachPolygons(Polygon shape, World world, mut Physics physics)
{
    Entity owner = FixtureOwner(world, this);
    if (!world.TryGet<Body>(owner, out var body)) return;
    var key = FixtureKey { entity = this, kind = 3 };
    mut var held = physics.fixtures[this];
    while (held.shapes.count < 6) held.shapes.Add(default);
    var previous = held.shapes[key.kind];
    var filter = world.Get<CollisionFilter>(this);
    mut var fixture = SyncPolygon(previous.state, body.id, PolygonShape(shape), filter, world.Has<CollisionFilter>(this));
    if (fixture.id == previous.state.id && fixture.signature == previous.state.signature) return;
    ForgetFixture(previous, this, physics);
    if (fixture.id != 0)
    {
        FixtureShapes(fixture, out var shapes);
        foreach (long id in shapes)
        {
            if (owner != this) physics.parts[id] = this;
            physics.shapes += 1;
        }
        if (shape.sensor)
        {
            mut var sensors = physics.sensors[this];
            foreach (long id in shapes) sensors.shapes.Add(id);
            physics.sensors[this] = sensors;
        }
        held.shapes[key.kind] = Fixture { state = fixture, shapes = shapes };
    }
    else held.shapes[key.kind] = default;
    physics.fixtures[this] = held;
}

