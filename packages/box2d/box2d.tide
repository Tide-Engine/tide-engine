struct QueryFilter
{
    long category = 1;
    long mask = -1;
    bool Matches(Collider collider)
    {
        return (category & collider.mask) != 0 && (mask & collider.category) != 0;
    }
}
[NativeName("b2t_query_filter")]
extern void SetQueryFilter(long category, long mask);

