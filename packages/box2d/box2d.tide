// A checked inline convex polygon at the C boundary; container handles never
// cross it inside records. Invalid counts remain invalid, rather than truncating.
struct Hull
{
    float2[8] points;
    int count;
    float radius;
    float density;
    float friction;
    float bounce;
    bool sensor;
}
Hull PolygonShape(Polygon shape)
{
    mut Hull result = Hull { count = shape.points.count, radius = shape.radius, density = shape.density,
                            friction = shape.friction, bounce = shape.bounce, sensor = shape.sensor };
    if (result.count >= 3 && result.count <= 8)
        for (int i = 0; i < result.count; i++) result.points[i] = shape.points[i];
    return result;
}

struct Fixtures { List<Fixture> shapes; }



