}


// Temporary query results retain the collider key while sorting.
struct SceneHit { long shape; RayHit hit; }
void AddSceneHit(mut List<SceneHit> found, Collider collider, Met met)
{
    if (!met.any) return;
    var value = SceneHit { shape = met.shape, hit = RayHit { entity = collider.entity, part = collider.part,
        point = met.point, normal = met.normal, fraction = met.fraction } };
    var last = found.count - 1;
    if (last >= 0 && found[last].shape == met.shape)
    {
        if (met.fraction < found[last].hit.fraction) found[last] = value;
    }
    else found.Add(value);
}

bool FinishSceneHits(mut List<SceneHit> found, out List<RayHit> hits)
{
    found.Sort(a, b) { return a.hit.fraction < b.hit.fraction || (a.hit.fraction == b.hit.fraction &&
        (a.shape & 0xFFFF_FFFFL) < (b.shape & 0xFFFF_FFFFL)); }
    hits = [];
    foreach (var value in found) hits.Add(value.hit);
    return hits.count > 0;
}

struct SceneLeaf { SceneBounds bounds; int collider; float key; }
struct SceneBranch { int first; int count; }
void BuildScene(List<Collider> colliders, out List<SceneNode> nodes)
{
    nodes = [];
    mut List<SceneLeaf> leaves = [];
    for (int i = 0; i < colliders.count; i++)
    {
        var bounds = ColliderBounds(colliders[i]);
        if (bounds.valid) leaves.Add(SceneLeaf { bounds = bounds, collider = i });
    }
    if (leaves.count == 0) return;
    mut var low = leaves[0].bounds.min;
    mut var high = leaves[0].bounds.max;
    foreach (var leaf in leaves)
    {
        low = Math.Min(low, leaf.bounds.min);
        high = Math.Max(high, leaf.bounds.max);
    }
    mut int axis = 0;
    mut float extent = high.x - low.x;
    if (high.y - low.y > extent) { axis = 1; extent = high.y - low.y; }
    for (int i = 0; i < leaves.count; i++)
    {
        mut var leaf = leaves[i];
        leaf.key = 0.5 * leaf.bounds.min.x + 0.5 * leaf.bounds.max.x;
        if (axis == 1) leaf.key = 0.5 * leaf.bounds.min.y + 0.5 * leaf.bounds.max.y;
        leaves[i] = leaf;
    }
    leaves.Sort(a, b) { return a.key < b.key || (a.key == b.key && a.collider < b.collider); }
    mut List<SceneBranch> branches = [SceneBranch { first = 0, count = leaves.count }];
    while (branches.count > 0)
    {
        var branch = branches[branches.count - 1];
        branches.RemoveAt(branches.count - 1);
        int first = branch.first;
        int count = branch.count;
        mut var node = SceneNode { min = leaves[first].bounds.min, max = leaves[first].bounds.max,
            collider = -1, next = nodes.count + count * 2 - 1 };
        for (int i = first + 1; i < first + count; i++)
        {
            node.min = Math.Min(node.min, leaves[i].bounds.min);
            node.max = Math.Max(node.max, leaves[i].bounds.max);
        }
        if (count == 1) node.collider = leaves[first].collider;
        else
        {
            int middle = count / 2;
            branches.Add(SceneBranch { first = first + middle, count = count - middle });
            branches.Add(SceneBranch { first = first, count = middle });
        }
        nodes.Add(node);
    }
}


void SortCandidates(mut List<int> candidates)
{
    candidates.Sort(a, b) { return a < b; }
}

[NativeName("b2t_box_bounds")]
extern SceneBounds BoxBounds(in Box shape, float rotation, float2 from, float2 to);

[NativeName("b2t_circle_bounds")]
extern SceneBounds CircleBounds(in Circle shape, float rotation, float2 from, float2 to);

[NativeName("b2t_read_colliders")]
extern void ReadColliders(long body, out List<Collider> colliders);
[NativeName("b2t_blend_collider")]
extern Collider BlendCollider(in Collider before, in Collider current, float alpha);
[NativeName("b2t_scene_ray")]
extern Met SceneRay(in Collider collider, float2 from, float2 to);
[NativeName("b2t_scene_touch")]
extern bool SceneTouch(in Collider a, in Collider b);
[NativeName("b2t_scene_cast_box")]
extern Met SceneCastBox(in Collider collider, in Box shape, float2 from, float angle, float2 to);
[NativeName("b2t_scene_overlap_box")]
extern bool SceneOverlapBox(in Collider collider, in Box shape, float2 at, float angle);
[NativeName("b2t_scene_cast_circle")]
extern Met SceneCastCircle(in Collider collider, in Circle shape, float2 from, float angle, float2 to);
[NativeName("b2t_scene_overlap_circle")]
extern bool SceneOverlapCircle(in Collider collider, in Circle shape, float2 at, float angle);

[Stage(PhysicsStages.Step, 22)]
system BeginHistory(Time time, mut Physics physics)
{
    if (!(time.maxRewind > 0))
    {
        if (physics.historyLimit > 0)
        {
            physics.historyLimit = 0;
            physics.historyDt = 0;
            physics.historyTick = 0;
            physics.selected.Clear();
            physics.pending = [];
            physics.history = [];
        }
        return;
    }
    physics.historyTick = time.tick + 1;
    physics.historyDt = time.dt;
    physics.historyLimit = time.maxRewind;
    physics.selected.Clear();
    physics.pending = [];
    // Keep the extra lower endpoint required by fractional timestamps.
    while (physics.history.count > 1 &&
           float(long(physics.historyTick) - long(physics.history[1].tick)) * time.dt > time.maxRewind)
        physics.history.RemoveAt(0);
}

[Stage(PhysicsStages.Step, 23)]
[NativeName("b2t_capture_history")]
extern system CaptureHistory(Body body, mut Physics physics);

[Stage(PhysicsStages.Step, 24)]
system EndHistory(mut Physics physics)
{
    if (!(physics.historyLimit > 0)) return;
    for (int i = 0; i < physics.pending.count; i++)
    {
        mut var collider = physics.pending[i];
        collider.part = PartOf(physics.parts, collider.shape, collider.entity);
        physics.pending[i] = collider;
        physics.selected[collider.body] = true;
    }
    physics.history.Add(HistoryFrame { tick = physics.historyTick, colliders = physics.pending });
}

[Stage(PhysicsStages.Step, 25)]
[NativeName("b2t_seal_history")]
extern system SealHistory(mut Physics physics);

void SortScene(mut List<Collider> scene)
{
    scene.Sort(a, b) { return (a.body & 0xFFFF_FFFFL) < (b.body & 0xFFFF_FFFFL) || (a.body == b.body && (a.shape & 0xFFFF_FFFFL) < (b.shape & 0xFFFF_FFFFL)); }
}

// Joints are entities with Joint and exactly one type's settings component.
// Anchors and rotations are local to the corresponding body's origin.
component Joint
{
    [Together] Entity a; // The bodies it joins, which in a sharded world are kept on one shard with it
    [Together] Entity b;
    float2 anchorA;
    float2 anchorB;
    float angleA;
    float angleB;
    float constraintHertz = 60;
    float constraintDampingRatio = 2;
    bool enabled = true;
    bool collideConnected;
    [Native] long id; // The package's own native handle, zero before attachment
    float2 force; // Read back after the step, in newtons
    float torque; // Read back after the step, in newton meters
    [Native] long configuration; // The package's own creation-only settings key
}

component DistanceJoint
{
    float length = 1;
    float lowerSpringForce = -1e12;
    float upperSpringForce = 1e12;
    float hertz = 0;
    float dampingRatio = 0;
    float minLength = 0;
    float maxLength = 1e6;
    float maxMotorForce = 0;
    float motorSpeed = 0;
    bool enableSpring = false;
    bool enableLimit = false;
    bool enableMotor = false;
}

component MotorJoint
{
    float2 linearVelocity;
    float angularVelocity;
    float maxVelocityForce = 0;
    float maxVelocityTorque = 0;
    float linearHertz = 0;
    float linearDampingRatio = 0;
    float maxSpringForce = 0;
    float angularHertz = 0;
    float angularDampingRatio = 0;
    float maxSpringTorque = 0;
}

component FilterJoint
{
    bool enabled = true;
}


component PrismaticJoint
{
