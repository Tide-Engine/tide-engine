// A game that orders its systems against the package's, each way one might.
// order.txt is the order `tidec --schedule` puts them all in, which the
// package's tests hold it to: the package's own systems are in their order
// whatever a game says. Only the first way is for a game to use; the ones
// that name a system of the package's get a place in the middle of the step,
// where what they write into a body is lost.

using Box2D;

scene Main { }

component Driven { }

event(Spawned) Build(with Main)
{
    Spawn(Body, Box, Circle, Driven);
}

// Into this tick's step
[Before(PhysicsStages.Step)]
system BeforeTheStep(mut Body body, with Driven)
{
    body.velocity = float2(1, 0);
}

// After it, which is where a game's systems are anyway
[After(PhysicsStages.Step)]
system AfterTheStep(mut Body body, with Driven)
{
    body.velocity = float2(2, 0);
}

// One that doesn't say goes by the default order, among the systems whose turn
// has come: after the package's in a game that orders nothing before them, and
// here before them, as they wait for systems written further down
system Unordered(mut Body body, with Driven)
{
    body.velocity = float2(3, 0);
}

[Before(Begin)]
system BeforeBegin(mut Body body, with Driven)
{
    body.velocity = float2(4, 0);
}

[Before(Enter)]
system BeforeEnter(mut Body body, with Driven)
{
    body.velocity = float2(5, 0);
}

[Before(Own)]
system BeforeOwn(mut Body body, with Driven)
{
    body.velocity = float2(6, 0);
}

[Before(AttachCircles)]
system BeforeAttachCircles(mut Body body, with Driven)
{
    body.velocity = float2(7, 0);
}

[Before(Simulate)]
system BeforeSimulate(mut Body body, with Driven)
{
    body.velocity = float2(8, 0);
}

[Before(Leave)]
system BeforeLeave(mut Body body, with Driven)
{
    body.velocity = float2(9, 0);
}

[Before(Report)]
system BeforeReport(mut Body body, with Driven)
{
    body.velocity = float2(10, 0);
}
