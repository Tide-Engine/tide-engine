  "sourceAbout": "Added to a Unity project's game: a body starts where its entity's Transform (Unity's placement) is in x and y, turned about z, and the Transform follows the body; a part that names no body is one of the nearest body above it",
  "source": [
    "namespace Box2D",
    "{",
    "    // A body whose entity has Tide's Transform (in Unity, every one): it starts where the Transform places it in x and y,",
    "    // turned as it's turned about z, whatever its position and angle said, and the Transform follows it after each step,",
    "    // its z kept, so Unity shows the body where it is. A body's place is the world's: one under an entity that turns",
    "    // isn't turned with it.",
    "    [Stage(PhysicsStages.Step, 0)]",
    "    system StartAtTransform(mut Body body, Transform transform)",
    "    {",
    "        if (body.id != 0) return;",
    "        var at = transform.position;",
    "        body.position = float2(at.x, at.y);",
    "        var q = transform.localRotation.value;",
    "        var sign = q.w < 0 ? -1.0 : 1.0; // The same turn, the short way: an angle from -pi to pi",
    "        body.angle = 2 * Math.Atan2(q.z * sign, q.w * sign);",
    "    }",
    "",
    "    [Stage(PhysicsStages.Step, 14)]",
    "    system FollowTransform(Body body, mut Transform transform)",
    "    {",
    "        var at = transform.position;",
    "        transform.position = float3(body.position.x, body.position.y, at.z);",
    "        transform.localRotation = quaternion.Euler(0, 0, body.angle);",
    "    }",
    "",
    "    // A part that names no body is a part of the nearest entity above it with one, as a collider on a Rigidbody2D's",
    "    // child is in Unity: tide unity bakes its shapes' offsets where its GameObject is on that body.",
    "    [Stage(PhysicsStages.Step, 0)]",
    "    system PartOfTheBodyAbove(mut Part part, World world)",
    "    {",
    "        if (part.of != default) return;",
    "        mut var above = world.Parent(this);",
    "        while (above != default && !world.Has<Body>(above)) above = world.Parent(above);",
    "        part.of = above;",
    "    }",
    "}"
  ]
}
