namespace CornerCulling;

// Bounds use half sizes. A zero extent is valid for an endpoint, including
// a point observer. Blockers must have positive extents on every axis.
struct Bounds
{
    float3 center;
    float3 extents;
}

enum OccluderShape { Box, Ellipsoid }

struct Occluder
{
    Bounds bounds;
    quaternion rotation = quaternion.identity;
    OccluderShape shape;
    int mask = -1;
}

struct CullingQuery
{
    Bounds observer;
    Bounds target;
    int mask = -1;
    float surfaceMargin = 0.0001;
    // Extra complete-envelope tests; exhaustion keeps the target visible.
    int maxSubdivisions = 32;
}

enum Status { Unknown, Visible, Occluded }

struct CullingResult
{
    Status status;
    // Input-list index for a single blocker; -1 for combined/no certificate.
    int occluder = -1;

    bool IsVisible() { return status != Status.Occluded; }
}

// Only a candidate, never a remembered answer. Safe after rebuild, update,
// rollback or reuse with a different world: the current box is always retested.
struct CullingCache { int candidate; }

struct Entry
{
    Occluder box;
    Geometry geometry;
    int source;
}

struct SearchResult
{
    int blocker = -1;
    int[16] candidates;
    int count;
    bool centerHit;
    bool unknown;
}

struct Location
{
    int entry;
    int leaf;
}

struct Node
{
    double3 min;
    double3 max;
    int mask;
    int first;
    int count;
    int escape;
}

struct PreparedQuery
{
    double3 min;
    double3 max;
    double3 observerMin;
    double3 observerMax;
    double3 targetMin;
    double3 targetMax;
    double3 observerCenter;
    double3 targetCenter;
    double3[8] observers;
    double3[8] targets;
    int observerCount;
    int targetCount;
    int mask;
    double margin;
}

bool Finite(float v) { return v >= -3.402823e38 && v <= 3.402823e38; }
bool Finite(float3 v) { return Finite(v.x) && Finite(v.y) && Finite(v.z); }

bool Valid(Bounds bounds)
{
    return Finite(bounds.center) && Finite(bounds.extents) &&
        bounds.extents.x >= 0 && bounds.extents.y >= 0 && bounds.extents.z >= 0;
}

bool Solid(Occluder box)
{
    float4 q = box.rotation.value;
    return (box.shape == OccluderShape.Box || box.shape == OccluderShape.Ellipsoid) &&
        Finite(q.x) && Finite(q.y) && Finite(q.z) && Finite(q.w) &&
        (q.x != 0 || q.y != 0 || q.z != 0 || q.w != 0) && box.mask != 0 && Valid(box.bounds) &&
        box.bounds.extents.x > 0 && box.bounds.extents.y > 0 && box.bounds.extents.z > 0;
}

bool Overlaps(double3 aMin, double3 aMax, double3 bMin, double3 bMax)
{
    return aMin.x <= bMax.x && aMax.x >= bMin.x &&
        aMin.y <= bMax.y && aMax.y >= bMin.y && aMin.z <= bMax.z && aMax.z >= bMin.z;
}

double3 Corner(double3 min, double3 max, int i)
{
    return double3((i & 1) == 0 ? min.x : max.x,
                   (i & 2) == 0 ? min.y : max.y,
                   (i & 4) == 0 ? min.z : max.z);
}

// Binary32 inputs widen before any arithmetic. Outward endpoint padding and
// inward blocker padding deliberately dominate binary64 rounding, including
// cancellation at large coordinates. Tiny/uncertain geometry fails open.
double3 Roundoff(Bounds bounds)
{
    return Math.Max(Math.Abs(double3(bounds.center)), double3(bounds.extents)) * 1e-12d;
}

PreparedQuery Prepare(CullingQuery query)
{
    mut PreparedQuery result = default;
    result.observerCenter = double3(query.observer.center);
    result.targetCenter = double3(query.target.center);
    mut double3 a = double3(query.observer.extents) + Roundoff(query.observer);
    mut double3 b = double3(query.target.extents) + Roundoff(query.target);
    result.observerCount = Math.Cmax(query.observer.extents) == 0 ? 1 : 8;
    result.targetCount = Math.Cmax(query.target.extents) == 0 ? 1 : 8;
    if (result.observerCount == 1) a = double3(0d);
    if (result.targetCount == 1) b = double3(0d);
    result.observerMin = result.observerCenter - a;
    result.observerMax = result.observerCenter + a;
    result.targetMin = result.targetCenter - b;
    result.targetMax = result.targetCenter + b;
    result.min = Math.Min(result.observerMin, result.targetMin);
    result.max = Math.Max(result.observerMax, result.targetMax);
    result.mask = query.mask;
    result.margin = query.surfaceMargin;
    for (var i = 0; i < result.observerCount; i++)
        result.observers[i] = Corner(result.observerMin, result.observerMax, i);
    for (var i = 0; i < result.targetCount; i++)
        result.targets[i] = Corner(result.targetMin, result.targetMax, i);
    return result;
}

bool Slab(double start, double end, double min, double max, mut double enter, mut double exit)
{
    double direction = end - start;
    if (direction == 0d) return start > min && start < max;
    double first = (min - start) / direction;
    double second = (max - start) / direction;
    enter = Math.Max(enter, Math.Min(first, second));
    exit = Math.Min(exit, Math.Max(first, second));
    return exit - enter > 1e-12d;
}

bool Intersects(double3 start, double3 end, double3 min, double3 max)
{
    mut double enter = 1e-12d;
    mut double exit = 1d - 1e-12d;
    return Slab(start.x, end.x, min.x, max.x, enter, exit) &&
        Slab(start.y, end.y, min.y, max.y, enter, exit) &&
        Slab(start.z, end.z, min.z, max.z, enter, exit);
}

// Prepared once on rebuild/update. Rotation is normalized in binary64;
// axes are columns of its matrix. Identity retains the original fast path.
struct Geometry
{
    double3 center;
    double3 extents;
    double3 rounding;
    double3 x;
    double3 y;
    double3 z;
    double3 min;
    double3 max;
    OccluderShape shape;
    int mask;
    bool aligned;
    bool exact;
}

bool ExactAdd(double a, double b)
{
    double sum = a + b;
    double v = sum - a;
    return (a - (sum - v)) + (b - v) == 0d;
}

Geometry GeometryFor(Occluder box)
{
    mut Geometry g = default;
    if (!Solid(box)) return g;
    g.center = double3(box.bounds.center);
    g.extents = double3(box.bounds.extents);
    g.mask = box.mask;
    g.shape = box.shape;
    double4 q = double4(box.rotation.value);
    g.aligned = q.x == 0d && q.y == 0d && q.z == 0d;
    g.x = double3(1d, 0d, 0d);
    g.y = double3(0d, 1d, 0d);
    g.z = double3(0d, 0d, 1d);
    g.rounding = Roundoff(box.bounds);
    if (!g.aligned)
    {
        double scale = 2d / Math.Dot(q, q);
        g.x = double3(1d - scale * (q.y*q.y + q.z*q.z), scale * (q.x*q.y + q.z*q.w), scale * (q.x*q.z - q.y*q.w));
        g.y = double3(scale * (q.x*q.y - q.z*q.w), 1d - scale * (q.x*q.x + q.z*q.z), scale * (q.y*q.z + q.x*q.w));
        g.z = double3(scale * (q.x*q.z + q.y*q.w), scale * (q.y*q.z - q.x*q.w), 1d - scale * (q.x*q.x + q.y*q.y));
        g.rounding = double3(Math.Cmax(Math.Max(Math.Abs(g.center), g.extents)) * 1e-11d);
    }
    double3 radius = Math.Abs(g.x) * g.extents.x + Math.Abs(g.y) * g.extents.y + Math.Abs(g.z) * g.extents.z;
    g.min = g.center - radius - g.rounding;
    g.max = g.center + radius + g.rounding;
    g.exact = g.aligned && ExactAdd(g.center.x, g.extents.x) && ExactAdd(g.center.x, -g.extents.x) &&
        ExactAdd(g.center.y, g.extents.y) && ExactAdd(g.center.y, -g.extents.y) &&
        ExactAdd(g.center.z, g.extents.z) && ExactAdd(g.center.z, -g.extents.z);
    return g;
}

double3 Local(Geometry g, double3 p)
{
    double3 d = p - g.center;
    return g.aligned ? d : double3(Math.Dot(d, g.x), Math.Dot(d, g.y), Math.Dot(d, g.z));
}

bool UnitSphereHits(double3 a, double3 b)
{
    double3 direction = b - a;
    double length = Math.Dot(direction, direction);
    if (length <= 0d) return false;
    double t = Math.Clamp(-Math.Dot(a, direction) / length, 1e-12d, 1d - 1e-12d);
    double3 closest = a + direction * t;
    double uncertainty = 1e-12d * Math.Max(1d, Math.Max(Math.Dot(a, a), Math.Dot(b, b)));
    return Math.Dot(closest, closest) < 1d - uncertainty;
}

bool Eligible(Geometry g, PreparedQuery query)
{
    return (g.mask & query.mask) != 0 && Overlaps(g.min, g.max, query.min, query.max) &&
        !Overlaps(g.min, g.max, query.observerMin, query.observerMax) &&
        !Overlaps(g.min, g.max, query.targetMin, query.targetMax);
}

// 0: center misses; 1: center hits but full coverage fails; 2: full coverage.
// Search needs both outcomes; compute the center ray only once. Arithmetic and
// corner order match the scalar kernel, including division (not reciprocals).
int Coverage(Geometry g, PreparedQuery query)
{
    double3 inner = g.extents - g.rounding - query.margin;
    if (Math.Cmin(inner) <= 0d) return 0;
    if (g.aligned && g.shape == OccluderShape.Box)
    {
        double3 min = g.center - inner;
        double3 max = g.center + inner;
        if (!Intersects(query.observerCenter, query.targetCenter, min, max)) return 0;
        for (var a = 0; a < query.observerCount; a++)
            for (var b = 0; b < query.targetCount; b++)
                if (!Intersects(query.observers[a], query.targets[b], min, max)) return 1;
        return 2;
    }
    bool rounded = g.shape == OccluderShape.Ellipsoid;
    double3 centerA = Local(g, query.observerCenter);
    double3 centerB = Local(g, query.targetCenter);
    if (rounded)
    {
        if (!UnitSphereHits(centerA / inner, centerB / inner)) return 0;
    }
    else if (!Intersects(centerA, centerB, -inner, inner)) return 0;
    mut double3[8] observers = default;
    mut double3[8] targets = default;
    for (var a = 0; a < query.observerCount; a++)
    {
        double3 local = Local(g, query.observers[a]);
        observers[a] = rounded ? local / inner : local;
    }
    for (var b = 0; b < query.targetCount; b++)
    {
        double3 local = Local(g, query.targets[b]);
        targets[b] = rounded ? local / inner : local;
    }
    if (rounded)
    {
        for (var a = 0; a < query.observerCount; a++)
            for (var b = 0; b < query.targetCount; b++)
                if (!UnitSphereHits(observers[a], targets[b])) return 1;
    }
    else
    {
        for (var a = 0; a < query.observerCount; a++)
            for (var b = 0; b < query.targetCount; b++)
                if (!Intersects(observers[a], targets[b], -inner, inner)) return 1;
    }
    return 2;
}

bool Blocks(Geometry g, PreparedQuery query)
{
    return Eligible(g, query) && Coverage(g, query) == 2;
}

bool Blocks(Occluder box, PreparedQuery query) { return Blocks(GeometryFor(box), query); }

// An inscribed rectangular prism in the union of two axis-aligned boxes.
// Intersect the other two axes: NEVER use their enclosing AABB. Only exact
// binary64 bounds may join at equality; uncertain contacts need real overlap.
Geometry Join(Geometry a, Geometry b, int axis)
{
    mut Geometry g = default;
    if (!a.aligned || !b.aligned || a.shape != OccluderShape.Box || b.shape != OccluderShape.Box) return g;
    double3 aMin = a.center - a.extents;
    double3 aMax = a.center + a.extents;
    double3 bMin = b.center - b.extents;
    double3 bMax = b.center + b.extents;
    double3 lo = Math.Max(aMin, bMin);
    double3 hi = Math.Min(aMax, bMax);
    double overlap = Axis(hi, axis) - Axis(lo, axis);
    if (overlap < 0d || (!(a.exact && b.exact) && overlap <= Axis(a.rounding, axis) + Axis(b.rounding, axis))) return g;
    mut double3 min = lo;
    mut double3 max = hi;
    SetAxis(min, axis, Math.Min(Axis(aMin, axis), Axis(bMin, axis)));
    SetAxis(max, axis, Math.Max(Axis(aMax, axis), Axis(bMax, axis)));
    if (Math.Cmin(max - min) <= 0d) return g;
    g.center = (min + max) * 0.5d;
    g.extents = (max - min) * 0.5d;
    g.rounding = Math.Max(Math.Abs(g.center), g.extents) * 4e-12d + a.rounding + b.rounding;
    g.min = min - g.rounding;
    g.max = max + g.rounding;
    g.aligned = true;
    g.mask = -1;
    g.exact = a.exact && b.exact &&
        g.center.x - g.extents.x == min.x && g.center.x + g.extents.x == max.x &&
        g.center.y - g.extents.y == min.y && g.center.y + g.extents.y == max.y &&
        g.center.z - g.extents.z == min.z && g.center.z + g.extents.z == max.z &&
        ExactAdd(g.center.x, g.extents.x) && ExactAdd(g.center.x, -g.extents.x) &&
        ExactAdd(g.center.y, g.extents.y) && ExactAdd(g.center.y, -g.extents.y) &&
        ExactAdd(g.center.z, g.extents.z) && ExactAdd(g.center.z, -g.extents.z);
    return g;
}

bool Contains(Geometry outer, Geometry inner)
{
    double3 lo = outer.center - outer.extents;
    double3 hi = outer.center + outer.extents;
    double3 a = inner.center - inner.extents;
    double3 b = inner.center + inner.extents;
    return lo.x <= a.x && lo.y <= a.y && lo.z <= a.z && hi.x >= b.x && hi.y >= b.y && hi.z >= b.z;
}

PreparedQuery Slice(PreparedQuery query, bool observer, int axis, bool upper)
{
    mut PreparedQuery result = query;
    mut double3 min = observer ? query.observerMin : query.targetMin;
    mut double3 max = observer ? query.observerMax : query.targetMax;
    double middle = (Axis(min, axis) + Axis(max, axis)) * 0.5d;
    if (upper) SetAxis(min, axis, middle);
    else SetAxis(max, axis, middle);
    if (observer)
    {
        result.observerMin = min;
        result.observerMax = max;
        result.observerCenter = (min + max) * 0.5d;
        for (var i = 0; i < result.observerCount; i++) result.observers[i] = Corner(min, max, i);
    }
    else
    {
        result.targetMin = min;
        result.targetMax = max;
        result.targetCenter = (min + max) * 0.5d;
        for (var i = 0; i < result.targetCount; i++) result.targets[i] = Corner(min, max, i);
    }
    result.min = Math.Min(result.observerMin, result.targetMin);
    result.max = Math.Max(result.observerMax, result.targetMax);
    return result;
}

double Axis(double3 value, int axis)
{
    return axis == 0 ? value.x : (axis == 1 ? value.y : value.z);
}

void SetAxis(mut double3 value, int axis, double scalar)
{
    if (axis == 0) value.x = scalar;
    else if (axis == 1) value.y = scalar;
    else value.z = scalar;
}

float Axis(float3 value, int axis)
{
    return axis == 0 ? value.x : (axis == 1 ? value.y : value.z);
}

void Swap(mut List<Entry> entries, int a, int b)
{
    Entry saved = entries[a];
    entries[a] = entries[b];
    entries[b] = saved;
}

// Three-way median selection avoids repeated-centroid degeneration. Invalid
// boxes have a finite zero key and stay in the tree, so Update can enable them.
float Key(Entry entry, int axis)
{
    return Valid(entry.box.bounds) ? Axis(entry.box.bounds.center, axis) : 0;
}

void Partition(mut List<Entry> entries, int first, int end, int middle, int axis)
{
    mut int lo = first;
    mut int hi = end;
    while (hi - lo > 1)
    {
        float a = Key(entries[lo], axis);
        float b = Key(entries[lo + (hi - lo) / 2], axis);
        float c = Key(entries[hi - 1], axis);
        float pivot = Math.Max(Math.Min(a, b), Math.Min(Math.Max(a, b), c));
        mut int less = lo;
        mut int scan = lo;
        mut int greater = hi;
        while (scan < greater)
        {
            float value = Key(entries[scan], axis);
            if (value < pivot) { Swap(entries, less, scan); less++; scan++; }
            else if (value > pivot) { greater--; Swap(entries, scan, greater); }
            else scan++;
        }
        if (middle < less) hi = less;
        else if (middle >= greater) lo = greater;
        else return;
    }
}

struct CullingWorld
{
    // Implementation storage. Keep it intact; use Rebuild/Update/Clear.
    List<Entry> entries;
    List<Node> nodes;
    List<Location> locations;
    List<int> parents;
    bool ready;

    Node Leaf(int first, int count, int escape)
    {
        mut Node node = Node { first = first, count = count, escape = escape };
        mut bool found = false;
        for (var i = first; i < first + count; i++)
        {
            Geometry g = entries[i].geometry;
            if (g.mask == 0) continue;
            double3 min = g.min;
            double3 max = g.max;
            node.min = found ? Math.Min(node.min, min) : min;
            node.max = found ? Math.Max(node.max, max) : max;
            node.mask |= g.mask;
            found = true;
        }
        return node;
    }

    mut void BuildBranch(int first, int count)
    {
        int index = nodes.count;
        Node bounds = Leaf(first, count, 0);
        nodes.Add(bounds);
        if (count > 4)
        {
            double3 span = bounds.max - bounds.min;
            int axis = span.x >= span.y && span.x >= span.z ? 0 : (span.y >= span.z ? 1 : 2);
            int left = count / 2;
            Partition(entries, first, first + count, first + left, axis);
            BuildBranch(first, left);
            BuildBranch(first + left, count - left);
            nodes[index].count = 0;
        }
        nodes[index].escape = nodes.count;
    }

    mut void Rebuild(List<Occluder> boxes)
    {
        entries.Clear();
        nodes.Clear();
        parents.Clear();
        for (var i = 0; i < boxes.count; i++)
            entries.Add(Entry { box = boxes[i], geometry = GeometryFor(boxes[i]), source = i });
        if (entries.count > 0) BuildBranch(0, entries.count);
        IndexLocations();
        ready = true;
    }

    // Also recovers the new lookup lists after hot reload of an older layout.
    // Preorder escape indices let us recover parents without a separate stack.
    mut void IndexLocations()
    {
        locations.Resize(entries.count);
        parents.Resize(nodes.count);
        mut int parent = -1;
        for (var n = 0; n < nodes.count; n++)
        {
            while (parent >= 0 && n >= nodes[parent].escape) parent = parents[parent];
            parents[n] = parent;
            Node node = nodes[n];
            for (var i = node.first; i < node.first + node.count; i++)
                locations[entries[i].source] = Location { entry = i, leaf = n };
            if (node.count == 0) parent = n;
        }
    }

    mut void Clear()
    {
        entries.Clear();
        nodes.Clear();
        parents.Clear();
        locations.Clear();
        ready = false;
    }

    // Source indices stay stable until the next Rebuild. Updating mask to zero
    // disables a door immediately. Refit is synchronous; no stale tree window.
    mut bool Update(int source, Occluder box)
    {
        if (!ready || source < 0 || source >= entries.count) return false;
        if (locations.count != entries.count || parents.count != nodes.count) IndexLocations();
        Location location = locations[source];
        int index = location.entry;
        if (index < 0 || index >= entries.count || entries[index].source != source) return false;
        entries[index].box = box;
        entries[index].geometry = GeometryFor(box);
        mut int n = location.leaf;
        while (n >= 0)
        {
            if (n >= nodes.count) return false;
            Node old = nodes[n];
            if (old.count > 0) nodes[n] = Leaf(old.first, old.count, old.escape);
            else
            {
                Node left = nodes[n + 1];
                Node right = nodes[left.escape];
                nodes[n].min = left.mask == 0 ? right.min : (right.mask == 0 ? left.min : Math.Min(left.min, right.min));
                nodes[n].max = left.mask == 0 ? right.max : (right.mask == 0 ? left.max : Math.Max(left.max, right.max));
                nodes[n].mask = left.mask | right.mask;
            }
            int parent = parents[n];
            if (parent >= n) return false;
            n = parent;
        }
        return true;
    }

    CullingResult Query(CullingQuery query, mut CullingCache cache)
    {
        if (!ready || !Valid(query.observer) || !Valid(query.target) ||
            !Finite(query.surfaceMargin) || query.surfaceMargin < 0)
        {
            cache.candidate = 0;
            return CullingResult { status = Status.Unknown };
        }
        PreparedQuery prepared = Prepare(query);
        if (query.mask == 0 || Overlaps(prepared.observerMin, prepared.observerMax,
                                       prepared.targetMin, prepared.targetMax))
        {
            cache.candidate = 0;
            return CullingResult { status = Status.Visible };
        }
        int cached = cache.candidate - 1;
        if (cached >= 0 && cached < entries.count && Blocks(entries[cached].geometry, prepared))
            return CullingResult { status = Status.Occluded, occluder = entries[cached].source };
        cache.candidate = 0;
        SearchResult search = Search(prepared);
        if (search.unknown) return CullingResult { status = Status.Unknown };
        if (search.blocker >= 0)
        {
            cache.candidate = search.blocker + 1;
            return CullingResult { status = Status.Occluded, occluder = entries[search.blocker].source };
        }
        mut int budget = Math.Clamp(query.maxSubdivisions, 0, 128);
        if (FinishCoverage(prepared, search, budget, 0)) return CullingResult { status = Status.Occluded };
        return CullingResult { status = Status.Visible };
    }

    // Fixed candidate storage and bounded recursion: incomplete proof is visible.
    // Every child must be certified, never merely its sampled rays collectively.
    SearchResult Search(PreparedQuery query)
    {
        mut SearchResult result = SearchResult { blocker = -1 };
        mut int at = 0;
        while (at < nodes.count)
        {
            Node node = nodes[at];
            if ((node.mask & query.mask) == 0 || !Overlaps(node.min, node.max, query.min, query.max))
            {
                if (node.escape <= at || node.escape > nodes.count) { result.unknown = true; return result; }
                at = node.escape;
                continue;
            }
            for (var i = 0; i < node.count; i++)
            {
                int index = node.first + i;
                if (index < 0 || index >= entries.count) continue;
                Geometry g = entries[index].geometry;
                if (!Eligible(g, query)) continue;
                int coverage = Coverage(g, query);
                if (coverage == 2) { result.blocker = index; return result; }
                if (result.count < 16) { result.candidates[result.count] = index; result.count++; }
                if (coverage == 1) result.centerHit = true;
            }
            at++;
        }
        return result;
    }

    bool Covered(PreparedQuery query, mut int budget, int depth)
    {
        SearchResult search = Search(query);
        if (search.unknown) return false;
        return search.blocker >= 0 || FinishCoverage(query, search, budget, depth);
    }

    bool FinishCoverage(PreparedQuery query, SearchResult search, mut int budget, int depth)
    {
        if (JoinedCoverage(query, search.candidates, search.count)) return true;
        if (!search.centerHit || budget <= 0 || depth >= 8) return false;
        double3 aSpan = query.observerMax - query.observerMin;
        double3 bSpan = query.targetMax - query.targetMin;
        bool observer = Math.Cmax(aSpan) > Math.Cmax(bSpan);
        double3 span = observer ? aSpan : bSpan;
        int axis = span.x >= span.y && span.x >= span.z ? 0 : (span.y >= span.z ? 1 : 2);
        if (Axis(span, axis) <= 0d) return false;
        budget--;
        return Covered(Slice(query, observer, axis, false), budget, depth + 1) &&
            Covered(Slice(query, observer, axis, true), budget, depth + 1);
    }

    // Keep this workspace in a separate call so recursive envelopes do not
    // retain it on the stack. Closure is bounded; only full rectangular unions
    // are retained for another join (inscribed pair prisms may still certify).
    bool JoinedCoverage(PreparedQuery query, int[16] candidates, int candidateCount)
    {
        if (candidateCount < 2) return false;
        mut Geometry[32] pool = default;
        mut int count = 0;
        for (var i = 0; i < candidateCount; i++)
        {
            Geometry g = entries[candidates[i]].geometry;
            if (!g.aligned || g.shape != OccluderShape.Box) continue;
            pool[count] = g;
            count++;
        }
        for (var a = 0; a < count; a++)
            for (var b = 0; b < a; b++)
            {
                // Disjoint broadphase bounds cannot yield any joined prism.
                if (!Overlaps(pool[a].min, pool[a].max, pool[b].min, pool[b].max)) continue;
                for (var axis = 0; axis < 3; axis++)
                {
                    Geometry joined = Join(pool[a], pool[b], axis);
                    if (joined.mask == 0) continue;
                    if (Blocks(joined, query)) return true;
                    if (count >= 32 || !Contains(joined, pool[a]) || !Contains(joined, pool[b])) continue;
                    mut bool redundant = false;
                    for (var i = 0; i < count; i++)
                        if (Contains(pool[i], joined)) { redundant = true; break; }
                    if (!redundant) { pool[count] = joined; count++; }
                }
            }
        return false;
    }

    CullingResult Query(CullingQuery query)
    {
        mut CullingCache cache = default;
        return Query(query, cache);
    }
}
