namespace Render3D;

// Plain shared draw values. Games advance time in local code and capture the
// same Wind once for every material/pass of a frame. No simulation clock/state.
struct Wind
{
    float2 direction = float2(1, 0.3);
    float strength = 0.3;
    float speed = 1;
    float gustScale = 0.04;
    float gustSpeed = 0.8;
    float gustStrength = 0.5;
    float time;
}

// Smooth triangle wave: cheap procedural motion without texture lookups. Phase
// is in cycles. Its analytic derivative is continuous at the triangle corners.
float WindWave(float phase)
{
    float triangle = 1 - 4 * Math.Abs(Math.Frac(phase) - 0.5);
    return triangle * (1.5 - 0.5 * triangle * triangle);
}

float WindWaveDerivative(float phase)
{
    float fraction = Math.Frac(phase);
    float triangle = 1 - 4 * Math.Abs(fraction - 0.5);
    return (fraction < 0.5 ? 4 : -4) * (1.5 - 1.5 * triangle * triangle);
}

// Project a world-space horizontal displacement into the mesh's local XZ plane.
// Keeping local Y unchanged makes the bend a shear with determinant one, so its
// normal correction remains nonsingular at any wind/response strength. Trees
// should have a local +Y trunk; arbitrary affine placement is accepted.
float3 WindLocalDirection(float4x4 transform, float2 direction)
{
    float3 x = transform.c0.xyz;
    float3 y = transform.c1.xyz;
    float3 z = transform.c2.xyz;
    float3 yz = Math.Cross(y, z);
    float determinant = Math.Dot(x, yz);
    if (!(Math.Abs(determinant) >= 0.00000001)) return float3(0);
    float3 world = float3(direction.x, 0, direction.y);
    return float3(Math.Dot(world, yz), 0, Math.Dot(world, Math.Cross(x, y))) / determinant;
}

// Mesh root is local y=0; vertices below it stay fixed. bend has world-distance
// units per squared mesh-local height, flutter per mesh-local height. Response
// is explicitly supplied: color/UV are untouched, so games choose weight storage
// without silently changing the ordinary material's vertex tint/coverage.
// Color and shadow callbacks must capture identical Wind/response values.
void ApplyWind(VertexInput input, mut MeshVertex vertex, Wind wind, float bend, float flutter)
{
    float height = Math.Clamp(vertex.position.y, 0, 10000);
    float strength = Math.Clamp(wind.strength, 0, 10);
    float bending = Math.Clamp(bend, 0, 1);
    float detail = Math.Clamp(flutter, 0, 1);
    if (height <= 0 || strength <= 0 || (bending <= 0 && detail <= 0)) return;
    float2 direction = Math.Normalize(wind.direction);
    float3 local = WindLocalDirection(input.localToWorld, direction);
    if (!(Math.LengthSq(local) > 0)) return;
    float time = Math.Clamp(wind.time, -1000000, 1000000);
    float speed = Math.Clamp(wind.speed, 0, 30);
    float scale = Math.Clamp(wind.gustScale, 0, 1);
    float travel = Math.Clamp(wind.gustSpeed, 0, 30);
    float gust = Math.Clamp(wind.gustStrength, 0, 1);
    float2 root = Math.Clamp(input.localToWorld.c3.xz, float2(-1000000), float2(1000000));
    float phase = Math.Dot(root, direction) * scale;
    float breeze = strength * (1 + gust * WindWave(phase - time * travel))
        * (0.65 + 0.35 * WindWave(phase * 0.73 + time * speed * 0.17));
    float leafPhase = height * 1.73 + phase + time * speed * 3.7;
    float leaf = WindWave(leafPhase);
    float amount = bending * height * height * breeze + detail * height * strength * leaf;
    mut float slope = 2 * bending * height * breeze
        + detail * strength * (leaf + height * 1.73 * WindWaveDerivative(leafPhase));
    if (vertex.position.y >= 10000) slope = 0;
    vertex.position += local * amount;
    // J = I + local * (0,slope,0)^T, local.y=0. Transform tangent by J,
    // normal by inverse-transpose J; re-orthogonalize the tangent frame.
    float3 normal = Math.Normalize(vertex.normal - float3(0, slope * Math.Dot(local, vertex.normal), 0));
    float3 tangent = vertex.tangent.xyz + local * (slope * vertex.tangent.y);
    vertex.normal = normal;
    vertex.tangent = float4(Math.Normalize(tangent - normal * Math.Dot(normal, tangent)), vertex.tangent.w);
}
