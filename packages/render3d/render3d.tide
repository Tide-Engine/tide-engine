// Forward PBR. Configure before Prepare and draw HUDs after Present.
namespace Render3D;

enum Stages { Prepare, Lights, Shadows, Color, Opaque, Transparent, PostPrepare, Bloom, PostProcess, Present }

struct MeshVertex
{
    float3 position;
    float3 normal;
    float2 uv;
    Color color = Color.white;
    float4 tangent;
}

using Mesh3D = Mesh<MeshVertex>;
using SkinnedMesh3D = SkinnedMesh<MeshVertex>;

struct Camera
{
    float3 position = float3(0, 2, -5);
    quaternion rotation = quaternion.identity;
    float verticalFov = 60deg;
    float near = 0.1;
    float far = 1000;
}

component DirectionalLight
{
    bool enabled = true;
    float3 direction = float3(1, -2, 1); // Local photon travel direction.
    float3 radiance = float3(4);        // Linear RGB.
    bool castShadows = true;
    int priority;
}

component PointLight
{
    bool enabled = true;
    float3 intensity = float3(10); // Linear incident light at one world unit.
    float range = 10;
    bool castShadows;
    int priority;
}

component SpotLight
{
    bool enabled = true;
    float3 direction = float3(0, 0, 1); // Local cone axis.
    float3 intensity = float3(10);
    float range = 10;
    float innerAngle = 25deg; // Full cone opening, radians.
    float outerAngle = 40deg;
    bool castShadows;
    int priority;
}

asset Texture White = "white.png";

component MeshRenderer
{
    Asset<Mesh3D> mesh;
    bool visible = true;
    bool castShadows = true;
}

component SkinnedMeshRenderer
{
    Asset<SkinnedMesh3D> mesh;
    bool visible = true;
    bool castShadows = true;
    local Pose? pose;
    // Frame snapshot: configure pose before Stages.Prepare.
    local Pose? preparedPose;
}

component Material
{
    SurfaceMode mode;
    Color baseColor = Color.white;
    float metallic;
    float roughness = 0.5;
    float3 emission;
    bool receiveShadows = true;
    bool doubleSided;
    float alphaCutoff = 0.5;
    float normalScale = 1;
    float occlusionStrength = 1;
    float heightScale;
    float2 uvScale = float2(1);
    float2 uvOffset;
    local Texture baseMap = White;
    [Raw] local Texture normalMap;
    [Raw] local Texture maskMap;
    local Texture emissionMap;
    [Raw] local Texture heightMap;
    local Func<SurfaceInput, mut float2, void> uv = Render3D.StandardUV;
    local Func<SurfaceInput, mut Coverage, void> coverage = Render3D.StandardCoverage;
    local Lit shader = Lit { surface = Render3D.StandardSurface };
    local Deform? vertex;
}

enum LightKind { Directional, Point, Spot }

// Numeric data only: lists travel through the existing GPU data textures.
struct LightData
{
    LightKind kind;
    float3 position;
    float3 direction;
    float3 intensity;
    float range;
    float innerCosine;
    float outerCosine;
    float outerAngle;
    bool castShadows;
    int priority;
    int shadowIndex = -1;
}

struct ShadowView
{
    float4x4 camera;
    float4x4 projection;
    float4x4 worldToClip;
    float4 uvRect; // Top-left interior; two-pixel gutter outside it.
}

local singleton Renderer
{
    bool enabled = true;
    Camera camera;
    Color background = Color(0.06, 0.08, 0.12);
    float exposure = 1;
    bool defaultPresent = true;
    BloomSettings bloom;
    List<PostEffect> postEffects;
    float3 ambientIrradiance;
    int maxLights = 32;
    bool shadows = true;
    int maxShadowMaps = 8; // Directional/spot: one; point: six together.
    int shadowResolution = 1024; // Requested cell size, including gutters.
    float3 shadowCenter;
    float shadowExtent = 10;
    float shadowDistance = 40;
    float shadowNear = 0.05;
    float shadowBias = 0.0005;
    float shadowSlopeBias = 0.002;

    RenderTarget hdr;
    RenderTarget shadowMap;
    DepthTexture shadow;
    List<LightData> lights;
    List<ShadowView> shadowViews;
    float3 eye;
    float shadowTexel;
    int activeShadowResolution;
    int atlasSize;
    int droppedLights;
    int unshadowedLights;
    bool ready;

    // Retained scratch is independent of ready for additive hot reloads.
    Texture output;
    RenderTarget postA;
    RenderTarget postB;
    bool postReady;
    int postSourceSlot;
    int postPendingSlot;
    RenderTarget bloomA;
    RenderTarget bloomB;
    Texture bloomImage;
    bool bloomReady;
}

void Dispose(mut Renderer renderer)
{
    DisposePost(renderer);
    renderer.hdr.Dispose();
    renderer.shadowMap.Dispose();
    renderer.hdr = default;
    renderer.shadowMap = default;
    renderer.shadow = default;
    renderer.lights.Clear();
    renderer.shadowViews.Clear();
    renderer.atlasSize = 0;
    renderer.ready = false;
}

void ResetTarget(RenderTarget target)
{
    target.SetClip();
    target.SetTint();
    target.SetTransform();
    target.SetStencil();
    target.SetBlend(Blend.Replace);
    target.SetDepth();
    target.SetCull();
    target.SetFrustumCulling();
    target.SetBounds();
}

[Stage(Stages.Prepare)]
view Prepare(mut Renderer renderer)
{
    PreparePostResources(renderer);
    if (!renderer.enabled)
    {
        if (renderer.ready) Dispose(renderer);
        return;
    }
    if (!renderer.ready)
    {
        renderer.hdr = RenderTarget.Window(Format.Rgba16f);
        renderer.shadowMap = RenderTarget(16, 16, 1, Format.Depth);
        renderer.shadow = renderer.shadowMap.depth;
        renderer.atlasSize = 16;
        renderer.ready = true;
    }
    renderer.eye = renderer.camera.position;
    renderer.lights.Clear();
    renderer.shadowViews.Clear();
    renderer.droppedLights = 0;
    renderer.unshadowedLights = 0;
    ResetTarget(renderer.shadowMap);
}

[Stage(Stages.Prepare, 1)]
view PreparePose(mut SkinnedMeshRenderer mesh, Renderer renderer)
{
    if (renderer.enabled && mesh.visible) mesh.preparedPose = mesh.pose;
    else mesh.preparedPose = null;
}

float3 LightDirection(float4x4 transform, float3 direction)
{
    float3 result = Math.Normalize(Math.Mul(transform, float4(direction, 0)).xyz);
    return Math.LengthSq(result) < 0.5 ? float3(0, -1, 0) : result;
}

// Equal priorities retain collection order: directional, spot, point; match then local.
void AddLight(mut Renderer renderer, LightData light)
{
    int limit = Math.Max(renderer.maxLights, 0);
    mut int slot = renderer.lights.count;
    while (slot > 0 && light.priority > renderer.lights[slot - 1].priority) slot--;
    if (slot >= limit)
    {
        renderer.droppedLights++;
        return;
    }
    if (renderer.lights.count >= limit)
    {
        renderer.lights.RemoveAt(renderer.lights.count - 1);
        renderer.droppedLights++;
    }
    renderer.lights.Insert(slot, light);
}

void AddDirectional(mut Renderer renderer, DirectionalLight light, float4x4 transform)
{
    if (!renderer.enabled || !renderer.ready || !light.enabled) return;
    AddLight(renderer, LightData {
        kind = LightKind.Directional, direction = LightDirection(transform, light.direction),
        intensity = Math.Max(light.radiance, float3(0)), castShadows = light.castShadows, priority = light.priority
    });
}

void AddPoint(mut Renderer renderer, PointLight light, float4x4 transform)
{
    if (!renderer.enabled || !renderer.ready || !light.enabled || light.range <= 0) return;
    AddLight(renderer, LightData {
        kind = LightKind.Point, position = transform.c3.xyz,
        intensity = Math.Max(light.intensity, float3(0)), range = light.range,
        castShadows = light.castShadows, priority = light.priority
    });
}

void AddSpot(mut Renderer renderer, SpotLight light, float4x4 transform)
{
    if (!renderer.enabled || !renderer.ready || !light.enabled || light.range <= 0) return;
    float outer = Math.Clamp(light.outerAngle, 1deg, 179deg);
    float inner = Math.Clamp(light.innerAngle, 0, outer);
    AddLight(renderer, LightData {
        kind = LightKind.Spot, position = transform.c3.xyz,
        direction = LightDirection(transform, light.direction),
        intensity = Math.Max(light.intensity, float3(0)), range = light.range,
        innerCosine = Math.Cos(inner * 0.5), outerCosine = Math.Cos(outer * 0.5), outerAngle = outer,
        castShadows = light.castShadows, priority = light.priority
    });
}

[Stage(Stages.Lights)]
view CollectDirectional(DirectionalLight light, mut Renderer renderer, World world)
{
    AddDirectional(renderer, light, world.LocalToWorld(this));
}

[Stage(Stages.Lights)]
view CollectLocalDirectional(local DirectionalLight light, mut Renderer renderer, World world)
{
    AddDirectional(renderer, light, world.LocalToWorld(this));
}

[Stage(Stages.Lights, 1)]
view CollectSpot(SpotLight light, mut Renderer renderer, World world)
{
    AddSpot(renderer, light, world.LocalToWorld(this));
}

[Stage(Stages.Lights, 1)]
view CollectLocalSpot(local SpotLight light, mut Renderer renderer, World world)
{
    AddSpot(renderer, light, world.LocalToWorld(this));
}

[Stage(Stages.Lights, 2)]
view CollectPoint(PointLight light, mut Renderer renderer, World world)
{
    AddPoint(renderer, light, world.LocalToWorld(this));
}

[Stage(Stages.Lights, 2)]
view CollectLocalPoint(local PointLight light, mut Renderer renderer, World world)
{
    AddPoint(renderer, light, world.LocalToWorld(this));
}

quaternion PointFaceRotation(int face)
{
    if (face == 0) return quaternion.LookRotation(float3(1, 0, 0), float3(0, 1, 0));
    if (face == 1) return quaternion.LookRotation(float3(-1, 0, 0), float3(0, 1, 0));
    if (face == 2) return quaternion.LookRotation(float3(0, 1, 0), float3(0, 0, -1));
    if (face == 3) return quaternion.LookRotation(float3(0, -1, 0), float3(0, 0, 1));
    if (face == 4) return quaternion.LookRotation(float3(0, 0, 1), float3(0, 1, 0));
    return quaternion.LookRotation(float3(0, 0, -1), float3(0, 1, 0));
}

void AddShadowView(mut Renderer renderer, float4x4 camera, float4x4 projection)
{
    renderer.shadowMap.SetCamera(camera, projection);
    renderer.shadowViews.Add(ShadowView {
        camera = camera, projection = projection, worldToClip = renderer.shadowMap.WorldToClip()
    });
}

[Stage(Stages.Lights, 3)]
view FinishLights(mut Renderer renderer)
{
    if (!renderer.enabled || !renderer.ready) return;
    int limit = renderer.shadows ? Math.Clamp(renderer.maxShadowMaps, 0, 16) : 0;
    for (var i = 0; i < renderer.lights.count; i++)
    {
        mut var light = renderer.lights[i];
        if (!light.castShadows) continue;
        int required = light.kind == LightKind.Point ? 6 : 1;
        float near = Math.Max(renderer.shadowNear, 0.001);
        if (renderer.shadowViews.count + required > limit ||
            (light.kind != LightKind.Directional && light.range <= near))
        {
            renderer.unshadowedLights++;
            continue;
        }
        light.shadowIndex = renderer.shadowViews.count;
        renderer.lights[i] = light;
        if (light.kind == LightKind.Directional)
        {
            float distance = Math.Max(renderer.shadowDistance, 0.2);
            float extent = Math.Max(renderer.shadowExtent, 0.01);
            var camera = float4x4.TRS(renderer.shadowCenter - light.direction * (distance * 0.5),
                                     quaternion.LookRotation(light.direction, float3(0, 1, 0)), float3(1));
            AddShadowView(renderer, camera, float4x4.Ortho(extent * 2, extent * 2, 0.01, distance));
        }
        else if (light.kind == LightKind.Spot)
        {
            var camera = float4x4.TRS(light.position, quaternion.LookRotation(light.direction, float3(0, 1, 0)), float3(1));
            AddShadowView(renderer, camera, float4x4.PerspectiveFov(light.outerAngle, 1, near, light.range));
        }
        else
        {
            for (var face = 0; face < 6; face++)
            {
                var camera = float4x4.TRS(light.position, PointFaceRotation(face), float3(1));
                AddShadowView(renderer, camera, float4x4.PerspectiveFov(90deg, 1, near, light.range));
            }
        }
    }
    mut int grid = 1;
    while (grid * grid < renderer.shadowViews.count) grid++;
    // Portable texture-size baseline: gutters remain real pixels on every backend.
    int cell = Math.Clamp(renderer.shadowResolution, 16, 2048 / grid);
    int size = renderer.shadowViews.count > 0 ? cell * grid : renderer.atlasSize;
    if (renderer.atlasSize != size)
    {
        renderer.shadowMap.Resize(size, size);
        renderer.atlasSize = size;
    }
    renderer.activeShadowResolution = renderer.shadowViews.count > 0 ? cell : 0;
    renderer.shadowTexel = 1.0 / size;
    for (var i = 0; i < renderer.shadowViews.count; i++)
    {
        renderer.shadowViews[i].uvRect = float4(
            (float(i % grid * cell) + 2) / size, (float(i / grid * cell) + 2) / size,
            float(cell - 4) / size, float(cell - 4) / size);
    }
    ResetTarget(renderer.shadowMap);
    renderer.shadowMap.Clear(Color.white);
}

struct ShadowTile { float4 uvRect; MaterialMaps maps; }

// Rebuilt from current caster values for this invocation, then shared by the
// light views. Contiguous runs retain the existing mesh and winding boundaries.
struct ShadowBatch
{
    Asset<Mesh3D> mesh;
    bool mirrored;
    bool doubleSided;
    int count;
    float4x4 first;
    List<float4x4> transforms;
    bool deformed;
    Func<VertexInput, mut MeshVertex, void> firstVertex;
    List<ShadowInstance> instances;
}

bool Mirrors(float4x4 matrix)
{
    // Match the drawing runtime's determinant, including its operation order.
    return matrix.c0.x * (matrix.c1.y * matrix.c2.z - matrix.c1.z * matrix.c2.y)
         + matrix.c0.y * (matrix.c1.z * matrix.c2.x - matrix.c1.x * matrix.c2.z)
         + matrix.c0.z * (matrix.c1.x * matrix.c2.y - matrix.c1.y * matrix.c2.x) < 0;
}

vert AtlasVertex(mut MeshVertex vertex, out float4 clip, ShadowTile tile)
{
    float4 raw = this.clip;
    clip = AtlasClip(raw, tile.uvRect);
}

[Stage(Stages.Shadows)]
view Cast(Renderer renderer, World world, query (MeshRenderer mesh, Material material) casters)
{
    if (!renderer.enabled || !renderer.ready) return;
    if (renderer.shadowViews.count == 0)
    {
        renderer.shadowMap.SetClip();
        return;
    }
    mut List<ShadowBatch> batches = [];
    mut List<float4x4> cutoutTransforms = [];
    mut ShadowBatch current = default;
    foreach (var caster in casters)
    {
        if (!caster.mesh.visible || !caster.mesh.castShadows) continue;
        if (caster.material.mode == SurfaceMode.Transparent) continue;
        var transform = world.LocalToWorld(caster.entity);
        if (caster.material.mode == SurfaceMode.Cutout)
        {
            cutoutTransforms.Add(transform);
            continue;
        }
        bool mirrored = Mirrors(transform);
        bool deformed = caster.material.vertex is Deform;
        if (current.count > 0 &&
            (current.mesh != caster.mesh.mesh || current.mirrored != mirrored ||
             current.doubleSided != caster.material.doubleSided || current.deformed != deformed))
        {
            batches.Add(current);
            current = default;
        }
        current.mesh = caster.mesh.mesh;
        current.mirrored = mirrored;
        current.doubleSided = caster.material.doubleSided;
        current.deformed = deformed;
        mut Func<VertexInput, mut MeshVertex, void> hook = StandardVertex;
        if (caster.material.vertex is Deform binding) hook = binding.vertex;
        if (current.count == 0)
        {
            current.first = transform;
            current.firstVertex = hook;
        }
        else
        {
            if (deformed)
            {
                if (current.count == 1)
                    current.instances.Add(ShadowInstance { transform = current.first, vertex = current.firstVertex });
                current.instances.Add(ShadowInstance { transform = transform, vertex = hook });
            }
            else
            {
                if (current.count == 1) current.transforms.Add(current.first);
                current.transforms.Add(transform);
            }
        }
        current.count++;
    }
    if (current.count > 0) batches.Add(current);
    foreach (var shadow in renderer.shadowViews)
    {
        renderer.shadowMap.SetCamera(shadow.camera, shadow.projection);
        renderer.shadowMap.Screen()
        {
            renderer.shadowMap.SetClip(Rect(shadow.uvRect.x * renderer.atlasSize, shadow.uvRect.y * renderer.atlasSize,
                                           shadow.uvRect.z * renderer.atlasSize, shadow.uvRect.w * renderer.atlasSize));
        }
        // Read the prepared list in place: copying a batch would copy its
        // nested transforms again for every light view.
        for (var i = 0; i < batches.count; i++)
        {
            renderer.shadowMap.SetCull(batches[i].doubleSided ? Cull.None : Cull.Back);
            if (batches[i].deformed)
            {
                if (batches[i].count == 1)
                    renderer.shadowMap.Mesh(batches[i].mesh.Value, batches[i].first,
                        DeformShadow { deform = batches[i].firstVertex }, ShadowTile { uvRect = shadow.uvRect });
                else
                {
                    // Keep callback captures in shared uniforms, as in the
                    // color pass. Their size does not consume vertex attributes.
                    // Equal adjacent captures still batch in the draw list.
                    for (var item = 0; item < batches[i].instances.count; item++)
                        renderer.shadowMap.Mesh(batches[i].mesh.Value, batches[i].instances[item].transform,
                            DeformShadow { deform = batches[i].instances[item].vertex },
                            ShadowTile { uvRect = shadow.uvRect });
                }
            }
            else if (batches[i].count == 1)
                renderer.shadowMap.Mesh(batches[i].mesh.Value, batches[i].first,
                                        AtlasVertex, ShadowTile { uvRect = shadow.uvRect });
            else
                renderer.shadowMap.Instanced(batches[i].mesh.Value, batches[i].transforms,
                                            AtlasVertex, ShadowTile { uvRect = shadow.uvRect });
        }
        if (cutoutTransforms.count > 0)
        {
            mut int cutout = 0;
            foreach (var caster in casters)
            {
                if (!caster.mesh.visible || !caster.mesh.castShadows || caster.material.mode != SurfaceMode.Cutout) continue;
                var transform = cutoutTransforms[cutout];
                cutout++;
                CastMasked(renderer, caster.mesh, caster.material, transform, shadow.uvRect);
            }
        }
    }
    renderer.shadowMap.SetCull();
    renderer.shadowMap.SetClip();
}

MaterialMaps Maps(Material material, float4x4 transform)
{
    return MaterialMaps {
        normal = material.normalMap.size.x > 0 && material.normalScale != 0,
        mask = material.maskMap.size.x > 0,
        emission = material.emissionMap.size.x > 0 && Math.LengthSq(material.emission) > 0,
        height = material.heightMap.size.x > 0 && material.heightScale != 0,
        handedness = Mirrors(transform) ? -1 : 1
    };
}

void CastMasked(Renderer renderer, MeshRenderer mesh, Material material, float4x4 transform, float4 rect)
{
    renderer.shadowMap.SetCull(material.doubleSided ? Cull.None : Cull.Back);
    if (material.vertex is Deform binding)
        renderer.shadowMap.Mesh(mesh.mesh.Value, transform, DeformShadow { deform = binding.vertex }, ShadowCutout,
                               ShadowTile { uvRect = rect, maps = Maps(material, transform) });
    else
        renderer.shadowMap.Mesh(mesh.mesh.Value, transform, AtlasVertex, ShadowCutout,
                               ShadowTile { uvRect = rect, maps = Maps(material, transform) });
}

Func<VertexInput, mut MeshVertex, void> VertexHook(Material material)
{
    if (material.vertex is Deform binding) return binding.vertex;
    return StandardVertex;
}

[Stage(Stages.Shadows)]
view CastSkinned(Renderer renderer, World world,
                 query (SkinnedMeshRenderer mesh, Material material) casters)
{
    if (!renderer.enabled || !renderer.ready || renderer.shadowViews.count == 0) return;
    // Transform preparation is independent of the shadow camera. Retain only
    // numeric values; material resources still come from the live query row.
    mut List<float4x4> transforms = [];
    foreach (var caster in casters)
    {
        if (!caster.mesh.visible || !caster.mesh.castShadows || caster.material.mode == SurfaceMode.Transparent) continue;
        transforms.Add(world.LocalToWorld(caster.entity));
    }
    if (transforms.count == 0) return;
    foreach (var shadow in renderer.shadowViews)
    {
        renderer.shadowMap.SetCamera(shadow.camera, shadow.projection);
        renderer.shadowMap.Screen()
        {
            renderer.shadowMap.SetClip(Rect(shadow.uvRect.x * renderer.atlasSize, shadow.uvRect.y * renderer.atlasSize,
                shadow.uvRect.z * renderer.atlasSize, shadow.uvRect.w * renderer.atlasSize));
        }
        mut int index = 0;
        foreach (var caster in casters)
        {
            if (!caster.mesh.visible || !caster.mesh.castShadows || caster.material.mode == SurfaceMode.Transparent) continue;
            CastSkinnedMaterial(renderer, caster.mesh, caster.material, transforms[index], shadow.uvRect);
            index++;
        }
    }
    renderer.shadowMap.SetCull();
    renderer.shadowMap.SetClip();
}

void CastSkinnedMaterial(Renderer renderer, SkinnedMeshRenderer mesh, Material material,
                         float4x4 transform, float4 rect)
{
    renderer.shadowMap.SetCull(material.doubleSided ? Cull.None : Cull.Back);
    var vertex = DeformShadow { deform = VertexHook(material) };
    var tile = ShadowTile { uvRect = rect, maps = Maps(material, transform) };
    if (mesh.preparedPose is Pose pose)
    {
        if (material.mode == SurfaceMode.Cutout)
            renderer.shadowMap.SkinnedMesh(mesh.mesh.Value, transform, pose, vertex, ShadowCutout, tile);
        else
            renderer.shadowMap.SkinnedMesh(mesh.mesh.Value, transform, pose, vertex, tile);
    }
    else
    {
        if (material.mode == SurfaceMode.Cutout)
            renderer.shadowMap.SkinnedMesh(mesh.mesh.Value, transform, vertex, ShadowCutout, tile);
        else
            renderer.shadowMap.SkinnedMesh(mesh.mesh.Value, transform, vertex, tile);
    }
}

[Stage(Stages.Color)]
view BeginColor(Renderer renderer)
{
    if (!renderer.enabled || !renderer.ready) return;
    ResetTarget(renderer.hdr);
    float near = Math.Max(renderer.camera.near, 0.001);
    float far = Math.Max(renderer.camera.far, near + 0.001);
    float fov = Math.Clamp(renderer.camera.verticalFov, 1deg, 179deg);
    float aspect = Math.Max(Screen.width, 1) / Math.Max(Screen.height, 1);
    var camera = float4x4.TRS(renderer.camera.position, renderer.camera.rotation, float3(1));
    renderer.hdr.SetCamera(camera, float4x4.PerspectiveFov(fov, aspect, near, far));
    float3 background = SrgbToLinear(float3(renderer.background.r, renderer.background.g, renderer.background.b));
    renderer.hdr.Clear(Color(background.x, background.y, background.z));
}

int PointFace(float3 direction)
{
    float3 absolute = Math.Abs(direction);
    if (absolute.x >= absolute.y && absolute.x >= absolute.z) return direction.x >= 0 ? 0 : 1;
    if (absolute.y >= absolute.z) return direction.y >= 0 ? 2 : 3;
    return direction.z >= 0 ? 4 : 5;
}

float ShadowVisibility(DepthTexture atlas, ShadowView shadow, float3 world, float bias, float texel, bool pointFace)
{
    float4 projected = Math.Mul(shadow.worldToClip, float4(world, 1));
    if (projected.w <= 0) return 1;
    float3 position = projected.xyz / projected.w;
    if (position.z < -1 || position.z > 1) return 1;
    // The dominant-axis point face covers x/y by construction. Camera rounding
    // can put an exact seam just outside [-1,1]; clamp its taps instead of leaking light.
    if (!pointFace && (position.x < -1 || position.x > 1 || position.y < -1 || position.y > 1)) return 1;
    float2 uv = shadow.uvRect.xy + float2(position.x * 0.5 + 0.5, 0.5 - position.y * 0.5) * shadow.uvRect.zw;
    float depth = position.z * 0.5 + 0.5 - bias;
    float2 minimum = shadow.uvRect.xy + float2(texel * 0.5);
    float2 maximum = shadow.uvRect.xy + shadow.uvRect.zw - float2(texel * 0.5);
    float step = texel * 0.75;
    return (atlas.Compare(Math.Clamp(uv + float2(-step, -step), minimum, maximum), depth)
          + atlas.Compare(Math.Clamp(uv + float2(step, -step), minimum, maximum), depth)
          + atlas.Compare(Math.Clamp(uv + float2(-step, step), minimum, maximum), depth)
          + atlas.Compare(Math.Clamp(uv + float2(step, step), minimum, maximum), depth)) * 0.25;
}

[Stage(Stages.Opaque)]
view DrawMesh(MeshRenderer mesh, Material material, Renderer renderer, World world)
{
    if (!renderer.enabled || !renderer.ready || !mesh.visible || material.mode == SurfaceMode.Transparent) return;
    DrawMaterial(renderer, mesh, material, world.LocalToWorld(this));
}

void DrawMaterial(Renderer renderer, MeshRenderer mesh, Material material, float4x4 transform)
{
    renderer.hdr.Cull(material.doubleSided ? Cull.None : Cull.Back)
    {
        if (material.vertex is Deform binding)
            renderer.hdr.Mesh(mesh.mesh.Value, transform, binding, material.shader, Maps(material, transform));
        else
            renderer.hdr.Mesh(mesh.mesh.Value, transform, material.shader, Maps(material, transform));
    }
}

[Stage(Stages.Opaque)]
view DrawSkinnedMesh(SkinnedMeshRenderer mesh, Material material, Renderer renderer, World world)
{
    if (!renderer.enabled || !renderer.ready || !mesh.visible || material.mode == SurfaceMode.Transparent) return;
    DrawSkinnedMaterial(renderer, mesh, material, world.LocalToWorld(this));
}

void DrawSkinnedMaterial(Renderer renderer, SkinnedMeshRenderer mesh, Material material, float4x4 transform)
{
    var vertex = Deform { vertex = VertexHook(material) };
    renderer.hdr.Cull(material.doubleSided ? Cull.None : Cull.Back)
    {
        if (mesh.preparedPose is Pose pose)
            renderer.hdr.SkinnedMesh(mesh.mesh.Value, transform, pose, vertex, material.shader, Maps(material, transform));
        else
            renderer.hdr.SkinnedMesh(mesh.mesh.Value, transform, vertex, material.shader, Maps(material, transform));
    }
}

// The package sorts captured instance packets, retaining each component's
// current resource/callback bindings without storing borrowed query rows.
extern int TransparentMark(DrawList list);
extern void SortTransparent(DrawList list, int first, float3 eye, float3 forward);

[Stage(Stages.Transparent)]
view DrawTransparent(Renderer renderer, World world, query (MeshRenderer mesh, Material material) meshes,
                     query (SkinnedMeshRenderer mesh, Material material) skins)
{
    if (!renderer.enabled || !renderer.ready) return;
    mut int first = -1;
    renderer.hdr.SetBlend(Blend.Alpha);
    renderer.hdr.SetDepth(Depth.Read);
    foreach (var object in meshes)
    {
        if (!object.mesh.visible || object.material.mode != SurfaceMode.Transparent) continue;
        if (first < 0) first = TransparentMark(Draw.list);
        DrawMaterial(renderer, object.mesh, object.material, world.LocalToWorld(object.entity));
    }
    foreach (var object in skins)
    {
        if (!object.mesh.visible || object.material.mode != SurfaceMode.Transparent) continue;
        if (first < 0) first = TransparentMark(Draw.list);
        DrawSkinnedMaterial(renderer, object.mesh, object.material, world.LocalToWorld(object.entity));
    }
    renderer.hdr.SetDepth();
    renderer.hdr.SetBlend(Blend.Replace);
    if (first >= 0)
        SortTransparent(Draw.list, first, renderer.eye,
                        Math.Normalize(Math.Rotate(renderer.camera.rotation, float3(0, 0, 1))));
}

struct Presentation { float exposure = 1; }

[Stage(Stages.PostPrepare)]
view PreparePost(mut Renderer renderer)
{
    BeginPost(renderer);
}

[Stage(Stages.Bloom)]
view Bloom(mut Renderer renderer)
{
    ApplyBloom(renderer);
}

[Stage(Stages.PostProcess)]
view PostProcess(mut Renderer renderer)
{
    ApplyPostEffects(renderer);
}

frag TonemapScene(Vertex vertex, out Color color, Texture source, Presentation settings)
{
    Color hdr = source.Sample(vertex.uv);
    float3 display = LinearToSrgb(Tonemap(float3(hdr.r, hdr.g, hdr.b), settings.exposure));
    color = Color(display.x, display.y, display.z);
}

[Stage(Stages.Present)]
view Present(Renderer renderer)
{
    if (!renderer.enabled || !renderer.ready || !renderer.defaultPresent) return;
    Draw.Blit(renderer.output, Draw.window, TonemapScene, Presentation { exposure = renderer.exposure });
}
