using Render3D;

scene Main;
asset Mesh3D giQuad = "quad.obj";

singleton GIFixture { bool room; bool built; }
component GIRoomWall { bool emission = true; }

local singleton GIProbe
{
    GISettings settings;
    GISettings raw;
    GISettings bounded;
    bool disabled;
    bool dispose;
    float3 ambient;
    float3 directRadiance;
    bool lightBuilt;
    float3 emission = float3(0.2, 0.1, 0.05);
    int synthetic;
    int sampleCount;
    float3[16] positions;
    float3[16] normals;
    float3[64] grid;
}

float3 GIWallForward(int face)
{
    if (face == 0) return float3(1, 0, 0);
    if (face == 1) return float3(-1, 0, 0);
    if (face == 2) return float3(0, 1, 0);
    if (face == 3) return float3(0, -1, 0);
    if (face == 4) return float3(0, 0, 1);
    return float3(0, 0, -1);
}

system BuildGIRoom(mut GIFixture fixture)
{
    if (fixture.built) return;
    fixture.built = true;
    if (!fixture.room) return;
    for (var face = 0; face < 6; face++)
    {
        float3 forward = GIWallForward(face);
        float3 up = face == 2 ? float3(0, 0, -1) : face == 3 ? float3(0, 0, 1) : float3(0, 1, 0);
        Spawn(GIRoomWall, MeshRenderer { mesh = giQuad }, Material { doubleSided = true },
            Transform { localPosition = forward * 3, localRotation = quaternion.LookRotation(forward, up),
                        localScale = float3(8, 8, 1) });
    }
    // Small enough to miss the coarse probe quadrature rays. Its actual Lit
    // output is checked separately from direct calls to the GI sampler.
    Spawn(MeshRenderer { mesh = giQuad }, Material { baseColor = Color.white },
          Transform { localScale = float3(0.25, 0.25, 1) });
}

[Before(Stages.Prepare)]
view ConfigureGIProbe(mut Renderer renderer, mut GIProbe probe)
{
    if (probe.dispose) DisposeGI(renderer);
    renderer.enabled = !probe.disabled;
    renderer.gi = probe.settings;
    renderer.camera = Camera { position = float3(0, 0, -2), rotation = quaternion.identity,
                               verticalFov = 60deg, near = 0.1, far = 20 };
    renderer.shadows = false;
    renderer.shadowResolution = 16;
    renderer.maxLights = 1;
    renderer.background = Color.black;
    renderer.ambientIrradiance = probe.ambient;
    probe.bounded = ClampGI(probe.raw);
    GISettings grid = ClampGI(probe.settings);
    for (var i = 0; i < 64; i++) probe.grid[i] = GIPosition(grid, i);
    if (!probe.lightBuilt)
    {
        probe.lightBuilt = true;
        local Spawn(DirectionalLight { direction = float3(0, 0, 1), radiance = float3(0), castShadows = false });
    }
}

[Before(Stages.Prepare)]
view ChangeGILight(mut local DirectionalLight light, GIProbe probe)
{
    light.radiance = probe.directRadiance;
}

[Before(Stages.Prepare)]
view ChangeGIRoom(GIRoomWall wall, mut Material material, GIProbe probe)
{
    float3 emission = wall.emission ? probe.emission : float3(0);
    material.shader = Lit {
        surface = (SurfaceInput input, mut Surface surface) => GIEmission(input, surface, emission)
    };
}

void GIEmission(SurfaceInput input, mut Surface surface, float3 emission)
{
    surface.emission = emission;
}

RenderTarget GIProbeFace(GIResources state, int face)
{
    if (face == 0) return state.face0;
    if (face == 1) return state.face1;
    if (face == 2) return state.face2;
    if (face == 3) return state.face3;
    if (face == 4) return state.face4;
    return state.face5;
}

vert NearGIDepth(mut MeshVertex vertex, out float4 clip)
{
    clip = float4(vertex.position.xy, -0.999, 1);
}

frag SolidGIProbe(MeshVertex vertex, out Color color)
{
    color = Color(0.2, 0.1, 0.05);
}

frag ModerateGIVisibility(Vertex vertex, out Color irradiance, out Color moments)
{
    irradiance = Color(float3(0.2, 0.1, 0.05) * Math.PI, 1);
    moments = Color(0.1, 0.04, 0, 1);
}

// Controlled incoming light has an analytic cosine integral, pi * radiance.
// Mode 2 puts a close depth shell around every probe; mode 3 lights +X only.
[Stage(Stages.GI, 1)]
view ControlledGI(mut Renderer renderer, GIProbe probe)
{
    if (!renderer.enabled || !renderer.giState.ready || probe.synthetic == 0) return;
    for (var face = 0; face < 6; face++)
    {
        RenderTarget target = GIProbeFace(renderer.giResources, face);
        ResetTarget(target);
        target.Clear(probe.synthetic == 3 && face != 0 ? Color.black : Color(0.2, 0.1, 0.05));
        if (probe.synthetic == 2)
        {
            target.SetCull(Cull.None);
            target.Mesh([
                MeshVertex { position = float3(-1, -1, 0) }, MeshVertex { position = float3(1, -1, 0) },
                MeshVertex { position = float3(1, 1, 0) }, MeshVertex { position = float3(-1, 1, 0) }
            ], [0, 1, 2, 0, 2, 3], float4x4.identity, NearGIDepth, SolidGIProbe);
        }
    }
    for (var index = 0; index < renderer.giState.total; index++) IntegrateGIProbe(renderer, index);
    if (probe.synthetic == 4)
    {
        // Known moderate visibility in every direction must attenuate the
        // result even when every candidate probe is equally occluded.
        float height = float(renderer.giState.atlasRows * 10);
        RenderTarget atlas = renderer.giResources.atlas;
        ResetTarget(atlas);
        atlas.Screen()
        {
            atlas.Mesh([
                Vertex { position = float2(0, 0) }, Vertex { position = float2(80, 0) },
                Vertex { position = float2(80, height) }, Vertex { position = float2(0, height) }
            ], [0, 1, 2, 0, 2, 3], ModerateGIVisibility);
        }
    }
}

struct GIWitness { float3 position; float3 normal; }

frag ReadGIWitness(Vertex vertex, out Color color, Renderer renderer, GIWitness witness)
{
    float3 light = SampleGI(renderer.giIrradiance, renderer.giDistance, renderer.giState.settings,
        renderer.giState.initialized, renderer.giState.atlasRows, renderer.giState.far,
        witness.position, witness.normal) / Math.PI;
    color = Color(light, 1);
}

[Stage(Stages.Present, 1)]
view GIWitnesses(Renderer renderer, GIProbe probe)
{
    if (!renderer.enabled || !renderer.ready) return;
    Draw.Screen()
    {
        Draw.SetBlend(Blend.Replace);
        Draw.SetDepth();
        Draw.SetCull();
        for (var i = 0; i < probe.sampleCount && i < 16; i++)
        {
            float x = float(i * 4);
            Draw.Mesh([Vertex { position = float2(x, 0) }, Vertex { position = float2(x + 4, 0) },
                       Vertex { position = float2(x + 4, 8) }, Vertex { position = float2(x, 8) }],
                [0, 1, 2, 0, 2, 3], ReadGIWitness,
                GIWitness { position = probe.positions[i], normal = probe.normals[i] });
        }
    }
}
