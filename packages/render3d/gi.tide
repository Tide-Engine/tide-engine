namespace Render3D;

// One bounded, machine-local diffuse irradiance volume. Updates are whole
// probes, each consisting of six small raster views and one convolution pass.
struct GISettings
{
    bool enabled;
    float3 center;
    float3 size = float3(10);
    int3 counts = int3(3);
    int updatesPerFrame = 1;
    float intensity = 1;
    bool debug;
}

struct GIState
{
    bool ready;
    GISettings settings;
    int cursor;
    int initialized;
    int total;
    int atlasRows;
    float far;
}

// CPU-only geometry and destinations are separate from shader-visible state.
struct GIResources
{
    RenderTarget face0;
    RenderTarget face1;
    RenderTarget face2;
    RenderTarget face3;
    RenderTarget face4;
    RenderTarget face5;
    RenderTarget atlas;
    List<Vertex> quad;
    List<int> indices;
    List<Vertex3> debugMesh;
    List<int> debugIndices;
}

GISettings ClampGI(GISettings settings)
{
    return GISettings {
        enabled = settings.enabled,
        center = Math.Clamp(settings.center, float3(-1000000), float3(1000000)),
        size = Math.Clamp(settings.size, float3(0.1), float3(100)),
        counts = Math.Clamp(settings.counts, int3(2), int3(4)),
        updatesPerFrame = Math.Clamp(settings.updatesPerFrame, 0, 4),
        intensity = Math.Clamp(settings.intensity, 0, 16),
        debug = settings.debug
    };
}

float3 GIPosition(GISettings settings, int index)
{
    int3 coordinate = int3(index % settings.counts.x,
        (index / settings.counts.x) % settings.counts.y,
        index / (settings.counts.x * settings.counts.y));
    return settings.center - settings.size * 0.5
        + float3(coordinate) * settings.size / float3(settings.counts - int3(1));
}

void DisposeGI(mut Renderer renderer)
{
    renderer.giResources.face0.Dispose();
    renderer.giResources.face1.Dispose();
    renderer.giResources.face2.Dispose();
    renderer.giResources.face3.Dispose();
    renderer.giResources.face4.Dispose();
    renderer.giResources.face5.Dispose();
    renderer.giResources.atlas.Dispose();
    renderer.giState = default;
    renderer.giResources = default;
    renderer.giLight0 = default;
    renderer.giLight1 = default;
    renderer.giLight2 = default;
    renderer.giLight3 = default;
    renderer.giLight4 = default;
    renderer.giLight5 = default;
    renderer.giDepth0 = default;
    renderer.giDepth1 = default;
    renderer.giDepth2 = default;
    renderer.giDepth3 = default;
    renderer.giDepth4 = default;
    renderer.giDepth5 = default;
    renderer.giIrradiance = default;
    renderer.giDistance = default;
    renderer.giCapture = false;
}

// A changed volume invalidates all positions and retained lighting. Intensity,
// debug and the scheduling budget can change without discarding the field.
void PrepareGIResources(mut Renderer renderer)
{
    GISettings settings = ClampGI(renderer.gi);
    if (!renderer.enabled || !settings.enabled)
    {
        if (renderer.giState.ready) DisposeGI(renderer);
        return;
    }
    bool changed = !renderer.giState.ready
        || Math.LengthSq(settings.center - renderer.giState.settings.center) > 0
        || Math.LengthSq(settings.size - renderer.giState.settings.size) > 0
        || settings.counts.x != renderer.giState.settings.counts.x
        || settings.counts.y != renderer.giState.settings.counts.y
        || settings.counts.z != renderer.giState.settings.counts.z;
    if (changed)
    {
        if (renderer.giState.ready) DisposeGI(renderer);
        renderer.giState.total = settings.counts.x * settings.counts.y * settings.counts.z;
        renderer.giState.atlasRows = (renderer.giState.total + 7) / 8;
        renderer.giState.far = Math.Clamp(Math.Length(settings.size) * 2, 0.1, 1000);
        renderer.giResources.face0 = RenderTarget(16, 16, 1, Format.Rgba16f);
        renderer.giResources.face1 = RenderTarget(16, 16, 1, Format.Rgba16f);
        renderer.giResources.face2 = RenderTarget(16, 16, 1, Format.Rgba16f);
        renderer.giResources.face3 = RenderTarget(16, 16, 1, Format.Rgba16f);
        renderer.giResources.face4 = RenderTarget(16, 16, 1, Format.Rgba16f);
        renderer.giResources.face5 = RenderTarget(16, 16, 1, Format.Rgba16f);
        renderer.giResources.atlas = RenderTarget(80, renderer.giState.atlasRows * 10, 1,
                                             Format.Rgba16f, Format.Rgba16f);
        renderer.giLight0 = renderer.giResources.face0.color;
        renderer.giLight1 = renderer.giResources.face1.color;
        renderer.giLight2 = renderer.giResources.face2.color;
        renderer.giLight3 = renderer.giResources.face3.color;
        renderer.giLight4 = renderer.giResources.face4.color;
        renderer.giLight5 = renderer.giResources.face5.color;
        renderer.giDepth0 = renderer.giResources.face0.depth;
        renderer.giDepth1 = renderer.giResources.face1.depth;
        renderer.giDepth2 = renderer.giResources.face2.depth;
        renderer.giDepth3 = renderer.giResources.face3.depth;
        renderer.giDepth4 = renderer.giResources.face4.depth;
        renderer.giDepth5 = renderer.giResources.face5.depth;
        renderer.giIrradiance = renderer.giResources.atlas.color;
        renderer.giDistance = renderer.giResources.atlas.colors[1];
        renderer.giResources.quad = [
            Vertex { position = float2(0, 0), uv = float2(0, 0) },
            Vertex { position = float2(10, 0), uv = float2(1, 0) },
            Vertex { position = float2(10, 10), uv = float2(1, 1) },
            Vertex { position = float2(0, 10), uv = float2(0, 1) }
        ];
        renderer.giResources.indices = [0, 1, 2, 0, 2, 3];
        renderer.giResources.debugMesh = [
            Vertex3 { position = float3(1, 0, 0) }, Vertex3 { position = float3(-1, 0, 0) },
            Vertex3 { position = float3(0, 1, 0) }, Vertex3 { position = float3(0, -1, 0) },
            Vertex3 { position = float3(0, 0, 1) }, Vertex3 { position = float3(0, 0, -1) }
        ];
        renderer.giResources.debugIndices = [2, 0, 4, 2, 4, 1, 2, 1, 5, 2, 5, 0,
                                       3, 4, 0, 3, 1, 4, 3, 5, 1, 3, 0, 5];
        ResetTarget(renderer.giResources.atlas);
        renderer.giResources.atlas.Clear(Color.black);
        renderer.giState.ready = true;
    }
    renderer.giState.settings = settings;
}

quaternion GIFaceRotation(int face)
{
    if (face == 0) return quaternion.LookRotation(float3(1, 0, 0), float3(0, 1, 0));
    if (face == 1) return quaternion.LookRotation(float3(-1, 0, 0), float3(0, 1, 0));
    if (face == 2) return quaternion.LookRotation(float3(0, 1, 0), float3(0, 0, -1));
    if (face == 3) return quaternion.LookRotation(float3(0, -1, 0), float3(0, 0, 1));
    if (face == 4) return quaternion.LookRotation(float3(0, 0, 1), float3(0, 1, 0));
    return quaternion.LookRotation(float3(0, 0, -1), float3(0, 1, 0));
}

RenderTarget GIFaceTarget(Renderer renderer, int face)
{
    if (face == 0) return renderer.giResources.face0;
    if (face == 1) return renderer.giResources.face1;
    if (face == 2) return renderer.giResources.face2;
    if (face == 3) return renderer.giResources.face3;
    if (face == 4) return renderer.giResources.face4;
    return renderer.giResources.face5;
}

float3 GIFaceDirection(int face, float2 uv)
{
    float2 p = uv * 2 - float2(1);
    if (face == 0) return Math.Normalize(float3(1, -p.y, -p.x));
    if (face == 1) return Math.Normalize(float3(-1, -p.y, p.x));
    if (face == 2) return Math.Normalize(float3(p.x, 1, p.y));
    if (face == 3) return Math.Normalize(float3(p.x, -1, -p.y));
    if (face == 4) return Math.Normalize(float3(p.x, -p.y, 1));
    return Math.Normalize(float3(-p.x, -p.y, -1));
}

// Octahedral borders reflect into the opposite edge. Each probe has its own
// one-texel gutter, so bilinear reads never mix neighboring probe records.
float2 GIWrapOct(float2 uv)
{
    mut float2 result = uv;
    if (result.x < 0) result = float2(-result.x, 1 - result.y);
    else if (result.x > 1) result = float2(2 - result.x, 1 - result.y);
    if (result.y < 0) result = float2(1 - result.x, -result.y);
    else if (result.y > 1) result = float2(1 - result.x, 2 - result.y);
    return result;
}

float3 GIOctDirection(float2 uv)
{
    float2 p = GIWrapOct(uv) * 2 - float2(1);
    mut float3 direction = float3(p, 1 - Math.Abs(p.x) - Math.Abs(p.y));
    if (direction.z < 0)
        direction = float3((1 - Math.Abs(p.y)) * (p.x >= 0 ? 1 : -1),
                           (1 - Math.Abs(p.x)) * (p.y >= 0 ? 1 : -1), direction.z);
    return Math.Normalize(direction);
}

float2 GIOctUV(float3 direction)
{
    float3 n = Math.Normalize(direction);
    float scale = Math.Abs(n.x) + Math.Abs(n.y) + Math.Abs(n.z);
    if (scale <= 0) return float2(0.5);
    float3 p = n / scale;
    float2 folded = p.z >= 0 ? p.xy
        : float2((1 - Math.Abs(p.y)) * (p.x >= 0 ? 1 : -1),
                 (1 - Math.Abs(p.x)) * (p.y >= 0 ? 1 : -1));
    return folded * 0.5 + float2(0.5);
}

float2 GIAtlasUV(int probe, int rows, float3 direction)
{
    float2 tile = float2(probe % 8, probe / 8) * 10;
    return (tile + float2(1) + GIOctUV(direction) * 8) / float2(80, rows * 10);
}

float3 GICaptureLight(Texture light0, Texture light1, Texture light2,
                      Texture light3, Texture light4, Texture light5, int face, float2 uv)
{
    mut Color light = Color.black;
    if (face == 0) light = light0.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 1) light = light1.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 2) light = light2.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 3) light = light3.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 4) light = light4.Sample(uv, Filter.Point, Wrap.Clamp);
    else light = light5.Sample(uv, Filter.Point, Wrap.Clamp);
    return ClampHdr(float3(light.r, light.g, light.b));
}

float GICaptureDepth(DepthTexture depth0, DepthTexture depth1, DepthTexture depth2,
                      DepthTexture depth3, DepthTexture depth4, DepthTexture depth5, int face, float2 uv)
{
    if (face == 0) return depth0.Sample(uv);
    if (face == 1) return depth1.Sample(uv);
    if (face == 2) return depth2.Sample(uv);
    if (face == 3) return depth3.Sample(uv);
    if (face == 4) return depth4.Sample(uv);
    return depth5.Sample(uv);
}

// Perspective depth is axial distance. Divide by the ray's largest absolute
// component to recover radial distance, then normalize before half-float storage.
float GIRadialDistance(float depth, float3 direction, float far)
{
    float axial = 0.02 * far / Math.Max(far - Math.Clamp(depth, 0, 1) * (far - 0.02), 0.00001);
    float dominant = Math.Max(Math.Abs(direction.x), Math.Max(Math.Abs(direction.y), Math.Abs(direction.z)));
    return Math.Clamp(axial / Math.Max(dominant * far, 0.00001), 0, 1);
}

frag ConvolveGI(Vertex vertex, out Color irradiance, out Color moments, Renderer renderer)
{
    float3 direction = GIOctDirection((vertex.uv * 10 - float2(1)) / 8);
    mut float3 light = float3(0);
    mut float lightWeight = 0;
    mut float mean = 0;
    mut float second = 0;
    mut float distanceWeight = 0;
    for (var face = 0; face < 6; face++)
    {
        for (var y = 0; y < 4; y++)
        {
            for (var x = 0; x < 4; x++)
            {
                // Symmetric actual texel centers in each 16-square face.
                // Reconstruct exactly the rays fetched by Point/depth reads.
                int px = x < 2 ? 2 + x * 4 : 9 + (x - 2) * 4;
                int py = y < 2 ? 2 + y * 4 : 9 + (y - 2) * 4;
                float2 uv = (float2(px, py) + float2(0.5)) / 16;
                float2 plane = uv * 2 - float2(1);
                float lengthSq = 1 + Math.Dot(plane, plane);
                float solidAngle = 1 / (lengthSq * Math.Sqrt(lengthSq));
                float3 ray = GIFaceDirection(face, uv);
                float cosine = Math.Max(Math.Dot(direction, ray), 0);
                float diffuse = cosine * solidAngle;
                float3 radiance = GICaptureLight(renderer.giLight0, renderer.giLight1, renderer.giLight2,
                    renderer.giLight3, renderer.giLight4, renderer.giLight5, face, uv);
                light += radiance * diffuse;
                lightWeight += diffuse;
                float depth = GICaptureDepth(renderer.giDepth0, renderer.giDepth1, renderer.giDepth2,
                    renderer.giDepth3, renderer.giDepth4, renderer.giDepth5, face, uv);
                float distance = GIRadialDistance(depth, ray, renderer.giState.far);
                float square = cosine * cosine;
                float fourth = square * square;
                float eighth = fourth * fourth;
                float weight = eighth * eighth * solidAngle;
                mean += distance * weight;
                second += distance * distance * weight;
                distanceWeight += weight;
            }
        }
    }
    irradiance = Color(ClampHdr(light * (Math.PI / Math.Max(lightWeight, 0.00001))), 1);
    moments = Color(mean / Math.Max(distanceWeight, 0.00001),
                    second / Math.Max(distanceWeight, 0.00001), 0, 1);
}

// Exposed separately from scene capture for analytic test fixtures and future
// update scheduling. The tile draw leaves every other retained probe untouched.
void IntegrateGIProbe(mut Renderer renderer, int probe)
{
    if (!renderer.giState.ready || probe < 0 || probe >= renderer.giState.total) return;
    ResetTarget(renderer.giResources.atlas);
    renderer.giResources.atlas.SetScreen();
    renderer.giResources.atlas.Transform(float2(probe % 8, probe / 8) * 10)
    {
        renderer.giResources.atlas.Mesh(renderer.giResources.quad, renderer.giResources.indices, ConvolveGI);
    }
    renderer.giState.initialized = Math.Max(renderer.giState.initialized, probe + 1);
}

// Chebyshev visibility, sharpened to suppress the broad tails that otherwise
// brighten the far side of walls. Distances and moments are normalized alike.
float GIVisibility(float mean, float second, float distance)
{
    if (distance <= mean) return 1;
    float variance = Math.Max(second - mean * mean, 0.000001);
    float difference = distance - mean;
    float visibility = variance / (variance + difference * difference);
    return visibility * visibility * visibility;
}

// Texture arguments are explicit: GPU helpers cannot acquire resource fields
// through a copied aggregate. Moments always have alpha one, preserving numbers
// through ordinary target color sampling.
float3 SampleGI(Texture irradiance, Texture distance, GISettings settings,
                int initialized, int atlasRows, float far, float3 world, float3 normal)
{
    if (!settings.enabled || initialized <= 0 || settings.intensity <= 0 || atlasRows <= 0) return float3(0);
    float3 minimum = settings.center - settings.size * 0.5;
    float3 volume = (world - minimum) / settings.size;
    if (volume.x < 0 || volume.y < 0 || volume.z < 0
        || volume.x > 1 || volume.y > 1 || volume.z > 1) return float3(0);
    float3 n = Math.Normalize(normal);
    float3 spacing = settings.size / float3(settings.counts - int3(1));
    float bias = Math.Min(spacing.x, Math.Min(spacing.y, spacing.z)) * 0.03;
    float3 position = world + n * bias;
    float3 grid = Math.Clamp((position - minimum) / spacing, float3(0), float3(settings.counts - int3(1)));
    int3 lower = Math.Min(int3(Math.Floor(grid)), settings.counts - int3(2));
    float3 fraction = grid - float3(lower);
    mut float3 result = float3(0);
    mut float weightSum = 0;
    for (var z = 0; z < 2; z++)
    {
        for (var y = 0; y < 2; y++)
        {
            for (var x = 0; x < 2; x++)
            {
                int3 coordinate = lower + int3(x, y, z);
                int probe = coordinate.x + settings.counts.x * (coordinate.y + settings.counts.y * coordinate.z);
                if (probe >= initialized) continue;
                float3 axis = float3(x == 0 ? 1 - fraction.x : fraction.x,
                                     y == 0 ? 1 - fraction.y : fraction.y,
                                     z == 0 ? 1 - fraction.z : fraction.z);
                float3 probePosition = minimum + float3(coordinate) * spacing;
                float3 delta = position - probePosition;
                Color moments = distance.Sample(GIAtlasUV(probe, atlasRows, delta), Filter.Bilinear, Wrap.Clamp);
                float visibility = GIVisibility(moments.r, moments.g,
                                                Math.Length(delta) / Math.Max(far, 0.1));
                float facing = Math.Max(Math.Dot(n, Math.Normalize(probePosition - world)), 0);
                float baseWeight = axis.x * axis.y * axis.z * (0.05 + facing * facing);
                float weight = baseWeight * visibility;
                Color sampled = irradiance.Sample(GIAtlasUV(probe, atlasRows, n), Filter.Bilinear, Wrap.Clamp);
                result += ClampHdr(float3(sampled.r, sampled.g, sampled.b)) * weight;
                // Normalize interpolation, not visibility. Including visibility
                // here would restore full brightness when all probes are hidden.
                weightSum += baseWeight;
            }
        }
    }
    return weightSum > 0.00001 ? ClampHdr(result / weightSum * settings.intensity) : float3(0);
}

[Stage(Stages.GI)]
view UpdateGI(mut Renderer renderer, World world,
              query (MeshRenderer mesh, Material material) meshes,
              query (SkinnedMeshRenderer mesh, Material material) skins)
{
    if (!renderer.enabled || !renderer.ready || !renderer.giState.ready) return;
    int budget = Math.Min(renderer.giState.settings.updatesPerFrame, renderer.giState.total);
    for (var update = 0; update < budget; update++)
    {
        int probe = renderer.giState.cursor;
        float3 position = GIPosition(renderer.giState.settings, probe);
        mut Renderer capture = renderer;
        capture.giCapture = true;
        capture.giEye = position;
        for (var face = 0; face < 6; face++)
        {
            capture.hdr = GIFaceTarget(renderer, face);
            ResetTarget(capture.hdr);
            capture.hdr.Clear(Color.black);
            capture.hdr.SetCamera(float4x4.TRS(position, GIFaceRotation(face), float3(1)),
                float4x4.PerspectiveFov(Math.PI * 0.5, 1, 0.02, renderer.giState.far));
            foreach (var object in meshes)
            {
                if (!object.mesh.visible || object.material.mode == SurfaceMode.Transparent) continue;
                DrawMaterial(capture, object.mesh, object.material, world.LocalToWorld(object.entity));
            }
            foreach (var object in skins)
            {
                if (!object.mesh.visible || object.material.mode == SurfaceMode.Transparent) continue;
                DrawSkinnedMaterial(capture, object.mesh, object.material, world.LocalToWorld(object.entity));
            }
        }
        IntegrateGIProbe(renderer, probe);
        renderer.giState.cursor = (probe + 1) % renderer.giState.total;
    }
}

struct GIProbeIndex { int index; }

frag DebugGIProbe(Vertex3 vertex, out Color color, Renderer renderer, GIProbeIndex probe)
{
    if (probe.index >= renderer.giState.initialized)
    {
        color = Color(0.15, 0, 0.15);
        return;
    }
    Color sampled = renderer.giIrradiance.Sample(
        GIAtlasUV(probe.index, renderer.giState.atlasRows, vertex.position), Filter.Bilinear, Wrap.Clamp);
    color = Color(ClampHdr(float3(sampled.r, sampled.g, sampled.b)
        * (renderer.giState.settings.intensity / Math.PI)), 1);
}

[After(Stages.Transparent), Before(Stages.PostPrepare)]
view DebugGI(Renderer renderer)
{
    if (!renderer.enabled || !renderer.ready || !renderer.giState.ready || !renderer.giState.settings.debug) return;
    float3 spacing = renderer.giState.settings.size / float3(renderer.giState.settings.counts - int3(1));
    float radius = Math.Min(spacing.x, Math.Min(spacing.y, spacing.z)) * 0.06;
    renderer.hdr.Cull(Cull.None), renderer.hdr.Depth(Depth.Read), renderer.hdr.Blend(Blend.Replace)
    {
        for (var probe = 0; probe < renderer.giState.total; probe++)
        {
            float3 position = GIPosition(renderer.giState.settings, probe);
            renderer.hdr.Mesh(renderer.giResources.debugMesh, renderer.giResources.debugIndices,
                float4x4.TRS(position, quaternion.identity, float3(radius)), DebugGIProbe,
                GIProbeIndex { index = probe });
        }
    }
}
