using Render3D;
namespace GlobalIllumination;

// Quality and work controls; placement is derived from rendered geometry.
struct Settings
{
    bool enabled = true;
    float probeSpacing = 1.5;
    int maxProbes = 512;
    int updatesPerFrame = 4;
    float viewDistance = 48;
    float captureDistance = 48;
    int refreshInterval = 600;
    float intensity = 1;
    bool debug;
}

struct FieldLayout
{
    float3 minimum;
    float spacing;
    int3 counts;
    int total;
    int atlasRows;
    float far;
    bool sparse;
    float size;
    int nodeCount;
    int depthLimit;
}

struct LocalBounds
{
    float3 minimum;
    float3 maximum;
    bool valid;
}

struct StaticBounds
{
    Asset<Render3D.Mesh3D> mesh;
    LocalBounds bounds;
    bool placementReady;
    PlacementMesh placement;
}

struct SkinBounds
{
    Asset<Render3D.SkinnedMesh3D> mesh;
    LocalBounds bounds;
}

// Comparable material facts for regional invalidation. Live material resources
// and prepared poses remain in the renderer query used for capture packets.
struct CaptureMaterial
{
    SurfaceMode mode;
    Color baseColor = Color.white;
    float metallic;
    float roughness = 0.5;
    float3 emission;
    bool receiveShadows = true;
    bool doubleSided;
    float alphaCutoff = 0.5;
    float normalScale = 1;
    float occlusionStrength = 1;
    float heightScale;
    float2 uvScale = float2(1);
    float2 uvOffset;
    bool deformed;
}

CaptureMaterial CaptureMaterialOf(Render3D.Material material)
{
    return CaptureMaterial {
        mode = material.mode, baseColor = material.baseColor, metallic = material.metallic,
        roughness = material.roughness, emission = material.emission,
        receiveShadows = material.receiveShadows, doubleSided = material.doubleSided,
        alphaCutoff = material.alphaCutoff, normalScale = material.normalScale,
        occlusionStrength = material.occlusionStrength, heightScale = material.heightScale,
        uvScale = material.uvScale, uvOffset = material.uvOffset, deformed = material.vertex != null
    };
}

// Current presentation instance identities and comparable facts. Stored
// transforms and bounds are shared by coverage, relocation and capture queries
// rather than being recomputed per capture face.
struct SceneInstance
{
    Entity entity;
    bool skinned;
    bool castShadows;
    Asset<Render3D.Mesh3D> mesh;
    Asset<Render3D.SkinnedMesh3D> skin;
    CaptureMaterial material;
    float4x4 transform;
    LocalBounds bounds;
    int slot;
    bool placementEligible;
    bool seen;
}

struct CoverageNode
{
    float3 minimum;
    float size;
    int children = -1;
    int slot = -1;
    int depth;
    bool relevant;
    float priority;
    int probeMask = 134217727;
}

// Numeric receiver visibility, independent of GPU resources or draw-list state.
// The finite prototype range matches the existing coverage/capture controls.
struct CoverageView
{
    float3 eye;
    float3[6] normals;
    float[6] distances;
    float padding;
    LocalBounds bounds;
}

// Local geometry facts are read once per pack generation. Entity-to-slot
// maps avoid searching the distinct asset list for every instance each frame.
local singleton WorldBounds
{
    FieldLayout layout;
    bool ready;
    long generation;
    int staticScans;
    int skinnedScans;
    int geometryCount;
    List<StaticBounds> staticBounds;
    List<SkinBounds> skinnedBounds;
    Map<Entity, int> staticSlots;
    Map<Entity, int> skinnedSlots;
    float3 minimum;
    float3 maximum;
    float requestedSpacing;
    int requestedMaxProbes;
    float requestedViewDistance;
    float requestedCaptureDistance;
    float3 viewCell;
    float3 viewDirection;
    quaternion viewRotation;
    float requestedFov;
    float requestedNear;
    float requestedFar;
    float requestedAspect;
    CoverageView coverageView;
    List<SceneInstance> instances;
    Map<Entity, int> instanceSlots;
    Map<Entity, int> skinInstanceSlots;
    List<LocalBounds> changes;
    List<LocalBounds> shadowChanges;
    bool geometryChanged;
    int revision;
    int geometryRevision;
    int sceneRevision = -1;
    SceneIndex scene;
    int topologyRevision;
    List<CoverageNode> nodes;
    List<int> lookup;
}

// Package-local C bridge to the existing pack generation counter. This is
// presentation cache metadata, never simulation state or an engine ABI.
extern long GIAssetGeneration();

Settings ClampSettings(Settings settings)
{
    return Settings {
        enabled = settings.enabled,
        probeSpacing = Math.Clamp(settings.probeSpacing, 0.1, 1000),
        maxProbes = Math.Clamp(settings.maxProbes, 125, 2048),
        updatesPerFrame = Math.Clamp(settings.updatesPerFrame, 0, 16),
        viewDistance = Math.Clamp(settings.viewDistance, 1, 1000000),
        captureDistance = Math.Clamp(settings.captureDistance, 1, 1000000),
        refreshInterval = Math.Clamp(settings.refreshInterval, 1, 36000),
        intensity = Math.Clamp(settings.intensity, 0, 16),
        debug = settings.debug
    };
}

bool FiniteBoundsValue(float value)
{
    // Values beyond this leave too little binary32 precision for a useful
    // bounded field. Refuse that geometry instead of generating NaN layout.
    return value >= -1e30 && value <= 1e30;
}

bool FiniteBoundsValue(float3 value)
{
    return FiniteBoundsValue(value.x) && FiniteBoundsValue(value.y) && FiniteBoundsValue(value.z);
}

LocalBounds MeshBounds(Render3D.Mesh3D mesh)
{
    mut LocalBounds result = default;
    foreach (var vertex in mesh.vertices)
    {
        if (!FiniteBoundsValue(vertex.position)) return default;
        result.minimum = result.valid ? Math.Min(result.minimum, vertex.position) : vertex.position;
        result.maximum = result.valid ? Math.Max(result.maximum, vertex.position) : vertex.position;
        result.valid = true;
    }
    return result;
}

LocalBounds SkinBoundsOf(Render3D.SkinnedMesh3D mesh)
{
    // Rest geometry is the available CPU bound. Arbitrary deformation/poses
    // can exceed it; the raster capture itself still uses the prepared pose.
    mut LocalBounds result = default;
    foreach (var vertex in mesh.vertices)
    {
        if (!FiniteBoundsValue(vertex.position)) return default;
        result.minimum = result.valid ? Math.Min(result.minimum, vertex.position) : vertex.position;
        result.maximum = result.valid ? Math.Max(result.maximum, vertex.position) : vertex.position;
        result.valid = true;
    }
    return result;
}

LocalBounds StaticLocalBounds(mut WorldBounds world, Entity entity, Asset<Render3D.Mesh3D> mesh)
{
    if (world.staticSlots.TryGet(entity, out var slot))
    {
        int index = slot - 1;
        if (index >= 0 && index < world.staticBounds.count && world.staticBounds[index].mesh == mesh)
            return world.staticBounds[index].bounds;
    }
    mut int found = -1;
    for (var index = 0; index < world.staticBounds.count; index++)
    {
        if (world.staticBounds[index].mesh == mesh) { found = index; break; }
    }
    if (found < 0)
    {
        found = world.staticBounds.count;
        world.staticBounds.Add(StaticBounds { mesh = mesh, bounds = MeshBounds(mesh.Value) });
        world.staticScans++;
    }
    world.staticSlots[entity] = found + 1;
    return world.staticBounds[found].bounds;
}

LocalBounds SkinnedLocalBounds(mut WorldBounds world, Entity entity, Asset<Render3D.SkinnedMesh3D> mesh)
{
    if (world.skinnedSlots.TryGet(entity, out var slot))
    {
        int index = slot - 1;
        if (index >= 0 && index < world.skinnedBounds.count && world.skinnedBounds[index].mesh == mesh)
            return world.skinnedBounds[index].bounds;
    }
    mut int found = -1;
    for (var index = 0; index < world.skinnedBounds.count; index++)
    {
        if (world.skinnedBounds[index].mesh == mesh) { found = index; break; }
    }
    if (found < 0)
    {
        found = world.skinnedBounds.count;
        world.skinnedBounds.Add(SkinBounds { mesh = mesh, bounds = SkinBoundsOf(mesh.Value) });
        world.skinnedScans++;
    }
    world.skinnedSlots[entity] = found + 1;
    return world.skinnedBounds[found].bounds;
}

LocalBounds TransformBounds(LocalBounds bounds, float4x4 transform)
{
    if (!bounds.valid) return default;
    mut LocalBounds result = default;
    for (var index = 0; index < 8; index++)
    {
        float3 corner = float3((index & 1) == 0 ? bounds.minimum.x : bounds.maximum.x,
                               (index & 2) == 0 ? bounds.minimum.y : bounds.maximum.y,
                               (index & 4) == 0 ? bounds.minimum.z : bounds.maximum.z);
        float3 position = Math.Mul(transform, float4(corner, 1)).xyz;
        if (!FiniteBoundsValue(position)) return default;
        result.minimum = result.valid ? Math.Min(result.minimum, position) : position;
        result.maximum = result.valid ? Math.Max(result.maximum, position) : position;
        result.valid = true;
    }
    return result;
}

LocalBounds JoinBounds(LocalBounds first, LocalBounds second)
{
    if (!first.valid) return second;
    if (!second.valid) return first;
    return LocalBounds {
        valid = true, minimum = Math.Min(first.minimum, second.minimum),
        maximum = Math.Max(first.maximum, second.maximum)
    };
}

FieldLayout BuildLayout(float3 minimum, float3 maximum, float spacing, int maxProbes)
{
    if (!FiniteBoundsValue(minimum) || !FiniteBoundsValue(maximum)
        || minimum.x > maximum.x || minimum.y > maximum.y || minimum.z > maximum.z) return default;
    // Avoid a spacing smaller than binary32 can represent at this world
    // coordinate, which would collapse distinct probes onto the same point.
    double magnitude = Math.Cmax(Math.Max(Math.Abs(double3(minimum)), Math.Abs(double3(maximum))));
    mut double step = Math.Max(double(Math.Clamp(spacing, 0.1, 1000)), magnitude * 1e-6d);
    int limit = Math.Clamp(maxProbes, 125, 2048);
    // Work in double while fitting integer cell counts, before narrowing the
    // bounded layout. At most 112 doublings cover the accepted world range.
    for (var attempt = 0; attempt < 112; attempt++)
    {
        // Half-cell lattice avoids putting probes exactly on common integer
        // walls/floors. Quarter-cell padding includes the receiver normal bias
        // without spending the probe budget on two extra nodes per axis.
        double3 lower = Math.Floor(double3(minimum) / step - double3(0.75d));
        double3 upper = Math.Ceil(double3(maximum) / step - double3(0.25d));
        double3 span = upper - lower + double3(1d);
        int3 counts = int3(Math.Clamp(span, double3(2d), double3(2049d)));
        long total = long(counts.x) * long(counts.y) * long(counts.z);
        if (total <= long(limit))
        {
            float actualSpacing = float(step);
            float3 origin = float3((lower + double3(0.5d)) * step);
            float far = float(Math.Clamp(step * Math.Sqrt(Math.Dot(double3(counts - int3(1)),
                double3(counts - int3(1)))) * 2d, 0.1d, 1000000d));
            if (!FiniteBoundsValue(origin * 0.125) || !FiniteBoundsValue(actualSpacing) || far <= 0) return default;
            return FieldLayout {
                minimum = origin, spacing = actualSpacing, counts = counts,
                total = int(total), atlasRows = (int(total) + 31) / 32, far = far
            };
        }
        step *= 2d;
    }
    return default;
}

float3 ProbePosition(FieldLayout layout, int index)
{
    if (layout.total <= 0 || index < 0 || index >= layout.total) return float3(0);
    int3 coordinate = int3(index % layout.counts.x,
        (index / layout.counts.x) % layout.counts.y,
        index / (layout.counts.x * layout.counts.y));
    return layout.minimum + float3(coordinate) * layout.spacing;
}

bool SameLayout(FieldLayout first, FieldLayout second)
{
    return first.minimum.x == second.minimum.x && first.minimum.y == second.minimum.y
        && first.minimum.z == second.minimum.z && first.spacing == second.spacing
        && first.counts.x == second.counts.x && first.counts.y == second.counts.y
        && first.counts.z == second.counts.z && first.total == second.total;
}

void ClearWorldBounds(mut WorldBounds world)
{
    world = default;
}

bool SameVector2(float2 a, float2 b)
{
    return a.x == b.x && a.y == b.y;
}

bool SameVector3(float3 a, float3 b)
{
    return a.x == b.x && a.y == b.y && a.z == b.z;
}

bool SameVector4(float4 a, float4 b)
{
    return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w;
}

bool SameTransform(float4x4 a, float4x4 b)
{
    // Squared differences can underflow to zero for distinct finite values.
    return SameVector4(a.c0, b.c0) && SameVector4(a.c1, b.c1)
        && SameVector4(a.c2, b.c2) && SameVector4(a.c3, b.c3);
}

bool SameMaterial(CaptureMaterial a, CaptureMaterial b)
{
    // Callback captures and texture identity/contents have no comparison API.
    // Explicit invalidation and background refresh cover those parameters.
    return a.mode == b.mode && a.baseColor.r == b.baseColor.r && a.baseColor.g == b.baseColor.g
        && a.baseColor.b == b.baseColor.b && a.baseColor.a == b.baseColor.a
        && a.metallic == b.metallic && a.roughness == b.roughness
        && SameVector3(a.emission, b.emission) && a.receiveShadows == b.receiveShadows
        && a.doubleSided == b.doubleSided && a.alphaCutoff == b.alphaCutoff
        && a.normalScale == b.normalScale && a.occlusionStrength == b.occlusionStrength
        && a.heightScale == b.heightScale && SameVector2(a.uvScale, b.uvScale)
        && SameVector2(a.uvOffset, b.uvOffset);
}

bool SameShadowCoverage(CaptureMaterial a, CaptureMaterial b)
{
    if (a.mode != b.mode || a.doubleSided != b.doubleSided) return false;
    // Opaque color/roughness/emission cannot change the shadow silhouette.
    // Cutout UV/parallax and numeric alpha controls can. Opaque callback and
    // texture changes use explicit invalidation instead of guessed identity.
    if (a.mode != Render3D.SurfaceMode.Cutout && b.mode != Render3D.SurfaceMode.Cutout) return true;
    return a.baseColor.a == b.baseColor.a && a.alphaCutoff == b.alphaCutoff
        && a.heightScale == b.heightScale && SameVector2(a.uvScale, b.uvScale)
        && SameVector2(a.uvOffset, b.uvOffset);
}

LocalBounds ShadowRegion(SceneInstance instance)
{
    // Rest bounds do not constrain the current extent of a skin or callback.
    return instance.skinned || instance.material.deformed ? default : instance.bounds;
}

int ExistingInstance(WorldBounds bounds, Entity entity, bool skinned = false)
{
    mut int slot = 0;
    bool found = skinned ? bounds.skinInstanceSlots.TryGet(entity, out slot) : bounds.instanceSlots.TryGet(entity, out slot);
    if (!found) return -1;
    return slot > 0 && slot <= bounds.instances.count ? slot - 1 : -1;
}

void StoreInstance(mut WorldBounds bounds, SceneInstance input, int previous)
{
    mut SceneInstance instance = input;
    mut bool geometryChanged = previous < 0;
    mut bool materialChanged = previous < 0;
    mut bool casterChanged = previous < 0;
    mut bool shadowChanged = previous < 0;
    if (previous >= 0)
    {
        SceneInstance before = bounds.instances[previous];
        geometryChanged = before.skinned != instance.skinned || !SameTransform(before.transform, instance.transform)
            || before.placementEligible != instance.placementEligible
            || before.material.deformed != instance.material.deformed
            || (instance.skinned ? before.skin != instance.skin : before.mesh != instance.mesh);
        materialChanged = !SameMaterial(before.material, instance.material);
        casterChanged = before.castShadows != instance.castShadows;
        shadowChanged = geometryChanged || casterChanged || !SameShadowCoverage(before.material, instance.material);
        if (geometryChanged || materialChanged || casterChanged) bounds.changes.Add(before.bounds);
        if (shadowChanged && before.castShadows) bounds.shadowChanges.Add(ShadowRegion(before));
    }
    if (geometryChanged || materialChanged || casterChanged || instance.skinned || instance.material.deformed)
        bounds.changes.Add(instance.bounds);
    if (instance.castShadows && (shadowChanged || instance.skinned || instance.material.deformed))
        bounds.shadowChanges.Add(ShadowRegion(instance));
    bounds.geometryChanged = bounds.geometryChanged || geometryChanged;
    instance.seen = true;
    if (previous >= 0) bounds.instances[previous] = instance;
    else
    {
        if (instance.skinned) bounds.skinInstanceSlots[instance.entity] = bounds.instances.count + 1;
        else bounds.instanceSlots[instance.entity] = bounds.instances.count + 1;
        bounds.instances.Add(instance);
    }
}

bool BoxesOverlap(float3 aMin, float3 aMax, float3 bMin, float3 bMax)
{
    return aMin.x <= bMax.x && aMax.x >= bMin.x && aMin.y <= bMax.y
        && aMax.y >= bMin.y && aMin.z <= bMax.z && aMax.z >= bMin.z;
}

double BoundsDistanceSq(LocalBounds bounds, float3 point)
{
    if (!bounds.valid) return 1e300d;
    double3 delta = double3(point) - Math.Clamp(double3(point), double3(bounds.minimum), double3(bounds.maximum));
    return Math.LengthSq(delta);
}

CoverageView MakeCoverageView(Render3D.Camera camera, float aspect, float padding)
{
    mut CoverageView frustum = default;
    frustum.eye = camera.position;
    frustum.padding = padding;
    quaternion rotation = Math.Normalize(camera.rotation);
    float3 right = Math.Rotate(rotation, float3(1, 0, 0));
    float3 up = Math.Rotate(rotation, float3(0, 1, 0));
    float3 forward = Math.Rotate(rotation, float3(0, 0, 1));
    float vertical = Math.Tan(Math.Clamp(camera.verticalFov, 1deg, 179deg) * 0.5);
    float horizontal = vertical * Math.Max(aspect, 0.000001);
    float near = Math.Clamp(camera.near, 0.001, 999999);
    float far = Math.Clamp(camera.far, near + 0.001, 1000000);
    frustum.normals[0] = Math.Normalize(forward * horizontal + right);
    frustum.normals[1] = Math.Normalize(forward * horizontal - right);
    frustum.normals[2] = Math.Normalize(forward * vertical + up);
    frustum.normals[3] = Math.Normalize(forward * vertical - up);
    frustum.normals[4] = forward;
    frustum.normals[5] = -forward;
    frustum.distances[4] = near;
    frustum.distances[5] = -far;
    // Until the next rebuild, full camera rotation changes by at most ten
    // degrees. A unit plane normal then changes by at most 2*sin(5deg)<.175.
    // Cover that displacement and translation within the retained view cell.
    double reach = double(far) * Math.Sqrt(1d + double(horizontal) * double(horizontal)
        + double(vertical) * double(vertical));
    float margin = float(reach * 0.175d + double(padding));
    for (var corner = 0; corner < 8; corner++)
    {
        float depth = (corner & 4) == 0 ? near : far;
        float3 point = camera.position + forward * depth
            + right * (depth * horizontal * ((corner & 1) == 0 ? -1 : 1))
            + up * (depth * vertical * ((corner & 2) == 0 ? -1 : 1));
        if (!FiniteBoundsValue(point) || !FiniteBoundsValue(margin)) return default;
        frustum.bounds = JoinBounds(frustum.bounds,
            LocalBounds { valid = true, minimum = point - float3(margin), maximum = point + float3(margin) });
    }
    return frustum;
}

bool CoverageVisible(CoverageView frustum, LocalBounds receiver)
{
    if (!frustum.bounds.valid || !receiver.valid
        || !BoxesOverlap(receiver.minimum, receiver.maximum, frustum.bounds.minimum, frustum.bounds.maximum)) return false;
    double3 center = (double3(receiver.minimum) + double3(receiver.maximum)) * 0.5d - double3(frustum.eye);
    double3 extent = (double3(receiver.maximum) - double3(receiver.minimum)) * 0.5d;
    double movement = double(frustum.padding) + (Math.Length(center) + Math.Length(extent)) * 0.175d;
    for (var plane = 0; plane < 6; plane++)
    {
        double3 normal = double3(frustum.normals[plane]);
        double support = Math.Dot(normal, center) + Math.Dot(Math.Abs(normal), extent) + movement;
        if (support < double(frustum.distances[plane])) return false;
    }
    return true;
}

bool CoverageEligible(WorldBounds bounds, LocalBounds receiver, float3 eye, float viewDistance)
{
    float near = viewDistance + bounds.coverageView.padding;
    return receiver.valid && (BoundsDistanceSq(receiver, eye) <= double(near) * double(near)
        || CoverageVisible(bounds.coverageView, receiver));
}

LocalBounds CoverageReceiverBounds(WorldBounds bounds, float3 eye, float viewDistance)
{
    mut LocalBounds result = default;
    float near = viewDistance + bounds.coverageView.padding;
    float3 nearMin = eye - float3(near);
    float3 nearMax = eye + float3(near);
    foreach (var instance in bounds.instances)
    {
        LocalBounds receiver = instance.bounds;
        if (!receiver.valid) continue;
        if (BoundsDistanceSq(receiver, eye) <= double(near) * double(near))
            result = JoinBounds(result, LocalBounds { valid = true,
                minimum = Math.Max(receiver.minimum, nearMin), maximum = Math.Min(receiver.maximum, nearMax) });
        if (CoverageVisible(bounds.coverageView, receiver))
            result = JoinBounds(result, LocalBounds { valid = true,
                minimum = Math.Max(receiver.minimum, bounds.coverageView.bounds.minimum),
                maximum = Math.Min(receiver.maximum, bounds.coverageView.bounds.maximum) });
    }
    return result;
}

bool UsefulCoverage(WorldBounds bounds, float3 minimum, float size, float3 eye, float viewDistance, float padding)
{
    LocalBounds cell = LocalBounds { valid = true, minimum = minimum, maximum = minimum + float3(size) };
    if (!CoverageEligible(bounds, cell, eye, viewDistance)) return false;
    float3 center = minimum + float3(size * 0.5);
    float radius = size * 0.9 + padding;
    var candidates = CaptureCandidates(bounds.scene, center, radius);
    foreach (var index in candidates)
    {
        if (index < 0 || index >= bounds.instances.count) continue;
        SceneInstance instance = bounds.instances[index];
        LocalBounds receiver = LocalBounds { valid = instance.bounds.valid,
            minimum = Math.Max(minimum - float3(padding), instance.bounds.minimum),
            maximum = Math.Min(minimum + float3(size + padding), instance.bounds.maximum) };
        if (!BoxesOverlap(minimum - float3(padding), minimum + float3(size + padding),
                          instance.bounds.minimum, instance.bounds.maximum)) continue;
        if (!CoverageEligible(bounds, receiver, eye, viewDistance)) continue;
        if (instance.placementEligible && instance.slot >= 0 && instance.slot < bounds.staticBounds.count
            && bounds.staticBounds[instance.slot].placement.valid)
        {
            // Actual triangles, rather than the filled instance AABB, decide
            // whether a block has nearby receiver geometry.
            GeometryHit hit = PlacementSurface(bounds.staticBounds[instance.slot].placement,
                instance.transform, center, radius);
            if (!hit.found) continue;
        }
        return true;
    }
    return false;
}

int CoverageProbeMask(WorldBounds bounds, float3 minimum, float size, float baseSpacing,
                      float3 eye, float viewDistance)
{
    float spacing = size * 0.5;
    if (spacing <= 0) return 0;
    // A logical node is useful only where its interpolation support overlaps a
    // receiver. Include the normal bias and the cross-block filter footprint.
    // One conservative instance query supplies all 27 bits for this node.
    float padding = baseSpacing * 0.3;
    float3 lower = minimum - float3(padding);
    float3 upper = minimum + float3(size + padding);
    float3 center = minimum + float3(size * 0.5);
    var candidates = CaptureCandidates(bounds.scene, center, size * 0.9 + padding * 1.733);
    mut int mask = 0;
    foreach (var index in candidates)
    {
        if (index < 0 || index >= bounds.instances.count) continue;
        LocalBounds receiver = bounds.instances[index].bounds;
        if (!receiver.valid || !BoxesOverlap(lower, upper, receiver.minimum, receiver.maximum)) continue;
        LocalBounds support = LocalBounds { valid = true,
            minimum = Math.Max(lower, receiver.minimum), maximum = Math.Min(upper, receiver.maximum) };
        if (!CoverageEligible(bounds, support, eye, viewDistance)) continue;
        float3 lo = Math.Clamp((receiver.minimum - float3(padding) - minimum) / spacing, float3(0), float3(2));
        float3 hi = Math.Clamp((receiver.maximum + float3(padding) - minimum) / spacing, float3(0), float3(2));
        int3 first = int3(Math.Floor(lo));
        int3 last = int3(Math.Ceil(hi));
        for (var z = first.z; z <= last.z; z++)
            for (var y = first.y; y <= last.y; y++)
                for (var x = first.x; x <= last.x; x++) mask |= 1 << (x + 3 * y + 9 * z);
        if (mask == 134217727) return mask;
    }
    return mask;
}

float CoveragePriority(WorldBounds bounds, float3 minimum, float size, float3 eye,
                       float3 forward, float minimumSize, float viewDistance)
{
    float padding = minimumSize * 0.15;
    float3 maximum = minimum + float3(size);
    float3 lower = minimum - float3(padding);
    float3 upper = maximum + float3(padding);
    float3 center = minimum + float3(size * 0.5);
    var candidates = CaptureCandidates(bounds.scene, center, size * 0.9 + padding);
    mut bool found = false;
    mut double nearest = 1e300d;
    mut float facing = 0;
    foreach (var index in candidates)
    {
        if (index < 0 || index >= bounds.instances.count) continue;
        LocalBounds receiver = bounds.instances[index].bounds;
        if (!receiver.valid) continue;
        float3 receiverMin = Math.Max(lower, receiver.minimum);
        float3 receiverMax = Math.Min(upper, receiver.maximum);
        if (receiverMin.x > receiverMax.x || receiverMin.y > receiverMax.y || receiverMin.z > receiverMax.z) continue;
        if (!CoverageEligible(bounds, LocalBounds { valid = true, minimum = receiverMin, maximum = receiverMax }, eye, viewDistance)) continue;
        float3 closest = Math.Clamp(eye, receiverMin, receiverMax);
        double distanceSq = Math.LengthSq(double3(closest) - double3(eye));
        float3 support = Math.Clamp(eye + forward * minimumSize, receiverMin, receiverMax);
        double3 delta = double3(support) - double3(eye);
        double supportDistance = Math.Sqrt(Math.LengthSq(delta));
        float alignment = supportDistance > 0d ? float(Math.Dot(delta / supportDistance, double3(forward))) : 1;
        float visible = Math.Clamp(alignment, 0, 1);
        if (!found || distanceSq < nearest || (distanceSq == nearest && visible > facing))
        {
            found = true;
            nearest = distanceSq;
            facing = visible;
        }
    }
    if (!found)
    {
        float3 closest = Math.Clamp(eye, minimum, maximum);
        nearest = Math.LengthSq(double3(closest) - double3(eye));
        float3 support = Math.Clamp(eye + forward * minimumSize, minimum, maximum);
        double3 delta = double3(support) - double3(eye);
        double supportDistance = Math.Sqrt(Math.LengthSq(delta));
        facing = supportDistance > 0d ? Math.Clamp(float(Math.Dot(delta / supportDistance, double3(forward))), 0, 1) : 1;
    }
    // Empty space in a large cell is not nearby receiver support. Measure the
    // closest geometry intersection, so a distant building cannot claim the
    // camera's detail budget just because its containing cell reaches the view.
    // Nested receiver intersections preserve parent/child distance ordering;
    // the linear size and bounded 1..2 facing bonus keep importance monotone.
    double denominator = Math.Sqrt(nearest) + double(minimumSize) * 0.25d;
    float front = facing * facing;
    return float(double(size) / (denominator * denominator)) * (1 + front * front);
}

int CountCoverageProbes(List<CoverageNode> nodes, List<CoverageNode> replacement,
                        int replaceIndex, int maxProbes)
{
    // Neighboring bricks share physical captures wherever their dyadic anchors
    // coincide. Count the proposed leaf set, not 27 private records per brick.
    mut Map<int, int> heads = default;
    mut List<PlacementWeld> positions = default;
    for (var source = 0; source < 2; source++)
    {
        int count = source == 0 ? nodes.count : replacement.count;
        for (var index = 0; index < count; index++)
        {
            if (source == 0 && index == replaceIndex) continue;
            CoverageNode node = source == 0 ? nodes[index] : replacement[index];
            if (!node.relevant || node.children >= 0) continue;
            for (var probe = 0; probe < 27; probe++)
            {
                if ((node.probeMask & (1 << probe)) == 0) continue;
                float3 position = node.minimum
                    + float3(probe % 3, (probe / 3) % 3, probe / 9) * (node.size * 0.5);
                int shared = PlacementWeldIndex(heads, positions, position, 0);
                if (shared >= maxProbes) return positions.count;
            }
        }
    }
    return positions.count;
}

float StableProbeSpacing(float3 eye, float requested)
{
    mut double spacing = double(Math.Clamp(requested, 0.1, 1000));
    if (!FiniteBoundsValue(eye)) return float(spacing);
    double precision = Math.Cmax(Math.Abs(double3(eye))) * 1e-6d;
    // Keep one world-anchored phase while the view moves. A continuously
    // varying precision floor makes eye / spacing constant at large positions,
    // preventing cell-based streaming and invalidating every retained capture.
    for (var attempt = 0; attempt < 112; attempt++)
    {
        if (spacing >= precision) return float(spacing);
        spacing *= 2d;
    }
    return float(spacing);
}

bool CoverageAhead(List<CoverageNode> nodes, int a, int b, bool minimum)
{
    return (minimum ? nodes[a].priority < nodes[b].priority : nodes[a].priority > nodes[b].priority)
        || (nodes[a].priority == nodes[b].priority && a < b);
}

void QueueCoverage(mut List<int> queue, List<CoverageNode> nodes, int index, bool minimum = false)
{
    mut int at = queue.count;
    queue.Add(index);
    while (at > 0)
    {
        int parent = (at - 1) / 2;
        if (!CoverageAhead(nodes, index, queue[parent], minimum)) break;
        queue[at] = queue[parent];
        at = parent;
    }
    queue[at] = index;
}

int PopCoverage(mut List<int> queue, List<CoverageNode> nodes, bool minimum = false)
{
    if (queue.count <= 0) return -1;
    int result = queue[0];
    int last = queue[queue.count - 1];
    queue.RemoveAt(queue.count - 1);
    if (queue.count == 0) return result;
    mut int at = 0;
    while (at * 2 + 1 < queue.count)
    {
        mut int child = at * 2 + 1;
        if (child + 1 < queue.count && CoverageAhead(nodes, queue[child + 1], queue[child], minimum)) child++;
        if (!CoverageAhead(nodes, queue[child], last, minimum)) break;
        queue[at] = queue[child];
        at = child;
    }
    queue[at] = last;
    return result;
}

int MergeableCoverageChildren(List<CoverageNode> nodes, int index)
{
    if (index < 0 || index >= nodes.count) return 0;
    CoverageNode node = nodes[index];
    if (!node.relevant || node.children < 0 || node.children > nodes.count - 8) return 0;
    mut int count = 0;
    for (var child = 0; child < 8; child++)
    {
        CoverageNode entry = nodes[node.children + child];
        if (!entry.relevant) continue;
        if (entry.children >= 0) return 0;
        count++;
    }
    return count;
}

void CopyCoverageNode(List<CoverageNode> source, mut List<CoverageNode> destination,
                      int sourceIndex, int destinationIndex, int depth)
{
    if (sourceIndex < 0 || sourceIndex >= source.count
        || destinationIndex < 0 || destinationIndex >= destination.count) return;
    mut CoverageNode node = source[sourceIndex];
    node.slot = -1;
    if (!node.relevant || node.children < 0 || depth >= 24)
    {
        node.children = -1;
        destination[destinationIndex] = node;
        return;
    }
    int first = node.children;
    node.children = destination.count;
    destination[destinationIndex] = node;
    for (var child = 0; child < 8; child++) destination.Add(default);
    for (var child = 0; child < 8; child++)
        CopyCoverageNode(source, destination, first + child, node.children + child, depth + 1);
}

void BuildCoverage(mut WorldBounds bounds, Settings settings, Render3D.Camera camera, float aspect)
{
    float3 eye = camera.position;
    float3 forward = Math.Rotate(Math.Normalize(camera.rotation), float3(0, 0, 1));
    bounds.nodes.Clear();
    bounds.lookup.Clear();
    bounds.ready = false;
    if (bounds.instances.count == 0 || !FiniteBoundsValue(eye))
    {
        bounds.layout = default;
        bounds.topologyRevision++;
        return;
    }
    float spacing = StableProbeSpacing(eye, settings.probeSpacing);
    float minimumSize = spacing * 2;
    bounds.coverageView = MakeCoverageView(camera, aspect, minimumSize * 2);
    LocalBounds receivers = CoverageReceiverBounds(bounds, eye, settings.viewDistance);
    if (!receivers.valid)
    {
        bounds.layout = default;
        bounds.topologyRevision++;
        return;
    }
    mut float size = minimumSize * 128;
    mut int depth = 7;
    mut float3 root = float3(0);
    for (var attempt = 0; attempt < 18; attempt++)
    {
        root = Math.Floor(eye / (size * 0.25)) * (size * 0.25)
            - float3(size * 0.5) + float3(spacing * 0.5);
        if (receivers.minimum.x >= root.x + spacing && receivers.minimum.y >= root.y + spacing
            && receivers.minimum.z >= root.z + spacing && receivers.maximum.x <= root.x + size - spacing
            && receivers.maximum.y <= root.y + size - spacing && receivers.maximum.z <= root.z + size - spacing) break;
        if (depth >= 24) break;
        size *= 2;
        depth++;
    }
    // Every subdivision keeps the same half-base-cell phase. This avoids
    // probes coinciding with common integer wall/floor planes, including
    // thin-wall edges whose tangential captures can see around the occluder.
    float viewDistance = settings.viewDistance;
    if (!FiniteBoundsValue(root) || !FiniteBoundsValue(root + float3(size)) || size <= 0)
    {
        bounds.layout = default;
        bounds.topologyRevision++;
        return;
    }
    // Only eligible receiver assets need triangle caches. An off-camera scene
    // cannot enlarge the field or consume its probe budget merely by existing.
    for (var i = 0; i < bounds.instances.count; i++)
    {
        if (i < 0 || i >= bounds.instances.count) continue;
        SceneInstance instance = bounds.instances[i];
        if (!instance.placementEligible || !CoverageEligible(bounds, instance.bounds, eye, viewDistance)) continue;
        int slot = instance.slot;
        if (slot < 0 || slot >= bounds.staticBounds.count || bounds.staticBounds[slot].placementReady) continue;
        mut StaticBounds cached = bounds.staticBounds[slot];
        cached.placement = BuildPlacementMesh(cached.mesh.Value);
        cached.placementReady = true;
        bounds.staticBounds[slot] = cached;
    }
    // Cover the normal bias (.04 spacing) and boundary filter (.25 spacing),
    // so receivers do not fade just because geometry lies near a leaf face.
    bool relevant = UsefulCoverage(bounds, root, size, eye, viewDistance, spacing * 0.3);
    bounds.nodes.Add(CoverageNode {
        minimum = root, size = size, relevant = relevant,
        priority = relevant ? CoveragePriority(bounds, root, size, eye, forward, minimumSize, viewDistance) : 0,
        probeMask = relevant ? CoverageProbeMask(bounds, root, size, spacing, eye, viewDistance) : 0
    });
    mut int leaves = relevant ? 1 : 0;
    int budget = Math.Clamp(settings.maxProbes, 125, 2048);
    int limit = 128;
    int maxNodes = 576 * 64 - limit * 28;
    mut List<int> pending = [];
    if (relevant) QueueCoverage(pending, bounds.nodes, 0);
    // Plan the useful receiver geometry before applying the physical budget.
    // Fitting one split at a time can deadlock: eight coarse neighboring bricks
    // share 125 anchors, but shrinking just one temporarily needs more anchors
    // even when refining all eight together still fits the same 125 probes.
    // The heap spends the bounded planning table on the most important regions
    // first if the requested detail cannot fit even the CPU planning budget.
    for (var iteration = 0; iteration < 4096; iteration++)
    {
        if (pending.count == 0 || bounds.nodes.count > maxNodes - 8) break;
        int best = PopCoverage(pending, bounds.nodes);
        if (best < 0) break;
        CoverageNode node = bounds.nodes[best];
        // Visible distant receivers need coarse support, not a full base-detail
        // plan which would immediately be discarded by the budget merge pass.
        // A cell touching the nearby radius keeps the original finest target.
        LocalBounds cell = LocalBounds { valid = true,
            minimum = node.minimum, maximum = node.minimum + float3(node.size) };
        double distance = Math.Sqrt(BoundsDistanceSq(cell, eye));
        double detailRadius = Math.Max(double(viewDistance), double(minimumSize));
        double targetSize = double(minimumSize) * Math.Max(1d, distance / detailRadius);
        if (!node.relevant || double(node.size) <= targetSize * 1.001d || node.depth >= depth) continue;
        float half = node.size * 0.5;
        mut List<CoverageNode> children = [];
        mut int count = 0;
        for (var child = 0; child < 8; child++)
        {
            float3 lower = node.minimum + float3(child % 2, (child / 2) % 2, child / 4) * half;
            bool useful = UsefulCoverage(bounds, lower, half, eye, viewDistance, spacing * 0.3);
            children.Add(CoverageNode {
                minimum = lower, size = half, depth = node.depth + 1, relevant = useful,
                priority = useful ? CoveragePriority(bounds, lower, half, eye, forward, minimumSize, viewDistance) : 0,
                probeMask = useful ? CoverageProbeMask(bounds, lower, half, spacing, eye, viewDistance) : 0
            });
            if (useful) count++;
        }
        if (count == 0)
        {
            bounds.nodes[best].relevant = false;
            leaves--;
            continue;
        }
        int first = bounds.nodes.count;
        bounds.nodes[best].children = first;
        foreach (var child in children) bounds.nodes.Add(child);
        for (var child = 0; child < 8; child++)
            if (children[child].relevant) QueueCoverage(pending, bounds.nodes, first + child);
        leaves += count - 1;
    }
    // Cull any parent whose padded receiver candidates vanished at finer detail.
    // Node indices increase down the tree, so one reverse pass propagates this.
    for (var index = bounds.nodes.count - 1; index >= 0; index--)
    {
        CoverageNode node = bounds.nodes[index];
        if (!node.relevant || node.children < 0) continue;
        mut bool any = false;
        for (var child = 0; child < 8; child++)
            any = any || bounds.nodes[node.children + child].relevant;
        if (!any) bounds.nodes[index].relevant = false;
    }
    mut List<int> parents = [];
    parents.Resize(bounds.nodes.count);
    for (var index = 0; index < parents.count; index++) parents[index] = -1;
    mut List<int> multiple = [];
    mut List<int> single = [];
    for (var index = 0; index < bounds.nodes.count; index++)
    {
        CoverageNode node = bounds.nodes[index];
        if (node.children >= 0)
            for (var child = 0; child < 8; child++) parents[node.children + child] = index;
        int count = MergeableCoverageChildren(bounds.nodes, index);
        if (count > 1) QueueCoverage(multiple, bounds.nodes, index, true);
        else if (count == 1) QueueCoverage(single, bounds.nodes, index, true);
    }
    mut int probes = CountCoverageProbes(bounds.nodes, [], -1, budget);
    // Coarsening whole sibling groups lets neighboring regions reach a useful
    // shared resolution before the budget is checked. Every merge removes at
    // least one internal node, so even non-monotonic unique counts eventually
    // reach the root's 27-probe fallback within the bounded plan.
    // Compare both min-heaps by importance. Cheap distant single-child paths
    // must be allowed to collapse before expensive nearby sibling groups.
    for (var iteration = 0; iteration < 32768 && (probes > budget || leaves > limit); iteration++)
    {
        mut int best = -1;
        mut int bestCount = 0;
        while (best < 0 && (multiple.count > 0 || single.count > 0))
        {
            bool group = multiple.count > 0 && (single.count == 0
                || CoverageAhead(bounds.nodes, multiple[0], single[0], true));
            int candidate = group ? PopCoverage(multiple, bounds.nodes, true) : PopCoverage(single, bounds.nodes, true);
            int count = MergeableCoverageChildren(bounds.nodes, candidate);
            if (count <= 0) continue;
            if (group && count == 1) { QueueCoverage(single, bounds.nodes, candidate, true); continue; }
            if (!group && count > 1) { QueueCoverage(multiple, bounds.nodes, candidate, true); continue; }
            best = candidate;
            bestCount = count;
        }
        if (best < 0) break;
        int first = bounds.nodes[best].children;
        for (var child = 0; child < 8; child++) bounds.nodes[first + child].relevant = false;
        bounds.nodes[best].children = -1;
        leaves -= bestCount - 1;
        int parent = parents[best];
        int count = MergeableCoverageChildren(bounds.nodes, parent);
        if (count > 1) QueueCoverage(multiple, bounds.nodes, parent, true);
        else if (count == 1) QueueCoverage(single, bounds.nodes, parent, true);
        probes = CountCoverageProbes(bounds.nodes, [], -1, budget);
    }
    // The complete plan is temporary. Keep only the budgeted reachable tree so
    // atlas uploads, stable-slot reconciliation and later lookups stay small.
    mut List<CoverageNode> compact = [];
    compact.Add(default);
    CopyCoverageNode(bounds.nodes, compact, 0, 0, 0);
    bounds.nodes = compact;
    int total = budget;
    bounds.layout = FieldLayout {
        sparse = true, minimum = root, size = size, spacing = spacing,
        counts = int3(3), total = total, atlasRows = (total + 31) / 32,
        far = settings.captureDistance, nodeCount = bounds.nodes.count, depthLimit = depth
    };
    bounds.lookup.Resize(bounds.nodes.count);
    for (var i = 0; i < bounds.nodes.count; i++)
        bounds.lookup[i] = bounds.nodes[i].children >= 0 ? bounds.nodes[i].children + 256 : 0;
    bounds.ready = leaves > 0;
    bounds.topologyRevision++;
}

int FindBlock(WorldBounds bounds, float3 position)
{
    if (!bounds.ready || bounds.nodes.count == 0) return -1;
    mut int at = 0;
    for (var depth = 0; depth <= bounds.layout.depthLimit && depth <= 24; depth++)
    {
        if (at < 0 || at >= bounds.nodes.count) return -1;
        CoverageNode node = bounds.nodes[at];
        if (!node.relevant || position.x < node.minimum.x || position.y < node.minimum.y || position.z < node.minimum.z
            || position.x > node.minimum.x + node.size || position.y > node.minimum.y + node.size
            || position.z > node.minimum.z + node.size) return -1;
        if (node.children < 0) return node.slot;
        float3 middle = node.minimum + float3(node.size * 0.5);
        at = node.children + (position.x >= middle.x ? 1 : 0)
            + (position.y >= middle.y ? 2 : 0) + (position.z >= middle.z ? 4 : 0);
    }
    return -1;
}

[After(Render3D.Stages.Prepare), Before(Render3D.Stages.Lights)]
view CollectWorldBounds(mut WorldBounds bounds, Environment environment, Render3D.Renderer renderer,
    World world, query (Render3D.MeshRenderer mesh, Render3D.Material material) meshes,
    query (Render3D.SkinnedMeshRenderer mesh, Render3D.Material material) skins)
{
    Settings settings = ClampSettings(environment.settings);
    if (!renderer.enabled || !settings.enabled)
    {
        ClearWorldBounds(bounds);
        return;
    }
    long generation = GIAssetGeneration();
    if (bounds.generation != generation)
    {
        ClearWorldBounds(bounds);
        bounds.generation = generation;
    }
    // Retain stable entity-to-asset lookups for large live scenes while still
    // bounding stale entries from spawn churn and invalid visible assets.
    int slotLimit = Math.Max(4096, Math.Min(bounds.geometryCount, 1000000000) * 2);
    if (bounds.staticSlots.count > slotLimit) bounds.staticSlots.Clear();
    if (bounds.skinnedSlots.count > slotLimit) bounds.skinnedSlots.Clear();
    bounds.changes.Clear();
    bounds.shadowChanges.Clear();
    bounds.geometryChanged = false;
    for (var i = 0; i < bounds.instances.count; i++) bounds.instances[i].seen = false;
    mut LocalBounds observed = default;
    foreach (var object in meshes)
    {
        if (!object.mesh.visible) continue;
        LocalBounds local = StaticLocalBounds(bounds, object.entity, object.mesh.mesh);
        float4x4 transform = world.LocalToWorld(object.entity);
        int previous = ExistingInstance(bounds, object.entity);
        bool sameGeometry = previous >= 0 && !bounds.instances[previous].skinned
            && bounds.instances[previous].mesh == object.mesh.mesh
            && SameTransform(bounds.instances[previous].transform, transform);
        LocalBounds placed = sameGeometry ? bounds.instances[previous].bounds : TransformBounds(local, transform);
        if (!placed.valid) continue;
        int slot = bounds.staticSlots[object.entity] - 1;
        StoreInstance(bounds, SceneInstance {
            entity = object.entity, mesh = object.mesh.mesh, material = CaptureMaterialOf(object.material),
            castShadows = object.mesh.castShadows && object.material.mode != SurfaceMode.Transparent,

            transform = transform, bounds = placed, slot = slot,
            placementEligible = object.material.mode == Render3D.SurfaceMode.Opaque
                && !object.material.doubleSided && object.material.vertex == null
        }, previous);
        observed = JoinBounds(observed, placed);
    }
    foreach (var object in skins)
    {
        if (!object.mesh.visible) continue;
        LocalBounds local = SkinnedLocalBounds(bounds, object.entity, object.mesh.mesh);
        float4x4 transform = world.LocalToWorld(object.entity);
        int previous = ExistingInstance(bounds, object.entity, true);
        bool sameGeometry = previous >= 0 && bounds.instances[previous].skinned
            && bounds.instances[previous].skin == object.mesh.mesh
            && SameTransform(bounds.instances[previous].transform, transform);
        LocalBounds placed = sameGeometry ? bounds.instances[previous].bounds : TransformBounds(local, transform);
        if (!placed.valid) continue;
        StoreInstance(bounds, SceneInstance {
            entity = object.entity, skinned = true, skin = object.mesh.mesh,
            material = CaptureMaterialOf(object.material),
            castShadows = object.mesh.castShadows && object.material.mode != SurfaceMode.Transparent,

            transform = transform, bounds = placed, slot = bounds.skinnedSlots[object.entity] - 1
        }, previous);
        observed = JoinBounds(observed, placed);
    }
    // Compact disappeared instances and rebuild their bounded identity index.
    // Stable scene order is retained for unchanged entities.
    mut bool removed = false;
    for (var i = bounds.instances.count - 1; i >= 0; i--)
    {
        if (bounds.instances[i].seen) continue;
        bounds.changes.Add(bounds.instances[i].bounds);
        if (bounds.instances[i].castShadows) bounds.shadowChanges.Add(ShadowRegion(bounds.instances[i]));
        bounds.instances.RemoveAt(i);
        removed = true;
    }
    if (removed)
    {
        bounds.geometryChanged = true;
        bounds.instanceSlots.Clear();
        bounds.skinInstanceSlots.Clear();
        for (var i = 0; i < bounds.instances.count; i++)
        {
            if (bounds.instances[i].skinned) bounds.skinInstanceSlots[bounds.instances[i].entity] = i + 1;
            else bounds.instanceSlots[bounds.instances[i].entity] = i + 1;
        }
    }
    if (bounds.changes.count > 0) bounds.revision++;
    if (bounds.geometryChanged) bounds.geometryRevision++;
    if (bounds.sceneRevision != bounds.geometryRevision)
    {
        bounds.scene = BuildSceneIndex(bounds);
        bounds.sceneRevision = bounds.geometryRevision;
    }
    bounds.geometryCount = bounds.instances.count;
    bounds.minimum = observed.valid ? observed.minimum : float3(0);
    bounds.maximum = observed.valid ? observed.maximum : float3(0);
    float3 eye = renderer.camera.position;
    float precisionSpacing = StableProbeSpacing(eye, settings.probeSpacing);
    float3 viewCell = Math.Floor(eye / (precisionSpacing * 2));
    quaternion rotation = Math.Normalize(renderer.camera.rotation);
    float3 forward = Math.Rotate(rotation, float3(0, 0, 1));
    float aspect = Math.Max(Screen.width, 1) / Math.Max(Screen.height, 1);
    bool changed = !bounds.ready || !FiniteBoundsValue(eye) || bounds.geometryChanged
        || bounds.layout.spacing != precisionSpacing || bounds.requestedSpacing != settings.probeSpacing
        || bounds.requestedMaxProbes != settings.maxProbes || bounds.requestedViewDistance != settings.viewDistance
        || bounds.requestedCaptureDistance != settings.captureDistance
        || bounds.requestedFov != renderer.camera.verticalFov || bounds.requestedNear != renderer.camera.near
        || bounds.requestedFar != renderer.camera.far || bounds.requestedAspect != aspect
        || Math.LengthSq(viewCell - bounds.viewCell) > 0
        || Math.Abs(Math.Dot(rotation.value, bounds.viewRotation.value)) < 0.9961947;
    if (!changed) return;
    bounds.requestedSpacing = settings.probeSpacing;
    bounds.requestedMaxProbes = settings.maxProbes;
    bounds.requestedViewDistance = settings.viewDistance;
    bounds.requestedCaptureDistance = settings.captureDistance;
    bounds.viewCell = viewCell;
    bounds.viewDirection = forward;
    bounds.viewRotation = rotation;
    bounds.requestedFov = renderer.camera.verticalFov;
    bounds.requestedNear = renderer.camera.near;
    bounds.requestedFar = renderer.camera.far;
    bounds.requestedAspect = aspect;
    BuildCoverage(bounds, settings, renderer.camera, aspect);
}
