using Render3D;
namespace GlobalIllumination;

float3 FaceVector(int face, float2 uv)
{
    float2 p = uv * 2 - float2(1);
    if (face == 0) return float3(1, -p.y, -p.x);
    if (face == 1) return float3(-1, -p.y, p.x);
    if (face == 2) return float3(p.x, 1, p.y);
    if (face == 3) return float3(p.x, -1, -p.y);
    if (face == 4) return float3(p.x, -p.y, 1);
    return float3(-p.x, -p.y, -1);
}

float3 FaceDirection(int face, float2 uv)
{
    return Math.Normalize(FaceVector(face, uv));
}

// Octahedral borders reflect into the opposite edge. Each probe has its own
// one-texel gutter, so bilinear reads never mix neighboring probe records.
float2 WrapOct(float2 uv)
{
    mut float2 result = uv;
    if (result.x < 0) result = float2(-result.x, 1 - result.y);
    else if (result.x > 1) result = float2(2 - result.x, 1 - result.y);
    if (result.y < 0) result = float2(1 - result.x, -result.y);
    else if (result.y > 1) result = float2(1 - result.x, 2 - result.y);
    return result;
}

float3 OctVector(float2 uv)
{
    float2 p = WrapOct(uv) * 2 - float2(1);
    mut float3 direction = float3(p, 1 - Math.Abs(p.x) - Math.Abs(p.y));
    if (direction.z < 0)
        direction = float3((1 - Math.Abs(p.y)) * (p.x >= 0 ? 1 : -1),
                           (1 - Math.Abs(p.x)) * (p.y >= 0 ? 1 : -1), direction.z);
    return direction;
}

float3 OctDirection(float2 uv)
{
    return Math.Normalize(OctVector(uv));
}

float2 OctUV(float3 direction)
{
    float3 n = Math.Normalize(direction);
    float scale = Math.Abs(n.x) + Math.Abs(n.y) + Math.Abs(n.z);
    if (scale <= 0) return float2(0.5);
    float3 p = n / scale;
    float2 folded = p.z >= 0 ? p.xy
        : float2((1 - Math.Abs(p.y)) * (p.x >= 0 ? 1 : -1),
                 (1 - Math.Abs(p.x)) * (p.y >= 0 ? 1 : -1));
    return folded * 0.5 + float2(0.5);
}

int AtlasHeight(int rows)
{
    // The last 64 rows hold sparse lookup codes, outside every probe gutter.
    return rows * 19 + 64;
}

float2 AtlasUV(int probe, int rows, float3 direction)
{
    float2 tile = float2(probe % 32, probe / 32) * float2(18, 19);
    return (tile + float2(1) + OctUV(direction) * 16) / float2(576, AtlasHeight(rows));
}

// A separate row keeps position metadata outside the octahedral filter gutter.
// Offsets are relative to the stable lattice anchor, in units of spacing.
Color ProbeMetadata(Texture distance, int probe, int rows)
{
    float2 pixel = float2(probe % 32, probe / 32) * float2(18, 19) + float2(0.5, 18.5);
    // Pixel-center reads share the moment sampler, including its filter, so
    // fully mapped skinned materials still use only two GI texture bindings.
    return distance.Sample(pixel / float2(576, AtlasHeight(rows)), Filter.Bilinear, Wrap.Clamp);
}

float3 ProbeOffset(Texture distance, int probe, int rows)
{
    Color value = ProbeMetadata(distance, probe, rows);
    // 128/255 represents zero exactly on the Rgba8 fallback as well.
    return float3(value.r, value.g, value.b) - float3(128.0 / 255.0);
}

struct SampleBrick
{
    int slot = -1;
    float3 minimum;
    float size;
    int transitions = 63;
}

Color LookupData(Texture distance, int rows, int address)
{
    if (address < 0 || address >= 576 * 64) return Color(0, 0, 0, 1);
    float2 pixel = float2(address % 576, rows * 19 + address / 576) + float2(0.5);
    return distance.Sample(pixel / float2(576, AtlasHeight(rows)), Filter.Bilinear, Wrap.Clamp);
}

int DecodeLookupCode(Color packed)
{
    return int(Math.Floor(packed.r * 255 + 0.5)) + int(Math.Floor(packed.g * 255 + 0.5)) * 256;
}

int DecodeLookupMask(Color packed)
{
    return DecodeLookupCode(packed) + int(Math.Floor(packed.b * 255 + 0.5)) * 65536;
}

int LookupCode(Texture distance, int rows, int address)
{
    return DecodeLookupCode(LookupData(distance, rows, address));
}

SampleBrick LookupBrick(Texture distance, FieldLayout layout, float3 position)
{
    SampleBrick missing = SampleBrick { slot = -1, transitions = 63 };
    if (layout.nodeCount <= 0 || layout.size <= 0
        || position.x < layout.minimum.x || position.y < layout.minimum.y || position.z < layout.minimum.z
        || position.x > layout.minimum.x + layout.size || position.y > layout.minimum.y + layout.size
        || position.z > layout.minimum.z + layout.size) return missing;
    mut float3 minimum = layout.minimum;
    mut float size = layout.size;
    mut int address = 0;
    // Read the root and at most depthLimit descendants. The CPU and shader
    // both bound lookup depth; a malformed child can never escape the strip.
    int end = Math.Clamp(layout.depthLimit, 0, 24);
    for (var depth = 0; depth <= end; depth++)
    {
        if (address < 0 || address >= layout.nodeCount || address >= 576 * 64) return missing;
        Color packed = LookupData(distance, layout.atlasRows, address);
        int code = DecodeLookupCode(packed);
        if (code <= 0)
        {
            // Keep the known empty domain so nearby filter corners can reuse
            // the miss without repeating the same serial tree traversal.
            if (code == 0) return SampleBrick { slot = -1, minimum = minimum, size = size, transitions = 63 };
            return missing;
        }
        if (code <= 128)
        {
            int slot = code - 1;
            if (layout.nodeCount + slot * 28 + 27 >= 576 * 64) return missing;
            return SampleBrick { slot = slot, minimum = minimum, size = size,
                transitions = int(Math.Floor(packed.b * 255 + 0.5)) };
        }
        if (code < 256 || depth == end) return missing;
        int first = code - 256;
        if (first < 0 || first > layout.nodeCount - 8) return missing;
        size *= 0.5;
        float3 middle = minimum + float3(size);
        int x = position.x >= middle.x ? 1 : 0;
        int y = position.y >= middle.y ? 1 : 0;
        int z = position.z >= middle.z ? 1 : 0;
        minimum += float3(x, y, z) * size;
        address = first + x + y * 2 + z * 4;
    }
    return missing;
}

float3 CaptureLight(Texture light0, Texture light1, Texture light2,
                      Texture light3, Texture light4, Texture light5, int face, float2 uv)
{
    mut Color light = Color.black;
    if (face == 0) light = light0.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 1) light = light1.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 2) light = light2.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 3) light = light3.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 4) light = light4.Sample(uv, Filter.Point, Wrap.Clamp);
    else light = light5.Sample(uv, Filter.Point, Wrap.Clamp);
    return ClampHdr(float3(light.r, light.g, light.b));
}

Color CaptureData(Texture data0, Texture data1, Texture data2,
                   Texture data3, Texture data4, Texture data5, int face, float2 uv)
{
    mut Color data = Color.black;
    if (face == 0) data = data0.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 1) data = data1.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 2) data = data2.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 3) data = data3.Sample(uv, Filter.Point, Wrap.Clamp);
    else if (face == 4) data = data4.Sample(uv, Filter.Point, Wrap.Clamp);
    else data = data5.Sample(uv, Filter.Point, Wrap.Clamp);
    return data;
}

// One means unsupported. A valid hit is inside the radial far sphere, so its
// normalized axial distance is strictly below one on every cube face.
float CaptureAxialDepth(Color record, int face, float2 uv)
{
    if (record.a <= 0.25) return 1;
    float3 ray = FaceVector(face, uv);
    float3 normal = OctDirection(float2(record.g, record.b));
    float denominator = Math.Dot(normal, ray);
    // The stored normal points from the eye towards the physical plane.
    // An ideal ray across its grazing boundary must not hit behind the eye.
    if (denominator <= 0.000001
        || record.r * record.r * Math.Dot(ray, ray) >= denominator * denominator) return 1;
    return record.r / denominator;
}

frag PackRays(Vertex vertex, out Color light, out Color data, Environment environment)
{
    int face = Math.Clamp(int(Math.Floor(vertex.uv.y * 6)), 0, 5);
    int sample = Math.Clamp(int(Math.Floor(vertex.uv.x * 64)), 0, 63);
    int y = sample / 8;
    int x = sample % 8;
    int px = x < 4 ? 2 + x * 4 : 17 + (x - 4) * 4;
    int py = y < 4 ? 2 + y * 4 : 17 + (y - 4) * 4;
    float2 uv = (float2(px, py) + float2(0.5)) / 32;
    float2 plane = uv * 2 - float2(1);
    float lengthSq = 1 + Math.Dot(plane, plane);
    float solidAngle = 1 / (lengthSq * Math.Sqrt(lengthSq));
    float3 ray = FaceDirection(face, uv);
    float3 radiance = CaptureLight(environment.light0, environment.light1, environment.light2,
        environment.light3, environment.light4, environment.light5, face, uv);
    Color hit = CaptureData(environment.data0, environment.data1, environment.data2,
        environment.data3, environment.data4, environment.data5, face, uv);
    // A cube's axial far planes include corners outside the radial capture
    // range. Intersect the captured plane with the ideal pixel ray, rather
    // than keeping their light or treating them as nearby back-face geometry.
    bool beyond = hit.a > 0.25 && CaptureAxialDepth(hit, face, uv) >= 1;
    float back = hit.a > 0.25 && hit.a < 0.75 && !beyond ? 1 : 0;
    // Both images use ordinary color targets. Alpha retains front-face
    // validity in the first and solid angle in the second; Sample returns
    // their straight RGB values. Encode the ray so Rgba8 can keep its signs.
    light = Color(beyond ? float3(0) : radiance, 1 - back);
    data = Color(ray * 0.5 + float3(0.5), solidAngle);
}

struct FaceCoordinate { int face; float2 uv; }

FaceCoordinate FaceUV(float3 direction)
{
    float3 magnitude = Math.Abs(direction);
    mut int face = 0;
    mut float2 plane = float2(0);
    if (magnitude.x >= magnitude.y && magnitude.x >= magnitude.z)
    {
        float inverse = 1 / Math.Max(magnitude.x, 0.00001);
        face = direction.x >= 0 ? 0 : 1;
        plane = float2(direction.x >= 0 ? -direction.z : direction.z, -direction.y) * inverse;
    }
    else if (magnitude.y >= magnitude.z)
    {
        float inverse = 1 / Math.Max(magnitude.y, 0.00001);
        face = direction.y >= 0 ? 2 : 3;
        plane = float2(direction.x, direction.y >= 0 ? direction.z : -direction.z) * inverse;
    }
    else
    {
        float inverse = 1 / Math.Max(magnitude.z, 0.00001);
        face = direction.z >= 0 ? 4 : 5;
        plane = float2(direction.z >= 0 ? direction.x : -direction.x, -direction.y) * inverse;
    }
    return FaceCoordinate { face = face, uv = plane * 0.5 + float2(0.5) };
}

float CaptureInverseDepth(Texture data0, Texture data1, Texture data2,
                          Texture data3, Texture data4, Texture data5,
                          int face, float2 pixel, float spacing, float far)
{
    float2 uv = (pixel + float2(0.5)) / 32;
    Color data = CaptureData(data0, data1, data2, data3, data4, data5, face, uv);
    float axial = CaptureAxialDepth(data, face, uv);
    return axial < 1 ? spacing / Math.Max(axial * far, spacing * 0.001) : 0;
}

frag Convolve(Vertex vertex, out Color irradiance, out Color moments, Environment environment)
{
    float2 pixel = vertex.uv * float2(18, 19);
    if (pixel.y >= 18)
    {
        irradiance = Color.black;
        moments = Color(environment.captureOffset + float3(128.0 / 255.0), 1);
        return;
    }
    float3 direction = OctDirection((pixel - float2(1)) / 16);
    // Positive cosine quadrature avoids the extra lobes introduced by a
    // truncated signed SH reconstruction. The packed image retains radiance
    // and sidedness; fixed quadrature geometry is reconstructed analytically.
    mut float3 light = float3(0);
    mut float cosineWeight = 0;
    mut float sphereWeight = 0;
    mut float backfaces = 0;
    int rayCount = Math.Clamp(environment.rayCount, 1, 384);
    for (var sample = 0; sample < rayCount; sample++)
    {
        float2 uv = (float2(sample % 64, sample / 64) + float2(0.5)) / float2(64, 6);
        Color radiance = environment.rayLight.Sample(uv, Filter.Point, Wrap.Clamp);
        int face = sample / 64;
        int rayIndex = sample % 64;
        int x = rayIndex % 8;
        int y = rayIndex / 8;
        int px = x < 4 ? 2 + x * 4 : 17 + (x - 4) * 4;
        int py = y < 4 ? 2 + y * 4 : 17 + (y - 4) * 4;
        float2 captureUV = (float2(px, py) + float2(0.5)) / 32;
        float2 plane = captureUV * 2 - float2(1);
        float lengthSq = 1 + Math.Dot(plane, plane);
        float solidAngle = 1 / (lengthSq * Math.Sqrt(lengthSq));
        // unitRay * solidAngle = FaceVector / lengthSq^2. This avoids a
        // second texture read and its FP16 geometry/unpremultiply rounding.
        float3 weightedRay = FaceVector(face, captureUV) / (lengthSq * lengthSq);
        float weight = Math.Max(Math.Dot(direction, weightedRay), 0);
        light += float3(radiance.r, radiance.g, radiance.b) * (weight * radiance.a);
        cosineWeight += weight;
        sphereWeight += solidAngle;
        backfaces += (1 - radiance.a) * solidAngle;
    }
    // Correct the discrete cosine kernel's small direction-dependent integral
    // error. Every ray remains in the denominator, including rejected backfaces:
    // this preserves PI*L for constant incoming light without restoring occlusion.
    light *= Math.PI / Math.Max(cosineWeight, 0.000001);
    float backfaceFraction = backfaces / Math.Max(sphereWeight, 0.000001);
    // Inverse axial cube depth is affine on a planar surface. Interpolate it
    // at the requested direction before converting to the octahedral metric;
    // point-sampled radial depth introduced false occlusion on smooth walls.
    FaceCoordinate tap = FaceUV(direction);
    float2 capturePixel = tap.uv * 32 - float2(0.5);
    float2 lower = Math.Clamp(Math.Floor(capturePixel), float2(0), float2(30));
    float2 fraction = capturePixel - lower;
    float a = CaptureInverseDepth(environment.data0, environment.data1, environment.data2,
        environment.data3, environment.data4, environment.data5, tap.face, lower,
        environment.captureSpacing, environment.captureFar);
    float b = CaptureInverseDepth(environment.data0, environment.data1, environment.data2,
        environment.data3, environment.data4, environment.data5, tap.face, lower + float2(1, 0),
        environment.captureSpacing, environment.captureFar);
    float c = CaptureInverseDepth(environment.data0, environment.data1, environment.data2,
        environment.data3, environment.data4, environment.data5, tap.face, lower + float2(0, 1),
        environment.captureSpacing, environment.captureFar);
    float d = CaptureInverseDepth(environment.data0, environment.data1, environment.data2,
        environment.data3, environment.data4, environment.data5, tap.face, lower + float2(1, 1),
        environment.captureSpacing, environment.captureFar);
    float axial = Math.Max(Math.Lerp(Math.Lerp(a, b, fraction.x), Math.Lerp(c, d, fraction.x), fraction.y), 0);
    float3 absolute = Math.Abs(direction);
    float inverse = axial * Math.Cmax(absolute) / (absolute.x + absolute.y + absolute.z);
    irradiance = Color(ClampHdr(light), 1);
    moments = Color(inverse, 0, Math.Clamp(backfaceFraction, 0, 1), 1);
}

float ProbeVisibility(float mean, float standardDeviation, float inverse, float tolerance = 0.01)
{
    // A small relative reconstruction margin covers quantized depth and the
    // smooth receiver plane's approximation to rasterized mesh facets.
    float difference = Math.Max(mean - inverse - Math.Max(mean * tolerance, 0.00001), 0);
    if (difference <= 0) return 1;
    float sigma = Math.Max(standardDeviation, Math.Max(mean * 0.001, 0.00001));
    float variance = sigma * sigma;
    float probability = variance / (variance + difference * difference);
    return probability;
}

float2 ReceiverTapVisibility(Color moments, float3 ray, float3 normal,
                              float planeDistance, float pointInverse, float spacing, float tolerance, float3 delta,
                              float metricSpacing = 0)
{
    float metric = metricSpacing > 0 ? metricSpacing : spacing;
    // Visibility belongs to the physical capture, independently of which
    // coarse/fine interpolation brick references that record.
    float planeWeight = Math.SmoothStep(metric * 0.0001, metric * 0.01, Math.Abs(planeDistance));
    float denominator = Math.Abs(planeDistance) >= metric * 0.0000001 ? planeDistance
        : planeDistance < 0 ? -metric * 0.0000001 : metric * 0.0000001;
    float expected = metric * Math.Dot(normal, ray) / denominator;
    mut float support = Math.Lerp(1, expected > 0 ? 1 : 0, planeWeight);
    // Grazing rays can meet the receiver plane far outside the actual surface
    // neighborhood. Prefer taps whose projected footprint stays near the pixel.
    float rayNormal = Math.Dot(normal, ray);
    float rayDenominator = Math.Abs(rayNormal) >= 0.000001 ? rayNormal : rayNormal < 0 ? -0.000001 : 0.000001;
    float3 projected = ray * ((planeDistance / metric) / rayDenominator);
    float footprint = Math.Min(Math.LengthSq(projected - delta / metric) * 4, 1000000);
    support *= Math.Lerp(1, 1 / (1 + footprint * footprint), planeWeight);
    float inverse = Math.Lerp(pointInverse, Math.Clamp(expected, 0, 1000), planeWeight);
    return float2(ProbeVisibility(moments.r, moments.g, inverse, tolerance) * support, support);
}

float2 ReceiverVisibility(Texture distance, int probe, int rows, float3 delta, float3 normal, float spacing, float tolerance,
                           float metricSpacing = 0)
{
    float metric = metricSpacing > 0 ? metricSpacing : spacing;
    float2 size = float2(576, AtlasHeight(rows));
    float2 tile = float2(probe % 32, probe / 32) * float2(18, 19);
    float2 pixel = AtlasUV(probe, rows, delta) * size - float2(0.5);
    float2 lower = Math.Floor(pixel);
    float2 fraction = pixel - lower;
    float2 center = lower + float2(0.5);
    float inverse = metric / Math.Max(Math.Abs(delta.x) + Math.Abs(delta.y) + Math.Abs(delta.z), metric * 0.001);
    float planeDistance = Math.Dot(normal, delta);
    mut float2 previous = float2(0);
    mut float2 top = float2(0);
    mut float2 filtered = float2(0);
    mut float back = 0;
    // A uniform bound avoids four expanded copies of the plane-projection path
    // in software drivers. Preserve the original row-wise bilinear evaluation.
    int end = Math.Min(rows + 3, 4);
    for (var sample = 0; sample < end; sample++)
    {
        int x = sample % 2;
        int y = sample / 2;
        float2 offset = float2(x, y);
        Color moments = distance.Sample((center + offset) / size, Filter.Bilinear, Wrap.Clamp);
        float2 uv = (center + offset - tile - float2(1)) / 16;
        float2 visibility = ReceiverTapVisibility(moments, OctVector(uv), normal, planeDistance, inverse, spacing, tolerance, delta, metric);
        if (sample == 0) back = moments.b;
        if (x == 0) previous = visibility;
        else
        {
            float2 row = Math.Lerp(previous, visibility, fraction.x);
            if (y == 0) top = row;
            else filtered = Math.Lerp(top, row, fraction.y);
        }
    }
    float probability = filtered.y > 0.0000001 ? filtered.x / filtered.y : 0;
    return float2(probability * probability * probability, back);
}

struct IrradianceBlend
{
    float3 light;
    float weight;
    float base;
    float available;
}

IrradianceBlend GatherSparseIrradiance(Texture irradiance, Texture distance, FieldLayout layout,
                               int initialized, float3 world, float3 n, float3 visibilityNormal, float3 grid, float tolerance,
                               int baseProbe = 0, float metricSpacing = 0, int coordinateStride = 1)
{
    float metric = metricSpacing > 0 ? metricSpacing : layout.spacing;
    int3 lower = Math.Min(int3(Math.Floor(grid)), layout.counts - int3(2));
    float3 fraction = grid - float3(lower);
    mut IrradianceBlend result = default;
    // The valid layout has at least eight nodes. A uniform loop bound keeps
    // software drivers from expanding eight complete receiver-PCF bodies.
    int end = Math.Min(layout.total, 8);
    for (var sample = 0; sample < end; sample++)
    {
        int x = sample % 2;
        int y = (sample / 2) % 2;
        int z = sample / 4;
        int3 coordinate = lower + int3(x, y, z);
        int3 lookupCoordinate = coordinate * coordinateStride;
        int logical = baseProbe + lookupCoordinate.x + 3 * (lookupCoordinate.y + 3 * lookupCoordinate.z);
        // Bricks share physical probe records at identical world anchors,
        // including anchors common to different subdivision levels.
        int probe = LookupCode(distance, layout.atlasRows, layout.nodeCount + logical) - 1;
        if (probe < 0 || probe >= layout.total || initialized <= 0) continue;
        float3 axis = float3(x == 0 ? 1 - fraction.x : fraction.x,
            y == 0 ? 1 - fraction.y : fraction.y, z == 0 ? 1 - fraction.z : fraction.z);
        float spatial = axis.x * axis.y * axis.z;
        if (spatial <= 0) continue;
        Color metadata = ProbeMetadata(distance, probe, layout.atlasRows);
        // Sparse slots initialize independently and can be reused. Their
        // metadata alpha replaces the dense field's initialized prefix.
        if (metadata.a < 0.5) continue;
        result.available += spatial;
        float3 offset = float3(metadata.r, metadata.g, metadata.b) - float3(128.0 / 255.0);
        float3 eye = layout.minimum + float3(coordinate) * layout.spacing + offset * metric;
        // Cell selection is biased; occlusion ends at the real surface.
        // Moving the visibility endpoint could cross a thin occluder.
        float3 delta = world - eye;
        float receiverDistance = Math.Length(delta);
        float alignment = Math.Clamp(Math.Dot(n, -delta) / Math.Max(receiverDistance, 0.000001), -1, 1);
        // This is a property of the physical capture, which may be shared by
        // coarse and fine bricks. Its near-eye regularization must not change
        // with the interpolation grid that happens to reference it.
        float radius = Math.Saturate(receiverDistance / (metric * 0.04));
        // Tangent probes have ill-conditioned plane projections. Their
        // small base weight retains dark support without visible arcs.
        float forward = Math.Max(alignment, 0);
        float facing = Math.Lerp(1, forward * forward + 0.01, radius);
        float baseWeight = spatial * facing;
        // Invalid neighbors still count as missing coverage, so the
        // remaining light fades continuously as valid support vanishes.
        result.base += baseWeight;
        // A capture behind the unperturbed receiver plane cannot supply its
        // incoming hemisphere. Otherwise a black exterior probe can pass a
        // coplanar depth comparison and darken a valid interior receiver.
        // Retain tangent support and fade the tiny quantization margin smoothly.
        float side = Math.Dot(visibilityNormal, -delta);
        float frontSupport = Math.SmoothStep(-metric * 0.001, 0, side);
        if (frontSupport <= 0) continue;
        float2 visibility = ReceiverVisibility(distance, probe, layout.atlasRows, delta, visibilityNormal,
            layout.spacing, tolerance, metric);
        if (visibility.y >= 0.25) continue;
        float weight = baseWeight * frontSupport * visibility.x;
        Color sampled = irradiance.Sample(AtlasUV(probe, layout.atlasRows, n), Filter.Bilinear, Wrap.Clamp);
        result.light += ClampHdr(float3(sampled.r, sampled.g, sampled.b)) * weight;
        result.weight += weight;
    }
    return result;
}

// The analytic lattice path has a separate call graph. Keeping sparse tree
// traversal out of these shaders avoids compiling it for every dense fixture.
IrradianceBlend GatherLegacyIrradiance(Texture irradiance, Texture distance, FieldLayout layout,
                                      int initialized, float3 world, float3 n, float3 visibilityNormal,
                                      float3 grid, float tolerance)
{
    int3 lower = Math.Min(int3(Math.Floor(grid)), layout.counts - int3(2));
    float3 fraction = grid - float3(lower);
    mut IrradianceBlend result = default;
    int end = Math.Min(layout.total, 8);
    for (var sample = 0; sample < end; sample++)
    {
        int x = sample % 2;
        int y = (sample / 2) % 2;
        int z = sample / 4;
        int3 coordinate = lower + int3(x, y, z);
        int probe = coordinate.x + layout.counts.x * (coordinate.y + layout.counts.y * coordinate.z);
        if (probe < 0 || probe >= layout.total || probe >= initialized) continue;
        float3 axis = float3(x == 0 ? 1 - fraction.x : fraction.x,
            y == 0 ? 1 - fraction.y : fraction.y, z == 0 ? 1 - fraction.z : fraction.z);
        float spatial = axis.x * axis.y * axis.z;
        if (spatial <= 0) continue;
        float3 eye = layout.minimum + (float3(coordinate)
            + ProbeOffset(distance, probe, layout.atlasRows)) * layout.spacing;
        float3 delta = world - eye;
        float receiverDistance = Math.Length(delta);
        float alignment = Math.Clamp(Math.Dot(n, -delta) / Math.Max(receiverDistance, 0.000001), -1, 1);
        float radius = Math.Saturate(receiverDistance / (layout.spacing * 0.04));
        float forward = Math.Max(alignment, 0);
        float facing = Math.Lerp(1, forward * forward + 0.01, radius);
        float baseWeight = spatial * facing;
        result.base += baseWeight;
        float2 visibility = ReceiverVisibility(distance, probe, layout.atlasRows, delta, visibilityNormal,
            layout.spacing, tolerance);
        if (visibility.y >= 0.25) continue;
        float weight = baseWeight * visibility.x;
        Color sampled = irradiance.Sample(AtlasUV(probe, layout.atlasRows, n), Filter.Bilinear, Wrap.Clamp);
        result.light += ClampHdr(float3(sampled.r, sampled.g, sampled.b)) * weight;
        result.weight += weight;
    }
    return result;
}

float3 ResolveIrradiance(IrradianceBlend blend)
{
    float confidence = blend.weight / Math.Max(blend.base, 0.0000001);
    float trusted = Math.SmoothStep(0.00001, 0.001, confidence);
    return blend.weight > 0.0000001 ? ClampHdr(blend.light / blend.weight * trusted) : float3(0);
}

float3 SampleBrickIrradiance(Texture irradiance, Texture distance, FieldLayout layout,
                            int initialized, SampleBrick brick, float3 world, float3 n,
                            float3 visibilityNormal, float3 position, float tolerance)
{
    FieldLayout local = FieldLayout {
        minimum = brick.minimum, spacing = brick.size * 0.5, counts = int3(3),
        total = layout.total, atlasRows = layout.atlasRows, sparse = true, nodeCount = layout.nodeCount
    };
    float3 grid = Math.Clamp((position - brick.minimum) / local.spacing, float3(0), float3(2));
    IrradianceBlend blend = GatherSparseIrradiance(irradiance, distance, local, initialized,
        world, n, visibilityNormal, grid, tolerance, brick.slot * 28, layout.spacing);
    float3 fine = ResolveIrradiance(blend);
    mut float3 result = fine;
    // Refinement preserves the old parent nodes as this child's eight outer
    // corners. Keep their lighting while new edge/face/interior nodes fill;
    // otherwise an exact new midpoint has no captured fine-grid weight at all.
    // Treat roundoff at complete support as full to retain the interior fast
    // path instead of repeating a gather for a rounding-only missing weight.
    if (blend.available < 0.99999)
    {
        FieldLayout coarse = FieldLayout {
            minimum = brick.minimum, spacing = brick.size, counts = int3(2),
            total = layout.total, atlasRows = layout.atlasRows, sparse = true, nodeCount = layout.nodeCount
        };
        float3 coarseGrid = Math.Clamp((position - brick.minimum) / brick.size, float3(0), float3(1));
        IrradianceBlend corners = GatherSparseIrradiance(irradiance, distance, coarse, initialized,
            world, n, visibilityNormal, coarseGrid, tolerance, brick.slot * 28, layout.spacing, 2);
        result = Math.Lerp(ResolveIrradiance(corners), fine, Math.Saturate(blend.available));
    }
    return result;
}

float3 SampleSparse(Texture irradiance, Texture distance, FieldLayout layout, int initialized,
                     float3 world, float3 n, float3 visibilityNormal, float3 position, float tolerance)
{
    // Different resolutions and missing coverage use a fixed world-space
    // filter. Equal-resolution neighbors share their face records already,
    // so they retain the ordinary single-brick gather all the way to the face.
    float radius = layout.spacing * 0.25;
    SampleBrick own = LookupBrick(distance, layout, position);
    mut float3 result = float3(0);
    // Keep one explicitly initialized result and one return for all paths;
    // this also avoids an ANGLE/HLSL false uninitialized-return diagnostic.
    int nx = position.x < own.minimum.x + radius ? -1 : position.x > own.minimum.x + own.size - radius ? 1 : 0;
    int ny = position.y < own.minimum.y + radius ? -1 : position.y > own.minimum.y + own.size - radius ? 1 : 0;
    int nz = position.z < own.minimum.z + radius ? -1 : position.z > own.minimum.z + own.size - radius ? 1 : 0;
    int sx = nx > 0 ? 1 : 0;
    int sy = ny > 0 ? 1 : 0;
    int sz = nz > 0 ? 1 : 0;
    mut bool transition = (nx != 0 && (own.transitions & (1 << sx)) != 0)
        || (ny != 0 && (own.transitions & (1 << (2 + sy))) != 0)
        || (nz != 0 && (own.transitions & (1 << (4 + sz))) != 0);
    if (own.slot >= 0 && !transition
        && ((nx != 0 && ny != 0) || (nx != 0 && nz != 0) || (ny != 0 && nz != 0)))
    {
        // A missing/coarser diagonal must affect just its nearby edge or
        // corner, rather than forcing every pixel along either whole face
        // through the expensive multi-brick filter.
        int mask = DecodeLookupMask(LookupData(distance, layout.atlasRows,
            layout.nodeCount + own.slot * 28 + 27));
        transition = (nx != 0 && ny != 0 && (mask & (1 << (sx + sy * 2))) != 0)
            || (nx != 0 && nz != 0 && (mask & (1 << (4 + sx + sz * 2))) != 0)
            || (ny != 0 && nz != 0 && (mask & (1 << (8 + sy + sz * 2))) != 0)
            || (nx != 0 && ny != 0 && nz != 0 && (mask & (1 << (12 + sx + sy * 2 + sz * 4))) != 0);
    }
    bool single = own.slot >= 0 && !transition;
    if (single)
    {
        result = SampleBrickIrradiance(irradiance, distance, layout, initialized,
            own, world, n, visibilityNormal, position, tolerance);
    }
    else
    {
        float3 lower = position - float3(radius);
        float3 upper = position + float3(radius);
        mut int4 first = int4(-1);
        mut int4 second = int4(-1);
        mut SampleBrick cached = own;
        // Every leaf is at least four filter widths across, so the eight corners
        // find every intersecting leaf. Integrate each leaf's overlap only once.
        int end = Math.Min(layout.total, 8);
        for (var corner = 0; corner < end; corner++)
        {
            float3 point = float3((corner & 1) == 0 ? lower.x : upper.x,
                (corner & 2) == 0 ? lower.y : upper.y, (corner & 4) == 0 ? lower.z : upper.z);
            mut SampleBrick brick = own;
            if (own.size <= 0 || point.x < own.minimum.x || point.y < own.minimum.y || point.z < own.minimum.z
                || point.x >= own.minimum.x + own.size || point.y >= own.minimum.y + own.size
                || point.z >= own.minimum.z + own.size)
            {
                // The x-alternating corner order often revisits the same
                // neighboring leaf or empty branch. Preserve that cached
                // domain while intervening corners use the receiver's own.
                if (cached.size > 0 && point.x >= cached.minimum.x && point.y >= cached.minimum.y
                    && point.z >= cached.minimum.z && point.x < cached.minimum.x + cached.size
                    && point.y < cached.minimum.y + cached.size && point.z < cached.minimum.z + cached.size)
                    brick = cached;
                else
                {
                    brick = LookupBrick(distance, layout, point);
                    cached = brick;
                }
            }
            int slot = brick.slot;
            if (slot < 0 || slot == first.x || slot == first.y || slot == first.z || slot == first.w
                || slot == second.x || slot == second.y || slot == second.z || slot == second.w) continue;
            if (corner == 0) first.x = slot;
            else if (corner == 1) first.y = slot;
            else if (corner == 2) first.z = slot;
            else if (corner == 3) first.w = slot;
            else if (corner == 4) second.x = slot;
            else if (corner == 5) second.y = slot;
            else if (corner == 6) second.z = slot;
            else second.w = slot;
            float3 overlap = Math.Max(Math.Min(upper, brick.minimum + float3(brick.size))
                - Math.Max(lower, brick.minimum), float3(0)) / (2 * radius);
            float weight = overlap.x * overlap.y * overlap.z;
            if (weight <= 0) continue;
            result += SampleBrickIrradiance(irradiance, distance, layout, initialized,
                brick, world, n, visibilityNormal, position, tolerance) * weight;
        }
    }
    // Uncovered portions retain zero weight: sparse exterior coverage fades
    // continuously instead of extrapolating a distant brick into empty space.
    return result;
}

struct SamplingFrame
{
    bool valid;
    float3 normal;
    float3 visibilityNormal;
    float3 position;
}

SamplingFrame PrepareSamplingFrame(FieldLayout layout, float intensity, int initialized,
                                    float3 world, float3 normal, float3 visibilityNormal)
{
    mut SamplingFrame frame = default;
    if (!(initialized <= 0 || intensity <= 0 || layout.total <= 0))
    {
        float3 n = Math.Normalize(normal);
        if (!(Math.LengthSq(n) < 0.5))
        {
            mut float3 planeNormal = Math.Normalize(visibilityNormal);
            if (Math.LengthSq(planeNormal) < 0.5) planeNormal = n;
            frame.valid = true;
            frame.normal = n;
            frame.visibilityNormal = planeNormal;
            frame.position = world + n * (layout.spacing * 0.04);
        }
    }
    return frame;
}

float3 SampleLegacy(Texture irradiance, Texture distance, FieldLayout layout, float intensity,
                    int initialized, float3 world, float3 normal, float3 visibilityNormal, float tolerance = 0.01)
{
    SamplingFrame frame = PrepareSamplingFrame(layout, intensity, initialized, world, normal, visibilityNormal);
    if (!frame.valid) return float3(0);
    // Automatic world coverage extrapolates smoothly at its retained edge.
    float3 rawGrid = (frame.position - layout.minimum) / layout.spacing;
    float3 grid = Math.Clamp(rawGrid, float3(0), float3(layout.counts - int3(1)));
    float beyond = Math.Length(rawGrid - grid);
    float fade = 1 / (1 + beyond * beyond);
    IrradianceBlend fine = GatherLegacyIrradiance(irradiance, distance, layout, initialized,
        world, frame.normal, frame.visibilityNormal, grid, tolerance);
    float3 result = ResolveIrradiance(fine);
    return ClampHdr(result * (intensity * fade));
}

float3 SampleLegacy(Texture irradiance, Texture distance, FieldLayout layout, float intensity,
                    int initialized, float3 world, float3 normal)
{
    return SampleLegacy(irradiance, distance, layout, intensity, initialized, world, normal, normal);
}

float3 SampleWorld(Texture irradiance, Texture distance, FieldLayout layout, float intensity,
                    int initialized, float3 world, float3 normal, float3 visibilityNormal, float tolerance = 0.01)
{
    SamplingFrame frame = PrepareSamplingFrame(layout, intensity, initialized, world, normal, visibilityNormal);
    if (!frame.valid) return float3(0);
    return ClampHdr(SampleSparse(irradiance, distance, layout, initialized,
        world, frame.normal, frame.visibilityNormal, frame.position, tolerance) * intensity);
}

float3 SampleWorld(Texture irradiance, Texture distance, FieldLayout layout, float intensity,
                    int initialized, float3 world, float3 normal)
{
    return SampleWorld(irradiance, distance, layout, intensity, initialized, world, normal, normal);
}

float3 Sample(Texture irradiance, Texture distance, FieldLayout layout, float intensity,
                int initialized, float3 world, float3 normal, float3 visibilityNormal, float tolerance = 0.01)
{
    if (layout.sparse)
        return SampleWorld(irradiance, distance, layout, intensity, initialized, world, normal, visibilityNormal, tolerance);
    return SampleLegacy(irradiance, distance, layout, intensity, initialized, world, normal, visibilityNormal, tolerance);
}

float3 Sample(Texture irradiance, Texture distance, FieldLayout layout, float intensity,
                int initialized, float3 world, float3 normal)
{
    return Sample(irradiance, distance, layout, intensity, initialized, world, normal, normal);
}
