using Render3D;

scene Main;
asset Mesh3D giQuad = "quad.obj";
asset Mesh3D giBox = "cube.obj";
asset Mesh3D giSphere = "../../../docs/examples/assets/render3d/sphere.obj";
asset SkinnedMesh3D giSkin = "skinning.gltf";

singleton GIFixture
{
    int scenario;
    bool built;
    bool spawnFar;
    bool farBuilt;
    float3 offset;
    float3 farPosition = float3(30, 2, -11);
    bool casterShadows = true;
    float3 casterEmission;
    float casterRoughness = 0.5;
    bool casterCutout;
    float casterAlpha = 1;
}

component GIRoomWall { }
component GIMoving { }
component GIShadowCaster { }

local singleton GIProbe
{
    GlobalIllumination.Settings settings;
    GlobalIllumination.Settings raw;
    GlobalIllumination.Settings bounded;
    bool disabled;
    bool dispose;
    float3 ambient;
    float3 directRadiance;
    bool lightBuilt;
    float3 emission = float3(0.2, 0.1, 0.05);
    int synthetic;
    int sampleCount;
    bool showOffset;
    bool showMoments;
    int offsetIndex;
    float3 cameraPosition = float3(0, 0, -2);
    bool shadowsEnabled = true;
    int shadowMaps = 6;
    bool invalidate;
    GlobalIllumination.LocalBounds invalidateRegion;
    int coverageCount;
    float3[16] coveragePositions;
    int[16] coverageSlots;
    float[16] coverageSpacing;
    float3[16] coverageMinimum;
    float3[16] positions;
    float3[16] normals;
}

float3 GIWallForward(int face)
{
    if (face == 0) return float3(1, 0, 0);
    if (face == 1) return float3(-1, 0, 0);
    if (face == 2) return float3(0, 1, 0);
    if (face == 3) return float3(0, -1, 0);
    if (face == 4) return float3(0, 0, 1);
    return float3(0, 0, -1);
}

system BuildGIWorld(mut GIFixture fixture)
{
    if (fixture.built) return;
    fixture.built = true;
    if (fixture.scenario == 1)
    {
        Spawn(GIMoving, MeshRenderer { mesh = giBox }, Material,
            Transform { localPosition = float3(2, -1, 3), localScale = float3(2, 4, 6) });
    }
    if (fixture.scenario == 2)
    {
        for (var face = 0; face < 6; face++)
        {
            float3 forward = GIWallForward(face);
            float3 up = face == 2 ? float3(0, 0, -1) : face == 3 ? float3(0, 0, 1) : float3(0, 1, 0);
            Spawn(GIRoomWall, MeshRenderer { mesh = giQuad }, Material,
                Transform { localPosition = forward * 3, localRotation = quaternion.LookRotation(forward, up),
                            localScale = float3(6, 6, 1) });
        }
        Spawn(MeshRenderer { mesh = giQuad }, Material { baseColor = Color.white },
            Transform { localScale = float3(0.25, 0.25, 1) });
    }
    if (fixture.scenario == 3)
    {
        Spawn(MeshRenderer { mesh = giBox }, Material,
            Transform { localPosition = float3(0, -0.15, 0), localScale = float3(8, 0.3, 8) });
        Spawn(MeshRenderer { mesh = giBox }, Material,
            Transform { localPosition = float3(-4.15, 3, 0), localScale = float3(0.3, 6, 8) });
    }
    if (fixture.scenario == 4)
    {
        Spawn(SkinnedMeshRenderer { mesh = giSkin }, Material,
            Transform { localPosition = float3(7, -3, 2), localScale = float3(2, 3, 4) });
    }
    if (fixture.scenario == 5)
        Spawn(MeshRenderer { mesh = giQuad }, Material,
            Transform { localScale = float3(0.1) });
    if (fixture.scenario == 6)
    {
        Spawn(MeshRenderer { mesh = giBox }, Material { baseColor = Color(0.85, 0.85, 0.85), roughness = 0.85 },
            Transform { localPosition = float3(0, -0.15, 0), localScale = float3(8, 0.3, 8) });
        Spawn(MeshRenderer { mesh = giBox }, Material { baseColor = Color(0.85, 0.85, 0.85), roughness = 0.85 },
            Transform { localPosition = float3(0, 3, 4.15), localScale = float3(8, 6, 0.3) });
        Spawn(MeshRenderer { mesh = giBox }, Material { baseColor = Color(0.85, 0.1, 0.07), roughness = 0.9 },
            Transform { localPosition = float3(-4.15, 3, 0), localScale = float3(0.3, 6, 8) });
        Spawn(MeshRenderer { mesh = giBox }, Material { baseColor = Color(0.05, 0.6, 0.8), roughness = 0.9 },
            Transform { localPosition = float3(4.15, 3, 0), localScale = float3(0.3, 6, 8) });
        Spawn(MeshRenderer { mesh = giSphere }, Material { baseColor = Color(0.9, 0.9, 0.9), roughness = 0.65 },
            Transform { localPosition = float3(1.3, 1, -0.6), localScale = float3(1) });
        Spawn(MeshRenderer { mesh = giBox }, Material { emission = float3(6, 4.5, 2.5), roughness = 1 },
            Transform { localPosition = float3(0, 5.6, 1), localScale = float3(3, 0.08, 2) });
        Spawn(PointLight { intensity = float3(95, 80, 65), range = 18, castShadows = true },
            Transform { localPosition = float3(0, 5.2, 0.5) });
    }
    if (fixture.scenario == 7 || fixture.scenario == 8)
    {
        if (fixture.scenario == 7)
            Spawn(MeshRenderer { mesh = giBox }, Material,
                Transform { localScale = float3(8, 8, 0.05) });
        Spawn(MeshRenderer { mesh = giQuad }, Material { emission = float3(2, 1, 0.5) },
            Transform { localPosition = float3(0, 0, 2), localScale = float3(4, 4, 1) });
    }
    if (fixture.scenario == 9)
    {
        Spawn(MeshRenderer { mesh = giBox }, Material);
        Spawn(MeshRenderer { mesh = giBox }, Material,
            Transform { localPosition = float3(32, 0, 0) });
    }
    if (fixture.scenario == 10)
    {
        Spawn(MeshRenderer { mesh = giBox }, Material,
            Transform { localPosition = float3(2000000, 0, 0) });
        Spawn(MeshRenderer { mesh = giBox }, Material,
            Transform { localPosition = float3(2001000, 0, 0) });
    }
    if (fixture.scenario == 11)
        Spawn(MeshRenderer { mesh = giQuad }, Material { emission = float3(0.2, 0.1, 0.05) },
            Transform { localPosition = float3(0, 0, 1.089), localScale = float3(0.1) });
    if (fixture.scenario == 12)
    {
        // The far receiver is beyond a six-unit capture of the caster but
        // remains inside this light's shadow influence and the resident view.
        Spawn(GIShadowCaster, MeshRenderer { mesh = giBox }, Material, Transform);
        Spawn(MeshRenderer { mesh = giBox }, Material,
            Transform { localPosition = float3(32, 0, 0) });
        Spawn(PointLight { intensity = float3(1), range = 100, castShadows = true },
            Transform { localPosition = float3(0, 8, 0) });
    }
}

system MoveGIWorld(with GIMoving, mut Transform transform, GIFixture fixture)
{
    transform.localPosition = float3(2, -1, 3) + fixture.offset;
}

system ChangeGIShadowCaster(with GIShadowCaster, mut MeshRenderer mesh,
                            mut Transform transform, mut Material material, GIFixture fixture)
{
    mesh.castShadows = fixture.casterShadows;
    transform.localPosition = fixture.offset;
    material.emission = fixture.casterEmission;
    material.roughness = fixture.casterRoughness;
    material.mode = fixture.casterCutout ? SurfaceMode.Cutout : SurfaceMode.Opaque;
    material.baseColor = Color(1, 1, 1, fixture.casterAlpha);
}

system AddFarGIObject(mut GIFixture fixture)
{
    if (!fixture.spawnFar || fixture.farBuilt) return;
    fixture.farBuilt = true;
    Spawn(MeshRenderer { mesh = giBox }, Material,
        Transform { localPosition = fixture.farPosition, localScale = float3(2) });
}

[Before(Stages.Prepare)]
view ConfigureGIProbe(mut Renderer renderer, mut GlobalIllumination.Environment environment, mut GIProbe probe, GIFixture fixture)
{
    if (probe.dispose) GlobalIllumination.Dispose(environment);
    renderer.enabled = !probe.disabled;
    environment.settings = probe.settings;
    if (probe.invalidate)
    {
        GlobalIllumination.Invalidate(environment, probe.invalidateRegion);
        probe.invalidate = false;
    }
    renderer.camera = Camera { position = probe.cameraPosition, rotation = quaternion.identity,
                               verticalFov = 60deg, near = 0.1, far = 100 };
    renderer.shadows = fixture.scenario == 6 || (fixture.scenario == 12 && probe.shadowsEnabled);
    renderer.shadowResolution = fixture.scenario == 6 ? 512 : 16;
    renderer.maxShadowMaps = probe.shadowMaps;
    renderer.maxLights = fixture.scenario == 6 || fixture.scenario == 12 ? 2 : 1;
    renderer.background = Color.black;
    renderer.ambientIrradiance = probe.ambient;
    probe.bounded = GlobalIllumination.ClampSettings(probe.raw);
    if (!probe.lightBuilt)
    {
        probe.lightBuilt = true;
        local Spawn(DirectionalLight { direction = float3(0, 0, 1), radiance = float3(0), castShadows = false });
    }
}

[Before(Stages.Prepare)]
view ChangeGILight(mut local DirectionalLight light, GIProbe probe)
{
    light.radiance = probe.directRadiance;
}

[Before(Stages.Prepare)]
view ChangeGIRoom(with GIRoomWall, mut Material material, GIProbe probe)
{
    float3 emission = probe.emission;
    material.shader = Lit {
        surface = (SurfaceInput input, mut Surface surface) => GIEmission(input, surface, emission)
    };
}

void GIEmission(SurfaceInput input, mut Surface surface, float3 emission)
{
    surface.emission = emission;
}

RenderTarget GIProbeFace(GlobalIllumination.Resources resources, int face)
{
    if (face == 0) return resources.face0;
    if (face == 1) return resources.face1;
    if (face == 2) return resources.face2;
    if (face == 3) return resources.face3;
    if (face == 4) return resources.face4;
    return resources.face5;
}

struct ControlledIncoming { int mode; int face; }

frag PartialVisibility(Vertex vertex, out Color light, out Color moments,
                       GlobalIllumination.Environment environment, GIProbe probe)
{
    if (int(Math.Floor(vertex.uv.y * float(environment.layout.atlasRows * 19))) % 19 == 18)
    {
        light = Color.black;
        moments = Color(float3(128.0 / 255.0), 1);
        return;
    }
    int column = int(Math.Floor(vertex.uv.x * 32));
    int row = int(Math.Floor(vertex.uv.y * float(environment.layout.atlasRows * 19))) / 19;
    int slot = (column + row * 32) / 27;
    float3 radiance = probe.synthetic == 6 ? float3(column % 2 == 0 ? 0.2 : 0.8)
        : probe.synthetic == 9 ? float3(slot == 0 ? 0.2 : slot == 1 ? 0.8 : 0.4)
        : float3(0.2, 0.1, 0.05);
    light = Color(radiance * Math.PI, 1);
    // Inverse projective depth and its standard deviation. Mode 4 supplies
    // uncertain finite visibility; mode 6 has no blocker in any direction.
    moments = probe.synthetic == 6 || probe.synthetic >= 8 ? Color(0, 0, 0, 1) : Color(2, 1, 0, 1);
}

frag SparseControlledField(Vertex vertex, out Color light, out Color moments,
                           GlobalIllumination.Environment environment, GIProbe probe)
{
    float2 pixel = vertex.uv * float2(576, environment.layout.atlasRows * 19);
    int index = int(Math.Floor(pixel.x / 18)) + int(Math.Floor(pixel.y / 19)) * 32;
    int slot = index / 27;
    int local = index % 27;
    bool outer = local % 3 != 1 && (local / 3) % 3 != 1 && local / 9 != 1;
    bool captured = probe.synthetic == 11 ? slot == 2 && outer : probe.synthetic != 10 || slot == 2;
    if (int(Math.Floor(pixel.y)) % 19 == 18)
    {
        light = Color.black;
        moments = captured ? Color(float3(128.0 / 255.0), 1) : Color(0, 0, 0, 0);
        return;
    }
    float3 radiance = probe.synthetic == 9 ? float3(slot == 0 ? 0.2 : slot == 1 ? 0.8 : 0.4)
        : float3(0.2, 0.1, 0.05);
    light = Color(radiance * Math.PI, 1);
    moments = Color(0, 0, 0, 1);
}

frag GIIncoming(Vertex vertex, out Color light, out Color data, ControlledIncoming incoming)
{
    bool dark = (incoming.mode == 3 && incoming.face != 0)
        || (incoming.mode == 7 && (incoming.face != 0
            || int(Math.Floor(vertex.uv.x * 32)) != 17 || int(Math.Floor(vertex.uv.y * 32)) != 17));
    light = dark ? Color.black : incoming.mode == 7 ? Color(20, 10, 5) : Color(0.2, 0.1, 0.05);
    // R is radial distance/far, G a one-sided backface, B says a hit exists.
    data = incoming.mode == 12 ? Color(1, 1, 1, 1)
         : incoming.mode == 2 ? Color(0.001, 0, 1, 1)
         : incoming.mode == 5 ? Color(0.1, 1, 1, 1) : Color(0, 0, 0, 1);
}

// Use the real convolution and receiver sampling with analytically controlled
// incident light. Explicit synthetic layouts keep these reconstruction oracles
// independent of the automatic world's current placement and budget policy.
[After(GlobalIllumination.CollectWorldBounds), Before(GlobalIllumination.Update)]
view ControlledGIWorld(mut GlobalIllumination.WorldBounds bounds, GIProbe probe)
{
    // Avoid recording automatic atlas writes that a controlled layout would
    // replace later in this same frame. Ordinary world scenarios use Update.
    if (probe.synthetic != 0) bounds.ready = false;
}

[After(GlobalIllumination.Update), Before(Stages.Color)]
view ControlledGI(mut GlobalIllumination.Environment environment, GIProbe probe)
{
    if (probe.synthetic == 0) return;
    // Preserve the original analytic lattice cases independently of the
    // geometry-driven runtime allocator, then exercise sparse lookup below.
    if (probe.synthetic < 8 || probe.synthetic == 12)
        GlobalIllumination.PrepareResources(environment,
            GlobalIllumination.BuildLayout(float3(-0.05), float3(0.05), 1.5, 125));
    else
    {
        GlobalIllumination.PrepareResources(environment, GlobalIllumination.FieldLayout {
            minimum = float3(0), spacing = 1, counts = int3(3),
            total = probe.synthetic == 14 ? 189 : 108, atlasRows = probe.synthetic == 14 ? 6 : 4,
            far = 48, sparse = true, size = probe.synthetic >= 13 ? 4 : 8,
            nodeCount = probe.synthetic >= 13 ? 9 : 17, depthLimit = probe.synthetic >= 13 ? 1 : 2
        });
        // Root child zero is a coarse brick, child one splits into two fine
        // bricks along Y. Other children are empty. Nonzero high index bytes
        // exercise the same lookup encoding used by runtime tree uploads.
        // These authored independent brick fields need every boundary filtered;
        // runtime equal-resolution shared faces can clear their transition bit.
        mut List<int> codes = [257, 1 | (63 << 16), 265, 0, 0, 0, 0, 0, 0,
            2 | (63 << 16), 0, 3 | (63 << 16), 0, 0, 0, 0, 0];
        if (probe.synthetic == 13)
            codes = [257, 1 | (21 << 16), 2 | (63 << 16), 3 | (63 << 16), 0,
                4 | (63 << 16), 0, 0, 0];
        if (probe.synthetic == 14)
            codes = [257, 1 | (21 << 16), 2 | (63 << 16), 3 | (63 << 16), 4 | (63 << 16),
                5 | (63 << 16), 6 | (63 << 16), 7 | (63 << 16), 0];
        // Deliberately give these constant/contrast bricks separate physical
        // records; runtime bricks share identical anchors through this table.
        int blocks = probe.synthetic == 14 ? 7 : probe.synthetic == 13 ? 4 : 3;
        for (var slot = 0; slot < blocks; slot++)
        {
            for (var index = 0; index < 27; index++) codes.Add(slot * 27 + index + 1);
            // One extra RGB record keeps the twenty local edge/corner bits.
            codes.Add(probe.synthetic == 14 && slot == 0 ? 1 << 19 : (1 << 20) - 1);
        }
        GlobalIllumination.UploadLookup(environment, codes);
        environment.initialized = probe.synthetic == 10 ? 27 : probe.synthetic == 11 ? 8 : blocks * 27;
        ResetTarget(environment.resources.atlas);
        environment.resources.atlas.Screen()
        {
            float height = float(environment.layout.atlasRows * 19);
            environment.resources.atlas.Mesh([
                Vertex { position = float2(0, 0), uv = float2(0, 0) }, Vertex { position = float2(576, 0), uv = float2(1, 0) },
                Vertex { position = float2(576, height), uv = float2(1, 1) }, Vertex { position = float2(0, height), uv = float2(0, 1) }
            ], [0, 1, 2, 0, 2, 3], SparseControlledField);
        }
        return;
    }
    if (probe.synthetic == 4 || probe.synthetic == 6)
    {
        // Author a known constant irradiance with partial probe visibility.
        // Visible-weight normalization must preserve L, without an extra AO
        // multiplier whose maximum jumps as interpolation weights disappear.
        ResetTarget(environment.resources.atlas);
        environment.resources.atlas.Screen()
        {
            float height = float(environment.layout.atlasRows * 19);
            environment.resources.atlas.Mesh([
                Vertex { position = float2(0, 0), uv = float2(0, 0) }, Vertex { position = float2(576, 0), uv = float2(1, 0) },
                Vertex { position = float2(576, height), uv = float2(1, 1) }, Vertex { position = float2(0, height), uv = float2(0, 1) }
            ], [0, 1, 2, 0, 2, 3], PartialVisibility);
        }
        environment.initialized = environment.layout.total;
        return;
    }
    for (var face = 0; face < 6; face++)
    {
        RenderTarget target = GIProbeFace(environment.resources, face);
        ResetTarget(target);
        target.Screen()
        {
            target.Mesh([
                Vertex { position = float2(0, 0), uv = float2(0, 0) },
                Vertex { position = float2(32, 0), uv = float2(1, 0) },
                Vertex { position = float2(32, 32), uv = float2(1, 1) },
                Vertex { position = float2(0, 32), uv = float2(0, 1) }
            ], [0, 1, 2, 0, 2, 3], GIIncoming, ControlledIncoming { mode = probe.synthetic, face = face });
        }
    }
    for (var index = 0; index < environment.layout.total; index++)
        GlobalIllumination.IntegrateProbe(environment, index);
}

[After(ControlledGI), Before(Stages.Color)]
view BindControlledGI(mut Renderer renderer, GlobalIllumination.Environment environment, GIProbe probe)
{
    if (!environment.ready || probe.synthetic == 0) return;
    // Controlled layouts can recreate the targets after the automatic update.
    // All ordinary material draws must receive the current live resources too.
    GlobalIllumination.FieldLayout layout = environment.layout;
    float intensity = environment.settings.intensity;
    int initialized = environment.initialized;
    if (layout.sparse)
        renderer.indirect = (SurfaceInput input, Surface surface, Texture a, Texture b) =>
            GlobalIllumination.Indirect(input, surface, a, b, layout, intensity, initialized);
    else
        renderer.indirect = (SurfaceInput input, Surface surface, Texture a, Texture b) =>
            GlobalIllumination.IndirectLegacy(input, surface, a, b, layout, intensity, initialized);
    renderer.indirect0 = environment.irradiance;
    renderer.indirect1 = environment.distance;
}

struct GIWitness { float3 position; float3 normal; }

frag ReadGIWitness(Vertex vertex, out Color color, GlobalIllumination.Environment environment, GIWitness witness, GIProbe probe)
{
    if (probe.showMoments)
    {
        color = environment.distance.Sample(GlobalIllumination.AtlasUV(probe.offsetIndex,
            environment.layout.atlasRows, witness.normal), Filter.Bilinear, Wrap.Clamp);
        return;
    }
    if (probe.showOffset)
    {
        color = Color(GlobalIllumination.ProbeOffset(environment.distance, probe.offsetIndex,
            environment.layout.atlasRows) + float3(128.0 / 255.0), 1);
        return;
    }
    float3 light = GlobalIllumination.SampleWorld(environment.irradiance, environment.distance,
        environment.layout, environment.settings.intensity, environment.initialized,
        witness.position, witness.normal) / Math.PI;
    color = Color(light, 1);
}

frag ReadGILegacyWitness(Vertex vertex, out Color color, GlobalIllumination.Environment environment, GIWitness witness, GIProbe probe)
{
    if (probe.showMoments)
    {
        color = environment.distance.Sample(GlobalIllumination.AtlasUV(probe.offsetIndex,
            environment.layout.atlasRows, witness.normal), Filter.Bilinear, Wrap.Clamp);
        return;
    }
    if (probe.showOffset)
    {
        color = Color(GlobalIllumination.ProbeOffset(environment.distance, probe.offsetIndex,
            environment.layout.atlasRows) + float3(128.0 / 255.0), 1);
        return;
    }
    float3 light = GlobalIllumination.SampleLegacy(environment.irradiance, environment.distance,
        environment.layout, environment.settings.intensity, environment.initialized,
        witness.position, witness.normal) / Math.PI;
    color = Color(light, 1);
}

local singleton GIPlacementAudit
{
    bool enabled;
    bool compare;
    bool stable = true;
    int relocated;
    int index = -1;
    float3 offset;
    float maxFraction;
    List<float3> reference;
}

[After(GlobalIllumination.Update)]
view AuditGIPlacement(GlobalIllumination.Environment environment, mut GIPlacementAudit audit)
{
    if (!audit.enabled || !environment.ready) return;
    audit.relocated = 0;
    audit.maxFraction = 0;
    for (var i = 0; i < environment.layout.total; i++)
    {
        if (!environment.active[i] || !environment.captured[i]) continue;
        float spacing = GlobalIllumination.ProbeSpacing(environment, i);
        if (spacing <= 0) continue;
        float3 offset = environment.offsets[i] / spacing;
        float length = Math.Length(offset);
        audit.maxFraction = Math.Max(audit.maxFraction, length);
        if (length > 0.00001)
        {
            audit.relocated++;
            if (audit.index < 0) { audit.index = i; audit.offset = offset; }
        }
        if (audit.compare && (audit.reference.count != environment.layout.total
            || Math.LengthSq(environment.offsets[i] - audit.reference[i]) > 0)) audit.stable = false;
    }
    if (environment.initialized == environment.activeProbes && audit.reference.count == 0)
        audit.reference = environment.offsets;
}

[After(GlobalIllumination.Update), Before(ControlledGI)]
view AuditGICoverage(GlobalIllumination.Environment environment, GlobalIllumination.WorldBounds bounds, mut GIProbe probe)
{
    for (var i = 0; i < probe.coverageCount && i < 16; i++)
    {
        int slot = GlobalIllumination.FindBlock(bounds, probe.coveragePositions[i]);
        probe.coverageSlots[i] = slot;
        probe.coverageSpacing[i] = slot >= 0 && slot < environment.blocks.count ? environment.blocks[slot].spacing : 0;
        probe.coverageMinimum[i] = slot >= 0 && slot < environment.blocks.count ? environment.blocks[slot].minimum : float3(0);
    }
}

[Stage(Stages.Present, 1)]
view GIWitnesses(Renderer renderer, GIProbe probe, GlobalIllumination.Environment environment)
{
    if (!renderer.enabled || !renderer.ready) return;
    Draw.Screen()
    {
        Draw.SetBlend(Blend.Replace);
        Draw.SetDepth();
        Draw.SetCull();
        for (var i = 0; i < probe.sampleCount && i < 16; i++)
        {
            float x = float(i * 4);
            List<Vertex> vertices = [Vertex { position = float2(x, 0) }, Vertex { position = float2(x + 4, 0) },
                Vertex { position = float2(x + 4, 8) }, Vertex { position = float2(x, 8) }];
            List<int> indices = [0, 1, 2, 0, 2, 3];
            GIWitness witness = GIWitness { position = probe.positions[i], normal = probe.normals[i] };
            if (environment.layout.sparse)
                Draw.Mesh(vertices, indices, ReadGIWitness, witness);
            else
                Draw.Mesh(vertices, indices, ReadGILegacyWitness, witness);
        }
    }
}

// CPU geometry witnesses run only when explicitly requested by the host test.
// They share the actual cube/sphere assets used by automatic probe placement.
local singleton GIPlacementProbe
{
    bool enabled;
    bool done;
    bool cubeClosed;
    bool sphereClosed;
    bool planeClosed;
    float3 invalidPoint;
    float4x4 invalidTransform = float4x4.identity;
    float invalidRadius;
    GlobalIllumination.GeometryHit[16] hits;
    float3 relocated;
    float3 retained;
    float3 unresolved;
    float3 largeUnresolved;
}

[Before(Stages.Prepare)]
view GIPlacementWitnesses(mut GIPlacementProbe probe)
{
    if (!probe.enabled || probe.done) return;
    probe.done = true;
    var cube = GlobalIllumination.BuildPlacementMesh(giBox);
    var sphere = GlobalIllumination.BuildPlacementMesh(giSphere);
    var plane = GlobalIllumination.BuildPlacementMesh(giQuad);
    probe.cubeClosed = cube.closed;
    probe.sphereClosed = sphere.closed;
    probe.planeClosed = plane.closed;
    probe.hits[0] = GlobalIllumination.PlacementSurface(cube, float4x4.identity, float3(0), 1);
    probe.hits[1] = GlobalIllumination.PlacementSurface(cube, float4x4.identity, float3(1, 0, 0), 2);
    probe.hits[2] = GlobalIllumination.PlacementSurface(cube,
        float4x4.TRS(float3(0), quaternion.identity, float3(-2, 1, 3)), float3(-2, 0, 0), 2);
    probe.hits[3] = GlobalIllumination.PlacementSurface(cube,
        float4x4(float4(1, 0, 0, 0), float4(1, 1, 0, 0), float4(0, 0, 1, 0), float4(0, 0, 0, 1)),
        float3(0.8, 0.1, 0), 1);
    probe.hits[4] = GlobalIllumination.PlacementSurface(sphere, float4x4.identity, float3(-0.55, -0.25, -0.15), 1);
    mut GlobalIllumination.PlacementMesh room = cube;
    for (var i = 0; i < room.triangles.count; i++)
    {
        float3 saved = room.triangles[i].b;
        room.triangles[i].b = room.triangles[i].c;
        room.triangles[i].c = saved;
    }
    probe.hits[5] = GlobalIllumination.PlacementSurface(room, float4x4.identity, float3(0), 1);
    probe.hits[6] = GlobalIllumination.PlacementSurface(plane, float4x4.identity, float3(0, 0, -0.01), 1);
    probe.hits[7] = GlobalIllumination.PlacementSurface(cube,
        float4x4.TRS(float3(0), quaternion.identity, float3(1, 0, 1)), float3(0), 1);
    probe.hits[8] = GlobalIllumination.PlacementSurface(cube, float4x4.identity, probe.invalidPoint, 1);
    probe.hits[9] = GlobalIllumination.PlacementSurface(cube, probe.invalidTransform, float3(0), 1);
    probe.hits[10] = GlobalIllumination.PlacementSurface(cube, float4x4.identity, float3(0), probe.invalidRadius);
    mut GlobalIllumination.PlacementMesh separated = default;
    for (var side = 0; side < 2; side++)
    {
        float3 offset = float3(side == 0 ? -2 : 2, 0, 0);
        foreach (var triangle in cube.triangles)
            separated.triangles.Add(GlobalIllumination.PlacementTriangle {
                a = triangle.a + offset, b = triangle.b + offset, c = triangle.c + offset,
                source = triangle.source + side * cube.triangles.count
            });
    }
    separated.BuildBranch(0, separated.triangles.count);
    separated.closed = cube.closed;
    separated.valid = true;
    probe.hits[11] = GlobalIllumination.PlacementSurface(separated, float4x4.identity, float3(0), 2);
    probe.hits[12] = GlobalIllumination.PlacementSurface(cube, float4x4.identity, float3(1, 0, 0), 0.49);
    probe.hits[13] = GlobalIllumination.PlacementSurface(cube, float4x4.identity, float3(0.5, 0, 0), 1);
    probe.hits[14] = GlobalIllumination.PlacementSurface(cube,
        float4x4.TRS(float3(0), quaternion.identity, float3(0.00000001, 1, 1)), float3(0), 1);
    probe.hits[15] = GlobalIllumination.PlacementSurface(cube, float4x4.identity, float3(0.50001, 0, 0), 1);
    mut GlobalIllumination.WorldBounds bounds = default;
    bounds.staticBounds.Add(GlobalIllumination.StaticBounds { placement = cube });
    var unit = GlobalIllumination.PlacementInstance {
        slot = 0, transform = float4x4.identity,
        bounds = GlobalIllumination.LocalBounds { valid = true, minimum = float3(-0.5), maximum = float3(0.5) }
    };
    probe.relocated = GlobalIllumination.RelocateProbe(bounds, [unit], float3(0.4, 0, 0), float3(0), 1);
    probe.retained = GlobalIllumination.RelocateProbe(bounds, [unit], float3(0.4, 0, 0), probe.relocated, 1);
    probe.unresolved = GlobalIllumination.RelocateProbe(bounds, [unit], float3(0), float3(0), 1);
    var huge = GlobalIllumination.PlacementInstance {
        slot = 0, transform = float4x4.TRS(float3(0), quaternion.identity, float3(1e24)),
        bounds = GlobalIllumination.LocalBounds { valid = true, minimum = float3(-5e23), maximum = float3(5e23) }
    };
    probe.largeUnresolved = GlobalIllumination.RelocateProbe(bounds, [huge], float3(4.8e23, 0, 0), float3(0), 1e22);
}
