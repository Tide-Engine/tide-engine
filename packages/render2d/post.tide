namespace Render2D;

struct BloomSettings
{
    bool enabled;
    float threshold = 1;
    float softness = 0.5;
    float intensity = 0.2;
    float radius = 1;
}

local singleton PostState
{
    RenderTarget bright;
    RenderTarget scratch;
    RenderTarget composite;
    Texture glow;
    bool ready;
}

float3 BloomRadiance(Color color)
{
    return Math.Clamp(float3(color.r, color.g, color.b), float3(0), float3(65504));
}

float3 BloomBright(float3 radiance, BloomSettings settings)
{
    float3 light = Math.Clamp(radiance, float3(0), float3(65504));
    float brightness = Math.Max(Math.Max(light.x, light.y), light.z);
    float threshold = Math.Clamp(settings.threshold, 0, 65504);
    float knee = Math.Clamp(settings.softness, 0, 65504);
    mut float excess = Math.Max(brightness - threshold, 0);
    if (knee > 0)
    {
        float soft = Math.Clamp(brightness - threshold + knee, 0, 2 * knee);
        excess = Math.Max(excess, soft * soft / (4 * knee));
    }
    return light * (Math.Min(excess, brightness) / Math.Max(brightness, 0.00001));
}

void DisposeBloom(mut PostState post)
{
    post.bright.Dispose();
    post.scratch.Dispose();
    post.composite.Dispose();
    post.bright = default;
    post.scratch = default;
    post.composite = default;
    post.glow = default;
    post.ready = false;
}

// Release before recording any passes that could still reference the images.
[Stage(Stages.Prepare, 1)]
view PrepareBloom(Renderer renderer, mut PostState post)
{
    if (post.ready && (!renderer.enabled || !renderer.bloom.enabled || renderer.bloom.intensity <= 0))
        DisposeBloom(post);
}

frag ExtractBloom(Vertex vertex, out Color color, Texture source, BloomSettings settings)
{
    float2 pixel = 1.0 / float2(Math.Max(source.size, int2(1)));
    float3 light = (BloomRadiance(source.Sample(vertex.uv + float2(-pixel.x, -pixel.y), Filter.Bilinear, Wrap.Clamp))
                  + BloomRadiance(source.Sample(vertex.uv + float2(pixel.x, -pixel.y), Filter.Bilinear, Wrap.Clamp))
                  + BloomRadiance(source.Sample(vertex.uv + float2(-pixel.x, pixel.y), Filter.Bilinear, Wrap.Clamp))
                  + BloomRadiance(source.Sample(vertex.uv + float2(pixel.x, pixel.y), Filter.Bilinear, Wrap.Clamp))) * 0.25;
    color = Color(BloomBright(light, settings), 1);
}

struct BloomStep { float2 direction; }

frag BlurBloom(Vertex vertex, out Color color, Texture source, BloomStep step)
{
    float2 pixel = step.direction / float2(Math.Max(source.size, int2(1)));
    float2 near = pixel * (18.0 / 13);
    float2 far = pixel * (42.0 / 13);
    float3 light = BloomRadiance(source.Sample(vertex.uv, Filter.Bilinear, Wrap.Clamp)) * (84.0 / 370)
        + (BloomRadiance(source.Sample(vertex.uv + near, Filter.Bilinear, Wrap.Clamp))
         + BloomRadiance(source.Sample(vertex.uv - near, Filter.Bilinear, Wrap.Clamp))) * (117.0 / 370)
        + (BloomRadiance(source.Sample(vertex.uv + far, Filter.Bilinear, Wrap.Clamp))
         + BloomRadiance(source.Sample(vertex.uv - far, Filter.Bilinear, Wrap.Clamp))) * (26.0 / 370);
    color = Color(Math.Clamp(light, float3(0), float3(65504)), 1);
}

frag CompositeBloom(Vertex vertex, out Color color, Texture source, PostState post, BloomSettings settings)
{
    float3 light = BloomRadiance(source.Sample(vertex.uv, Filter.Bilinear, Wrap.Clamp));
    float3 glow = BloomRadiance(post.glow.Sample(vertex.uv, Filter.Bilinear, Wrap.Clamp));
    color = Color(Math.Clamp(light + glow * Math.Clamp(settings.intensity, 0, 4), float3(0), float3(65504)), 1);
}

[Stage(Stages.PostProcess)]
view Bloom(mut Renderer renderer, mut PostState post)
{
    if (!renderer.enabled || !renderer.ready || !renderer.bloom.enabled || renderer.bloom.intensity <= 0) return;
    if (!post.ready)
    {
        post.bright = RenderTarget.Window(0.25, Format.Rgba16f);
        post.scratch = RenderTarget.Window(0.25, Format.Rgba16f);
        post.composite = RenderTarget.Window(Format.Rgba16f);
        post.ready = true;
    }
    Draw.Blit(renderer.output, post.bright, ExtractBloom, renderer.bloom);
    float radius = Math.Clamp(renderer.bloom.radius, 0, 8);
    if (radius > 0)
    {
        Draw.Blit(post.bright.color, post.scratch, BlurBloom, BloomStep { direction = float2(radius, 0) });
        Draw.Blit(post.scratch.color, post.bright, BlurBloom, BloomStep { direction = float2(0, radius) });
    }
    post.glow = post.bright.color;
    Draw.Blit(renderer.output, post.composite, CompositeBloom, renderer.bloom);
    renderer.output = post.composite.color;
}
