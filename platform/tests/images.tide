local singleton Images
{
    RenderTarget painted;
    RenderTarget before;
    RenderTarget after;
    Texture image;
    Texture3D volume;
    Texture3D alias;
    Texture3D colors;
    Texture3D numbers;
    Grid3<Color> cells = Grid3(2, 2, 2);
    Grid3<float> floats = Grid3(2, 2, 2);
    List<Vertex> quad;
    int frames;
    long revision;
}

struct Paint { Color color; }
struct Probe { float3 uv; int mode; }

[Group(4, 4)]
compute PaintImage(Images images, Paint paint)
{
    images.image[this.at.xy] = paint.color;
}

[Group(4, 4)]
compute PaintDirect(Images images)
{
    images.painted.color[this.at.xy] = Color.green;
}

[Group(2, 2, 2)]
compute PaintVolume(Images images)
{
    images.volume[this.at] = Color(float(this.at.x), float(this.at.y), float(this.at.z), 1);
}

compute Outside(Images images)
{
    images.image[int2(-1, 0)] = Color.white;
    images.image[int2(8, 0)] = Color.white;
    images.image[int2(2147483647)] = Color.white;
    images.volume[int3(-1)] = Color.white;
    images.volume[int3(2, 0, 0)] = Color.white;
    images.volume[int3(2147483647)] = Color.white;
}

compute Aliased(Images images)
{
    images.volume[this.at] = images.alias.Sample(float3(0.25)) + Color.green;
}

frag Image(Vertex vertex, out Color color, Texture source)
{
    Color read = source.Sample(vertex.uv, Filter.Point);
    color = Color(read.r, read.g, read.b, 1);
}

frag RoundTrip(Vertex vertex, out Color color, Texture source)
{
    Color read = source.Sample(vertex.uv, Filter.Point);
    color = read.r == 1 && read.g == 0.25 && read.b == 0.5 && read.a == 0.5 ? Color.blue : Color.red;
}

frag Volume(Vertex vertex, out Color color, Images images, Probe probe)
{
    if (probe.mode == 0) color = images.volume.Sample(probe.uv);
    else if (probe.mode == 1) color = images.colors.Sample(probe.uv);
    else if (probe.mode == 2) color = images.numbers.Sample(probe.uv);
    else color = images.volume[int3(1, 0, 1)];
}

view Show(mut Images images)
{
    if (images.frames == 0)
    {
        images.painted = RenderTarget(8, 8, 1, Format.Rgba16f);
        images.before = RenderTarget(8, 8, 1);
        images.after = RenderTarget(8, 8, 1);
        images.image = images.painted.color;
        images.volume = Texture3D(int3(2));
        images.alias = images.volume;
        for (var z = 0; z < 2; z++)
            for (var y = 0; y < 2; y++)
                for (var x = 0; x < 2; x++)
                {
                    images.cells[x, y, z] = Color(float(x), float(y), float(z), 1);
                    images.floats[x, y, z] = float(x + y + z);
                }
        images.colors = images.cells;
        images.numbers = images.floats;
        images.quad = [Vertex { position = float2(0, 0), uv = float2(0, 0) },
                       Vertex { position = float2(8, 0), uv = float2(1, 0) },
                       Vertex { position = float2(8, 8), uv = float2(1, 1) },
                       Vertex { position = float2(0, 8), uv = float2(0, 1) }];
    }
    images.frames++;
    images.cells[0, 0, 0] = Color(float(images.frames % 2), 0, 0, 1);
    images.colors = images.cells;
    Draw.SetScreen();
    Draw.Clear(Color.black);
    images.painted.Clear(Color.black);
    Draw.Blit(images.image, images.before, Image);
    GPU.Run(PaintImage, int2(8), Paint { color = Color(1, 0.25, 0.5, 0.5) });
    Draw.Blit(images.image, images.after, RoundTrip);
    GPU.Run(PaintDirect, int2(8));
    long revision = images.volume.contentRevision;
    if (images.revision != revision) GPU.Run(PaintVolume, int3(2));
    GPU.Run(Outside, 1);
    GPU.Run(Aliased, 1); // Rejected at runtime: two fields name the same image. Existing cells must stay intact.
    Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], images.before.color, Image);
    Draw.Transform(float2(8, 0)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], images.after.color, Image); }
    Draw.Transform(float2(16, 0)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], images.image, Image); }
    Draw.Transform(float2(0, 8)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], Volume, Probe { uv = float3(0.5, 0.25, 0.25), mode = 0 }); }
    Draw.Transform(float2(8, 8)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], Volume, Probe { uv = float3(0.25, 0.5, 0.25), mode = 0 }); }
    Draw.Transform(float2(16, 8)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], Volume, Probe { uv = float3(0.25, 0.25, 0.5), mode = 0 }); }
    Draw.Transform(float2(0, 16)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], Volume, Probe { uv = float3(0.5), mode = 1 }); }
    Draw.Transform(float2(8, 16)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], Volume, Probe { uv = float3(0.5), mode = 2 }); }
    Draw.Transform(float2(16, 16)) { Draw.Mesh(images.quad, [0, 1, 2, 0, 2, 3], Volume, Probe { uv = float3(0), mode = 3 }); }
    images.revision = revision;
}

scene Main { }

local singleton NumberImages
{
    RenderTarget r8;
    RenderTarget rg8;
    RenderTarget r16;
    RenderTarget rg16;
    RenderTarget r32;
    RenderTarget rgba16;
    RenderTarget rgba32;
    RenderTarget ids;
    [Raw(float)] Texture one8;
    [Raw(float2)] Texture two8;
    [Raw(float)] Texture one16;
    [Raw(float2)] Texture two16;
    [Raw(float)] Texture one32;
    [Raw(float4)] Texture four16;
    [Raw(float4)] Texture four32;
    [Raw(int)] Texture integer;
    [Raw(float)] Texture3D scalarVolume;
    [Raw(float4)] Texture3D vectorVolume;
    [Raw(int)] Texture3D integerVolume;
    [Raw(int)] Texture missingInteger;
    [Raw(int)] Texture3D missingIntegerVolume;
    [Raw(float4)] Texture missingNumber;
    [Raw(float4)] Texture3D missingNumberVolume;
    List<Vertex> quad;
    bool made;
}
struct NumberProbe { int mode; }
frag OneNumber(Vertex vertex, out float value) { value = 1.5; }
frag TwoNumbers(Vertex vertex, out float2 value) { value = float2(1.5, -0.5); }
frag FourNumbers(Vertex vertex, out float4 value) { value = float4(1.5, -0.5, 2, 0.125); }
frag IntegerNumber(Vertex vertex, out int value) { value = -16777217; }
bool SameTwo(float2 a, float2 b) { return a.x == b.x && a.y == b.y; }
bool SameFour(float4 a, float4 b) { return a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w; }
frag CheckNumbers(Vertex vertex, out Color color, NumberImages images, NumberProbe probe)
{
    mut bool good = false;
    if (probe.mode == 0) good = images.one8.Sample(vertex.uv) == 1;
    else if (probe.mode == 1) good = SameTwo(images.two8.Sample(vertex.uv), float2(1, 0));
    else if (probe.mode == 2) good = images.one16.Sample(vertex.uv) == 1.5;
    else if (probe.mode == 3) good = SameTwo(images.two16.Sample(vertex.uv), float2(1.5, -0.5));
    else if (probe.mode == 4) good = images.one32.Sample(vertex.uv) == 1.5;
    else if (probe.mode == 5) good = SameFour(images.four16.Sample(vertex.uv), float4(1.5, -0.5, 2, 0.125));
    else if (probe.mode == 6) good = SameFour(images.four32.Sample(vertex.uv), float4(1.5, -0.5, 2, 0.125));
    else if (probe.mode == 7) good = images.integer.Sample(vertex.uv) == -16777217;
    else if (probe.mode == 8) good = images.one32.Sample(float2(0.0625)) == 9.5;
    else if (probe.mode == 9) good = SameFour(images.four32.Sample(float2(0.0625)), float4(9.5, -3, 4, 0.25));
    else if (probe.mode == 10) good = images.integer.Sample(float2(0.0625)) == -33554433;
    else if (probe.mode == 11) good = images.scalarVolume.Sample(float3(0.75)) == 9.5;
    else if (probe.mode == 12) good = SameFour(images.vectorVolume.Sample(float3(0.75)), float4(9.5, -3, 4, 0.25));
    else good = images.integerVolume.Sample(float3(0.75)) == -33554433
        && images.missingInteger.Sample(vertex.uv) == 0 && images.missingIntegerVolume.Sample(float3(0.5)) == 0
        && SameFour(images.missingNumber.Sample(vertex.uv), float4(0))
        && SameFour(images.missingNumberVolume.Sample(float3(0.5)), float4(0));
    color = good ? Color.green : Color.red;
}
[Group(2, 2, 2)]
compute FillNumberVolumes(NumberImages images)
{
    images.scalarVolume[this.at] = 9.5;
    images.vectorVolume[this.at] = float4(9.5, -3, 4, 0.25);
    images.integerVolume[this.at] = -33554433;
}
[Group(2, 2)]
compute FillNumbers(NumberImages images)
{
    if (this.at.z == 0)
    {
        images.one32[this.at.xy] = 9.5;
        images.four32[this.at.xy] = float4(9.5, -3, 4, 0.25);
        images.integer[this.at.xy] = -33554433;
    }
}
view ShowNumbers(mut NumberImages images)
{
    if (!images.made)
    {
        images.r8 = RenderTarget(8, 8, 1, Format.R8);
        images.rg8 = RenderTarget(8, 8, 1, Format.Rg8);
        images.r16 = RenderTarget(8, 8, 1, Format.R16f, samples: 4);
        images.rg16 = RenderTarget(8, 8, 1, Format.Rg16f, samples: 4);
        images.r32 = RenderTarget(8, 8, 1, Format.R32f);
        images.rgba16 = RenderTarget(8, 8, 1, Format.Rgba16f);
        images.rgba32 = RenderTarget(8, 8, 1, Format.Rgba32f);
        images.ids = RenderTarget(8, 8, 1, Format.R32i);
        images.one8 = images.r8.color;
        images.two8 = images.rg8.color;
        images.one16 = images.r16.color;
        images.two16 = images.rg16.color;
        images.one32 = images.r32.color;
        images.four16 = images.rgba16.color;
        images.four32 = images.rgba32.color;
        images.integer = images.ids.color;
        images.scalarVolume = Texture3D(int3(2), Format.R32f);
        images.vectorVolume = Texture3D(int3(2), Format.Rgba32f);
        images.integerVolume = Texture3D(int3(2), Format.R32i);
        images.quad = [Vertex { position = float2(0, 0), uv = float2(0, 0) },
                       Vertex { position = float2(8, 0), uv = float2(1, 0) },
                       Vertex { position = float2(8, 8), uv = float2(1, 1) },
                       Vertex { position = float2(0, 8), uv = float2(0, 1) }];
        images.made = true;
    }
    images.r8.SetScreen(); images.rg8.SetScreen(); images.r16.SetScreen(); images.rg16.SetScreen();
    images.r32.SetScreen(); images.rgba16.SetScreen(); images.rgba32.SetScreen(); images.ids.SetScreen();
    images.r8.Tint(Color(0, 0, 0, 0)) { images.r8.Mesh(images.quad, [0,1,2,0,2,3], OneNumber); }
    images.rg8.Tint(Color(0, 0, 0, 0)) { images.rg8.Mesh(images.quad, [0,1,2,0,2,3], TwoNumbers); }
    images.r16.Tint(Color(0, 0, 0, 0)) { images.r16.Mesh(images.quad, [0,1,2,0,2,3], OneNumber); }
    images.rg16.Tint(Color(0, 0, 0, 0)) { images.rg16.Mesh(images.quad, [0,1,2,0,2,3], TwoNumbers); }
    images.r32.Tint(Color(0, 0, 0, 0)) { images.r32.Mesh(images.quad, [0,1,2,0,2,3], OneNumber); }
    images.rgba16.Tint(Color(0, 0, 0, 0)) { images.rgba16.Mesh(images.quad, [0,1,2,0,2,3], FourNumbers); }
    images.rgba32.Tint(Color(0, 0, 0, 0)) { images.rgba32.Mesh(images.quad, [0,1,2,0,2,3], FourNumbers); }
    images.ids.Tint(Color(0, 0, 0, 0)) { images.ids.Mesh(images.quad, [0,1,2,0,2,3], IntegerNumber); }
    for (var i = 0; i < 8; i++)
        Draw.Transform(float2(float(i % 3) * 8, 24 + float(i / 3) * 8))
        { Draw.Mesh(images.quad, [0,1,2,0,2,3], CheckNumbers, NumberProbe { mode = i }); }
    GPU.Run(FillNumbers, int2(2));
    GPU.Run(FillNumberVolumes, int3(2));
    for (var i = 0; i < 6; i++)
        Draw.Transform(float2(float(i % 3) * 8, 48 + float(i / 3) * 8))
        { Draw.Mesh(images.quad, [0,1,2,0,2,3], CheckNumbers, NumberProbe { mode = 8 + i }); }
}

local singleton MixedImages
{
    RenderTarget target;
    Texture color;
    [Raw(float4)] Texture numbers;
    [Raw(int)] Texture identity;
    bool made;
}
frag FillMixed(Vertex vertex, out Color color, out float4 numbers, out int identity)
{
    color = Color(1, 0, 0, 0.5);
    numbers = float4(1.5, -0.5, 2, 0.125);
    identity = -16777217;
}
frag CheckMixed(Vertex vertex, out Color color, MixedImages images, NumberProbe probe)
{
    mut bool good = false;
    if (probe.mode == 0)
    {
        Color stored = images.color.Sample(vertex.uv);
        good = stored.r == 0.21875 && stored.g == 0 && stored.b == 0 && stored.a == 1;
    }
    else if (probe.mode == 1) good = SameFour(images.numbers.Sample(vertex.uv), float4(1.5, -0.5, 2, 0.125));
    else good = images.identity.Sample(vertex.uv) == -16777217;
    color = good ? Color.green : Color.red;
}
view DrawMixed(mut MixedImages mixed, NumberImages images)
{
    if (!mixed.made)
    {
        mixed.target = RenderTarget(8, 8, 1, Format.Rgba16f, Format.Rgba32f, Format.R32i);
        mixed.color = mixed.target.colors[0];
        mixed.numbers = mixed.target.colors[1];
        mixed.identity = mixed.target.colors[2];
        mixed.made = true;
    }
    mixed.target.SetScreen();
    mixed.target.Clear(Color.black, float4(0), 0);
    mixed.target.Tint(Color(0.5, 1, 1, 0.5))
    {
        mixed.target.Mesh(images.quad, [0,1,2,0,2,3], FillMixed);
        mixed.target.Mesh(images.quad, [0,1,2,0,2,3], FillMixed);
    }
    for (var i = 0; i < 3; i++)
        Draw.Transform(float2(float(i) * 8, 64))
        { Draw.Mesh(images.quad, [0,1,2,0,2,3], CheckMixed, NumberProbe { mode = i }); }
}

// Number images through a blending sampler: a midpoint between two pixels, a mip level made of what was drawn,
// gradients, an array's layer and a cube's face, and zeros where no image is given.
local singleton FilteredImages
{
    RenderTarget r8;
    RenderTarget r16;
    RenderTarget rg16;
    RenderTarget rgba16;
    [Raw(float)] Texture one8;
    [Raw(float)] Texture one16;
    [Raw(float2)] Texture two16;
    [Raw(float4)] Texture four16;
    [Raw(float)] Texture missing;
    [Raw(float)] TextureArray layers;
    [Raw(float2)] TextureArray pairs;
    [Raw(float4)] TextureArray missingLayers;   // Four channels: zeros' alpha is 0, the white array's and dark cube's 1
    [Raw(float)] Cubemap cube;
    [Raw(float2)] Cubemap pairCube;
    [Raw(float4)] Cubemap missingCube;
    RenderTarget smooth16;
    RenderTarget smoothColor;
    [Raw(float)] Texture smooth;
    Texture smoothColorImage;
    bool made;
}
frag HalfOne(Vertex vertex, out float value) { value = vertex.uv.x < 0.5 ? 0 : 3; }
frag HalfColor(Vertex vertex, out Color color) { color = vertex.uv.x < 0.5 ? Color.black : Color.white; }
frag HalfTwo(Vertex vertex, out float2 value) { value = vertex.uv.x < 0.5 ? float2(0, 1) : float2(3, -1); }
frag HalfFour(Vertex vertex, out float4 value) { value = vertex.uv.x < 0.5 ? float4(0, 0, 0, 1) : float4(3, -1, 2, 0); }
bool Near(float a, float b) { return Math.Abs(a - b) < 0.02; }
bool NearTwo(float2 a, float2 b) { return Near(a.x, b.x) && Near(a.y, b.y); }
bool NearFour(float4 a, float4 b) { return Near(a.x, b.x) && Near(a.y, b.y) && Near(a.z, b.z) && Near(a.w, b.w); }
float Blended([Raw(float)] Texture image, float2 uv) { return image.Sample(uv, Filter.Bilinear); }
float LayerLevel([Raw(float)] TextureArray layers, float2 uv, int layer, float level) { return layers.SampleLevel(uv, layer, level); }
frag CheckFiltered(Vertex vertex, out Color color, FilteredImages images, NumberProbe probe)
{
    mut bool good = false;
    float2 middle = float2(0.5);
    if (probe.mode == 0) good = Near(images.one8.Sample(middle, Filter.Bilinear), 0.5) && images.one8.Sample(middle) == 1;
    else if (probe.mode == 1) good = Near(Blended(images.one16, middle), 1.5) && images.one16.Sample(middle, Filter.Point) == 3;
    else if (probe.mode == 2) good = Near(images.one16.SampleLevel(vertex.uv, 3), 1.5)
        && Near(images.one16.SampleLevel(float2(0.25, 0.5), 1, Filter.Bilinear), 0)
        && Near(images.one16.SampleLevel(float2(0.75, 0.5), 1, Filter.Bilinear), 3)
        && Near(images.one8.SampleLevel(vertex.uv, 3), 0.5);
    else if (probe.mode == 3) good = Near(images.one16.SampleGrad(vertex.uv, float2(1, 0), float2(0, 1)), 1.5);
    else if (probe.mode == 4) good = NearTwo(images.two16.Sample(middle, Filter.Bilinear), float2(1.5, 0))
        && NearTwo(images.two16.SampleLevel(vertex.uv, 3, Filter.Trilinear), float2(1.5, 0));
    else if (probe.mode == 5) good = NearFour(images.four16.Sample(middle, Filter.Bilinear), float4(1.5, -0.5, 1, 0.5))
        && NearFour(images.four16.SampleLevel(vertex.uv, 3), float4(1.5, -0.5, 1, 0.5));
    else if (probe.mode == 6) good = images.missing.Sample(vertex.uv, Filter.Bilinear) == 0 && images.missing.SampleLevel(vertex.uv, 1) == 0
        && NearFour(images.missingLayers.Sample(vertex.uv, 0, Filter.Bilinear), float4(0))
        && NearFour(images.missingCube.Sample(float3(0, 0, 1), Filter.Bilinear), float4(0));
    else if (probe.mode == 7) good = images.layers.Sample(vertex.uv, 0) == 0.25
        && Near(images.layers.Sample(middle, 1, Filter.Bilinear), 1.5) && images.layers.Sample(middle, 1) == 3;
    else if (probe.mode == 8) good = Near(LayerLevel(images.layers, vertex.uv, 1, 3), 1.5)
        && Near(images.layers.SampleLevel(vertex.uv, 0, 3.0), 0.25);
    else if (probe.mode == 9) good = NearTwo(images.pairs.Sample(middle, 1, Filter.Bilinear), float2(0.5, 0.5))
        && NearTwo(images.pairs.Sample(middle, 0), float2(0, 0));
    else if (probe.mode == 10) good = Near(images.cube.Sample(float3(0, 0, 1), Filter.Bilinear), 1.5)
        && images.cube.Sample(float3(1, 0, 0)) == 2 && images.cube.Sample(float3(0, -1, 0), Filter.Bilinear) == 2;
    else if (probe.mode == 11) good = Near(images.cube.SampleLevel(float3(0, 0, 1), 3), 1.5)
        && NearTwo(images.pairCube.Sample(float3(0, 1, 0), Filter.Bilinear), float2(1.5, 0));
    // A multisampled target's smaller images, made of what its samples came to, as any target's
    else if (probe.mode == 12) good = Near(images.smooth.SampleLevel(vertex.uv, 3), 1.5) && images.smooth.Sample(vertex.uv) == 3;
    else
    {
        Color level = images.smoothColorImage.SampleLevel(vertex.uv, 3, Filter.Trilinear);
        good = Near(level.r, 0.5) && Near(level.g, 0.5) && Near(level.b, 0.5)
            && images.smoothColorImage.SampleLevel(vertex.uv, 0, Filter.Trilinear).r == 1;
    }
    color = good ? Color.green : Color.red;
}
view ShowFiltered(mut FilteredImages images, NumberImages numbers)
{
    if (!images.made)
    {
        images.r8 = RenderTarget(8, 8, 1, Format.R8);
        images.r16 = RenderTarget(8, 8, 1, Format.R16f);
        images.rg16 = RenderTarget(8, 8, 1, Format.Rg16f);
        images.rgba16 = RenderTarget(8, 8, 1, Format.Rgba16f);
        images.one8 = images.r8.color;
        images.one16 = images.r16.color;
        images.two16 = images.rg16.color;
        images.four16 = images.rgba16.color;
        images.layers = TextureArray(8, 8, 2, 1, Format.R16f);
        images.pairs = TextureArray(8, 8, 2, 1, Format.Rg8);
        images.cube = Cubemap(8, Format.R16f);
        images.pairCube = Cubemap(8, Format.Rg16f);
        images.smooth16 = RenderTarget(8, 8, 1, Format.R16f, samples: 4);
        images.smoothColor = RenderTarget(8, 8, 1, samples: 4);
        images.smooth = images.smooth16.color;
        images.smoothColorImage = images.smoothColor.color;
        images.made = true;
    }
    images.r8.SetScreen(); images.r16.SetScreen(); images.rg16.SetScreen(); images.rgba16.SetScreen();
    images.r8.Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.r16.Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.rg16.Mesh(numbers.quad, [0,1,2,0,2,3], HalfTwo);
    images.rgba16.Mesh(numbers.quad, [0,1,2,0,2,3], HalfFour);
    images.layers.layers[0].Clear(0.25);
    images.layers.layers[1].SetScreen();
    images.layers.layers[1].Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.pairs.layers[0].Clear(float2(0, 0));
    images.pairs.layers[1].SetScreen();
    images.pairs.layers[1].Mesh(numbers.quad, [0,1,2,0,2,3], HalfTwo);
    for (var face = 0; face < 6; face++) images.cube.faces[face].Clear(2.0);
    images.cube.faces[4].SetScreen();
    images.cube.faces[4].Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.pairCube.faces[2].SetScreen();
    images.pairCube.faces[2].Mesh(numbers.quad, [0,1,2,0,2,3], HalfTwo);
    images.smooth16.SetScreen(); images.smoothColor.SetScreen();
    images.smooth16.Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.smoothColor.Mesh(numbers.quad, [0,1,2,0,2,3], HalfColor);
    for (var i = 0; i < 14; i++)
        Draw.Transform(float2(float(i % 3) * 8, 72 + float(i / 3) * 8))
        { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], CheckFiltered, NumberProbe { mode = i }); }
}

// Images whose format the compiler can't follow: a Color read handed an integer image reads as no image, and a
// kernel whose field the host's C re-made in another format behind the code's back (images.c: tidec follows every
// origin Tide code gives a field, `out` and `mut` arguments too, and refuses what it can't) writes nothing. Neither
// may reach a GPU binding of another format.
local singleton Mismatched
{
    RenderTarget ids;
    RenderTarget scene;
    Texture source;
    Texture3D volume;
    // An int read of a float grid's R16F image, as a hot reload from [Raw(float)] to [Raw(int)] would have left it
    // before roles were told apart: images.c puts `floats` in `numbers`
    Grid2<float> heights = Grid2(2, 2);
    Texture floats;
    [Raw(int)] Texture numbers;
    int frames;
    bool made;
}
[Group(2, 2, 2)]
compute FillMismatched(Mismatched images) { images.volume[this.at] = Color(1, 0, 0, 1); }
frag ReadMismatched(Vertex vertex, out Color color, Mismatched images, NumberProbe probe)
{
    if (probe.mode == 0) color = images.source.Sample(vertex.uv, Filter.Bilinear);
    else if (probe.mode == 1) color = images.volume.Sample(float3(0.5));
    else if (probe.mode == 2) color = images.numbers.Sample(vertex.uv) == 0 ? Color.green : Color.red;
    else color = images.source.Sample(vertex.uv, Filter.Trilinear); // ...between smaller images, which it has none of
}
view ShowMismatched(mut Mismatched images, NumberImages numbers)
{
    if (!images.made)
    {
        images.ids = RenderTarget(8, 8, 1, Format.R32i);
        images.scene = RenderTarget(8, 8, 1);
        images.volume = Texture3D(int3(2));
        images.heights[0, 0] = 3.5;
        images.floats = images.heights;
        images.numbers = images.ids.color;
        images.made = true;
    }
    images.frames++;
    images.ids.Clear(7);
    images.scene.Clear(Color.blue);
    images.source = images.frames > 0 ? images.ids.color : images.scene.color;
    GPU.Run(FillMismatched, int3(2));
    for (var i = 0; i < 4; i++)
        Draw.Transform(float2(float(i % 3) * 8, 112 + float(i / 3) * 8))
        { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], ReadMismatched, NumberProbe { mode = i }); }
}

// 32-bit numbers loaded exactly and blended in the shader, the same bits on every device: a Texture's, an array's
// layers and a cube's faces (six layers), and a volume's eight cells; a typed Rgba16f volume and a Grid3<float>'s
// blended through the GPU's sampler; SampleLevel that names no filter reading between levels of a Color texture, cube
// and array; and a depth cube read by a direction, as a number and compared, under either depth storage.
local singleton ExactImages
{
    RenderTarget r32;
    RenderTarget rgba32;
    RenderTarget colors;
    [Raw(float)] Texture one32;
    [Raw(float4)] Texture four32;
    Texture color;
    [Raw(float)] TextureArray depths;
    [Raw(float4)] TextureArray points;
    [Raw(int)] TextureArray ids;
    [Raw(float)] Cubemap far;
    [Raw(int)] Cubemap faceIds;
    [Raw(float4)] Cubemap rays;
    [Raw(float)] Texture3D exactVolume;
    [Raw(float4)] Texture3D halfVolume;
    [Raw(float)] Texture3D gridVolume;
    Grid3<float> cells = Grid3(2, 2, 2);
    Cubemap sky;
    TextureArray painted;
    Cubemap lamp;
    DepthCubemap shadows;
    [Raw(float)] TextureArray missingDepths;
    [Raw(int)] TextureArray missingIds;
    [Raw(int)] Cubemap missingFaces;
    DepthCubemap missingShadows;
    float depth;
    bool made;
}
frag HalfWide(Vertex vertex, out float4 value) { value = vertex.uv.x < 0.5 ? float4(0, 0, 0, 1) : float4(3, -1, 1000000000, 0); }
frag ExactDepth(Vertex3 vertex, out Color color, ExactImages images) { color = Color.white; this.WriteDepth(images.depth); }
float Exact([Raw(float)] Texture image, float2 uv) { return image.Sample(uv, Filter.Bilinear); }
float CubeDepth(DepthCubemap shadows, float3 way) { return shadows.Sample(way); }
bool DepthNear(float a, float b) { return Math.Abs(a - b) < 0.0001; }
frag CheckSource(Vertex vertex, out Color color, [Raw(float)] Texture source)
{
    color = source.Sample(float2(0.5), Filter.Bilinear) == 1.5 && source.Sample(float2(0.5)) == 3 ? Color.green : Color.red;
}
[Group(2, 2, 2)]
compute FillExactVolumes(ExactImages images)
{
    images.exactVolume[this.at] = float(this.at.x + 2 * this.at.y + 4 * this.at.z);
    images.halfVolume[this.at] = float4(float(this.at.x), float(this.at.y), float(this.at.z) * 2, 0.25);
}
frag CheckExact(Vertex vertex, out Color color, ExactImages images, NumberProbe probe)
{
    mut bool good = false;
    float2 middle = float2(0.5);
    if (probe.mode == 0) good = images.one32.Sample(middle, Filter.Bilinear) == 1.5 && images.one32.Sample(middle) == 3
        && images.one32.Sample(float2(0, 0.5), Filter.Bilinear, Wrap.Repeat) == 1.5
        && images.one32.Sample(float2(0, 0.5), Filter.Bilinear, Wrap.Mirror) == 0
        && images.one32.Sample(float2(0, 0.5), Filter.Bilinear) == 0 && Exact(images.one32, middle) == 1.5;
    else if (probe.mode == 1) good = SameFour(images.four32.Sample(middle, Filter.Bilinear), float4(1.5, -0.5, 500000000, 0.5));
    else if (probe.mode == 2) good = images.depths.Sample(vertex.uv, 0) == 9.5 && images.depths.Sample(middle, 1) == 3
        && images.depths.Sample(middle, 1, Filter.Bilinear) == 1.5 && images.depths.Sample(middle, 7) == 3;
    else if (probe.mode == 3) good = SameFour(images.points.Sample(middle, 1, Filter.Bilinear), float4(1.5, -0.5, 500000000, 0.5))
        && SameFour(images.points.Sample(vertex.uv, 0), float4(1, 2, 3, 4));
    else if (probe.mode == 4) good = images.ids.Sample(vertex.uv, 0) == -33554433 && images.ids.Sample(vertex.uv, 1) == -16777217;
    else if (probe.mode == 5) good = images.far.Sample(float3(1, 0, 0)) == 0.25 && images.far.Sample(float3(-1, 0, 0)) == 1.75
        && images.far.Sample(float3(0, 1, 0)) == 3.25 && images.far.Sample(float3(0, -1, 0)) == 4.75
        && images.far.Sample(float3(0, 0, -1)) == 7.75;
    else if (probe.mode == 6) good = images.far.Sample(float3(-0.5, 0, 1)) == 0 && images.far.Sample(float3(0.5, 0, 1)) == 3;
    else if (probe.mode == 7) good = images.faceIds.Sample(float3(0, 1, 0)) == -200007 && images.faceIds.Sample(float3(0, 0, -1)) == -500007
        && SameFour(images.rays.Sample(float3(0, 0, -1)), float4(-1, 0.5, 1000000000, 2));
    else good = images.exactVolume.Sample(float3(0.5), Filter.Bilinear) == 3.5
        && images.exactVolume.Sample(float3(0.25), Filter.Bilinear) == 0 && images.exactVolume.Sample(float3(0.75)) == 7;
    color = good ? Color.green : Color.red;
}
// ...and the rest, as a draw reads 16 textures at the most
frag CheckLevels(Vertex vertex, out Color color, ExactImages images, NumberProbe probe)
{
    mut bool good = false;
    if (probe.mode == 9) good = NearFour(images.halfVolume.Sample(float3(0.5), Filter.Bilinear), float4(0.5, 0.5, 1, 0.25))
        && Near(images.gridVolume.Sample(float3(0.5), Filter.Bilinear), 1.5);
    else if (probe.mode == 10) good = Near(images.color.SampleLevel(vertex.uv, 3).r, 0.5)
        && images.color.SampleLevel(float2(0.75, 0.5), 3, Filter.Bilinear).r == 1;
    else if (probe.mode == 11) good = Near(images.sky.SampleLevel(float3(0, 0, 1), 3).r, 0.5)
        && Near(images.painted.SampleLevel(vertex.uv, 1, 3).r, 0.5);
    else if (probe.mode == 12) good = DepthNear(images.shadows.Sample(float3(1, 0, 0)), 0.25) && images.shadows.Sample(float3(-1, 0, 0)) == 1
        && DepthNear(CubeDepth(images.shadows, float3(0.25, -0.5, -1)), 0.625);
    else if (probe.mode == 13) good = images.shadows.Compare(float3(1, 0, 0), 0.5) == 0 && images.shadows.Compare(float3(1, 0.25, -0.5), 0.2) == 1
        && images.shadows.Compare(float3(-1, 0, 0), 0.9) == 1 && images.shadows.Compare(float3(0, 0, -1), 0.5) == 1;
    else good = images.missingDepths.Sample(vertex.uv, 0) == 0 && images.missingIds.Sample(vertex.uv, 0) == 0
        && images.missingFaces.Sample(float3(1, 0, 0)) == 0 && images.missingShadows.Sample(float3(0, 1, 0)) == 1
        && images.missingShadows.Compare(float3(0, 1, 0), 0.5) == 1;
    color = good ? Color.green : Color.red;
}
view ShowExact(mut ExactImages images, NumberImages numbers)
{
    if (!images.made)
    {
        images.r32 = RenderTarget(8, 8, 1, Format.R32f);
        images.rgba32 = RenderTarget(8, 8, 1, Format.Rgba32f);
        images.colors = RenderTarget(8, 8, 1);
        images.one32 = images.r32.color;
        images.four32 = images.rgba32.color;
        images.color = images.colors.color;
        images.depths = TextureArray(8, 8, 2, 1, Format.R32f);
        images.points = TextureArray(8, 8, 2, 1, Format.Rgba32f);
        images.ids = TextureArray(8, 8, 2, 1, Format.R32i);
        images.far = Cubemap(8, Format.R32f);
        images.faceIds = Cubemap(8, Format.R32i);
        images.rays = Cubemap(8, Format.Rgba32f);
        images.exactVolume = Texture3D(int3(2), Format.R32f);
        images.halfVolume = Texture3D(int3(2), Format.Rgba16f);
        for (var z = 0; z < 2; z++)
            for (var y = 0; y < 2; y++)
                for (var x = 0; x < 2; x++) images.cells[x, y, z] = float(x + y + z);
        images.gridVolume = images.cells;
        images.sky = Cubemap(8);
        images.painted = TextureArray(8, 8, 2, 1);
        images.lamp = Cubemap(8, Format.Depth);
        images.shadows = images.lamp.depth;
        images.made = true;
    }
    images.r32.SetScreen(); images.rgba32.SetScreen(); images.colors.SetScreen();
    images.r32.Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.rgba32.Mesh(numbers.quad, [0,1,2,0,2,3], HalfWide);
    images.colors.SetBlend(.Replace);
    images.colors.Mesh(numbers.quad, [0,1,2,0,2,3], HalfColor);
    images.depths.layers[0].Clear(9.5);
    images.depths.layers[1].SetScreen();
    images.depths.layers[1].Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.points.layers[0].Clear(float4(1, 2, 3, 4));
    images.points.layers[1].SetScreen();
    images.points.layers[1].Mesh(numbers.quad, [0,1,2,0,2,3], HalfWide);
    images.ids.layers[0].Clear(-33554433);
    images.ids.layers[1].SetScreen();
    images.ids.layers[1].Mesh(numbers.quad, [0,1,2,0,2,3], IntegerNumber);
    for (var face = 0; face < 6; face++)
    {
        images.far.faces[face].Clear(face * 1.5 + 0.25);
        images.faceIds.faces[face].Clear(-100000 * face - 7);
    }
    images.far.faces[4].SetScreen();
    images.far.faces[4].Mesh(numbers.quad, [0,1,2,0,2,3], HalfOne);
    images.rays.faces[5].Clear(float4(-1, 0.5, 1000000000, 2));
    GPU.Run(FillExactVolumes, int3(2));
    images.sky.faces[4].SetScreen(); images.sky.faces[4].SetBlend(.Replace);
    images.sky.faces[4].Mesh(numbers.quad, [0,1,2,0,2,3], HalfColor);
    images.painted.layers[1].SetScreen(); images.painted.layers[1].SetBlend(.Replace);
    images.painted.layers[1].Mesh(numbers.quad, [0,1,2,0,2,3], HalfColor);
    // A lamp's depth cube: +x at 0.25, -z at 0.625, the others at the far limit
    List<Vertex3> card = [Vertex3 { position = float3(-1, -1, 0.5) }, Vertex3 { position = float3(1, -1, 0.5) },
                          Vertex3 { position = float3(1, 1, 0.5) }, Vertex3 { position = float3(-1, 1, 0.5) }];
    for (var face = 0; face < 6; face++)
    {
        RenderTarget side = images.lamp.faces[face];
        side.Clear(Color.black);
        if (face != 0 && face != 5) continue;
        side.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
        side.SetCull(.None); side.SetDepth(.ReadWrite);
        images.depth = face == 0 ? 0.25 : 0.625;
        side.Mesh(card, [0,1,2,0,2,3], float4x4.identity, ExactDepth);
    }
    for (var i = 0; i < 9; i++)
        Draw.Transform(float2(float(i % 3) * 8, 144 + float(i / 3) * 8))
        { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], CheckExact, NumberProbe { mode = i }); }
    for (var i = 9; i < 15; i++)
        Draw.Transform(float2(float(i % 3) * 8, 144 + float(i / 3) * 8))
        { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], CheckLevels, NumberProbe { mode = i }); }
    Draw.Transform(float2(0, 184)) { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], images.one32, CheckSource); }
}

// Grids of numbers as textures, through the [Raw(T)] role of their cells: a Grid2<float2> in a field, blended and at
// its nearest cell; a Grid2<float4> by its name, blended, and in a field at its one smaller image; a Grid2<int> through a
// helper, its ints exact; a Grid2<byte> as a frag's source; and a Grid2<int> one cell of which changes every frame,
// so a texture sent in parts that missed a change shows the old number.
local singleton NumberGrids
{
    Grid2<float2> pairs = Grid2(2, 1);
    Grid2<float4> fours = Grid2(2, 1);
    Grid2<int> ids = Grid2(2, 1);
    Grid2<byte> masks = Grid2(2, 1);
    Grid2<int> counts = Grid2(4, 4);
    [Raw(float2)] Texture pairTexture;
    [Raw(float4)] Texture fourTexture;
    int frames;
    bool made;
}
struct GridProbe { int mode; int frame; }
int Id([Raw(int)] Texture image, float2 uv) { return image.Sample(uv); }
frag CheckGrids(Vertex vertex, out Color color, NumberGrids grids, GridProbe probe)
{
    mut bool good = false;
    float2 middle = float2(0.5);
    if (probe.mode == 0) good = NearTwo(grids.pairTexture.Sample(middle, Filter.Bilinear), float2(1.5, 0))
        && NearTwo(grids.pairTexture.Sample(float2(0.25, 0.5)), float2(0, 1)) && NearTwo(grids.pairTexture.Sample(float2(0.75, 0.5)), float2(3, -1));
    else if (probe.mode == 1) good = NearFour(grids.fours.Sample(middle, Filter.Bilinear), float4(1.5, -0.5, 1, 0.5))
        && NearFour(grids.fourTexture.SampleLevel(middle, 1, Filter.Trilinear), float4(1.5, -0.5, 1, 0.5))
        && NearFour(grids.fours.Sample(float2(0.75, 0.5)), float4(3, -1, 2, 0));
    else if (probe.mode == 2) good = Id(grids.ids, float2(0.25, 0.5)) == -2147483647 && Id(grids.ids, float2(0.75, 0.5)) == 16777217;
    else if (probe.mode == 4) good = grids.counts.Sample(float2(0.625, 0.375)) == probe.frame && grids.counts.Sample(float2(0.125)) == 5;
    else good = grids.masks.Sample(float2(0.75, 0.5)) == 255 && grids.masks.Sample(float2(0.25, 0.5)) == 0;
    color = good ? Color.green : Color.red;
}
frag CheckGridSource(Vertex vertex, out Color color, [Raw(int)] Texture source)
{
    color = source.Sample(float2(0.75, 0.5)) == 255 && source.Sample(float2(0.25, 0.5), Filter.Point, Wrap.Repeat) == 0
        ? Color.green : Color.red;
}
[After(ShowMismatched)]
view ShowNumberGrids(mut NumberGrids grids, NumberImages numbers)
{
    if (!grids.made)
    {
        grids.pairs[0, 0] = float2(0, 1);
        grids.pairs[1, 0] = float2(3, -1);
        grids.fours[0, 0] = float4(0, 0, 0, 1);
        grids.fours[1, 0] = float4(3, -1, 2, 0);
        grids.ids[0, 0] = -2147483647;
        grids.ids[1, 0] = 16777217;
        grids.masks[1, 0] = 255;
        grids.counts[0, 0] = 5;
        grids.pairTexture = grids.pairs;
        grids.fourTexture = grids.fours;
        grids.made = true;
    }
    grids.frames++;
    grids.counts[2, 1] = grids.frames;
    for (var i = 0; i < 5; i++)
        Draw.Transform(float2(float(i % 3) * 8, 128 + float(i / 3) * 8))
        { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], CheckGrids, GridProbe { mode = i == 3 ? 5 : i, frame = grids.frames }); }
    Draw.Transform(float2(16, 136)) { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], grids.masks, CheckGridSource); }
}

// How each face of a cube is laid, both ways across it: each face's four quarters drawn with numbers of their own
// (rows from the top, as a target's are), read back by the directions the faces' layout says point at them (+y up
// for the four around, +x right of +z, -z at the top of the one above and +z of the one below). An R32f cube is
// tidec's face math over six layers, an R16f one the GPU's own cube, and a depth cube the face math over a depth
// array whose faces are drawn at a depth by where each pixel is: the three agree with the layout on every backend.
// Then what's read where no image is given: an Rgba32f cube's every face (one layer of zeros is bound for none, which
// the face is held to), an R32i cube's, an R32f volume blended from its eight loads and an Rgba16f one through the
// sampler (TIDE_SHADER_READ_NUMBER_VOLUME_BLEND); and a color cube's depth, known only as the game runs, which no
// draw reads: the draw is passed by.
local singleton FaceImages
{
    [Raw(float)] Cubemap exact;
    [Raw(float)] Cubemap sampled;
    Cubemap lamp;
    DepthCubemap shadows;
    [Raw(float4)] Cubemap goneRays;
    [Raw(int)] Cubemap goneIds;
    [Raw(float)] Texture3D goneVolume;
    [Raw(float4)] Texture3D goneHalfVolume;
    Cubemap colors;
    DepthCubemap colorDepth;
    bool colorsChosen = true;
    bool never;
    bool made;
}
struct FaceCode { int face; }
frag QuadrantCode(Vertex vertex, out float value, FaceCode code)
{
    value = float(code.face * 4 + (vertex.uv.x < 0.5 ? 0 : 1) + (vertex.uv.y < 0.5 ? 0 : 2));
}
frag QuadrantDepth(Vertex3 vertex, out Color color)
{
    color = Color.white;
    float2 pixel = this.position.xy; // An 8 by 8 face's pixels, rows from the top
    this.WriteDepth(0.125 + (pixel.x < 4 ? 0 : 0.25) + (pixel.y < 4 ? 0 : 0.5));
}
// The direction the layout says points at quarter `q` of face `face` (0 top left, 1 top right, 2 bottom left, 3
// bottom right), half way out from the face's middle each way
float3 Toward(int face, int q)
{
    float right = q % 2 == 0 ? -0.5 : 0.5;
    float down = q < 2 ? -0.5 : 0.5;
    if (face == 0) return float3(1, -down, -right);
    if (face == 1) return float3(-1, -down, right);
    if (face == 2) return float3(right, 1, down);
    if (face == 3) return float3(right, -1, -down);
    if (face == 4) return float3(right, -down, 1);
    return float3(-right, -down, -1);
}
frag CheckFaces(Vertex vertex, out Color color, FaceImages images, NumberProbe probe)
{
    mut bool good = true;
    for (var face = 0; face < 6; face++)
    {
        for (var q = 0; q < 4; q++)
        {
            float3 way = Toward(face, q);
            if (probe.mode == 0) good = good && images.exact.Sample(way) == float(face * 4 + q);
            else if (probe.mode == 1) good = good && images.sampled.Sample(way) == float(face * 4 + q);
            else if (probe.mode == 2) good = good && DepthNear(images.shadows.Sample(way), 0.125 + (q % 2 == 0 ? 0 : 0.25) + (q < 2 ? 0 : 0.5));
            else good = good && SameFour(images.goneRays.Sample(way), float4(0)) && images.goneIds.Sample(way) == 0;
        }
    }
    if (probe.mode == 3) good = good && images.goneVolume.Sample(float3(0.5), Filter.Bilinear) == 0
        && images.goneVolume.Sample(float3(0.25, 0.75, 0.5), Filter.Bilinear, Wrap.Repeat) == 0
        && SameFour(images.goneHalfVolume.Sample(float3(0.5), Filter.Bilinear), float4(0));
    color = good ? Color.green : Color.red;
}
frag ReadColorDepth(Vertex vertex, out Color color, FaceImages images)
{
    color = Color(1, images.colorDepth.Sample(float3(0, 0, 1)), 0);
}
[After(ShowNumberGrids)]
view ShowFaces(mut FaceImages images, NumberImages numbers)
{
    if (!images.made)
    {
        images.exact = Cubemap(8, Format.R32f);
        images.sampled = Cubemap(8, Format.R16f);
        images.lamp = Cubemap(8, Format.Depth);
        images.shadows = images.lamp.depth;
        images.colors = Cubemap(8);
        // Known only as the game runs: a cube of colors, whose faces' depth isn't kept to read
        images.colorDepth = images.colorsChosen ? images.colors.depth : images.lamp.depth;
        if (images.never)
        {
            images.goneRays = Cubemap(8, Format.Rgba32f);
            images.goneIds = Cubemap(8, Format.R32i);
            images.goneVolume = Texture3D(int3(2), Format.R32f);
            images.goneHalfVolume = Texture3D(int3(2), Format.Rgba16f);
        }
        images.made = true;
    }
    List<Vertex3> card = [Vertex3 { position = float3(-1, -1, 0.5) }, Vertex3 { position = float3(1, -1, 0.5) },
                          Vertex3 { position = float3(1, 1, 0.5) }, Vertex3 { position = float3(-1, 1, 0.5) }];
    for (var face = 0; face < 6; face++)
    {
        images.exact.faces[face].SetScreen();
        images.exact.faces[face].Mesh(numbers.quad, [0,1,2,0,2,3], QuadrantCode, FaceCode { face = face });
        images.sampled.faces[face].SetScreen();
        images.sampled.faces[face].Mesh(numbers.quad, [0,1,2,0,2,3], QuadrantCode, FaceCode { face = face });
        RenderTarget side = images.lamp.faces[face];
        side.Clear(Color.black);
        side.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
        side.SetCull(.None); side.SetDepth(.ReadWrite);
        side.Mesh(card, [0,1,2,0,2,3], float4x4.identity, QuadrantDepth);
    }
    for (var i = 0; i < 4; i++)
        Draw.Transform(float2(float(i % 3) * 8, 192 + float(i / 3) * 8))
        { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], CheckFaces, NumberProbe { mode = i }); }
    Draw.Transform(float2(8, 200)) { Draw.Mesh(numbers.quad, [0,1,2,0,2,3], ReadColorDepth); }
}