scene Main {}
local singleton CopyState
{
    RenderTarget target; RenderTarget high; bool started; int frame;
    RenderTarget several; // Rgba8, R32f, Rg16f, R32i
    RenderTarget bytes;   // R8, Rg8
    RenderTarget half;    // R16f
    RenderTarget wide;    // Rgba32f
    RenderTarget deep;    // Format.Depth
    Cubemap cube;
    TextureArray array;
    TextureArray shadows; // Format.Depth layers
    Cubemap heights;      // R16f faces
    TextureArray flows;   // Rg8 layers
    TextureArray glows;   // Rgba16f layers
    Cubemap exactFaces;   // R32f faces, six layers
    Cubemap idFaces;      // R32i faces
    TextureArray idLayers;   // R32i layers
    TextureArray wideLayers; // Rgba32f layers
    Cubemap shadowCube;   // Format.Depth: six faces of depth alone
    float depth;          // What DepthCard writes
    int images; int none; int windowImages;
}
local singleton CopyResult
{
    Grid2<Color> pixels; Grid2<Color> hdr; bool done; bool failed; int firstFrame;
    Grid2<Color> first; Grid2<float> second; Grid2<float2> third; Grid2<int> fourth;
    Grid2<float> mask; Grid2<float2> pair; Grid2<float> halves; Grid2<float4> wide; Grid2<float4> hdrRaw;
    Grid2<float> depth; Grid2<float> resolved; Grid2<float> alone;
    Grid2<Color> face0; Grid2<Color> face3; Grid2<Color> face5; Grid2<float> faceDepth;
    Grid2<Color> layer0; Grid2<Color> layer2; Grid2<float> layerDepth; Grid2<float> shadow1;
    Grid2<float> height1; Grid2<float> height4; Grid2<float2> flow1; Grid2<float4> glow0; Grid2<Color> glowColor;
    Grid2<float> exact3; Grid2<int> id5; Grid2<int> idLayer1; Grid2<float4> wide0; Grid2<float> shadowFace1; Grid2<float> shadowFace0;
    bool missingFailed; bool disposedFailed;
}
async void ReadImages(CopyState state, mut CopyResult result) {
    if (await state.target.Read() is Grid2<Color> pixels) result.pixels = pixels.Copy();
    else result.failed = true;
    if (await state.high.Read() is Grid2<Color> hdr) result.hdr = hdr.Copy();
    else result.failed = true;
    result.firstFrame = state.frame;
    // Each image of a target, as its own type
    if (await state.several.Read(0) is Grid2<Color> first) result.first = first.Copy(); else result.failed = true;
    if (await state.several.Read<float>(1) is Grid2<float> second) result.second = second.Copy(); else result.failed = true;
    if (await state.several.Read<float2>(2) is Grid2<float2> third) result.third = third.Copy(); else result.failed = true;
    if (await state.several.Read<int>(3) is Grid2<int> fourth) result.fourth = fourth.Copy(); else result.failed = true;
    if (await state.bytes.Read<float>() is Grid2<float> mask) result.mask = mask.Copy(); else result.failed = true;
    if (await state.bytes.Read<float2>(1) is Grid2<float2> pair) result.pair = pair.Copy(); else result.failed = true;
    if (await state.half.Read<float>() is Grid2<float> halves) result.halves = halves.Copy(); else result.failed = true;
    if (await state.wide.Read<float4>() is Grid2<float4> wide) result.wide = wide.Copy(); else result.failed = true;
    if (await state.high.Read<float4>() is Grid2<float4> raw) result.hdrRaw = raw.Copy(); else result.failed = true;
    // Depth: a target's, a multisampled target's, and a target's of depth alone
    if (await state.several.ReadDepth() is Grid2<float> depth) result.depth = depth.Copy(); else result.failed = true;
    if (await state.target.ReadDepth() is Grid2<float> resolved) result.resolved = resolved.Copy(); else result.failed = true;
    if (await state.deep.ReadDepth() is Grid2<float> alone) result.alone = alone.Copy(); else result.failed = true;
    // A cube's faces and an array's layers
    if (await state.cube.faces[0].Read() is Grid2<Color> face0) result.face0 = face0.Copy(); else result.failed = true;
    if (await state.cube.faces[3].Read() is Grid2<Color> face3) result.face3 = face3.Copy(); else result.failed = true;
    if (await state.cube.faces[5].Read() is Grid2<Color> face5) result.face5 = face5.Copy(); else result.failed = true;
    if (await state.cube.faces[2].ReadDepth() is Grid2<float> faceDepth) result.faceDepth = faceDepth.Copy(); else result.failed = true;
    if (await state.array.layers[0].Read() is Grid2<Color> layer0) result.layer0 = layer0.Copy(); else result.failed = true;
    if (await state.array.layers[2].Read() is Grid2<Color> layer2) result.layer2 = layer2.Copy(); else result.failed = true;
    if (await state.array.layers[1].ReadDepth() is Grid2<float> layerDepth) result.layerDepth = layerDepth.Copy(); else result.failed = true;
    if (await state.shadows.layers[1].ReadDepth() is Grid2<float> shadow1) result.shadow1 = shadow1.Copy(); else result.failed = true;
    // Faces and layers of numbers, as their own types
    if (await state.heights.faces[1].Read<float>() is Grid2<float> height1) result.height1 = height1.Copy(); else result.failed = true;
    if (await state.heights.faces[4].Read<float>() is Grid2<float> height4) result.height4 = height4.Copy(); else result.failed = true;
    if (await state.flows.layers[1].Read<float2>() is Grid2<float2> flow1) result.flow1 = flow1.Copy(); else result.failed = true;
    if (await state.glows.layers[0].Read<float4>() is Grid2<float4> glow0) result.glow0 = glow0.Copy(); else result.failed = true;
    if (await state.glows.layers[0].Read() is Grid2<Color> glowColor) result.glowColor = glowColor.Copy(); else result.failed = true;
    // 32-bit faces and layers, which are six layers or an array's, and a depth cube's faces
    if (await state.exactFaces.faces[3].Read<float>() is Grid2<float> exact3) result.exact3 = exact3.Copy(); else result.failed = true;
    if (await state.idFaces.faces[5].Read<int>() is Grid2<int> id5) result.id5 = id5.Copy(); else result.failed = true;
    if (await state.idLayers.layers[1].Read<int>() is Grid2<int> idLayer1) result.idLayer1 = idLayer1.Copy(); else result.failed = true;
    if (await state.wideLayers.layers[0].Read<float4>() is Grid2<float4> wide0) result.wide0 = wide0.Copy(); else result.failed = true;
    if (await state.shadowCube.faces[1].ReadDepth() is Grid2<float> shadowFace1) result.shadowFace1 = shadowFace1.Copy(); else result.failed = true;
    if (await state.shadowCube.faces[0].ReadDepth() is Grid2<float> shadowFace0) result.shadowFace0 = shadowFace0.Copy(); else result.failed = true;
    // What isn't there fails, and nothing more: a layer past the array's, and a target disposed before its read
    if (await state.array.layers[7].Read() is Grid2<Color> missing) result.failed = true; else result.missingFailed = true;
    RenderTarget gone = RenderTarget(2, 2, 1);
    gone.Dispose();
    if (await gone.Read() is Grid2<Color> never) result.failed = true; else result.disposedFailed = true;
    result.done = true;
}

frag HighColor(Vertex vertex, out Color color) { color = Color(2, 0.5, 0.25, 0.5); }
frag DepthCard(Vertex3 vertex, out Color color, CopyState state) { color = vertex.color; this.WriteDepth(state.depth); }

view Paint(mut CopyState state, mut CopyResult result) {
    if (!state.started) {
        state.target = RenderTarget(4, 3, 1, samples: 4);
        state.high = RenderTarget(2, 2, 1, Format.Rgba16f);
        state.several = RenderTarget(4, 2, 1, Format.Rgba8, Format.R32f, Format.Rg16f, Format.R32i);
        state.bytes = RenderTarget(2, 2, 1, Format.R8, Format.Rg8);
        state.half = RenderTarget(2, 2, 1, Format.R16f);
        state.wide = RenderTarget(2, 2, 1, Format.Rgba32f);
        state.deep = RenderTarget(2, 2, 1, Format.Depth);
        state.cube = Cubemap(2);
        state.array = TextureArray(2, 2, 3, 1);
        state.shadows = TextureArray(2, 2, 2, 1, Format.Depth);
        state.heights = Cubemap(2, Format.R16f);
        state.flows = TextureArray(2, 2, 2, 1, Format.Rg8);
        state.glows = TextureArray(2, 2, 1, 1, Format.Rgba16f);
        state.exactFaces = Cubemap(2, Format.R32f);
        state.idFaces = Cubemap(2, Format.R32i);
        state.idLayers = TextureArray(2, 2, 2, 1, Format.R32i);
        state.wideLayers = TextureArray(2, 2, 1, 1, Format.Rgba32f);
        state.shadowCube = Cubemap(2, Format.Depth);
        state.started = true;
        state.images = state.several.colors.count * 100 + state.bytes.colors.count * 10 + state.deep.colors.count;
        RenderTarget none = default;
        state.none = none.colors.count;
        ReadImages(state, result);
    }
    state.target.SetScreen(); state.target.SetBlend(.Replace);
    state.target.Clear(state.frame == 0 ? Color.red : Color.blue);
    state.target.Rect(float2(1, 1), float2(2, 2), Color.green);
    state.high.SetScreen(); state.high.SetBlend(.Replace); state.high.Clear(Color.black);
    List<Vertex> quad = [Vertex {}, Vertex { position = float2(2, 0) }, Vertex { position = float2(2) }, Vertex { position = float2(0, 2) }];
    state.high.Mesh(quad, [0,1,2,0,2,3], HighColor);

    // Typed clears, whole and then clipped to the pixel (1, 0), are exact in every image
    state.several.SetScreen();
    state.several.Clear(Color.red, 2.5, float2(-4, 8), -2147483647);
    state.several.Clip(Rect(1, 0, 1, 1)) { state.several.Clear(Color(0, 0, 1, 1), 0.001, float2(0.5, 65504), 16777217); }
    state.bytes.SetScreen();
    state.bytes.Clear(1.0, float2(0, 1));
    state.bytes.Clip(Rect(0, 1, 1, 1)) { state.bytes.Clear(0.2, float2(0.6, 0.4)); }
    state.half.SetScreen();
    state.half.Clear(0.5);
    state.half.Clip(Rect(1, 1, 1, 1)) { state.half.Clear(-2.5); }
    state.wide.SetScreen();
    state.wide.Clear(float4(1000000000, -3.25, 0.1, 7));
    state.wide.Clip(Rect(1, 0, 1, 1)) { state.wide.Clear(float4(0, 0.000001, -65536.5, 3)); }

    // Depth a frag writes, in forward terms, over the right half of `several` (red over red) and all of the others
    List<Vertex3> card = [Vertex3 { position = float3(-1, -1, 0.5) }, Vertex3 { position = float3(1, -1, 0.5) },
                          Vertex3 { position = float3(1, 1, 0.5) }, Vertex3 { position = float3(-1, 1, 0.5) }];
    List<Vertex3> left = [Vertex3 { position = float3(-1, -1, 0.5) }, Vertex3 { position = float3(0, -1, 0.5) },
                          Vertex3 { position = float3(0, 1, 0.5) }, Vertex3 { position = float3(-1, 1, 0.5) }];
    state.several.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
    state.several.SetCull(.None); state.several.SetDepth(.ReadWrite);
    state.depth = 0.25;
    List<Vertex3> right = [Vertex3 { position = float3(0, -1, 0.5), color = Color.red }, Vertex3 { position = float3(1, -1, 0.5), color = Color.red },
                           Vertex3 { position = float3(1, 1, 0.5), color = Color.red }, Vertex3 { position = float3(0, 1, 0.5), color = Color.red }];
    state.several.Mesh(right, [0,1,2,0,2,3], float4x4.identity, DepthCard);
    state.deep.Clear(Color.black);
    state.deep.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
    state.deep.SetCull(.None); state.deep.SetDepth(.ReadWrite);
    state.depth = 0.75;
    state.deep.Mesh(card, [0,1,2,0,2,3], float4x4.identity, DepthCard);

    // Each face and layer its own color, with its top left pixel white: which face, and which way up
    for (int i = 0; i < 6; i++)
    {
        RenderTarget face = state.cube.faces[i];
        face.SetScreen(); face.SetBlend(.Replace);
        face.Clear(Color(i / 5.0, 1 - i / 5.0, 0, 1));
        face.Rect(float2(0.5, 0.5), float2(1, 1), Color.white);
        face.Rect(float2(1.5, 0.5), float2(1, 1), Color.blue);
        if (i == 2)
        {
            face.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
            face.SetCull(.None); face.SetDepth(.ReadWrite);
            state.depth = 0.125;
            face.Mesh(left, [0,1,2,0,2,3], float4x4.identity, DepthCard);
        }
    }
    for (int i = 0; i < 3; i++)
    {
        RenderTarget layer = state.array.layers[i];
        layer.SetScreen(); layer.SetBlend(.Replace);
        layer.Clear(Color(i / 2.0, 0, 1 - i / 2.0, 0.5));
        layer.Rect(float2(0.5, 0.5), float2(1, 1), Color.white);
        if (i == 1)
        {
            layer.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
            layer.SetCull(.None); layer.SetDepth(.ReadWrite);
            state.depth = 0.5;
            layer.Mesh(left, [0,1,2,0,2,3], float4x4.identity, DepthCard);
        }
    }
    // Numbers in faces and layers: each face its own height, the pixel (1, 0) another; a layer of pairs; a layer
    // of four floats, drawn as a Color (stored times its alpha)
    for (int i = 0; i < 6; i++)
    {
        state.heights.faces[i].SetScreen();
        state.heights.faces[i].Clear(i + 0.5);
        state.heights.faces[i].Clip(Rect(1, 0, 1, 1)) { state.heights.faces[i].Clear(-1024.0); }
    }
    for (int i = 0; i < 2; i++)
    {
        state.flows.layers[i].SetScreen();
        state.flows.layers[i].Clear(float2(i, 1 - i));
        state.flows.layers[i].Clip(Rect(0, 1, 1, 1)) { state.flows.layers[i].Clear(float2(0.2, 0.8)); }
    }
    state.glows.layers[0].SetScreen(); state.glows.layers[0].SetBlend(.Replace);
    state.glows.layers[0].Clear(Color.black);
    state.glows.layers[0].Mesh(quad, [0,1,2,0,2,3], HighColor);
    for (int i = 0; i < 2; i++)
    {
        RenderTarget shadow = state.shadows.layers[i];
        shadow.Clear(Color.black);
        shadow.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
        shadow.SetCull(.None); shadow.SetDepth(.ReadWrite);
        state.depth = i == 0 ? 0.375 : 0.625;
        shadow.Mesh(card, [0,1,2,0,2,3], float4x4.identity, DepthCard);
    }
    // 32-bit numbers in faces and layers, bit for bit, the pixel (1, 0) another; a depth cube's face drawn on its left
    for (int i = 0; i < 6; i++)
    {
        state.exactFaces.faces[i].SetScreen();
        state.exactFaces.faces[i].Clear(i * 1.25 + 0.5);
        state.exactFaces.faces[i].Clip(Rect(1, 0, 1, 1)) { state.exactFaces.faces[i].Clear(-3000000000.0); }
        state.idFaces.faces[i].Clear(-100000 * i - 7);
    }
    for (int i = 0; i < 2; i++)
    {
        state.idLayers.layers[i].SetScreen();
        state.idLayers.layers[i].Clear(i == 0 ? -2147483647 : 16777217);
        state.idLayers.layers[i].Clip(Rect(0, 1, 1, 1)) { state.idLayers.layers[i].Clear(-5); }
    }
    state.wideLayers.layers[0].Clear(float4(1000000000, -3.25, 0.1, 7));
    RenderTarget lamp = state.shadowCube.faces[1];
    lamp.Clear(Color.black);
    lamp.SetCamera(float4x4.identity, float4x4.Ortho(2, 2, 0, 1));
    lamp.SetCull(.None); lamp.SetDepth(.ReadWrite);
    state.depth = 0.375;
    lamp.Mesh(left, [0,1,2,0,2,3], float4x4.identity, DepthCard);
    state.frame += 1;
}
