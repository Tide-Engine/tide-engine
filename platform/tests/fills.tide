// Fills' pixels on each GPU backend (tests/fills.c): a gradient and a lambda's
// round fill, drawn as one batch.
scene Main;

view Paint()
{
    Draw.Clear(Color.black);
    Draw.SetScreen();
    Draw.Rect(Rect(0, 0, 32, 32), 0, Gradient.Vertical(Color.red, Color.blue));
    Color green = Color.green;
    Draw.Rect(Rect(32, 0, 32, 32), 16, (float2 uv) => green);
}
