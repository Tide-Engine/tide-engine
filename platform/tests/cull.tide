// Listed runs culled on the GPU (platform/tests/cull.c): fields of plants, each a list drawn through one shader,
// near and far, before and behind the camera, one list mirrored and one half mirrored; with one setting, behind a
// wall, testing occlusion. The host draws each frame
// with the GPU culling and without, and compares what they draw.

scene Main { }

struct Corner
{
    float3 position;
    float2 uv;
    Color color = Color.white;
}

struct Plant
{
    float4x4 transform = float4x4.identity;
    Color tint;
}

local singleton Field
{
    List<Corner> corners;
    List<int> faces;
    List<List<Plant>> patches;
    List<Plant> wall; // Before the field, for occlusion
    int made;
}

// What the host has the frame drawn with: a camera, and a setting
local singleton Shot
{
    int camera;
    int setting;
    RenderTarget target;
}

frag Paint(Corner corner, out Color color, Plant plant)
{
    color = plant.tint * corner.color;
}

float Roll(int i, int k)
{
    return (Math.Hash(int2(i, k)) % 10000) / 10000.0;
}

view Make(mut Field field)
{
    if (field.made > 0) return;
    field.made = 1;
    // A box, its corners colored, its faces' fronts out
    for (int c = 0; c < 8; c++)
    {
        float3 at = float3((c & 1) == 0 ? -0.5 : 0.5, (c & 2) == 0 ? -0.5 : 0.5, (c & 4) == 0 ? -0.5 : 0.5);
        field.corners.Add(Corner { position = at, uv = at.xy, color = Color(0.3 + 0.7 * (c & 1), 0.3 + 0.35 * (c & 2), 0.3 + 0.175 * (c & 4)) });
    }
    field.faces = [0, 2, 1, 1, 2, 3, 4, 5, 6, 5, 7, 6, 0, 1, 4, 1, 5, 4, 2, 6, 3, 3, 6, 7, 0, 4, 2, 2, 4, 6, 1, 3, 5, 3, 7, 5];
    for (int p = 0; p < 24; p++)
    {
        mut List<Plant> patch = [];
        float3 middle = float3(Roll(p, 0) * 160 - 80, Roll(p, 1) * 8 - 4, Roll(p, 2) * 220 - 40);
        int count = 60 + p * 23;
        for (int i = 0; i < count; i++)
        {
            float turn = Roll(p * 1000 + i, 3) * 6.28;
            float size = 0.4 + Roll(p * 1000 + i, 4) * 1.6;
            bool flip = p == 5 || (p == 11 && i % 3 == 0);
            float3 at = middle + float3(Roll(p * 1000 + i, 5) * 30 - 15, Roll(p * 1000 + i, 6) * 6 - 3, Roll(p * 1000 + i, 7) * 30 - 15);
            float4x4 placed = float4x4.TRS(at, quaternion.AxisAngle(float3(0, 1, 0), turn), float3(flip ? -size : size, size, size));
            patch.Add(Plant { transform = placed, tint = Color(0.5 + 0.5 * Roll(p, 8), 0.5 + 0.5 * Roll(i, 9), 1) });
        }
        field.patches.Add(patch);
    }
    field.wall.Add(Plant { transform = float4x4.TRS(float3(-6, 1, 25), quaternion.identity, float3(30, 10, 0.5)), tint = Color(0.6, 0.6, 0.55) });
}

view Shoot(Field field, mut Shot shot)
{
    if (shot.setting == 4) // Into a target of its own, its levels picked by a camera further on
    {
        if (!shot.target.valid) shot.target = RenderTarget(160, 96, 1);
        shot.target.SetCamera(float3(0, 1, -10), quaternion.Euler(float3(0.1, 0.3, 0)), 70);
        shot.target.SetLODCamera(float3(0, 1, 50), quaternion.identity, 60);
        shot.target.Clear(Color(0.2, 0.1, 0.1));
        foreach (List<Plant> patch in field.patches) shot.target.Instanced(field.corners, field.faces, patch, Paint);
        Draw.SetScreen();
        Draw.Sprite(shot.target.color, float2(80, 48), float2(160, 96), Filter.Point);
        return;
    }
    if (shot.camera == 0) Draw.SetCamera(float3(0, 1, -10), quaternion.identity, 60);
    else if (shot.camera == 1) Draw.SetCamera(float3(10, 4, 30), quaternion.Euler(float3(0.15, 2.4, 0)), 50);
    else Draw.SetCamera(float3(-30, 2, 120), quaternion.Euler(float3(0, 0.9, 0)), 75);
    if (shot.setting == 1) Draw.SetLOD(1);
    if (shot.setting == 2) Draw.SetLODPixels(6);
    if (shot.setting == 3) Draw.SetFrustumCulling(false);
    Draw.Clear(Color(0.1, 0.1, 0.15));
    if (shot.setting == 5) // A wall, then the field testing occlusion against it: its runs at their levels culled again
    {                      // at the run's start, and joined still
        Draw.Instanced(field.corners, field.faces, field.wall, Paint);
        Draw.SetOcclusion(true);
    }
    foreach (List<Plant> patch in field.patches) Draw.Instanced(field.corners, field.faces, patch, Paint);
    // ...and the first patch again, just after: one run of both
    Draw.Instanced(field.corners, field.faces, field.patches[0], Paint);
}
