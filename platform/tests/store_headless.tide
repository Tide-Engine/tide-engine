// A run with no window of a game that keeps the server's store (store_headless.c): 400 values saved, then loaded in
// one tick, and the tick their first answer reaches.

scene Main { }

singleton Kept
{
    int asked;    // The tick the loads were asked in
    int answered; // The tick the first answer reached
    int found;    // Answers that found their value
}

List<byte> Bytes(int count)
{
    mut List<byte> made = [];
    for (var i = 0; i < count; i++) made.Add(byte(i));
    return made;
}

system Work(mut Kept kept, Time time)
{
    if (time.tick == 1) for (var i = 0; i < 400; i++) Storage.Save($"chunks/{i}", Bytes(2000));
    if (time.tick == 3)
    {
        for (var i = 0; i < 400; i++) Storage.Load($"chunks/{i}");
        kept.asked = time.tick;
    }
}

event(Loaded loaded) Got(mut Kept kept, Time time)
{
    if (kept.answered == 0) kept.answered = time.tick;
    if (loaded.found && loaded.bytes.count == 2000) kept.found += 1;
}
