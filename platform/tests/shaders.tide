// frag and vert, through the whole path: Tide to GLSL and WGSL, the draw
// list, the renderer and the GPU, read back as pixels by shaders.c. The
// screen is a grid of 32 pixel cells, each with a 24 pixel square drawn one
// way: Cell(column, row) is a cell's middle in the 3D world, which the camera
// shows a unit to a pixel, and Spot(column, row) the same for 2D.

scene Main { }

struct Dot
{
    float3 position;
}

struct Corner3
{
    float3 position;
    float3 normal;
    float2 uv;
    Color color = Color.white;
    int kind;
}

struct Dot2
{
    float2 position;
}

struct Corner2
{
    float2 position;
    float2 uv;
    Color color = Color.white;
}

// Ordinary list elements, without an entity for each one
struct Batch3
{
    float4x4 transform = float4x4.identity;
    Color tint;
    int kind;
    float unread;
}

struct Batch2
{
    float2 at;
    Color tint;
    int kind;
    float4x4 transform = float4x4.identity; // Ordinary data in 2D, not applied by the engine
}

enum Mode { Plain, Bright }
enum Shade : byte { Light, Mid, Dark }

struct Finish
{
    float shine = 1;
    int layers = 1;
}

// What a vert works out for its frag, which no vertex of a mesh carries
struct Handed
{
    float across;
    Color paint;
    float unread; // Written, and read by no frag: it isn't carried
}

struct Extra
{
    float level;
    float2 pair;
}

component Box
{
    float3 pos;
    Color tint = Color.white;
}

component Lamp
{
    float3 pos;
    float2 at;
    Color glow = Color.white;
    int kind;
    bool on;
    Mode mode;
    Finish finish;
}

singleton Sun
{
    Color light = Color(1, 1, 0.5);
    float shift = 64;
}

// Where the checks' lines are, which the frags compare with
singleton Marks
{
    float split = 16;  // A window pixel's x
    float world = -48; // A world x: Cell(2, 2)'s
    float placed = 48; // Cell(5, 2)'s
    float line = 144;  // A window pixel's y
    Mode mode = Mode.Bright;
}

local singleton Art
{
    List<Dot> dots;
    List<Corner3> quad;
    List<Dot2> dots2;
    List<Corner2> flat;
    List<Corner2> onScreen;
    List<int> faces;
    List<int> backFaces; // The same triangles, their corners the other way round
    List<Vertex3> manualMesh;
    List<float4x4> manualTransforms;
    List<Batch3> manual3;
    List<Batch2> manual2;
    List<Batch2> manualTextured;
    List<Batch3> empty;
    List<Batch3> handedItems;
    Grid2<Color> four = Grid2(2, 2);
    Color paint = Color(1, 0.5, 0);
    int frames;
    RenderTarget sourceTarget;
    RenderTarget outputTarget;
    Texture uploaded;
    Texture targetTexture;
    List<Vertex> targetQuad;
    int targetPass;
    // Targets sized as the window is, or in pixels of their own (pass 6)
    RenderTarget full;
    RenderTarget half;
    RenderTarget exact;
    bool sized;
    float2 window;
    // What a uv past a texture's edges reads (pass 7)
    RenderTarget tiles; // Two pixels by two, as `four`
    bool tiled;
    List<Vertex> tile;        // 48 pixels across from its corner, its uvs to (2, 2)
    List<Vertex> wideTile;    // 96 across and 24 down
    List<Corner2> cornerTile; // ...of a vertex of the game's
    List<Vertex3> tile3;      // 24 across, around its middle
    List<float4x4> tilePlaces;
    // Images of the game's own, and what their declarations say (pass 10)
    bool bricked;
    List<Vertex> brickTile;   // As `tile`
    List<Vertex3> brickTile3; // As `tile3`
    Texture keptBricks;
    [Filter(Filter.Point), Wrap(Wrap.Repeat)]
    Grid2<Color> painted = Grid2(2, 2); // As `four`
}

float3 Cell(int column, int row)
{
    return float3(32 * column - 112, 112 - 32 * row, 5);
}

float2 Spot(int column, int row)
{
    return float2(32 * column - 112, 112 - 32 * row);
}

// ---------------------------------------------------------------------------
// What a frag reads: the entity's components, singletons, and nothing

// Read-only singleton values pass through ordinary helper chains on the GPU.
Color Sunlight(Sun sun)
{
    return sun.light;
}

Color Lighting(Sun sun)
{
    return Sunlight(sun);
}

frag Tinted(Corner3 vertex, out Color color, Box box, Sun sun)
{
    color = box.tint * Lighting(sun);
}

// Writes white, and reads nothing
frag Blank(Corner3 vertex, out Color color)
{
    color = Color.white;
}

vert Shift(mut Corner3 vertex, Sun sun)
{
    vertex.position.x += sun.shift;
}

frag Wood(Corner3 vertex, out Color color, Art art)
{
    color = art.four.Sample(vertex.uv, Filter.Point);
}

frag Smooth(Corner3 vertex, out Color color, Art art)
{
    color = art.four.Sample(vertex.uv);
}

// ---------------------------------------------------------------------------
// Where the pixel is, and how the mesh was drawn

frag Split(Corner3 vertex, out Color color, Pixel pixel, Marks marks)
{
    color = pixel.position.x < marks.split ? Color.red : Color.blue;
}

frag Hole(Corner3 vertex, out Color color, Pixel pixel)
{
    float2 from = vertex.uv - float2(0.5, 0.5);
    if (Math.Abs(from.x) < 0.2 && Math.Abs(from.y) < 0.2) pixel.Discard();
    color = Color.magenta;
}

frag World(Corner3 vertex, out Color color, Pixel pixel, Marks marks)
{
    color = pixel.world.x > marks.world ? Color.green : Color.red;
}

frag ByDepth(Corner3 vertex, out Color color, Pixel pixel)
{
    color = Color(pixel.depth * 10, 0, 0);
}

vert Turn(mut Corner3 vertex, Instance instance)
{
    vertex.normal = Math.Rotate(instance.transform, vertex.normal);
}

frag Normal(Corner3 vertex, out Color color)
{
    color = Color(vertex.normal.x * 0.5 + 0.5, vertex.normal.y * 0.5 + 0.5, vertex.normal.z * 0.5 + 0.5);
}

frag Placed(Corner3 vertex, out Color color, Instance instance, Marks marks)
{
    color = instance.transform.c3.x == marks.placed ? Color.cyan : Color.red;
}

// Ints, bools, enums and structs of a component, for each instance
frag Lit(Corner3 vertex, out Color color, Lamp lamp)
{
    if (lamp.kind == 1)
    {
        color = Color.green;
        return;
    }
    if (lamp.mode == Mode.Bright && lamp.on)
    {
        color = Color(lamp.finish.shine, 0, lamp.finish.layers / 4.0);
        return;
    }
    color = Color.blue;
}

// ---------------------------------------------------------------------------
// 2D

frag Paint(Corner2 vertex, out Color color, Art art)
{
    color = art.paint;
}

vert Slide(mut Corner2 vertex, Sun sun)
{
    vertex.position.x += sun.shift;
}

vert Place(mut Corner2 vertex, Lamp lamp)
{
    vertex.position += lamp.at;
}

frag Glow(Corner2 vertex, out Color color, Lamp lamp)
{
    color = lamp.glow;
}

frag Stripe(Corner2 vertex, out Color color, Pixel pixel, Marks marks)
{
    color = pixel.position.y < marks.line ? Color.yellow : Color.cyan;
}

// Manual instances: the vert and frag both read the list's current item
vert BatchPlace3(mut Corner3 vertex, Batch3 item)
{
    Bump(vertex.position.x, item.kind);
}

frag BatchPaint3(Corner3 vertex, out Color color, Batch3 item, Instance instance)
{
    color = instance.transform.c3.z == 5 && item.kind < 3 ? item.tint : Color.magenta;
}

vert BatchPlace2(mut Corner2 vertex, Batch2 item)
{
    vertex.position += item.at;
}

frag BatchPaint2(Corner2 vertex, out Color color, Batch2 item, Instance instance)
{
    color = item.kind == 3 && instance.transform.c0.x == 1 && item.transform.c3.x == 10000 ? item.tint : Color.magenta;
}

// ---------------------------------------------------------------------------
// What a vert writes for its frag: an `out` struct of the vert's, which the
// frag reads blended across the triangle

// A field at a time
vert Hand(mut Corner3 vertex, out Handed handed, out Extra extra)
{
    handed.across = vertex.uv.x;
    handed.paint = Color(0, 1, 0);
    handed.unread = vertex.uv.y;
    extra.level = 1;
    extra.pair = float2(0, vertex.uv.y);
}

// Reads one of the two, and not all of it
frag Take(Corner3 vertex, Handed handed, out Color color)
{
    color = Color(handed.across, handed.paint.g, 0);
}

Color Mixed(Extra extra)
{
    return Color(extra.level, extra.pair.x, extra.pair.y);
}

// Reads the other, whole
frag TakeWhole(Corner3 vertex, out Color color, Extra extra)
{
    color = Mixed(extra);
}

// A path that draws no pixel writes no color
frag TakeHalf(Corner3 vertex, Handed handed, out Color color, Pixel pixel)
{
    if (handed.across < 0.5) pixel.Discard();
    color = handed.paint;
}

// All at once, from an instance's struct, which the frag reads beside it
vert HandItem(mut Corner3 vertex, out Handed handed, Batch3 item)
{
    handed = Handed { across = vertex.uv.x, paint = Color(1, 0.5, 1), unread = item.kind };
}

frag TakeItem(Corner3 vertex, Batch3 item, Handed handed, out Color color)
{
    color = item.tint * handed.paint;
}

vert Hand2(mut Corner2 vertex, out Handed handed, Sun sun)
{
    handed.across = vertex.uv.y;
    handed.paint = sun.light;
    handed.unread = 0;
}

frag Take2(Corner2 vertex, out Color color, Handed handed)
{
    color = Color(0, handed.across, handed.paint.r);
}

// ---------------------------------------------------------------------------
// The language, on the GPU: green where every check holds

struct Pair
{
    float a = 1;
    float b = 2;

    float Sum()
    {
        return a + b;
    }

    mut void Scale(float by)
    {
        a *= by;
        b *= by;
    }

    Pair operator +(Pair x, Pair y)
    {
        return Pair { a = x.a + y.a, b = x.b + y.b };
    }
}

const float HALF = 0.5;
const int THREE = 3;

float Twice(float x)
{
    return x * 2;
}

void Bump(mut float x, float by)
{
    x += by;
}

int Count(int to)
{
    mut int n = 0;
    for (int i = 0; i < to; i++)
    {
        if (i == 1) continue;
        if (i > 5) break;
        n++;
    }
    return n;
}

bool Near(float a, float b)
{
    return Math.Abs(a - b) < 0.001;
}

// Halfway between two colors a byte each: a GPU that blends in bytes gives 127
// or 128 of 255, where one that blends in floats gives a half.
bool Halfway(float a)
{
    return Math.Abs(a - 0.5) < 0.003;
}

frag Sink(Corner3 vertex, out Color color, Marks marks)
{
    mut bool ok = true;

    // Numbers
    int i = 7;
    float f = i;
    if (!Near(f / 2, 3.5)) ok = false;
    if (i / 2 != 3 || i % 4 != 3) ok = false;
    if ((i << 2) != 28 || (i >> 1) != 3 || (i & 5) != 5 || (i | 8) != 15 || (i ^ 2) != 5) ok = false;
    if (-i != -7 || ~i != -8) ok = false;

    // Vectors
    float3 v = float3(1, 2, 3);
    mut float3 w = v * 2 + float3(1);
    w.xy = w.yx;
    if (!Near(w.x, 5) || !Near(w.y, 3) || !Near(w.z, 7)) ok = false;
    if (!Near(Math.Dot(v, v), 14) || !Near(Math.Length(float2(3, 4)), 5)) ok = false;
    float3 across = Math.Cross(float3(1, 0, 0), float3(0, 1, 0));
    if (!Near(across.z, 1)) ok = false;
    int2 cell = int2(3, 4) * 2;
    if (cell.x != 6 || cell.y != 8) ok = false;
    float2 mixed = float2(cell) * HALF;
    if (!Near(mixed.y, 4)) ok = false;

    // Math
    if (!Near(Math.Clamp(5.0, 0, 1), 1) || !Near(Math.Lerp(2.0, 4.0, 0.5), 3) || !Near(Math.Saturate(-1.0), 0)) ok = false;
    if (!Near(Math.Max(v, 2).x, 2) || !Near(Math.Min(1, 2.5), 1) || Math.Max(i, 9) != 9) ok = false;
    if (!Near(Math.Floor(1.7), 1) || !Near(Math.Frac(1.75), 0.75) || !Near(Math.Sqrt(16.0), 4) || !Near(Math.Pow(2.0, 3.0), 8)) ok = false;
    if (!Near(Math.Sin(0.0), 0) || !Near(Math.Cos(0.0), 1) || !Near(Math.Atan2(1.0, 1.0), Math.PI / 4)) ok = false;
    if (!Near(Math.Step(0.5, 0.7), 1) || !Near(Math.SmoothStep(0.0, 1.0, 0.5), 0.5) || !Near(Math.Unlerp(2.0, 4.0, 3.0), 0.5)) ok = false;
    if (!Near(Math.LengthSq(float2(3, 4)), 25) || !Near(Math.DistanceSq(float2(1, 1), float2(4, 5)), 25)) ok = false;
    if (!Near(Math.Csum(v), 6) || !Near(Math.Cmax(v), 3) || !Near(Math.Cmin(v), 1)) ok = false;
    if (!Near(Math.Normalize(float3(0)).x, 0) || !Near(Math.Normalize(float3(0, 3, 0)).y, 1)) ok = false;
    if (!Near(Math.Log10(100.0), 2) || !Near(Math.Exp(0.0), 1) || !Near(Math.Degrees(Math.PI), 180)) ok = false;

    // Matrices
    float2x2 m = float2x2(1, 2, 3, 4);
    float2 through = Math.Mul(m, float2(1, 1));
    if (!Near(through.x, 3) || !Near(through.y, 7) || !Near(m.c1.x, 2) || !Near(Math.Determinant(m), -2)) ok = false;
    float2x2 doubled = m * 2;
    if (!Near(doubled.c0.y, 6)) ok = false;
    float3 moved = Math.Transform(float4x4.identity, v);
    if (!Near(moved.z, 3)) ok = false;

    // Structs, methods and operators
    mut Pair p = Pair { a = 2 };
    p.Scale(2);
    Pair q = p + Pair { };
    if (!Near(q.Sum(), 11)) ok = false;

    // Functions, and what they change
    mut float bumped = Twice(HALF);
    Bump(bumped, 2);
    Bump(w.z, 1);
    if (!Near(bumped, 3) || !Near(w.z, 8) || Count(THREE + 5) != 5) ok = false;

    // Enums, ?: and default
    Mode mode = marks.mode;
    float pick = mode == Mode.Bright ? 1 : 0;
    Pair usual = default;
    if (!Near(pick, 1) || !Near(usual.b, 2)) ok = false;

    // An enum from its number, and one stored as a byte, which keeps the number's low 8 bits here as on the CPU
    int number = int(mode);
    if (Mode(number) != Mode.Bright || Mode(number - 1) != Mode.Plain) ok = false;
    if (Shade(number + 257) != Shade.Dark || int(Shade(number + 511)) != 0 || int(Shade(number - 2)) != 255) ok = false;

    // Colors
    Color tint = Color(0.5, 0.25, 1) * Color.white * 2 - Color(0, 0, 1, 1) + Color.clear;
    if (!Near(tint.g, 0.5) || !Near(tint.a, 1)) ok = false;

    color = ok ? Color.green : Color.red;
}

struct Inner
{
    float v = 2;
}

struct Outer
{
    Inner inner;
    int n = 3;

    float Total()
    {
        return inner.v * n;
    }

    float Double()
    {
        return Total() * 2;
    }

    mut void Grow(float by)
    {
        inner.v += by;
        n++;
    }
}

struct Holder
{
    Pair pair;
}

Outer Made(float v)
{
    return Outer { inner = Inner { v = v }, n = 2 };
}

// What a call makes through `out`: whether there's something, and it
bool Halve(float value, out float half)
{
    half = value * 0.5;
    return value > 0;
}

void Parts(float value, out float whole, out float rest)
{
    whole = Math.Floor(value);
    rest = value - whole;
}

float First(float3 v, float least)
{
    for (int i = 0; i < 3; i++)
    {
        if (v.x + i > least) return i;
    }
    return -1;
}

frag More(Corner3 vertex, out Color color)
{
    mut bool ok = true;

    // Matrices
    float3x3 turn = float3x3(float3(0, 1, 0), float3(-1, 0, 0), float3(0, 0, 1));
    float3 turned = Math.Mul(turn, float3(1, 0, 0));
    if (!Near(turned.y, 1) || !Near(turned.x, 0)) ok = false;
    float3x3 back = Math.Transpose(turn);
    if (!Near(Math.Mul(back, turned).x, 1)) ok = false;
    float3x3 less = -turn;
    float3x3 half = turn / 2;
    float3x3 sum = turn + turn - half;
    if (!Near(less.c0.y, -1) || !Near(half.c0.y, 0.5) || !Near(sum.c1.x, -1.5)) ok = false;
    float3 spun = Math.Rotate(float4x4.identity, float3(1, 2, 3));
    if (!Near(spun.y, 2)) ok = false;

    // Int vectors, and vectors from others
    mut int3 steps = int3(1, 2, 3) + int3(1);
    steps = steps * 3 % 4;
    if (steps.x != 2 || steps.y != 1 || steps.z != 0) ok = false;
    int3 whole = int3(float3(1.7, 2.2, -0.5));
    float4 packed = float4(float2(1, 2), 3, 4);
    if (whole.x != 1 || whole.y != 2 || !Near(packed.z, 3) || !Near(packed.zyx.z, 1)) ok = false;

    // Assignments
    mut int n = 10;
    n -= 3;
    n *= 2;
    n /= 4;
    n %= 3;
    n <<= 2;
    n |= 1;
    n &= 7;
    n ^= 2;
    n++;
    n--;
    n >>= 1;
    mut float x = 8;
    x -= 2;
    x *= 3;
    x /= 4;
    if (n != 1 || !Near(x, 4.5)) ok = false;

    // Loops
    mut int total = 0;
    for (int i = 5; i > 0; i--) total += i;
    for (int i = 0; i <= 6; i += 2) total += 1;
    if (total != 19 || !Near(First(float3(0.5, 0, 0), 2), 2)) ok = false;

    // Structs in structs, their methods, and structs from functions
    mut Outer outer = Made(1.5);
    outer.Grow(0.5);
    outer.inner.v *= 2;
    if (!Near(outer.Total(), 12) || !Near(outer.Double(), 24)) ok = false;
    mut Holder holder = Holder { };
    holder.pair.Scale(3);
    if (!Near(holder.pair.Sum(), 9)) ok = false;

    // Numbers of both kinds
    int count = 3;
    bool small = count < 3.5 && !(count > 4);
    float ratio = count / 2;
    int cut = int(2.9);
    float wide = float(count) / 2;
    float either = small ? (count > 2 ? 7 : 8) : 9;
    if (!small || !Near(ratio, 1) || cut != 2 || !Near(wide, 1.5) || !Near(either, 7) || !Near(Twice(default), 0)) ok = false;

    // More of Math
    if (!Near(Math.Round(2.5), 2) || !Near(Math.Sign(-3.0), -1) || !Near(Math.Trunc(-1.7), -1) || !Near(Math.Ceil(1.2), 2)) ok = false;
    if (!Near(Math.Rsqrt(4.0), 0.5) || !Near(Math.Radians(180.0), Math.PI) || !Near(Math.Tan(0.0), 0)) ok = false;
    if (!Near(Math.Asin(1.0), Math.PI / 2) || !Near(Math.Acos(1.0), 0) || !Near(Math.Atan(1.0), Math.PI / 4)) ok = false;
    if (!Near(Math.Exp2(3.0), 8) || !Near(Math.Log(1.0), 0) || !Near(Math.Log2(8.0), 3)) ok = false;
    float3 bounced = Math.Reflect(float3(1, -1, 0), float3(0, 1, 0));
    if (!Near(bounced.y, 1) || !Near(Math.Distance(float2(0, 0), float2(3, 4)), 5)) ok = false;
    float3 sizes = Math.Abs(float3(-1, 2, -3));
    if (!Near(sizes.z, 3) || Math.Min(count, 2) != 2 || Math.Clamp(count, 0, 2) != 2) ok = false;
    if (Math.Abs(-count) != 3 || Math.Sign(-count) != -1) ok = false;

    // `out` parameters: a local declared at the call, a variable the code has, and one left out
    if (!Halve(3, out var made) || !Near(made, 1.5)) ok = false;
    mut float kept = 9;
    if (Halve(-4, out kept) || !Near(kept, -2)) ok = false;
    Parts(2.25, out float floor, out _);
    Parts(floor + 0.75, out _, out var past);
    if (!Near(floor, 2) || !Near(past, 0.75)) ok = false;

    color = ok ? Color(0, 1, 0, 1) : Color.red;
}

// Loops that start under 0, end there, or whose start, bound and step are
// worked out, and nothing else: what a shader's compiler makes of a loop's
// first line is all this frag asks of it. (One compiler lost a function that
// only such lines called.)
frag Counts(Corner3 vertex, out Color color)
{
    mut int around = 0;
    for (int row = -1; row <= 1; row++)
    {
        for (int column = -2; column <= 2; column++) around += column * column + row;
    }
    for (int i = -3; i < -1; i++) around += i;
    for (int i = 6 / 2; i > -(1 + 1); i -= 4 / 2) around += 1;
    color = around == 28 ? Color(0, 1, 0, 1) : Color.red;
}

// A loop that starts under 0 and samples as it goes, as a blur does: the
// grid's first row, a cell to each side of its middle.
frag Around(Corner3 vertex, out Color color, Art art)
{
    mut var sum = Color(0, 0, 0, 0);
    for (int x = -1; x <= 1; x += 2) sum = sum + art.four.Sample(float2(0.5 + x * 0.25, 0.25), Filter.Point);
    color = Color(sum.r * 0.5, sum.g * 0.5, sum.b * 0.5, 1);
}

// ---------------------------------------------------------------------------
// Math, on the GPU: green where it's what the CPU worked out
//
// Each function below works a part of Math out from a `Given`. The view runs
// it on the CPU and keeps its answers in `Probe`; a frag and a vert run it
// again on the GPU, and compare theirs with those. What's integers has to be
// the same number, and floats as near as a GPU rounds.

struct Given
{
    int one = 1;
    int big = -1640531527;
    int2 pair = int2(3, -4);
    int3 cell = int3(17, -250, 2147483647);
    int4 quad = int4(-2147483647, 65536, -1, 99);
    int low;                  // A long's halves, which the view splits
    int high;
    quaternion turn;          // Rotations the view makes
    quaternion other;
    quaternion none;          // What a field nothing set holds: zero
    float3 point = float3(1, -2, 0.5);
    float3 angles = float3(0.3, -1.1, 2);
    float amount = 0.3;
    float wide = 3;           // Nearly half a turn, in radians
    float2x2 two = float2x2(2, 1, -1, 3);
    float3x3 three = float3x3(2, 0, 1, -1, 3, 0.5, 0, 1, 4);
    float4x4 four = float4x4.identity; // The view's: a place, a turn and a size
    float zero;
    float nan;                // 0 / 0, which the view works out
}

struct Hashes
{
    int one;
    int two;
    int three;
    int four;
    int chained;
    int constant;
    int halves;
}

struct Turns
{
    quaternion product;
    quaternion inverse;
    quaternion conjugate;
    quaternion unit;
    quaternion idle;
    quaternion slerp;
    quaternion slerpNear;
    quaternion slerpFar;
    quaternion nlerp;
    quaternion nlerpFar;
    quaternion nlerpNone;
    quaternion axisAngle;
    quaternion euler;
    quaternion look;
    quaternion fromSmall;
    quaternion fromX;
    quaternion fromY;
    quaternion fromZ;
    quaternion made;
    quaternion constant;
    float3 rotated;
    float3 multiplied;
    float3 forward;
    float3 up;
    float3 right;
    float dot;
    float angle;
    float angleNone;
}

struct Matrices
{
    float2x2 inverse2;
    float3x3 inverse3;
    float4x4 inverse4;
    float3 determinants;
    float2x2 product2;
    float3x3 product3;
    float4x4 product4;
    float2 through2;
    float3 through3;
    float4 through4;
    float3x3 transposed;
    float3 moved;
    float3 turned;
    float3x3 fromTurn;
    float4x4 fromParts;
    float4x4 trs;
    float4x4 translate;
    float4x4 perspective;
    float4x4 ortho;
    float4x4 constant;
    float2x2 flat; // Of a matrix with no inverse: no numbers, so nothing compares it
}

struct Rest
{
    float4 mins;      // Of a number, then of each size of vector, summed
    float4 maxes;
    float4 clamps;
    float4 smooths;
    float4 powers;
    float4 arcs;
    float4 units;
    float4 ends;
    float4 saturated;
    float2 capped;
    float4 bad;       // Of NaN: what math.h says of it
    float4 bad2;
    float3 badVector;
    float4 none;      // Of vectors with no direction
    float4 turnedPowers;
    float4 corners;
    float4 edges;
    float2 wrong;     // Bounds the wrong way around
    int2 wrongInts;
}

local singleton Probe
{
    Given given;
    Hashes hashes;
    Turns turns;
    Matrices matrices;
    Rest rest;
}

Hashes HashesOf(Given given)
{
    mut Hashes hashes = Hashes { };
    hashes.one = Math.Hash(given.big);
    hashes.two = Math.Hash(given.pair);
    hashes.three = Math.Hash(given.cell);
    hashes.four = Math.Hash(given.quad);
    // Hashes of hashes, and of vectors made along the way
    hashes.chained = Math.Hash(int2(Math.Hash(given.one), Math.Hash(int4(given.cell, given.big))));
    // Of constants, which no shader compiler may refuse to work out ahead
    hashes.constant = Math.Hash(7) ^ Math.Hash(int2(1, 2)) ^ Math.Hash(int3(-1, 0, 1)) ^ Math.Hash(int4(1, 2, 3, 2147483647));
    // A long's hash is its halves', as an int2: the GPU has no long
    hashes.halves = Math.Hash(int2(given.low, given.high));
    return hashes;
}

bool SameHashes(Hashes a, Hashes b)
{
    return a.one == b.one && a.two == b.two && a.three == b.three && a.four == b.four && a.chained == b.chained
        && a.constant == b.constant && a.halves == b.halves && a.one != a.two;
}

Turns TurnsOf(Given given)
{
    mut Turns turns = Turns { };
    quaternion a = given.turn;
    quaternion b = given.other;
    turns.product = Math.Mul(a, b);
    turns.inverse = Math.Inverse(quaternion(a.value * 2));
    turns.conjugate = Math.Conjugate(a);
    turns.unit = Math.Normalize(quaternion(b.value * 3));
    turns.idle = Math.Normalize(given.none); // The identity
    turns.slerp = Math.Slerp(a, b, given.amount);
    turns.slerpNear = Math.Slerp(a, Math.Nlerp(a, b, 0.001), given.amount); // So near that it goes straight
    turns.slerpFar = Math.Slerp(a, quaternion(-b.value), given.amount);     // The same rotation, the long way around
    turns.nlerp = Math.Nlerp(a, b, given.amount);
    turns.nlerpFar = Math.Nlerp(a, quaternion(-b.value), given.amount);
    turns.nlerpNone = Math.Nlerp(given.none, given.none, given.amount);
    turns.axisAngle = quaternion.AxisAngle(Math.Normalize(given.point), given.wide);
    turns.euler = quaternion.Euler(given.angles);
    turns.look = quaternion.LookRotation(Math.Forward(a), Math.Up(b));
    // From a matrix, each of the four ways there are: by its trace, and by each axis it turns nearly half around
    turns.fromSmall = quaternion(float3x3(a));
    turns.fromX = quaternion(float3x3(quaternion.AxisAngle(float3(1, 0, 0), given.wide)));
    turns.fromY = quaternion(float3x3(quaternion.AxisAngle(float3(0, 1, 0), given.wide)));
    turns.fromZ = quaternion(float3x3(quaternion.AxisAngle(float3(0, 0, 1), given.wide)));
    turns.made = quaternion(given.one, 0.5, given.amount, 2);
    turns.constant = Math.Mul(quaternion.Euler(float3(0.5, 1, 1.5)),
                              Math.Slerp(quaternion.identity, quaternion.AxisAngle(float3(0, 1, 0), 2), 0.25));
    turns.rotated = Math.Rotate(a, given.point);
    turns.multiplied = Math.Mul(b, given.point);
    turns.forward = Math.Forward(a);
    turns.up = Math.Up(a);
    turns.right = Math.Right(a);
    turns.dot = Math.Dot(a, b);
    turns.angle = Math.Angle(a, b);
    turns.angleNone = Math.Angle(given.none, b);
    return turns;
}

bool Close(float a, float b)
{
    return Math.Abs(a - b) <= 0.002 * (1 + Math.Abs(b));
}

bool Close2(float2 a, float2 b)
{
    return Close(a.x, b.x) && Close(a.y, b.y);
}

bool Close3(float3 a, float3 b)
{
    return Close(a.x, b.x) && Close(a.y, b.y) && Close(a.z, b.z);
}

bool Close4(float4 a, float4 b)
{
    return Close(a.x, b.x) && Close(a.y, b.y) && Close(a.z, b.z) && Close(a.w, b.w);
}

bool CloseTurn(quaternion a, quaternion b)
{
    return Close4(a.value, b.value);
}

bool Close3x3(float3x3 a, float3x3 b)
{
    return Close3(a.c0, b.c0) && Close3(a.c1, b.c1) && Close3(a.c2, b.c2);
}

bool Close4x4(float4x4 a, float4x4 b)
{
    return Close4(a.c0, b.c0) && Close4(a.c1, b.c1) && Close4(a.c2, b.c2) && Close4(a.c3, b.c3);
}

bool SameTurns(Turns a, Turns b)
{
    mut bool same = CloseTurn(a.product, b.product) && CloseTurn(a.inverse, b.inverse) && CloseTurn(a.conjugate, b.conjugate);
    same = same && CloseTurn(a.unit, b.unit) && CloseTurn(a.idle, b.idle) && a.idle.value.w == 1;
    same = same && CloseTurn(a.slerp, b.slerp) && CloseTurn(a.slerpNear, b.slerpNear) && CloseTurn(a.slerpFar, b.slerpFar);
    same = same && CloseTurn(a.nlerp, b.nlerp) && CloseTurn(a.nlerpFar, b.nlerpFar) && CloseTurn(a.nlerpNone, b.nlerpNone);
    same = same && CloseTurn(a.axisAngle, b.axisAngle) && CloseTurn(a.euler, b.euler) && CloseTurn(a.look, b.look);
    same = same && CloseTurn(a.fromSmall, b.fromSmall) && CloseTurn(a.fromX, b.fromX) && CloseTurn(a.fromY, b.fromY);
    same = same && CloseTurn(a.fromZ, b.fromZ) && CloseTurn(a.made, b.made) && CloseTurn(a.constant, b.constant);
    same = same && Close3(a.rotated, b.rotated) && Close3(a.multiplied, b.multiplied);
    same = same && Close3(a.forward, b.forward) && Close3(a.up, b.up) && Close3(a.right, b.right);
    return same && Close(a.dot, b.dot) && Close(a.angle, b.angle) && Close(a.angleNone, b.angleNone);
}

Matrices MatricesOf(Given given)
{
    mut Matrices made = Matrices { };
    made.inverse2 = Math.Inverse(given.two);
    made.inverse3 = Math.Inverse(given.three);
    made.inverse4 = Math.Inverse(given.four);
    made.determinants = float3(Math.Determinant(given.two), Math.Determinant(given.three), Math.Determinant(given.four));
    made.product2 = Math.Mul(given.two, made.inverse2 + given.two);
    made.product3 = Math.Mul(given.three, Math.Transpose(given.three));
    made.product4 = Math.Mul(given.four, given.four);
    made.through2 = Math.Mul(given.two, given.point.xy);
    made.through3 = Math.Mul(given.three, given.point);
    made.through4 = Math.Mul(given.four, float4(given.point, 1));
    made.transposed = Math.Transpose(given.three);
    made.moved = Math.Transform(given.four, given.point);
    made.turned = Math.Rotate(given.four, given.point);
    made.fromTurn = float3x3(given.turn);
    made.fromParts = float4x4(made.fromTurn, given.point);
    made.trs = float4x4.TRS(given.point, given.other, given.angles);
    made.translate = float4x4.Translate(given.angles);
    made.perspective = float4x4.PerspectiveFov(given.wide / 3, 1.5, given.amount, 100);
    made.ortho = float4x4.Ortho(8, given.wide, given.amount, 50);
    // Of constants, and of a matrix with no inverse: neither may be a shader a compiler refuses
    made.constant = Math.Inverse(float4x4.TRS(float3(1, 2, 3), quaternion.Euler(float3(0.5, 1, 1.5)), float3(2, 1, 0.5)));
    made.flat = Math.Inverse(float2x2(1, 2, 2, 4));
    return made;
}

bool SameMatrices(Matrices a, Matrices b)
{
    mut bool same = Close2(a.inverse2.c0, b.inverse2.c0) && Close2(a.inverse2.c1, b.inverse2.c1);
    same = same && Close3x3(a.inverse3, b.inverse3) && Close4x4(a.inverse4, b.inverse4) && Close3(a.determinants, b.determinants);
    same = same && Close2(a.product2.c0, b.product2.c0) && Close2(a.product2.c1, b.product2.c1);
    same = same && Close3x3(a.product3, b.product3) && Close4x4(a.product4, b.product4);
    same = same && Close2(a.through2, b.through2) && Close3(a.through3, b.through3) && Close4(a.through4, b.through4);
    same = same && Close3x3(a.transposed, b.transposed) && Close3(a.moved, b.moved) && Close3(a.turned, b.turned);
    same = same && Close3x3(a.fromTurn, b.fromTurn) && Close4x4(a.fromParts, b.fromParts) && Close4x4(a.trs, b.trs);
    same = same && Close4x4(a.translate, b.translate) && Close4x4(a.perspective, b.perspective) && Close4x4(a.ortho, b.ortho);
    return same && Close4x4(a.constant, b.constant);
}

// What Math does on the GPU as tide/math.h does it, where a shader language's
// own function would do otherwise, or says it may do anything
Rest RestOf(Given given)
{
    mut Rest rest = Rest { };
    float a = given.amount;
    float2 p2 = given.point.xy;
    float3 p3 = given.point;
    float4 p4 = float4(given.point, given.wide);
    float3 q3 = given.angles;
    float4 q4 = float4(given.angles, -1);

    // Every size of each
    rest.mins = float4(Math.Min(a, given.wide), Math.Csum(Math.Min(p2, q3.xy)), Math.Csum(Math.Min(p3, q3)), Math.Csum(Math.Min(p4, q4)));
    rest.maxes = float4(Math.Max(a, given.wide), Math.Csum(Math.Max(p2, q3.xy)), Math.Csum(Math.Max(p3, q3)), Math.Csum(Math.Max(p4, q4)));
    rest.clamps = float4(Math.Clamp(given.wide, a, 1), Math.Csum(Math.Clamp(p2, -1, a)), Math.Csum(Math.Clamp(p3, q3 - 1, q3 + 1)),
                         Math.Csum(Math.Clamp(p4, 0, 2)));
    rest.smooths = float4(Math.SmoothStep(0, 1, a), Math.Csum(Math.SmoothStep(-3, 3, p2)), Math.Csum(Math.SmoothStep(-3, 3, p3)),
                          Math.Csum(Math.SmoothStep(-3, 3, p4)));
    rest.powers = float4(Math.Pow(given.wide, a), Math.Csum(Math.Pow(Math.Abs(p2), 1.5)), Math.Csum(Math.Pow(p3, 2)),
                         Math.Csum(Math.Pow(p4, 3)));
    rest.arcs = float4(Math.Atan2(a, given.wide), Math.Csum(Math.Atan2(p2, q3.xy)), Math.Csum(Math.Atan2(p3, q3)),
                       Math.Csum(Math.Atan2(p4, q4)));
    rest.units = float4(Math.Normalize(p2).x, Math.Normalize(p3).y, Math.Normalize(p4).z, Math.Normalize(p4).w);
    rest.ends = float4(Math.Cmin(p2), Math.Cmax(p3), Math.Cmin(p4), Math.Cmax(p4));
    rest.saturated = Math.Saturate(p4);
    rest.capped = float2(Math.Saturate(given.wide), Math.Saturate(-given.wide));

    // With one NaN, Min and Max give the other, and Clamp its lower bound
    float nan = given.nan;
    float3 holed = float3(1, nan, 3);
    rest.bad = float4(Math.Min(nan, 2), Math.Max(nan, 2), Math.Clamp(nan, 1, 3), Math.Saturate(nan));
    rest.bad2 = float4(Math.Min(2, nan), Math.Max(2, nan), Math.SmoothStep(0, 1, nan), Math.Cmin(float3(4, nan, 5)));
    rest.badVector = Math.Min(holed, float3(2)) + Math.Max(holed, float3(2)) + Math.Clamp(holed, float3(0), float3(1.5));

    // A vector with no direction normalizes to zero, and a quaternion to the identity
    float3 still = float3(given.zero);
    rest.none = float4(Math.Csum(Math.Normalize(still.xy)), Math.Csum(Math.Normalize(still)),
                       Math.Csum(Math.Normalize(float4(still, given.zero))), Math.Normalize(given.none).value.w);

    // A whole power of a number under 0, and anything to the power of 0
    float two = given.wide - 1;
    rest.turnedPowers = float4(Math.Pow(-two, 3), Math.Pow(-two, two), Math.Pow(given.zero, given.zero), Math.Pow(-0.5, -3));
    // Atan2 where there's no direction, and along each axis
    rest.corners = float4(Math.Atan2(given.zero, given.zero), Math.Atan2(two, given.zero), Math.Atan2(given.zero, -two),
                          Math.Atan2(-two, -two));
    // SmoothStep from an edge down to a lower one, and between two at the same place
    rest.edges = float4(Math.SmoothStep(1, 0, 0.25), Math.SmoothStep(two, two, 1), Math.SmoothStep(two, two, 3),
                        Math.SmoothStep(two, two, two));
    // Clamp with its bounds the wrong way around gives the lower one
    rest.wrong = float2(Math.Clamp(5.0, 3, 1), Math.Clamp(given.wide, two, 1));
    rest.wrongInts = int2(Math.Clamp(5, 3, 1), Math.Clamp(given.one, 7, given.one));
    return rest;
}

bool SameRest(Rest a, Rest b)
{
    mut bool same = Close4(a.mins, b.mins) && Close4(a.maxes, b.maxes) && Close4(a.clamps, b.clamps) && Close4(a.smooths, b.smooths);
    same = same && Close4(a.powers, b.powers) && Close4(a.arcs, b.arcs) && Close4(a.units, b.units) && Close4(a.ends, b.ends);
    same = same && Close4(a.saturated, b.saturated) && Close2(a.capped, b.capped) && Close4(a.bad, b.bad) && Close4(a.bad2, b.bad2) && Close3(a.badVector, b.badVector);
    same = same && Close4(a.none, b.none) && Close4(a.turnedPowers, b.turnedPowers) && Close4(a.corners, b.corners);
    same = same && Close4(a.edges, b.edges) && Close2(a.wrong, b.wrong);
    return same && a.wrongInts.x == b.wrongInts.x && a.wrongInts.y == b.wrongInts.y;
}

frag HashFrag(Corner3 vertex, out Color color, Probe probe)
{
    color = SameHashes(HashesOf(probe.given), probe.hashes) ? Color.green : Color.red;
}

frag TurnFrag(Corner3 vertex, out Color color, Probe probe)
{
    color = SameTurns(TurnsOf(probe.given), probe.turns) ? Color.green : Color.red;
}

frag MatrixFrag(Corner3 vertex, out Color color, Probe probe)
{
    color = SameMatrices(MatricesOf(probe.given), probe.matrices) ? Color.green : Color.red;
}

frag RestFrag(Corner3 vertex, out Color color, Probe probe)
{
    color = SameRest(RestOf(probe.given), probe.rest) ? Color.green : Color.red;
}

vert HashVert(mut Corner3 vertex, Probe probe)
{
    vertex.color = SameHashes(HashesOf(probe.given), probe.hashes) ? Color.green : Color.red;
}

vert TurnVert(mut Corner3 vertex, Probe probe)
{
    vertex.color = SameTurns(TurnsOf(probe.given), probe.turns) ? Color.green : Color.red;
}

vert MatrixVert(mut Corner3 vertex, Probe probe)
{
    vertex.color = SameMatrices(MatricesOf(probe.given), probe.matrices) ? Color.green : Color.red;
}

vert RestVert(mut Corner3 vertex, Probe probe)
{
    vertex.color = SameRest(RestOf(probe.given), probe.rest) ? Color.green : Color.red;
}

// A vert reads its vertex's ints, and samples too
vert Checks(mut Corner3 vertex, Art art)
{
    Color sampled = art.four.Sample(float2(0.75, 0.75), Filter.Point);
    if (vertex.kind == 3 && sampled.b > 0.5) vertex.color = Color.green * sampled;
    else vertex.color = Color.red;
}

// Explicit Texture inputs, target colors, and Texture fields use the same
// top-left UVs. Point and bilinear bindings can share one image in a shader.
frag TargetCopy(Vertex vertex, out Color color, Texture source)
{
    color = source.Sample(vertex.uv, Filter.Point);
}

frag TargetAlpha(Vertex vertex, out Color color, Texture source)
{
    color = source.Sample(vertex.uv, Filter.Point);
    color.a = 0.25;
}

frag TargetInspect(Vertex vertex, out Color color, Texture source, Art art)
{
    Color nearest = art.targetTexture.Sample(float2(0.25, 0.25), Filter.Point);
    Color middle = art.targetTexture.Sample(float2(0.5, 0.5));
    Color sampled = source.Sample(vertex.uv, Filter.Point);
    bool correct = nearest.r > 0.99 && nearest.g < 0.01 && nearest.b < 0.01
                && Halfway(middle.r) && Halfway(middle.g) && Halfway(middle.b);
    color = correct ? Color(sampled.a, sampled.r, sampled.g) : Color.magenta;
}

// Where a pixel is, over the window's size: in logical pixels, so the same
// picture on a display of any scale, in a target as in the window.
frag Where(Vertex vertex, out Color color, Texture source, Pixel pixel, Art art)
{
    color = Color(pixel.position.x / art.window.x, pixel.position.y / art.window.y, 0);
}

// What a uv past a texture's edges reads, said where it's sampled (pass 7).
frag Clamped(Vertex vertex, out Color color, Art art)
{
    color = art.four.Sample(vertex.uv, Filter.Point, Wrap.Clamp);
}

frag Repeated(Vertex vertex, out Color color, Art art)
{
    color = art.four.Sample(vertex.uv, Filter.Point, Wrap.Repeat);
}

frag Mirrored(Vertex vertex, out Color color, Art art)
{
    color = art.four.Sample(vertex.uv, Filter.Point, Wrap.Mirror);
}

// The Texture its draw gives it: a target's color
frag SourceMirrored(Vertex vertex, out Color color, Texture source)
{
    color = source.Sample(vertex.uv, Filter.Point, Wrap.Mirror);
}

// One grid read two ways in one frag: its left half repeats, and its right half mirrors
frag BothWays(Vertex vertex, out Color color, Art art)
{
    if (vertex.uv.x < 1) color = art.four.Sample(vertex.uv, Filter.Point, Wrap.Repeat);
    else color = art.four.Sample(vertex.uv, Filter.Point, Wrap.Mirror);
}

// Blended: what a cell at the edge blends with is what the wrap says is past it
frag SmoothRepeated(Vertex vertex, out Color color, Art art)
{
    color = art.four.Sample(vertex.uv, Filter.Bilinear, Wrap.Repeat);
}

frag SmoothMirrored(Vertex vertex, out Color color, Art art)
{
    color = art.four.Sample(vertex.uv, Filter.Bilinear, Wrap.Mirror);
}

// A vert samples past the edges too
vert TileChecks(mut Vertex vertex, Art art)
{
    Color repeated = art.four.Sample(float2(1.25, 0.25), Filter.Point, Wrap.Repeat); // As (0.25, 0.25): red
    Color mirrored = art.four.Sample(float2(1.25, 0.25), Filter.Point, Wrap.Mirror); // As (0.75, 0.25): green
    Color clamped = art.four.Sample(float2(1.25, 1.25), Filter.Point);               // Its last cell: white
    bool correct = repeated.r > 0.99 && repeated.g < 0.01 && mirrored.g > 0.99 && mirrored.r < 0.01
                && clamped.r > 0.99 && clamped.b > 0.99;
    vertex.color = correct ? Color.white : Color.magenta;
}

vert TextureChecks(mut Vertex vertex, Texture source)
{
    Color nearest = source.Sample(float2(0.25, 0.25), Filter.Point);
    Color middle = source.Sample(float2(0.5, 0.5));
    bool correct = nearest.r > 0.99 && nearest.g < 0.01 && nearest.b < 0.01
                && Halfway(middle.r) && Halfway(middle.g) && Halfway(middle.b);
    vertex.color = correct ? Color.white : Color.magenta;
}

// ---------------------------------------------------------------------------

event(Spawned) Setup(with Main)
{
    Spawn(Box { pos = Cell(0, 0), tint = Color.red });
    Spawn(Box { pos = Cell(1, 0), tint = Color.green });
    Spawn(Box { pos = Cell(2, 0), tint = Color.blue });
    Spawn(Lamp { pos = Cell(0, 3), at = Spot(0, 6), glow = Color.red, kind = 1 });
    Spawn(Lamp { pos = Cell(1, 3), at = Spot(1, 6), glow = Color.green, on = true, mode = Mode.Bright,
                 finish = Finish { shine = 0.5, layers = 2 } });
    Spawn(Lamp { pos = Cell(2, 3), at = Spot(2, 6), glow = Color.blue });
}

view Start(mut Art art, mut Probe probe)
{
    art.frames += 1;
    if (art.frames == 1)
    {
        // What Math is worked out from, and what the CPU makes of it
        long whole = 81985529216486895L;
        probe.given.low = int(whole);
        probe.given.high = int(whole >> 32);
        probe.given.turn = quaternion.Euler(float3(0.2, 0.4, -0.3));
        probe.given.other = quaternion.Euler(float3(1, -0.5, 0.8));
        probe.given.four = float4x4.TRS(float3(3, -4, 5), probe.given.turn, float3(2, 0.5, 1.5));
        probe.given.nan = probe.given.zero / probe.given.zero;
        probe.hashes = HashesOf(probe.given);
        probe.turns = TurnsOf(probe.given);
        probe.matrices = MatricesOf(probe.given);
        probe.rest = RestOf(probe.given);
        Debug.Assert(probe.given.nan != probe.given.nan, "0 / 0 is no number");
        Debug.Assert(probe.hashes.halves == Math.Hash(whole), "a long's hash is its halves', as an int2");
        Debug.Assert(probe.rest.bad.x == 2 && probe.rest.bad.y == 2 && probe.rest.bad.z == 1 && probe.rest.bad.w == 0,
                     "Min and Max of a NaN and a number are the number, and Clamp of a NaN its lower bound");

        // A square around the origin, its uv (0, 0) at its top left corner
        art.quad = [Corner3 { position = float3(-12, 12, 0), normal = float3(1, 0, 0), color = Color.yellow, kind = 3 },
                    Corner3 { position = float3(12, 12, 0), normal = float3(1, 0, 0), uv = float2(1, 0), color = Color.yellow, kind = 3 },
                    Corner3 { position = float3(12, -12, 0), normal = float3(1, 0, 0), uv = float2(1, 1), color = Color.yellow, kind = 3 },
                    Corner3 { position = float3(-12, -12, 0), normal = float3(1, 0, 0), uv = float2(0, 1), color = Color.yellow, kind = 3 }];
        art.dots = [Dot { position = float3(-12, 12, 0) }, Dot { position = float3(12, 12, 0) },
                    Dot { position = float3(12, -12, 0) }, Dot { position = float3(-12, -12, 0) }];
        art.dots2 = [Dot2 { position = float2(-12, 12) }, Dot2 { position = float2(12, 12) },
                     Dot2 { position = float2(12, -12) }, Dot2 { position = float2(-12, -12) }];
        art.flat = [Corner2 { position = float2(-12, 12) }, Corner2 { position = float2(12, 12), uv = float2(1, 0) },
                    Corner2 { position = float2(12, -12), uv = float2(1, 1) }, Corner2 { position = float2(-12, -12), uv = float2(0, 1) }];
        // In the screen's pixels, from the top left: Cell(4, 4)'s square
        art.onScreen = [Corner2 { position = float2(132, 132) }, Corner2 { position = float2(156, 132) },
                        Corner2 { position = float2(156, 156) }, Corner2 { position = float2(132, 156) }];
        art.faces = [0, 1, 2, 0, 2, 3];
        art.backFaces = [0, 2, 1, 0, 3, 2];
        art.targetQuad = [Vertex { position = float2(0, 0) },
                          Vertex { position = float2(Screen.width, 0), uv = float2(1, 0) },
                          Vertex { position = float2(Screen.width, Screen.height), uv = float2(1, 1) },
                          Vertex { position = float2(0, Screen.height), uv = float2(0, 1) }];
        art.manualMesh = [Vertex3 { position = float3(-12, 12, 0) },
                          Vertex3 { position = float3(12, 12, 0), uv = float2(1, 0) },
                          Vertex3 { position = float3(12, -12, 0), uv = float2(1, 1) },
                          Vertex3 { position = float3(-12, -12, 0), uv = float2(0, 1) }];
        art.manualTransforms = [float4x4.Translate(Cell(3, 7))];
        art.manual3 = [Batch3 { transform = float4x4.Translate(Cell(0, 7)), tint = Color.red, kind = 0 },
                       Batch3 { transform = float4x4.Translate(Cell(1, 7)), tint = Color.green, kind = 1 },
                       Batch3 { transform = float4x4.Translate(Cell(2, 7)), tint = Color.blue, kind = 2 }];
        art.manual2 = [Batch2 { at = Spot(4, 7), tint = Color.yellow, kind = 3,
                               transform = float4x4.Translate(float3(10000)) },
                       Batch2 { at = Spot(5, 7), tint = Color.cyan, kind = 3,
                               transform = float4x4.Translate(float3(10000)) }];
        art.manualTextured = [Batch2 { at = Spot(6, 7) }];
        art.handedItems = [Batch3 { transform = float4x4.Translate(Cell(3, 1)), tint = Color(0, 1, 1) }];
        art.four[0, 0] = Color.red;
        art.four[1, 0] = Color.green;
        art.four[0, 1] = Color.blue;
        art.four[1, 1] = Color.white;
    }
    Draw.Clear(Color(0.1, 0.1, 0.1));
    // A unit a pixel, the origin at the screen's middle, looking along +z
    Draw.SetCamera(float4x4.identity, float4x4.Ortho(Screen.width, Screen.height, 0.1, 100));
}

// Three entities, three tints, one draw
view Boxes(Box box, Art art)
{
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(box.pos), Tinted);
}

view Singles(Art art)
{
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(4, 0)), Blank);
    Draw.Mesh(art.dots, art.faces, float4x4.Translate(Cell(5, 0)));
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(6, 0)));

    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(0, 1)), Shift);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(4, 1)), Wood);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(5, 1)), Smooth);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(6, 1)), art.four, Filter.Point);

    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(0, 2)), Split);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(1, 2)), Hole);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(2, 2)), World);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(3, 2)), ByDepth);
    var turned = float4x4.TRS(Cell(4, 2), quaternion.AxisAngle(float3(0, 0, 1), Math.Radians(90)), float3(1));
    Draw.Mesh(art.quad, art.faces, turned, Turn, Normal);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(5, 2)), Placed);

    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(0, 5)), Sink);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(1, 5)), Checks);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(2, 5)), More);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(7, 3)), Counts);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(7, 5)), Around);

    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(3, 0)), Hand, Take);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(1, 1)), Hand, TakeWhole);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(6, 2)), Hand); // What it writes goes nowhere
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(4, 6)), Hand, TakeHalf);
}

view Lamps(Lamp lamp, Art art)
{
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(lamp.pos), Lit);
}

// Math, in a frag each, and below them in a vert
view Sums(Art art)
{
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(3, 3)), HashFrag);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(4, 3)), TurnFrag);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(5, 3)), MatrixFrag);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(6, 3)), RestFrag);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(3, 5)), HashVert);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(4, 5)), TurnVert);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(5, 5)), MatrixVert);
    Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(6, 5)), RestVert);
}

// 2D meshes go through the 2D camera, in order with the other 2D calls
view Flat(Art art)
{
    Draw.SetCamera(-Spot(0, 4), Screen.height / 2);
    Draw.Rect(float2(0, 0), float2(32, 32), Color.blue);
    Draw.Mesh(art.flat, art.faces, Paint);
    Draw.Rect(float2(0, 0), float2(8, 8), Color.green);

    Draw.SetCamera(-Spot(2, 4), Screen.height / 2);
    Draw.Mesh(art.dots2, art.faces);
    Draw.SetCamera(-Spot(3, 4), Screen.height / 2);
    Draw.Mesh(art.flat, art.faces, art.four, Filter.Point);
    Draw.SetCamera(-Spot(5, 4), Screen.height / 2);
    Draw.Mesh(art.flat, art.faces, Slide);
    Draw.SetCamera(-Spot(1, 4), Screen.height / 2);
    Draw.Mesh(art.flat, art.faces, Hand2, Take2);

    Draw.SetScreen();
    Draw.Mesh(art.onScreen, art.faces, Stripe);
    Draw.SetCamera(float2(0, 0), Screen.height / 2);
}

// Three entities in one 2D draw: the vert puts each where its component says
view FlatLamps(with Lamp, Art art)
{
    Draw.Mesh(art.flat, art.faces, Place, Glow);
}

view Manual(Art art)
{
    Draw.Instanced(art.quad, art.faces, art.empty, BatchPlace3, BatchPaint3);
    Draw.Instanced(art.quad, art.faces, art.manual3, BatchPlace3, BatchPaint3);
    Draw.Instanced(art.manualMesh, art.faces, art.manualTransforms, art.four, Filter.Point);
    Draw.Instanced(art.flat, art.faces, art.manual2, BatchPlace2, BatchPaint2);
    Draw.Instanced(art.flat, art.faces, art.manualTextured, art.four, Filter.Point, BatchPlace2);
    Draw.Instanced(art.quad, art.faces, art.handedItems, HandItem, TakeItem);
}

frag Bare(Corner3 vertex, out Color color)
{
    color = Color.white;
}

// A draw's settings reach its frag's pixels: what tints them, how they go over
// what's there, and where the mesh lands.
view Settings(Art art)
{
    // A tint multiplies what the frag wrote: Paint's orange
    Draw.Transform(Spot(7, 0)),
    Draw.Tint(Color(0.5, 1, 1, 1))
    {
        Draw.Mesh(art.flat, art.faces, Paint);
    }
    // Added to what's there, and multiplying it by as much as its alpha says
    Draw.Rect(Spot(7, 1), float2(24, 24), Color(0, 0, 0.5, 1));
    Draw.Transform(Spot(7, 1)),
    Draw.Blend(Blend.Add)
    {
        Draw.Mesh(art.flat, art.faces, Paint);
    }
    Draw.Rect(Spot(7, 2), float2(24, 24), Color(0.5, 1, 1, 1));
    Draw.Transform(Spot(7, 2)),
    Draw.Blend(Blend.Multiply),
    Draw.Tint(Color(1, 1, 1, 0.5))
    {
        Draw.Mesh(art.flat, art.faces, Paint);
    }
    // Turned an eighth and half as big: a diamond
    Draw.Transform(Spot(7, 6), Math.PI / 4, 0.5)
    {
        Draw.Mesh(art.flat, art.faces, Paint);
    }
    // In 3D, each instance goes through the transform on its way to the world
    Draw.Transform(float4x4.Translate(Cell(7, 3))),
    Draw.Tint(Color(0, 1, 0, 1))
    {
        Draw.Mesh(art.quad, art.faces, float4x4.identity, Bare);
    }
}

// A vert that mirrors its mesh itself, which nothing but the game knows of:
// its triangles reach the screen the other way round.
vert Flip(mut Corner3 vertex)
{
    vertex.position.x = -vertex.position.x;
}

// A quarter of a cell: the quad at two fifths of its size, `right` and `down`
// pixels from the cell's middle, mirrored left to right by `mirror` of -1.
float4x4 Quarter(int column, int row, float right, float down, float mirror)
{
    return float4x4.TRS(Cell(column, row) + float3(right, -down, 0), quaternion.identity, float3(0.4 * mirror, 0.4, 1));
}

// Which side of a triangle draws: the front, the side its corners go
// clockwise on, through a frag and a vert as without them.
view Sides(Art art)
{
    // Mirrored by its own transform, its front is still its front
    Draw.Mesh(art.quad, art.faces, Quarter(5, 6, -7, -7, -1), Blank);
    // Seen from the back, it isn't drawn, mirrored or not, unless the draw says the back is
    Draw.Mesh(art.quad, art.backFaces, Quarter(5, 6, 7, -7, 1), Blank);
    Draw.Mesh(art.quad, art.backFaces, Quarter(5, 6, 7, 7, -1), Blank);
    Draw.Cull(Cull.Front)
    {
        Draw.Mesh(art.quad, art.backFaces, Quarter(5, 6, -7, 7, 1), Blank);
    }
    // What a vert does to the triangles is the game's to draw for
    Draw.Mesh(art.quad, art.faces, Quarter(6, 6, -7, -7, 1), Flip, Blank);
    Draw.Mesh(art.quad, art.backFaces, Quarter(6, 6, 7, 7, 1), Flip, Blank);
    Draw.Cull(Cull.Front)
    {
        Draw.Mesh(art.quad, art.faces, Quarter(6, 6, 7, -7, 1), Flip, Blank);
    }
    Draw.Cull(Cull.None)
    {
        Draw.Mesh(art.quad, art.faces, Quarter(6, 6, -7, 7, 1), Flip, Blank);
    }
}

// Targets that take their size from the window, and one with pixels of its
// own: made once, and never resized, whatever shaders.c makes of the window
// and its display's scale afterwards.
[After(Targets)]
view ScreenTargets(mut Art art)
{
    if (art.targetPass != 6) return;
    if (!art.sized)
    {
        art.full = RenderTarget.Screen();
        art.half = RenderTarget.Screen(0.5);
        art.exact = RenderTarget(4, 4, 1);
        art.sized = true;
    }
    var w = Screen.width;
    var h = Screen.height;
    art.window = float2(w, h);
    // Where each of its pixels is, then a square in its top right corner: in logical pixels, as in the window
    Draw.Blit(art.uploaded, art.full, Where);
    art.full.SetScreen();
    art.full.Rect(float2(w - 16, 16), float2(32), Color.blue);
    // Half the window, so its own left half is a quarter of the window across
    art.half.SetScreen();
    art.half.Clear(Color.black);
    art.half.Rect(float2(w * 0.125, h * 0.25), float2(w * 0.25, h * 0.5), Color.green);
    // Four pixels by four on any display, the first one white
    art.exact.SetScreen();
    art.exact.Clear(Color.black);
    art.exact.Rect(float2(0.5), float2(1), Color.white);

    Draw.Blit(art.full.color, Draw.window, TargetCopy);
    Draw.SetScreen();
    Draw.SetClip();
    // The half one over the window's bottom right quarter, pixel for pixel
    Draw.Mesh([Vertex { position = float2(w * 0.5, h * 0.5) },
                 Vertex { position = float2(w, h * 0.5), uv = float2(1, 0) },
                 Vertex { position = float2(w, h), uv = float2(1, 1) },
                 Vertex { position = float2(w * 0.5, h), uv = float2(0, 1) }], art.faces, art.half.color, Filter.Point);
    // ...and the exact one 64 logical pixels square in its bottom left corner, blended between its four pixels
    Draw.Mesh([Vertex { position = float2(0, h - 64) },
                 Vertex { position = float2(64, h - 64), uv = float2(1, 0) },
                 Vertex { position = float2(64, h), uv = float2(1, 1) },
                 Vertex { position = float2(0, h), uv = float2(0, 1) }], art.faces, art.exact.color);
}

// What a uv past a texture's edges reads (pass 7): squares in the screen's
// pixels whose uvs go to (2, 2), so each shows its texture twice across and
// twice down, or what its wrap makes of that. The grid and the target are red,
// green, blue and white, two by two.
[After(ScreenTargets)]
view Wraps(mut Art art)
{
    if (art.targetPass != 7) return;
    if (!art.tiled)
    {
        art.tiles = RenderTarget(2, 2, 1);
        art.tile = [Vertex { }, Vertex { position = float2(48, 0), uv = float2(2, 0) },
                    Vertex { position = float2(48, 48), uv = float2(2, 2) }, Vertex { position = float2(0, 48), uv = float2(0, 2) }];
        // Twice across its top row alone
        art.wideTile = [Vertex { uv = float2(0, 0.25) }, Vertex { position = float2(96, 0), uv = float2(2, 0.25) },
                        Vertex { position = float2(96, 24), uv = float2(2, 0.25) }, Vertex { position = float2(0, 24), uv = float2(0, 0.25) }];
        art.cornerTile = [Corner2 { }, Corner2 { position = float2(48, 0), uv = float2(2, 0) },
                          Corner2 { position = float2(48, 48), uv = float2(2, 2) }, Corner2 { position = float2(0, 48), uv = float2(0, 2) }];
        art.tile3 = [Vertex3 { position = float3(-12, 12, 0) }, Vertex3 { position = float3(12, 12, 0), uv = float2(2, 0) },
                     Vertex3 { position = float3(12, -12, 0), uv = float2(2, 2) }, Vertex3 { position = float3(-12, -12, 0), uv = float2(0, 2) }];
        art.tilePlaces = [float4x4.Translate(Cell(2, 7)), float4x4.Translate(Cell(3, 7))];
        art.tiled = true;
    }
    art.tiles.SetScreen();
    art.tiles.Clear(Color.black);
    art.tiles.Rect(float2(0.5, 0.5), float2(1), Color.red);
    art.tiles.Rect(float2(1.5, 0.5), float2(1), Color.green);
    art.tiles.Rect(float2(0.5, 1.5), float2(1), Color.blue);
    art.tiles.Rect(float2(1.5, 1.5), float2(1), Color.white);

    Draw.Clear(Color.black);
    Draw.SetScreen();
    Draw.SetClip();
    // The engine's own vertices: the draw says the wrap, after the filter, and none is the cells at the edge
    Draw.Transform(float2(8, 8))
    {
        Draw.Mesh(art.tile, art.faces, art.four, Filter.Point);
    }
    Draw.Transform(float2(64, 8))
    {
        Draw.Mesh(art.tile, art.faces, art.four, Filter.Point, Wrap.Repeat);
    }
    Draw.Transform(float2(120, 8))
    {
        Draw.Mesh(art.tile, art.faces, art.four, Filter.Point, Wrap.Mirror);
    }
    // A render target's color wraps as a grid does
    Draw.Transform(float2(176, 8))
    {
        Draw.Mesh(art.tile, art.faces, art.tiles.color, Filter.Point, Wrap.Repeat);
    }
    // A frag says it where it samples
    Draw.Transform(float2(8, 64))
    {
        Draw.Mesh(art.tile, art.faces, Clamped);
    }
    Draw.Transform(float2(64, 64))
    {
        Draw.Mesh(art.tile, art.faces, Repeated);
    }
    Draw.Transform(float2(120, 64))
    {
        Draw.Mesh(art.tile, art.faces, Mirrored);
    }
    Draw.Transform(float2(176, 64))
    {
        Draw.Mesh(art.tile, art.faces, art.tiles.color, SourceMirrored);
    }
    Draw.Transform(float2(8, 120))
    {
        Draw.Mesh(art.tile, art.faces, BothWays);
    }
    Draw.Transform(float2(64, 120))
    {
        Draw.Mesh(art.tile, art.faces, TileChecks);
    }
    // A vertex of the game's with no frag: one shader, whose draws say the wrap or leave it out
    Draw.Transform(float2(120, 120))
    {
        Draw.Mesh(art.cornerTile, art.faces, art.four, Filter.Point, Wrap.Mirror);
    }
    Draw.Transform(float2(176, 120))
    {
        Draw.Mesh(art.cornerTile, art.faces, art.four, Filter.Point);
    }
    Draw.Transform(float2(8, 176))
    {
        Draw.Mesh(art.wideTile, art.faces, SmoothRepeated);
    }
    Draw.Transform(float2(120, 176))
    {
        Draw.Mesh(art.wideTile, art.faces, SmoothMirrored);
    }
    // 3D meshes, and a list's instances with a target's color
    Draw.Mesh(art.tile3, art.faces, float4x4.Translate(Cell(0, 7)), art.four, Filter.Point, Wrap.Repeat);
    Draw.Mesh(art.tile3, art.faces, float4x4.Translate(Cell(1, 7)), art.four, Filter.Point, Wrap.Mirror);
    Draw.Instanced(art.tile3, art.faces, art.tilePlaces, art.tiles.color, Filter.Point, Wrap.Repeat);
    Draw.Mesh(art.tile3, art.faces, float4x4.Translate(Cell(4, 7)), art.uploaded, Filter.Point, Wrap.Mirror);
}

// A shadow map, the whole way (pass 8). What's nearest the lamp goes into a
// target of depth alone, through the lamp's camera, and the frag that lights
// a pixel compares how far that pixel is from the lamp with what's stored
// where the lamp sees it.
local singleton Shadow
{
    RenderTarget map;      // Depth alone, 256 pixels by 256 whatever the display
    DepthTexture depth;    // ...as the frags read it
    float4x4 toLamp;       // From the world to the lamp's clip space
    List<Vertex3> floor;
    List<Vertex3> slab;    // Casts a shadow, and is lit itself
    List<Vertex3> grate;   // Casts through a frag that leaves its left half out
    List<Vertex> readout;  // Where the lamp's depth shows: the window's top left corner
    bool made;
}

// Where a point of the world is in the lamp's image, a uv from its top left
// corner, and how far from the lamp it is there, a depth from 0 to 1.
float3 FromLamp(float3 world, float4x4 toLamp)
{
    float4 clip = Math.Mul(toLamp, float4(world, 1));
    return float3(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5, clip.z * 0.5 + 0.5);
}

frag Shadowed(Vertex3 vertex, out Color color, Pixel pixel, Shadow shadow)
{
    float3 at = FromLamp(pixel.world, shadow.toLamp);
    // A little nearer than it is, so what the lamp sees isn't in its own shadow
    float lit = shadow.depth.Compare(at.xy, at.z - 0.01);
    float shade = 0.25 + 0.75 * lit;
    color = Color(vertex.color.r * shade, vertex.color.g * shade, vertex.color.b * shade);
}

// What a caster with holes in it is: its color goes nowhere in the lamp's
// target, and the pixels it leaves out cast nothing.
frag Grate(Vertex3 vertex, out Color color, Pixel pixel)
{
    if (vertex.uv.x < 0.5) pixel.Discard();
    color = Color.magenta;
}

frag LampDepth(Vertex vertex, out Color color, Shadow shadow)
{
    float depth = shadow.depth.Sample(vertex.uv);
    color = Color(depth, depth, depth);
}

[After(ScreenTargets)]
view Shadows(Art art, mut Shadow shadow)
{
    if (art.targetPass != 8) return;
    if (!shadow.made)
    {
        shadow.made = true;
        shadow.map = RenderTarget(256, 256, 1, Format.DepthOnly);
        shadow.depth = shadow.map.depth;
        // The floor, 8 by 8 around the origin; a slab 1 above it; a grate 2 above it, its uv from 0 to 1 along x
        shadow.floor = [Vertex3 { position = float3(-4, 0, 4) }, Vertex3 { position = float3(4, 0, 4) },
                        Vertex3 { position = float3(4, 0, -4) }, Vertex3 { position = float3(-4, 0, -4) }];
        shadow.slab = [Vertex3 { position = float3(-3, 1, 1), color = Color.red }, Vertex3 { position = float3(-1, 1, 1), color = Color.red },
                       Vertex3 { position = float3(-1, 1, -1), color = Color.red }, Vertex3 { position = float3(-3, 1, -1), color = Color.red }];
        shadow.grate = [Vertex3 { position = float3(0, 2, -1) }, Vertex3 { position = float3(2, 2, -1), uv = float2(1, 0) },
                        Vertex3 { position = float3(2, 2, -3), uv = float2(1, 1) }, Vertex3 { position = float3(0, 2, -3), uv = float2(0, 1) }];
        shadow.readout = [Vertex { position = float2(0, 0) }, Vertex { position = float2(64, 0), uv = float2(1, 0) },
                          Vertex { position = float2(64, 64), uv = float2(1, 1) }, Vertex { position = float2(0, 64), uv = float2(0, 1) }];
    }
    // The lamp looks down and along +x, halfway between the two, from 10 away: a shadow falls as far
    // along +x as what casts it is high. Its camera sees a box 16 by 16, with no perspective.
    quaternion down = quaternion.AxisAngle(float3(1, 0, 0), Math.PI * 0.5);
    quaternion slant = Math.Mul(quaternion.AxisAngle(float3(0, 0, 1), Math.PI * 0.25), down);
    float4x4 lamp = float4x4.TRS(Math.Mul(slant, float3(0, 0, -10)), slant, float3(1));
    float4x4 sees = float4x4.Ortho(16, 16, 0.1, 30);
    // A camera looks along its +z, and clip space along -z: the world to the lamp's clip space is its
    // projection, after z turned around, after the lamp's transform undone
    shadow.toLamp = Math.Mul(sees, Math.Mul(float4x4.TRS(float3(0), quaternion.identity, float3(1, 1, -1)), Math.Inverse(lamp)));

    // What casts, into the lamp's target: as far as a clear leaves it, then each caster's depth. The
    // slab has no frag, and the grate's leaves half of it out; neither's color goes anywhere there
    shadow.map.Clear(Color.white);
    shadow.map.SetCamera(lamp, sees);
    shadow.map.Mesh(shadow.slab, art.faces, float4x4.identity);
    shadow.map.Mesh(shadow.grate, art.faces, float4x4.identity, Grate);
    shadow.map.SetScreen();
    shadow.map.Rect(float2(128, 128), float2(256), Color.blue);

    // The window, from straight above: x to the right and z up, 8 by 8
    Draw.SetClip();
    Draw.Clear(Color.black);
    Draw.SetCamera(float4x4.TRS(float3(0, 10, 0), down, float3(1)), float4x4.Ortho(8, 8, 0.1, 30));
    Draw.Mesh(shadow.floor, art.faces, float4x4.identity, Shadowed);
    Draw.Mesh(shadow.slab, art.faces, float4x4.identity, Shadowed);
    // ...and what the lamp's target holds, as a picture
    Draw.SetScreen();
    Draw.Mesh(shadow.readout, art.faces, LampDepth);
}

// ---------------------------------------------------------------------------
// Stencil (pass 9): a number for each pixel, which draws store and are tested
// against, in the window and in a target of the game's.

local singleton Mask
{
    RenderTarget target;  // 64 pixels by 64 whatever the display
    List<Vertex> square;  // 64 across from its corner, green
    List<Vertex> picture; // ...and white, for a texture
    bool made;
}

// A sheet that leaves its right half out: what it stores, it stores on the left.
frag LeftHalf(Vertex vertex, out Color color, Pixel pixel)
{
    if (vertex.uv.x > 0.5) pixel.Discard();
    color = Color.clear;
}

frag Own(Vertex vertex, out Color color)
{
    color = vertex.color;
}

// Half as big, about its corner.
vert Halved(mut Vertex vertex)
{
    vertex.position = vertex.position * 0.5;
}

[After(Shadows)]
view Masks(Art art, mut Mask mask)
{
    if (art.targetPass != 9) return;
    if (!mask.made)
    {
        mask.made = true;
        mask.target = RenderTarget(64, 64, 1);
        mask.square = [Vertex { color = Color.green }, Vertex { position = float2(64, 0), uv = float2(1, 0), color = Color.green },
                       Vertex { position = float2(64, 64), uv = float2(1, 1), color = Color.green },
                       Vertex { position = float2(0, 64), uv = float2(0, 1), color = Color.green }];
        mask.picture = [Vertex { }, Vertex { position = float2(64, 0), uv = float2(1, 0) },
                        Vertex { position = float2(64, 64), uv = float2(1, 1) }, Vertex { position = float2(0, 64), uv = float2(0, 1) }];
    }
    Draw.SetClip();
    Draw.Clear(Color.blue); // ...and every pixel's number is 0
    Draw.SetScreen();

    // A circle drawn clear stores where it is, and shows nothing; a rect over it is drawn where it stored
    Draw.Stencil(StencilTest.Always, 1, StencilOp.Replace)
    {
        Draw.Circle(float2(48, 48), 32, Color.clear);
    }
    Draw.Stencil(StencilTest.Equal, 1)
    {
        Draw.Rect(float2(48, 48), float2(96, 96), Color.white);
    }

    // Through a frag, a mesh stores where its pixels weren't discarded; one through another, and a vert, is tested
    Draw.Transform(float2(128, 16))
    {
        Draw.Stencil(StencilTest.Always, 2, StencilOp.Replace)
        {
            Draw.Mesh(mask.square, art.faces, LeftHalf);
        }
        Draw.Stencil(StencilTest.Equal, 2)
        {
            Draw.Mesh(mask.square, art.faces, Own);
            // Half as big, drawn where the number isn't the sheet's: its right half, past the sheet's
            Draw.SetStencil(StencilTest.NotEqual, 2);
            Draw.Transform(float2(48, 48))
            {
                Draw.Mesh(mask.picture, art.faces, Halved, Own);
            }
        }
    }

    // Two rects that count one more each: where both are, it's 2
    Draw.Stencil(StencilTest.Always, 0, StencilOp.Increment)
    {
        Draw.Rect(float2(48, 160), float2(64, 64), Color.clear);
        Draw.Rect(float2(80, 160), float2(64, 64), Color.clear);
    }
    Draw.Stencil(StencilTest.Equal, 2)
    {
        Draw.Rect(float2(64, 160), float2(128, 64), Color(1, 1, 0));
    }
    Draw.Stencil(StencilTest.Equal, 1)
    {
        Draw.Rect(float2(64, 160), float2(128, 64), Color.magenta);
    }

    // 3D meshes store and are tested as 2D draws are: a square stores, a rect is drawn where it did, and a
    // square twice as big around it only where it didn't
    Draw.SetCamera(float4x4.TRS(float3(0, 0, -10), quaternion.identity, float3(1)), float4x4.Ortho(256, 256, 0.1, 30));
    Draw.Stencil(StencilTest.Always, 5, StencilOp.Replace)
    {
        Draw.Mesh(art.quad, art.faces, float4x4.Translate(Cell(5, 4)), Bare);
    }
    Draw.Stencil(StencilTest.Equal, 5)
    {
        Draw.Rect(float2(176, 144), float2(64, 64), Color.red);
    }
    Draw.Stencil(StencilTest.NotEqual, 5)
    {
        Draw.Mesh(art.quad, art.faces, float4x4.TRS(Cell(5, 4), quaternion.identity, float3(2, 2, 1)), Bare);
    }

    // A target's stencil is its own, and so is what its draws do with it: the window's, which lets nothing
    // through here, is nothing to them
    Draw.Stencil(StencilTest.Never, 0)
    {
        mask.target.Clear(Color.black);
        mask.target.SetScreen();
        mask.target.Stencil(StencilTest.Always, 1, StencilOp.Replace)
        {
            mask.target.Rect(float2(16, 32), float2(32, 64), Color.clear);
        }
        mask.target.Stencil(StencilTest.Equal, 1)
        {
            mask.target.Rect(float2(32, 32), float2(64, 64), Color.green);
        }
    }
    Draw.Transform(float2(192, 192))
    {
        Draw.Mesh(mask.picture, art.faces, mask.target.color, Filter.Point);
    }
}

// Images of the game's own (pass 10): a Texture asset, drawn with the pack's
// pixels, and how a texture's declaration says it's sampled wherever a draw
// or a Sample that names it doesn't say. four.png is `four`'s colors: red,
// green, blue and white, two by two. Squares as Wraps', their uvs to (2, 2).
[Filter(Filter.Point), Wrap(Wrap.Repeat)]
asset Texture bricks = "four.png";
[Filter(Filter.Point)]
asset Texture plainBricks = "four.png";
asset List<Texture> brickFrames = "four*.png";
[Filter(Filter.Point), Wrap(Wrap.Mirror)]
asset Grid2<Color> brickCells = "four.png";

frag BricksByName(Vertex vertex, out Color color)
{
    color = bricks.Sample(vertex.uv);
}

frag BrickCellsByName(Vertex vertex, out Color color)
{
    color = brickCells.Sample(vertex.uv);
}

// What its Sample leaves unsaid is its draw's source's to say
frag BrickSource(Vertex vertex, out Color color, Texture source)
{
    color = source.Sample(vertex.uv);
}

frag PaintedByName(Vertex vertex, out Color color, Art art)
{
    color = art.painted.Sample(vertex.uv);
}

[After(ScreenTargets)]
view Images(mut Art art)
{
    if (art.targetPass != 10) return;
    if (!art.bricked)
    {
        art.brickTile = [Vertex { }, Vertex { position = float2(48, 0), uv = float2(2, 0) },
                         Vertex { position = float2(48, 48), uv = float2(2, 2) }, Vertex { position = float2(0, 48), uv = float2(0, 2) }];
        art.brickTile3 = [Vertex3 { position = float3(-12, 12, 0) }, Vertex3 { position = float3(12, 12, 0), uv = float2(2, 0) },
                          Vertex3 { position = float3(12, -12, 0), uv = float2(2, 2) }, Vertex3 { position = float3(-12, -12, 0), uv = float2(0, 2) }];
        art.painted[0, 0] = Color.red;
        art.painted[1, 0] = Color.green;
        art.painted[0, 1] = Color.blue;
        art.painted[1, 1] = Color.white;
        art.keptBricks = bricks; // A value: it names the image, and no declaration
        art.bricked = true;
    }
    Draw.Clear(Color.black);
    Draw.SetScreen();
    Draw.SetClip();
    // By its name: its declaration's filter and wrap
    Draw.Transform(float2(8, 8))
    {
        Draw.Mesh(art.brickTile, art.faces, bricks);
    }
    // One that only says its filter: the cells at the edge
    Draw.Transform(float2(64, 8))
    {
        Draw.Mesh(art.brickTile, art.faces, plainBricks);
    }
    // What the draw says goes over its declaration's
    Draw.Transform(float2(120, 8))
    {
        Draw.Mesh(art.brickTile, art.faces, bricks, Filter.Point, Wrap.Mirror);
    }
    // One of a list, and the value a field holds: the image, as the draw says
    Draw.Transform(float2(176, 8))
    {
        Draw.Mesh(art.brickTile, art.faces, brickFrames[0], Filter.Point);
    }
    Draw.Transform(float2(8, 64))
    {
        Draw.Mesh(art.brickTile, art.faces, art.keptBricks, Filter.Point);
    }
    // In a frag, by its name; and as the Texture a draw gives a frag, whose Sample says nothing
    Draw.Transform(float2(64, 64))
    {
        Draw.Mesh(art.brickTile, art.faces, BricksByName);
    }
    Draw.Transform(float2(120, 64))
    {
        Draw.Mesh(art.brickTile, art.faces, bricks, BrickSource);
    }
    Draw.Transform(float2(176, 64))
    {
        Draw.Mesh(art.brickTile, art.faces, plainBricks, BrickSource);
    }
    // A grid's: an asset's and a field's
    Draw.Transform(float2(8, 120))
    {
        Draw.Mesh(art.brickTile, art.faces, brickCells);
    }
    Draw.Transform(float2(64, 120))
    {
        Draw.Mesh(art.brickTile, art.faces, BrickCellsByName);
    }
    Draw.Transform(float2(120, 120))
    {
        Draw.Mesh(art.brickTile, art.faces, art.painted);
    }
    Draw.Transform(float2(176, 120))
    {
        Draw.Mesh(art.brickTile, art.faces, PaintedByName);
    }
    // In 3D
    Draw.Mesh(art.brickTile3, art.faces, float4x4.Translate(Cell(0, 7)), bricks);
    Draw.Mesh(art.brickTile3, art.faces, float4x4.Translate(Cell(1, 7)), plainBricks);
}

// Several colors from one frag (pass 11). A target made to hold three color
// images, the second and third of floats, is drawn into by frags that write
// three colors, two, and one, and by the engine's own shapes; then each image
// is read back by a frag of its own, which brings what floats hold (numbers
// past 1, and under 0) into what a window shows.
local singleton Several
{
    RenderTarget scene;    // Three color images, 64 pixels by 64 whatever the display: bytes, then floats twice
    RenderTarget bright;   // One, of floats, 16 by 16
    Texture first;         // The scene's images, as frags read them
    Texture second;
    Texture third;
    Texture none;          // One the scene hasn't got
    Texture glow;          // The bright one's
    List<Vertex> top;      // The scene's top three quarters
    List<Vertex> corner;   // Its top left corner, 16 by 16
    List<Vertex> middle;   // A square in its middle, 16 by 16
    List<Vertex> panel;    // 64 by 64 in the window, at the transform it's drawn under
    bool made;
}

// Three colors at once: where the pixel is, a number past 1, and one under 0.
frag Fill(Vertex vertex, out Color albedo, out Color big, out Color signed)
{
    albedo = Color(vertex.uv.x, vertex.uv.y, 0);
    big = Color(4 * vertex.uv.x, 2, 0.5);
    signed = Color(-1, 0.25, vertex.uv.y - 2);
}

// Two, into a target of three: its third is left as it was.
frag Two(Vertex vertex, out Color albedo, out Color big)
{
    albedo = Color.blue;
    big = Color(8, 4, 0.25);
}

// A frag of several outputs leaves a pixel out like any other: none of them is written there.
frag Holes(Vertex vertex, out Color albedo, out Color big, Pixel pixel)
{
    if (vertex.uv.x < 0.5) pixel.Discard();
    albedo = Color.white;
    big = Color(6, 6, 1);
}

frag ShowFirst(Vertex vertex, out Color color, Several several)
{
    color = several.first.Sample(vertex.uv, Filter.Point);
}

// Up to 8, in what a byte holds
frag ShowSecond(Vertex vertex, out Color color, Several several)
{
    Color held = several.second.Sample(vertex.uv, Filter.Point);
    color = Color(held.r / 8, held.g / 8, held.b);
}

// What's under 0, the other way up
frag ShowThird(Vertex vertex, out Color color, Several several)
{
    Color held = several.third.Sample(vertex.uv, Filter.Point);
    color = Color(-held.r, held.g, held.b + 2);
}

frag ShowNone(Vertex vertex, out Color color, Several several)
{
    color = several.none.Sample(vertex.uv, Filter.Point);
}

// Blended between its pixels, as any texture is
frag ShowGlow(Vertex vertex, out Color color, Several several)
{
    Color held = several.glow.Sample(vertex.uv);
    color = Color(held.r / 4, held.g / 4, held.b / 4);
}

[After(Shadows)]
view Outputs(Art art, mut Several several)
{
    if (art.targetPass != 11) return;
    if (!several.made)
    {
        several.made = true;
        several.scene = RenderTarget(64, 64, 1, Format.Color, Format.Float, Format.Float);
        several.bright = RenderTarget(16, 16, 1, Format.Float);
        several.first = several.scene.colors[0];
        several.second = several.scene.colors[1];
        several.third = several.scene.colors[2];
        several.none = several.scene.colors[3];
        several.glow = several.bright.color;
        several.top = [Vertex { position = float2(0, 0) }, Vertex { position = float2(64, 0), uv = float2(1, 0) },
                       Vertex { position = float2(64, 48), uv = float2(1, 1) }, Vertex { position = float2(0, 48), uv = float2(0, 1) }];
        several.corner = [Vertex { position = float2(0, 0) }, Vertex { position = float2(16, 0), uv = float2(1, 0) },
                          Vertex { position = float2(16, 16), uv = float2(1, 1) }, Vertex { position = float2(0, 16), uv = float2(0, 1) }];
        several.middle = [Vertex { position = float2(24, 24) }, Vertex { position = float2(40, 24), uv = float2(1, 0) },
                          Vertex { position = float2(40, 40), uv = float2(1, 1) }, Vertex { position = float2(24, 40), uv = float2(0, 1) }];
        several.panel = [Vertex { position = float2(0, 0) }, Vertex { position = float2(64, 0), uv = float2(1, 0) },
                         Vertex { position = float2(64, 64), uv = float2(1, 1) }, Vertex { position = float2(0, 64), uv = float2(0, 1) }];
    }

    // A clear fills every image. Then three outputs over the top three quarters; two over a corner, which
    // leaves the third there; a frag that discards half of a square; and a shape of the engine's own,
    // which has one color and writes the first image alone
    several.scene.SetScreen();
    several.scene.Clear(Color(0.5, 0.25, 1));
    several.scene.Mesh(several.top, art.faces, Fill);
    several.scene.Mesh(several.corner, art.faces, Two);
    several.scene.Mesh(several.middle, art.faces, Holes);
    several.scene.Rect(float2(56, 8), float2(16), Color.green);

    // Floats add up past 1: three times white over the right half, with the target's own blend
    several.bright.SetScreen();
    several.bright.Clear(Color.black);
    several.bright.Blend(Blend.Add)
    {
        several.bright.Rect(float2(12, 8), float2(8, 16), Color.white);
        several.bright.Rect(float2(12, 8), float2(8, 16), Color.white);
        several.bright.Rect(float2(12, 8), float2(8, 16), Color.white);
    }

    // The window: each image through a frag that reads it, the frag of three outputs drawn straight
    // into it (where its first is the pixel's and the others go nowhere), the bright target, and
    // an image the scene hasn't got, whose draw is passed by
    Draw.SetClip();
    Draw.SetScreen();
    Draw.Clear(Color.black);
    Draw.Mesh(several.panel, art.faces, ShowFirst);
    Draw.Transform(float2(64, 0))
    {
        Draw.Mesh(several.panel, art.faces, ShowSecond);
    }
    Draw.Transform(float2(128, 0))
    {
        Draw.Mesh(several.panel, art.faces, ShowThird);
    }
    Draw.Transform(float2(192, 0))
    {
        Draw.Mesh(several.panel, art.faces, Fill);
    }
    Draw.Transform(float2(0, 64))
    {
        Draw.Mesh(several.panel, art.faces, ShowGlow);
    }
    Draw.Rect(float2(96, 96), float2(64), Color.magenta);
    Draw.Transform(float2(64, 64))
    {
        Draw.Mesh(several.panel, art.faces, ShowNone);
    }
}

// A draw's values (pass 12): a struct after the vert and the frag, the same
// for the whole draw. Blits of one frag with values of their own, meshes
// through a vert and a frag that each read some of theirs, and instances
// whose struct is beside the draw's.
struct Rinse
{
    Color tint = Color.white;
    int steps;        // Each adds a quarter of red
    float4x4 unread;  // Not sent
}

struct Put
{
    float2 by;
    Color tint = Color.white;
    bool dim;
}

struct Speck
{
    float2 offset;
    Color tint;
}

struct Strip
{
    float2 origin;
    float gain = 1;
}

local singleton PerDraw
{
    RenderTarget source; // White, 16 pixels by 16 whatever the display
    RenderTarget first;  // What a blit made of it, with its values
    RenderTarget second; // ...and another, with others, and a third over that
    List<Vertex> square; // 16 by 16 at the origin
    List<Vertex> left;   // 32 by 32, where each target is shown
    List<Vertex> right;
    List<Speck> dots;
    bool made;
}

frag Rinsed(Vertex vertex, out Color color, Texture source, Rinse rinse)
{
    color = source.Sample(vertex.uv, Filter.Point) * rinse.tint;
    for (var i = 0; i < rinse.steps; i++) color.r += 0.25;
}

vert PutAt(mut Vertex vertex, Put put)
{
    vertex.position += put.by;
}

frag PutTint(Vertex vertex, out Color color, Put put)
{
    color = put.tint;
    if (put.dim) color = Color(color.r * 0.5, color.g * 0.5, color.b * 0.5);
}

vert SpeckAt(mut Vertex vertex, Speck speck, Strip strip)
{
    vertex.position += speck.offset + strip.origin;
}

frag SpeckTint(Vertex vertex, out Color color, Speck speck, Strip strip)
{
    color = Color(speck.tint.r * strip.gain, speck.tint.g * strip.gain, speck.tint.b * strip.gain);
}

[After(Outputs)]
view Values(Art art, mut PerDraw given)
{
    if (art.targetPass != 12) return;
    if (!given.made)
    {
        given.made = true;
        given.source = RenderTarget(16, 16, 1);
        given.first = RenderTarget(16, 16, 1);
        given.second = RenderTarget(16, 16, 1);
        given.square = [Vertex { position = float2(0, 0) }, Vertex { position = float2(16, 0), uv = float2(1, 0) },
                        Vertex { position = float2(16, 16), uv = float2(1, 1) }, Vertex { position = float2(0, 16), uv = float2(0, 1) }];
        given.left = [Vertex { position = float2(0, 0) }, Vertex { position = float2(32, 0), uv = float2(1, 0) },
                      Vertex { position = float2(32, 32), uv = float2(1, 1) }, Vertex { position = float2(0, 32), uv = float2(0, 1) }];
        given.right = [Vertex { position = float2(32, 0) }, Vertex { position = float2(64, 0), uv = float2(1, 0) },
                       Vertex { position = float2(64, 32), uv = float2(1, 1) }, Vertex { position = float2(32, 32), uv = float2(0, 1) }];
        given.dots = [Speck { tint = Color.red }, Speck { offset = float2(32, 0), tint = Color.blue }];
    }
    given.source.Clear(Color.white);
    given.first.Clear(Color.black);
    given.second.Clear(Color.black);

    // One frag, three blits, each with its own values: none of them is the others'
    Draw.Blit(given.source.color, given.first, Rinsed, Rinse { tint = Color(1, 0.5, 0.25) });
    Draw.Blit(given.source.color, given.second, Rinsed, Rinse { tint = Color(0.25, 0.5, 0.5), steps = 2 });
    Draw.Blit(given.source.color, given.second, Blend.Add, Rinsed, Rinse { tint = Color(0, 0, 0.25) });

    Draw.SetClip();
    Draw.SetScreen();
    Draw.Clear(Color.black);
    Draw.Mesh(given.left, art.faces, given.first.color, Filter.Point);
    Draw.Mesh(given.right, art.faces, given.second.color, Filter.Point);

    // Meshes: the vert reads where, the frag which color, of the same values. Two values in a row are two
    // draws; the same values twice are one, of two instances, which add up here
    Draw.Mesh(given.square, art.faces, PutAt, PutTint, Put { by = float2(0, 64), tint = Color.red });
    Draw.Mesh(given.square, art.faces, PutAt, PutTint, Put { by = float2(32, 64), tint = Color.green, dim = true });
    var gray = Put { by = float2(64, 64), tint = Color(0.25, 0.25, 0.25) };
    Draw.Blend(Blend.Add)
    {
        Draw.Mesh(given.square, art.faces, PutAt, PutTint, gray);
        Draw.Mesh(given.square, art.faces, PutAt, PutTint, gray);
    }

    // Instances: each one's own struct, and the draw's for all of them
    Draw.Instanced(given.square, art.faces, given.dots, SpeckAt, SpeckTint, Strip { origin = float2(0, 128), gain = 0.5 });
    Draw.Instanced(given.square, art.faces, given.dots, SpeckAt, SpeckTint, Strip { origin = float2(0, 160) });
}

// shaders.c requests independent full-window checks after the existing grid.
// Resource descriptors are supplied by C, without choosing a Tide lifetime API.
[After(Manual)]
view Targets(mut Art art)
{
    // 6 is ScreenTargets', 7 Wraps', 8 Shadows', 9 Masks', 10 Images', 11 Outputs' and 12 Values'
    if (art.targetPass == 0 || art.targetPass >= 6) return;
    if (art.targetPass >= 4)
    {
        Draw.SetScreen();
        if (art.targetPass == 4)
            Draw.Mesh(art.targetQuad, art.faces, art.uploaded, Filter.Point, TextureChecks);
        else
            Draw.Mesh(art.targetQuad, art.faces, art.uploaded, Filter.Point);
        return;
    }

    art.sourceTarget.SetScreen();
    art.sourceTarget.Clear(Color.black);
    art.sourceTarget.Rect(float2(8, 8), float2(16), Color.red);
    art.sourceTarget.Rect(float2(24, 8), float2(16), Color.green);
    art.sourceTarget.Rect(float2(8, 24), float2(16), Color.blue);
    art.sourceTarget.Rect(float2(24, 24), float2(16), Color.white);

    art.outputTarget.Clear(Color.magenta);
    art.outputTarget.SetCamera(float2(10000), 0.01);
    art.outputTarget.SetClip(Rect(0, 0, 0, 0));
    Draw.SetCamera(float2(10000), 0.01);
    Draw.SetClip(Rect(0, 0, 0, 0));

    if (art.targetPass == 1)
    {
        Draw.Blit(art.sourceTarget.color, art.outputTarget, TargetAlpha);
        art.targetTexture = art.sourceTarget.color;
    }
    else if (art.targetPass == 2)
    {
        Draw.Blit(art.four, art.outputTarget, TargetCopy);
        Draw.Blit(art.outputTarget.color, Draw.window, TargetCopy);
        return;
    }
    else
    {
        Draw.Blit(art.uploaded, art.outputTarget, TargetAlpha);
        art.targetTexture = art.uploaded;
    }
    Draw.Blit(art.outputTarget.color, Draw.window, TargetInspect);
}
