// expect: view 'Show' doesn't guarantee its entity has a 'Box', which frag 'Shade' reads
// A frag's components are those of the entity the view runs for
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

frag Shade(V vertex, out Color color, Box box)
{
    color = box.tint;
}

view Show(Models models)
{
    Draw3D.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
