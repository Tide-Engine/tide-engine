// expect: an indexed element is a copy, so what it holds can't be changed in place
// expect: take it out, change it, and put it back: 'mut var e = items[i]; e.parts.Add(x); items[i] = e;'
struct Bag { List<int> parts; }
component Shelf { List<Bag> bags; }
scene Main { }
system Fill(mut Shelf shelf)
{
    shelf.bags[0].parts.Add(1);
}
