// expect: the values a draw gives its vert and frag come after their names: 'Draw.Mesh(..., Shade, Glow { ... })'
scene Main { }
struct Corner { float3 position; float2 uv; }
struct Glow { Color tint; float gain; }
struct Lift { float3 by; }
local singleton Models
{
    List<Corner> crate;
    List<int> faces;
    List<Glow> glows;
    RenderTarget bright;
    RenderTarget spread;
}
frag Shade(Corner corner, out Color color, Glow glow)
{
    color = glow.tint;
}
view Show(Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Glow { gain = 2 }, Shade);
}
