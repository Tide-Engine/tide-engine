// expect: the match is the same on every machine, so a match handler has nothing 'verified' to read
component Health { int value; }
event Hit { int damage; }
scene Main { }

event(Spawned) Setup(with Main) { Spawn(Health).Send(Hit); }

event(Hit hit) TakeHit(mut Health health, with verified Health)
{
    health.value -= hit.damage;
}
