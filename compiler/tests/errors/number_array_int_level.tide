// expect: an int array reads its nearest pixel: a GPU blends no integers, so it has no smaller images. Use Sample(uv, layer)
scene Main { }
local singleton Images { [Raw(int)] TextureArray layers; }
frag Read(Vertex vertex,out Color color,Images images) { color=Color(float(images.layers.SampleLevel(vertex.uv,0,2.0)),0,0); }
view Show(mut Images images) { images.layers=TextureArray(8,8,2,Format.R32i); List<Vertex> quad=[Vertex {position=float2(0)},Vertex {position=float2(1,0)},Vertex {position=float2(0,1)}]; Draw.Mesh(quad,[0,1,2],Read); }