// expect: Entity can't go to the GPU: it's a handle into the world, which the GPU doesn't have
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
    Entity target;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

frag Shade(V vertex, mut Color color, Box box)
{
    var target = box.target;
    color = box.tint;
}

view Show(Box box, Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
