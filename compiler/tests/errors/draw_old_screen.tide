// expect: Draw.Screen is 'Draw.Pixels' now
// expect: it draws in the screen's pixels, from the top left with y down: 'Draw.Pixels() { ... }' around some draws, or 'Draw.SetPixels();' for the draws that follow
scene Main { }

view Show()
{
    Draw.Screen()
    {
        Draw.Rect(float2(0, 0), float2(4, 4), Color.white);
    }
}
