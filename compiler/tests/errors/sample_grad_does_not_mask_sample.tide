// expect: a Sample in a function can't be Filter.Trilinear: only a frag's own Sample reads between a texture's smaller images
scene Main { }
local singleton Art { Texture image; List<Vertex> corners; }
Color Gradient(Texture source, float2 uv)
{
    return source.SampleGrad(uv, float2(0.1), float2(0.1), .Trilinear) + source.Sample(uv, .Trilinear);
}
frag Shade(Vertex vertex, out Color color, Texture source) { color = Gradient(source, vertex.uv); }
view Show(Art art) { Draw.Mesh(art.corners, [0, 1, 2], art.image, Shade); }
