// expect: Read<float> gives a Grid2<float> of the image's own numbers, and this target's format for image 0 isn't fixed by its constructor assignments
scene Main {}
local singleton State { RenderTarget target; bool wide; }
view Make(mut State state)
{
    if (state.wide) state.target = RenderTarget(8, 8, Format.R32f);
    else state.target = RenderTarget(8, 8, Format.Rg16f);
}
async void Read(State state) { var pixels = await state.target.Read<float>(); }
