// expect: 'title' is text of the match's, which a local handler doesn't hear yet
component Name { string title; }
event Hit { int damage; }
local singleton Log { string last; }
scene Main { }

event(Spawned) Setup(with Main) { Spawn(Name { title = "Ada" }).Send(Hit); }

local event(Hit hit) Flash(Name name, mut Log log)
{
    log.last = name.title;
}
