// expect: 'Kept' adds to a GPU list, so a call of it is a statement of its own
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<Blade> shown;
}
void Keep(GPUList<Blade> into, Blade b)
{
    into.Add(b);
}
int Kept(GPUList<Blade> into, Blade b)
{
    into.Add(b);
    return 1;
}
[Group(64)]
compute Thin(Meadow meadow)
{
    int k = Kept(meadow.shown, meadow.blades[this.index]);
    meadow.blades[0] = Blade { root = float3(0, 0, 0), height = float(k) };
}
view Show(Meadow meadow) { GPU.Run(Thin, meadow.blades); }
