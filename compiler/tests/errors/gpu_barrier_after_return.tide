// expect: and a 'return' before it ends some of them
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
compute Wait(Meadow meadow)
{
    if (this.index >= 10) return;
    GPU.Barrier();
    meadow.counts[0] = 1;
}
view Show(Meadow meadow) { GPU.Run(Wait, 64); }
