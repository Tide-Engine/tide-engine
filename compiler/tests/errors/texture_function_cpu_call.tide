// expect: 'Tile' samples a texture, which only code the GPU runs does: a frag, a vert and the functions they call
// expect: it does on line 5, itself or through what it calls there: a texture's pixels stay on the GPU, where a frag or a vert that calls 'Tile' reads them
scene Main { }
local singleton Look { Texture atlas; }
Color Tile(Texture atlas, float2 uv) { return atlas.Sample(uv); }
view Show(Look look) { Draw.Clear(Tile(look.atlas, float2(0))); }
