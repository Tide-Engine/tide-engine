// expect: 'masks' is [Raw], its pixels numbers and not colors to draw: it's no Texture to draw with or hand on
[Raw] asset Texture masks = "../e2e/assets/hero.png";

frag Copy(Vertex vertex, out Color color, Texture source)
{
    color = source.Sample(vertex.uv);
}

view Show()
{
    Draw.Mesh([Vertex { }, Vertex { position = float2(1, 0) }, Vertex { position = float2(0, 1) }], [0, 1, 2], masks, Copy);
}

scene Main
{
}
