// expect: an operator works a value out of its operands, so it can't call 'Notify', which sends 'Ping'
// expect: it does on line 4
event Ping { int n; }
void Notify(int n) { Send(Ping { n = n }); }
struct Money
{
    int cents;
    Money operator +(Money a, Money b)
    {
        Notify(a.cents);
        return Money { cents = a.cents + b.cents };
    }
}
scene Main { }
event(Ping ping) Heard() { }
