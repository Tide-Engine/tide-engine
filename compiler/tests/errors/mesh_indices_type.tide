// expect: a mesh's indices are a List<int>, three for each triangle, and this is List<float>
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

local singleton Shapes
{
    List<float> faces;
}

view Show(Shapes shapes, Models models)
{
    Draw.Mesh(models.crate, shapes.faces, float4x4.identity);
}
