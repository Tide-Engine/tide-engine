// expect: frag 'Tint' reads a 'BatchItem', and this draw names no vert that writes one
scene Main { }
struct BatchItem { Color tint; }
struct WrongItem { Color tint; }
local singleton Mesh
{
    List<Vertex3> vertices;
    List<int> indices;
    List<WrongItem> instances;
}
frag Tint(Vertex3 vertex, out Color color, BatchItem item)
{
    color = item.tint;
}
view DrawBatch(Mesh mesh)
{
    Draw.Instanced(mesh.vertices, mesh.indices, mesh.instances, Tint);
}
