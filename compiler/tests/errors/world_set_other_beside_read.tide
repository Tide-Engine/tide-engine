// expect: Set<Health> changes any entity's Health, and the system takes this entity's too
// expect: this entity's can be set beside 'own', which is only read: 'world.Set<Health>(this, value)'. For another entity's, send it an event
component Health { int value; Entity other; }
scene Main { }
system Drain(Health own, mut World world)
{
    mut var theirs = world.Get<Health>(own.other);
    theirs.value -= 1;
    world.Set<Health>(own.other, theirs);
}
