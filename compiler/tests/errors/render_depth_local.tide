// expect: a frag reads a DepthTexture that's a field of a component or singleton it takes, like 'lamp.shadow.Sample(uv)'
// expect: a view puts a target's depth there: 'lamp.shadow = lamp.map.depth;'
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
frag Lit(Vertex vertex, mut Color color, Lamp lamp)
{
    DepthTexture shadow = lamp.shadow;
    float far = shadow.Sample(vertex.uv);
    color = Color(far, far, far);
}
