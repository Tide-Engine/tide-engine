// expect: a local handler's query has the match as its event's tick left it, so it has nothing 'verified' to read yet
component Body { float x; }
event Hit { int damage; }
scene Main { }
event(Spawned) Setup(with Main) { Spawn(Body).Send(Hit { damage = 1 }); }
local event(Hit hit) Show(query (verified Body body) bodies)
{
    foreach (var row in bodies) Debug.Log($"{row.body.x + hit.damage}");
}
