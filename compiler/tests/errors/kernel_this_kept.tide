// expect: a kernel's invocation is read through 'this.index'
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
compute Inner(Meadow meadow)
{
    var me = this;
    meadow.counts[0] = 1;
}
view Show(Meadow meadow) { GPU.Run(Inner, 4); }
