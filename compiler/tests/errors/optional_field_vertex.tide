// expect: 'BoxVertex' can't be a mesh's vertex: its 'shade' is float?
struct Tone { float gain = 1; float? boost; }
struct BoxVertex { float3 position; float3 normal; float? shade; }
singleton Sun { float3 direction; float? glow; Tone tone; }
component Box { Color tint; int? kind; }
local singleton Models { List<BoxVertex> crate; List<int> faces; }
frag Shade(BoxVertex vertex, out Color color, Box box, Sun sun)
{
    color = box.tint * sun.direction.x;
}
view Boxes(with Box, Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
scene Main { }
