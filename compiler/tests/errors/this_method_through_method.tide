// expect: 'health' needs an attached component: this value is a detached copy
component Health
{
    int value;

    bool IsMine(Entity e) { return e == this; }

    // Uses this through IsMine.
    bool Report(Entity e) { return IsMine(e) && value > 0; }
}
scene Main { }
bool Check(Health health, Entity e)
{
    return health.Report(e);
}
system Run() { _ = Check(Health {}, default); }
