// expect: frag 'Shade' runs on a Other, and this mesh's vertices are a List<V>
// A frag runs on the vertex of the meshes it's drawn with
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

struct Other
{
    float3 position;
}

frag Shade(Other vertex, mut Color color)
{
    color = Color.white;
}

view Show(Box box, Models models)
{
    Draw3D.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
