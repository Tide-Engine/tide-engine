// expect: 'store' is read-only
// expect: a view can't change the match: put what it wants in the input, and change it in a system
extern int Fill(out List<byte> bytes);
singleton Store { List<byte> image; }
local singleton Shown { int size; }
scene Main { }
view Show(Store store, mut Shown shown) { shown.size = Fill(store.image); }
