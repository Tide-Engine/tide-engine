// expect: this Sample reads its texture as it says, and 'look.far' says Filter.Trilinear, which only a frag's own Sample reads
// expect: frag 'Shade' samples it through 'Tile', here
// A grid of the singleton a function is handed says Trilinear where it's declared, and the function's Sample leaves it to it
scene Main { }
local singleton Look
{
    [Filter(Filter.Trilinear)]
    Grid2<Color> far = Grid2(4, 4);
    List<Vertex3> mesh;
}
Color Tile(Look look, float2 uv) { return look.far.Sample(uv); }
frag Shade(Vertex3 vertex, out Color color, Look look) { color = Tile(look, vertex.uv); }
view Show(Look look) { Draw.Mesh(look.mesh, [0, 1, 2], float4x4.identity, Shade); }
