// expect: a function samples a DepthTexture it takes as a parameter of its own
// expect: the frag or vert that calls it passes the one to read, a field of a component or singleton it takes: 'float Lit(DepthTexture shadow, ...)', called as 'Lit(lamp.shadow, ...)'
// A function reads the depth it's passed, not one it finds in a singleton it takes
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
float Lit(Lamp lamp, float2 uv) { return lamp.shadow.Compare(uv, 0.5); }
