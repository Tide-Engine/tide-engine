// expect: Draw2D can only be used in views, and in functions they call
component Body { float2 position; }
event Hit { int damage; }
scene Main { }

event(Spawned) Setup(with Main) { Spawn(Body).Send(Hit); }

local event(Hit hit) Flash(Body body)
{
    Draw2D.Circle(body.position, 1, Color.white);
}
