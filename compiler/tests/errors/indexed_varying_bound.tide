// expect: this loop can't be indexed: its bound reads 'reach', which the loop changes
component Body { float3 position; }
event Hit { float amount; }
scene Main { }
system Hits(Body body, query (Body other) others)
{
    mut var reach = 1.0;
    indexed foreach (var o in others)
    {
        if (Math.Distance(o.other.position, body.position) > reach) continue;
        reach += 1.0;
    }
}
