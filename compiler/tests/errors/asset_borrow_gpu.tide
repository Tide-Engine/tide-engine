// expect: 'Indirect' uses resource collections, which CPU helpers read
asset List<Mesh<Vertex3>> images = "../e2e/assets/meshes/*.glb";
int Count(List<Mesh<Vertex3>> values) { return values.count; }
int Indirect() { return Count(images); }
frag Shade(Vertex vertex, out Color color) { color = Color(Indirect(), vertex.uv.x, 0, 1); }
scene Main { }
