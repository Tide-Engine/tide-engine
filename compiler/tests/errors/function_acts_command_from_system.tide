// expect: 'Ask' sends the command 'Rename', and commands are sent from views and local handlers to the match
command Rename { int n; }
component Enemy { int hp; }
scene Main { }
void Ask(int n) { Send(Rename { n = n }); }
event(Spawned) Setup(with Main) { Spawn(Enemy); }
command(Rename rename, PlayerID sender) Take() { }
view Show(Enemy enemy) { Ask(enemy.hp); }
system Fight(Enemy enemy) { Ask(enemy.hp); }
