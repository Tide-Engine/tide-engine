// expect: a map's local in code the GPU runs names one map, for good: 'hues' can't be 'mut'
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Map<int, Color> hues;
}

frag Shade(V vertex, out Color color, Models models)
{
    mut var hues = models.hues;
    color = hues[1];
}

view Show(Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
