// expect: Cubemap takes its faces' side in pixels, and what each holds when that isn't Format.Rgba8: 'Cubemap(256)' or 'Cubemap(256, Format.Rgba16f)'
// expect: a cube's six faces are squares of one size and one format, each with depth of its own
// Cubemap takes a size, then a format
scene Main { }
local singleton Room { Cubemap reflection; RenderTarget side; List<Vertex3> ball; }
view Show(mut Room room) { room.reflection = Cubemap(64, 64); }
