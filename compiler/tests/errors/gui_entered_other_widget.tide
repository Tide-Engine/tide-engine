// expect: 'GUILayout.Float2Field' has no version that says when it was entered, so it takes no 'out' argument
// expect: remove the argument: the widgets with such a version are TextField, IntField and FloatField, like 'GUILayout.TextField(label, value, out var entered)'
scene Main { }
local singleton Lobby { string code; int count; float ratio; bool entered; }
local singleton Place { float2 at; }
view Join(mut Lobby lobby, mut Place place)
{
    GUILayout.Float2Field("Place", place.at, out var entered);
    if (entered) lobby.count += 1;
}
