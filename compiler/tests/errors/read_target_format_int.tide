// expect: Read<int> gives a Grid2<int>, but this target's image 0 is Format.Rgba16f, which holds Color or float4: write 'await target.Read()'
scene Main {}
local singleton State { RenderTarget target; }
view Make(mut State state) { state.target = RenderTarget(8, 8, Format.Rgba16f); }
async void Read(State state) { var pixels = await state.target.Read<int>(); }
