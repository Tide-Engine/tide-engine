// expect: Draw.SetDepth sets it for the draws that follow, and takes no block
// expect: to set it around some draws, and have it put back after them, write 'Draw.Depth(...) { ... }'
scene Main { }

view Show()
{
    Draw.SetDepth(Depth.Read)
    {
        Draw3D.Cube(float3(0, 0, 5), float3(1, 1, 1), Color.white);
    }
}
