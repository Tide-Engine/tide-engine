// expect: a blit's textures go before its destination, and this is a RenderTarget, not a Texture
// expect: a target's color image is its Texture, 'target.color', and its others 'target.colors[1]'
// A target given where a blit's second texture goes: its color image is the texture
scene Main { }
local singleton Image { Texture source; RenderTarget lut; }
frag Grade(Vertex vertex, out Color color, Texture source, Texture lut) { color = source.Sample(vertex.uv) * lut.Sample(vertex.uv); }
view Show(Image image) { Draw.Blit(image.source, image.lut, Draw.window, Grade); }
