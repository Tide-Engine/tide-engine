// expect: Set sends a List<Blade>, the list's elements, not List<int>
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
view Show(Meadow meadow)
{
    List<int> numbers = [1, 2];
    meadow.blades.Set(numbers);
}
