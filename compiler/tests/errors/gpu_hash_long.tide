// expect: Math.Hash of a long isn't on the GPU, whose ints are 32 bits
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

// All of Math is on the GPU but this: it has no 64-bit integers to hash.
frag Shade(V vertex, out Color color)
{
    color = Color.white * (Math.Hash(5L) % 2);
}

view Show(Box box, Models models)
{
    Draw3D.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
