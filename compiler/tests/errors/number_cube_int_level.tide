// expect: an int cube reads its nearest pixel: a GPU blends no integers, so it has no smaller images. Use Sample(direction)
scene Main { }
local singleton Room { [Raw(int)] Cubemap ids; }
frag Read(Vertex vertex,out Color color,Room room) { color=Color(float(room.ids.SampleLevel(float3(vertex.uv,1),2)),0,0); }
view Show(mut Room room) { room.ids=Cubemap(8,Format.R32i); List<Vertex> quad=[Vertex {position=float2(0)},Vertex {position=float2(1,0)},Vertex {position=float2(0,1)}]; Draw.Mesh(quad,[0,1,2],Read); }