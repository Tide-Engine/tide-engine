// expect: Draw.Mesh doesn't take a 'Glow' here: a draw's values are read by the vert or the frag it names before them, and this names neither
// expect: like 'Draw.Mesh(..., Shade, Glow { ... })', for a frag that takes a 'Glow' parameter
scene Main { }
struct Corner { float3 position; float2 uv; }
struct Glow { Color tint; float gain; }
struct Lift { float3 by; }
local singleton Models
{
    List<Corner> crate;
    List<int> faces;
    List<Glow> glows;
    RenderTarget bright;
    RenderTarget spread;
}
view Show(Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Glow { gain = 2 });
}
