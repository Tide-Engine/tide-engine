// expect: '++' can't be part of an expression in a parallel loop's step
// expect: write it as a statement of its own: 'i += 1;'
scene Main { }

singleton Table
{
    List<int> values;
}

system Step(mut Table table)
{
    parallel (var i in table.values)
    {
        mut var n = table.values[i];
        table.values[i] = n++ + n;
    }
}
