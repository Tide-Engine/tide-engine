// expect: RenderTarget has no 'Sphere'; it has Window and Cube
// expect: 'RenderTarget.Window()' is a target that's always the window's size, 'RenderTarget(width, height)' one of a size of its own, and 'RenderTarget.Cube(size)' a Cubemap whose six faces are drawn into
// RenderTarget has Window and Cube
scene Main { }
local singleton Room { Cubemap reflection; RenderTarget side; List<Vertex3> ball; }
view Show(mut Room room) { room.reflection = RenderTarget.Sphere(64); }
