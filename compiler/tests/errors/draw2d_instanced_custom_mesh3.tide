// expect: Draw2D.Instanced draws 2D vertices, and 'Corner' has a float3 position
struct Corner { float3 position; }
struct Item { Color color; }
frag Shade(Corner vertex, out Color color, Item item) { color = item.color * vertex.position.x; }
scene Main { }
view Show() { Draw2D.Instanced([Corner { }], [0, 0, 0], [Item { }], Shade); }
