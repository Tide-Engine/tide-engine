// expect: a texture is read at a vertex's 'float2 uv', which Bare doesn't have
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

struct Bare
{
    float3 position;
}

local singleton Shapes
{
    List<Bare> corners;
}

view Show(Shapes shapes, Models models)
{
    Draw.Mesh(shapes.corners, [0, 1, 2], float4x4.identity, models.wood);
}
