// expect: frag output 1 is int, but Format.Rgba8 takes Color: change the output type or this image's format
scene Main { }
local singleton Images { RenderTarget target; }
void Make(mut RenderTarget t) { t = RenderTarget(8, 8, 1); }
frag Ids(Vertex vertex, out int id) { id = 3; }
view V(mut Images images)
{
    Make(images.target);
    List<Vertex> quad = [Vertex { position = float2(0) }, Vertex { position = float2(1, 0) }, Vertex { position = float2(0, 1) }];
    images.target.Mesh(quad, [0, 1, 2], Ids);
}
