// expect: mesh geometry is read in CPU code
struct Corner
{
    float3 position;
    float3 normal;
}

asset Mesh<Corner> quad = "../e2e/assets/meshes/quad.glb";

frag Paint(Corner corner, out Color color)
{
    color = Color.white * quad.vertices.count;
}

view Show()
{
    Draw.Mesh(quad, float4x4.identity, Paint);
}

scene Main
{
}
