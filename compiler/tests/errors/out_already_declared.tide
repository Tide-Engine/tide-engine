// expect: 'half' is already declared
// expect: 'out half' assigns the variable there is; a new one takes another name
scene Main { }
singleton Tally { int total; }
bool TryHalf(int value, out int half)
{
    half = value / 2;
    return value % 2 == 0;
}
system Run(mut Tally tally)
{
    mut var half = 0;
    TryHalf(8, out var half);
    tally.total = half;
}
