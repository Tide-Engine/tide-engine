// expect: this frag's Texture is [Raw], and the image this draw gives it isn't
asset Texture colors = "../e2e/assets/hero.png";
frag Copy(Vertex vertex, out Color color, [Raw] Texture source) { color = source.Sample(vertex.uv); }
view V() { Draw.Mesh([Vertex { }, Vertex { position = float2(1, 0) }, Vertex { position = float2(0, 1) }], [0, 1, 2], colors, Copy); }
scene Main { }