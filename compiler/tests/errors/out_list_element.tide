// expect: an indexed element can't be an 'out' argument to 'TryHalf'
// expect: receive the result in 'out var value', then assign value to the indexed destination after the call
scene Main { }
struct Cell { int half; }
singleton Tally { List<Cell> cells; }
bool TryHalf(int value, out int half)
{
    half = value / 2;
    return value % 2 == 0;
}
system Run(mut Tally tally) { TryHalf(8, out tally.cells[0].half); }
