// expect: '++' is in a part of its expression that only runs sometimes, which code the GPU runs can't keep it to
// expect: write it as an 'if' with the '++' inside
scene Main { }

local singleton Models
{
    List<Vertex> corners;
}

frag Shade(Vertex vertex, out Color color)
{
    mut var i = 0;
    float shade = vertex.uv.x > 0.5 ? ++i * 0.5 : 1.0;
    color = Color(shade, shade, shade);
}

view Show(Models models)
{
    Draw.Mesh(models.corners, [0, 1, 2], Shade);
}
