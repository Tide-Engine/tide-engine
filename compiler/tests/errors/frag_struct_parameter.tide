// expect: frag 'Shade' reads a 'V', and this draw names no vert that writes one
// expect: a frag's struct is what the draw's vert writes for it, 'out V other' among the vert's parameters, or an element of the list an Instanced draw is given, a List<V>
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

frag Shade(V vertex, out Color color, V other)
{
    color = Color.white;
}

view Boxes(Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
