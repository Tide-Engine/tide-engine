// expect: 'Combat.Armor(float)' isn't marked 'virtual', so nothing replaces it
namespace Combat;

component Position { float value; }
component Velocity { float value; }
component Player { }

struct Stats
{
    float health = 100;

    virtual bool IsDead() { return health <= 0; }
    bool IsHurt() { return health < 100; }
}

component Unit { Stats stats; }

event Hit { int damage; }
event Heal { int amount; }

virtual float Damage(float base, float multiplier = 1)
{
    return base * multiplier;
}

float Armor(float base)
{
    return base / 2;
}

virtual system Move(mut Position position, Velocity velocity)
{
    position.value += velocity.value;
}

system Fall(mut Velocity velocity)
{
    velocity.value -= 1;
}

virtual view Show(Position position)
{
    Draw.Circle(float2(position.value, 0), 1, Color.white);
}

virtual event(Hit hit) TakeHit(mut Unit unit)
{
    unit.stats.health -= hit.damage * Damage(1) + Armor(0);
}

system Strike(Unit unit)
{
    if (unit.stats.IsDead() || unit.stats.IsHurt()) this.Send(Hit { damage = 1 });
}

event(Spawned) Setup(with Main)
{
    Spawn(Position, Velocity);
    Spawn(Unit).Send(Heal { amount = 1 });
}

event(Heal heal) TakeHeal(mut Unit unit)
{
    unit.stats.health += heal.amount;
}

scene Main { }
