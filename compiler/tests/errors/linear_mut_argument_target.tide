// expect: this [Linear] source's format is not fixed by its constructor assignments
scene Main { }
local singleton Art { RenderTarget rt; [Linear] Texture lit; }
void Make(mut RenderTarget t) { t = RenderTarget(64, 64, Format.Rgba16f); }
view V(mut Art s) { s.rt = RenderTarget(64, 64); Make(s.rt); s.lit = s.rt.color; }
