// expect: 'lamp' is read-only
// expect: a frag reads what it's given: it writes its pixel's color, 'out Color color'
scene Main { }
struct Corner { float3 position; float3 normal; float2 uv; }
struct FromLamp { float3 place; float glow; }
singleton Sun { float3 at = float3(0, 4, 0); }
local singleton Models { List<Corner> crate; List<int> faces; }
frag Look(Corner corner, FromLamp lamp, out Color color)
{
    lamp.glow = 1;
    color = Color.white * lamp.glow;
}
