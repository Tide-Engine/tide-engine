local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

frag Shade(V vertex, mut Color color, Sun sun)
{
    mut float4 at = float4(1);
    at = Math.Mul(sun.bone0, at);
    at = Math.Mul(sun.bone1, at);
    at = Math.Mul(sun.bone2, at);
    at = Math.Mul(sun.bone3, at);
    at = Math.Mul(sun.bone4, at);
    at = Math.Mul(sun.bone5, at);
    at = Math.Mul(sun.bone6, at);
    at = Math.Mul(sun.bone7, at);
    at = Math.Mul(sun.bone8, at);
    at = Math.Mul(sun.bone9, at);
    at = Math.Mul(sun.bone10, at);
    at = Math.Mul(sun.bone11, at);
    at = Math.Mul(sun.bone12, at);
    at = Math.Mul(sun.bone13, at);
    at = Math.Mul(sun.bone14, at);
    at = Math.Mul(sun.bone15, at);
    at = Math.Mul(sun.bone16, at);
    at = Math.Mul(sun.bone17, at);
    at = Math.Mul(sun.bone18, at);
    at = Math.Mul(sun.bone19, at);
    at = Math.Mul(sun.bone20, at);
    at = Math.Mul(sun.bone21, at);
    at = Math.Mul(sun.bone22, at);
    at = Math.Mul(sun.bone23, at);
    at = Math.Mul(sun.bone24, at);
    at = Math.Mul(sun.bone25, at);
    at = Math.Mul(sun.bone26, at);
    at = Math.Mul(sun.bone27, at);
    at = Math.Mul(sun.bone28, at);
    at = Math.Mul(sun.bone29, at);
    at = Math.Mul(sun.bone30, at);
    at = Math.Mul(sun.bone31, at);
    at = Math.Mul(sun.bone32, at);
    at = Math.Mul(sun.bone33, at);
    at = Math.Mul(sun.bone34, at);
    at = Math.Mul(sun.bone35, at);
    at = Math.Mul(sun.bone36, at);
    at = Math.Mul(sun.bone37, at);
    at = Math.Mul(sun.bone38, at);
    at = Math.Mul(sun.bone39, at);
    at = Math.Mul(sun.bone40, at);
    at = Math.Mul(sun.bone41, at);
    at = Math.Mul(sun.bone42, at);
    at = Math.Mul(sun.bone43, at);
    at = Math.Mul(sun.bone44, at);
    at = Math.Mul(sun.bone45, at);
    at = Math.Mul(sun.bone46, at);
    at = Math.Mul(sun.bone47, at);
    at = Math.Mul(sun.bone48, at);
    at = Math.Mul(sun.bone49, at);
    at = Math.Mul(sun.bone50, at);
    at = Math.Mul(sun.bone51, at);
    at = Math.Mul(sun.bone52, at);
    at = Math.Mul(sun.bone53, at);
    at = Math.Mul(sun.bone54, at);
    at = Math.Mul(sun.bone55, at);
    at = Math.Mul(sun.bone56, at);
    at = Math.Mul(sun.bone57, at);
    at = Math.Mul(sun.bone58, at);
    at = Math.Mul(sun.bone59, at);
    at = Math.Mul(sun.bone60, at);
    at = Math.Mul(sun.bone61, at);
    at = Math.Mul(sun.bone62, at);
    color = Color.white * at.x;
}

view Show(Box box, Models models)
{
    Draw3D.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
