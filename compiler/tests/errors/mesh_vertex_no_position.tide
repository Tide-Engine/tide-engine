// expect: 'Normal' can't be a mesh's vertex: it has no 'position'
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

struct Normal
{
    float3 normal;
}

local singleton Shapes
{
    List<Normal> corners;
}

view Show(Shapes shapes)
{
    Draw2D.Mesh(shapes.corners, [0, 1, 2]);
}
