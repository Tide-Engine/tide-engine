// expect: image 'cube' is read as float2, but Format.R16f takes float: declare its numeric role with [Raw(float)]
scene Main { }
local singleton Images { [Raw(float2)] Cubemap cube; }
frag Read(Vertex vertex,out Color color,Images images) { color=Color(images.cube.Sample(float3(vertex.uv,1)).x,0,0); }
view Show(mut Images images) { images.cube=Cubemap(8,Format.R16f); List<Vertex> quad=[Vertex {position=float2(0)},Vertex {position=float2(1,0)},Vertex {position=float2(0,1)}]; Draw.Mesh(quad,[0,1,2],Read); }
