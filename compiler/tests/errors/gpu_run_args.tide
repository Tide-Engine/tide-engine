// expect: GPU.Run takes the kernel, what it runs over, and maybe its values
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
compute Inner(Meadow meadow) { meadow.counts[0] = 1; }
view Show(Meadow meadow) { GPU.Run(Inner); }
