// expect: 'Keep' can add to 'counts' twice: an invocation adds to a GPU list once at the most, on any path
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
compute Keep(Meadow meadow)
{
    if (this.index > 2) meadow.counts.Add(1);
    meadow.counts.Add(2);
}
view Show(Meadow meadow) { GPU.Run(Keep, 4); }
