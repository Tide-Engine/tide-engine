// expect: GPU.Run can only be used in views, and in functions they call
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
compute Inner(Meadow meadow) { meadow.counts[0] = 1; }
system Tick()
{
    GPU.Run(Inner, 1);
}
