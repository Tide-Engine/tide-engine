// expect: a frag reads a DepthCubemap that's a field of a component or singleton it takes, not a parameter of its own
scene Main { }
local singleton Lamp { Cubemap cube; DepthCubemap shadows; }
frag Lit(Vertex vertex,out Color color,DepthCubemap shadows) { color=Color(shadows.Sample(float3(vertex.uv,1)),0,0); }
view Show(mut Lamp lamp) { lamp.cube=Cubemap(64,Format.Depth); lamp.shadows=lamp.cube.depth; }
