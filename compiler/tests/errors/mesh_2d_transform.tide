// expect: a 2D mesh is drawn where its vertices are, through the 2D camera: it takes no transform
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

struct Flat
{
    float2 position;
}

local singleton Shapes
{
    List<Flat> corners;
}

view Show(Shapes shapes)
{
    Draw.Mesh(shapes.corners, [0, 1, 2], float4x4.identity);
}
