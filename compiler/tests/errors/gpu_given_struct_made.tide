// expect: a Poses that holds a list goes to code the GPU runs by its name, as the frag or vert was given it
// expect: pass the frag's or vert's own parameter, its singleton, its component or the draw's values, or a function's parameter that stands for one
scene Main { }

struct Boned
{
    float3 position;
    int4 joints;
}

struct Poses
{
    int bones;
    List<float4> table;

    float Count() { return table.count; }
}

struct Item
{
    float4x4 transform;
}

vert Play(mut Boned corner, Item item, Poses poses)
{
    corner.position.x += Poses { bones = 2 }.Count();
}

local singleton Keep
{
    Poses poses;
    List<Boned> corners;
    List<int> indices;
    List<Item> items;
}

view Show(Keep keep)
{
    Draw.Instanced(keep.corners, keep.indices, keep.items, Play, keep.poses);
}
