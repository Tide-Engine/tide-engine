// expect: 'Tail' is never copied: it holds an array of more than 4096 elements, which stays where it is, in its audio declaration's state
struct Tail
{
    int at;
    float[96000] line;
}

audio Echo(mut Samples samples, mut Tail tail)
{
    tail = Tail { at = 1 };
    samples.values[0] = tail.line[0];
}

scene Main
{
}
