// expect: kernel 'Inner' takes no values
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
struct Settings { float speed; }
compute Inner(Meadow meadow) { meadow.counts[0] = 1; }
view Show(Meadow meadow) { GPU.Run(Inner, 4, Settings { speed = 1 }); }
