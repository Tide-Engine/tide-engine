// expect: but Format.Rgba8 takes Color: change the output type or this image's format
scene Main { }
local singleton Images { RenderTarget target; }
frag Fill(Vertex vertex, out float4 value) { value = float4(vertex.uv,3,0.25); }
view Show(mut Images images) {
 images.target = RenderTarget(8,8,Format.Rgba8);
 images.target.Mesh([Vertex {position=float2(0)},Vertex {position=float2(1,0)},Vertex {position=float2(0,1)}], [0,1,2],Fill);
}
