// expect: TryGet takes an entity's handle and the variable its component goes to: 'world.TryGet<Health>(entity, out var value)'
component Health { int value; }
component Healer { Entity patient; }
scene Main { }
system Read(mut Healer healer, World world)
{
    if (world.TryGet<Health>(healer.patient)) healer.patient = default;
}
