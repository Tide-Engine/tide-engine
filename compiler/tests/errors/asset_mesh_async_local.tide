// expect: a task can't keep a Mesh while it waits: it's the pack's own memory, which is read within a frame
struct Corner
{
    float3 position;
    float3 normal;
}

asset Mesh<Corner> quad = "../e2e/assets/meshes/quad.glb";

local singleton Counter
{
    int n;
}

async void Later(mut Counter counter)
{
    var mesh = quad;
    await Wait.Seconds(1);
    counter.n = mesh.vertices.count;
}

scene Main
{
}
