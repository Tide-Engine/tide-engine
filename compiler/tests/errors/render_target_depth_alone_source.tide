// expect: the frag's source is the color of a target of depth alone (Format.Depth), which has none: read the target's depth through a DepthTexture field holding 'target.depth', or make the target with a color Format
scene Main { }
local singleton Lamp { RenderTarget map; RenderTarget scene; }
frag Copy(Vertex vertex, out Color color, Texture source) { color = source.Sample(vertex.uv); }
view Show(mut Lamp lamp)
{
    lamp.map = RenderTarget(64, 64, 1, Format.Depth);
    lamp.scene = RenderTarget(64, 64, 1);
    Draw.Blit(lamp.map.color, lamp.scene, Copy);
}
