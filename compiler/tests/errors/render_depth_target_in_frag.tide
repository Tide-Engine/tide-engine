// expect: a frag runs on the GPU, for each pixel, so it can't read a RenderTarget
// expect: the view keeps its depth in a DepthTexture field of a component or singleton this takes, 'lamp.shadow = lamp.map.depth;', which it reads there
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
frag Lit(Vertex vertex, mut Color color, Lamp lamp)
{
    float far = lamp.map.depth.Sample(vertex.uv);
    color = Color(far, far, far);
}
