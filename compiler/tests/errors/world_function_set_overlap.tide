// expect: 'Drain' sets any entity's Health through its World, and the system takes this entity's too
// expect: change this entity's through 'own', and send the others an event
component Health { int value; Entity other; }
scene Main { }
void Drain(Entity target, mut World world)
{
    mut var theirs = world.Get<Health>(target);
    theirs.value -= 1;
    world.Set<Health>(target, theirs);
}
system Fight(mut Health own, mut World world)
{
    own.value -= 1;
    Drain(own.other, world);
}
