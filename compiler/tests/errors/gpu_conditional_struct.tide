// expect: '?:' picks between numbers, vectors and colors in code the GPU runs, and this is V
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

frag Shade(V vertex, out Color color)
{
    V other = vertex.uv.x > 0.5 ? vertex : V { };
    color = Color.white * other.uv.x;
}

view Show(Box box, Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
