// expect: frag 'Shade' can end without writing its pixel's color, 'color'
// expect: a frag writes its color on every path that ends; one that draws nothing leaves the pixel with 'this.Discard();'
scene Main { }
struct Corner { float2 position; float2 uv; }
frag Shade(Corner corner, out Color color)
{
    if (corner.uv.x > 0.5) color = Color.red;
}
