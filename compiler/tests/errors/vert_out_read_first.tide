// expect: 'lamp.glow' is read before it's written
// expect: what a vert writes for its frag starts with no value: write it before reading it
scene Main { }
struct Corner { float3 position; float3 normal; float2 uv; }
struct FromLamp { float3 place; float glow; }
singleton Sun { float3 at = float3(0, 4, 0); }
local singleton Models { List<Corner> crate; List<int> faces; }
vert Place(mut Corner corner, out FromLamp lamp, Sun sun)
{
    lamp.place = corner.position - sun.at;
    lamp.glow = lamp.glow * 0.5;
}
