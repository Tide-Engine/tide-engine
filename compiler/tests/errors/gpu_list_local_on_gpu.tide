// expect: a GPU list in code the GPU runs is named where it's used: it can't be kept in a local, returned or picked there
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
float First(GPUList<Blade> blades)
{
    var kept = blades;
    return kept[0].height;
}
compute Look(Meadow meadow)
{
    meadow.counts[0] = int(First(meadow.blades));
}
view Show(Meadow meadow) { GPU.Run(Look, 1); }
