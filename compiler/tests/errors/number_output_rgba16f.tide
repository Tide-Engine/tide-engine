// expect: but Format.Rgba16f takes Color or float4: change the output type or this image's format
scene Main { }
local singleton Images { RenderTarget target; }
frag Fill(Vertex vertex, out float2 value) { value = vertex.uv; }
view Show(mut Images images) {
 images.target = RenderTarget(8,8,Format.Rgba16f);
 images.target.Mesh([Vertex {position=float2(0)},Vertex {position=float2(1,0)},Vertex {position=float2(0,1)}], [0,1,2],Fill);
}
