// expect: a Pixel is read by its fields, where the frag or vert takes it: it's not a value to keep or pass on
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

frag Shade(V vertex, out Color color, Pixel pixel)
{
    var p = pixel;
    color = Color.white;
}

view Show(Box box, Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Shade);
}
