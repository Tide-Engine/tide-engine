// expect: frag 'Look' reads a 'FromLamp', which vert 'Lift' doesn't write
// expect: a frag's struct is what the draw's vert writes for it, 'out FromLamp lamp' among the vert's parameters, an element of the list an Instanced draw is given, a List<FromLamp>, or the values the draw gives after its frag, 'Draw.Mesh(..., Look, FromLamp { ... })'
scene Main { }
struct Corner { float3 position; float3 normal; float2 uv; }
struct FromLamp { float3 place; float glow; }
singleton Sun { float3 at = float3(0, 4, 0); }
local singleton Models { List<Corner> crate; List<int> faces; }
vert Lift(mut Corner corner, Sun sun)
{
    corner.position.y += sun.at.y;
}
frag Look(Corner corner, FromLamp lamp, out Color color)
{
    color = Color.white * lamp.glow;
}

view Show(Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Lift, Look);
}
