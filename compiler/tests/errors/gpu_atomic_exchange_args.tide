// expect: AtomicCompareExchange takes the element's index, the value it compares with
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
compute Count(Meadow meadow)
{
    meadow.counts.AtomicCompareExchange(0, 1);
}
view Show(Meadow meadow) { GPU.Run(Count, 4); }
