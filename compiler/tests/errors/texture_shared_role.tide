// expect: vert 'Raise' and frag 'Shade' take the one texture 'height' with two roles
// expect: give both the same [Raw(T)], or name them apart for two textures
scene Main { }
local singleton Art { [Raw(float)] Texture height; List<Vertex3> mesh; }
vert Raise(mut Vertex3 vertex, [Raw(float)] Texture height) { vertex.position.y += height.Sample(vertex.uv); }
frag Shade(Vertex3 vertex, out Color color, Texture height) { color = height.Sample(vertex.uv); }
view Show(Art art) { Draw.Mesh(art.mesh, [0, 1, 2], float4x4.identity, art.height, Raise, Shade); }
