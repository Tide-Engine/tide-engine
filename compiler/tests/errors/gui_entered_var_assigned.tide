// expect: 'entered' is read-only
// expect: declare it as 'out mut var entered' to change it after the call that makes it
scene Main { }
local singleton Lobby { string code; int count; float ratio; bool entered; }
view Join(mut Lobby lobby)
{
    GUILayout.TextField("Code", lobby.code, out var entered);
    entered = entered || lobby.count > 2;
    if (entered) lobby.count += 1;
}
