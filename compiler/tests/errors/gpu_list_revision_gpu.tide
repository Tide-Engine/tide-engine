// expect: a kernel runs on the GPU, for each invocation, so it can't read a GPU list's contentRevision
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
compute Look(Meadow meadow)
{
    long r = meadow.blades.contentRevision;
    meadow.counts[0] = int(r);
}
view Show(Meadow meadow) { GPU.Run(Look, 1); }
