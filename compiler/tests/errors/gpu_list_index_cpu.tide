// expect: a GPU list's elements are on the GPU: the CPU reads it back with 'await list.Read()'
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
view Show(Meadow meadow)
{
    Blade b = meadow.blades[0];
    Draw.Circle(float2(0, 0), b.height, Color.white);
}
