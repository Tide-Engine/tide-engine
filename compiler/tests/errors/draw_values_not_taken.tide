// expect: this draw gives a 'Lift', which frag 'Shade' doesn't take
// expect: a vert or a frag reads a draw's values through a read-only parameter of their type, 'Lift values', after its vertex
scene Main { }
struct Corner { float3 position; float2 uv; }
struct Glow { Color tint; float gain; }
struct Lift { float3 by; }
local singleton Models
{
    List<Corner> crate;
    List<int> faces;
    List<Glow> glows;
    RenderTarget bright;
    RenderTarget spread;
}
frag Shade(Corner corner, out Color color)
{
    color = Color.white;
}
view Show(Models models)
{
    Draw.Mesh(models.crate, models.faces, float4x4.identity, Shade, Lift { by = float3(0, 1, 0) });
}
