// expect: a DepthTexture has Sample(uv) and Compare(uv, value), not 'Compared'
// expect: did you mean 'Compare'?
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
frag Lit(Vertex vertex, out Color color, Lamp lamp)
{
    float lit = lamp.shadow.Compared(vertex.uv, 0.5);
    color = Color(lit, lit, lit);
}
