// expect: an audio declaration's state is 1048568 bytes at the most where it rolls with Random, and 'Grain' is 1048572
// expect: each voice keeps what it rolls with after its state, 8 of the 1048576 bytes there are: make 'Grain' smaller
// Four bytes short of a megabyte fit a state, but not with the generator the
// code rolls with after them: here it rolls through a function.
struct Grain
{
    float[262143] taps;
}

float Hiss()
{
    return Random.NextFloat() - 0.5;
}

audio Noise(mut Samples samples, mut Grain grain)
{
    grain.taps[0] = Hiss();
    samples.values[0] = grain.taps[0];
}

scene Main
{
}
