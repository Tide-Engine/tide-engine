// expect: Draw.Mesh takes one wrap, for both of its texture's axes, and this is a second
scene Main { }

local singleton Art
{
    List<Vertex> corners;
    Grid2<Color> tiles = Grid2(4, 4);
}

view Show(Art art)
{
    Draw.Mesh(art.corners, [0, 1, 2], art.tiles, Filter.Point, Wrap.Repeat, Wrap.Clamp);
}
