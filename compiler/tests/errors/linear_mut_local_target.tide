// expect: [Linear] cannot read Rgba16f: this format has no sRGB counterpart
scene Main { }
local singleton Art { [Linear] Texture lit; }
void Remake(mut RenderTarget t) { t = RenderTarget(64, 64, Format.Rgba16f); }
view V(mut Art s) { mut RenderTarget t = RenderTarget(64, 64); Remake(t); s.lit = t.color; }
