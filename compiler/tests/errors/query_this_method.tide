// expect: 'Owner' uses 'this', the entity its Body belongs to, and this one belongs to none
component Body
{
    Entity Owner() { return this; }
}
scene Main { }
system Hits(query (Body body) bodies)
{
    foreach (var row in bodies)
    {
        var copied = row.body;
        Debug.Log($"{copied.Owner()}");
    }
}
