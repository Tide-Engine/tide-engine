// expect: this Sample reads its texture as it says, and 'look.far' says Filter.Anisotropic, which only a frag's own Sample reads
scene Main { }
local singleton Look
{
    [Filter(Filter.Anisotropic)]
    Grid2<Color> far = Grid2(4, 4);
    List<Vertex3> mesh;
}
Color Tile(Texture atlas, float2 uv) { return atlas.Sample(uv); }
frag Shade(Vertex3 vertex, out Color color, Look look) { color = Tile(look.far, vertex.uv); }
view Show(Look look) { Draw.Mesh(look.mesh, [0, 1, 2], float4x4.identity, Shade); }
