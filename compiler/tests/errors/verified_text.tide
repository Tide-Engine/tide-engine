// expect: 'title' is text of the confirmed match's, which a view doesn't read yet
component Name { string title; }
local singleton Fx { string shown; }
scene Main { }

event(Spawned) Setup(with Main) { Spawn(Name { title = "Ada" }); }

view Show(verified Name name, mut Fx fx)
{
    fx.shown = name.title;
}
