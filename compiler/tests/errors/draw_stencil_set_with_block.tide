// expect: Draw.SetStencil sets it for the draws that follow, and takes no block
// expect: to set it around some draws, and have it put back after them, write 'Draw.Stencil(...) { ... }'
scene Main { }

view Show()
{
    Draw.SetStencil(StencilTest.Always, 1, StencilOp.Replace)
    {
        Draw.Circle(float2(0, 0), 20, Color.white);
    }
}
