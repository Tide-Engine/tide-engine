// expect: a depth is read at its nearest pixel: Sample takes where to read, and no Filter
// expect: a depth blended between two pixels would be neither's: 'Compare(uv, value)' compares each, and blends what that gives
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
frag Lit(Vertex vertex, out Color color, Lamp lamp)
{
    float far = lamp.shadow.Sample(vertex.uv, Filter.Bilinear);
    color = Color(far, far, far);
}
