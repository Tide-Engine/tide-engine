// expect: a 3D mesh takes the transform that places it in the world, a float4x4, after its indices
// expect: 'Vertex3' is a 3D mesh's vertex, as its 'position' is a float3
scene Main { }

local singleton Art
{
    List<Vertex3> corners;
}

// A 3D mesh goes somewhere in the world: it takes a transform
view Show(Art art)
{
    Draw.Mesh(art.corners, [0, 1, 2]);
}
