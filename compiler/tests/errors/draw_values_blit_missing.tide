// expect: frag 'Blur' reads a 'Glow', and this draw names no vert that writes one
// expect: a frag's struct is what the draw's vert writes for it, 'out Glow glow' among the vert's parameters, an element of the list an Instanced draw is given, a List<Glow>, or the values the draw gives after its frag, 'Draw.Blit(..., Blur, Glow { ... })'
scene Main { }
struct Corner { float3 position; float2 uv; }
struct Glow { Color tint; float gain; }
struct Lift { float3 by; }
local singleton Models
{
    List<Corner> crate;
    List<int> faces;
    List<Glow> glows;
    RenderTarget bright;
    RenderTarget spread;
}
frag Blur(Vertex vertex, out Color color, Texture source, Glow glow)
{
    color = source.Sample(vertex.uv) * glow.tint;
}
view Show(Models models)
{
    Draw.Blit(models.bright.color, models.spread, Blur);
}
