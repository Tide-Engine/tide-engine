// expect: a render target holds 4 color images at the most, and this names 5 formats
// expect: each format after its size is one color image: 'RenderTarget(width, height, Format.Rgba8, Format.Rgba16f)' holds two
// Four color images is what every GPU Tide draws with has
scene Main { }
view Show() { var target = RenderTarget(64, 64, 1, Format.Rgba8, Format.Rgba16f, Format.Rgba16f, Format.Rgba16f, Format.Rgba16f); }
