// expect: the vert comes before the frag, as the GPU runs them: 'Draw3D.Mesh(..., Wave, Shade)'
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

frag Shade(V vertex, out Color color, Box box)
{
    color = box.tint;
}

vert Wave(mut V vertex)
{
    vertex.position.y += 1;
}

view Show(Box box, Models models)
{
    Draw3D.Mesh(models.crate, models.faces, float4x4.identity, Shade, Wave);
}
