// expect: a Sample that's Filter.Trilinear reads where the frag can work out as it starts: this uv is made of a variable that changes, or of one a loop counts
// expect: the GPU picks between a texture's smaller images by how fast the uv changes from one pixel to the next, which it's asked before any branch or loop: make the uv of the frag's parameters, constants and variables declared with 'var' and never assigned again, or sample with Filter.Bilinear here
scene Main { }

local singleton Models
{
    List<Vertex> corners;
    [Filter(Filter.Trilinear)]
    Grid2<Color> wood = Grid2(64, 64);
}

frag Shade(Vertex vertex, out Color color, Models models)
{
    color = Color.black;
    for (int i = 0; i < 4; i++) color += models.wood.Sample(vertex.uv + float2(i * 0.01, 0));
}

view Show(Models models)
{
    Draw.Mesh(models.corners, [0, 1, 2], Shade);
}
