// expect: Sample reads a grid as a texture, which the GPU does: in a frag or a vert
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

view Show(Models models)
{
    Draw.Clear(models.wood.Sample(float2(0, 0)));
}
