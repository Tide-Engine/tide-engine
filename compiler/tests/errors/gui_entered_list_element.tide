// expect: an indexed element can't be an 'out' argument to 'GUILayout.TextField'
// expect: receive the result in 'out var value', then assign value to the indexed destination after the call
scene Main { }
local singleton Lobby { string code; int count; float ratio; bool entered; }
local singleton Flags { List<bool> entered; }
view Join(mut Lobby lobby, mut Flags flags) { GUILayout.TextField("Code", lobby.code, out flags.entered[0]); }
