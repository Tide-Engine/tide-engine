// expect: 'Deep' can't be a mesh's vertex: its 'position' is float4
scene Main { }

struct V
{
    float3 position;
    float2 uv;
}

component Box
{
    Color tint = Color.white;
}

singleton Sun
{
    float3 direction = float3(0, -1, 0);
}

local singleton Models
{
    List<V> crate;
    List<int> faces;
    Grid2<Color> wood = Grid2(4, 4);
}

event(Spawned) Setup(with Main)
{
    Spawn(Box);
}

struct Deep
{
    float4 position;
}

local singleton Shapes
{
    List<Deep> corners;
}

view Show(Shapes shapes)
{
    Draw.Mesh(shapes.corners, [0, 1, 2], float4x4.identity);
}
