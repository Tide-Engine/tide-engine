// expect: a GPU list's elements are on the GPU
scene Main { }

struct Blade
{
    float3 root;
    float height;
}

local singleton Meadow
{
    GPUList<Blade> blades;
    GPUList<int> counts;
    List<Blade> sent;
}
view Show(Meadow meadow)
{
    foreach (var b in meadow.blades) Draw.Circle(float2(0, 0), b.height, Color.white);
}
