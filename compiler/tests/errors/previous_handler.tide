// expect: 'previous' is for a system's query: a handler runs once the tick's systems are done
// expect: a handler's query reads the world as its event's turn finds it
component Body { float3 position; }
event Hit { int amount; }
scene Main { }
system Hits(Body body) { this.Send(Hit { amount = 1 }); }
event(Hit hit) Heard(query (previous Body other) others)
{
    foreach (var o in others) { }
}
