// expect: 'Marked' can't go from a vert to its frag: its 'bone' is long
// expect: use floats, their vectors, colors, ints, int vectors, bools or enums in the handed struct
scene Main { }
struct Corner { float2 position; }
struct Marked { long bone; }
vert Wave(mut Corner corner, out Marked marked) { marked.bone = 2; }
