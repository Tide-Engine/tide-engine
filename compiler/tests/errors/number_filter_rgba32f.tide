// expect: image 'source' is read between its smaller images, and Format.Rgba32f has none: read it with Sample(uv) or Filter.Bilinear, or draw the numbers into Format.Rgba16f
// expect: no GPU blends 32-bit floats on every device, so tidec loads them exactly
scene Main { }
local singleton Images { RenderTarget target; [Raw(float4)] Texture source; }
frag Read(Vertex vertex,out Color color,Images images) { color=Color(images.source.Sample(vertex.uv,Filter.Trilinear).x,0,0); }
view Show(mut Images images) { images.target=RenderTarget(8,8,Format.Rgba32f); images.source=images.target.color; List<Vertex> quad=[Vertex {position=float2(0)},Vertex {position=float2(1,0)},Vertex {position=float2(0,1)}]; Draw.Mesh(quad,[0,1,2],Read); }
