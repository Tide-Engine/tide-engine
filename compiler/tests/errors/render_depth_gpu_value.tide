// expect: DepthTexture can't go to the GPU: a target's depth is read with 'depth.Sample(uv)' or 'depth.Compare(uv, value)', not kept as a GPU value
// A function is written for the depth it's passed, and keeps it nowhere
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
float Far(DepthTexture shadow)
{
    DepthTexture kept = shadow;
    return 1;
}
frag Lit(Vertex vertex, out Color color, Lamp lamp)
{
    float far = Far(lamp.shadow);
    color = Color(far, far, far);
}
