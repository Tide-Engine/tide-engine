// expect: Sample takes where to read, a float2 from (0, 0) to (1, 1): 'shadow.Sample(uv)'
// expect: it gives the depth stored there, a float; 'shadow.Compare(uv, depth)' compares it with one
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
frag Lit(Vertex vertex, mut Color color, Lamp lamp)
{
    float far = lamp.shadow.Sample(vertex.uv.x);
    color = Color(far, far, far);
}
