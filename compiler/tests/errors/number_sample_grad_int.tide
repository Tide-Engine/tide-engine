// expect: an int image reads its nearest pixel: a GPU blends no integers, so it has no smaller images
scene Main { }
local singleton Images { [Raw(int)] Texture image; }
frag Read(Vertex vertex, out Color color, Images images) { color=Color(images.image.SampleGrad(vertex.uv,float2(0.1,0),float2(0,0.1)),0,0); }
