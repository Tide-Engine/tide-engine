// expect: Compare takes where to read, a float2 from (0, 0) to (1, 1), and the depth to compare what's stored there with, a number from 0 to 1: 'shadow.Compare(uv, depth)'
scene Main { }
local singleton Lamp { RenderTarget map; DepthTexture shadow; }
frag Lit(Vertex vertex, mut Color color, Lamp lamp)
{
    float lit = lamp.shadow.Compare(vertex.uv);
    color = Color(lit, lit, lit);
}
