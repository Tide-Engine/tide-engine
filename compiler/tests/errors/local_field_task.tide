// expect: 'bakes' is a local field of 'Box': it's this machine's, and 'Rebake' is a match task, which can't see it
component Box
{
    float3 pos;
    local List<int> verts;
    local int bakes;
}
scene Main { }

// Waiting for ticks makes it the match's: local fields are this machine's tasks'
async void Rebake(mut Box box)
{
    await Wait.Ticks(2);
    box.bakes = 0;
}
