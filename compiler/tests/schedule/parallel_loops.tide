// Each parallel loop's reckoning and when it goes to the threads, or what
// keeps it on one; and the views whose first tests run before a row is copied
scene Main { }

component Body { float3 position; float speed; local bool near; local float shown; }

singleton Field { List<float> heights; }

local singleton Looks { List<float> weights; bool on; }

event Poke { }

event(Spawned) Setup(with Main)
{
    Spawn(Body { speed = 2 });
}

float Heavy(float x)
{
    mut var v = x;
    for (var i = 0; i < 40; i++) v = Math.Sin(v * 1.3) + Math.Cos(v);
    return v;
}

system Raise(mut Field field)
{
    parallel (var i in field.heights) field.heights[i] = Heavy(i);
}

// Its steps read a list the system made: on its own thread
[After(Raise)] system Scale(mut Field field)
{
    mut List<float> by = [];
    by.Add(2);
    parallel (var i in field.heights) field.heights[i] = field.heights[i] * by[0];
}

view Place(query (mut Body body) bodies)
{
    parallel (var row in bodies)
    {
        if (!row.body.near) continue;
        row.body.shown = Heavy(row.body.position.x);
    }
}

local event(Poke) Heard(mut Looks looks)
{
    parallel (var i in looks.weights) looks.weights[i] = Heavy(i);
}

[After(Place)] view Near(Body body, Looks looks)
{
    if (!looks.on || !body.near) return;
    Draw.Circle(body.position.xy, 1, Color.white);
}

// A test of the match's own field: the view's code runs it
[After(Near)] view Fast(Body body)
{
    if (body.speed < 1) return;
    Draw.Circle(body.position.xy, 2, Color.white);
}

system Tell(Field field)
{
    if (field.heights.count > 100000) Send(Poke { });
}
