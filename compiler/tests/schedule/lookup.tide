// A lookup is access to every entity's component: Aim and Chase can't meet
// the same entity, but Chase looks every Transform up, so it waits for Aim's
// writes; Heal's mut lookup writes any Health, so Drain waits for it.

component Transform
{
    float2 position;
}

component Turret { }

component Runner
{
    Entity leader;
}

component Health
{
    int value;
}

component Healer
{
    Entity patient;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Transform, Turret);
    Spawn(Transform, Runner);
    Spawn(Health);
    Spawn(Healer);
}

system Aim(mut Transform trs, with Turret)
{
    trs.position.x += 1;
}

system Chase(mut Transform trs, Runner runner, lookup Transform others)
{
    trs.position = others[runner.leader].position;
}

system Heal(Healer healer, mut lookup Health health)
{
    mut var h = health[healer.patient];
    h.value += 1;
    health[healer.patient] = h;
}

system Drain(mut Health health)
{
    health.value -= 1;
}
