// A system in C is handed the entity table (tide_rows.entities), where a
// spawner's entities are once it registers them: on threads, whenever its
// tasks are done. So a system in C and a system that spawns keep their order,
// with no data in common, and C sees the entities the systems before it
// spawned and none of the ones after it, as on one thread. Systems written in
// Tide can't tell, and spawning makes none of them wait.

component Position
{
    float2 at;
}

component Velocity
{
    float2 by;
}

component Rock { }

singleton Count
{
    int moved;
}

scene Main { }

[NativeName("game_move")]
extern system Move(mut Position position, Velocity velocity, Time time);

// Shares nothing with Move, Drift or Tally, but spawns: after Move, before Tally
system Launch(Time time)
{
    if (time.tick % 60 == 0) Spawn(Position, Velocity, Rock);
}

// In Tide: spawning makes it wait for nothing
system Drift(mut Velocity velocity, with Rock)
{
    velocity.by *= 0.5;
}

[NativeName("game_tally")]
extern system Tally(mut Count count);

event(Spawned) Setup(with Main)
{
    Spawn(Position, Velocity, Rock);
}
