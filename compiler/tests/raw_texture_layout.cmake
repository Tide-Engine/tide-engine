# Role changes must select migration without changing the C representation or simulation identity.
foreach(kind IN ITEMS plain raw)
    file(MAKE_DIRECTORY "${OUT}/${kind}")
    set(role "")
    if(kind STREQUAL raw)
        set(role "[Raw] ")
    endif()
    file(WRITE "${OUT}/${kind}.tide"
        "using Image = Texture;\nscene Main { }\nsingleton State { int value = 7; }\nlocal singleton Art { ${role}Image image; }\n")
    execute_process(COMMAND "${TIDEC}" "${OUT}/${kind}.tide" -o "${OUT}/${kind}" --name game --layout
        RESULT_VARIABLE result ERROR_VARIABLE diagnostics)
    if(NOT result EQUAL 0 OR NOT diagnostics STREQUAL "")
        message(FATAL_ERROR "${kind} Texture role layout failed: ${diagnostics}")
    endif()
    file(READ "${OUT}/${kind}/game.h" ${kind}_header)
    file(READ "${OUT}/${kind}/game.c" ${kind}_generated)
    string(REGEX MATCH "#define TIDE_SIMULATION_ID \"[^\"]+\"" ${kind}_simulation "${${kind}_header}")
    string(REGEX MATCH "\\.hash = 0x[0-9A-F]+ull" ${kind}_hash "${${kind}_generated}")
endforeach()
if(NOT plain_hash OR NOT raw_hash OR plain_hash STREQUAL raw_hash)
    message(FATAL_ERROR "Texture role changes must change the header hash so reload takes the migration path")
endif()
if(NOT plain_simulation OR NOT plain_simulation STREQUAL raw_simulation)
    message(FATAL_ERROR "a local Texture role must not change simulation identity")
endif()
if(NOT raw_generated MATCHES "\"image\", \"\\[Raw\\] Texture\""
   OR NOT plain_generated MATCHES "\"image\", \"Texture\"")
    message(FATAL_ERROR "Raw/plain Texture fields must have distinct private migration names")
endif()
if(plain_header MATCHES "\\[Raw\\] Texture")
    message(FATAL_ERROR "ordinary games must keep their unmarked headers")
endif()
string(REPLACE " // [Raw] Texture" "" raw_header "${raw_header}")
foreach(kind IN ITEMS plain raw)
    string(REGEX REPLACE "^[^\n]*\n" "" ${kind}_header "${${kind}_header}")
endforeach()
if(NOT plain_header STREQUAL raw_header)
    message(FATAL_ERROR "a local Raw role must change only its header comment, with identical C storage")
endif()
