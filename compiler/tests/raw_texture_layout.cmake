# Role changes must select migration without changing the C representation or simulation identity: plain, [Raw]
# and each typed [Raw(T)] role are told apart, so a reload from one to another resets the field.
set(kinds plain raw rawfloat rawfloat4 rawint)
set(plain_role "")
set(raw_role "[Raw] ")
set(rawfloat_role "[Raw(float)] ")
set(rawfloat4_role "[Raw(float4)] ")
set(rawint_role "[Raw(int)] ")
set(plain_name "Texture")
set(raw_name "\\[Raw\\] Texture")
set(rawfloat_name "\\[Raw\\(float\\)\\] Texture")
set(rawfloat4_name "\\[Raw\\(float4\\)\\] Texture")
set(rawint_name "\\[Raw\\(int\\)\\] Texture")
foreach(kind IN LISTS kinds)
    file(MAKE_DIRECTORY "${OUT}/${kind}")
    file(WRITE "${OUT}/${kind}.tide"
        "using Image = Texture;\nscene Main { }\nsingleton State { int value = 7; }\nlocal singleton Art { ${${kind}_role}Image image; }\n")
    execute_process(COMMAND "${TIDEC}" "${OUT}/${kind}.tide" -o "${OUT}/${kind}" --name game --layout
        RESULT_VARIABLE result ERROR_VARIABLE diagnostics)
    if(NOT result EQUAL 0 OR NOT diagnostics STREQUAL "")
        message(FATAL_ERROR "${kind} Texture role layout failed: ${diagnostics}")
    endif()
    file(READ "${OUT}/${kind}/game.h" ${kind}_header)
    file(READ "${OUT}/${kind}/game.c" ${kind}_generated)
    string(REGEX MATCH "#define TIDE_SIMULATION_ID \"[^\"]+\"" ${kind}_simulation "${${kind}_header}")
    string(REGEX MATCH "\\.hash = 0x[0-9A-F]+ull" ${kind}_hash "${${kind}_generated}")
    if(NOT ${kind}_hash)
        message(FATAL_ERROR "${kind}: no layout hash")
    endif()
    if(NOT ${kind}_generated MATCHES "\"image\", \"${${kind}_name}\"")
        message(FATAL_ERROR "${kind} Texture fields must have their own private migration name")
    endif()
endforeach()
foreach(a IN LISTS kinds)
    foreach(b IN LISTS kinds)
        if(NOT a STREQUAL b AND ${a}_hash STREQUAL ${b}_hash)
            message(FATAL_ERROR "Texture role changes (${a} to ${b}) must change the header hash so reload takes the migration path")
        endif()
    endforeach()
    if(NOT plain_simulation OR NOT plain_simulation STREQUAL ${a}_simulation)
        message(FATAL_ERROR "a local Texture role (${a}) must not change simulation identity")
    endif()
endforeach()
if(plain_header MATCHES "\\[Raw")
    message(FATAL_ERROR "ordinary games must keep their unmarked headers")
endif()
foreach(kind IN LISTS kinds)
    string(REGEX REPLACE " // \\[Raw[^\n]*\\] Texture" "" ${kind}_header "${${kind}_header}")
    string(REGEX REPLACE "^[^\n]*\n" "" ${kind}_header "${${kind}_header}")
    if(NOT plain_header STREQUAL ${kind}_header)
        message(FATAL_ERROR "a local ${kind} role must change only its header comment, with identical C storage")
    endif()
endforeach()
