// expect: build code made 'quad' with a triangle of vertex 9, and it has 4 vertices
struct Corner { float3 position; }
asset Mesh<Corner> source = "../e2e/assets/meshes/quad.glb";
build Mesh<Corner> Broken(Mesh<Corner> from) { return Mesh(from.vertices, [0, 1, 9]); }
asset Mesh<Corner> quad = Broken(source);
scene Main { }
