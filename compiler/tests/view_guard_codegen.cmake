if(NOT DEFINED GAME_C OR NOT EXISTS "${GAME_C}")
    message(FATAL_ERROR "GAME_C must name the generated view_guard C file")
endif()
file(READ "${GAME_C}" generated)
# The body of a view's run function, tide_run_view_<name>
function(body_of view output)
    string(FIND "${generated}" "static void tide_run_view_${view}(" begin)
    if(begin EQUAL -1)
        message(FATAL_ERROR "view_guard is missing tide_run_view_${view}")
    endif()
    string(SUBSTRING "${generated}" ${begin} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    string(SUBSTRING "${tail}" 0 ${end} body)
    set(${output} "${body}" PARENT_SCOPE)
endfunction()
# Views that start with tests of this machine's own state run them before a row's copy and blend
foreach(view IN ITEMS Fresh Guarded Nested MatchGuarded)
    body_of(${view} body)
    string(FIND "${body}" "if (tide_view_guard_${view}(" guard)
    string(FIND "${body}" "tide_gather_" gather)
    string(FIND "${body}" "tide_blend_" blend)
    if(guard EQUAL -1)
        message(FATAL_ERROR "${view} starts with tests of local state, yet its rows have no guard")
    endif()
    if(gather EQUAL -1 OR gather LESS guard OR (NOT blend EQUAL -1 AND blend LESS guard))
        message(FATAL_ERROR "${view}'s rows are copied before its guard runs")
    endif()
endforeach()
# A call, an assignment first, and a test of the match's own field are the code's alone
foreach(view IN ITEMS Choose Plain Match MatchPlain)
    body_of(${view} body)
    if(body MATCHES "tide_view_guard_")
        message(FATAL_ERROR "${view} has a guard, though its code doesn't start with tests of local state")
    endif()
endforeach()
# The body of the function that makes a view's query's rows (its definition, past its declaration)
function(rows_of view output)
    string(REGEX MATCH "tide_query_${view}_[0-9]+\\(const tide_world \\*tide_w[^;{]*\\)\n{" start "${generated}")
    if(start STREQUAL "")
        message(FATAL_ERROR "view_guard is missing ${view}'s rows")
    endif()
    string(FIND "${generated}" "${start}" begin)
    string(SUBSTRING "${generated}" ${begin} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    string(SUBSTRING "${tail}" 0 ${end} body)
    set(${output} "${body}" PARENT_SCOPE)
endfunction()
# A view's rows: where its one loop starts with tests of local state, the rows' fill runs them first
foreach(view IN ITEMS EachGuarded AtOnce Beams)
    rows_of(${view} body)
    string(FIND "${body}" "an entity they turn away has no row" guard)
    string(FIND "${body}" "tide_gather_" gather)
    if(guard EQUAL -1 OR gather LESS guard)
        message(FATAL_ERROR "${view}'s rows are made before its loop's tests run")
    endif()
endforeach()
foreach(view IN ITEMS EachPlain Sum BeamsPlain)
    rows_of(${view} body)
    if(body MATCHES "an entity they turn away has no row")
        message(FATAL_ERROR "${view}'s rows have a guard, though its loop doesn't start with tests of local state")
    endif()
endforeach()
# A query handed to a function: its rows hold the lanes the function's loop reads, not the whole component
rows_of(Beams body)
if(NOT body MATCHES "tide_gather_some_Man" OR body MATCHES "tide_gather_Man[(]")
    message(FATAL_ERROR "Beams hands its query to a function that reads a few of Man's fields, yet its rows copy all of it")
endif()
