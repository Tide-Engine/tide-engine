cmake_minimum_required(VERSION 3.25)

file(MAKE_DIRECTORY "${OUT}")
set(source "${OUT}/game.tide")
set(types "component Value { int number; }\nscene Other { int size = 22; }\nlocal scene Menu { }\nnamespace Levels { prefab First { Value { number = 7 }; } prefab Second { Value { number = 9 }; } }\n")
file(WRITE "${source}" "${types}settings { startScene = Levels.First; }\n")

function(compile name expected)
    file(MAKE_DIRECTORY "${OUT}/${name}")
    execute_process(COMMAND "${TIDEC}" "${source}" ${extra_sources} -o "${OUT}/${name}" --name game --no-line ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    if("${stdout}${stderr}" MATCHES "AddressSanitizer|UndefinedBehaviorSanitizer|runtime error:")
        message(FATAL_ERROR "a sanitizer's report:\n${stdout}${stderr}")
    endif()
    if(expected EQUAL 0)
        if(NOT result EQUAL 0 OR NOT stderr STREQUAL "")
            message(FATAL_ERROR "${name}: expected warning-free compilation, got ${result}:\n${stdout}${stderr}")
        endif()
        file(READ "${OUT}/${name}/game.h" header)
        file(READ "${OUT}/${name}/game.c" generated)
        string(REGEX MATCH "#define TIDE_SIMULATION_ID \"([0-9a-f]+)\"" matched "${header}")
        set(identity "${CMAKE_MATCH_1}" PARENT_SCOPE)
        set(header "${header}" PARENT_SCOPE)
        set(generated "${generated}" PARENT_SCOPE)
    elseif(result EQUAL 0)
        message(FATAL_ERROR "${name}: invalid startup compiled")
    endif()
    set(stderr "${stderr}" PARENT_SCOPE)
endfunction()

function(contains text needle)
    string(FIND "${text}" "${needle}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "missing '${needle}' in:\n${text}")
    endif()
endfunction()

compile(persistent 0)
set(first_identity "${identity}")
set(first_generated "${generated}")
compile(explicit_same 0 --scene Levels.First)
if(NOT identity STREQUAL first_identity OR NOT generated STREQUAL first_generated)
    message(FATAL_ERROR "selecting the persistent startup explicitly changed the generated program")
endif()
compile(override 0 --scene Levels.Second)
if(identity STREQUAL first_identity)
    message(FATAL_ERROR "different authored startup values kept the same simulation identity")
endif()

# Local declarations do not alter the startup factory's stable identity.
file(APPEND "${source}" "local singleton Unrelated { int number; }\n")
compile(unrelated_local 0)
if(NOT identity STREQUAL first_identity)
    message(FATAL_ERROR "an unrelated local declaration changed the startup simulation identity")
endif()

compile(local_scene 0 --scene Menu)
contains("${header}" "#define TIDE_MAIN_IS_LOCAL 1")
compile(match_scene 0 --scene Other)
string(FIND "${header}" "#define TIDE_MAIN_IS_LOCAL" local)
if(NOT local EQUAL -1)
    message(FATAL_ERROR "a match startup was emitted as local")
endif()
file(APPEND "${source}" "scene Main { }\n")
compile(unknown 1 --scene Levels.Missing)
contains("${stderr}" "no prefab or scene named 'Levels.Missing'")
compile(not_scene 1 --scene Value)
contains("${stderr}" "startup takes a prefab or scene")

# Ordinary builds keep their source symbols and have no startup factory.
file(WRITE "${source}" "${types}scene Main { }\n")
compile(normal 0)
set(normal_generated "${generated}")
string(FIND "${generated}" "tide_function_tide_startup" factory)
if(NOT factory EQUAL -1)
    message(FATAL_ERROR "a normal Main build gained a startup factory")
endif()
compile(normal_again 0)
if(NOT normal_generated STREQUAL generated)
    message(FATAL_ERROR "a normal build changed after direct-startup generation")
endif()
file(WRITE "${source}" "${types}settings { startScene = \"Levels.First\"; }\n")
compile(string_setting 1)
contains("${stderr}" "startScene names a prefab or scene declaration")
file(WRITE "${source}" "${types}settings { startScene = Levels.First; startScene = Levels.Second; }\n")
compile(duplicate_setting 1)
contains("${stderr}" "'startScene' is set twice")

# The replacement lives outside the original directory. Assets resolve from
# the original source, and neither valid nor invalid drafts touch its bytes.
file(MAKE_DIRECTORY "${OUT}/authored/assets" "${OUT}/drafts")
set(original "${OUT}/authored/overlay.tide")
set(draft "${OUT}/drafts/replacement.txt")
set(extra_sources "${original}")
file(WRITE "${source}" "component Text { string value; }\nsettings { startScene = Draft; }\n")
file(WRITE "${OUT}/authored/assets/selected.txt" "selected one\n")
file(WRITE "${OUT}/authored/assets/unused.txt" "unused one\n")
set(draft_text "asset string selected = \"assets/selected.txt\";\nasset string unused = \"assets/unused.txt\";\nprefab Draft { Text { value = selected }; }\n")
file(WRITE "${draft}" "${draft_text}")
file(WRITE "${original}" "invalid original source bytes\r\n")
file(SHA256 "${original}" original_hash)
compile(overlay 0 --source-overlay "${original}" "${draft}" --strip-unused-assets)
set(overlay_identity "${identity}")
contains("${generated}" "tide_asset_selected")
string(FIND "${generated}" "tide_asset_unused" unused)
if(NOT unused EQUAL -1)
    message(FATAL_ERROR "unused control asset was retained")
endif()
compile(server_overlay 0 --source-overlay "${original}" "${draft}" --strip-server-assets)
if(NOT identity STREQUAL overlay_identity)
    message(FATAL_ERROR "server startup asset closure changed the client simulation identity")
endif()
contains("${generated}" "tide_asset_selected")
file(WRITE "${OUT}/authored/assets/unused.txt" "unused two\n")
compile(unused_asset_edit 0 --source-overlay "${original}" "${draft}" --strip-unused-assets)
if(NOT identity STREQUAL overlay_identity)
    message(FATAL_ERROR "an unused asset changed the startup simulation identity")
endif()
file(WRITE "${OUT}/authored/assets/selected.txt" "selected two\n")
compile(startup_asset_edit 0 --source-overlay "${original}" "${draft}" --strip-unused-assets)
if(identity STREQUAL overlay_identity)
    message(FATAL_ERROR "a startup-only asset edit did not change the simulation identity")
endif()
file(WRITE "${draft}" "prefab Draft { Missing; }\n")
compile(invalid_overlay 1 --source-overlay "${original}" "${draft}")
contains("${stderr}" "authored/overlay.tide:")
file(SHA256 "${original}" after_hash)
if(NOT original_hash STREQUAL after_hash)
    message(FATAL_ERROR "source-overlay changed original source bytes")
endif()

# An unsaved new file can be supplied explicitly to tidec before it exists.
set(extra_sources "${OUT}/authored/absent.tprefab")
file(WRITE "${draft}" "prefab Draft { Text { value = \"unsaved\" }; }\n")
compile(absent_overlay 0 --source-overlay "${extra_sources}" "${draft}")
if(EXISTS "${extra_sources}")
    message(FATAL_ERROR "source-overlay wrote the unsaved source to disk")
endif()

set(extra_sources "")
file(WRITE "${source}" "${types}settings { startScene = Levels.First; }\n")
execute_process(COMMAND "${TIDEC}" "${source}" --outline RESULT_VARIABLE result OUTPUT_VARIABLE outline ERROR_VARIABLE err)
if(NOT result EQUAL 0 OR NOT err STREQUAL "")
    message(FATAL_ERROR "startup outline failed: ${err}")
endif()
string(FIND "${outline}" "tide_startup" private)
if(NOT private EQUAL -1)
    message(FATAL_ERROR "the private startup factory leaked into the source outline")
endif()
