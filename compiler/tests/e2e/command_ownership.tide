// `with ownership` on a command's handler: only for an entity the command's sender owns; `without`, any other

component Counter { int value; int pokes; }
command Poke { int amount; }
command Steal { int amount; }
singleton Log { int stolen; PlayerID last; int seen; }
local singleton UI { Entity target; int which; bool send; }
scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Counter, Owner { player = PlayerID(0) });
    Spawn(Counter, Owner { player = PlayerID(1) });
    Spawn(Counter); // Nobody's
}

// No sender named: the filter is all the check there is
command(Poke poke) Bump(mut Counter counter, with ownership)
{
    counter.value += poke.amount;
    counter.pokes++;
}

// A sender named too, and the filter's other side: only what the sender doesn't own, whoever's it is
command(Steal steal, PlayerID sender) Take(mut Counter counter, mut Log log, without ownership)
{
    counter.value -= steal.amount;
    log.stolen += steal.amount;
    log.last = sender;
    log.seen++;
}

view Submit(mut UI ui)
{
    if (!ui.send) return;
    ui.send = false;
    if (ui.which == 0) ui.target.Send(Poke { amount = 5 });
    else ui.target.Send(Steal { amount = 2 });
}
