// Each owner's text, lists and grids are in a heap of its own (tide/heap.h, A
// world's heaps), so systems that change different owners' run at the same
// time, and what a system spawns or sends holding text goes into the heap of
// what holds it. Whatever threads run them, the world is one thread's: the
// same blocks at the same places in every heap, tick by tick, and as bytes.

singleton Ledger
{
    List<int> entries;
    string last;
}

singleton Roster
{
    List<string> names;
    Map<int, int> seen;
}

singleton Board
{
    Grid2<int> cells = Grid2(64, 64);
    string? note;       // Text behind a `?` is in the heap as any other
    List<int>? marks;
}

singleton Tally
{
    int ticks;          // Nothing of its own in a heap
    int ghosts;
}

component Pack
{
    int id;
    List<int> items;
    string label;
}

component Trail
{
    int id;
    List<float> points;
}

component Ghost
{
    int of;
    string name;
}

event Named
{
    int id;
    string name;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    for (var i = 0; i < 400; i++) Spawn(Pack { id = i, label = $"pack {i}" });
    for (var i = 0; i < 300; i++) Spawn(Trail { id = i });
}

// Each of these changes one owner's heap and reads nothing the others change
system Write(mut Ledger ledger, Time time)
{
    mut var y = float(time.tick) * 0.001;
    for (var i = 0; i < 20000; i++) y = Math.Sin(y * 1.3 + 0.7) + Math.Cos(y * 0.9);
    for (var i = 0; i < 40; i++) ledger.entries.Add(time.tick * 100 + i + int(y * 10));
    if (time.tick % 3 == 2) for (var i = 0; i < 25; i++) ledger.entries.RemoveAt(0);
    ledger.last = $"tick {time.tick} of {ledger.entries.count}";
}

system Enlist(mut Roster roster, Time time)
{
    mut var y = float(time.tick) * 0.002;
    for (var i = 0; i < 20000; i++) y = Math.Sin(y * 1.1 + 0.3) + Math.Cos(y * 0.7);
    for (var i = 0; i < 12; i++) roster.names.Add($"recruit {time.tick}.{i}.{int(y * 100)}");
    if (time.tick % 4 == 3) for (var i = 0; i < 9; i++) roster.names.RemoveAt(roster.names.count - 1);
    roster.seen[time.tick % 7] = time.tick;
    if (time.tick % 5 == 4) roster.seen.Remove((time.tick + 3) % 7);
}

system Paint(mut Board board, Time time)
{
    mut var y = float(time.tick) * 0.003;
    for (var i = 0; i < 20000; i++) y = Math.Sin(y * 0.9 + 0.1) + Math.Cos(y * 1.7);
    for (var i = 0; i < 64; i++) board.cells[(i * 7 + time.tick) % 64, (i * 13 + time.tick * 3) % 64] = time.tick + i + int(y);
    if (time.tick % 2 == 0)
    {
        board.note = $"painted on tick {time.tick}";
        board.marks = [time.tick, time.tick + 1, time.tick + 2];
    }
    else
    {
        board.note = null;
        board.marks = null;
    }
}

// Per entity, changing each row's own list and text: one thread, its entities
// in order. Their work is written out here, where tidec counts it: a tick's
// worth of threads on a pool that doesn't time its ticks
system Stuff(mut Pack pack, Time time)
{
    mut var y = float(pack.id + time.tick) * 0.001;
    for (var i = 0; i < 1500; i++) y = Math.Sin(y * 1.3 + 0.7) + Math.Cos(y * 0.9);
    if (y > 100.0) return;
    if ((pack.id + time.tick) % 3 == 0) pack.items.Add(pack.id * 10 + time.tick);
    if ((pack.id + time.tick) % 8 == 5 && pack.items.count > 0) pack.items.RemoveAt(0);
    if ((pack.id + time.tick) % 11 == 2) pack.label = $"pack {pack.id} at {time.tick}";
}

system Walk(mut Trail trail, Time time)
{
    mut var y = float(trail.id + time.tick) * 0.001;
    for (var i = 0; i < 1500; i++) y = Math.Sin(y * 1.1 + 0.3) + Math.Cos(y * 0.7);
    trail.points.Add(y);
    if ((trail.id + time.tick) % 6 == 4) trail.points.Clear();
}

// Spawns a component and sends an event that hold text: into Ghost's heap and
// Named's, as they're queued, in its entities' order
system Haunt(Pack pack, Time time)
{
    if ((pack.id * 3 + time.tick) % 16 != 1) return;
    Spawn(Ghost { of = pack.id, name = $"ghost of {pack.id} from tick {time.tick}" });
    Send(Named { id = pack.id, name = $"named {pack.id}.{time.tick}" });
}

// Another spawner of the same component: nothing waits for the other to run,
// and the entities are registered in the tick's order
system Summon(Trail trail, Time time)
{
    if ((trail.id + time.tick * 5) % 31 != 3) return;
    Spawn(Ghost { of = -trail.id, name = $"summoned by trail {trail.id}" });
}

system Exorcise(Ghost ghost, mut Tally tally, Time time)
{
    tally.ghosts++;
    if ((ghost.of + time.tick) % 5 == 0) this.Destroy();
}

system Count(mut Tally tally)
{
    tally.ticks++;
}

event(Named named) Hear(mut Roster roster)
{
    roster.names.Add(named.name);
}
