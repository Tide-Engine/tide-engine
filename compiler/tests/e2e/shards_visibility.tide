// Visibility in a sharded world (tests/e2e/shards_visibility_test.c): a
// group the root makes keeps four movers from everyone but player 0 on
// whichever shard has them, as the directory of groups is the root's and every
// shard reads it. Once mover 0 is well into the right region, code there opens
// the group to everyone: it waits on the border for the root's directory, and
// then every shard shows the movers to every player.
settings
{
    shards = true;
    reach = 8;
    maxPlayers = 4;
}

component Mover
{
    [Position] float2 position;
    float2 velocity;
    int id;
    bool opened;
}

component Secret { int value = 7; }

singleton Control { VisibilityGroup few; }

scene Main { }

event(Spawned) Setup(with Main, mut Control control)
{
    control.few = Visibility.CreateGroup(Audience.Only(PlayerID(0)));
    for (int i = 0; i < 4; i++)
    {
        Spawn(Mover { position = float2(-14.0 + i, 0), velocity = float2(4, 0), id = i }, Secret,
              Visibility { group = control.few });
    }
    Spawn(Mover { position = float2(14, 0), id = 10 }, Secret, Visibility);
}

system Move(mut Mover m, Time time)
{
    m.position += m.velocity * time.dt;
    if (m.position.x > 18) m.velocity = float2(0, 0);
}

system Open(mut Mover m, Control control)
{
    if (m.id != 0 || m.opened || m.position.x < 10) return;
    Visibility.Set(control.few, Audience.All);
    m.opened = true;
}
