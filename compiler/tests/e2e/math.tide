// Vector math: every built-in type, constructors, swizzles, operators,
// Math functions, quaternions and matrices.

const float3 RGB = float3(0.25, 0.5, 0.75);
const Color RGB_TINT = Color(RGB);
const Color RGBA_TINT = Color(float4(RGB.xy, RGB.z, 0.5));
const float QUARTER_TURN = 90deg;

component Body
{
    float3 position = float3(1, 2, 3);
    float2 flat;
    float4 color = float4(1, 0.5, 0.25, 1);
    int2 cell = int2(3, -4);
    quaternion rotation = quaternion.identity;
    quaternion initialEuler = quaternion.Euler(0, Math.PI / 2, 0);
    float3x3 basis = float3x3.identity;
    float4x4 world;
    float angle = Math.Radians(90);
    float pi = Math.PI;
    float2 move; // No key held
    quaternion unset = quaternion(0, 0, 0, 0);
    Color rgbTint = RGB_TINT;
    Color rgbaTint = RGBA_TINT;
    Color mixedTint = Color(0.25, float2(0.5, 0.75));
    Color integerTint = Color(int3(1, 0, 1), 0.5);
    float degreeAngle = 180deg;
    float degreeConstant = QUARTER_TURN;
    quaternion degreeEuler = quaternion.Euler(y: 90deg, x: 0deg, z: 0deg);
    quaternion initialFromTo = quaternion.FromToRotation(float3(2, 0, 0), float3(0, 3, 0));
    float4x4 initialScale = float4x4.Scale(float3(2, 3, 4));
}

component Results
{
    float3 swizzled;
    float4 built;
    float3 splat;
    float3 scaled;
    int3 halved;
    float3 widened;
    int3 truncated;
    int converted;
    float dotted;
    float length;
    float3 normalized;
    float3 stayed;
    float2 noDirection;
    float4 tooShort;
    quaternion noRotation;
    float3 crossed;
    float3 rotated;
    float3 transformed;
    quaternion fromTo;
    float3 aimed;
    float3 opposite;
    float3 scalePoint;
    float determinant;
    int clamped;
    float3 lerped;
    float sine;
    float angle45;
    float power;
    float3 written;
    float2x2 matrixFromRows;
    float3 columnScaled;
    float3 negated;
    int hashed;
    int hashed2;
    int hashed3;
    int hashed4;
    float4 perlins;   // Noise: each size, with a seed and without
    float4 simplexes;
    float4 cells;
    Color uvColor;
    Color rgbColor;
    Color rgbaColor;
    Color alphaColor;
    Color scalarFirstColor;
    Color vectorMiddleColor;
    Color pairedColor;
    Color integerColor;
    Color integerRgbaColor;
    Color scalarColor;
    Color lerpedColor;      // Math on colors: channel by channel, alpha too
    Color perChannelColor;
    Color clampedColor;
    Color saturatedColor;
    Color brighterColor;
    quaternion vectorEuler;
    quaternion scalarEuler;
    quaternion namedEuler;
    quaternion integerEuler;
    quaternion orderedEuler;
    quaternion reorderedEuler;
    int eulerOrder;
    int namedEulerOrder;
    float4 degreeForms;
    float4 degreeRounding;
    float4 degreeZeros;
    float2 degreeSubnormals;
    float degreeArithmetic;
    float degreeDefault;
    float degreeNamed;
    float degreeInferred;
    float degreeField;
    quaternion degreeScalarEuler;
    quaternion degreeVectorEuler;
    quaternion degreeNamedEuler;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Body, Results);
}

float EulerArgument(mut int order, int digit)
{
    order = order * 10 + digit;
    return digit * 0.1;
}

float DegreeIdentity(float angle = 45deg)
{
    return angle;
}

system Compute(mut Body body, mut Results r)
{
    r.swizzled = body.position.zyx;
    body.flat = body.position.xz;
    r.built = float4(body.position.xy, 7, 8);
    r.splat = float3(2);
    r.scaled = body.position * 2 + 1;
    r.halved = int3(7, -7, 9) / 2;
    r.widened = body.cell.xyx + float3(0.5);
    r.truncated = int3(float3(1.9, -1.9, 1e20));
    r.converted = int(-2.75);

    r.dotted = Math.Dot(body.position, float3(1, 1, 1));
    r.length = Math.Length(float3(3, 4, 12));
    r.normalized = Math.Normalize(float3(0, 5, 0));
    // Nothing to normalize gives zero, never NaN: a move with no key held moves nothing
    r.stayed = body.position + Math.Normalize(float3(body.move.x, 0, body.move.y)) * 5;
    r.noDirection = Math.Normalize(body.move);
    r.tooShort = Math.Normalize(float4(body.move, 1e-20, 0));
    r.noRotation = Math.Normalize(body.unset);
    r.crossed = Math.Cross(float3(1, 0, 0), float3(0, 1, 0));

    quaternion yaw = quaternion.AxisAngle(float3(0, 1, 0), body.angle);
    r.fromTo = quaternion.FromToRotation(to: float3(-3, 2, 1), from: body.position);
    r.aimed = Math.Rotate(r.fromTo, Math.Normalize(body.position));
    r.opposite = Math.Rotate(quaternion.FromToRotation(body.position, -body.position), Math.Normalize(body.position));
    r.scalePoint = Math.Transform(float4x4.Scale(scale: float3(-2, 0, 3)), body.position);
    r.rotated = Math.Rotate(yaw, float3(1, 0, 0));
    body.rotation = Math.Mul(body.rotation, yaw);

    float4x4 m = float4x4.TRS(float3(1, 2, 3), quaternion.identity, float3(2));
    r.transformed = Math.Transform(m, float3(1, 1, 1));
    r.determinant = Math.Determinant(m);
    body.world = m;

    r.clamped = Math.Clamp(5, 0, 1);
    r.lerped = Math.Lerp(float3(0), float3(10, 20, 30), 0.5);
    r.sine = Math.Sin(Math.PI / 2);
    r.angle45 = Math.Degrees(Math.Atan2(1, 1));
    r.power = Math.Pow(2, 10);

    mut float3 w = float3(0);
    w.xz = float2(4, 5);
    w.y += 1;
    w.zx += float2(1, 1);
    r.written = w;

    r.matrixFromRows = float2x2(1, 2,
                                3, 4);
    r.columnScaled = body.basis.c1 * 3;
    r.negated = -body.position;

    r.hashed = Math.Hash(-7);
    r.hashed2 = Math.Hash(body.cell);
    r.hashed3 = Math.Hash(int3(body.cell, 9));
    r.hashed4 = Math.Hash(int4(1, 2, 3, 4));

    float2 at = body.position.xy * 0.37 + 0.11;
    float3 deep = body.position * 0.83;
    r.perlins = float4(Math.Perlin(at), Math.Perlin(at, 7), Math.Perlin(deep), Math.Perlin(deep, -3));
    r.simplexes = float4(Math.Simplex(at), Math.Simplex(at, 7), Math.Simplex(deep), Math.Simplex(deep, -3));
    r.cells = float4(Math.Cellular(at), Math.Cellular(deep, 7));

    // Color flattens scalar and vector arguments into RGB or RGBA channels.
    float2 uv = float2(0.25, 0.5);
    r.uvColor = Color(uv.xy, 0);
    r.rgbColor = Color(RGB);
    r.rgbaColor = Color(float4(RGB, 0.5));
    r.alphaColor = Color(RGB, 0.5);
    r.scalarFirstColor = Color(0.25, RGB.yz);
    r.vectorMiddleColor = Color(0.25, RGB.yz, 0.5);
    r.pairedColor = Color(uv, float2(0.75, 0.5));
    r.integerColor = Color(int2(1, 0), 1);
    r.integerRgbaColor = Color(int4(1, 0, 1, 0));
    r.scalarColor = Color(0.25, 0.5, 0.75, 0.5);

    // Math takes colors as it takes vectors; a number beside one is that number in every channel.
    Color from = Color(0, 0.5, 1, 0);
    Color to = Color(1, 0.5, 0, 1);
    r.lerpedColor = Math.Lerp(from, to, 0.25);
    r.perChannelColor = Math.Lerp(from, to, Color(0, 1, 0.5, 0.5));
    r.clampedColor = Math.Clamp(Color(-1, 0.5, 2, 0.75), 0, Color(1, 0.25, 1, 1));
    r.saturatedColor = Math.Saturate(Color(-1, 0.5, 2, 3));
    r.brighterColor = Math.Max(from, 0.25);

    // Both Euler forms use the same radians and Z-X-Y rotation order.
    r.vectorEuler = quaternion.Euler(float3(0.1, 0.2, 0.3));
    r.scalarEuler = quaternion.Euler(0.1, 0.2, 0.3);
    r.namedEuler = quaternion.Euler(z: 0.3, x: 0.1, y: 0.2);
    r.integerEuler = quaternion.Euler(0, 180, 0);
    mut int order = 0;
    r.orderedEuler = quaternion.Euler(EulerArgument(order, 1), EulerArgument(order, 2), EulerArgument(order, 3));
    r.eulerOrder = order;
    order = 0;
    r.reorderedEuler = quaternion.Euler(z: EulerArgument(order, 3), x: EulerArgument(order, 1), y: EulerArgument(order, 2));
    r.namedEulerOrder = order;

    // deg produces an ordinary binary32 radians value wherever a float goes.
    r.degreeForms = float4(180deg, .5deg, 1e2deg, 1_8_0deg);
    r.degreeRounding = float4(16_777_217deg, 1_2.5_0e+1deg, .5_0e-0_1deg, 3.4028234e38deg);
    r.degreeZeros = float4(0deg, -0deg, 1e-100deg, -1e-100deg);
    r.degreeSubnormals = float2(1e-37deg, 1e-40deg);
    r.degreeArithmetic = -(45deg + 90deg) * 2;
    r.degreeDefault = DegreeIdentity();
    r.degreeNamed = DegreeIdentity(angle: 30deg);
    var inferredAngle = -180deg;
    r.degreeInferred = inferredAngle;
    r.degreeField = body.degreeAngle;
    r.degreeScalarEuler = quaternion.Euler(30deg, 90deg, -45deg);
    r.degreeVectorEuler = quaternion.Euler(Math.Radians(float3(30, 90, -45)));
    r.degreeNamedEuler = quaternion.Euler(z: -45deg, x: 30deg, y: 90deg);
}
