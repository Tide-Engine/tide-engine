scene Main { }

singleton Filled
{
    List<float> values;
    List<float> few;
    int count;
    int ticks;
}

// A step's work is in a function it calls: tidec counts the function's body,
// not just the call
float Heavy(int k)
{
    mut var x = float(k) * 0.001;
    for (var i = 0; i < 400; i++) x = Math.Sin(x * 1.3 + 0.7) + Math.Cos(x * 0.9);
    return x;
}

// Sized in the tick that loops over it: the tick's reckoning, made before
// its systems run, finds the list empty, so the tick is on one thread and the
// loop calls the pool's threads in for itself
system Fill(mut Filled f)
{
    f.ticks++;
    if (f.values.count == 0) f.values.Resize(f.count);
    parallel (var k in f.values) f.values[k] = Heavy(k + f.ticks);
}

// A short list of costly steps, shared out a few to a task
[After(Fill)] system Few(mut Filled f)
{
    if (f.few.count == 0) f.few.Resize(400);
    parallel (var k in f.few) f.few[k] = Heavy(k * 3 + f.ticks);
}
