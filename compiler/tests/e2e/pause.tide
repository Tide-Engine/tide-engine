// A pause menu: views read this machine's devices once per frame, and a modal
// takes them while it's up.

local singleton Pause
{
    bool open;
    int opened;
    int resumed;
    int behind;
}

local scene Main { }

view Hud(mut Pause pause)
{
    if (GUILayout.Button("Behind")) pause.behind += 1;
}

// A function reads the devices explicitly passed by its caller.
bool Opens(Devices devices)
{
    return devices.keyboard.escape.down || devices.gamepad.start.down;
}

view Menu(Devices devices, mut Pause pause)
{
    if (Opens(devices))
    {
        pause.open = true;
        pause.opened += 1;
    }
    GUILayout.Modal(Anchor.MiddleCenter, pause.open)
    {
        GUILayout.Label("Paused");
        if (GUILayout.Button("Resume"))
        {
            pause.open = false;
            pause.resumed += 1;
        }
    }
}
