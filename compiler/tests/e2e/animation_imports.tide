Animation LookupClip(AnimationCatalog clips, string name) { clips.TryGetByName(name, out var result); return result; }
Animation ClipAt(AnimationCatalog clips, int index) { clips.TryGetAt(index, out var result); return result; }

const string runPath = "animation_imports/movement/run.gltf";
asset AnimationCatalog movement = ["animation_imports/movement/walk.gltf", runPath, runPath];
asset AnimationCatalog globbed = "animation_imports/movement/*.gltf";
asset AnimationCatalog mixed = ["animation_imports/movement/*.gltf", runPath];
asset AnimationCatalog names = "animation_imports/names.gltf";
asset SkinnedMesh<Vertex3> model = "animation_imports/names.gltf";
asset Animation single = "animation_imports/single.gltf";
[Name("Root|Run")]
asset Animation run = runPath;

struct Required {
    [Name("Root|Run")] Animation run;
    [Name("Right Hand")] Bone hand;
}
asset SkinnedMesh<Vertex3, Required> required = "animation_imports/names.gltf";

singleton Probe {
    AnimationCatalog saved = movement;
    Animation selected = run;
    Pose pose;
    int checks;
    int passed;
    int ticks;
}
scene Main { }
void Expect(mut Probe p, bool yes) { p.checks++; if (yes) p.passed++; }
Animation ThroughHelper(AnimationCatalog value) { return LookupClip(value, "Root|Run"); }

system Check(mut Probe p) {
    if (p.ticks == 0) {
        var retained = movement;
        Expect(p, movement.count == 4 && mixed.count == 4 && globbed.count == 4);
        Expect(p, retained.rootWalk.name == "Root|Walk" && retained.rootRun.name == "Root|Run");
        Expect(p, movement.walkRoot0TargetingPose.name == "Root|0.Targeting Pose");
        Expect(p, movement.runRoot0TargetingPose.name == "Root|0.Targeting Pose");
        Expect(p, !movement.TryGetByName("Root|0.Targeting Pose", out _));
        Expect(p, LookupClip(movement, "Root|Run").name == "Root|Run" && !movement.TryGetByName("rootRun", out _));
        Expect(p, ClipAt(movement, 0).name == "Root|0.Targeting Pose" && ClipAt(movement, 3).name == "Root|Run");
        Expect(p, !movement.TryGetAt(-1, out _) && !movement.TryGetAt(4, out _));
        Expect(p, ThroughHelper(movement).name == "Root|Run");
        Expect(p, single.name == "Root|Run" && run.name == "Root|Run" && run.duration == 1);
        Expect(p, names.rootRun.name == "Root|Run" && names.root0TargetingPose.name == "Root|0.Targeting Pose");
        Expect(p, names._123Start.name == "123 start" && names._for.name == "for" && names._count.name == "count");
        Expect(p, names._tide_private.name == "tide_private");
        Expect(p, names.badName___7.name == "bad name" && names.badName_8.name == "bad-name");
        Expect(p, names.badName_7.name == "badName_7" && names.badName__7.name == "badName__7");
        Expect(p, names.same_11.name == "Same" && names.same_12.name == "Same" && !names.TryGetByName("Same", out _));
        Expect(p, names._.name == "!!!" && ClipAt(names, 13).name == "" && !names.TryGetByName("", out _));
        Expect(p, model.animations.rootRun.Sample(0.5)[model.skeleton.bones.rightHand].position.x == -12
            && required.defaultPose[required.skeleton.bones.hand].scale.x == 1);
        var escaped = model.animations;
        Expect(p, escaped.rootRun.name == "Root|Run" && !escaped.TryGetByName("Same", out _) && escaped.count == 14);
        SkinnedMesh<Vertex3, Required> converted = model;
        Expect(p, converted.animations.run.name == "Root|Run");
        p.pose = run.Sample(0.5);
    }
    Expect(p, p.saved.count == 4 && LookupClip(p.saved, "Root|Run").name == "Root|Run" && p.selected.name == "Root|Run");
    p.pose.Sample(p.selected, float(p.ticks % 4) * 0.25, Playback.Loop);
    p.ticks++;
}
