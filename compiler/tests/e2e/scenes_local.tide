// A program that starts in a local scene, a menu, before there's any match.

local scene Main { }

local scene Menu
{
    int page;
}

component Button
{
    int id;
}

component MenuStyle { string caption; int[2] values; }

local singleton Frames
{
    int count;
    int opened;
}

local event(Spawned) Open(with Main, mut Frames frames)
{
    frames.opened += 1;
    Scene.Load(Menu { page = 1 }, MenuStyle { caption = "local-root", values = [4, 5] });
}

local event(Spawned) Buttons(with Menu, local MenuStyle style)
{
    Debug.Assert(style.caption == "local-root" && style.values[1] == 5);
    local Spawn(Button { id = 1 });
    local Spawn(Button { id = 2 });
}

view Count(mut Frames frames)
{
    frames.count += 1;
}

view Close(with Menu, Frames frames)
{
    if (frames.count == 2) Scene.Unload(this);
}

// Main leaves too, and with no scene left, it loads again.
view Leave(with Main, Frames frames)
{
    if (frames.count == 3) Scene.Unload(this);
}
