asset List<byte> constantSource = "worker_constants.bin";
const List<int> FROM_ASSET = DecodeConstants(constantSource);
const List<int> NUMBERS = MakeNumbers(4);
struct Segment { float2 start; float2 end; float width; int index; }
const List<Segment> SEGMENTS = MakeSegments();
List<int> DecodeConstants(List<byte> bytes)
{
    mut List<int> result = [];
    for (var i = 0; i < bytes.count; i++) result.Add(int(bytes[i]));
    return result;
}
List<int> MakeNumbers(int n)
{
    mut List<int> result = [];
    for (var i = 0; i < n; i++) result.Add(i + 1);
    return result;
}
List<Segment> MakeSegments()
{
    return [Segment { start = float2(1, 2), end = float2(3, 4), width = 5, index = 6 }];
}
int ReadConstants(int i)
{
    var segment = SEGMENTS[0];
    return FROM_ASSET[i % FROM_ASSET.count] + NUMBERS[i % NUMBERS.count]
        + int(segment.start.x + segment.start.y + segment.end.x + segment.end.y + segment.width) + segment.index;
}
local worker bool ConstantValues()
{
    for (var i = 0; i < 1000; i++)
        if (ReadConstants(i) != i % 256 + i % 4 + 22) return false;
    mut List<int> output = [];
    output.Resize(4096);
    parallel (var i in output) output[i] = ReadConstants(i);
    for (var i = 0; i < output.count; i++)
        if (output[i] != i % 256 + i % 4 + 22) return false;
    return true;
}

struct Payload
{
    List<List<string>> nested;
    Map<string, List<int>> groups;
    int[2] names;
    int? choice;
}

enum WorkerError { Empty }

local singleton Results
{
    Payload source;
    Payload result;
    string message;
    int[2] names;
    string? optional;
    bool good;
    bool started;
    bool done;
    int calls;
}

int Next(mut Results results) { results.calls++; return results.calls; }
local worker int Pair(int first, int second) { return first * 10 + second; }
local worker Payload Echo(Payload input) { return input; }
local worker string EchoText(string value) { return value + "!"; }
local worker int[2] EchoArray(int[2] value) { return value; }
local worker string? EchoOptional(string? value) { return value; }
local worker string MayFail(string value) fails WorkerError
{
    if (value.length == 0) fail WorkerError.Empty;
    return value + " okay";
}
local worker void NoResult(int count)
{
    for (var i = 0; i < count; i++) { }
}

local worker bool CaptureLists()
{
    mut List<int> heights = [];
    heights.Resize(4096);
    for (var i = 0; i < heights.count; i++) heights[i] = i + 7;
    List<List<int>> nested = [[11, 13]];
    mut List<int> vertices = [];
    vertices.Resize(heights.count);
    parallel (var k in vertices)
    {
        mut int sum = 0;
        for (var n = 0; n < 512; n++) sum += heights[k] + nested[0][k % 2];
        vertices[k] = sum;
    }
    heights[0] = 100;
    for (var i = 0; i < vertices.count; i++)
        if (vertices[i] != (i + 7 + 11 + (i % 2) * 2) * 512) return false;
    parallel (var k in vertices) vertices[k] = heights[k] + nested[0][k % 2];
    return vertices[0] == 111 && vertices[4095] == 4115 && nested[0][0] == 11;
}

async void Work(mut Results results)
{
    results.result = await Echo(results.source);
    results.message = await EchoText(results.source.nested[0][0]);
    results.names = await EchoArray(results.source.names);
    results.optional = await EchoOptional(results.message);
    var failure = await MayFail("") ?? "failed";
    var success = await MayFail("value") ?? "bad";
    await NoResult(2);
    var captured = await CaptureLists();
    var constants = await ConstantValues();
    results.calls = 0;
    var ordered = await Pair(Next(results), Next(results));
    var orderedOnce = results.calls == 2;
    results.calls = 0;
    var named = await Pair(second: Next(results), first: Next(results));
    var nested = await Pair(3, await Pair(4, 5));
    results.source.nested[0][0] = "changed";
    results.good = results.result.nested[0][0] == "a"
        && results.result.nested[1][0] == "c"
        && results.result.groups["first"][1] == 5
        && results.result.names[1] == 9
        && (results.result.choice ?? 0) == 7
        && results.message == "a!"
        && results.names[0] == 8
        && (results.optional ?? "") == "a!"
        && failure == "failed" && captured && constants
        && success == "value okay"
        && ordered == 12 && orderedOnce && named == 21 && results.calls == 2 && nested == 75;
    results.done = true;
}

view Start(mut Results results)
{
    if (results.started) return;
    results.started = true;
    results.source = Payload {
        nested = [["a", "b"], ["c"]],
        names = [8, 9],
        choice = 7
    };
    results.source.groups["first"] = [4, 5];
    Work(results);
}

scene Main;
