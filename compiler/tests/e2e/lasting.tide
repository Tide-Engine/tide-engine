// Lasting tags: Sleeping is added and removed, but [Lasting] keeps it out of
// the row's presence bits, so its Add and Remove move the entity to an
// archetype of its own. Drowsy, an ordinary tag that's added and removed, is
// sparse and moves nobody.

component Body
{
    int id;
    int steps;
    int naps;
}

[Lasting]
component Sleeping { }

component Drowsy { }

scene Main { }

event(Spawned) Setup(with Main)
{
    for (var i = 0; i < 6; i++) Spawn(Body { id = i });
}

// Awake bodies step; on tick 1 the even ones fall asleep and the odd ones get drowsy
system Step(mut Body body, Time time, without Sleeping)
{
    body.steps += 1;
    if (time.tick != 1) return;
    if (body.id % 2 == 0) this.Add(Sleeping);
    else this.Add(Drowsy);
}

// Sleepers count their naps and wake on tick 3
system Nap(mut Body body, Time time, with Sleeping)
{
    body.naps += 1;
    if (time.tick == 3) this.Remove(Sleeping);
}

system Rouse(Time time, with Drowsy)
{
    if (time.tick == 3) this.Remove(Drowsy);
}
