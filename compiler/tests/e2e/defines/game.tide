// A file's own symbols, the build's (--define, DEBUG), and its packages'.
#define LOCAL
#define DROPPED // One that's taken back
#undef DROPPED
#undef FAST // The build defines it; this file says otherwise
  #define SPACED

#if LOCAL && SPACED && !DROPPED
const int OWN = 1;
#else
const int OWN = 0;
#endif

#if FAST
const int FAST_HERE = 1;
#else
const int FAST_HERE = 0;
#endif

#if WIDE
const int FROM_BUILD = 1;
#else
const int FROM_BUILD = 0;
#endif

#if NEVER_DEFINED || local
const int UNKNOWN = 1;
#else
const int UNKNOWN = 0; // A symbol nothing defines is false, and names are told apart by case
#endif

#if DEBUG
const int DEBUGGING = 1;
#else
const int DEBUGGING = 0;
#endif

#if PACKAGE_EXTRA
const int WITH_EXTRA = Extra.BONUS;
#else
const int WITH_EXTRA = 0;
#endif

#if PACKAGE_BOX2D
using Box2D; // A package the game doesn't build with: nothing here is read
const int WITH_BOX2D = 1;
#else
const int WITH_BOX2D = 0;
#endif

enum Army
{
    Small,
    Large,
    Huge = 9,
}

// What code reads of them: defined(NAME), and define(NAME, default) with the value the build gave
const bool PREPASS = !defined(NO_PREPASS);
const bool SAYS_FAST = defined(FAST);       // This file's #undef
const bool SAYS_LOCAL = defined(LOCAL);     // ...and its #define
const bool SAYS_WIDE = defined(WIDE);       // The build's, with no value
const bool SAYS_SIDE = defined(SIDE);       // The build's, with one
const bool SAYS_NEW = defined(TIDE_0_1_OR_NEWER);
const int SIDE_COUNT = define(SIDE, 500);   // --define SIDE=50
const int UNSET = define(UNSET_SIDE, -12);  // Not given: its default
const long BIG = define(BIG, 1L);           // --define BIG=-9223372036854775808
const byte SMALL = define(SMALL, 3);        // --define SMALL=255
const float SCALE = define(SCALE, 1);       // --define SCALE=-2.5, read as the float this is
const double FAR = define(FAR, 0.5d);       // --define FAR=0.1
const string TITLE = define(TITLE, "untitled"); // --define TITLE=Two "words", a \ and a tab
const string EMPTY = define(EMPTY, "x");    // --define EMPTY=
const bool QUICK = define(WIDE, false);     // A symbol with no value read as a bool is true
const bool SLOW = define(SLOW, true);       // --define SLOW=false
const Army ARMY = define(ARMY, Army.Small); // --define ARMY=Huge

singleton Picked
{
    bool prepass = PREPASS;
    bool saysFast = SAYS_FAST;
    bool saysLocal = SAYS_LOCAL;
    bool saysWide = SAYS_WIDE;
    bool saysSide = SAYS_SIDE;
    bool saysNew = SAYS_NEW;
    int sideCount = SIDE_COUNT;
    int unset = UNSET;
    long big = BIG;
    byte tiny = SMALL;
    float scale = SCALE;
    double distance = FAR;
    string title = TITLE;
    string empty = EMPTY;
    bool quick = QUICK;
    bool slow = SLOW;
    Army army = ARMY;
    int[2] sizes = [define(SIDE, 0), define(UNSET_SIDE, 2)];
    int inCode;
    int own = OWN;
    int fastHere = FAST_HERE;
    int fromBuild = FROM_BUILD;
    int unknown = UNKNOWN;
    int debugging = DEBUGGING;
    int withExtra = WITH_EXTRA;
    int withBox2D = WITH_BOX2D;
    int fastThere = Extra.FAST_THERE;
    int localThere = Extra.LOCAL_THERE;
    bool localInExtra = Extra.SAYS_LOCAL;
    int sideInExtra = Extra.SIDE_THERE;
}

scene Main { }

// In code that runs: the same constants
system Count(mut Picked picked)
{
    if (defined(SIDE) && !defined(NEVER_DEFINED)) picked.inCode = define(SIDE, 1) * 2 + define(UNSET_SIDE, 0);
}
