// A local worker call's `priority:`: which of the calls that wait for a thread starts first. The host gives one
// thread, which takes one calculation at a time, and counts the order they start in (Ran).
local singleton State
{
    int phase;              // What the host asks for next: Start does it once and sets it back to 0
    int done;               // Calls whose results came
    int sum;                // ...and their numbers, added
    LocalTask<int> kept;    // Handles: a call that gives one says its priority too
    LocalTask<int> other;
    LocalTask<int> last;
    bool cancelKept;
    WorkerPriority level;   // Normal, as nothing set it
}

extern void Ran(int id);

local worker int Job(int id)
{
    Ran(id);
    return id;
}

// Shares its name with nothing: a function that isn't a worker keeps a `priority` parameter of its own
int Weigh(int value, int priority = 1)
{
    return value * priority;
}

WorkerPriority Level(int id)
{
    return id % 2 == 0 ? WorkerPriority.Urgent : WorkerPriority.Background;
}

async void Run(mut State state, int id, WorkerPriority priority)
{
    var value = await Job(id, priority: priority);
    state.done += 1;
    state.sum += value;
}

// A priority worked out by a function, and a call with its argument by name before it
async void Leveled(mut State state, int number)
{
    var value = await Job(id: number, priority: Level(number));
    state.done += 1;
    state.sum += value;
}

async void Plain(mut State state, int id)
{
    var value = await Job(id);
    state.done += 1;
    state.sum += value;
}

async void Read(mut State state, LocalTask<int> job)
{
    var value = await job;
    state.done += 1;
    state.sum += value;
}

view Start(mut State state)
{
    var phase = state.phase;
    state.phase = 0;
    if (phase == 1)
    {
        // The first is the thread's at once. The rest wait: the urgent ones start first, then the normal ones,
        // then the background ones, each level in the order it came
        Plain(state, 1);
        Run(state, 2, WorkerPriority.Background);
        Run(state, 3, state.level);
        Run(state, 4, WorkerPriority.Urgent);
        Run(state, 5, WorkerPriority.Background);
        Plain(state, 6);
        Run(state, 7, WorkerPriority.Urgent);
    }
    if (phase == 2)
    {
        // Under a stream of urgent calls, the normal ones and the background one still get their turns
        Plain(state, 100);
        Run(state, 101, WorkerPriority.Background);
        Plain(state, 102);
        Plain(state, 103);
        for (var i = 0; i < 40; i++) Run(state, 200 + i, WorkerPriority.Urgent);
    }
    if (phase == 3)
    {
        // Handles: the priority is the call's, whatever is done with what it gives
        state.kept = Job(1);
        state.other = Job(2, priority: WorkerPriority.Background);
        state.last = Job(3, priority: WorkerPriority.Urgent);
        var unsaid = Job(4);
        Read(state, state.kept);
        Read(state, state.other);
        Read(state, state.last);
        Read(state, unsaid);
    }
    if (phase == 4)
    {
        // A queued call that's cancelled never starts, whatever its priority; the ones after it do
        Plain(state, 1);
        state.kept = Job(2, priority: WorkerPriority.Urgent);
        state.other = Job(3, priority: WorkerPriority.Background);
        Read(state, state.kept);
        Read(state, state.other);
        Run(state, 4, WorkerPriority.Background);
    }
    if (phase == 5)
    {
        Plain(state, 1);
        Leveled(state, 3);
        Leveled(state, 4);
        Plain(state, Weigh(5, priority: 2));
    }
    if (phase == 6)
    {
        // More than the host's limit lets wait at once (4, of each priority; 2 of background ones): the
        // background calls past theirs wait for room, and keep no other call waiting for it
        Plain(state, 1);
        for (var i = 0; i < 5; i++) Run(state, 10 + i, WorkerPriority.Background);
        Run(state, 20, WorkerPriority.Urgent);
        Run(state, 21, WorkerPriority.Urgent);
        Run(state, 22, WorkerPriority.Urgent);
        Plain(state, 30);
    }
    if (state.cancelKept)
    {
        state.kept.Cancel();
        state.cancelKept = false;
    }
}

scene Main;
