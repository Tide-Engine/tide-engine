enum Choice { First = 1, Second = 2 }
struct Detail { string note; [Clamp(-2, 2)] int count; }
component Name { string value = "before"; }
singleton Seen
{
    int calls;
    PlayerID sender;
    float rating;
    Choice choice;
    float2 aim;
    string note;
    int count;
    string announcement;
    string[2] tagged;
    PlayerID claimed;
    Entity other;
}
local singleton UI
{
    bool send;
    bool announce;
    bool handler;
    bool tag;
    string text = "Alice";
    Entity target;
}
local event Submit { }
scene Main { }
event(Spawned) Setup(with Main)
{
    Spawn(Name, Owner { player = PlayerID(0) });
    Spawn(Name, Owner { player = PlayerID(1) });
}
command(string name, [Clamp(0, 10)] float rating = 3, Choice choice = Choice.First, float2 aim = default,
    Detail detail = default, PlayerID claimed = default, Entity other = default)
    Rename(Owner owner, mut Name mine, mut Seen seen, PlayerID sender)
{
    if (sender != owner.player) return;
    if (name.length == 0) return;
    mine.value = name;
    seen.calls++;
    seen.sender = sender;
    seen.rating = rating;
    seen.choice = choice;
    seen.aim = aim;
    seen.note = detail.note;
    seen.count = detail.count;
    seen.claimed = claimed;
    seen.other = other;
}
command(string message) Announce(mut Seen seen, PlayerID sender)
{
    KeepAnnouncement(message, seen);
    seen.sender = sender;
}
command(string[2] words) Tag(PlayerID sender, mut Seen seen)
{
    _ = sender;
    seen.tagged = words;
}
void KeepAnnouncement(string message, mut Seen seen) { seen.announcement = message; }
local event(Submit) SubmitFromHandler(UI ui)
{
    ui.target.Rename(ui.text, detail: Detail { note = "handler", count = 7 });
}
view SubmitFromView(mut UI ui)
{
    if (ui.send)
    {
        ui.target.Rename(ui.text, detail: Detail { note = "view", count = -7 }, claimed: PlayerID(7), other: ui.target);
        ui.send = false;
    }
    if (ui.announce)
    {
        Announce(ui.text);
        ui.announce = false;
    }
    if (ui.tag)
    {
        Tag([ui.text, "tag"]);
        ui.tag = false;
    }
    if (ui.handler)
    {
        Send(Submit);
        ui.handler = false;
    }
}
