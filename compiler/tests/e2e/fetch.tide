settings { appId = "tests.tide.fetch"; }

// await Web.Fetch(url), against a server on this machine (fetch.mjs, with
// platform/tests/fetch_routes.mjs: a path for each case): what each gives,
// read by the host (fetch_check.h), natively and in a page.

local scene Main { }

local singleton Fetches
{
    string origin; // http://127.0.0.1:<port>, which the host sets before the first frame
    bool started;
    bool done;
    List<byte> hello; // /hello, as it is
    bool missing;     // /missing is NotFound
    bool failed;      // /error (500) is Failed
    bool invalid;     // A URL that isn't http:// or https:// is InvalidPath
    bool refused;     // A port nobody listens on is Failed
    int chunked;      // /chunked's bytes, which come in chunks
    long chunkedSum;
    int moved;        // /moved's bytes: through three redirects to /hello
    bool loop;        // /loop redirects to itself: Failed
    bool big;         // /big says it's more than the limit: Failed
    bool endless;     // /endless goes on past the limit: Failed
    int empty;        // /empty (204): no bytes, and no error
    int nothing;      // /nothing: a body of 0 bytes
    int requests;     // Web.Request's cases, a bit each that went as it should (see Requests)
    int frames;       // Frames from the first fetch to the last
}

async void Run(mut Fetches f)
{
    LocalTask<List<byte> fails IOError> hello = Web.Fetch(f.origin + "/hello");
    f.hello = await hello ?? [];
    f.hello = await hello ?? [];
    f.missing = await Web.Fetch(f.origin + "/missing") is IOError.NotFound;
    f.failed = await Web.Fetch(f.origin + "/error") is IOError.Failed;
    f.invalid = await Web.Fetch("ftp://example.com/file") is IOError.InvalidPath;
    f.refused = await Web.Fetch("http://127.0.0.1:1/nothing") is IOError.Failed;
    var chunked = await Web.Fetch(f.origin + "/chunked") ?? [];
    f.chunked = chunked.count;
    foreach (var b in chunked) f.chunkedSum += b;
    var moved = await Web.Fetch(f.origin + "/moved") ?? [];
    f.moved = moved.count;
    f.loop = await Web.Fetch(f.origin + "/loop") is IOError.Failed;
    f.big = await Web.Fetch(f.origin + "/big") is IOError.Failed;
    f.endless = await Web.Fetch(f.origin + "/endless") is IOError.Failed;
    var empty = await Web.Fetch(f.origin + "/empty") ?? [1, 1];
    f.empty = empty.count;
    var nothing = await Web.Fetch(f.origin + "/nothing") ?? [1, 1];
    f.nothing = nothing.count;
    f.requests = await Requests(f.origin);
    f.done = true;
}

// Whether /echo's answer says the request had this method (by its length)
// and this many bytes of X-Tide header, no X-Evil header, and `body` bytes
// of body after them, which are 1, 2, 3 and on.
bool Echoed(WebResponse answer, int status, int method, int header, int body)
{
    if (answer.status != status || answer.body.count != 3 + body) return false;
    if (answer.body[0] != method || answer.body[1] != header || answer.body[2] != 0) return false;
    for (var i = 0; i < body; i++)
    {
        if (answer.body[3 + i] != i + 1) return false;
    }
    return true;
}

// await request.Send(), against /echo: a bit for each case that's right.
async int Requests(string origin)
{
    mut var right = 0;
    var echo = origin + "/echo";
    // A POST with a header and a body, built in one line
    LocalTask<WebResponse fails IOError> sending = Web.Request(echo).SetMethod("POST").SetHeader("X-Tide", "hello").SetBody([1, 2, 3]).Send();
    var posted = await sending;
    var postedAgain = await sending;
    if (posted is WebResponse a && Echoed(a, 200, 4, 5, 3)
        && postedAgain is WebResponse againPosted && Echoed(againPosted, 200, 4, 5, 3)) right |= 1;
    // A request with nothing set is a GET
    var got = await Web.Request(echo).Send();
    if (got is WebResponse b && Echoed(b, 200, 3, 0, 0)) right |= 2;
    // An answer of another status is an answer, with its body
    var conflict = await Web.Request(echo + "?status=409").SetMethod("PUT").SetBody([1, 2]).Send();
    if (conflict is WebResponse c && Echoed(c, 409, 3, 0, 2)) right |= 4;
    var missing = await Web.Request(origin + "/missing").Send();
    if (missing is WebResponse d && d.status == 404) right |= 8;
    // A request kept in a variable across a wait, changed a field and a call at a time
    mut var request = Web.Request(echo);
    request.method = "DELETE";
    request = request.SetHeader("X-Tide", "ab");
    var first = await request.Send();
    request = request.SetMethod("patch").SetBody([1, 2, 3, 4]);
    var second = await request.Send();
    if (first is WebResponse e && Echoed(e, 200, 6, 2, 0) && second is WebResponse g && Echoed(g, 200, 5, 2, 4)) right |= 16;
    // HEAD has no body, whatever the server would send
    var head = await Web.Request(echo).SetMethod("HEAD").Send();
    if (head is WebResponse h && h.status == 200 && h.body.count == 0) right |= 32;
    // Redirects, as a page's fetch follows them: a 303 becomes a GET, a 307 is the request again
    var seeOther = await Web.Request(origin + "/see-other").SetMethod("POST").SetBody([1, 2, 3]).Send();
    if (seeOther is WebResponse j && Echoed(j, 200, 3, 0, 0)) right |= 64;
    var again = await Web.Request(origin + "/again").SetMethod("POST").SetBody([1, 2, 3]).Send();
    if (again is WebResponse k && Echoed(k, 200, 4, 0, 3)) right |= 128;
    // A value with a line break in it is one header, not two
    var broken = await Web.Request(echo).SetHeader("X-Tide", "a\nX-Evil: 1").Send();
    if (broken is WebResponse m && Echoed(m, 200, 3, 11, 0)) right |= 256;
    // The connection's own headers are the sender's to say
    var length = await Web.Request(echo).SetMethod("POST").SetHeader("Content-Length", "999").SetBody([1, 2, 3]).Send();
    if (length is WebResponse n && Echoed(n, 200, 4, 0, 3)) right |= 512;
    // What can't be sent as it's written, and what gets no answer
    if (await Web.Request(echo).SetMethod("GE T").Send() is IOError.InvalidData) right |= 1024;
    if (await Web.Request(echo).SetMethod("TRACE").Send() is IOError.InvalidData) right |= 2048;
    if (await Web.Request(echo).SetHeader("Bad Name", "x").Send() is IOError.InvalidData) right |= 4096;
    if (await Web.Request("ftp://example.com/file").Send() is IOError.InvalidPath) right |= 8192;
    if (await Web.Request("http://127.0.0.1:1/nothing").SetMethod("POST").Send() is IOError.Failed) right |= 16384;
    // A time limit: a server that takes the request and never answers is TimedOut once it's past
    if (await Web.Request(origin + "/silent").SetTimeout(0.3).Send() is IOError.TimedOut) right |= 32768;
    // ...and so is one that stops in the middle of its answer's body
    if (await Web.Request(origin + "/stall").SetTimeout(0.3).Send() is IOError.TimedOut) right |= 65536;
    // An answer that comes within the limit is the answer
    var slow = await Web.Request(origin + "/slow").SetTimeout(30).Send();
    if (slow is WebResponse s && s.status == 200 && s.body.count == 11) right |= 131072;
    // 0 or less is no limit
    var unlimited = await Web.Request(origin + "/slow").SetTimeout(-1).Send();
    if (unlimited is WebResponse u && u.status == 200 && u.body.count == 11) right |= 262144;
    // The limit stays through the calls after it, and a field sets it too
    mut var limited = Web.Request(origin + "/silent").SetTimeout(30).SetMethod("POST").SetHeader("X-Tide", "x").SetBody([1]);
    var kept = limited.timeout == 30;
    limited.timeout = 0.3;
    if (kept && await limited.Send() is IOError.TimedOut) right |= 524288;
    // What timed out left nothing behind: the next request is answered
    var after = await Web.Request(echo).SetTimeout(30).Send();
    if (after is WebResponse v && Echoed(v, 200, 3, 0, 0)) right |= 1048576;
    return right;
}

// The host says where the server is, so the fetching starts once it has
view Start(mut Fetches f)
{
    if (f.started || f.origin == "") return;
    f.started = true;
    Run(f);
}

view Count(mut Fetches f)
{
    if (f.started && !f.done) f.frames += 1;
}
