// Enums and switch: named values, and switches over them and over ints.

enum Phase
{
    Warmup,
    Playing = 5,
    Over,
}

enum Weapon { Sword, Bow }
enum Aliases { First = -10, Same = -10, Last = 50, Count = 100 }
enum Direction { North, East, South, West }
const int DIRECTIONS = Direction.Count();
const int ALIASES = Aliases.Count();
const int FORWARD_COUNT = Later.Count();
enum Later { A = Direction.Count(), B }

struct Loadout
{
    Weapon primary = Weapon.Bow;
}

singleton Match
{
    Phase phase; // Warmup: 0, like every field without a default
    int ticksInPhase;
    int score;
    int phaseValue;
    Loadout loadout;
}

// A value from another machine that isn't one of Weapon's members becomes the default.
input Controls
{
    Weapon weapon = Weapon.Sword;
}

// Stored as a byte and as a ushort: a number converts to what fits them.
enum Voxel : byte { Air, Stone, Water }
enum Tile : ushort { Grass, Rock }

// Constants: an enum from its number, and a number through an enum.
const Weapon SPARE = Weapon(1);
const int WRAPPED = int(Voxel(258)); // Its low 8 bits: 2

// An enum from its number, Weapon(1), as int(weapon) is its number.
singleton Picks
{
    Weapon rolled;
    Weapon spare = SPARE;
    Weapon small;
    Phase odd;      // A number none of Phase's members has, kept as it is
    int oddValue;
    int oddCase;
    Voxel voxel;
    Voxel wrapped;
    Tile tile;
    int wrappedConstant;
    int cases;
    int members = Phase.Count();
    int aliases = ALIASES;
    int forwardCount = FORWARD_COUNT;
    int[Direction.Count()] counts;
    Direction direction;
    int countedCase;
    int builtinCount;
    string shown;
}

scene Main { }

Weapon WeaponNumbered(int number) { return Weapon(number); }

system Pick(mut Picks picks, Time time)
{
    picks.direction = Direction((int(picks.direction) + 1) % DIRECTIONS);
    picks.counts[Direction.Count() - 1] = Voxel.Count() + Tile.Count();
    picks.builtinCount = Prediction.Count();
    switch (Direction.Count())
    {
        case Direction.Count():
            picks.countedCase = 1;
            break;
        default:
            break;
    }
    picks.rolled = WeaponNumbered(time.tick % 2);
    byte one = 1;
    picks.small = Weapon(one); // A byte is an int where one goes
    picks.odd = Phase(3);
    picks.oddValue = int(picks.odd);
    switch (picks.odd) // No member's case, so the default's
    {
        case Phase.Warmup:
        case Phase.Playing:
        case Phase.Over:
            picks.oddCase = 1;
            break;
        default:
            picks.oddCase = 2;
            break;
    }
    picks.voxel = Voxel(time.tick + 1);
    picks.wrapped = Voxel(time.tick + 258); // As byte(x): the low 8 bits
    picks.tile = Tile(65537 - time.tick);   // And a ushort's low 16
    picks.wrappedConstant = WRAPPED;
    switch (Weapon(time.tick % 2))
    {
        case SPARE:
            picks.cases += 10;
            break;
        case Weapon(0):
            picks.cases += 1;
            break;
    }
    picks.shown = $"{Phase(5)} {picks.odd} {Voxel(1)} {Voxel(-1)}";
}

system Advance(mut Match match, Time time)
{
    match.ticksInPhase += 1;
    switch (match.phase)
    {
        case Phase.Warmup:
            if (match.ticksInPhase >= 2)
            {
                match.phase = Phase.Playing;
                match.ticksInPhase = 0;
            }
            break;
        case Phase.Playing:
            match.score += Points(time.tick);
            if (match.ticksInPhase >= 3) match.phase = Phase.Over;
            break;
        default:
            break;
    }
    match.phaseValue = int(match.phase);
}

system Arm(Controls controls, mut Match match)
{
    if (controls.weapon != match.loadout.primary) match.loadout.primary = controls.weapon;
}

// Every section returns, and there's a default, so the function always returns.
int Points(int tick)
{
    switch (tick % 3)
    {
        case 0:
            return 10;
        case 1:
        case -1:
            return 1;
        default:
            return 0;
    }
}
