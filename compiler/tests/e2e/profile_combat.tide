// A system in a namespace: a profile names it with it, Combat.Hit.
namespace Combat;

singleton Tally
{
    int hits;
}

system Hit(mut Tally tally)
{
    tally.hits += 1;
}

// Keep the complete qualified name even when the panel abbreviates it.
view PresentationWithANameLongerThanTheProfilerPanelCanDisplay(Tally tally)
{
    Debug.Assert(tally.hits >= 0);
}
