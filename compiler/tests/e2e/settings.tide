// The engine's settings for the game, which can name constants. A game's
// blocks are one list of what it sets: two here, and one in settings_more.tide.

const int RATE = 20;
const string NAME = "Tide \"settings\"";
const bool SHOW_STATS = true;

settings
{
    title = NAME;
    tickRate = RATE + 10;
}

settings { stats = SHOW_STATS; }

scene Main { }
