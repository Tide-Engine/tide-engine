// Match tasks that await the server's store in a game that hides state (State
// visibility): the server's run of a task has its answer, and what it changes
// reaches the players through the state they may have
// (tests/e2e/storage_await_hidden_test.c). A player's own run of the task
// never gets one, as players' frames carry no answers here.

settings { maxPlayers = 2; }

scene Main;

event(Spawned) Setup(with Main) { Spawn(Visibility); }

singleton Vault
{
    int found;    // Awaited loads that found their key
    int missing;  // ...that found nothing
    int sum;      // The bytes the found ones gave, added up
    int listed;   // Keys an awaited listing gave
    int refused;  // A key the store refuses: IOError.InvalidPath, in the tick it was awaited
}

input Controls { float2 move; }

List<byte> Bytes(int start, int count)
{
    mut List<byte> made = [];
    for (var i = 0; i < count; i++) made.Add(byte(start + i));
    return made;
}

async void Take(mut Vault vault, string key)
{
    var got = await Storage.Load(key);
    if (got is List<byte> bytes)
    {
        vault.found += 1;
        foreach (var b in bytes) vault.sum += b;
    }
    else if (got is IOError.NotFound) vault.missing += 1;
}

async void Count(mut Vault vault)
{
    if (await Storage.List("hidden/") is StorageKeys keys) vault.listed += keys.keys.count;
    if (await Storage.Load("") is IOError.InvalidPath) vault.refused += 1;
}

system Work(mut Vault vault, Time time)
{
    if (time.tick == 2)
    {
        Storage.Save("hidden/a", Bytes(1, 3));
        Storage.Save("hidden/b", Bytes(10, 2));
    }
    if (time.tick == 4)
    {
        Take(vault, "hidden/a");
        Take(vault, "hidden/b");
        Take(vault, "hidden/none");
        Count(vault);
    }
}
