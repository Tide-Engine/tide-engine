// local_events_same.tide without its events for local code, and without the
// local handlers that hear them: the same match (local_events_same.h).

component Ball
{
    float2 position;
    float2 velocity = float2(3, 2);
    int bounces;
}

component Player { }

singleton Field
{
    float2 size = float2(8, 5);
    int bounces;
}

input Controls
{
    float push;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Ball { position = float2(1, 1) });
    Spawn(Ball { position = float2(4, 3), velocity = float2(-2, 3) });
}

event(PlayerJoined joined) AddPlayer()
{
    Spawn(Player, Owner { player = joined.player });
}

system Push(Controls controls, mut Field field, with Player)
{
    if (controls.push == 0) return;
    field.size.x += controls.push * 0.01;
}

system Roll(mut Ball ball, mut Field field, Time time)
{
    ball.position += ball.velocity * time.dt;
    if (ball.position.x < 0 || ball.position.x > field.size.x)
    {
        ball.velocity.x = -ball.velocity.x;
        ball.bounces += 1;
        field.bounces += 1;
    }
    if (ball.position.y < 0 || ball.position.y > field.size.y)
    {
        ball.velocity.y = -ball.velocity.y;
        ball.bounces += 1;
        field.bounces += 1;
    }
}
