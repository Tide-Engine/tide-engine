struct MeshInput
{
    List<int> voxels;
    string name;
}

struct MeshData
{
    List<int> faces;
    string name;
}

local singleton Meshing
{
    MeshInput source;
    MeshData result;
    bool started;
    bool finished;
    float matchBefore;
    float matchAfter;
}

int Face(int voxel) { return voxel * 3 + 1; }

local worker MeshData BuildMesh(MeshInput input)
{
    var saved = input;
    mut List<int> faces = input.voxels;
    parallel (var i in faces)
    {
        faces[i] = Face(saved.voxels[i]);
    }
    return MeshData { faces = faces, name = input.name + " built" };
}

async void Rebuild(mut Meshing meshing)
{
    meshing.result = await BuildMesh(meshing.source);
    meshing.finished = true;
}

view Prepare(mut Meshing meshing, mut WorkerPreview preview)
{
    if (!meshing.started)
    {
        meshing.started = true;
        preview.result = 41;
        meshing.matchBefore = preview.value;
        Rebuild(meshing);
        meshing.matchAfter = preview.value;
        preview.result += 1;
    }
}

scene Main;

component WorkerPreview
{
    [Position] float value;
    local int result;
}

event(Spawned) Setup(with Main) { Spawn(WorkerPreview { value = 7 }); }

component RenderTask
{
    bool started;
    bool finished;
    MeshData mesh;
}

local singleton Control
{
    bool spawn;
    bool destroy;
    LocalEntity owner;
}

view OwnerControl(mut Control control)
{
    if (control.spawn)
    {
        control.owner = local Spawn(RenderTask);
        control.spawn = false;
    }
    if (control.destroy)
    {
        control.owner.Destroy();
        control.destroy = false;
    }
}

async void FinishOwner(mut local RenderTask owner, MeshInput input)
{
    owner.mesh = await BuildMesh(input);
    owner.finished = true;
}

view OwnerWork(mut local RenderTask owner, Meshing meshing)
{
    if (!owner.started)
    {
        owner.started = true;
        FinishOwner(owner, meshing.source);
    }
}
