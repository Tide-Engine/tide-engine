// Match tasks that await the server's store: loads that find their key, find
// nothing, or find what can't be read; listings page after page, and one that
// fails; a load awaited through an async function of its own, after a wait of
// ticks and after a save the task made; a save and a load of one key in one
// tick; and a task whose entity goes before its answer comes. Played on a host
// with a guest: the guest's world goes as the host's does, though only the
// host's machine has the store.

settings { maxPlayers = 2; }

scene Main { }

singleton Vault
{
    int found;      // Awaited loads that found their key
    int missing;    // ...that found nothing: IOError.NotFound
    int failed;     // ...whose files couldn't be read: IOError.Failed
    int sum;        // Every byte the found ones gave, added up
    int same;       // What a load found of a key saved in its own tick, before it
    int crates;     // Crates tasks spawned once their answers came
    int finished;   // Loading tasks that got to their end
    int pages;      // Pages awaited listings gave
    int keys;       // ...their keys
    int keysHash;   // ...and their bytes, in order
    int listFailed; // Listings that couldn't be made
    int deep;       // What loads awaited through Size gave
    int deepFailed;
    int held;       // What the task whose entity went got: never anything
    int handled;    // What an async handler's loads gave
}

event Fetch { string key; }

component Holder { int got; }

component Crate { int size; }

input Controls { float2 move; }

// A value of `count` bytes: start, start + 1, ...
List<byte> Bytes(int start, int count)
{
    mut List<byte> made = [];
    for (var i = 0; i < count; i++) made.Add(byte(start + i));
    return made;
}

// Keys' bytes into a hash, in order: what C checks the keys were
int Mix(int hash, string key)
{
    mut var h = hash;
    foreach (var b in key.ToBytes()) h = (h ^ int(b)) * 16777619;
    return (h ^ 47) * 16777619;
}

// What the store has under `key`, as the task's own value: its bytes, or an error
async void Take(mut Vault vault, string key)
{
    var got = await Storage.Load(key);
    if (got is List<byte> bytes)
    {
        vault.found += 1;
        foreach (var b in bytes) vault.sum += b;
        if (key == "same") foreach (var b in bytes) vault.same += b;
        Spawn(Crate { size = bytes.count });
        vault.crates += 1;
    }
    else if (got is IOError.NotFound) vault.missing += 1;
    else vault.failed += 1;
    vault.finished += 1;
}

// Every key under `prefix`, a page at a time, each page asked for after the last key of the one before
async void Pages(mut Vault vault, string prefix)
{
    mut var after = "";
    mut var going = true;
    while (going)
    {
        var page = await Storage.List(prefix, after);
        if (page is StorageKeys keys)
        {
            vault.pages += 1;
            foreach (var key in keys.keys)
            {
                vault.keys += 1;
                vault.keysHash = Mix(vault.keysHash, key);
            }
            going = keys.more;
            if (going) after = keys.keys[keys.keys.count - 1];
        }
        else
        {
            vault.listFailed += 1;
            going = false;
        }
    }
}

// A load awaited in an async function of its own, which passes its error on
async int Size(string key) fails IOError
{
    var bytes = try await Storage.Load(key);
    return bytes.count;
}

// ...awaited after a wait of ticks, and again after a save the task makes itself, which the load after it finds
async void Deep(mut Vault vault)
{
    await Wait.Ticks(2);
    vault.deep += await Size("deep/a") ?? -100;
    Storage.Save("deep/b", Bytes(7, 5));
    vault.deep += await Size("deep/b") ?? -1000;
    if (await Size("deep/none") is IOError.NotFound) vault.deepFailed += 1;
    if (await Storage.List("deep/") is StorageKeys listed) vault.deep += listed.keys.count * 100;
}

// An async handler's task awaits as an async function's does
async event(Fetch fetch) Fetched(mut Vault vault)
{
    if (await Storage.Load(fetch.key) is List<byte> bytes) vault.handled += bytes.count;
    vault.handled += (await Storage.List(fetch.key) ?? default).keys.count * 10;
}

// Started for its entity, which goes in the same tick: its answer comes for a task that has ended
async void Hold(mut Holder holder)
{
    if (await Storage.Load("boxes/7") is List<byte> bytes) holder.got = bytes.count;
}

system Keep(mut Holder holder, Time time)
{
    if (time.tick == 4) Hold(holder);
}

system Drop(Holder holder, Time time)
{
    if (time.tick == 4 && holder.got == 0) this.Destroy();
}

system Work(mut Vault vault, Time time)
{
    if (time.tick == 1) Spawn(Holder { });
    if (time.tick == 2)
    {
        Storage.Save("boxes/7", Bytes(1, 3));
        Storage.Save("big", Bytes(0, 5000));         // Past what a frame carries inline: by download
        Storage.Save("deep/a", Bytes(3, 2));
        Storage.Save("list/a", Bytes(1, 1));
        Storage.Save("list/b", Bytes(1, 1));
        Storage.Save("list/c/d", Bytes(1, 1));
        for (var i = 0; i < 1100; i++) Storage.Save($"page/{i}", Bytes(i, 1)); // More than a page has
    }
    if (time.tick == 4)
    {
        Take(vault, "boxes/7");
        Take(vault, "boxes/7");                      // Awaited twice in a tick: two tasks, each answered
        Take(vault, "boxes/none");
        Take(vault, "locked");                       // The host's files say it can't be read
        Take(vault, "big");
        Storage.Save("same", Bytes(50, 2));          // A save then an awaited load of its key in one tick: it's found
        Take(vault, "same");
        Pages(vault, "page/");
        Pages(vault, "list/");
        Pages(vault, "locked/");                     // The host's files say it can't be listed
        Deep(vault);
        Send(Fetch { key = "boxes/7" });
    }
}
