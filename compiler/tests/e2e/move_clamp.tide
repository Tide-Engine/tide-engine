// The first Tide program: players move and never go below y = 0.

component TestTransform
{
    float3 position;
    float3 rotation;
    float3 scale;
}

component Player
{
    float3 speed;
}

// Props have a TestTransform but no Player, so the player systems skip them.
component Prop
{
    int id;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(TestTransform { position = float3(0, 10, 0), scale = float3(1, 1, 1) },
          Player { speed = float3(1, -2, 0) });

    Spawn(TestTransform { position = float3(0, 10, 0) }, Prop { id = 7 });
}

system MovePlayer(Time time, Player player, mut TestTransform trs)
{
    trs.position += player.speed * time.dt;
}

system ClampPlayer(mut TestTransform trs, with Player)
{
    if (trs.position.y < 0)
        trs.position.y = 0;
}
