// A parallel loop over a query's rows, beside the foreach that does the same:
// rows across archetypes, some left out by the query's filters and some by
// the steps' own guard, and the events the steps send, to the world and to
// the rows' entities, come in the order the foreach sends them. A system's
// loop, and a match handler's, which sends while its event's tick dispatches.

component Body
{
    int id;
    float x;
}

component Fighter { }
component Benched { }
component Armored { } // Its fighters are an archetype of their own

singleton Settings
{
    int skip;
}

singleton Log
{
    List<int> serial;    // Ids, as the foreach's events came
    List<int> atOnce;    // ...as the system's parallel loop's did
    List<int> handled;   // ...and the handler's
    List<int> hitSerial; // The entities' ids, as their Hit came
    List<int> hitParallel;
    List<float> sums;    // What each event carried, from a costly step
}

event Heard
{
    int id;
    int source; // 0 the foreach, 1 the system's parallel loop, 2 the handler's
    float sum;
}

event Hit
{
    bool atOnce;
}

event Sweep { }

scene Main { }

event(Spawned) Setup(with Main, mut Settings settings)
{
    settings.skip = 7;
    for (var i = 0; i < 6000; i++)
    {
        var e = Spawn(Body { id = i, x = float(i) * 0.5 });
        if (i % 3 != 2) e.Add(Fighter);
        if (i % 5 == 0) e.Add(Benched);
        if (i % 4 == 1) e.Add(Armored);
    }
}

// Work enough that a step's run is worth a thread
float Heavy(float x)
{
    mut var y = x * 0.001;
    for (var i = 0; i < 40; i++) y = Math.Sin(y * 1.3 + 0.7) + Math.Cos(y * 0.9);
    return y;
}

system Serial(query (Body body, with Fighter, without Benched) fighters, Settings settings, Time time)
{
    if (time.tick != 1) return;
    var limit = 5900.0;
    foreach (var f in fighters)
    {
        if (f.body.id % settings.skip == 3 || f.body.x * 2 > limit) continue;
        Send(Heard { id = f.body.id, source = 0, sum = Heavy(f.body.x) });
        f.entity.Send(Hit { atOnce = false });
    }
}

[After(Serial)]
system Parallel(query (Body body, with Fighter, without Benched) fighters, Settings settings, Time time)
{
    if (time.tick != 1) return;
    var limit = 5900.0;
    parallel (var f in fighters)
    {
        if (f.body.id % settings.skip == 3 || f.body.x * 2 > limit) continue;
        Send(Heard { id = f.body.id, source = 1, sum = Heavy(f.body.x) });
        f.entity.Send(Hit { atOnce = true });
    }
}

[After(Parallel)]
system Trigger(Time time)
{
    if (time.tick == 1) Send(Sweep { });
}

event(Sweep) Sweeper(query (Body body, with Fighter, without Benched) fighters, Settings settings)
{
    parallel (var f in fighters)
    {
        if (f.body.id % settings.skip == 3) continue;
        if (f.body.x * 2 > 5900.0) continue;
        Send(Heard { id = f.body.id, source = 2, sum = Heavy(f.body.x) });
    }
}

event(Heard heard) Hear(mut Log log)
{
    if (heard.source == 0) log.serial.Add(heard.id);
    else if (heard.source == 1) log.atOnce.Add(heard.id);
    else log.handled.Add(heard.id);
    log.sums.Add(heard.sum);
}

event(Hit hit) Struck(Body body, mut Log log)
{
    if (hit.atOnce) log.hitParallel.Add(body.id);
    else log.hitSerial.Add(body.id);
}

local singleton Seen
{
    int frames;
}

// A view's rows are made for it: its loop goes through them where they are
view Look(query (Body body, with Fighter) bodies, mut Seen seen)
{
    seen.frames++;
    parallel (var b in bodies)
    {
        var far = b.body.x > 100;
        if (far) continue;
    }
}
