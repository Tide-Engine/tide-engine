// Tweaks: values game.tweaks gives in place of the code's. A dev build reads
// them from the match (TideTweaks) and this machine's copy, which can change
// while it runs; a build without dev has the file's values as constants.

namespace Combat
{
    enum Rate { Slow, Fast }
    tweak Rate Speed = Rate.Slow;
}

tweak float KickUp = 0.5;
const int BASE = 3;
tweak int Rounds = 3;
tweak Color Fog = Color(0.1, 0.2, 0.3, 1);
tweak bool Auto = false;
tweak float Unchanged = 2;

scene Main { }

singleton Seen
{
    float kick;
    int rounds;
    Color fog;
    bool auto;
    int fast;
    float unchanged;
    float doubled;
    int start = Rounds; // A field's default: the build's value
}

// A helper reads them as the code that calls it does
float Doubled()
{
    return KickUp * 2;
}

system Read(mut Seen seen)
{
    seen.kick = KickUp;
    seen.rounds = Rounds;
    seen.fog = Fog;
    seen.auto = Auto;
    seen.fast = Combat.Speed == Combat.Rate.Fast ? 1 : 0;
    seen.unchanged = Unchanged;
    seen.doubled = Doubled();
}

local singleton Drawn
{
    float kick;
}

view Show(mut Drawn drawn)
{
    drawn.kick = KickUp + Doubled();
}

// Tweak fields: every Gun's, read through a Gun or its type, and by name in its methods
component Gun
{
    int ammo = 3;
    tweak float kick = 0.1;
    tweak Combat.Rate pace = Combat.Rate.Slow;

    float Kicked() { return kick * 2; }
}

event(Spawned) Arm(with Main)
{
    Spawn(Gun { });
}

singleton Fired
{
    float kick;
    float kicked;
    int fast;
}

system Fire(Gun gun, mut Fired fired)
{
    fired.kick = gun.kick;
    fired.kicked = gun.Kicked();
    fired.fast = Gun.pace == Combat.Rate.Fast ? 1 : 0;
}
