// What the game's tweaks are while it's tuned: each a value, worked out from
// numbers, constants and other tweaks, in place of the code's
KickUp = 0.25;
Rounds = 2 + BASE;  // A constant of the game's
Fog = Color(0.5, 0.5, 0.5, 1);
Auto = true;
Combat.Speed = Combat.Rate.Fast;
Gone = 1;
Gun.kick = KickUp + 0.05;  // Another tweak's
Gun.pace = Combat.Rate.Fast;
