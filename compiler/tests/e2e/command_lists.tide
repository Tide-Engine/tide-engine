// Commands that hold lists of values other than bytes: ints, floats, enums,
// entities and structs, in a struct, as a T? and in an array, each element
// packed as a field of its type is. See docs/spec.md, Commands.
enum Kind { Light = 1, Heavy = 2 }

struct Slot
{
    [Clamp(0, 9)] int level;
    float weight = 1;
    Kind kind = Kind.Light;
    bool locked;
    float2 at;
}

struct Loadout
{
    List<int> picks;
    string name;
}

singleton Seen
{
    int calls;
    List<int> attributes;
    List<Slot> slots;
    List<float> weights;
    List<Kind> kinds;
    List<int> picks;
    string name;
    List<Entity> marks;
    int extra;
    int pairs;
}

local singleton UI
{
    bool send;
    int big;
    Entity target;
}

scene Main { }

command([Clamp(0, 20)] List<int> attributes, List<Slot> slots = default, List<float> weights = default, List<Kind> kinds = default, Loadout loadout = default, List<Entity> marks = default, List<int>? extra = default, List<int>[2] pairs = default)
    Enlist(mut Seen seen, PlayerID sender)
{
    _ = sender;
    seen.calls++;
    seen.attributes = attributes;
    seen.slots = slots;
    seen.weights = weights;
    seen.kinds = kinds;
    seen.picks = loadout.picks;
    seen.name = loadout.name;
    seen.marks = marks;
    seen.extra = extra == null ? -1 : (extra ?? []).count;
    mut var sum = 0;
    foreach (var pair in pairs)
    {
        foreach (var n in pair) sum += n;
    }
    seen.pairs = sum;
}

view Submit(mut UI ui)
{
    if (ui.send)
    {
        ui.send = false;
        mut List<int>[2] pairs = default;
        pairs[0] = [1, 2];
        pairs[1] = [30];
        Enlist([3, 25, -4, 7, 1000000, 6], [Slot { level = 4, weight = 2.5, kind = Kind.Heavy, locked = true, at = float2(1, 2) }, Slot { level = 12 }], [0.5, -1.25], [Kind.Heavy, Kind.Light, Kind.Heavy], Loadout { picks = [5, 6, 7], name = "scout" }, [ui.target], [9, 9, 9, 9], pairs);
    }
    if (ui.big > 0)
    {
        mut List<int> attributes = [];
        for (var i = 0; i < ui.big; i++) attributes.Add(i % 21);
        Enlist(attributes);
        ui.big = 0;
    }
}
