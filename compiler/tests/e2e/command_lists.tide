// Commands that hold lists of values other than bytes: ints, floats, enums,
// entities and structs, in a struct, as a T? and in an array, each element
// packed as a field of its type is. See docs/spec.md, Commands.
enum Kind { Light = 1, Heavy = 2 }

struct Slot
{
    [Clamp(0, 9)] int level;
    float weight = 1;
    Kind kind = Kind.Light;
    bool locked;
    float2 at;
}

struct Loadout
{
    List<int> picks;
    string name;
}

command Enlist
{
    [Clamp(0, 20)] List<int> attributes;
    List<Slot> slots;
    List<float> weights;
    List<Kind> kinds;
    Loadout loadout;
    List<Entity> marks;
    List<int>? extra;
    List<int>[2] pairs;
}

singleton Seen
{
    int calls;
    List<int> attributes;
    List<Slot> slots;
    List<float> weights;
    List<Kind> kinds;
    List<int> picks;
    string name;
    List<Entity> marks;
    int extra;
    int pairs;
}

local singleton UI
{
    bool send;
    int big;
    Entity target;
}

scene Main { }

command(Enlist enlist, PlayerID sender) OnEnlist(mut Seen seen)
{
    _ = sender;
    seen.calls++;
    seen.attributes = enlist.attributes;
    seen.slots = enlist.slots;
    seen.weights = enlist.weights;
    seen.kinds = enlist.kinds;
    seen.picks = enlist.loadout.picks;
    seen.name = enlist.loadout.name;
    seen.marks = enlist.marks;
    seen.extra = enlist.extra == null ? -1 : (enlist.extra ?? []).count;
    mut var sum = 0;
    foreach (var pair in enlist.pairs)
    {
        foreach (var n in pair) sum += n;
    }
    seen.pairs = sum;
}

view Submit(mut UI ui)
{
    if (ui.send)
    {
        ui.send = false;
        mut List<int>[2] pairs = default;
        pairs[0] = [1, 2];
        pairs[1] = [30];
        Send(Enlist
        {
            attributes = [3, 25, -4, 7, 1000000, 6],
            slots = [Slot { level = 4, weight = 2.5, kind = Kind.Heavy, locked = true, at = float2(1, 2) }, Slot { level = 12 }],
            weights = [0.5, -1.25],
            kinds = [Kind.Heavy, Kind.Light, Kind.Heavy],
            loadout = Loadout { picks = [5, 6, 7], name = "scout" },
            marks = [ui.target],
            extra = [9, 9, 9, 9],
            pairs = pairs
        });
    }
    if (ui.big > 0)
    {
        mut List<int> attributes = [];
        for (var i = 0; i < ui.big; i++) attributes.Add(i % 21);
        Send(Enlist { attributes = attributes });
        ui.big = 0;
    }
}
