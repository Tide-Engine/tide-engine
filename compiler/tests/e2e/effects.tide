// Audio declarations: code the audio thread runs on a voice's or a bus's
// block, with state kept between blocks and knobs the frame gives. The host
// (effects_test.c) calls what the frame recorded, as the mixer would.

asset Clip hum = "assets/beep.wav";

struct Knobs
{
    float gain;
    float add;
}

struct Counter
{
    int blocks;
    float last;
}

// Scales the block, adds a number, and counts the blocks it saw
audio Scale(mut Samples samples, mut Counter counter, Knobs knobs)
{
    counter.blocks += 1;
    for (var i = 0; i < samples.values.count; i++)
    {
        samples.values[i] = samples.values[i] * knobs.gain + knobs.add;
        counter.last = samples.values[i];
    }
}

// A source: makes a square wave from nothing, with no knobs
audio Square(mut Samples samples, mut Counter counter)
{
    for (var i = 0; i < samples.values.count; i++)
    {
        samples.values[i] = (i / 2) % 100 < 50 ? 0.5 : -0.5;
    }
    counter.blocks += 1;
    Halve(samples);
}

// Noise: an audio declaration rolls, each voice from a sequence of its own, kept with its state
audio Hiss(mut Samples samples, mut Counter counter)
{
    counter.blocks += 1;
    for (var i = 0; i < samples.values.count; i++) samples.values[i] += Grain() * 0.5;
}

float Grain()
{
    return Random.NextFloat(-1, 1);
}

void Halve(mut Samples samples)
{
    for (var i = 0; i < samples.values.count; i++) samples.values[i] = samples.values[i] * 0.5;
}

// An echo: a delay line of a second of stereo, far longer than any other array
// is, which only an audio declaration's state holds. It's read and written
// where it is, here and in the function it's passed on to.
struct Tail
{
    int at;
    float[96000] line;
}

struct Delay
{
    int frames;
    float wet;
}

audio Echo(mut Samples samples, mut Tail tail, Delay delay)
{
    for (var i = 0; i < samples.values.count; i += 2)
    {
        var from = (tail.at + 48000 - delay.frames) % 48000;
        var left = samples.values[i];
        var right = samples.values[i + 1];
        samples.values[i] += tail.line[2 * from] * delay.wet;
        samples.values[i + 1] += tail.line[2 * from + 1] * delay.wet;
        Push(tail, left, right);
    }
    tail.line[95999] += 0; // Its last element, and none past it
    tail.line[96000] = 1;
    tail.line[-1] = 1;
}

void Push(mut Tail tail, float left, float right)
{
    tail.line[2 * tail.at] = left;
    tail.line[2 * tail.at + 1] = right;
    tail.at = (tail.at + 1) % (tail.line.count / 2);
}

// ...and one that rolls beside a long state: its generator is after it
audio Crackle(mut Samples samples, mut Tail tail)
{
    tail.at = (tail.at + 1) % tail.line.count;
    tail.line[tail.at] = Grain();
    samples.values[0] = tail.line[tail.at];
}

[Bus]
enum Bus
{
    Master,
    Music,
}

local singleton Mix
{
    Sound track;
    Sound synth;
    Sound far;
    Sound crackle;
    float gain;
    bool echoes;
}

scene Main { }

view Levels(mut Mix mix)
{
    mix.track.clip = hum;
    mix.track.loop = true;
    mix.track.playing = true;
    mix.track.effect = Scale(Knobs { gain = mix.gain, add = 0.25 });
    mix.synth.playing = true; // No clip: a source
    mix.synth.effect = Square();
    Audio.SetEffect(Bus.Music, Scale(Knobs { gain = 2, add = 0 }));
    Audio.SetEffect(Bus.Master, Hiss());
    if (!mix.echoes) return;
    mix.far.playing = true;
    mix.far.effect = Echo(Delay { frames = 512, wet = 0.5 });
    mix.crackle.playing = true;
    mix.crackle.effect = Crackle();
}
