scene Main { }

struct Surface { RenderTarget target; Texture image; }
local singleton Buffers
{
    Surface surface;
    RenderTarget alias;
    RenderTarget exact;
    RenderTarget card;
    RenderTarget screen;
    RenderTarget half;
    int frames;
    long madeRevision;
    long orderedRevision;
    long grownRevision;
    long drawnRevision;
    long aliasRevision;
    long disposedRevision;
}
local event Release { Surface surface; }

void Grow(RenderTarget target) { target.Resize(32, 24); }
int GrowAndZero(RenderTarget target) { Grow(target); return 0; }
long Keep(long revision, int marker) { return revision + marker; }
void Finish(RenderTarget target) { target.Dispose(); }

// A third of the window, whatever it is: the factor is any number
RenderTarget Part(float factor) { return RenderTarget.Window(factor); }

local event(Release release) Cleanup()
{
    var scratch = RenderTarget(3, 5);
    scratch.Resize(4, 6);
    scratch.Dispose();
    Finish(release.surface.target);
}

view Lifecycle(mut Buffers buffers)
{
    if (buffers.frames == 0)
    {
        var made = RenderTarget(16, 12);
        buffers.surface.target = made;
        buffers.surface.image = made.color;
        buffers.alias = made;
        buffers.madeRevision = made.contentRevision;
        buffers.orderedRevision = Keep(made.contentRevision, GrowAndZero(buffers.alias));
        buffers.grownRevision = made.contentRevision;
        made.Clear(Color.black);
        buffers.drawnRevision = made.contentRevision;
        buffers.aliasRevision = buffers.alias.contentRevision;
        // Exactly these pixels, on any display: 1 of them a unit
        buffers.exact = RenderTarget(320, 180, 1);
        // Logical pixels, like the window's: any number, at the display's scale
        buffers.card = RenderTarget(Screen.width / 4, 90.5);
        buffers.screen = RenderTarget.Window();
        buffers.half = Part(0.5);
    }
    else if (buffers.frames == 1)
    {
        Send(Release { surface = buffers.surface });
        // Keeps the pixels per unit it was made with
        buffers.exact.Resize(64, 32.5);
        // The window's to say: refused, with a line on stderr
        buffers.half.Resize(8, 8);
    }
    buffers.frames += 1;
    buffers.disposedRevision = buffers.surface.target.contentRevision;
}
