component Data { int value = 7; string label = "default"; }
component Links { [SceneRequired] Entity child; Entity tip; }
component LocalLinks { [SceneRequired] LocalEntity child; }
component LocalNested { List<LocalEntity> children; }
component OptionalLink { [SceneRequired] Entity? target; }
component Spawner { Entity root; int work; }
component WorkerLink { [SceneRequired] Entity child; }
component WorkerChild { }
component LevelSettings { int difficulty = 1; }
component Self { Entity value; }
component ScopedLinks { Entity child; Entity tip; }
component DescendantRefs { [SceneRequired] Entity kept; [SceneRequired] Entity changed; Entity self; }
component DescendantRoots
{
    Entity first; Entity second; Entity source;
    Entity firstTip; Entity secondTip; Entity sourceTip;
    Entity anchor; Entity added;
}
component LocalDescendantRefs { [SceneRequired] LocalEntity kept; [SceneRequired] LocalEntity changed; LocalEntity self; }
component LocalDescendantRoots { LocalEntity item; LocalEntity source; LocalEntity tip; LocalEntity anchor; LocalEntity added; }
namespace Defaults { const int VALUE = 41; }
namespace Overrides { const int VALUE = 42; }
singleton Probe
{
    Entity root;
    Entity loaded;
    long order;
    bool ready;
    bool destroy;
    bool unload;
    int batchCount;
    bool invalidWorker;
    bool heavy; // Never set; the static cost estimate makes the scheduler split this test's rows.
    int overrideCalls;
    bool spawnScoped;
    Entity scoped;
    bool spawnDescendants;
    Entity descendants;
    Entity descendantsAgain;
    int descendantReady;
    bool invalidDescendants;
}
local singleton LocalProbe
{
    LocalEntity root; LocalEntity loaded; bool started; bool ready; bool unload;
    bool spawnDescendants; LocalEntity descendants; LocalEntity descendantsAgain; int descendantReady; bool invalidDescendants;
}
scene Main { }

int OverrideValue(mut Probe probe, int value)
{
    probe.overrideCalls += 1;
    return value;
}

event(Spawned) Setup(with Main, mut Probe probe)
{
    probe.root = Spawn(Tree, Data { value = OverrideValue(probe, 11) }, LevelSettings { difficulty = 2 });
    var group = Visibility.CreateGroup(Audience.None);
    probe.loaded = Scene.Load(Tree, Data { value = OverrideValue(probe, 12) }, LevelSettings { difficulty = 3 }, Visibility { group = group });
    Spawn(Links); // SceneRequired does not prevent ordinary code-driven construction.
    Spawn(Empty, LevelSettings { });
}

event(Spawned) RootReady(Links links, Data data, mut Probe probe, World world)
{
    // Part's root has Links too; its optional tip is empty.
    if (links.tip != default)
    {
        probe.ready = world.Has<Data>(links.child) && world.Get<Data>(links.child).value == 25
            && world.Get<Data>(links.child).label == "part" && world.Get<Data>(links.tip).value == 30
            && world.Parent(links.child) == this && world.Parent(links.tip) == links.child
            && world.LocalToWorld(links.tip).c3.x == 15 && data.label == "root";
    }
}

event(Spawned) Order(Data data, mut Probe probe) { probe.order = probe.order * 100 + data.value; }

system Actions(mut Probe probe)
{
    if (probe.spawnScoped) { probe.scoped = Spawn(Overrides.Scoped); probe.spawnScoped = false; }
    if (probe.spawnDescendants)
    {
        probe.descendants = Spawn(Overrides.Descendants);
        probe.descendantsAgain = Scene.Load(Overrides.Descendants);
        probe.spawnDescendants = false;
    }
    if (probe.destroy) { probe.root.Destroy(); probe.destroy = false; }
    if (probe.unload) { Scene.Unload(probe.loaded); probe.unload = false; }
}

event(Spawned) DescendantsReady(DescendantRoots roots, mut Probe probe, World world)
{
    var first = world.Get<DescendantRefs>(roots.first);
    var second = world.Get<DescendantRefs>(roots.second);
    var source = world.Get<DescendantRefs>(roots.source);
    probe.descendantReady += 1;
    probe.invalidDescendants = probe.invalidDescendants
        || world.Parent(roots.first) != this || world.Parent(roots.second) != this || world.Parent(roots.source) != this
        || world.Parent(first.kept) != roots.first || world.Parent(second.kept) != roots.second || world.Parent(source.kept) != roots.source
        || world.Parent(roots.firstTip) != first.kept || world.Parent(roots.secondTip) != second.kept || world.Parent(roots.sourceTip) != source.kept
        || world.Parent(roots.added) != roots.first || world.Parent(roots.anchor) != this;
}

Entity MakeWorker() { return Spawn(Worker); }

system SetupBatch(mut Probe probe)
{
    for (var i = 0; i < probe.batchCount; i++) Spawn(Spawner);
    probe.batchCount = 0;
}

system Batch(mut Spawner spawner, Probe probe)
{
    if (probe.heavy) for (var i = 0; i < 1000000; i++) spawner.work += i;
    if (spawner.root == default) spawner.root = MakeWorker();
}

system CheckWorkers(WorkerLink link, World world, mut Probe probe)
{
    if (!world.Has<WorkerChild>(link.child) || world.Parent(link.child) != this
        || world.Get<Self>(link.child).value != link.child || world.Get<Self>(this).value != this) probe.invalidWorker = true;
}

view LocalSetup(mut LocalProbe probe)
{
    if (!probe.started)
    {
        probe.root = local Spawn(LocalTree);
        local Spawn(SharedTree);
        probe.loaded = Scene.Load(SharedTree, Data { value = 21 });
        probe.started = true;
    }
    if (probe.unload) { Scene.Unload(probe.loaded); probe.unload = false; }
    if (probe.spawnDescendants)
    {
        probe.descendants = local Spawn(LocalDescendants);
        probe.descendantsAgain = Scene.Load(LocalDescendants);
        probe.spawnDescendants = false;
    }
}

local event(Spawned) LocalDescendantsReady(local LocalDescendantRoots roots, mut LocalProbe probe, World world)
{
    var item = world.Get<LocalDescendantRefs>(roots.item);
    var source = world.Get<LocalDescendantRefs>(roots.source);
    probe.descendantReady += 1;
    probe.invalidDescendants = probe.invalidDescendants
        || world.Parent(roots.item) != this || world.Parent(roots.source) != this
        || world.Parent(item.kept) != roots.item || world.Parent(source.kept) != roots.source
        || world.Parent(roots.tip) != item.kept || world.Parent(roots.added) != roots.item
        || world.Parent(roots.anchor) != this;
}

local event(Spawned) LocalReady(local LocalLinks links, local LocalNested nested, mut LocalProbe probe, World world)
{
    probe.ready = world.Get<Data>(links.child).value == 4 && world.Parent(links.child) == this
        && nested.children[0] == links.child;
}
