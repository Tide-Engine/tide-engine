// Commands in channels, unordered commands, and a command that carries a
// file's bytes: see docs/spec.md, Commands.
settings
{
    hostMigration = true;
}

enum Channels { Uploads, Chat }

// The default channel: in order, after every earlier Say

// A channel of its own: a Say never waits behind an upload

// No order at all: handled in the tick it arrives, once

// A second channel of the game's, numbered after Uploads

input Controls
{
    bool fire;
}

singleton Log
{
    int says;
    string last;
    int uploads;
    int uploadBytes;
    int uploadHash;
    int pings;
    int pingSum;
    int duplicates;
    List<int> pingIds;
    int whispers;
    string order;
}

local singleton UI
{
    bool say;
    string text = "hello";
    bool upload;
    int uploadSize;
    bool ping;
    int pingAt;
    bool whisper;
}

scene Main { }

command(string text) Say(mut Log log, PlayerID sender)
{
    log.says++;
    log.last = text;
    log.order = log.order + "S";
}

[Channel(Channels.Uploads)]
command(List<byte> bytes) Upload(mut Log log, PlayerID sender)
{
    log.uploads++;
    log.uploadBytes = bytes.count;
    mut var hash = 0;
    foreach (var b in bytes) hash = hash * 31 + b;
    log.uploadHash = hash;
    log.order = log.order + "U";
}

[Unordered]
command(int at) Ping(mut Log log, PlayerID sender)
{
    if (log.pingIds.Contains(at)) log.duplicates++;
    else log.pingIds.Add(at);
    log.pings++;
    log.pingSum += at;
}

[Channel(Channels.Chat)]
command(string text) Whisper(mut Log log, PlayerID sender)
{
    log.whispers++;
    log.order = log.order + "W";
}

view Submit(mut UI ui)
{
    if (ui.say)
    {
        Say(ui.text);
        ui.say = false;
    }
    if (ui.upload)
    {
        mut List<byte> bytes = [];
        bytes.Resize(ui.uploadSize);
        for (var i = 0; i < ui.uploadSize; i++) bytes[i] = byte(i * 7 + 3);
        Upload(bytes);
        ui.upload = false;
    }
    if (ui.ping)
    {
        Ping(ui.pingAt);
        ui.ping = false;
    }
    if (ui.whisper)
    {
        Whisper(ui.text);
        ui.whisper = false;
    }
}
