// Where lists go: a struct can hold one, and a component such a struct. A list
// can't hold lists, or structs with lists, yet: what the errors say to write
// instead is here too, one list with where each part starts, and a list of
// entities that each have a list of their own.

struct Loadout
{
    List<int> cards;
    Map<int, int> uses;
    string title;
}

component Fighter
{
    Loadout loadout;
}

// A row's part of Table.cells
struct Row
{
    int first;
    int count;
}

singleton Table
{
    List<int> cells;
    List<Row> rows;
}

component Bag
{
    List<int> items;
}

component Backpack
{
    List<Entity> bags;
}

singleton Results
{
    int checks;
    int passed;
    int firstFailure;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    var small = Spawn(Bag { items = [1, 2] });
    var big = Spawn(Bag { items = [3, 4, 5] });
    Spawn(Backpack { bags = [small, big] }, Fighter);
}

void Expect(mut Results t, bool ok)
{
    t.checks += 1;
    if (ok) t.passed += 1;
    else if (t.firstFailure == 0) t.firstFailure = t.checks;
}

void AddRow(mut Table table, List<int> cells)
{
    table.rows.Add(Row { first = table.cells.count, count = cells.count });
    foreach (var cell in cells) table.cells.Add(cell);
}

int RowSum(Table table, int row)
{
    var part = table.rows[row];
    mut var sum = 0;
    for (var i = 0; i < part.count; i++) sum += table.cells[part.first + i];
    return sum;
}

system Use(mut Fighter fighter, Backpack pack, mut Results t, mut Table table, World world)
{
    if (t.checks > 0) return; // Once

    // A struct's list, map and text, in a component
    fighter.loadout.cards.Add(3);
    fighter.loadout.cards.Add(5);
    fighter.loadout.uses[5] += 2;
    fighter.loadout.title = "two";
    Expect(t, fighter.loadout.cards.count == 2 && fighter.loadout.cards[1] == 5);
    Expect(t, fighter.loadout.uses[5] == 2 && fighter.loadout.title == "two");

    // The struct copies them with it
    mut var copy = fighter.loadout;
    copy.cards.Add(8);
    copy.uses[5] = 9;
    Expect(t, copy.cards.count == 3 && fighter.loadout.cards.count == 2 && fighter.loadout.uses[5] == 2);
    fighter.loadout = copy;
    Expect(t, fighter.loadout.cards.count == 3 && fighter.loadout.cards[2] == 8 && fighter.loadout.uses[5] == 9);

    // Rows of any length in one list, each knowing its part
    AddRow(table, [1, 2, 3]);
    AddRow(table, []);
    AddRow(table, [10, 20]);
    Expect(t, table.rows.count == 3 && table.cells.count == 5);
    Expect(t, RowSum(table, 0) == 6 && RowSum(table, 1) == 0 && RowSum(table, 2) == 30);

    // A list for each entity held
    mut var total = 0;
    foreach (var bag in pack.bags)
    {
        var items = world.Get<Bag>(bag).items;
        foreach (var item in items) total += item;
    }
    Expect(t, pack.bags.count == 2 && total == 15);
}
