// Lookups: another entity's component in the same tick, by its handle.

component Health
{
    int value = 10;
    string name;
}

component Rival
{
    Entity other;
}

component Attacker
{
    Entity target;
    int damage = 3;
    int hits;
    int misses;
}

component Healer
{
    Entity patient;
}

singleton Stats
{
    int kills;
    int seen;
}

scene Main { }

event(Spawned) Setup(with Main)
{
    var a = Spawn(Health { value = 7, name = "a" });
    var b = Spawn(Health { value = 20, name = "b" });
    a.Add(Rival { other = b });
    b.Add(Rival { other = a });
    Spawn(Attacker { target = a });
    Spawn(Attacker { target = b, damage = 1 });
    Spawn(Attacker { }); // No target: never hits
    Spawn(Healer { patient = b });
}

// Reads the target's health as it is this tick, and counts the kill
system Attack(mut Attacker attacker, lookup Health health, mut Stats stats)
{
    if (!health.Has(attacker.target))
    {
        attacker.misses += 1;
        return;
    }
    var target = health[attacker.target];
    attacker.hits += 1;
    if (target.value <= attacker.damage) stats.kills += 1;
    attacker.target.Send(Hit { damage = attacker.damage });
}

event Hit
{
    int damage;
}

event(Hit hit) TakeHit(mut Health health)
{
    health.value -= hit.damage;
    if (health.value <= 0) this.Destroy();
}

// Changes another entity's component in place, through a mut lookup
system Heal(Healer healer, mut lookup Health health)
{
    mut var h = health[healer.patient];
    h.value += 2;
    health[healer.patient] = h;
}

// Reads a component it also changes: the rows it changed earlier in this run,
// as every machine sees them
system Spread(mut Health health, lookup Health others, mut Stats stats, Rival rival)
{
    stats.seen += others[rival.other].value;
    health.value += 1;
}
