// Scenes: groups of entities that load and unload together.

scene Arena
{
    int size = 20;
    int round;
}

// One player's cards, which only they see.
scene Hand
{
    PlayerID player;
}

component Floor
{
    int size;
}

component Enemy
{
    int hp = 3;
}

component Loot
{
    int from;
}

component RootSettings { int value; string text; List<int> values; }
[Sparse] component RootTag { int value = 5; }

singleton Stats
{
    int arenasSetUp;
    int destroyed;
    int lootDropped;
    Entity arena;
    Entity hand;
    int argumentOrder;
}

scene Main { }

int LoadValue(mut Stats stats, int value)
{
    stats.argumentOrder = stats.argumentOrder * 10 + value;
    return value;
}

event(Spawned) Setup(with Main, mut Stats stats)
{
    stats.arena = Scene.Load(Arena { size = LoadValue(stats, 3) * 10 },
                            RootSettings { value = LoadValue(stats, 7), text = "scene-root", values = [4, 5] }, RootTag);
    mut var audience = Audience.Only(PlayerID(1));
    audience.Add(PlayerID(3));
    audience.Remove(PlayerID(3));
    var group = Visibility.CreateGroup(audience);
    stats.hand = Scene.Load(Hand { player = PlayerID(1) }, Visibility { group = group });
}

event(Spawned) RootReady(Arena arena, RootSettings settings, RootTag tag)
{
    Debug.Assert(arena.size == 30 && settings.value == 7 && settings.text == "scene-root");
    Debug.Assert(settings.values.count == 2 && settings.values[1] == 5 && tag.value == 5);
}

// Runs for each arena as it loads: what it spawns joins that arena.
event(Spawned) SetupArena(Arena arena, mut Stats stats)
{
    stats.arenasSetUp += 1;
    Spawn(Floor { size = arena.size });
    Spawn(Enemy);
    Spawn(Enemy);
}

// Runs once per loaded arena, and unloads it on its third round.
system Rounds(mut Arena arena)
{
    arena.round += 1;
    if (arena.round == 3) Scene.Unload(this);
}

// A spawn joins the scene of the entity the code runs for: this loot, the arena.
system Drops(Enemy enemy, Time time)
{
    if (time.tick == 0 && enemy.hp > 0) Spawn(Loot { from = 1 });
}

event(Destroyed) CountDestroyed(mut Stats stats)
{
    stats.destroyed += 1;
}

// As the arena unloads, its enemies drop loot into it. By the loot's turn the
// arena is gone, so the loot is never made.
event(Destroyed) DropLoot(with Enemy, mut Stats stats)
{
    stats.lootDropped += 1;
    Spawn(Loot { from = 2 });
}
