scene Main { }

// A target's depth in a frag and in a vert: compared with a number, which
// the GPU does through a sampler of its own kind, and read as one. Each way a
// depth is read is a texture of the shader's, beside a grid's colors.
local singleton Lamp
{
    RenderTarget map;
    DepthTexture shadow;
    float4x4 toLamp;
    Grid2<Color> wood = Grid2(2, 2);
    List<Vertex3> mesh;
    List<int> faces;
}

// Where a point of the world is in the lamp's image, and how far from the lamp
float3 FromLamp(float3 world, float4x4 toLamp)
{
    float4 clip = Math.Mul(toLamp, float4(world, 1));
    return float3(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5, clip.z * 0.5 + 0.5);
}

frag Lit(Vertex3 vertex, mut Color color, Pixel pixel, Lamp lamp)
{
    float3 at = FromLamp(pixel.world, lamp.toLamp);
    mut float lit = lamp.shadow.Compare(at.xy, at.z - 0.01);
    // In a branch, as it's read at its one level
    if (lit < 1) lit = lit * 0.5 + lamp.shadow.Compare(at.xy + float2(0.01, 0), at.z - 0.01) * 0.5;
    float far = lamp.shadow.Sample(at.xy);
    color = lamp.wood.Sample(vertex.uv) * (0.25 + 0.75 * lit) * (far < 1 ? 1 : 0.5);
}

vert Sink(mut Vertex3 vertex, Lamp lamp)
{
    vertex.position.y -= lamp.shadow.Sample(vertex.uv);
}

view Show(mut Lamp lamp)
{
    lamp.shadow = lamp.map.depth;
    Draw3D.Mesh(lamp.mesh, lamp.faces, float4x4.identity, Lit);
    Draw3D.Mesh(lamp.mesh, lamp.faces, float4x4.identity, Sink, Lit);
}
