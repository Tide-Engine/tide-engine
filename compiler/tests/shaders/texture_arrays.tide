scene Main { }

// Texture arrays in a frag and a vert: an asset's of a glob, and a field's, read by a uv and a layer that can
// differ from pixel to pixel, one texture however many ways it's read, each way a sampler; a depth array read as a
// number and compared, one texture through two samplers; and one read between its smaller images, whose uv's change
// is asked as the frag starts.
[Filter(Filter.Point), Wrap(Wrap.Repeat)]
asset TextureArray ground = "../e2e/cubes/sky/sky_??.png";

local singleton Field
{
    TextureArray layers;
    DepthTextureArray cascades;
    int pick;
    List<Vertex3> mesh;
    List<int> faces;
}

frag Ground(Vertex3 vertex, out Color color, Field field)
{
    int layer = int(vertex.uv.x * 4);
    Color said = ground.Sample(vertex.uv, layer);
    Color blended = ground.Sample(vertex.uv, field.pick, Filter.Bilinear, Wrap.Clamp);
    Color far = field.layers.Sample(vertex.uv, 2, Filter.Trilinear);
    Color steep = field.layers.SampleGrad(vertex.uv, float2(0.1, 0), float2(0, 0.1), layer);
    float lit = field.cascades.Compare(vertex.uv, field.pick, 0.5);
    float depth = field.cascades.Sample(vertex.uv, 1);
    color = said * blended + far * steep * lit * depth;
}

vert Lift(mut Vertex3 vertex, Field field)
{
    vertex.position.y += field.layers.Sample(vertex.uv, 0).r + field.cascades.Sample(vertex.uv, 3);
}

view Show(mut Field field)
{
    if (field.layers.count == 0)
    {
        field.layers = TextureArray(64, 64, 4);
    }
    Draw.Mesh(field.mesh, field.faces, float4x4.identity, Lift, Ground);
}
