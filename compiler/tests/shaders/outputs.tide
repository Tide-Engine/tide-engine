// What tidec writes for a frag with several outputs, each an `out Color`
// parameter: in GLSL, an `out vec4` for each at the location that's its
// place among them; in WGSL, a struct of them that the fragment stage returns.
// Each goes through what the draw finishes a color with, its tint and what a
// draw that multiplies needs. The frag's function takes each as it takes its
// one color (inout, or a pointer in WGSL), in its parameters' order, wherever
// they are among them. A frag with one output is written as it always was.

scene Main { }

struct Corner
{
    float3 position;
    float3 normal;
    Color color;
}

struct FromLamp
{
    float3 place;
}

singleton Sun
{
    float3 at = float3(0, 4, 0);
}

local singleton Models
{
    List<Corner> crate;
    List<Vertex> quad;
    List<int> faces;
    RenderTarget scene;
    RenderTarget wide;
    Texture albedo;
    Texture normals;
    bool made;
}

// A function a frag passes one of its outputs on to
void Packed(float3 normal, out Color packed)
{
    packed = Color(normal.x, normal.y, normal.z);
}

vert Place(mut Corner corner, out FromLamp lamp, Sun sun)
{
    lamp.place = corner.position - sun.at;
}

// Two outputs: a color, and a normal as it is, which a target of floats keeps
frag Fill(Corner corner, out Color albedo, out Color normal)
{
    albedo = corner.color;
    Packed(corner.normal, out normal);
}

// Three, with what its vert wrote between them: one path leaves the pixel out
frag Deep(Corner corner, out Color albedo, FromLamp lamp, out Color normal, out Color place)
{
    if (corner.color.a < 0.5)
    {
        this.Discard();
    }
    albedo = corner.color;
    normal = Color(corner.normal.x, corner.normal.y, corner.normal.z);
    place = Color(lamp.place.x, lamp.place.y, lamp.place.z, this.depth);
}

// Four, which is as many as a target holds, in 2D
frag Split(Vertex vertex, out Color red, out Color green, out Color blue, out Color alpha)
{
    red = Color(vertex.color.r, 0, 0);
    green = Color(0, vertex.color.g, 0);
    blue = Color(0, 0, vertex.color.b);
    alpha = Color(vertex.color.a, vertex.color.a, vertex.color.a);
}

// One, reading what the first wrote: as a frag always was
frag Light(Vertex vertex, out Color color, Texture source, Models models)
{
    Color normal = models.normals.Sample(vertex.uv, Filter.Point);
    color = source.Sample(vertex.uv) * Math.Max(normal.b, 0.1);
}

view Show(mut Models models)
{
    if (!models.made)
    {
        models.made = true;
        models.scene = RenderTarget(256, 256, Format.Rgba8, Format.Rgba16f, Format.Rgba16f);
        models.wide = RenderTarget.Window(Format.Rgba8, Format.Rgba8, Format.Rgba8, Format.Rgba8);
        models.albedo = models.scene.color;
        models.normals = models.scene.colors[1];
    }
    models.scene.Mesh(models.crate, models.faces, float4x4.identity, Fill);
    models.scene.Mesh(models.crate, models.faces, float4x4.identity, Place, Deep);
    models.wide.Mesh(models.quad, models.faces, Split);
    Draw.Blit(models.albedo, Draw.window, Light);
}
