# An enum conversion in an alias's array bound folds before the usual enum
# prepass. Its cached alias type must match the same type resolved at a use.
file(MAKE_DIRECTORY "${OUT}")
foreach(order IN ITEMS before after)
    set(backing "using B = byte;\n")
    set(alias "using A = int[int(E(258))];\n")
    if(order STREQUAL before)
        set(declarations "${backing}${alias}")
    else()
        set(declarations "${alias}${backing}")
    endif()
    file(WRITE "${OUT}/game.tide" "${declarations}enum E : B { Zero }\ncomponent Holder { A values; }\nscene Main;\n")
    execute_process(COMMAND "${TIDEC}" "${OUT}/game.tide" --outline
        RESULT_VARIABLE result OUTPUT_VARIABLE outline ERROR_VARIABLE stderr)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "alias array did not compile (${order}): ${stderr}")
    endif()
    string(JSON count LENGTH "${outline}" declarations)
    math(EXPR last "${count} - 1")
    set(alias_type "")
    set(field_type "")
    foreach(index RANGE ${last})
        string(JSON name GET "${outline}" declarations ${index} name)
        if(name STREQUAL A)
            string(JSON alias_type GET "${outline}" declarations ${index} type)
        elseif(name STREQUAL Holder)
            string(JSON field_type GET "${outline}" declarations ${index} fields 0 type)
        endif()
    endforeach()
    if(NOT alias_type STREQUAL "int[2]" OR NOT field_type STREQUAL "int[2]")
        message(FATAL_ERROR "alias/use array identities differ (${order}): ${alias_type}, ${field_type}")
    endif()
endforeach()
