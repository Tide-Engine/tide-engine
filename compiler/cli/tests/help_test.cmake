foreach(topic nonsense --frmaes _editor-preview)
    help(2 help "${topic}")
    contains("${err}" "unknown help topic '${topic}'")
    if(NOT out STREQUAL "")
        message(FATAL_ERROR "Unknown topic printed help to stdout: ${out}")
    endif()
endforeach()
