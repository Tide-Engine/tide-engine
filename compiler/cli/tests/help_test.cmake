cmake_minimum_required(VERSION 3.25)

# A standalone copy has no game, installed sources, or sibling editor to use.
file(COPY "${TIDE}" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/help_test/bin")
get_filename_component(name "${TIDE}" NAME)
set(TIDE "${CMAKE_CURRENT_BINARY_DIR}/help_test/bin/${name}")

# Exercise the actual CLI, including dispatch before commands with side effects.
function(help expected)
    execute_process(COMMAND "${TIDE}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "tide ${ARGN}: expected ${expected}, got ${code}: ${out}${err}")
    endif()
    if(expected EQUAL 0 AND NOT err STREQUAL "")
        message(FATAL_ERROR "tide ${ARGN}: unexpected stderr: ${err}")
    endif()
    set(out "${out}" PARENT_SCOPE)
    set(err "${err}" PARENT_SCOPE)
endfunction()

function(contains text needle)
    string(FIND "${text}" "${needle}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Missing '${needle}' in: ${text}")
    endif()
endfunction()

function(excludes text needle)
    string(FIND "${text}" "${needle}" at)
    if(NOT at EQUAL -1)
        message(FATAL_ERROR "Unexpected '${needle}' in: ${text}")
    endif()
endfunction()

help(2)
set(overview "${out}")
string(REGEX MATCHALL "\n" lines "${overview}")
list(LENGTH lines length)
if(length GREATER 28)
    message(FATAL_ERROR "Overview should fit in 28 lines, got ${length}")
endif()
contains("${overview}" "tide help <command>")
excludes("${overview}" "--capture-audio")
excludes("${overview}" "_editor-preview")
foreach(alias help --help -h)
    help(0 "${alias}")
    if(NOT out STREQUAL overview)
        message(FATAL_ERROR "${alias} differs from bare tide")
    endif()
endforeach()

foreach(command run build deploy login logout schedule shaders add update eject fetch publish editors ide open upgrade version telemetry help)
    contains("${overview}" "${command}")
    help(0 help "${command}")
    contains("${out}" "usage: tide ${command}")
    set(details "${out}")
    # In `help --help`, --help is itself the requested argument topic.
    if(command STREQUAL "help")
        continue()
    endif()
    foreach(alias --help -h)
        help(0 "${command}" "${alias}")
        if(NOT out STREQUAL details)
            message(FATAL_ERROR "${command} ${alias} differs from help ${command}")
        endif()
    endforeach()
endforeach()

help(0 help build)
contains("${out}" "-o <path>")
excludes("${out}" "--capture-audio")
excludes("${out}" "--project")
help(0 help deploy)
contains("${out}" "--project <name-or-id>")
excludes("${out}" "--preview")
help(0 help run)
contains("${out}" "--capture-audio <file.wav>")
contains("${out}" "--data-dir <folder>")
contains("${out}" "--max-connections <n>")
excludes("${out}" "--nightly")

foreach(argument folder source package editor file.tprefab --release --web --android --define --title --stats --debug-views -o
        --no-open --host --join --connect --server --strip-server-assets --anonymous --port --max-matches --max-connections
        --udp-only --capture --capture-audio --microphone --frames --script --scale --size --seed --players --data-dir --project
        --server-only --bundle-only --check --preview --local-preview --nightly --stable --version setting --help -h)
    help(0 help "${argument}")
    contains("${out}" "Commands:")
endforeach()

