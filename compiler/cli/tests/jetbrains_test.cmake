# Run the real CLI against isolated profiles and archives. No IDE or network.
cmake_minimum_required(VERSION 3.25)
foreach(var TIDE WORK)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "Pass -D${var}=...")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(COPY "${TIDE}" DESTINATION "${WORK}/install/bin")
get_filename_component(tide_name "${TIDE}" NAME)
set(tide "${WORK}/install/bin/${tide_name}")
set(archive "${WORK}/install/editors/tide-jetbrains-installer.zip")
file(MAKE_DIRECTORY "${WORK}/install/editors" "${WORK}/path")
set(ENV{HOME} "${WORK}/home")
set(ENV{USERPROFILE} "${WORK}/home")
set(ENV{APPDATA} "${WORK}/roaming")
set(ENV{LOCALAPPDATA} "${WORK}/local")
set(ENV{XDG_CONFIG_HOME} "${WORK}/config")
set(ENV{XDG_DATA_HOME} "${WORK}/data")
set(ENV{PATH} "${WORK}/path")
if(WIN32)
    set(profiles "$ENV{APPDATA}/JetBrains")
    set(plugins "${profiles}")
    set(suffix "/plugins")
elseif(APPLE)
    set(profiles "$ENV{HOME}/Library/Application Support/JetBrains")
    set(plugins "${profiles}")
    set(suffix "/plugins")
else()
    set(profiles "$ENV{XDG_CONFIG_HOME}/JetBrains")
    set(plugins "$ENV{XDG_DATA_HOME}/JetBrains")
    set(suffix "")
endif()
function(payload version)
    file(REMOVE_RECURSE "${WORK}/payload")
    file(WRITE "${WORK}/payload/tide/lib/tide-${version}.jar" "Tide ${version}")
    file(WRITE "${WORK}/payload/tide/textmate/syntaxes/tide.json" "grammar ${version}")
    file(WRITE "${WORK}/payload/lsp4ij/lib/lsp4ij.jar" "bundled LSP4IJ")
    file(WRITE "${WORK}/payload/unrelated/ignore" "must not be installed")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip tide lsp4ij unrelated
        WORKING_DIRECTORY "${WORK}/payload" COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(run expected)
    execute_process(COMMAND "${tide}" editors ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "editors ${ARGN}: expected ${expected}, got ${result}\n${out}${err}")
    endif()
    set(output "${out}${err}" PARENT_SCOPE)
endfunction()
function(contains file expected)
    file(READ "${file}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${file}: ${actual}, expected ${expected}")
    endif()
endfunction()
set(rider "${plugins}/Rider2025.1${suffix}")
set(clion "${plugins}/CLion2026.2${suffix}")
set(idea "${plugins}/IdeaIC2024.2${suffix}")
payload(1)
run(0)
if(NOT output MATCHES "open it once")
    message(FATAL_ERROR "Missing first-launch guidance: ${output}")
endif()
foreach(name Rider2025.1 CLion2026.2 IdeaIC2024.2 Rider2024.1 Rider2026.2-EAP Toolbox RiderBackup2026.2)
    file(MAKE_DIRECTORY "${profiles}/${name}")
endforeach()
file(WRITE "${clion}/tide/lib/tide-old.jar" "old Tide")
file(WRITE "${clion}/lsp4ij/lib/newer.jar" "independent LSP4IJ")
file(WRITE "${clion}/other-plugin/lib/keep.jar" "other plugin")
file(WRITE "${profiles}/CLion2026.2/disabled_plugins.txt" "io.github.blenminer.tide\n")
run(0 --update)
if(NOT output STREQUAL "" OR EXISTS "${rider}/tide" OR EXISTS "${idea}/tide")
    message(FATAL_ERROR "Update must be quiet and only replace existing Tide: ${output}")
endif()
contains("${clion}/tide/lib/tide-1.jar" "Tide 1")
contains("${clion}/lsp4ij/lib/newer.jar" "independent LSP4IJ")
if(EXISTS "${clion}/tide/lib/tide-old.jar")
    message(FATAL_ERROR "Old Tide JAR was not removed")
endif()
run(0)
foreach(dir "${rider}" "${idea}" "${plugins}/Rider2026.2-EAP${suffix}")
    contains("${dir}/tide/lib/tide-1.jar" "Tide 1")
    contains("${dir}/lsp4ij/lib/lsp4ij.jar" "bundled LSP4IJ")
    if(EXISTS "${dir}/unrelated")
        message(FATAL_ERROR "Installed an unrelated archive entry")
    endif()
endforeach()
foreach(name Rider2024.1 Toolbox RiderBackup2026.2)
    if(EXISTS "${plugins}/${name}${suffix}/tide")
        message(FATAL_ERROR "Installed into unsupported profile ${name}")
    endif()
endforeach()
contains("${clion}/other-plugin/lib/keep.jar" "other plugin")
contains("${profiles}/CLion2026.2/disabled_plugins.txt" "io.github.blenminer.tide\n")
payload(2)
run(0 --update)
contains("${rider}/tide/lib/tide-2.jar" "Tide 2")
contains("${rider}/tide/textmate/syntaxes/tide.json" "grammar 2")
if(EXISTS "${rider}/tide/lib/tide-1.jar")
    message(FATAL_ERROR "Upgrade left a stale Tide JAR")
endif()
run(0 --update)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "Repeated upgrade was not quiet: ${output}")
endif()
if(WIN32)
    payload(3)
    execute_process(COMMAND "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe"
        -NoProfile -NonInteractive -File "${CMAKE_CURRENT_LIST_DIR}/jetbrains_lock_test.ps1"
        -Tide "${tide}" -Plugin "${rider}/tide/lib/tide-2.jar"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 1 OR NOT "${out}${err}" MATCHES "close the IDE")
        message(FATAL_ERROR "Locked plugin was not refused with a fix (${result}): ${out}${err}")
    endif()
    contains("${rider}/tide/lib/tide-2.jar" "Tide 2")
endif()
# Corrupt or incomplete archives must leave installed plugins intact.
file(WRITE "${archive}" "broken zip")
run(1 --update)
contains("${rider}/tide/lib/tide-2.jar" "Tide 2")
payload(3)
file(REMOVE_RECURSE "${WORK}/payload/lsp4ij")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip tide
    WORKING_DIRECTORY "${WORK}/payload" COMMAND_ERROR_IS_FATAL ANY)
run(1 --update)
contains("${rider}/tide/lib/tide-2.jar" "Tide 2")
# Missing payload is reported for profiles that already have Tide.
file(WRITE "${WORK}/install/editors/tide.vsix" "unused VSIX")
file(REMOVE "${archive}")
run(1 --update)
if(NOT output MATCHES "reinstall tide")
    message(FATAL_ERROR "Missing archive needs actionable guidance: ${output}")
endif()
file(REMOVE "${WORK}/install/editors/tide.vsix")
run(1 --update)

# Package smoke tests supply the actual Gradle archive as well as the small
# fixtures above. Every installed Tide/dependency file must match that build.
if(BUNDLE)
    file(COPY_FILE "${BUNDLE}" "${archive}")
    file(REMOVE_RECURSE "${rider}/lsp4ij")
    run(0 --update)
    file(ARCHIVE_EXTRACT INPUT "${BUNDLE}" DESTINATION "${WORK}/reference")
    foreach(plugin tide lsp4ij)
        file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${WORK}/reference/${plugin}"
            "${WORK}/reference/${plugin}/*")
        foreach(file IN LISTS files)
            file(SHA256 "${WORK}/reference/${plugin}/${file}" expected)
            file(SHA256 "${rider}/${plugin}/${file}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "Installed ${plugin}/${file} differs from the bundled build")
            endif()
        endforeach()
    endforeach()
endif()
