# Exercise the real package script with a minimal install tree, including its
# version guard and final archive contents. No compiler, IDE or network.
cmake_minimum_required(VERSION 3.25)
foreach(var SOURCE WORK)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "Pass -D${var}=...")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/source/cmake" "${WORK}/native/package" "${WORK}/payload")
file(COPY "${SOURCE}/cmake/package.cmake" DESTINATION "${WORK}/source/cmake")
file(WRITE "${WORK}/native/CMakeCache.txt" "")
file(WRITE "${WORK}/native/package/VERSION" "1.2.3-nightly.4\n")
file(WRITE "${WORK}/native/cmake_install.cmake" [=[
file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}/editors")
file(WRITE "${CMAKE_INSTALL_PREFIX}/editors/tide.vsix" "VSIX")
file(WRITE "${CMAKE_INSTALL_PREFIX}/VERSION" "1.2.3-nightly.4\n")
]=])
set(archive "${WORK}/installer.zip")
function(bundle version)
    file(WRITE "${WORK}/payload/VERSION" "${version}\n")
    file(WRITE "${WORK}/payload/lsp4ij/licenses/LICENSE" "dependency license")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip VERSION lsp4ij
        WORKING_DIRECTORY "${WORK}/payload" COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(package expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DNAME=tide-test "-DNATIVE=${WORK}/native"
        "-DJETBRAINS=${archive}" -P "${WORK}/source/cmake/package.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL expected)
        message(FATAL_ERROR "Package: expected ${expected}, got ${result}: ${out}${err}")
    endif()
    set(output "${out}${err}" PARENT_SCOPE)
endfunction()
bundle(1.2.3-nightly.4)
package(0)
file(ARCHIVE_EXTRACT INPUT "${WORK}/source/build/dist/tide-test.tar.gz" DESTINATION "${WORK}/unpacked")
file(SHA256 "${archive}" expected)
file(SHA256 "${WORK}/unpacked/editors/tide-jetbrains-installer.zip" actual)
if(NOT actual STREQUAL expected OR EXISTS "${WORK}/unpacked/editors/.jetbrains-version")
    message(FATAL_ERROR "Package did not preserve the installer or left version-check scratch files")
endif()
file(READ "${WORK}/unpacked/licenses/jetbrains/LICENSE" license)
if(NOT license STREQUAL "dependency license")
    message(FATAL_ERROR "Dependency licenses did not reach the package")
endif()
bundle(1.2.3)
package(1)
if(NOT output MATCHES "does not match Tide")
    message(FATAL_ERROR "Missing version-mismatch guidance: ${output}")
endif()
file(REMOVE "${archive}")
package(1)
if(NOT output MATCHES "No JetBrains CLI installer")
    message(FATAL_ERROR "Missing installer guidance: ${output}")
endif()
