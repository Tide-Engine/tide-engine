// Private generated hierarchy helpers. All retained links are values in the
// owning world's heap; scratch ancestor chains never escape a call.
static void gen_hierarchy(gen *g)
{
    static const char *const lines[] = {
        "",
        "TIDE_HELPER void @P@destroy_leaf(@W@ *w, tide_entity e);",
        "TIDE_HELPER tide_hierarchy_node @P@hierarchy_get(const @W@ *w, tide_entity e)",
        "{",
        "    return tide_map@M@_get(w->@S@.nodes, e);",
        "}",
        "TIDE_HELPER void @P@hierarchy_put(@W@ *w, tide_entity e, tide_hierarchy_node n)",
        "{",
        "    if (tide_entity_is_null(n.parent) && tide_entity_is_null(n.first)",
        "        && tide_entity_is_null(n.next) && tide_entity_is_null(n.previous)) {",
        "        (void)tide_map@M@_remove(&w->@S@.nodes, e, @WHERE@);",
        "    } else tide_map@M@_set(&w->@S@.nodes, e, n, @WHERE@);",
        "}",
        "TIDE_HELPER tide_entity @P@parent_of(const @W@ *w, tide_entity e)",
        "{",
        "    if (!tide_entity_alive(&w->entities, e)) return (tide_entity){0};",
        "    return @P@hierarchy_get(w, e).parent;",
        "}",
        "TIDE_HELPER bool @P@matrix_finite(tide_float4x4 m)",
        "{",
        "    const tide_float4 c[4] = {m.c0, m.c1, m.c2, m.c3};",
        "    for (int i = 0; i < 4; i++) {",
        "        if (!tide_is_finite_f(c[i].x) || !tide_is_finite_f(c[i].y)",
        "            || !tide_is_finite_f(c[i].z) || !tide_is_finite_f(c[i].w)) return false;",
        "    }",
        "    return true;",
        "}",
        "TIDE_HELPER tide_float4x4 @P@world_transform(const @W@ *w, tide_entity e, tide_quaternion *rotation)",
        "{",
        "    tide_float4x4 result = tide_identity_f4x4();",
        "    tide_quaternion q = tide_identity_q();",
        "    if (rotation) *rotation = q;",
        "    if (!tide_entity_alive(&w->entities, e)) return result;",
        "    if (tide_entity_is_null(@P@parent_of(w, e))) {",
        "        @ROOT_ANCHOR@",
        "        @T@ t;",
        "        if (tide_load_@T@(w, e, &t)) {",
        "            @ROOT_ROTATION@",
        "            @ROOT_MATRIX@",
        "        }",
        "        if (rotation) *rotation = q;",
        "        return result;",
        "    }",
        "    uint32_t count = 0;",
        "    for (tide_entity at = e; !tide_entity_is_null(at); at = @P@parent_of(w, at)) {",
        "        if (!tide_entity_alive(&w->entities, at) || count == w->entities.next_unused) {",
        "            fprintf(stderr, \"tide: invalid transform hierarchy\\n\");",
        "            return result;",
        "        }",
        "        count++;",
        "    }",
        "    if ((uint64_t)count * sizeof(tide_entity) > SIZE_MAX) return result;",
        "    const uint32_t mark = tide_scratch_mark();",
        "    tide_entity *chain = tide_scratch_memory((size_t)count * sizeof(*chain));",
        "    tide_entity at = e;",
        "    for (uint32_t i = 0; i < count; i++) { chain[i] = at; at = @P@parent_of(w, at); }",
        "    @CHAIN_ANCHOR@",
        "    for (uint32_t i = count; i-- > 0;) {",
        "        @T@ t;",
        "        if (!tide_load_@T@(w, chain[i], &t)) continue;",
        "        const tide_quaternion local = tide_normalize_q(t.localRotation);",
        "        result = tide_mul_f4x4(result, tide_trs_f4x4(t.localPosition, local, t.localScale));",
        "        q = tide_normalize_q(tide_mul_q(q, local));",
        "    }",
        "    tide_scratch_reset(mark);",
        "    if (rotation) *rotation = q;",
        "    return result;",
        "}",
        "TIDE_HELPER tide_float4x4 @P@local_to_world(const @W@ *w, tide_entity e)",
        "{",
        "    return @P@world_transform(w, e, NULL);",
        "}",
        "TIDE_HELPER void @P@hierarchy_unlink(@W@ *w, tide_entity e)",
        "{",
        "    tide_hierarchy_node n = @P@hierarchy_get(w, e);",
        "    if (!tide_entity_is_null(n.parent)) {",
        "        tide_hierarchy_node p = @P@hierarchy_get(w, n.parent);",
        "        if (tide_entity_equal(p.first, e)) p.first = n.next;",
        "        @P@hierarchy_put(w, n.parent, p);",
        "    }",
        "    if (!tide_entity_is_null(n.previous)) {",
        "        tide_hierarchy_node previous = @P@hierarchy_get(w, n.previous);",
        "        previous.next = n.next;",
        "        @P@hierarchy_put(w, n.previous, previous);",
        "    }",
        "    if (!tide_entity_is_null(n.next)) {",
        "        tide_hierarchy_node next = @P@hierarchy_get(w, n.next);",
        "        next.previous = n.previous;",
        "        @P@hierarchy_put(w, n.next, next);",
        "    }",
        "    n.parent = n.next = n.previous = (tide_entity){0};",
        "    @P@hierarchy_put(w, e, n);",
        "}",
        "TIDE_HELPER void @P@hierarchy_destroy(@W@ *w, tide_entity root)",
        "{",
        "    if (!tide_entity_alive(&w->entities, root)) return;",
        "    tide_entity at = root;",
        "    uint64_t left = (uint64_t)w->entities.next_unused * 2u + 1u;",
        "    while (left--) {",
        "        const tide_hierarchy_node n = @P@hierarchy_get(w, at);",
        "        if (!tide_entity_is_null(n.first) && tide_entity_alive(&w->entities, n.first)) { at = n.first; continue; }",
        "        const tide_entity parent = n.parent;",
        "        const bool last = tide_entity_equal(at, root);",
        "        @P@destroy_leaf(w, at);",
        "        @REMOVE_ANCHOR@",
        "        @P@hierarchy_unlink(w, at);",
        "        (void)tide_map@M@_remove(&w->@S@.nodes, at, @WHERE@);",
        "        if (last) return;",
        "        if (!tide_entity_alive(&w->entities, parent)) return;",
        "        at = parent;",
        "    }",
        "    fprintf(stderr, \"tide: invalid hierarchy while destroying descendants\\n\");",
        "}",
        "TIDE_HELPER void @P@set_parent_now(@W@ *w, tide_entity child, tide_entity parent, bool keep)",
        "{",
        "    if (!tide_entity_alive(&w->entities, child)",
        "        || (!tide_entity_is_null(parent) && !tide_entity_alive(&w->entities, parent))) {",
        "        fprintf(stderr, \"tide: SetParent rejected: child or parent no longer exists\\n\"); return;",
        "    }",
        "    if (@P@scene_root(w, child) && !tide_entity_is_null(parent)) {",
        "        fprintf(stderr, \"tide: SetParent rejected: a loaded scene is an independent root\\n\"); return;",
        "    }",
        "    uint64_t left = (uint64_t)w->entities.next_unused + 1u;",
        "    for (tide_entity at = parent; !tide_entity_is_null(at); at = @P@parent_of(w, at)) {",
        "        if (!left-- || tide_entity_equal(at, child)) {",
        "            fprintf(stderr, \"tide: SetParent rejected: the parent is the child or one of its descendants\\n\"); return;",
        "        }",
        "    }",
        "    @SAME_PARENT@",
        "    @T@ changed = {0};",
        "    if (keep) {",
        "        if (!tide_load_@T@(w, child, &changed)) {",
        "            fprintf(stderr, \"tide: SetParent rejected: preserving world placement requires a Transform on the child\\n\"); return;",
        "        }",
        "        tide_quaternion oldRotation, parentRotation;",
        "        const tide_float4x4 old = @P@world_transform(w, child, &oldRotation);",
        "        const tide_float4x4 parentWorld = @P@world_transform(w, parent, &parentRotation);",
        "        const tide_float4x4 inverseParent = tide_inverse_f4x4(parentWorld);",
        "        changed.localPosition = tide_transform_f4x4(inverseParent, tide_f3(old.c3.x, old.c3.y, old.c3.z));",
        "        changed.localRotation = tide_normalize_q(tide_mul_q(tide_inverse_q(parentRotation), oldRotation));",
        "        const tide_float4x4 basis = tide_mul_f4x4(parentWorld,",
        "            tide_trs_f4x4(tide_f3(0, 0, 0), changed.localRotation, tide_f3(1, 1, 1)));",
        "        const tide_float4x4 scale = tide_mul_f4x4(tide_inverse_f4x4(basis), old);",
        "        if (!@P@matrix_finite(inverseParent) || !@P@matrix_finite(scale)) {",
        "            fprintf(stderr, \"tide: SetParent rejected: the new parent has a singular or nonfinite world transform\\n\"); return;",
        "        }",
        "        changed.localScale = tide_f3(scale.c0.x, scale.c1.y, scale.c2.z);",
        "        if (!@P@matrix_finite(tide_trs_f4x4(changed.localPosition, changed.localRotation, changed.localScale))) {",
        "            fprintf(stderr, \"tide: SetParent rejected: the resulting local transform is nonfinite\\n\"); return;",
        "        }",
        "    }",
        "    @CLEAR_ANCHOR@",
        "    const tide_entity oldScene = @P@scene_of(w, child);",
        "    const tide_entity newScene = tide_entity_is_null(parent) ? oldScene : @P@scene_of(w, parent);",
        "    @P@hierarchy_unlink(w, child);",
        "    tide_hierarchy_node n = @P@hierarchy_get(w, child);",
        "    n.parent = parent;",
        "    if (!tide_entity_is_null(parent)) {",
        "        tide_hierarchy_node p = @P@hierarchy_get(w, parent);",
        "        n.next = p.first;",
        "        if (!tide_entity_is_null(p.first)) {",
        "            tide_hierarchy_node first = @P@hierarchy_get(w, p.first);",
        "            first.previous = child;",
        "            @P@hierarchy_put(w, p.first, first);",
        "        }",
        "        p.first = child;",
        "        @P@hierarchy_put(w, parent, p);",
        "    }",
        "    @P@hierarchy_put(w, child, n);",
        "    if (keep) tide_store_@T@(w, child, &changed);",
        "    if (!tide_entity_equal(oldScene, newScene)) {",
        "        tide_entity at = child;",
        "        uint64_t remaining = (uint64_t)w->entities.next_unused * 3u + 1u;",
        "        while (remaining--) {",
        "            @P@set_scene(w, at, newScene);",
        "            tide_hierarchy_node current = @P@hierarchy_get(w, at);",
        "            if (!tide_entity_is_null(current.first)) { at = current.first; continue; }",
        "            while (!tide_entity_equal(at, child) && tide_entity_is_null(current.next)) {",
        "                if (!remaining) { fprintf(stderr, \"tide: invalid hierarchy while moving scene membership\\n\"); return; }",
        "                remaining--;",
        "                at = current.parent;",
        "                current = @P@hierarchy_get(w, at);",
        "            }",
        "            if (tide_entity_equal(at, child)) break;",
        "            at = current.next;",
        "        }",
        "    }",
        "}",
    };
    for (int side = 0; side < 2; side++) {
        const decl *state = g->prog->hierarchy[side];
        if (!state) continue;
        const decl *transform = side ? g->prog->transform->local_placement : g->prog->transform;
        sb map = {0};
        sb_printf(&map, "%d", state->fields.items[0].type.decl->index);
        const bool anchors = side == 0 && g->prog->visibility_state;
        sb remove_anchor = {0}, clear_anchor = {0}, same_parent = {0};
        if (!anchors) sb_printf(&same_parent, "if (tide_entity_equal(%sparent_of(w, child), parent)) return;", world_prefix(side != 0));
        if (anchors) {
            const int index = g->prog->visibility_state->fields.items[3].type.decl->index;
            sb_printf(&remove_anchor, "(void)tide_map%d_remove(&w->tide_visibility_state.anchors, at, TIDE_IN_MATCH);", index);
            sb_printf(&clear_anchor, "(void)tide_map%d_remove(&w->tide_visibility_state.anchors, child, TIDE_IN_MATCH);", index);
            sb_printf(&same_parent, "if (tide_entity_equal(tide_parent_of(w, child), parent) && !tide_map%d_has(w->tide_visibility_state.anchors, child)) return;", index);
            sb_printf(&g->c, "TIDE_HELPER bool tide_hierarchy_anchor(const tide_world *w, tide_entity e, tide_float4x4 *matrix, tide_quaternion *rotation)\n{\n"
                       "    if (!tide_map%d_has(w->tide_visibility_state.anchors, e)) return false;\n"
                       "    const tide_visibility_anchor anchor = tide_map%d_get(w->tide_visibility_state.anchors, e);\n"
                       "    *matrix = anchor.matrix;\n    *rotation = anchor.rotation;\n    return true;\n}\n\n",
                      g->prog->visibility_state->fields.items[3].type.decl->index,
                      g->prog->visibility_state->fields.items[3].type.decl->index);
        }
        const char *const keys[] = {"@P@", "@W@", "@S@", "@M@", "@T@", "@WHERE@",
                                   "@ROOT_ANCHOR@", "@ROOT_ROTATION@", "@ROOT_MATRIX@", "@CHAIN_ANCHOR@",
                                   "@REMOVE_ANCHOR@", "@CLEAR_ANCHOR@", "@SAME_PARENT@"};
        const char *const values[] = {world_prefix(side != 0), world_type(side != 0), type_cname(state), map.data,
                                     type_cname(transform), world_where(side != 0),
            anchors ? "const bool anchored = tide_hierarchy_anchor(w, e, &result, &q);" : "",
            anchors ? "const tide_quaternion local = tide_normalize_q(t.localRotation); q = anchored ? tide_normalize_q(tide_mul_q(q, local)) : local;"
                    : "q = tide_normalize_q(t.localRotation);",
            anchors ? "const tide_float4x4 localMatrix = tide_trs_f4x4(t.localPosition, local, t.localScale); result = anchored ? tide_mul_f4x4(result, localMatrix) : localMatrix;"
                    : "result = tide_trs_f4x4(t.localPosition, q, t.localScale);",
            anchors ? "(void)tide_hierarchy_anchor(w, chain[count - 1u], &result, &q);" : "",
            anchors ? remove_anchor.data : "", anchors ? clear_anchor.data : "",
            same_parent.data};
        gen_hierarchy_scenes(g, side != 0);
        for (size_t i = 0; i < sizeof lines / sizeof lines[0]; i++) {
            const char *at = lines[i];
            while (*at) {
                int replacement = -1;
                for (size_t k = 0; k < sizeof keys / sizeof keys[0]; k++) if (strncmp(at, keys[k], strlen(keys[k])) == 0) { replacement = (int)k; break; }
                if (replacement < 0) sb_putn(&g->c, at++, 1);
                else { sb_put(&g->c, values[replacement]); at += strlen(keys[replacement]); }
            }
            sb_put(&g->c, "\n");
        }
    }
}
