using Rooms;

const Color INK = Color(0.06, 0.105, 0.13);
const Color PAPER = Color(0.94, 0.92, 0.82);
const Color DIM = Color(0.57, 0.67, 0.66);
const Color AMBER = Color(1, 0.71, 0.30);
const Color MINT = Color(0.40, 0.94, 0.75);
const Color CORAL = Color(1, 0.43, 0.36);
const Color PANEL = Color(0.085, 0.15, 0.18);
const GUITheme THEME = GUITheme { text = PAPER, panel = PANEL, control = Color(0.15, 0.24, 0.26),
    hot = Color(0.23, 0.34, 0.34), pressed = INK, field = INK, fieldHot = PANEL, accent = MINT, radius = 9 };
enum Art { Prepare, Warehouse, HUD, Sound }
struct Afterimage { float2 from; float2 to; float life; int seat; }
local singleton Desk
{
    int seat = -1;
    int target = -1;
    int serial = -1;
    bool guide;
    bool map;
    bool use;
    bool special;
    float2 stick;
    float2 camera = float2(29, 18);
    float2 origin;
    float zoom = 20;
    float clock;
    float toastTime;
    string toast;
    bool mute;
    Afterimage[10] trails;
    int nextTrail;
    bool autoStarted;
}
Color SparkColor(int seat) { return seat == 0 ? MINT : CORAL; }
string BodyName(Body kind)
{
    switch (kind) { case Body.Cleaner: return "CLEANER"; case Body.Forklift: return "FORKLIFT"; case Body.Camera: return "CAMERA"; }
    return "DOOR CONTROLLER";
}
string MachineName(int i)
{
    switch (i)
    {
        case 0: return "Bubbles"; case 1: return "Squeak"; case 2: return "Dock lifter"; case 3: return "Receiving control";
        case 4: return "Dock eye"; case 5: return "Aisle eye"; case 6: return "Pallet lifter"; case 7: return "Dusty";
        case 8: return "Records eye"; case 9: return "Vault control"; case 10: return "Service eye"; case 11: return "Polish";
        case 12: return "Vault eye"; case 13: return "Shipping control";
    }
    return "Vault lifter";
}
float2 Seen(Desk desk, float2 position) { return desk.origin + (position - desk.camera) * desk.zoom; }
void Text(string words, float2 at, float size = 14, Color tone = PAPER, Anchor anchor = Anchor.MiddleLeft)
{ Draw.Text(words, at, size, tone, anchor); }
void Plate(float2 at, float2 size, Color tone = PANEL, float radius = 12)
{
    Draw.RoundRect(at + float2(0, 5), size, radius, Color(0.02, 0.045, 0.055, 0.65));
    Draw.RoundRect(at, size, radius, tone);
}
bool Button(string words, Rect rect, bool accent = false, bool enabled = true)
{
    mut var hit = false;
    GUI.Disabled(!enabled)
    {
        var c = GUI.Control(rect);
        var at = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
        mut var fill = accent ? MINT : Color(0.15, 0.24, 0.26);
        if (c.hovered || c.focused) fill = Math.Lerp(fill, PAPER, 0.16);
        if (c.pressed) fill = Math.Lerp(fill, INK, 0.25);
        if (!enabled) fill = Color(0.13, 0.18, 0.20);
        Draw.RoundRect(at, float2(rect.width, rect.height), 7, fill);
        Text(words, at, 13, !enabled ? DIM : accent ? INK : PAPER, Anchor.MiddleCenter);
        hit = c.clicked;
    }
    return hit;
}
void WorldRect(Desk desk, Rect rect, Color tone, float lift = 0)
{
    var at = Seen(desk, float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5));
    var size = float2(rect.width, rect.height) * desk.zoom;
    if (lift > 0)
    {
        Draw.Rect(at + float2(4, 7), size + float2(4), Color(0.035, 0.07, 0.08, 0.28));
        Draw.Rect(at + float2(0, lift * 0.5), size + float2(0, lift), Math.Lerp(tone, INK, 0.35));
    }
    Draw.Rect(at - float2(0, lift * 0.5), size, tone);
}
void WorldLabel(Desk desk, string words, float2 at, Color tone = DIM, float size = 12)
{
    if (desk.zoom >= 15) Text(words, Seen(desk, at), size, tone, Anchor.MiddleCenter);
}
void Bolt(float2 at, float size, Color tone)
{
    Draw.Line(at + float2(0.2, -0.7) * size, at + float2(-0.2, 0) * size, size * 0.18, tone);
    Draw.Line(at + float2(-0.2, 0) * size, at + float2(0.2, 0) * size, size * 0.18, tone);
    Draw.Line(at + float2(0.2, 0) * size, at + float2(-0.2, 0.7) * size, size * 0.18, tone);
}
[Stage(Art.Prepare)]
[Before(Rooms.Begin, Rooms.Pages)]
view Prepare(Heist heist, Session session, mut Desk desk)
{
    GUI.SetTheme(THEME);
    desk.seat = Seat(heist, session.player);
    desk.clock += Math.Min(Frame.dt, 0.1);
    if (desk.clock > 100) desk.clock -= 100;
    desk.toastTime = Math.Max(0, desk.toastTime - Frame.dt);
    for (var i = 0; i < 10; i++) desk.trails[i].life = Math.Max(0, desk.trails[i].life - Frame.dt);
    if (desk.serial != heist.serial)
    {
        desk.serial = heist.serial;
        desk.target = -1;
        desk.autoStarted = false;
        desk.map = false;
        desk.guide = false;
    }
    desk.origin = float2(Screen.width * 0.5, (Screen.height - 2) * 0.5);
    if (desk.map) desk.origin.y -= 46;
    desk.zoom = desk.map || !heist.started ? Math.Min((Screen.width - 50) / 58, (Screen.height - (desk.map ? 275.0 : 190.0)) / 36)
        : Math.Clamp(Math.Min(Screen.width / 30, (Screen.height - 170) / 20), 13, 34);
    if (desk.map || !heist.started) desk.camera = float2(29, 18);
    else if (desk.seat >= 0)
    {
        var at = heist.machines[heist.possessed[desk.seat]].position;
        var hx = (Screen.width * 0.5 - 20) / desk.zoom;
        var hy = (Screen.height - 190) * 0.5 / desk.zoom;
        var wanted = float2(Math.Clamp(at.x, hx, Math.Max(hx, 58 - hx)), Math.Clamp(at.y, hy, Math.Max(hy, 36 - hy)));
        if (Math.Length(wanted - desk.camera) > 12) desk.camera = wanted;
        else desk.camera = Math.Lerp(desk.camera, wanted, Math.Min(1, Frame.dt * 8));
    }
}
local event(Pulse pulse) Feel(mut Desk desk)
{
    if (pulse.kind == Beat.Jump)
    {
        desk.trails[desk.nextTrail] = Afterimage { from = pulse.from, to = pulse.at, life = 0.5, seat = pulse.seat };
        desk.nextTrail = (desk.nextTrail + 1) % 10;
    }
    if (pulse.kind == Beat.Caught) { desk.toast = "BUSTED! Body rebooting. Your spark escaped to another machine."; desk.toastTime = 4; }
    if (pulse.kind == Beat.Unlock) { desk.toast = "Good work. The warehouse remembers what you changed."; desk.toastTime = 3; }
}
void DrawPallet(Desk desk, float2 at, bool lifted)
{
    var p = Seen(desk, at);
    var z = desk.zoom;
    var up = lifted ? 10.0 : 3.0;
    Draw.RoundRect(p + float2(4, 5), float2(z * 1.8), 3, Color(0.03, 0.06, 0.07, 0.35));
    Draw.Rect(p + float2(0, 3), float2(z * 1.7, z * 1.7 + up), Color(0.42, 0.26, 0.15));
    Draw.Rect(p - float2(0, up), float2(z * 1.7), Color(0.72, 0.52, 0.29));
    for (var i = -1; i <= 1; i++) Draw.Line(p + float2(i * z * 0.48, -z * 0.8 - up), p + float2(i * z * 0.48, z * 0.8 - up), 2, Color(0.51, 0.35, 0.20));
    Draw.Rect(p - float2(0, up), float2(z * 1.4, 3), Color(0.87, 0.69, 0.41));
}
void DrawBody(Heist heist, Desk desk, int index)
{
    var m = heist.machines[index];
    var at = Seen(desk, m.position);
    var z = desk.zoom;
    var who = Occupant(heist, index);
    mut var tone = who < 0 ? PAPER : SparkColor(who);
    if (m.offline > 0) tone = DIM;
    var dir = m.facing;
    var side = float2(-dir.y, dir.x);
    var angle = Math.Atan2(dir.y, dir.x);
    var reach = Reachable(heist, desk.seat, index);
    if (reach)
    {
        Draw.Circle(at, z * 1.3, Color(MINT.r, MINT.g, MINT.b, 0.055));
        Draw.WireCircle(at, z * 1.2, desk.target == index ? 2.5 : 1, desk.target == index ? PAPER : Color(0.40, 0.94, 0.75, 0.46));
    }
    if (who >= 0)
    {
        Draw.Circle(at, z * 1.1, Color(tone.r, tone.g, tone.b, 0.09));
        Draw.WireCircle(at, z * (1.02 + Math.Sin(desk.clock * 5) * 0.04), 2, tone);
    }
    Draw.RoundRect(at + float2(4, 6), float2(z * (m.kind == Body.Forklift ? 2.1 : 1.3), z * 1.25), z * 0.3, Color(0.025, 0.06, 0.07, 0.36));
    if (m.kind == Body.Cleaner)
    {
        var raised = m.raised > 0 ? 9.0 : 0.0;
        var p = at - float2(0, raised);
        Draw.Circle(p + float2(0, 3), z * 0.63, Color(0.27, 0.40, 0.41));
        Draw.Circle(p, z * 0.63, tone);
        Draw.WireCircle(p, z * 0.49, 2, Color(0.66, 0.74, 0.66));
        Draw.Circle(p + dir * z * 0.24 + side * z * 0.15, z * 0.085, INK);
        Draw.Circle(p + dir * z * 0.24 - side * z * 0.15, z * 0.085, INK);
        Draw.Line(p - dir * z * 0.58, p - dir * z * 0.85 + side * z * 0.25, 2, DIM);
        Draw.Line(p - dir * z * 0.58, p - dir * z * 0.85 - side * z * 0.25, 2, DIM);
        if (m.cooldown > 0) Draw.Circle(p - dir * z * 0.6, z * 0.13, MINT);
    }
    else if (m.kind == Body.Forklift)
    {
        Draw.RoundRect(at, float2(z * 1.9, z * 1.35), 3, angle, Color(0.14, 0.22, 0.23));
        Draw.RoundRect(at - float2(0, 3), float2(z * 1.6, z * 1.3), 4, angle, AMBER);
        Draw.RoundRect(at - float2(0, 5), float2(z * 0.6, z * 0.85), 3, angle, Color(0.18, 0.30, 0.32));
        for (var p = -1; p <= 1; p += 2)
            Draw.Line(at + dir * z * 0.65 + side * z * 0.42 * p, at + dir * z * 1.5 + side * z * 0.42 * p, z * 0.12, PAPER);
        Draw.Circle(at - dir * z * 0.6 - float2(0, 5), z * 0.16, who >= 0 ? tone : CORAL);
        if (m.cargo >= 0) Draw.WireCircle(at + dir * z * 1.2, z * 0.65, 1, AMBER);
    }
    else if (m.kind == Body.Camera)
    {
        Draw.Line(at + float2(0, z * 0.7), at - float2(0, z * 0.4), 5, Color(0.31, 0.42, 0.41));
        Draw.RoundRect(at - float2(0, 5), float2(z * 1.3, z * 0.8), 3, angle, tone);
        Draw.Circle(at + dir * z * 0.48 - float2(0, 5), z * 0.24, INK);
        Draw.Circle(at + dir * z * 0.52 - float2(0, 5), z * 0.12, MINT);
        if (who >= 0)
        {
            Draw.Line(at + dir * z, at + (dir * 7 + side * 3) * z, 1, Color(0.40, 0.94, 0.75, 0.30));
            Draw.Line(at + dir * z, at + (dir * 7 - side * 3) * z, 1, Color(0.40, 0.94, 0.75, 0.30));
        }
        if (m.flash > 0) Draw.Circle(at, z * (2 - m.flash * 3), Color(1, 0.96, 0.8, m.flash));
    }
    else
    {
        Draw.RoundRect(at, float2(z * 1.3, z * 1.6), 3, Color(0.24, 0.35, 0.35));
        Draw.RoundRect(at - float2(0, 4), float2(z * 1.3, z * 1.5), 3, tone);
        Draw.Rect(at - float2(0, z * 0.18 + 4), float2(z * 0.88, z * 0.58), INK);
        Bolt(at - float2(0, z * 0.18 + 4), z * 0.27, MINT);
        Draw.Circle(at + float2(-z * 0.25, z * 0.32 - 4), z * 0.08, CORAL);
        Draw.Circle(at + float2(z * 0.25, z * 0.32 - 4), z * 0.08, MINT);
    }
    if ((who >= 0 || desk.target == index || desk.map) && desk.zoom > 10)
    {
        var text = m.offline > 0 ? $"REBOOT {int(m.offline) + 1}s" : who >= 0 ? (who == desk.seat ? "YOU" : "FRIEND") : MachineName(index);
        var width = Draw.MeasureText(text, 10).x + 14;
        var p = at + float2(0, -z * 1.4 - 4);
        Draw.RoundRect(p, float2(width, 19), 4, INK);
        Text(text, p, 10, who >= 0 ? tone : PAPER, Anchor.MiddleCenter);
    }
}
[Stage(Art.Warehouse)]
view Warehouse(Heist heist, Desk desk)
{
    Draw.SetScreen();
    Draw.Clear(INK);
    Draw.Clip(Rect(0, 88, Screen.width, Math.Max(1, Screen.height - 178)))
    {
        WorldRect(desk, Rect(0, 0, 58, 36), Color(0.16, 0.23, 0.25));
        WorldRect(desk, Rect(1, 1, 15, 34), Color(0.31, 0.40, 0.38));
        WorldRect(desk, Rect(16.7, 1, 25.3, 34), Color(0.39, 0.45, 0.41));
        WorldRect(desk, Rect(42.7, 1, 14.3, 34), Color(0.31, 0.39, 0.42));
        for (var x = 1; x < 58; x += 2)
            Draw.Line(Seen(desk, float2(x, 1)), Seen(desk, float2(x, 35)), 1, Color(0.91, 0.91, 0.79, 0.04));
        for (var y = 1; y < 36; y += 2)
            Draw.Line(Seen(desk, float2(1, y)), Seen(desk, float2(57, y)), 1, Color(0.91, 0.91, 0.79, 0.04));
        WorldRect(desk, Rect(2, 25, 7, 9), Color(0.23, 0.46, 0.37));
        Draw.WireRect(Seen(desk, float2(5.5, 29.5)), float2(7, 9) * desk.zoom, 2, MINT);
        WorldLabel(desk, "GETAWAY", float2(5.5, 32), MINT, 14);
        WorldLabel(desk, "RECEIVING", float2(8, 14), PAPER, 17);
        WorldLabel(desk, "NIGHT SHIFT", float2(28, 33), PAPER, 17);
        WorldLabel(desk, "STORM STORAGE", float2(50, 14), PAPER, 16);
        // Paint and cable paths connect the interactive parts of the warehouse.
        for (var x = 5; x < 55; x += 2)
        {
            Draw.Line(Seen(desk, float2(x, 18.5)), Seen(desk, float2(x + 1, 18.5)), 2, Color(1, 0.71, 0.30, 0.36));
            WorldRect(desk, Rect(x, 28.5, 1.6, 2.6), Color(0.15, 0.23, 0.25));
            for (var y = 29; y <= 31; y++) Draw.Line(Seen(desk, float2(x, y)), Seen(desk, float2(x + 1.5, y)), 1, Color(0.39, 0.51, 0.49));
            var shift = heist.belt && !heist.won ? (desk.clock * 2.8 - Math.Floor(desk.clock * 1.4) * 2) : 0.0;
            var arrow = Seen(desk, float2(x - shift + 1, 29.8));
            Draw.Line(arrow + float2(4, -4), arrow, 2, heist.belt ? MINT : DIM);
            Draw.Line(arrow + float2(4, 4), arrow, 2, heist.belt ? MINT : DIM);
        }
        WorldLabel(desk, "SHIPPING BELT", float2(36, 32.6), heist.belt ? MINT : DIM);
        for (var i = 0; i < WALLS; i++)
        {
            var wall = Wall(i);
            var rack = i >= 8;
            WorldRect(desk, wall, rack ? Color(0.30, 0.40, 0.40) : Color(0.19, 0.31, 0.34), rack ? 9.0 : 5.0);
            if (rack)
            {
                for (var y = wall.y + 0.5; y < wall.y + wall.height; y += 1.2)
                    for (var x = wall.x + 0.45; x < wall.x + wall.width; x += 1.05)
                    {
                        var tone = (int(x + y) % 3) == 0 ? Color(0.75, 0.54, 0.31) : Color(0.66, 0.59, 0.41);
                        WorldRect(desk, Rect(x, y, 0.72, 0.78), tone, 6);
                    }
                Draw.Line(Seen(desk, float2(wall.x, wall.y)), Seen(desk, float2(wall.x, wall.y + wall.height)), 3, AMBER);
            }
        }
        for (var g = 0; g < 3; g++)
        {
            var gate = Gateway(g);
            var tone = heist.doors[g] ? MINT : heist.lockdown ? CORAL : AMBER;
            WorldRect(desk, gate, Color(tone.r, tone.g, tone.b, heist.doors[g] ? 0.12 : 0.7), heist.doors[g] ? 0.0 : 4.0);
            for (var y = gate.y; y < gate.y + gate.height; y += 0.4)
                Draw.Line(Seen(desk, float2(gate.x, y)), Seen(desk, float2(gate.x + gate.width, y + 0.2)), 1, tone);
        }
        WorldRect(desk, Rect(40.5, 13.2, 4.5, 1.4), Color(0.23, 0.31, 0.33), 7);
        for (var x = 41; x <= 44; x++)
            Draw.Line(Seen(desk, float2(x, 13.2)) - float2(0, 7), Seen(desk, float2(x, 14.6)) - float2(0, 7), 1, DIM);
        WorldLabel(desk, "LIFT TO CATWALK", float2(42.5, 12.5), AMBER, 10);
        for (var x = 16; x <= 42; x += 26)
        {
            WorldRect(desk, Rect(x, 5, 0.7, 3), Color(0.08, 0.16, 0.18));
            for (var y = 5.25; y < 8; y += 0.45)
                Draw.Line(Seen(desk, float2(x, y)), Seen(desk, float2(x + 0.7, y)), 2, DIM);
            WorldLabel(desk, "DUCT", float2(x, 8.8), MINT, 10);
        }
        WorldRect(desk, Rect(36.5, 9.5, 3, 3), VaultPower(heist) ? Color(0.25, 0.58, 0.41) : Color(0.64, 0.47, 0.24));
        WorldLabel(desk, "WEIGHT = POWER", float2(38, 8.5), AMBER);
        Bolt(Seen(desk, float2(38, 11)), desk.zoom * 0.8, VaultPower(heist) ? MINT : INK);
        WorldRect(desk, Rect(29.2, 3.2, 1.6, 1.6), heist.manifest ? MINT : AMBER, 5);
        WorldLabel(desk, "MANIFEST", float2(30, 2.4), heist.manifest ? MINT : AMBER);
        WorldRect(desk, Rect(48.2, 5.2, 1.6, 1.6), heist.bypass ? MINT : AMBER, 5);
        WorldLabel(desk, "POWER BYPASS", float2(49, 4.3), heist.bypass ? MINT : AMBER);
        // Fixed wired hosts share long-distance possession links.
        for (var i = 0; i < MACHINES; i++)
        {
            var m = heist.machines[i];
            if (int(m.kind) < int(Body.Camera)) continue;
            for (var j = i + 1; j < MACHINES; j++)
            {
                var n = heist.machines[j];
                if (int(n.kind) < int(Body.Camera) || n.circuit != m.circuit) continue;
                var corner = float2(m.position.x, n.position.y);
                var color = Color(0.40, 0.94, 0.75, 0.24);
                Draw.Line(Seen(desk, m.position), Seen(desk, corner), 2, color);
                Draw.Line(Seen(desk, corner), Seen(desk, n.position), 2, color);
            }
        }
        for (var i = 0; i < 12; i++)
            if (heist.slicks[i].life > 0)
            {
                var at = Seen(desk, heist.slicks[i].position);
                Draw.RoundRect(at, float2(2.4, 1.6) * desk.zoom, desk.zoom * 0.7, Color(0.49, 0.84, 0.78, Math.Min(0.4, heist.slicks[i].life * 0.08)));
                for (var b = 0; b < 4; b++) Draw.WireCircle(at + float2(Math.Sin(b * 8.1), Math.Cos(b * 5.2)) * desk.zoom * 0.6, desk.zoom * 0.12, 1, MINT);
            }
        for (var p = 0; p < PALLETS; p++) DrawPallet(desk, heist.pallets[p], Carried(heist, p));
        for (var g = 0; g < 2; g++)
        {
            var guard = heist.guards[g];
            var p = Seen(desk, guard.position);
            var z = desk.zoom;
            var dir = guard.facing;
            var side = float2(-dir.y, dir.x);
            var tone = guard.notice > 0.75 ? CORAL : AMBER;
            if (guard.stun <= 0)
            {
                mut List<Vertex> cone = [Vertex { position = p, color = Color(tone.r, tone.g, tone.b, 0.11) }];
                mut List<int> triangles = [];
                for (var ray = -4; ray <= 4; ray++)
                {
                    var way = Math.Normalize(dir + side * float(ray) * 0.16);
                    mut var length = 0.0;
                    for (var step = 1; step <= 16; step++)
                    {
                        var next = guard.position + way * (step * 0.5);
                        if (!Sight(heist, guard.position, next)) break;
                        length = step * 0.5;
                    }
                    cone.Add(Vertex { position = Seen(desk, guard.position + way * length), color = Color(tone.r, tone.g, tone.b, 0.11) });
                    if (ray > -4) { triangles.Add(0); triangles.Add(ray + 4); triangles.Add(ray + 5); }
                }
                Draw.Mesh(cone, triangles);
            }
            Draw.Circle(p + float2(3, 5), z * 0.65, Color(0.03, 0.06, 0.07, 0.35));
            Draw.RoundRect(p, float2(z * 0.9, z * 1.2), z * 0.25, Math.Atan2(dir.y, dir.x), Color(0.14, 0.24, 0.30));
            Draw.Circle(p - float2(0, 4), z * 0.32, Color(0.82, 0.64, 0.44));
            Draw.RoundRect(p - float2(0, 7), float2(z * 0.8, z * 0.45), z * 0.12, Color(0.10, 0.18, 0.24));
            Draw.Circle(p + dir * z * 0.65, z * 0.12, PAPER);
            if (guard.stun > 0) Text("* * *", p - float2(0, z * 1.2), 14, MINT, Anchor.MiddleCenter);
            else if (guard.notice > 0) Text(guard.notice > 0.75 ? "!" : "?", p - float2(0, z * 1.2), 22, tone, Anchor.MiddleCenter);
        }
        for (var i = 0; i < MACHINES; i++) DrawBody(heist, desk, i);
        var loot = Seen(desk, heist.loot);
        var z = desk.zoom;
        Draw.Circle(loot, z * 1.4, Color(0.40, 0.94, 0.75, 0.12));
        Draw.RoundRect(loot + float2(0, 3), float2(z * 1.6, z), 4, INK);
        Draw.RoundRect(loot - float2(0, 3), float2(z * 1.5, z), 4, heist.released ? MINT : Color(0.30, 0.43, 0.45));
        Draw.Rect(loot - float2(0, 3), float2(z * 0.9, z * 0.65), INK);
        Bolt(loot - float2(0, 3), z * 0.4, heist.released ? MINT : AMBER);
        WorldLabel(desk, heist.released ? "THE STORM" : "CLAMPED", heist.loot + float2(0, -1.4), heist.released ? MINT : AMBER);
        for (var i = 0; i < 10; i++)
        {
            var trail = desk.trails[i];
            if (trail.life <= 0) continue;
            var tone = SparkColor(trail.seat);
            var from = Seen(desk, trail.from);
            var to = Seen(desk, trail.to);
            var middle = (from + to) * 0.5 + float2(0, -12);
            Draw.Line(from, middle, 2 + trail.life * 4, Color(tone.r, tone.g, tone.b, trail.life * 1.8));
            Draw.Line(middle, to, 2 + trail.life * 4, Color(tone.r, tone.g, tone.b, trail.life * 1.8));
            Draw.WireCircle(to, (0.5 - trail.life) * 70 + 10, 2, Color(tone.r, tone.g, tone.b, trail.life));
        }
    }
}

override string Rooms.Tagline() { return "Electrical thieves. Borrowed bodies. One very portable storm."; }
override Rect Rooms.MenuButton(float2 screen) { return Rect(screen.x - 84, 24, 64, 34); }
override void Rooms.TitlePage(Session session, mut Rooms.Lobby lobby)
{
    Draw.SetScreen();
    var width = Math.Min(Screen.width - 36, 610);
    var at = float2(Screen.width * 0.5, Screen.height * 0.5);
    Plate(at, float2(width, 390));
    Draw.WireRoundRect(at, float2(width, 390), 12, 1, Color(0.32, 0.51, 0.48));
    Text("NIGHT SHIFT / WAREHOUSE 09", at + float2(0, -150), 12, MINT, Anchor.MiddleCenter);
    Text("HOT SWAP", at + float2(0, -96), Screen.width < 600 ? 44.0 : 62.0, PAPER, Anchor.MiddleCenter);
    Text("Electrical thieves. Borrowed bodies.", at + float2(0, -42), 19, AMBER, Anchor.MiddleCenter);
    Text("Steal the captive storm. Improvise your way out.", at + float2(0, -8), Screen.width < 550 ? 13.0 : 16.0, DIM, Anchor.MiddleCenter);
    Text("Cleaners / forklifts / cameras / door controllers", at + float2(0, 22), Screen.width < 550 ? 11.0 : 14.0, DIM, Anchor.MiddleCenter);
    var x = at.x - width * 0.5 + 28;
    var third = (width - 72) / 3;
    var connected = session.state == SessionState.Connected;
    if (Button("Play solo", Rect(x, at.y + 64, third, 48), true, connected)) Rooms.Play(lobby);
    if (Button("Host a friend", Rect(x + third + 8, at.y + 64, third, 48), false, connected))
    { Rooms.Host(lobby); lobby.page = Rooms.Page.Playing; }
    if (Button("Join a friend", Rect(x + (third + 8) * 2, at.y + 64, third, 48))) Rooms.ShowJoin(lobby);
    Text(lobby.message != "" ? lobby.message : "1-2 PLAYERS / THREE ESCAPE ROUTES / NO HARD TIMER", at + float2(0, 150), Screen.width < 550 ? 9.0 : 11.0, DIM, Anchor.MiddleCenter);
}
string Objective(Heist heist)
{
    if (heist.won) return "STORM LIBERATED";
    if (heist.lockdown) return "GET THE STORM TO THE GETAWAY";
    if (!heist.manifest) return "COPY THE SHIPPING MANIFEST";
    if (!VaultPower(heist)) return "POWER THE VAULT CLAMP";
    return "TAKE THE STORM CASE";
}
string Hint(Heist heist)
{
    if (heist.lockdown) return "Shutters closed! Reopen them, use the ducts, or reverse the shipping belt.";
    if (!heist.manifest) return "Records eye: face right and hold E to scan. A mobile body can read it up close.";
    if (!VaultPower(heist)) return "Drop a pallet on the amber power plate, or take a cleaner to the service bypass.";
    return "E near the case to carry it. The theft triggers a search. Plan your exit first.";
}
string UseHint(Heist heist, int index)
{
    var m = heist.machines[index];
    if (m.kind == Body.Camera) return !heist.manifest && index == 8 ? "HOLD E: scan manifest / SPACE: flash guards" : "WASD: aim / SPACE: flash and distract";
    if (m.kind == Body.Controller) return "E: latch shutter / SPACE: reverse shipping belt";
    if (!heist.manifest && Math.Length(m.position - float2(30, 4)) < 2.3) return "E: copy shipping manifest";
    if (m.kind == Body.Cleaner && Math.Length(m.position - float2(49, 6)) < 2.3) return "E: bypass the vault power clamp";
    if (m.cargo >= 0) return m.kind == Body.Cleaner ? "E: drop case / SPACE: leave slippery foam" : "E: drop cargo / SPACE: horn + lift nearby cleaner";
    if (Math.Length(m.position - heist.loot) < 2.6) return heist.released ? "E: take the storm. Get ready to run!" : "Case locked: copy manifest + power the clamp";
    return m.kind == Body.Cleaner ? "E: tow case / SPACE: leave slippery foam" : "E: lift pallet or case / SPACE: horn + lift nearby cleaner";
}
void MiniMap(Heist heist, Desk desk)
{
    var origin = float2(Screen.width - 190, 105);
    var scale = 2.7;
    Plate(origin + float2(78, 49), float2(176, 118));
    Draw.Rect(origin + float2(29, 18) * scale, float2(58, 36) * scale, Color(0.21, 0.31, 0.31));
    for (var w = 0; w < WALLS; w++)
    {
        var r = Wall(w);
        Draw.Rect(origin + float2(r.x + r.width * 0.5, r.y + r.height * 0.5) * scale, float2(r.width, r.height) * scale, INK);
    }
    Draw.Rect(origin + float2(5.5, 29.5) * scale, float2(7, 9) * scale, Color(0.29, 0.62, 0.44));
    for (var i = 0; i < MACHINES; i++)
        Draw.Circle(origin + heist.machines[i].position * scale, 2, Reachable(heist, desk.seat, i) ? MINT : DIM);
    for (var s = 0; s < 2; s++)
        if (heist.present[s]) Draw.Circle(origin + heist.machines[heist.possessed[s]].position * scale, 4, SparkColor(s));
    for (var g = 0; g < 2; g++) Draw.Circle(origin + heist.guards[g].position * scale, 3, CORAL);
    Draw.Circle(origin + heist.loot * scale, 3, AMBER);
}
[Stage(Art.HUD)]
[Before(Rooms.Pages)]
view HUD(Heist heist, Session session, Devices devices, mut Desk desk, mut Rooms.Lobby lobby)
{
    Draw.SetScreen();
    lobby.seats = 2;
    lobby.manned = (heist.present[0] ? 1 : 0) | (heist.present[1] ? 2 : 0);
    lobby.mine = desk.seat;
    lobby.offersNewGame = true;
    lobby.offersBots = false;
    desk.use = false;
    desk.special = false;
    desk.stick = float2(0);
    if (lobby.page != Rooms.Page.Playing) return;
    if (lobby.playing && desk.seat >= 0 && !heist.started && !desk.autoStarted)
    { Send(BeginHeist { serial = heist.serial }); desk.autoStarted = true; }
    var keys = devices.keyboard;
    var playing = lobby.playing && desk.seat >= 0;
    // The HUD claims keyboard navigation, so it supplies the held controls to
    // Sample explicitly. The sample still owns gamepad input and bool edges.
    if (playing) GUI.ClaimKeyboard();
    if (playing && keys.escape.down)
    {
        if (desk.guide) desk.guide = false;
        else if (desk.map) desk.map = false;
        else { lobby.page = Rooms.Page.Room; lobby.resume = true; }
    }
    if (playing && keys.m.down) desk.map = !desk.map;
    if (playing && keys.h.down) desk.guide = !desk.guide;
    if (playing && keys.v.down) desk.mute = !desk.mute;
    if (playing && !desk.guide && !desk.map && !heist.won)
    {
        desk.stick = float2((keys.d.pressed || keys.rightArrow.pressed ? 1 : 0) - (keys.a.pressed || keys.leftArrow.pressed ? 1 : 0),
            (keys.s.pressed || keys.downArrow.pressed ? 1 : 0) - (keys.w.pressed || keys.upArrow.pressed ? 1 : 0));
        desk.use = keys.e.pressed;
        desk.special = keys.space.pressed;
    }
    Draw.Rect(float2(Screen.width * 0.5, 44), float2(Screen.width, 88), INK);
    Text("HOT SWAP", float2(24, 26), 21, PAPER);
    Text(Objective(heist), float2(24, 59), Screen.width < 680 ? 12.0 : 15.0, MINT);
    var minutes = int(heist.elapsed) / 60;
    var seconds = int(heist.elapsed) % 60;
    Text($"{minutes}:{(seconds < 10 ? "0" : "")}{seconds} / {heist.swaps} swaps", float2(Screen.width * 0.53, 26), 12, DIM, Anchor.MiddleCenter);
    if (Screen.width > 720)
    {
        var bar = float2(Screen.width * 0.53, 59);
        Draw.RoundRect(bar, float2(150, 8), 4, PANEL);
        Draw.RoundRect(bar - float2((100 - heist.alarm) * 0.75, 0), float2(heist.alarm * 1.5, 8), 4, heist.alarm > 65 ? CORAL : AMBER);
        Text(heist.lockdown ? "SEARCH ACTIVE" : "SUSPICION", bar + float2(0, 15), 9, heist.lockdown ? CORAL : DIM, Anchor.MiddleCenter);
    }
    if (Button(desk.map ? "Close map" : "Map M", Rect(Screen.width - 262, 24, 84, 34))) desk.map = !desk.map;
    if (Button("Help H", Rect(Screen.width - 170, 24, 76, 34))) desk.guide = !desk.guide;
    if (session.room != "" && Screen.width > 650)
    {
        if (Button($"ROOM {session.room} / copy", Rect(Screen.width - 250, 65, 230, 26))) Clipboard.Copy(session.room);
    }
    if (Screen.width > 850 && !desk.map) MiniMap(heist, desk);
    if (!desk.map && !desk.guide && !heist.won && Screen.width > 750)
    {
        var width = Math.Min(Screen.width - 245, 670);
        var at = float2(width * 0.5 + 16, 119);
        Plate(at, float2(width, 44));
        Text(Hint(heist), at, 11, DIM, Anchor.MiddleCenter);
    }
    if (desk.seat >= 0)
    {
        var active = heist.possessed[desk.seat];
        var machine = heist.machines[active];
        var tone = SparkColor(desk.seat);
        var panelWidth = Math.Min(Screen.width - 32, 720);
        var at = float2(Screen.width * 0.5, Screen.height - 48);
        Plate(at, float2(panelWidth, 76));
        Draw.Circle(at + float2(-panelWidth * 0.5 + 30, -11), 6, tone);
        Text($"{MachineName(active)} / {BodyName(machine.kind)}", at + float2(-panelWidth * 0.5 + 46, -11), 14, tone);
        Text(UseHint(heist, active), at + float2(-panelWidth * 0.5 + 22, 15), Screen.width < 700 ? 10.0 : 12.0, PAPER);
        if (Screen.width > 950) Text("CLICK TO POSSESS / TAB TO PICK / Q TO JUMP", float2(Screen.width - 24, Screen.height - 9), 9, DIM, Anchor.MiddleRight);
        if (!desk.guide && !heist.won)
        {
            var pointer = Screen.Flip(devices.pointer.position);
            mut var closest = 40.0;
            mut var hovered = -1;
            for (var i = 0; i < MACHINES; i++)
            {
                if (!Reachable(heist, desk.seat, i)) continue;
                var distance = Math.Length(Seen(desk, heist.machines[i].position) - pointer);
                if (distance < closest) { closest = distance; hovered = i; }
            }
            if (hovered >= 0) desk.target = hovered;
            if (playing && keys.tab.down)
            {
                for (var offset = 1; offset <= MACHINES; offset++)
                {
                    var next = (desk.target + offset + MACHINES) % MACHINES;
                    if (Reachable(heist, desk.seat, next)) { desk.target = next; break; }
                }
            }
            if (!Reachable(heist, desk.seat, desk.target)) desk.target = -1;
            if (playing && !desk.map && (keys.q.down || devices.gamepad.buttonNorth.down) && desk.target < 0)
            {
                mut var distance = 999.0;
                for (var i = 0; i < MACHINES; i++)
                {
                    var away = Math.Length(machine.position - heist.machines[i].position);
                    if (Reachable(heist, desk.seat, i) && away < distance) { distance = away; desk.target = i; }
                }
            }
            if (playing && desk.target >= 0 && (keys.q.down || devices.gamepad.buttonNorth.down || hovered >= 0 && devices.pointer.press.down && pointer.y > 92 && pointer.y < Screen.height - 100))
                Send(Jump { serial = heist.serial, target = desk.target });
            if (desk.target >= 0)
            {
                var target = heist.machines[desk.target];
                var point = Seen(desk, target.position);
                if (point.x < 20 || point.x > Screen.width - 20 || point.y < 110 || point.y > Screen.height - 120)
                    Text($"Q: {MachineName(desk.target)} (wired)", float2(Screen.width * 0.5, 116), 13, MINT, Anchor.MiddleCenter);
            }
            if (machine.kind == Body.Camera && heist.scan[desk.seat] > 0)
            {
                var scanAt = Seen(desk, machine.position) + float2(0, 40);
                Plate(scanAt, float2(160, 36));
                Text($"SCANNING {int(Math.Min(100, heist.scan[desk.seat] / 3 * 100))}%", scanAt, 12, MINT, Anchor.MiddleCenter);
            }
        }
    }
    if (desk.map)
    {
        var width = Math.Min(Screen.width - 24, 750);
        var at = float2(Screen.width * 0.5, Screen.height - 142);
        Plate(at, float2(width, 74));
        Text("HEIST PLAN / manifest + power = free storm", at - float2(0, 17), 14, AMBER, Anchor.MiddleCenter);
        Text("1. cleaner ducts   2. loading shutters   3. reversed shipping belt", at + float2(0, 9), Screen.width < 650 ? 10.0 : 13.0, PAPER, Anchor.MiddleCenter);
    }
    if (desk.toastTime > 0 && !desk.guide)
    {
        var width = Math.Min(Screen.width - 30, 640);
        var at = float2(Screen.width * 0.5, Screen.height - 112);
        Plate(at, float2(width, 35));
        Text(desk.toast, at, Screen.width < 720 ? 10.0 : 12.0, AMBER, Anchor.MiddleCenter);
    }
    if (desk.guide)
    {
        var width = Math.Min(Screen.width - 30, 650);
        var at = float2(Screen.width * 0.5, Screen.height * 0.5);
        Plate(at, float2(width, 380));
        var x = at.x - width * 0.5 + 26;
        Text("BORROW A BODY. LEAVE A PLAN.", float2(x, at.y - 148), 21, MINT);
        Text("WASD / arrows move. Click a glowing machine to possess it.", float2(x, at.y - 108), 13);
        Text("Tab selects a body; Q jumps. M opens the whole warehouse map.", float2(x, at.y - 79), 13);
        Text("Nearby jumps need a clear path. Wired hosts jump across their circuit.", float2(x, at.y - 50), 12, DIM);
        Text("CLEANER: E tow / SPACE foam. Small enough for the upper ducts.", float2(x, at.y - 12), 13);
        Text("FORKLIFT: E lift/drop / SPACE horn + lift a nearby cleaner.", float2(x, at.y + 17), 13);
        Text("CAMERA: WASD aim / hold E scan / SPACE flash nearby guards.", float2(x, at.y + 46), 13);
        Text("CONTROLLER: E latch shutter / SPACE reverse the shipping belt.", float2(x, at.y + 75), 13);
        Text("Solo: settings stay put. Together: split jobs and swap roles.", float2(x, at.y + 109), 12, AMBER);
        Text("Captured sparks escape. V mutes. Esc opens the room menu.", float2(x, at.y + 136), 12, DIM);
        if (Button("Back to the heist", Rect(at.x - 90, at.y + 155, 180, 30), true)) desk.guide = false;
    }
    if (heist.won)
    {
        var at = float2(Screen.width * 0.5, Screen.height * 0.5);
        var width = Math.Min(Screen.width - 32, 520);
        Plate(at, float2(width, 292));
        Text("ONE STORM. ZERO RECEIPTS.", at - float2(0, 92), 12, AMBER, Anchor.MiddleCenter);
        Text("HEIST COMPLETE", at - float2(0, 49), 34, MINT, Anchor.MiddleCenter);
        var route = heist.route == 1 ? "Maintenance ducts" : heist.route == 3 ? "Shipping conveyor" : "Loading shutters";
        Text($"{minutes}:{(seconds < 10 ? "0" : "")}{seconds} / {heist.swaps} swaps / {heist.catches} captures", at - float2(0, 5), 15, PAPER, Anchor.MiddleCenter);
        Text($"Escape: {route}", at + float2(0, 26), 14, AMBER, Anchor.MiddleCenter);
        Text("Try another route. Trade bodies with a friend.", at + float2(0, 60), 13, DIM, Anchor.MiddleCenter);
        if (Button("Another heist", Rect(at.x - 100, at.y + 91, 200, 38), true)) Send(Restart { serial = heist.serial });
    }
}

// Rooms clears its button requests in Begin and raises them in Pages. Read a
// new-heist request in the same frame, after the package has drawn its menu.
[After(Rooms.Pages)]
view RoomRequests(Heist heist, Session session, Rooms.Lobby lobby)
{
    if (lobby.newGame && Seat(heist, session.player) >= 0) Send(Restart { serial = heist.serial });
}
