using Box3D;
using Rooms;

enum Layers { Camera, Gather, Lamp, Draw, Labels, Hud }
const Color AMBER = Color(1, 0.68, 0.23);
const Color CYAN = Color(0.23, 0.83, 0.85);
const Color INK = Color(0.92, 0.93, 0.87);
const Color QUIET = Color(0.58, 0.66, 0.65);
const Color DARK = Color(0.055, 0.087, 0.10);
const Color RUST = Color(0.48, 0.23, 0.13);
const Color METAL = Color(0.20, 0.28, 0.29);
const Color GREEN = Color(0.59, 0.86, 0.54);
const Color RED = Color(1, 0.34, 0.22);

struct Corner { float3 position; float3 normal; }
struct Painted { float4x4 transform = float4x4.identity; Color tint; float material; }
local singleton Models
{
    bool made;
    List<Corner> box;
    List<int> faces;
    List<Corner> round;
    List<int> roundFaces;
    List<Painted> cubes;
    List<Painted> rounds;
    float beat;
    float3 eye;
}
local singleton Shadow
{
    bool made;
    RenderTarget map;
    DepthTexture depth;
    float4x4 toLamp;
}

float3 SunDirection() { return Math.Normalize(float3(-0.45, 0.85, -0.4)); }
float Sunlight(DepthTexture depth, float3 world, float3 normal, float4x4 toLamp)
{
    var clip = Math.Mul(toLamp, float4(world + normal * 0.06, 1));
    var uv = float2(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5);
    var z = clip.z * 0.5 + 0.5;
    if (Math.Max(Math.Abs(clip.x), Math.Abs(clip.y)) > 1) return 1;
    var step = 0.75 / 1024;
    return (depth.Compare(uv + float2(-step, -step), z) + depth.Compare(uv + float2(step, -step), z)
        + depth.Compare(uv + float2(-step, step), z) + depth.Compare(uv + float2(step, step), z)) * 0.25;
}

Color CrewColor(int id) { return id == 0 ? AMBER : CYAN; }
string JobName(int job) { return job == 0 ? "THE CONVEYOR SPINE" : job == 1 ? "THE TURBINE DRUM" : "THE PRESSURE VESSEL"; }
string JobBrief(int job)
{
    return job == 0 ? "Pull it square through the doorway. Lay it across the trench, then haul it onto the sled."
        : job == 1 ? "Pay out the amber line: the ballast lifts the shutter. Extract the drum, then recover the ballast."
        : "Tilt the vessel under the low beam. Unequal pulls tip it; two lines control the landing.";
}

void BoxMesh(mut Models models)
{
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        var way = face % 2 == 0 ? 1.0 : -1.0;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        var first = models.box.count;
        for (var i = 0; i < 4; i++)
        {
            var a = i == 0 || i == 3 ? -0.5 : 0.5;
            var b = i < 2 ? -0.5 : 0.5;
            models.box.Add(Corner { position = normal * 0.5 + across * a + up * b, normal = normal });
        }
        models.faces.Add(first); models.faces.Add(first + 1); models.faces.Add(first + 2);
        models.faces.Add(first); models.faces.Add(first + 2); models.faces.Add(first + 3);
    }
    for (var ring = 0; ring <= 8; ring++)
        for (var step = 0; step <= 12; step++)
        {
            var tilt = ring * Math.PI / 8;
            var turn = step * Math.TAU / 12;
            var normal = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
            models.round.Add(Corner { position = normal, normal = normal });
            if (ring == 8 || step == 12) continue;
            var at = ring * 13 + step;
            models.roundFaces.Add(at); models.roundFaces.Add(at + 13); models.roundFaces.Add(at + 1);
            models.roundFaces.Add(at + 1); models.roundFaces.Add(at + 13); models.roundFaces.Add(at + 14);
        }
}

void Block(mut Models models, float3 at, float3 size, Color tint, quaternion turn = quaternion.identity, float material = 0)
{
    models.cubes.Add(Painted { transform = float4x4.TRS(at, turn, size), tint = tint, material = material });
}
void Orb(mut Models models, float3 at, float3 size, Color tint)
{
    models.rounds.Add(Painted { transform = float4x4.TRS(at, quaternion.identity, size), tint = tint });
}
void Rod(mut Models models, float3 a, float3 b, float width, Color tint)
{
    var delta = b - a;
    var length = Math.Length(delta);
    if (length < 0.001) return;
    Block(models, (a + b) * 0.5, float3(width, width, length), tint, quaternion.LookRotation(delta / length, float3(0, 1, 0)));
}

frag Industrial(Corner corner, out Color color, Painted painted, Instance instance, Shadow shadow)
{
    var normal = instance.Normal(corner.normal);
    var sun = Math.Max(0, Math.Dot(normal, SunDirection())) * Sunlight(shadow.depth, this.world, normal, shadow.toLamp);
    var fill = Math.Max(0, Math.Dot(normal, Math.Normalize(float3(0.7, 0.4, 0.7))));
    // Face seams and mottled paint keep the large simple shapes readable.
    var grain = Math.Sin(this.world.x * 19 + this.world.z * 13) * Math.Sin(this.world.y * 17 + this.world.x * 7);
    var light = 0.35 + 0.65 * sun + 0.20 * fill;
    mut var paint = float3(painted.tint.r, painted.tint.g, painted.tint.b) * (light + grain * 0.025);
    if (painted.material > 0.5)
    {
        var seam = Math.Abs(Math.Frac(this.world.x / 2) - 0.5) > 0.488 || Math.Abs(Math.Frac(this.world.z / 2) - 0.5) > 0.488;
        if (seam && normal.y > 0.8) paint *= 0.75;
    }
    color = Color(paint.x, paint.y, paint.z, painted.tint.a);
}

[Stage(Layers.Lamp)]
view CastShadows(Models models, mut Shadow shadow)
{
    if (!shadow.made)
    {
        shadow.map = RenderTarget(1024, 1024, 1, Format.Depth);
        shadow.depth = shadow.map.depth;
        shadow.made = true;
    }
    var turn = quaternion.LookRotation(-SunDirection(), float3(0, 1, 0));
    var position = float3(0, 2, 2) + SunDirection() * 50;
    shadow.map.Clear(Color.white);
    shadow.map.SetCamera(float4x4.TRS(position, turn, float3(1)), float4x4.Ortho(48, 48, 0, 100));
    shadow.toLamp = shadow.map.WorldToClip();
    shadow.map.Instanced(models.box, models.faces, models.cubes);
    shadow.map.Instanced(models.round, models.roundFaces, models.rounds);
}

[Before(Rooms.Pages)]
view Theme()
{
    GUI.SetTheme(GUITheme { text = INK, panel = DARK, control = Color(0.13, 0.20, 0.22),
        hot = Color(0.22, 0.30, 0.31), pressed = Color(0.08, 0.13, 0.15),
        accent = AMBER, field = Color(0.035, 0.055, 0.07), radius = 6 });
}
override string Rooms.Tagline() { return "Two workers. Too many tonnes. One way out."; }

[Stage(Layers.Camera)]
view Camera(mut Models models, mut Hands hands, Devices devices)
{
    if (!models.made) { BoxMesh(models); models.made = true; }
    models.cubes.Clear();
    models.rounds.Clear();
    models.beat += Math.Min(Frame.dt, 0.05) * 2;
    if (models.beat > Math.TAU) models.beat -= Math.TAU;
    if (hands.playing && devices.mouse.scroll.y != 0)
        hands.zoom = Math.Clamp(hands.zoom - devices.mouse.scroll.y * 0.06, 0.75, 1.3);
    var rotation = quaternion.Euler(float3(0.86, -0.349, 0));
    var forward = Math.Mul(rotation, float3(0, 0, 1));
    var target = float3(0, 0.8, 1.5);
    models.eye = target - forward * 55;
    var height = Math.Max(33, 40 * Screen.height / Math.Max(Screen.width, 1)) * hands.zoom;
    Draw.Clear(Color(0.035, 0.065, 0.08));
    Draw.SetCamera(float4x4.TRS(models.eye, rotation, float3(1)), float4x4.Ortho(height * Screen.width / Math.Max(Screen.height, 1), height, 0.1, 120));
}

[Stage(Layers.Gather)]
view Building(Body body, Structure structure, mut Models models)
{
    var material = structure.material;
    var tint = material == 0 ? Color(0.29, 0.34, 0.33) : material == 1 ? Color(0.23, 0.31, 0.32)
        : material == 2 ? Color(0.32, 0.34, 0.30) : material == 3 ? Color(0.20, 0.29, 0.25)
        : material == 4 ? RUST : Color(0.42, 0.33, 0.18);
    Block(models, body.position, structure.size, tint, body.rotation, material == 0 ? 1 : 0);
    if (material == 5)
    {
        for (var i = 0; i < 8; i++)
            Block(models, body.position + float3(-3.4 + i, 0, -0.26), float3(0.12, 5.8, 0.08), RUST);
    }
}

[Stage(Layers.Gather)]
view DressSite(Site site, mut Models models)
{
    // Roof trusses, rails, pipes, trench water and the painted loading bay.
    for (var row = 0; row < 3; row++)
    {
        var z = -8 + row * 10;
        Block(models, float3(0, 7, z), float3(20.5, 0.22, 0.28), RUST);
        for (var i = 0; i < 5; i++)
        {
            Rod(models, float3(-10 + i * 4, 7, z), float3(-8 + i * 4, 8, z), 0.09, RUST);
            Rod(models, float3(-8 + i * 4, 8, z), float3(-6 + i * 4, 7, z), 0.09, RUST);
        }
    }
    Block(models, float3(-13.5, 2.7, 3), float3(0.26, 0.26, 26), METAL);
    Block(models, float3(-13.5, 2.1, 3), float3(0.18, 0.18, 26), RUST);
    for (var i = 0; i < 8; i++)
    {
        var x = -8.3 + i * 2.35;
        Block(models, float3(x, 0.03, -1.08), float3(0.8, 0.025, 0.22), AMBER);
        Block(models, float3(x, 0.03, 3.08), float3(0.8, 0.025, 0.22), AMBER);
    }
    if (site.job == 0) Block(models, float3(0, -1.4, 1), float3(17.8, 0.03, 3.9), Color(0.09, 0.28, 0.29));
    for (var side = 0; side < 2; side++)
        Block(models, float3(side == 0 ? -8.9 : 8.9, 0.38, 11.75), float3(0.06, 0.03, 10.3), GREEN);
    Block(models, float3(0, 0.38, 16.9), float3(17.8, 0.03, 0.06), GREEN);
    Block(models, float3(0, 0.38, 6.6), float3(17.8, 0.03, 0.06), GREEN);
    for (var i = 0; i < 6; i++)
    {
        var cable = site.cables[i];
        var color = cable.worker < 0 ? QUIET : CrewColor(cable.worker);
        Block(models, cable.station + float3(0, 0.05, 0), float3(1.5, 0.1, 1.4), METAL);
        Block(models, cable.station + float3(0, 0.65, 0.25), float3(0.7, 1.2, 0.4), RUST);
        Block(models, cable.station + float3(0, 1.28, 0.23), float3(0.62, 0.05, 0.3), color);
        Orb(models, cable.anchor, float3(0.18), color);
        if (cable.anchor.y > 3)
            Rod(models, float3(cable.anchor.x, 7.9, -9), float3(cable.anchor.x, 7.9, 14), 0.16, METAL);
    }
    if (site.job == 1)
    {
        for (var side = 0; side < 2; side++)
            Block(models, float3(side == 0 ? -8.5 : -6.5, 4, 5), float3(0.12, 8, 0.12), RUST);
        Rod(models, float3(-7.5, 8, 5), float3(0, 9, 2), 0.09, QUIET);
    }
}

[Stage(Layers.Gather)]
view Loads(Body body, Cargo cargo, mut Models models)
{
    var size = cargo.size;
    var tint = cargo.kind == 0 ? Color(0.37, 0.49, 0.47) : cargo.kind == 1 ? Color(0.57, 0.37, 0.20)
        : cargo.kind == 2 ? Color(0.37, 0.38, 0.33) : cargo.kind == 3 ? Color(0.42, 0.53, 0.49) : RUST;
    if (cargo.kind == 0)
    {
        for (var side = 0; side < 2; side++)
            Block(models, body.position + Math.Mul(body.rotation, float3(side == 0 ? -0.72 : 0.72, 0, 0)),
                float3(0.34, 0.8, 9), tint, body.rotation);
        for (var i = 0; i < 14; i++)
            Block(models, body.position + Math.Mul(body.rotation, float3(0, 0, -4.3 + i * 0.66)), float3(1.7, 0.6, 0.28), METAL, body.rotation);
        // Collision box's top is a walkable continuous deck.
        Block(models, body.position + Math.Mul(body.rotation, float3(0, 0.35, 0)), float3(1.3, 0.1, 8.9), Color(0.25, 0.34, 0.32), body.rotation);
    }
    else if (cargo.kind == 1 || cargo.kind == 3)
    {
        // Faceted shell exactly inside the collision envelope, plus end caps.
        for (var face = 0; face < 8; face++)
        {
            var angle = face * Math.TAU / 8;
            var local = float3(Math.Sin(angle) * size.x * 0.43, 0, Math.Cos(angle) * size.z * 0.43);
            var turn = Math.Mul(body.rotation, quaternion.Euler(float3(0, angle, 0)));
            Block(models, body.position + Math.Mul(body.rotation, local), float3(size.x * 0.41, size.y, 0.18), tint, turn);
        }
        for (var end = 0; end < 2; end++)
            Block(models, body.position + Math.Mul(body.rotation, float3(0, (end == 0 ? -0.47 : 0.47) * size.y, 0)),
                float3(size.x * 0.88, 0.16, size.z * 0.88), METAL, body.rotation);
        Block(models, body.position + Math.Mul(body.rotation, float3(0, 0, -size.z * 0.49)),
            float3(0.12, size.y * 0.72, 0.12), AMBER, body.rotation);
    }
    else Block(models, body.position, size, tint, body.rotation);
    if (cargo.kind > 3) return;
    for (var s = 0; s < SocketCount(cargo); s++)
    {
        var point = SocketAt(body, cargo, s);
        Orb(models, point, float3(0.17), AMBER);
        Orb(models, point + float3(0, 0.04, 0), float3(0.08), DARK);
    }
}

[Stage(Layers.Gather)]
view Crew(Body body, Worker worker, mut Models models)
{
    var color = CrewColor(worker.id);
    var feet = body.position - float3(0, 0.75, 0);
    var turn = quaternion.Euler(float3(worker.tumble > 0 ? 1.3 : 0, worker.yaw, worker.tumble > 0 ? 0.5 : 0));
    var gait = worker.tumble > 0 ? 0 : Math.Sin(models.beat * 4) * Math.Min(Math.Length(body.velocity.xz) * 0.07, 0.22);
    for (var side = 0; side < 2; side++)
    {
        var x = side == 0 ? -0.16 : 0.16;
        var z = side == 0 ? gait : -gait;
        Block(models, feet + Math.Mul(turn, float3(x, 0.22, z)), float3(0.19, 0.43, 0.24), DARK, turn);
        Block(models, feet + Math.Mul(turn, float3(x, 0.68, 0)), float3(0.20, 0.15, 0.20), color, turn);
    }
    Block(models, feet + Math.Mul(turn, float3(0, 0.89, 0)), float3(0.60, 0.62, 0.38), color, turn);
    Block(models, feet + Math.Mul(turn, float3(0, 0.95, -0.20)), float3(0.43, 0.29, 0.17), METAL, turn);
    Orb(models, feet + Math.Mul(turn, float3(0, 1.35, 0)), float3(0.29, 0.23, 0.29), color);
    Block(models, feet + Math.Mul(turn, float3(0, 1.27, 0.23)), float3(0.34, 0.12, 0.06), DARK, turn);
}

void DrawCable(mut Models models, float3 from, float3 to, float length, Color tint)
{
    var distance = Math.Distance(from, to);
    var slack = Math.Min(2, Math.Max(0, length - distance) * 0.3);
    mut var previous = from;
    for (var segment = 1; segment <= 12; segment++)
    {
        var t = segment / 12.0;
        var point = Math.Lerp(from, to, t) - float3(0, slack * 4 * t * (1 - t), 0);
        Rod(models, previous, point, 0.045, tint);
        previous = point;
    }
}

[Stage(Layers.Gather, 1)]
view Rigging(Site site, World world, mut Models models)
{
    for (var i = 0; i < 6; i++)
    {
        var cable = site.cables[i];
        mut var to = cable.anchor;
        var attached = world.Has<Body>(cable.target) && world.Has<Cargo>(cable.target);
        if (attached) to = SocketAt(world.Get<Body>(cable.target), world.Get<Cargo>(cable.target), cable.socket);
        else if (cable.worker >= 0 && world.TryGet<Worker>(site.crew[cable.worker], out var worker) && worker.hook)
            to = world.Get<Body>(site.crew[cable.worker]).position + float3(0, 0.2, 0);
        else continue;
        mut var tint = cable.worker >= 0 ? CrewColor(cable.worker) : QUIET;
        if (cable.tension > 2.8) tint = RED;
        DrawCable(models, cable.anchor, to, attached ? cable.length : Math.Distance(cable.anchor, to), tint);
    }
    if (site.job == 1 && world.TryGet<Body>(site.shutter, out var gate) && world.TryGet<Body>(site.cargo[1], out var ballast))
    {
        Rod(models, gate.position + float3(0, 3, 0), float3(0, 9, 2), 0.05, QUIET);
        Rod(models, ballast.position + float3(0, 0.65, 0), float3(-7.5, 8, 5), 0.05, QUIET);
    }
}

[Stage(Layers.Draw)]
view Render(Models models)
{
    Draw.Instanced(models.box, models.faces, models.cubes, Industrial);
    Draw.Instanced(models.round, models.roundFaces, models.rounds, Industrial);
}

void WorldLabel(string words, float3 at, Color color, float size = 12)
{
    var projected = Draw.WorldToScreen(at);
    Draw.Screen() { Draw.Text(words, projected.xy, size, color, Anchor.MiddleCenter); }
}

[Stage(Layers.Labels)]
view Signage(Site site, World world, Hands hands, Session session, Lobby lobby)
{
    if (!lobby.playing) return;
    WorldLabel("LOADING SLED", float3(0, 0.45, 14.6), GREEN, 13);
    WorldLabel("PUMP STATION 04", float3(0, 0, -12.2), QUIET, 12);
    for (var i = 0; i < 6; i++)
        WorldLabel($"{i + 1}", site.cables[i].station + float3(0, 1.75, 0), site.cables[i].worker < 0 ? QUIET : CrewColor(site.cables[i].worker));
    for (var id = 0; id < 2; id++)
    {
        var entity = site.crew[id];
        if (!world.TryGet<Worker>(entity, out var worker)) continue;
        var body = world.Get<Body>(entity);
        var mine = site.joined >= 2 ? world.Get<Owner>(entity).player == session.player : hands.shared || hands.active == id;
        WorldLabel(id == 0 ? "A" : "B", body.position + float3(0, 1.1, 0), CrewColor(id), mine ? 17 : 12);
        if (!mine) continue;
        mut var hint = "";
        if (worker.hook && worker.winch >= 0 && NearbySocket(site, world, body.position, worker.winch, out var target, out var socket))
        {
            hint = "E  ATTACH";
            var p = Draw.WorldToScreen(SocketAt(world.Get<Body>(target), world.Get<Cargo>(target), socket));
            Draw.Screen() { Draw.WireCircle(p.xy, 9, 2, CrewColor(id)); }
        }
        else
        {
            var station = NearbyStation(site, body.position, id);
            if (station >= 0 && station != worker.winch) hint = $"E  WINCH {station + 1}";
        }
        if (worker.tumble > 0) hint = "Oof. Coming back.";
        if (hint != "") WorldLabel(hint, body.position + float3(0, 1.9, 0), INK, 12);
    }
}
