enum ArtStage { Prepare, Figures, World, Interface, Sound }
const Color INK = Color(0.035, 0.065, 0.115);
const Color NAVY = Color(0.075, 0.12, 0.18);
const Color FLOOR = Color(0.13, 0.23, 0.26);
const Color CREAM = Color(0.96, 0.91, 0.79);
const Color MUTED = Color(0.52, 0.64, 0.67);
const Color GOLD = Color(0.97, 0.73, 0.36);
const Color MINT = Color(0.48, 0.91, 0.76);
const Color CORAL = Color(1, 0.48, 0.43);
const Color LILAC = Color(0.72, 0.65, 1);
const Color BLUE = Color(0.43, 0.76, 0.97);

Color Suit(int seat) { return seat == 0 ? MINT : seat == 1 ? CORAL : seat == 2 ? LILAC : BLUE; }
Color TeamSuit(Heist heist, int seat) { return heist.mode == MatchMode.Teams ? (seat % 2 == 0 ? MINT : CORAL) : Suit(seat); }
string Alias(int seat) { return seat == 0 ? "MINT" : seat == 1 ? "ROUGE" : seat == 2 ? "VIOLET" : "AZURE"; }
string ExitName(int exit) { return exit == 0 ? "NORTHWEST" : exit == 1 ? "NORTHEAST" : exit == 2 ? "SOUTHEAST" : "SOUTHWEST"; }
string MapName(int map) { return map == 0 ? "THE PENTHOUSE" : map == 1 ? "THE GALLERY" : "THE TERRACE"; }
string ModeName(MatchMode mode) { return mode == MatchMode.Duel ? "DUEL" : mode == MatchMode.Teams ? "2 vs 2" : "FREE FOR ALL"; }
void Text(string text, float2 at, float size = 16, Color color = CREAM, Anchor anchor = Anchor.MiddleLeft)
{
    Draw.Text(text, at, size, color, anchor);
}
void Bold(string text, float2 at, float size, Color color = CREAM, Anchor anchor = Anchor.MiddleLeft)
{
    Draw.Text(text, at, size, color, anchor, Font.Bold);
}
void Triangle(float2 a, float2 b, float2 c, Color color)
{
    Draw.Mesh([Vertex { position = a, color = color }, Vertex { position = b, color = color }, Vertex { position = c, color = color }], [0, 1, 2]);
}
void Gem(float2 at, float size, Color tone = GOLD)
{
    var left = at + float2(-size, -size * 0.24);
    var right = at + float2(size, -size * 0.24);
    var top = at + float2(0, -size);
    var bottom = at + float2(0, size * 1.1);
    Triangle(left, top, at, Math.Lerp(tone, Color.white, 0.42));
    Triangle(top, right, at, tone);
    Triangle(left, at, bottom, Math.Lerp(tone, INK, 0.18));
    Triangle(at, right, bottom, Math.Lerp(tone, Color.white, 0.65));
    Draw.Line(left, top, 1.3, CREAM);
    Draw.Line(top, right, 1.3, CREAM);
}
struct Spark { float2 position; float2 velocity; float age; Color color; }
local singleton Picture
{
    float clock;
    float2[4] position;
    float2[4] facing;
    float2[4] last;
    float[4] stride;
    Spark[64] sparks;
    int nextSpark;
    float shake;
    string toast;
    float toastTime;
    Color toastColor;
    float2 popup;
    string popupText;
    float popupTime;
    float2 origin;
    float scale;
    int seat = -1;
    int round = -1;
}
[Stage(ArtStage.Prepare)]
view PreparePicture(mut Picture picture, Session session, Heist heist)
{
    picture.clock += Frame.dt;
    if (picture.clock >= 3600) picture.clock -= 3600;
    picture.seat = SeatOf(heist, session.player);
    picture.origin = float2(Screen.width * 0.5, Screen.height * 0.5 + 27);
    picture.scale = Math.Max(0.15, Math.Min((Screen.width - 60) / 1030, (Screen.height - 242) / 620));
    if (Screen.height < 520 && Screen.width > 650)
    {
        picture.origin = float2(Screen.width * 0.5, Screen.height * 0.5 + 12);
        picture.scale = Math.Min((Screen.width - 230) / 1030, (Screen.height - 65) / 560);
    }
    picture.shake = Math.Max(0, picture.shake - Frame.dt);
    picture.toastTime = Math.Max(0, picture.toastTime - Frame.dt);
    picture.popupTime = Math.Max(0, picture.popupTime - Frame.dt);
    if (picture.round != heist.round)
    {
        picture.round = heist.round;
        for (var s = 0; s < 4; s++) picture.last[s] = heist.thieves[s].position;
    }
    for (var i = 0; i < 64; i++)
    {
        if (picture.sparks[i].age <= 0) continue;
        picture.sparks[i].age -= Frame.dt;
        picture.sparks[i].position += picture.sparks[i].velocity * Frame.dt;
        picture.sparks[i].velocity *= Math.Max(0, 1 - Frame.dt * 3);
    }
}
[Stage(ArtStage.Figures)]
view FigurePositions(Figure figure, mut Picture picture)
{
    var s = figure.seat;
    picture.position[s] = figure.position;
    picture.facing[s] = figure.facing;
    picture.stride[s] += Math.Distance(picture.last[s], figure.position) * 0.08;
    picture.last[s] = figure.position;
}
local event(HeistSound cue) FeelHeist(mut Picture picture)
{
    var tone = cue.seat < 0 ? GOLD : Suit(cue.seat);
    var count = cue.kind == HeistCue.Dash ? 4 : cue.kind == HeistCue.Bluff ? 8 : 16;
    for (var i = 0; i < count; i++)
    {
        var index = picture.nextSpark++ % 64;
        var angle = i / float(count) * Math.TAU + picture.clock;
        picture.sparks[index] = Spark { position = cue.position, velocity = float2(Math.Cos(angle), Math.Sin(angle)) * (70 + i % 4 * 25), age = 0.55 + i % 3 * 0.1, color = tone };
    }
    if (cue.kind == HeistCue.Steal || cue.kind == HeistCue.Bank || cue.kind == HeistCue.Fooled)
    {
        picture.shake = 0.15;
        picture.popup = cue.position;
        picture.popupTime = 1.2;
        picture.popupText = cue.kind == HeistCue.Bank ? $"+{cue.amount}  BANKED" : cue.kind == HeistCue.Steal ? "YOINK!" : "FOOLED!";
    }
    if (cue.kind == HeistCue.Bank || cue.kind == HeistCue.Exit || cue.kind == HeistCue.Fooled || cue.kind == HeistCue.Steal)
    {
        picture.toastTime = 1.8;
        picture.toastColor = tone;
        picture.toast = cue.kind == HeistCue.Bank ? $"{Alias(cue.seat)} CASHED OUT  +{cue.amount}"
            : cue.kind == HeistCue.Steal ? $"{Alias(cue.seat)} STOLE THE PRISM"
            : cue.kind == HeistCue.Fooled ? $"{Alias(cue.seat)} FELL FOR A FAKE" : "THE GETAWAY HAS MOVED";
    }
}

void Skyline(float clock)
{
    Draw.SetScreen();
    Draw.Clear(INK);
    var width = Screen.width;
    var height = Screen.height;
    Draw.Shape(Shape { center = float2(width * 0.5, height * 0.5), size = float2(width, height), color = Color(0.035, 0.065, 0.13), color2 = Color(0.095, 0.15, 0.21) });
    for (var star = 0; star < 48; star++)
    {
        var at = float2((star * 197 % 997) / 997.0 * width, (star * 71 % 413) / 413.0 * height * 0.75);
        Draw.Circle(at, star % 7 == 0 ? 1.5 : 0.75, Color(0.7, 0.8, 0.82, 0.15 + Math.Sin(clock * 0.5 + star) * 0.08));
    }
    for (var building = 0; building < 21; building++)
    {
        var bw = width / 17;
        var x = building * width / 20.0;
        var bh = 65 + building * 43 % 138;
        var bottom = height;
        Draw.Rect(float2(x, bottom - bh * 0.5), float2(bw - 9, bh), Color(0.045, 0.075, 0.115));
        Draw.Rect(float2(x, bottom - bh - 4), float2(bw - 18, 8), Color(0.10, 0.17, 0.21));
        if (building % 3 == 0) Draw.Line(float2(x, bottom - bh), float2(x, bottom - bh - 24), 2, Color(0.12, 0.20, 0.24));
        for (var row = 0; row < 6; row++)
            for (var column = 0; column < 3; column++)
                if ((building * 3 + row * 5 + column) % 4 == 0)
                    Draw.Rect(float2(x - bw * 0.24 + column * bw * 0.24, bottom - 18 - row * 23), float2(5, 8), Color(0.85, 0.63, 0.31, 0.25));
    }
}
void Planter(Rect block)
{
    var at = float2(block.x + block.width * 0.5, block.y + block.height * 0.5);
    var size = float2(block.width, block.height);
    Draw.RoundRect(at + float2(3, 9), size + float2(7), 9, Color(0.015, 0.04, 0.045, 0.65));
    Draw.RoundRect(at + float2(0, 6), size + float2(4), 7, Color(0.35, 0.38, 0.33));
    Draw.RoundRect(at, size + float2(4), 7, CREAM);
    Draw.RoundRect(at, size - float2(7), 4, Color(0.05, 0.14, 0.13));
    for (var leaf = 0; leaf < 14; leaf++)
    {
        var x = block.x + 9 + (leaf * 29 % 101) / 101.0 * (block.width - 18);
        var y = block.y + 9 + (leaf * 47 % 97) / 97.0 * (block.height - 18);
        Draw.Ellipse(float2(x, y), float2(9, 5), leaf * 1.7, leaf % 3 == 0 ? Color(0.23, 0.48, 0.34) : Color(0.13, 0.34, 0.26));
    }
}
void Rooftop(Heist heist, Picture picture)
{
    // Raised cream parapet, inset brass border, terrazzo and a central vault.
    Draw.RoundRect(float2(8, 27), float2(970, 550), 32, Color(0.015, 0.03, 0.05, 0.7));
    Draw.RoundRect(float2(0, 14), float2(970, 550), 32, Color(0.27, 0.34, 0.36));
    Draw.RoundRect(float2(0), float2(970, 550), 32, CREAM);
    Draw.RoundRect(float2(0), float2(936, 516), 23, Color(0.085, 0.16, 0.19));
    Draw.RoundRect(float2(0), float2(914, 494), 17, FLOOR);
    Draw.WireRoundRect(float2(0), float2(924, 504), 20, 2, GOLD);
    for (var x = -8; x <= 8; x++)
        Draw.Line(float2(x * 55, -243), float2(x * 55, 243), 1, Color(0.23, 0.35, 0.36, 0.35));
    for (var y = -4; y <= 4; y++)
        Draw.Line(float2(-452, y * 55), float2(452, y * 55), 1, Color(0.23, 0.35, 0.36, 0.35));
    for (var dot = 0; dot < 100; dot++)
        Draw.Rect(float2(dot * 139 % 891 - 445, dot * 83 % 473 - 236), float2(2, 1), Color(0.42, 0.51, 0.47, 0.27));
    Draw.WireCircle(float2(0), 90, 1.5, Color(0.70, 0.63, 0.40, 0.28));
    Draw.WireCircle(float2(0), 83, 1, Color(0.70, 0.63, 0.40, 0.23));
    for (var ray = 0; ray < 12; ray++)
    {
        var angle = ray / 12.0 * Math.TAU;
        var normal = float2(Math.Cos(angle), Math.Sin(angle));
        Draw.Line(normal * 53, normal * 77, 1.5, Color(0.7, 0.6, 0.36, 0.28));
    }
    Draw.Circle(float2(0, 5), 47, Color(0.055, 0.11, 0.13));
    Draw.Circle(float2(0), 46, Color(0.29, 0.34, 0.31));
    Draw.WireCircle(float2(0), 46, 3, GOLD);
    Draw.Circle(float2(0), 35, NAVY);
    Draw.WireCircle(float2(0), 31, 1, Color(0.55, 0.50, 0.32));
    Text("S", float2(0), 30, GOLD, Anchor.MiddleCenter);
    Text("LE CLUB SWINDLE", float2(0, 117), 10, Color(0.48, 0.59, 0.55), Anchor.MiddleCenter);
    for (var exit = 0; exit < 4; exit++)
    {
        var active = exit == heist.exit;
        var at = ExitAt(exit);
        var tone = active ? MINT : Color(0.29, 0.39, 0.39);
        Draw.RoundRect(at + float2(0, 5), float2(106, 86), 12, Color(0.04, 0.09, 0.11));
        Draw.RoundRect(at, float2(106, 86), 12, active ? Color(0.14, 0.39, 0.34) : Color(0.12, 0.20, 0.23));
        Draw.WireRoundRect(at, float2(106, 86), 12, active ? 3.0 : 1.0, tone);
        if (active)
        {
            Draw.WireCircle(at, 39 + Math.Sin(picture.clock * 4) * 2, 1, Color(0.48, 0.91, 0.76, 0.25));
            for (var chevron = 0; chevron < 3; chevron++)
            {
                var y = at.y + 14 - chevron * 9;
                Draw.Line(float2(at.x - 9, y), float2(at.x, y - 7), 2, MINT);
                Draw.Line(float2(at.x, y - 7), float2(at.x + 9, y), 2, MINT);
            }
            Text("CASH OUT", at + float2(0, 30), 10, MINT, Anchor.MiddleCenter);
        }
        else Text("CLOSED", at, 10, MUTED, Anchor.MiddleCenter);
        Text($"0{exit + 1}", at + float2(0, -28), 10, tone, Anchor.MiddleCenter);
    }
    for (var b = 0; b < 4; b++) Planter(BlockAt(heist.map, b));
    // Lanterns sit on the parapet rather than in the playable lanes.
    for (var lamp = 0; lamp < 8; lamp++)
    {
        var at = float2(-410 + lamp % 4 * 273, lamp < 4 ? -265 : 265);
        Draw.Circle(at, 12, Color(0.98, 0.76, 0.36, 0.13));
        Draw.Circle(at, 5, GOLD);
        Draw.Circle(at, 2, CREAM);
    }
}
void Burglar(float2 at, float2 facing, Color suit, float stride, bool jewel, bool dash, bool stunned, bool yours)
{
    var bounce = Math.Sin(stride) * 2;
    Draw.Ellipse(at + float2(3, 12), float2(19, 8), Color(0.015, 0.035, 0.04, 0.58));
    if (dash)
        for (var trail = 1; trail <= 4; trail++)
            Draw.RoundRect(at - facing * trail * 17 + float2(0, -12), float2(24, 28), 8, Color(suit.r, suit.g, suit.b, 0.16 / trail));
    Draw.Line(at + float2(-7, 0), at + float2(-9, 9 + bounce), 7, INK);
    Draw.Line(at + float2(7, 0), at + float2(9, 9 - bounce), 7, INK);
    Triangle(at + float2(-18, -10), at + float2(18, -10), at + float2(0, 5), Math.Lerp(suit, INK, 0.42));
    Draw.RoundRect(at + float2(0, -10), float2(27, 24), 8, suit);
    Triangle(at + float2(-9, -20), at + float2(0, -6), at + float2(9, -20), CREAM);
    Draw.Line(at + float2(0, -18), at + float2(0, -9), 3, INK);
    Draw.Line(at + float2(-14, -13), at + float2(-21, -3 - bounce), 7, Math.Lerp(suit, INK, 0.10));
    Draw.Line(at + float2(14, -13), at + float2(21, -3 + bounce), 7, Math.Lerp(suit, INK, 0.10));
    var head = at + float2(facing.x * 2, -32 + Math.Abs(bounce) * 0.35);
    Triangle(head + float2(-14, -6), head + float2(-15, -22), head + float2(-3, -13), suit);
    Triangle(head + float2(14, -6), head + float2(15, -22), head + float2(3, -13), suit);
    Draw.RoundRect(head, float2(34, 28), 11, suit);
    Draw.RoundRect(head + float2(facing.x * 2, 1), float2(31, 11), 5, INK);
    Draw.Rect(head + float2(-7 + facing.x * 3, facing.y * 2 + 1), float2(5, 3), CREAM);
    Draw.Rect(head + float2(7 + facing.x * 3, facing.y * 2 + 1), float2(5, 3), CREAM);
    Triangle(head + float2(-4, 8), head + float2(4, 8), head + float2(0, 12), CREAM);
    if (yours)
    {
        Draw.Arc(at + float2(0, 4), 24, 0.15, Math.PI - 0.3, 2, CREAM);
        Triangle(head + float2(-5, -31), head + float2(5, -31), head + float2(0, -25), CREAM);
    }
    if (jewel)
    {
        Draw.Circle(head + float2(0, -36), 17, Color(0.97, 0.73, 0.36, 0.12));
        Gem(head + float2(0, -36), 11);
    }
    if (stunned) Text("* * *", head + float2(0, -27), 12, GOLD, Anchor.MiddleCenter);
}

[Stage(ArtStage.World)]
view DrawHeist(Heist heist, Picture picture, Rooms.Lobby lobby)
{
    Skyline(picture.clock);
    var shake = float2(Math.Sin(picture.clock * 90), Math.Cos(picture.clock * 73)) * picture.shake * 16;
    Draw.Transform(picture.origin + shake, 0, float2(picture.scale))
    {
        Rooftop(heist, picture);
        if (heist.carrier < 0 && heist.jewelWait <= 0)
        {
            var floatAt = heist.jewel + float2(0, -27 + Math.Sin(picture.clock * 3) * 4);
            Draw.Ellipse(heist.jewel + float2(0, 10), float2(16, 6), Color(0, 0, 0, 0.35));
            Draw.WireCircle(heist.jewel, 25 + Math.Sin(picture.clock * 4) * 3, 1.5, GOLD);
            Gem(floatAt, 18);
            if (heist.phase == RoundPhase.Ready) Text("THE PRISM", heist.jewel + float2(0, 39), 10, GOLD, Anchor.MiddleCenter);
        }
        // Stable depth order of all eight possible figures, using their feet.
        mut bool[8] drawn = [false, false, false, false, false, false, false, false];
        for (var pass = 0; pass < 8; pass++)
        {
            mut var next = -1;
            mut var y = 99999.0;
            for (var index = 0; index < 8; index++)
            {
                if (drawn[index]) continue;
                var s = index % 4;
                if (!Active(heist, s)) continue;
                if (index >= 4 && heist.replicas[s].life <= 0) continue;
                var at = index < 4 ? picture.position[s] : heist.replicas[s].position;
                if (at.y >= y) continue;
                next = index;
                y = at.y;
            }
            if (next < 0) break;
            drawn[next] = true;
            var seat = next % 4;
            var fake = next >= 4;
            var me = heist.thieves[seat];
            var own = seat == picture.seat || (heist.couch && seat == 1);
            if (!fake && me.cloak > 0 && !own) continue;
            var at = fake ? heist.replicas[seat].position : picture.position[seat];
            var facing = fake ? heist.replicas[seat].direction : picture.facing[seat];
            var opacity = !fake && me.cloak > 0 ? 0.25 : fake ? Math.Min(1, heist.replicas[seat].life * 4) : 1.0;
            Draw.Tint(Color(1, 1, 1, opacity))
            {
                Burglar(at, facing, TeamSuit(heist, seat), picture.stride[seat], fake ? heist.replicas[seat].jewel : heist.carrier == seat,
                    !fake && me.dashTime > 0, !fake && me.stun > 0, own && !fake && lobby.playing);
            }
            if (fake && own && !heist.couch) Text("YOUR FAKE", at + float2(0, 25), 8, MUTED, Anchor.MiddleCenter);
            if (!fake && me.banking > 0) Draw.Arc(at, 30, -Math.PI * 0.5, Math.TAU * Math.Min(1, me.banking / 0.65), 4, GOLD);
        }
        for (var i = 0; i < 64; i++)
        {
            var spark = picture.sparks[i];
            if (spark.age <= 0) continue;
            Draw.Rect(spark.position, float2(4), spark.age * 4, Color(spark.color.r, spark.color.g, spark.color.b, Math.Min(1, spark.age * 3)));
        }
        if (picture.popupTime > 0)
        {
            var at = picture.popup + float2(0, -75 - (1.2 - picture.popupTime) * 32);
            Bold(picture.popupText, at + float2(1, 2), 18, INK, Anchor.MiddleCenter);
            Bold(picture.popupText, at, 18, GOLD, Anchor.MiddleCenter);
        }
    }
}
