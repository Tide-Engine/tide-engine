const GUITheme CLUB_THEME = GUITheme {
    text = CREAM, panel = NAVY, control = Color(0.14, 0.22, 0.28),
    hot = Color(0.23, 0.34, 0.39), pressed = Color(0.10, 0.18, 0.23),
    field = INK, fieldHot = Color(0.11, 0.19, 0.24), accent = MINT, radius = 8
};
local singleton Menu
{
    int mode = 1;
    bool couch;
    bool bots = true;
    bool help;
    bool music = true;
    float2 touchStart;
    int stick = -1;
    int round = -1;
}
[Before(Rooms.Begin, Rooms.Pages)]
view Theme()
{
    GUI.SetTheme(CLUB_THEME);
}
override string Rooms.Tagline() { return "Steal the jewel. Sell the lie."; }
override Rect Rooms.MenuButton(float2 screen) { return Rect(screen.x - 97, 22, 75, 34); }
override void Rooms.TitlePage(Session session, mut Rooms.Lobby lobby) { }
override void Rooms.RoomPage(Session session, string room, mut Rooms.Lobby lobby) { }

bool Button(string label, Rect rect, bool primary = false, bool enabled = true, float inputScale = 1)
{
    mut var clicked = false;
    GUI.Disabled(!enabled)
    {
        var state = GUI.Control(Rect(rect.x * inputScale, rect.y * inputScale, rect.width * inputScale, rect.height * inputScale));
        var at = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
        var base = primary ? MINT : Color(0.13, 0.22, 0.28);
        var tone = !enabled ? Color(0.10, 0.15, 0.19) : state.hovered || state.focused ? Math.Lerp(base, CREAM, 0.15) : base;
        var down = state.pressed ? 2.0 : 0.0;
        Draw.RoundRect(at + float2(0, 3), float2(rect.width, rect.height), 8, Color(0.01, 0.03, 0.055));
        Draw.RoundRect(at + float2(0, down), float2(rect.width, rect.height), 8, tone);
        if (state.focused) Draw.WireRoundRect(at, float2(rect.width + 4, rect.height + 4), 10, 1, CREAM);
        Bold(label, at + float2(0, down), rect.height < 38 ? 11.0 : 14.0, !enabled ? MUTED : primary ? INK : CREAM, Anchor.MiddleCenter);
        clicked = state.clicked;
    }
    return clicked;
}
void ModePicker(mut Menu menu, float2 at, float width, int humans, float scale = 1)
{
    var third = (width - 12) / 3;
    for (var m = 0; m < 3; m++)
    {
        var rect = Rect(at.x + m * (third + 6), at.y, third, 32);
        if (Button(m == 0 ? "DUEL" : m == 1 ? "FREE FOR ALL" : "2 vs 2", rect, menu.mode == m, m != 0 || humans <= 2, scale)) menu.mode = m;
    }
}
void Instruction(float2 at, string number, string heading, string detail, Color tone)
{
    Draw.RoundRect(at + float2(18, 18), float2(36), 10, Color(tone.r, tone.g, tone.b, 0.12));
    Bold(number, at + float2(18, 18), 14, tone, Anchor.MiddleCenter);
    Bold(heading, at + float2(52, 9), 13, CREAM);
    Text(detail, at + float2(52, 30), 12, MUTED);
}
int Humans(Heist heist)
{
    mut var count = 0;
    for (var s = 0; s < 4; s++) if (heist.present[s]) count++;
    return count;
}
void Launch(Heist heist, Menu menu, mut Rooms.Lobby lobby, bool couch)
{
    Send(Deal { mode = menu.mode, couch = couch, bots = menu.bots });
    Rooms.Resume(lobby);
}
void Title(Heist heist, Session session, mut Rooms.Lobby lobby, mut Menu menu, Picture picture, float2 screen, float scale)
{
    var narrow = screen.x < 800;
    var left = narrow ? 24.0 : Math.Max(50, (screen.x - 1180) * 0.5);
    var width = narrow ? Math.Min(480, screen.x - 48) : 460.0;
    var top = narrow ? Math.Max(38, (screen.y - 660) * 0.5) : Math.Max(65, (screen.y - 650) * 0.5);
    Draw.Rect(screen * 0.5, screen, Color(0.025, 0.05, 0.095, 0.87));
    Text("LE CLUB  /  AFTER HOURS", float2(left, top), 11, GOLD);
    Bold("SWINDLE", float2(left - 4, top + 78), narrow ? 58.0 : 90.0, CREAM);
    Text("A very civil rooftop robbery.", float2(left, top + 148), narrow ? 19.0 : 23.0, MINT);
    Text("90 seconds. One jewel. Absolutely no loyalty.", float2(left, top + 183), 14, MUTED);
    Text("CHOOSE YOUR COMPANY", float2(left, top + 230), 10, GOLD);
    ModePicker(menu, float2(left, top + 249), width, 1, scale);
    var ready = session.state == SessionState.Connected;
    if (Button("PLAY  /  YOU vs BOTS", Rect(left, top + 303, width, 52), true, ready, scale)) Launch(heist, menu, lobby, false);
    if (Button("HOST FRIENDS", Rect(left, top + 368, (width - 10) * 0.5, 44), false, ready, scale))
    {
        menu.couch = false;
        Rooms.Host(lobby);
    }
    if (Button("JOIN A ROOM", Rect(left + (width + 10) * 0.5, top + 368, (width - 10) * 0.5, 44), false, true, scale)) Rooms.ShowJoin(lobby);
    if (Button("TWO ON ONE KEYBOARD", Rect(left, top + 424, width, 40), false, ready, scale)) Launch(heist, menu, lobby, true);
    Text(lobby.message != "" ? lobby.message : "1–4 players  /  online + same keyboard  /  instant rematches", float2(left, top + 490), narrow ? 10.0 : 12.0, MUTED);
    if (!narrow)
    {
        var hero = float2(screen.x * 0.73, top + 255);
        var size = Math.Min(1.0, (screen.x - left - width - 80) / 440);
        Draw.Transform(hero, 0, float2(size))
        {
            Draw.WireCircle(float2(0), 192, 1, Color(0.37, 0.40, 0.32));
            Draw.WireCircle(float2(0), 179, 1, Color(0.37, 0.40, 0.32));
            for (var ray = 0; ray < 24; ray++)
            {
                var angle = ray / 24.0 * Math.TAU;
                var way = float2(Math.Cos(angle), Math.Sin(angle));
                Draw.Line(way * 142, way * 169, 1, Color(0.37, 0.40, 0.32));
            }
            Draw.Circle(float2(0), 135, Color(0.085, 0.16, 0.19));
            Draw.Transform(float2(-63, 88), -0.11, float2(2.6)) { Burglar(float2(0), float2(1, 0), MINT, picture.clock * 1.3, false, false, false, false); }
            Draw.Transform(float2(73, 94), 0.13, float2(2.6)) { Burglar(float2(0), float2(-1, 0), CORAL, picture.clock * 1.3 + 2, false, false, false, false); }
            Draw.Circle(float2(0, -114), 42, Color(0.97, 0.73, 0.36, 0.10));
            Gem(float2(0, -114 + Math.Sin(picture.clock * 2) * 4), 32);
            Text("STEAL THE JEWEL.", float2(0, 223), 16, GOLD, Anchor.MiddleCenter);
            Text("SELL THE LIE.", float2(0, 250), 16, CREAM, Anchor.MiddleCenter);
        }
    }
    if (!narrow || screen.y > 790)
    {
        var y = Math.Min(screen.y - 86, top + 568);
        var spacing = narrow ? 0.0 : (screen.x - left * 2) / 3;
        Instruction(float2(left, y), "01", "TAKE IT", "Touch the prism. Greed grows its value.", GOLD);
        if (!narrow)
        {
            Instruction(float2(left + spacing, y), "02", "FAKE IT", "E sends a double. You vanish briefly.", LILAC);
            Instruction(float2(left + spacing * 2, y), "03", "BANK IT", "Stand in the green exit. Watch it move.", MINT);
        }
    }
}
void Room(Heist heist, Session session, string room, mut Rooms.Lobby lobby, mut Menu menu, Picture picture, float2 screen, float scale)
{
    var width = Math.Min(510, screen.x - 36);
    var at = screen * 0.5;
    var x = at.x - width * 0.5 + 26;
    var inner = width - 52;
    var online = room != "";
    Draw.Rect(screen * 0.5, screen, Color(0.025, 0.05, 0.095, 0.78));
    Draw.RoundRect(at, float2(width, 518), 18, NAVY);
    Draw.WireRoundRect(at, float2(width, 518), 18, 1, Color(0.25, 0.37, 0.40));
    Text("YOUR PARTNERS IN CRIME", float2(x, at.y - 219), 10, GOLD);
    Bold(online ? $"ROOM  {room}" : "THE BACK ROOM", float2(x, at.y - 178), 26);
    if (online && Button(lobby.copied < 2 ? "COPIED" : "COPY CODE", Rect(at.x + width * 0.5 - 124, at.y - 195, 98, 32), false, true, scale)) Rooms.CopyCode(lobby, room);
    Text(online ? "Share the code. Friends join from the title screen." : "Open a room to invite friends, or play right here.", float2(x, at.y - 142), 12, MUTED);
    for (var s = 0; s < 4; s++)
    {
        var row = at.y - 106 + s * 32;
        Draw.Circle(float2(x + 6, row), 5, Suit(s));
        Bold(Alias(s), float2(x + 22, row), 12, Suit(s));
        Text(heist.present[s] ? (s == picture.seat ? "YOU" : "FRIEND") : "BOT / OPEN SEAT", float2(x + inner - 2, row), 11, MUTED, Anchor.MiddleRight);
    }
    var host = picture.seat == heist.hostSeat;
    if (host)
    {
        ModePicker(menu, float2(x, at.y + 34), inner, Humans(heist), scale);
        if (Button(menu.bots ? "FILL EMPTY SEATS: BOTS" : "FILL EMPTY SEATS: OFF", Rect(x, at.y + 78, inner, 32), false, true, scale)) menu.bots = !menu.bots;
        if (Button(heist.phase == RoundPhase.Ready ? "START THE HEIST" : "NEW HEIST", Rect(x, at.y + 124, inner, 44), true, true, scale)) Launch(heist, menu, lobby, false);
    }
    else Text("The host chooses the next heist.", float2(at.x, at.y + 72), 14, MINT, Anchor.MiddleCenter);
    if (Button("RESUME", Rect(x, at.y + 181, (inner - 8) * 0.5, 38), false, heist.phase != RoundPhase.Ready, scale)) Rooms.Resume(lobby);
    if (Button(online ? "LEAVE ROOM" : "TITLE SCREEN", Rect(x + (inner + 8) * 0.5, at.y + 181, (inner - 8) * 0.5, 38), false, true, scale)) Rooms.Leave(session, lobby);
    if (host && !session.open && Button("INVITE FRIENDS", Rect(x, at.y - 12, inner, 30), false, true, scale))
    {
        Send(ReturnToLobby { });
        Rooms.Invite();
    }
}
void Cooldown(float2 at, string key, string action, float left, float total, Color tone)
{
    Draw.RoundRect(at, float2(43, 37), 7, left <= 0 ? Color(tone.r, tone.g, tone.b, 0.17) : NAVY);
    Draw.WireRoundRect(at, float2(43, 37), 7, 1, left <= 0 ? tone : Color(0.25, 0.34, 0.38));
    Bold(key, at, key == "SPACE" ? 9.0 : 14.0, left <= 0 ? tone : MUTED, Anchor.MiddleCenter);
    Bold(action, at + float2(32, -7), 12);
    Text(left <= 0 ? "READY" : $"{int(Math.Ceil(left))}s", at + float2(32, 10), 10, left <= 0 ? tone : MUTED);
    if (left > 0) Draw.Rect(at + float2(-21.5 + (1 - left / total) * 21.5, 17), float2((1 - left / total) * 43, 2), tone);
}
void HUD(Heist heist, Picture picture, Menu menu)
{
    if (Screen.height < 520 && Screen.width > 650)
    {
        var screen = float2(Screen.width, Screen.height);
        Draw.Rect(float2(screen.x * 0.5, 21), float2(screen.x, 42), INK);
        Bold("SWINDLE", float2(18, 22), 21);
        var secs = int(Math.Ceil(heist.clock));
        Bold(heist.overtime ? "OVERTIME" : $"{secs / 60}:{(secs % 60 < 10 ? "0" : "")}{secs % 60}", float2(screen.x * 0.5, 21), 25, heist.clock <= 15 ? CORAL : CREAM, Anchor.MiddleCenter);
        var count = heist.mode == MatchMode.Teams ? 2 : CountSeats(heist);
        for (var s = 0; s < count; s++)
        {
            var at = float2(66, 82 + s * 45);
            Draw.RoundRect(at, float2(100, 38), 6, NAVY);
            Text(heist.mode == MatchMode.Teams ? (s == 0 ? "MINT CREW" : "ROUGE CREW") : Alias(s), at + float2(-39, -4), 9, TeamSuit(heist, s));
            if (s == picture.seat) Text("YOU", at + float2(-39, 10), 7, MUTED);
            Bold($"{ScoreOf(heist, s)}", at + float2(39, 1), 20, CREAM, Anchor.MiddleRight);
        }
        Text($"EXIT 0{heist.exit + 1}", float2(screen.x - 72, 158), 11, MINT, Anchor.MiddleCenter);
        Text(ExitName(heist.exit), float2(screen.x - 72, 177), 8, MUTED, Anchor.MiddleCenter);
        Text($"MOVES IN {int(Math.Ceil(heist.exitClock))}s", float2(screen.x - 72, 196), 8, MUTED, Anchor.MiddleCenter);
        if (heist.carrier >= 0)
        {
            Gem(float2(screen.x * 0.5 + 95, 21), 9);
            Bold($"{Value(heist)}", float2(screen.x * 0.5 + 109, 22), 15, GOLD);
        }
        if (picture.toastTime > 0) Text(picture.toast, float2(screen.x * 0.5, 63), 9, picture.toastColor, Anchor.MiddleCenter);
        if (picture.seat >= 0)
        {
            var me = heist.thieves[picture.seat];
            Cooldown(float2(37, screen.y - 76), "SPACE", "DASH", me.dashCooldown, 1.35, MINT);
            Cooldown(float2(37, screen.y - 30), "E", "FAKE", me.bluffCooldown, 5.5, LILAC);
        }
        if (heist.phase == RoundPhase.Countdown)
            Bold($"{int(Math.Ceil(heist.countdown))}", screen * 0.5, 58, MINT, Anchor.MiddleCenter);
        return;
    }
    var narrow = Screen.width < 800;
    Draw.Rect(float2(Screen.width * 0.5, 48), float2(Screen.width, 96), Color(0.035, 0.065, 0.115, 0.94));
    Text("LE CLUB", float2(24, 24), 9, GOLD);
    Bold("SWINDLE", float2(24, 48), narrow ? 19.0 : 27.0);
    var secs = int(Math.Ceil(heist.clock));
    var seconds = secs % 60;
    Bold(heist.overtime ? "OVERTIME" : $"{secs / 60}:{(seconds < 10 ? "0" : "")}{seconds}", float2(Screen.width * 0.5, 36), heist.overtime ? 24.0 : 32.0, heist.clock <= 15 ? CORAL : CREAM, Anchor.MiddleCenter);
    Text(heist.overtime ? "NEXT CASH OUT WINS" : ModeName(heist.mode), float2(Screen.width * 0.5, 66), 10, MUTED, Anchor.MiddleCenter);
    Text(MapName(heist.map), float2(24, 77), 9, MUTED);
    var count = heist.mode == MatchMode.Teams ? 2 : CountSeats(heist);
    var width = Math.Min(narrow ? 106 : 166, (Screen.width - 40) / float(count));
    var rowX = Screen.width * 0.5 - count * width * 0.5;
    for (var s = 0; s < count; s++)
    {
        var at = float2(rowX + s * width + width * 0.5, 121);
        var tone = TeamSuit(heist, s);
        Draw.RoundRect(at, float2(width - 8, 40), 7, NAVY);
        Draw.Rect(at + float2(-width * 0.5 + 6, 0), float2(3, 24), tone);
        Text(heist.mode == MatchMode.Teams ? (s == 0 ? "MINT CREW" : "ROUGE CREW") : Alias(s), at + float2(-width * 0.5 + 18, -4), narrow ? 9.0 : 11.0, tone);
        if (!narrow && heist.mode != MatchMode.Teams) Text(Human(heist, s) ? (s == picture.seat ? "YOU" : "FRIEND") : "BOT", at + float2(-width * 0.5 + 18, 11), 8, MUTED);
        Bold($"{ScoreOf(heist, s)}", at + float2(width * 0.5 - 17, 1), 23, CREAM, Anchor.MiddleRight);
    }
    var band = Screen.height - 93;
    Draw.RoundRect(float2(Screen.width * 0.5, band), float2(Math.Min(604, Screen.width - 36), 38), 9, NAVY);
    var exitText = $"EXIT {heist.exit + 1}  /  {ExitName(heist.exit)}  /  MOVES IN {int(Math.Ceil(heist.exitClock))}s";
    Text(picture.toastTime > 0 ? picture.toast : exitText, float2(Screen.width * 0.5, band), narrow ? 10.0 : 12.0, picture.toastTime > 0 ? picture.toastColor : MINT, Anchor.MiddleCenter);
    if (picture.seat >= 0)
    {
        var me = heist.thieves[picture.seat];
        var y = Screen.height - 38;
        Cooldown(float2(46, y), "SPACE", "DASH / STEAL", me.dashCooldown, 1.35, MINT);
        Cooldown(float2(narrow ? 230.0 : 245.0, y), "E", "FAKE / VANISH", me.bluffCooldown, 5.5, LILAC);
        if (!narrow) Text(heist.couch ? "P2: ARROWS  /  R SHIFT DASH  /  ENTER FAKE" : "WASD MOVE  /  HOLD GREEN EXIT TO BANK", float2(Screen.width * 0.5 + 45, y), 10, MUTED, Anchor.MiddleCenter);
    }
    if (heist.carrier >= 0)
    {
        var value = Value(heist);
        var x = Screen.width - (narrow ? 34 : 132);
        Gem(float2(x, 170), 12);
        Text($"{value}", float2(x + 20, 170), 18, GOLD);
        if (!narrow) Text(value >= 8 ? "MAX GREED" : "VALUE GROWS", float2(x - 18, 197), 8, MUTED);
        if (heist.carrier == picture.seat) Text("YOU HAVE IT. CASH OUT OR GET GREEDY.", float2(Screen.width * 0.5, 165), narrow ? 9.0 : 12.0, GOLD, Anchor.MiddleCenter);
    }
    if (heist.phase == RoundPhase.Countdown)
    {
        Draw.RoundRect(float2(Screen.width * 0.5, Screen.height * 0.5), float2(260, 138), 15, Color(0.035, 0.065, 0.115, 0.85));
        Bold($"{int(Math.Ceil(heist.countdown))}", float2(Screen.width * 0.5, Screen.height * 0.5 - 12), 65, MINT, Anchor.MiddleCenter);
        Text("TRUST NO ONE", float2(Screen.width * 0.5, Screen.height * 0.5 + 45), 12, GOLD, Anchor.MiddleCenter);
    }
}
void Results(Heist heist, Picture picture, Menu menu, mut Rooms.Lobby lobby)
{
    var width = Math.Min(520, Screen.width - 32);
    var at = float2(Screen.width * 0.5, Screen.height * 0.5);
    var x = at.x - width * 0.5 + 30;
    Draw.Rect(at, float2(Screen.width, Screen.height), Color(0.025, 0.05, 0.095, 0.78));
    Draw.RoundRect(at, float2(width, 420), 18, NAVY);
    Text("THE NIGHT BELONGS TO", at + float2(0, -165), 10, GOLD, Anchor.MiddleCenter);
    var name = heist.winner < 0 ? "NOBODY" : heist.mode == MatchMode.Teams ? (heist.winner == 0 ? "MINT CREW" : "ROUGE CREW") : Alias(heist.winner);
    Bold(name, at + float2(0, -120), 38, heist.winner < 0 ? GOLD : TeamSuit(heist, heist.winner), Anchor.MiddleCenter);
    Text(heist.winner == picture.seat ? "Beautifully dishonest." : "No hard feelings. Just another heist.", at + float2(0, -81), 13, MUTED, Anchor.MiddleCenter);
    for (var s = 0; s < CountSeats(heist); s++)
    {
        var y = at.y - 35 + s * 33;
        Bold(Alias(s), float2(x, y), 12, TeamSuit(heist, s));
        Text($"{heist.thieves[s].steals} steals   {heist.thieves[s].fooled} fooled", float2(at.x + 25, y), 11, MUTED, Anchor.MiddleCenter);
        Bold($"{heist.thieves[s].score}", float2(at.x + width * 0.5 - 30, y), 20, GOLD, Anchor.MiddleRight);
    }
    if (picture.seat == heist.hostSeat)
    {
        if (Button("ONE MORE HEIST", Rect(x, at.y + 125, width - 60, 44), true)) Launch(heist, menu, lobby, heist.couch);
    }
    else Text("Waiting for the host's rematch…", at + float2(0, 148), 13, MINT, Anchor.MiddleCenter);
    if (Button("BACK ROOM", Rect(x, at.y + 181, width - 60, 30))) { lobby.page = Rooms.Page.Room; lobby.resume = true; }
}
void Help()
{
    var width = Math.Min(540, Screen.width - 32);
    var at = float2(Screen.width * 0.5, Screen.height * 0.5);
    Draw.Rect(at, float2(Screen.width, Screen.height), Color(0.025, 0.05, 0.095, 0.83));
    Draw.RoundRect(at, float2(width, 370), 18, NAVY);
    var x = at.x - width * 0.5 + 25;
    Bold("A SHORT GUIDE TO BETRAYAL", float2(x, at.y - 143), width < 470 ? 17.0 : 23.0);
    Instruction(float2(x, at.y - 106), "01", "WASD / LEFT STICK: MOVE", "Touch the prism to pick it up. No button needed.", GOLD);
    Instruction(float2(x, at.y - 44), "02", "SPACE / PAD SOUTH: DASH", "Hit a carrier to steal. Hits briefly stun opponents.", MINT);
    Instruction(float2(x, at.y + 18), "03", "E / PAD WEST: BLUFF", "A double runs forward. You vanish for one second.", LILAC);
    Instruction(float2(x, at.y + 80), "04", "GREEN EXIT: CASH OUT", "Stand there briefly. The exit moves every 12 seconds.", CORAL);
    Text("The prism grows from 2 to 8 points. Steals keep its value.", float2(x, at.y + 150), width < 470 ? 10.0 : 12.0, MUTED);
}
[Stage(ArtStage.Interface)]
[After(Rooms.Pages)]
view Interface(Heist heist, Session session, Devices devices, Picture picture, mut Rooms.Lobby lobby, mut Menu menu, mut TouchHand touch)
{
    Draw.SetScreen();
    if (menu.round != heist.round)
    {
        menu.round = heist.round;
        if (lobby.page == Rooms.Page.Room && (heist.phase == RoundPhase.Countdown || heist.phase == RoundPhase.Playing))
            Rooms.Resume(lobby);
    }
    lobby.seats = 4;
    lobby.mine = picture.seat;
    lobby.bots = heist.bots;
    lobby.manned = 0;
    for (var s = 0; s < 4; s++) if (heist.present[s]) lobby.manned |= 1 << s;
    if (lobby.page == Rooms.Page.Title)
    {
        GUI.ClaimKeyboard();
        var scale = Math.Min(1, Screen.height / 720.0);
        Draw.Transform(float2(0), 0, float2(scale))
            { Title(heist, session, lobby, menu, picture, float2(Screen.width, Screen.height) / scale, scale); }
        return;
    }
    if (lobby.page == Rooms.Page.Room)
    {
        GUI.ClaimKeyboard();
        var scale = Math.Min(1, Screen.height / 580.0);
        Draw.Transform(float2(0), 0, float2(scale))
            { Room(heist, session, session.room, lobby, menu, picture, float2(Screen.width, Screen.height) / scale, scale); }
        return;
    }
    if (lobby.page != Rooms.Page.Playing) return;
    if (heist.phase == RoundPhase.Ready)
    {
        lobby.page = Rooms.Page.Room;
        lobby.resume = false;
        return;
    }
    HUD(heist, picture, menu);
    if (heist.phase == RoundPhase.Finished)
    {
        GUI.ClaimKeyboard();
        Results(heist, picture, menu, lobby);
        return;
    }
    if (Button(menu.help ? "CLOSE GUIDE" : "HOW TO PLAY", Rect(Screen.width - 155, 68, 133, 27))) menu.help = !menu.help;
    if (Button(menu.music ? "MUSIC ON" : "MUSIC OFF", Rect(Screen.width - 117, 104, 95, 25))) menu.music = !menu.music;
    if (menu.help)
    {
        Help();
        if (Button("GOT IT", Rect(Screen.width * 0.5 - 65, Screen.height * 0.5 + 194, 130, 34), true)) menu.help = false;
    }
    touch.move = float2(0);
    touch.dash = false;
    touch.bluff = false;
    // Three independent touch regions; keyboard/gamepad remain available.
    for (var finger = 0; finger < 10; finger++)
    {
        var f = devices.touchscreen.touches[finger];
        if (!f.press.pressed) { if (menu.stick == finger) menu.stick = -1; continue; }
        var at = Screen.Flip(f.position);
        if (menu.stick < 0 && at.x < Screen.width * 0.40 && at.y > Screen.height * 0.45)
        { menu.stick = finger; menu.touchStart = at; }
        if (menu.stick == finger) touch.move = Math.Clamp((at - menu.touchStart) / 48, float2(-1), float2(1));
        else if (at.x > Screen.width - 130 && at.y > Screen.height - 210) touch.dash = true;
        else if (at.x > Screen.width - 255 && at.y > Screen.height - 210) touch.bluff = true;
    }
    if (menu.stick >= 0)
    {
        Draw.WireCircle(menu.touchStart, 48, 2, Color(0.96, 0.91, 0.79, 0.3));
        Draw.Circle(menu.touchStart + touch.move * 34, 17, Color(0.48, 0.91, 0.76, 0.5));
        Draw.WireCircle(float2(Screen.width - 72, Screen.height - 168), 32, 2, MINT);
        Text("DASH", float2(Screen.width - 72, Screen.height - 168), 10, MINT, Anchor.MiddleCenter);
        Draw.WireCircle(float2(Screen.width - 188, Screen.height - 168), 32, 2, LILAC);
        Text("FAKE", float2(Screen.width - 188, Screen.height - 168), 10, LILAC, Anchor.MiddleCenter);
    }
}
