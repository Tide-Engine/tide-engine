// What the match's events look like on this machine: sparks where the ball
// is struck, the blast of a goal, a wrecked car going up. Each event is heard
// once, however often its tick is run again; a goal and a wreck wait until
// the server has confirmed them, as neither should be shown and taken back.
local event(BallTouched touch) ShowTouch(mut Look look, MatchState match)
{
    var tone = TeamGlow(TeamOf(touch.seat));
    Burst(look, match.ball.position, Color(tone.r, tone.g, tone.b, 0.9), 4 + touch.force * 7, 4 + touch.force * 4.0, 0.3, 0.09);
    if (touch.force >= 2)
    {
        look.motes.Add(Mote { position = match.ball.position, tint = Color(1, 0.95, 0.85, 0.7), size = 0.9 + touch.force * 0.35, life = 0.12, grow = 1.5 });
        if (touch.seat == look.seat) look.shake = Math.Max(look.shake, 0.25 + touch.force * 0.12);
    }
}

local event(BallBounced bounce) ShowBounce(mut Look look, MatchState match)
{
    var ball = match.ball.position;
    if (ball.y < BALL_RADIUS + 0.3)
        Smoke(look, float3(ball.x, 0.15, ball.z), Color(0.75, 0.85, 0.7, 0.16), 2 + bounce.force * 2, 2.0, 0.6, 0.35);
}

local event(verified GoalScored goal) ShowGoal(mut Look look)
{
    // The goal goes off in the color of the side that scored
    var tone = TeamGlow(goal.team);
    var at = float3(0, 3.2, (goal.team == 0 ? 1 : -1) * (BACK_WALL + 3));
    Burst(look, at, Color(tone.r, tone.g, tone.b, 1), 260, 46, 1.5, 0.3);
    Burst(look, at, Color(1, 1, 0.9, 1), 90, 28, 0.9, 0.2);
    Smoke(look, at, Color(tone.r, tone.g, tone.b, 0.35), 30, 14, 1.8, 2.2);
    look.motes.Add(Mote { position = at, tint = Color(tone.r, tone.g, tone.b, 0.9), size = 5, life = 0.5, grow = 5 });
    look.motes.Add(Mote { position = at, tint = Color(1, 1, 1, 0.9), size = 3, life = 0.22, grow = 3 });
    look.flash = 1;
    look.flashTone = tone;
    look.shake = 1;
    look.cheer = 1;
}

local event(verified CarWrecked wreck) ShowWreck(mut Look look, MatchState match)
{
    if (wreck.seat < 0 || wreck.seat >= CARS) return;
    var at = match.cars[wreck.seat].position;
    var tone = TeamGlow(TeamOf(wreck.seat));
    Burst(look, at, Color(1, 0.75, 0.3, 1), 70, 20, 0.9, 0.2);
    Burst(look, at, Color(tone.r, tone.g, tone.b, 1), 40, 14, 1.1, 0.16);
    Smoke(look, at, Color(0.2, 0.2, 0.22, 0.55), 16, 6, 1.4, 1.0);
    look.motes.Add(Mote { position = at, tint = Color(1, 0.85, 0.5, 0.95), size = 2.2, life = 0.25, grow = 2.5 });
    if (wreck.seat == look.seat || wreck.by == look.seat) look.shake = 0.9;
}

local event(PadTaken taken) ShowPad(mut Look look)
{
    var at = PadPosition(taken.pad);
    Burst(look, float3(at.x, PadBig(taken.pad) ? 0.9 : 0.3, at.z), Color(1, 0.75, 0.2, 0.9), PadBig(taken.pad) ? 30 : 8, PadBig(taken.pad) ? 9.0 : 4.0, 0.4, 0.1);
}

local event(CarJumped jumped) ShowJump(mut Look look, MatchState match)
{
    if (jumped.seat < 0 || jumped.seat >= CARS) return;
    var car = match.cars[jumped.seat];
    // A dodge leaves a ring of light where it kicked off the air
    if (jumped.dodge)
        look.motes.Add(Mote { position = car.position, tint = Color(0.85, 0.95, 1, 0.5), size = 0.7, life = 0.18, grow = 1.6 });
    else if (car.position.y < 1.5)
        Smoke(look, car.position - float3(0, 0.12, 0), Color(0.8, 0.85, 0.75, 0.14), 3, 1.5, 0.45, 0.3);
}
