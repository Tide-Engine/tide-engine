// What's drawn over the match on this machine: the score and the clock, the
// boost gauge, what's called out as it happens, names over the other cars,
// the result, and the controls a touchscreen plays with.
using Rooms;

struct Callout
{
    string text;
    Color tone = Color.white;
    float age;
}

local singleton Board
{
    List<Callout> callouts;     // What this player just earned, newest last
    float goalAge = 100;        // Seconds since the last goal was confirmed
    int goalTeam;
    int goalScorer = -1;
    int goalAssist = -1;
    int goalSpeed;
    float playAge;              // Seconds since the kickoff's countdown ended
    float hint = 14;            // Seconds the controls are still shown for
    float camAge = 100;         // Seconds since the ball camera was switched
    bool camWas = true;
}

string CarName(MatchState match, int seat, int mine)
{
    if (seat == mine) return "You";
    if (seat >= 0 && seat < CARS && match.manned[seat]) return $"Player {seat + 1}";
    switch (seat)
    {
        case 0: return "Comet";
        case 1: return "Blitz";
        case 2: return "Nova";
        case 3: return "Jet";
        case 4: return "Flare";
    }
    return "Dash";
}

string Clock(float seconds)
{
    var whole = int(Math.Ceil(Math.Max(0, seconds)));
    var rest = whole % 60;
    return rest < 10 ? $"{whole / 60}:0{rest}" : $"{whole / 60}:{rest}";
}

local event(verified GoalScored goal) AnnounceGoal(mut Board board)
{
    board.goalAge = 0;
    board.goalTeam = goal.team;
    board.goalScorer = goal.scorer;
    board.goalAssist = goal.assist;
    board.goalSpeed = goal.speed;
}

local event(verified FeatEarned earned) AnnounceFeat(mut Board board, Look look)
{
    if (earned.seat != look.seat) return;
    mut var text = "";
    mut var tone = Color.white;
    switch (earned.feat)
    {
        case Feat.Goal: text = "GOAL  +100"; tone = Color(1, 0.86, 0.3); break;
        case Feat.Assist: text = "ASSIST  +50"; tone = Color(0.6, 0.9, 1); break;
        case Feat.Save: text = "SAVE  +50"; tone = Color(0.6, 1, 0.7); break;
        case Feat.EpicSave: text = "EPIC SAVE  +75"; tone = Color(0.5, 1, 0.85); break;
        case Feat.Shot: text = "SHOT ON GOAL  +10"; break;
        case Feat.Wreck: text = "DEMOLITION"; tone = Color(1, 0.55, 0.3); break;
    }
    board.callouts.Add(Callout { text = text, tone = tone });
    if (board.callouts.count > 5) board.callouts.RemoveAt(0);
}

// Where the touch controls are, by the screen's size
float2 TouchStick(float2 screen) { return float2(96, screen.y - 112); }
float2 TouchBoost(float2 screen) { return float2(screen.x - 74, screen.y - 104); }
float2 TouchJump(float2 screen) { return float2(screen.x - 168, screen.y - 70); }
float2 TouchSlide(float2 screen) { return float2(screen.x - 70, screen.y - 206); }
float2 TouchCam(float2 screen) { return float2(screen.x - 166, screen.y - 168); }

void Finger(mut Hand hand, float2 at, float2 start, float2 screen)
{
    if (Math.Distance(start, TouchStick(screen)) < 96)
    {
        mut var push = (at - TouchStick(screen)) / 56;
        if (Math.Length(push) > 1) push = Math.Normalize(push);
        hand.stick = push;
        hand.steer = push.x;
        hand.throttle = -push.y;
        hand.pitch = push.y;
    }
    if (Math.Distance(start, TouchBoost(screen)) < 50) hand.boost = true;
    if (Math.Distance(start, TouchJump(screen)) < 42) hand.jump = true;
    if (Math.Distance(start, TouchSlide(screen)) < 36) hand.handbrake = true;
}

void TouchButton(float2 at, float radius, string text, bool held, Color tone)
{
    Draw.Shape(Shape { center = at, size = float2(radius * 2), ellipse = true, color = Color(0.02, 0.04, 0.07, held ? 0.75 : 0.5),
                       outline = held ? 3.0 : 1.5, outlineColor = held ? Color.white : Color(tone.r, tone.g, tone.b, 0.85) });
    Draw.Text(text, at, radius * 0.34, held ? Color.white : tone, Anchor.MiddleCenter, Font.Bold);
}

// Text with a dark edge under it, to read over grass and sky alike
void Banner(string text, float2 at, float size, Color tone)
{
    Draw.Text(text, at + float2(0, size * 0.06), size, Color(0, 0.02, 0.05, 0.75 * tone.a), Anchor.MiddleCenter, Font.Bold);
    Draw.Text(text, at, size, tone, Anchor.MiddleCenter, Font.Bold);
}

[Stage(Layers.Hud)]
view Hud(MatchState match, mut Look look, mut Board board, mut Hand hand, Devices devices, Lobby lobby)
{
    var screen = float2(Screen.width, Screen.height);
    var dt = Math.Min(Frame.dt, 0.05);
    // The touch controls are read whether or not they're drawn this frame
    hand.throttle = 0; hand.steer = 0; hand.pitch = 0; hand.stick = float2(0);
    hand.jump = false; hand.boost = false; hand.handbrake = false;
    if (devices.touchscreen.connected) hand.touch = true;
    if (lobby.playing)
        foreach (var touch in devices.touchscreen.touches)
        {
            if (!touch.press.pressed) continue;
            Finger(hand, Screen.Flip(touch.position), Screen.Flip(touch.startPosition), screen);
            if (touch.press.down && Math.Distance(Screen.Flip(touch.position), TouchCam(screen)) < 30) look.ballCam = !look.ballCam;
        }

    // The throttle key, held as the car leaves the ground, is held through
    // the takeoff until it's let go, or another key says where the nose goes
    var keys = devices.keyboard;
    var forward = keys.w.pressed || keys.upArrow.pressed;
    var steered = keys.s.pressed || keys.downArrow.pressed || keys.q.pressed || keys.e.pressed
               || (hand.layout == KeyLayout.Classic ? keys.leftShift.pressed : devices.mouse.right.pressed);
    if (match.cars[look.seat].wheels >= 3 || !forward) hand.held = forward;
    if (steered) hand.held = false;

    board.goalAge += dt;
    board.playAge = match.phase == MatchPhase.Playing ? board.playAge + dt : 0;
    if (look.ballCam != board.camWas) board.camAge = 0;
    board.camWas = look.ballCam;
    board.camAge += dt;
    mut var index = 0;
    while (index < board.callouts.count)
    {
        board.callouts[index].age += dt;
        if (board.callouts[index].age > 3) board.callouts.RemoveAt(index);
        else index++;
    }
    if (lobby.page != Page.Playing) return;
    board.hint = Math.Max(0, board.hint - dt);

    Draw.SetScreen();
    var narrow = screen.x < 620;
    var scale = narrow ? 0.82 : 1.0;
    var middle = screen.x * 0.5;
    var blue = TeamColor(0);
    var orange = TeamColor(1);

    // Names over the other cars, in their side's color
    for (var seat = 0; seat < match.size * 2; seat++)
    {
        if (seat == look.seat || match.cars[seat].wrecked > 0) continue;
        var at = look.scene.WorldToScreen(match.cars[seat].position + float3(0, 1.25, 0));
        if (at.z <= 0 || at.z >= 1 || at.x < 30 || at.x > screen.x - 30 || at.y < 70 || at.y > screen.y - 40) continue;
        var name = CarName(match, seat, look.seat);
        var wide = Draw.MeasureText(name, 12, Font.Bold).x + 16;
        var tone = TeamColor(TeamOf(seat));
        Draw.RoundRect(at.xy, float2(wide, 19), 4, Color(tone.r * 0.5, tone.g * 0.5, tone.b * 0.5, 0.78));
        Draw.Text(name, at.xy, 12, Color.white, Anchor.MiddleCenter, Font.Bold);
    }

    // The score, either side of the clock
    var top = 30.0;
    Draw.RoundRect(float2(middle, top), float2(268 * scale, 50), 8, Color(0.02, 0.03, 0.05, 0.86));
    Draw.RoundRect(float2(middle - 94 * scale, top), float2(74 * scale, 44), 6, Color(blue.r, blue.g, blue.b, 0.95));
    Draw.RoundRect(float2(middle + 94 * scale, top), float2(74 * scale, 44), 6, Color(orange.r, orange.g, orange.b, 0.95));
    Draw.Text($"{match.score[0]}", float2(middle - 94 * scale, top), 32, Color.white, Anchor.MiddleCenter, Font.Bold);
    Draw.Text($"{match.score[1]}", float2(middle + 94 * scale, top), 32, Color.white, Anchor.MiddleCenter, Font.Bold);
    var last = !match.overtime && match.clock <= 30;
    Draw.Text(match.overtime ? $"+{Clock(match.clock)}" : Clock(match.clock), float2(middle, top), 26,
        last ? Color(1, 0.45, 0.3) : Color.white, Anchor.MiddleCenter, Font.Bold);
    if (match.overtime) Draw.Text("OVERTIME", float2(middle, top + 36), 11, Color(1, 0.8, 0.3), Anchor.MiddleCenter, Font.Bold);

    // The boost gauge: an arc that empties, round the number left
    var mine = match.cars[look.seat];
    var radius = narrow ? 44.0 : 58.0;
    var gauge = float2(screen.x - radius - 26, screen.y - radius - (hand.touch ? 262 : 26));
    var full = Math.Saturate(mine.boost / 100);
    var heat = Math.Lerp(Color(1, 0.35, 0.08), Color(1, 0.72, 0.15), full);
    Draw.Circle(gauge, radius + 7, Color(0.02, 0.03, 0.05, 0.7));
    Draw.Arc(gauge, radius, Math.PI * 0.75, Math.PI * 1.5, 9, Color(0.25, 0.2, 0.14, 0.9));
    if (full > 0.005) Draw.Arc(gauge, radius, Math.PI * 0.75, Math.PI * 1.5 * full, 9, heat);
    Draw.Text($"{int(Math.Round(mine.boost))}", gauge - float2(0, 3), radius * 0.72, Color.white, Anchor.MiddleCenter, Font.Bold);
    Draw.Text("BOOST", gauge + float2(0, radius * 0.5), 10, Color(1, 0.75, 0.3), Anchor.MiddleCenter, Font.Bold);
    if (mine.supersonic) Draw.Text("SUPERSONIC", gauge - float2(0, radius + 20), 11, Color(0.75, 0.9, 1), Anchor.MiddleCenter, Font.Bold);

    // Which camera, for a moment after it's switched
    if (board.camAge < 1.6)
        Draw.Text(look.ballCam ? "BALL CAM" : "CAR CAM", float2(middle, screen.y - 96), 15,
            Color(1, 1, 1, Math.Saturate(1.6 - board.camAge)), Anchor.MiddleCenter, Font.Bold);

    // Where the ball is, when it's out of the picture
    if (match.ball.live)
    {
        var at = look.scene.WorldToScreen(match.ball.position);
        var behind = at.z <= 0 || at.z >= 1;
        if (behind || at.x < 20 || at.x > screen.x - 20 || at.y < 70 || at.y > screen.y - 20)
        {
            mut var mark = float2(Math.Clamp(at.x, 26, screen.x - 26), Math.Clamp(at.y, 78, screen.y - 30));
            if (behind) mark = float2(Math.Clamp(screen.x - at.x, 26, screen.x - 26), screen.y - 30);
            Draw.Circle(mark, 11, Color(0.02, 0.03, 0.05, 0.8));
            Draw.Circle(mark, 7, Color.white);
            Draw.Circle(mark, 3, Color(0.2, 0.23, 0.28));
        }
    }

    // What this player just earned
    for (var row = 0; row < board.callouts.count; row++)
    {
        var callout = board.callouts[row];
        var fade = Math.Saturate(3 - callout.age) * Math.Saturate(callout.age * 6);
        Draw.Text(callout.text, float2(screen.x - 24, screen.y * 0.42 + row * 24), 15,
            Color(callout.tone.r, callout.tone.g, callout.tone.b, fade), Anchor.MiddleRight, Font.Bold);
    }

    // The big words: the countdown, a goal, the last seconds, the result
    var centre = float2(middle, screen.y * 0.3);
    if (match.phase == MatchPhase.Countdown)
    {
        var left = Math.Max(match.phaseTime, 0);
        var beat = 1 - Math.Frac(left);
        Banner($"{int(Math.Ceil(left))}", centre, 96 * scale * (1.25 - beat * 0.25), Color(1, 1, 1, Math.Saturate(2 - beat * 1.4)));
    }
    else if (match.phase == MatchPhase.Playing && board.playAge < 0.9)
        Banner("GO!", centre, 84 * scale, Color(0.6, 1, 0.6, Math.Saturate(1.8 - board.playAge * 2)));
    if (match.phase == MatchPhase.Goal || board.goalAge < 3.2 && match.phase != MatchPhase.Finished)
    {
        var tone = TeamGlow(board.goalTeam);
        var swell = 1 + Math.Saturate(0.3 - board.goalAge) * 1.2;
        Banner("GOAL!", centre - float2(0, 16), 92 * scale * swell, Color(tone.r, tone.g, tone.b, Math.Saturate(3.4 - board.goalAge)));
        if (board.goalScorer >= 0 && board.goalAge > 0.35)
        {
            var who = board.goalScorer == look.seat ? "You scored" : $"{CarName(match, board.goalScorer, look.seat)} scored";
            Banner($"{who}   {board.goalSpeed} km/h", centre + float2(0, 54), 21 * scale, Color(1, 1, 1, Math.Saturate(3.4 - board.goalAge)));
            if (board.goalAssist >= 0)
                Banner($"Assist: {CarName(match, board.goalAssist, look.seat)}", centre + float2(0, 82), 15 * scale, Color(0.85, 0.92, 1, Math.Saturate(3.4 - board.goalAge)));
        }
    }
    if (match.phase == MatchPhase.Playing && !match.overtime && !match.waiting)
    {
        if (match.clock <= 10 && match.clock > 0)
        {
            var beat = Math.Frac(match.clock);
            Banner($"{int(Math.Ceil(match.clock))}", float2(middle, 104), 54 * scale * (0.9 + beat * 0.25), Color(1, 0.5, 0.35, 0.55 + beat * 0.45));
        }
        else if (match.clock <= 60 && match.clock > 57) Banner("1 MINUTE REMAINING", float2(middle, 96), 22 * scale, Color(1, 0.85, 0.5, Math.Saturate((match.clock - 57) * 2)));
        else if (match.clock <= 30 && match.clock > 27) Banner("30 SECONDS REMAINING", float2(middle, 96), 22 * scale, Color(1, 0.7, 0.4, Math.Saturate((match.clock - 27) * 2)));
        else if (match.clock <= 0) Banner("FINAL TOUCH", float2(middle, 96), 22 * scale, Color(1, 0.6, 0.4));
    }
    if (match.phase == MatchPhase.Countdown && match.overtime) Banner("OVERTIME", float2(middle, 104), 34 * scale, Color(1, 0.8, 0.3));

    if (match.phase == MatchPhase.Finished)
    {
        // The result: who won, and what each car did, best first
        var tone = TeamGlow(match.winner);
        Banner(match.winner == 0 ? "BLUE WINS" : "ORANGE WINS", float2(middle, screen.y * 0.16 + 40), 60 * scale, tone);
        var cars = match.size * 2;
        var wide = Math.Min(screen.x - 24, 560.0);
        var rowHigh = 30.0;
        var tableTop = screen.y * 0.16 + 100;
        Draw.RoundRect(float2(middle, tableTop + (cars + 1) * rowHigh * 0.5), float2(wide, (cars + 1) * rowHigh + 16), 10, Color(0.02, 0.03, 0.05, 0.88));
        var left = middle - wide * 0.5 + 18;
        var step = (wide - 180) / 5;
        Draw.Text("SCORE", float2(left + 150 + step * 0.5, tableTop + 15), 11, Color(0.7, 0.78, 0.86), Anchor.MiddleCenter, Font.Bold);
        Draw.Text("GOALS", float2(left + 150 + step * 1.5, tableTop + 15), 11, Color(0.7, 0.78, 0.86), Anchor.MiddleCenter, Font.Bold);
        Draw.Text("ASSISTS", float2(left + 150 + step * 2.5, tableTop + 15), 11, Color(0.7, 0.78, 0.86), Anchor.MiddleCenter, Font.Bold);
        Draw.Text("SAVES", float2(left + 150 + step * 3.5, tableTop + 15), 11, Color(0.7, 0.78, 0.86), Anchor.MiddleCenter, Font.Bold);
        Draw.Text("SHOTS", float2(left + 150 + step * 4.5, tableTop + 15), 11, Color(0.7, 0.78, 0.86), Anchor.MiddleCenter, Font.Bold);
        mut var row = 0;
        // The winners first, then each side by its points
        for (var pass = 0; pass < 2; pass++)
            for (var rank = 0; rank < cars; rank++)
            {
                // The seat with this many better on its side
                for (var seat = 0; seat < cars; seat++)
                {
                    if ((TeamOf(seat) == match.winner) != (pass == 0)) continue;
                    mut var better = 0;
                    for (var other = TeamOf(seat); other < cars; other += 2)
                        if (match.cars[other].points > match.cars[seat].points || match.cars[other].points == match.cars[seat].points && other < seat) better += 1;
                    if (better != rank) continue;
                    var car = match.cars[seat];
                    var y = tableTop + 30 + row * rowHigh + 15;
                    var side = TeamColor(TeamOf(seat));
                    Draw.RoundRect(float2(middle, y), float2(wide - 16, rowHigh - 4), 5, Color(side.r, side.g, side.b, seat == look.seat ? 0.6 : 0.3));
                    Draw.Text(CarName(match, seat, look.seat), float2(left, y), 15, Color.white, Anchor.MiddleLeft, Font.Bold);
                    Draw.Text($"{car.points}", float2(left + 150 + step * 0.5, y), 15, Color.white, Anchor.MiddleCenter, Font.Bold);
                    Draw.Text($"{car.goals}", float2(left + 150 + step * 1.5, y), 15, Color.white, Anchor.MiddleCenter);
                    Draw.Text($"{car.assists}", float2(left + 150 + step * 2.5, y), 15, Color.white, Anchor.MiddleCenter);
                    Draw.Text($"{car.saves}", float2(left + 150 + step * 3.5, y), 15, Color.white, Anchor.MiddleCenter);
                    Draw.Text($"{car.shots}", float2(left + 150 + step * 4.5, y), 15, Color.white, Anchor.MiddleCenter);
                    row += 1;
                }
            }
        Draw.Text($"Next match in {int(Math.Ceil(Math.Max(match.phaseTime, 0)))}", float2(middle, tableTop + (cars + 1) * rowHigh + 30), 14,
            Color(0.85, 0.9, 0.95), Anchor.MiddleCenter);
    }

    if (hand.touch)
    {
        var stick = TouchStick(screen);
        Draw.Circle(stick, 60, Color(0.02, 0.04, 0.07, 0.45));
        Draw.WireCircle(stick, 59, 1.5, Color(0.7, 0.82, 0.92, 0.5));
        Draw.Circle(stick + hand.stick * 42, 25, Color(0.88, 0.94, 1, 0.42));
        TouchButton(TouchBoost(screen), 47, "BOOST", hand.boost, Color(1, 0.7, 0.2));
        TouchButton(TouchJump(screen), 39, "JUMP", hand.jump, Color(0.8, 0.92, 1));
        TouchButton(TouchSlide(screen), 33, "SLIDE", hand.handbrake, Color(0.8, 0.92, 1));
        TouchButton(TouchCam(screen), 27, "CAM", look.ballCam, Color(0.8, 0.92, 1));
    }
    else if (board.hint > 0)
    {
        var fade = Math.Saturate(board.hint);
        Draw.RoundRect(float2(middle, screen.y - 26), float2(Math.Min(screen.x - 20, 980.0), 28), 8, Color(0.02, 0.03, 0.05, 0.6 * fade));
        var classic = hand.layout == KeyLayout.Classic;
        var keysHint = narrow ? (classic ? "WASD drive   RMB jump   LMB boost   SPACE camera" : "WASD drive   SPACE jump   SHIFT boost   MMB camera")
            : classic ? "WASD  Drive      RIGHT MOUSE  Jump / Dodge      LEFT MOUSE  Boost      SHIFT  Powerslide / Air roll      Q E  Roll      SPACE  Ball cam"
                      : "WASD  Drive      SPACE  Jump / Dodge      SHIFT  Boost      RIGHT MOUSE  Powerslide / Air roll      Q E  Roll      MIDDLE MOUSE  Ball cam";
        Draw.Text(keysHint, float2(middle, screen.y - 26), narrow ? 10 : 12, Color(0.9, 0.94, 0.98, fade), Anchor.MiddleCenter);
    }
}

[Before(Rooms.Pages)]
view RoomTheme()
{
    GUI.SetTheme(GUITheme { text = Color(0.93, 0.96, 1), panel = Color(0.03, 0.05, 0.085),
        control = Color(0.07, 0.15, 0.27), hot = Color(0.11, 0.27, 0.46), pressed = Color(0.05, 0.1, 0.19),
        field = Color(0.02, 0.035, 0.06), fieldHot = Color(0.04, 0.09, 0.15), accent = Color(1, 0.56, 0.1), radius = 6 });
}

// How many cars a side, beside the Menu button: a press asks for one more,
// and round again, from the next kickoff.
[After(Rooms.Pages)]
view RoomSetup(MatchState match, Look look, mut Lobby lobby, mut Hand hand, mut Board board, query (Participant participant) players)
{
    mut var manned = 0;
    foreach (var player in players) manned |= 1 << player.participant.seat;
    lobby.seats = match.size * 2;
    lobby.manned = manned;
    lobby.mine = look.seat;
    lobby.bots = true;
    lobby.offersNewGame = true;
    lobby.offersBots = false;
    if (lobby.newGame) Send(Restart { });
    if (lobby.page != Page.Playing) return;
    var label = match.wanted == match.size ? $"{match.size}v{match.size}" : $"{match.wanted}v{match.wanted} next";
    // On a narrow screen the two buttons sit under the score, at its sides
    var place = Screen.width < 620 ? Rect(10, 64, 92, 32) : Rect(Screen.width - 190, 10, 92, 32);
    if (GUI.Button(place, label)) Send(Teams { size = match.wanted % 3 + 1 });
    // Which of the game's two layouts the keys and the mouse are in
    if (hand.touch || Screen.width < 620) return;
    if (GUI.Button(Rect(Screen.width - 332, 10, 132, 32), hand.layout == KeyLayout.Classic ? "Keys: Classic" : "Keys: Modern"))
    {
        hand.layout = hand.layout == KeyLayout.Classic ? KeyLayout.Modern : KeyLayout.Classic;
        board.hint = 10;
    }
}

override string Rooms.Title() { return "AERIAL"; }
override string Rooms.Tagline() { return "Rocket-powered car soccer. Boost, fly, score."; }
override Rect Rooms.MenuButton(float2 screen) { return Rect(screen.x - 90, screen.x < 620 ? 64 : 10, 80, 32); }
