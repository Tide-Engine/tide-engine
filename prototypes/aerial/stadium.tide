// The stadium, built once from the numbers the match collides with: what's
// drawn as a wall is where arena.tide says the wall is. The pitch and what
// stands on it are solid; the walls above the ramps, the roof and the nets
// are see-through, with the stands and the sky beyond them.
const float STAND_START = 2.4;      // Behind the walls, where the seats begin
const float SEAT_RISE = 0.78;
const float SEAT_RUN = 1.15;
const int SEAT_ROWS = 22;

// The wall's line round a quarter of the pitch, from the middle of a side
// wall to the middle of an end wall: each point with the way into the pitch.
void Rim(mut List<float4> rim)
{
    rim.Add(float4(SIDE_WALL, 0, -1, 0));
    var first = float2(SIDE_WALL - CORNER_ROUND, CORNER_CUT - SIDE_WALL + CORNER_ROUND - CORNER_ROUND / SQRT_HALF);
    var second = float2(CORNER_CUT - BACK_WALL + CORNER_ROUND - CORNER_ROUND / SQRT_HALF, BACK_WALL - CORNER_ROUND);
    for (var step = 0; step <= 5; step++)
    {
        var turn = step * Math.PI / 20;
        rim.Add(float4(first.x + Math.Cos(turn) * CORNER_ROUND, first.y + Math.Sin(turn) * CORNER_ROUND, -Math.Cos(turn), -Math.Sin(turn)));
    }
    for (var step = 0; step <= 5; step++)
    {
        var turn = Math.PI / 4 + step * Math.PI / 20;
        rim.Add(float4(second.x + Math.Cos(turn) * CORNER_ROUND, second.y + Math.Sin(turn) * CORNER_ROUND, -Math.Cos(turn), -Math.Sin(turn)));
    }
    rim.Add(float4(GOAL_HALF, BACK_WALL, 0, -1));
    rim.Add(float4(0, BACK_WALL, 0, -1));
}

// A corner of the stadium: a point of the rim, moved `inward` into the pitch
// (or out of it, under 0) and up to `height`, in one of the four quarters.
float3 Around(float4 rim, float inward, float height, float2 quarter)
{
    return float3((rim.x + rim.z * inward) * quarter.x, height, (rim.y + rim.w * inward) * quarter.y);
}

float3 Inward(float4 rim, float2 quarter)
{
    return float3(rim.z * quarter.x, 0, rim.w * quarter.y);
}

// A strip of wall between two points of the rim: from one (inward, height)
// to another, each with how much its normal leans from the wall's to up.
void Strip(mut List<Solid> vertices, mut List<int> faces, float4 from, float4 to, float2 quarter,
           float2 low, float2 high, float2 lowLean, float2 highLean, Color paint, float material)
{
    var up = float3(0, 1, 0);
    Patch(vertices, faces,
        Solid { position = Around(from, low.x, low.y, quarter), normal = Inward(from, quarter) * lowLean.x + up * lowLean.y, color = paint, material = material },
        Solid { position = Around(to, low.x, low.y, quarter), normal = Inward(to, quarter) * lowLean.x + up * lowLean.y, color = paint, material = material },
        Solid { position = Around(to, high.x, high.y, quarter), normal = Inward(to, quarter) * highLean.x + up * highLean.y, color = paint, material = material },
        Solid { position = Around(from, high.x, high.y, quarter), normal = Inward(from, quarter) * highLean.x + up * highLean.y, color = paint, material = material });
}

void MakeGoal(mut Models models, float end)
{
    var team = end < 0 ? 0 : 1;
    var tone = TeamGlow(team);
    var dark = Color(0.03, 0.04, 0.055);
    var line = end * BACK_WALL;
    var back = end * (BACK_WALL + GOAL_DEPTH);
    var middle = (line + back) * 0.5;
    // The frame glows in its side's color, just behind the line
    for (var side = -1; side <= 1; side += 2)
    {
        Box(models.shell, models.shellFaces, float3(side * (GOAL_HALF + 0.2), GOAL_HEIGHT * 0.5 + 0.2, line + end * 0.22),
            float3(0.4, GOAL_HEIGHT + 0.4, 0.44), tone, GLOW);
        // The walls of the recess, from outside
        Box(models.shell, models.shellFaces, float3(side * (GOAL_HALF + 0.85), GOAL_HEIGHT * 0.5, middle + end * 0.5),
            float3(0.9, GOAL_HEIGHT, GOAL_DEPTH), dark);
        Quad(models.glass, models.glassFaces, float3(side * GOAL_HALF, 0, line), float3(side * GOAL_HALF, 0, back),
             float3(side * GOAL_HALF, GOAL_HEIGHT, back), float3(side * GOAL_HALF, GOAL_HEIGHT, line), float3(-side, 0, 0), tone, 1);
    }
    Box(models.shell, models.shellFaces, float3(0, GOAL_HEIGHT + 0.2, line + end * 0.22), float3(GOAL_HALF * 2 + 0.8, 0.4, 0.44), tone, GLOW);
    Box(models.shell, models.shellFaces, float3(0, GOAL_HEIGHT + 0.75, middle + end * 0.5), float3(GOAL_HALF * 2 + 2.6, 0.7, GOAL_DEPTH), dark);
    Box(models.shell, models.shellFaces, float3(0, GOAL_HEIGHT * 0.5, back + end * 0.45), float3(GOAL_HALF * 2 + 2.6, GOAL_HEIGHT + 1.4, 0.9), dark);
    Quad(models.glass, models.glassFaces, float3(-GOAL_HALF, GOAL_HEIGHT, line), float3(GOAL_HALF, GOAL_HEIGHT, line),
         float3(GOAL_HALF, GOAL_HEIGHT, back), float3(-GOAL_HALF, GOAL_HEIGHT, back), float3(0, -1, 0), tone, 1);
    Quad(models.glass, models.glassFaces, float3(-GOAL_HALF, 0, back), float3(GOAL_HALF, 0, back),
         float3(GOAL_HALF, GOAL_HEIGHT, back), float3(-GOAL_HALF, GOAL_HEIGHT, back), float3(0, 0, -end), tone, 1);
}

void MakeStadium(mut Models models)
{
    mut List<float4> rim = [];
    Rim(rim);
    var concrete = Color(0.44, 0.47, 0.52);
    var steel = Color(0.2, 0.23, 0.28);
    var glassTone = Color(0.55, 0.75, 0.9);
    var top = CEILING - CEILING_RAMP;
    // The pitch is one sheet, cut to the arena's shape by its frag
    Quad(models.pitch, models.pitchFaces, float3(-SIDE_WALL, 0, -BACK_WALL - GOAL_DEPTH), float3(SIDE_WALL, 0, -BACK_WALL - GOAL_DEPTH),
         float3(SIDE_WALL, 0, BACK_WALL + GOAL_DEPTH), float3(-SIDE_WALL, 0, BACK_WALL + GOAL_DEPTH), float3(0, 1, 0), Color.white);

    for (var turn = 0; turn < 4; turn++)
    {
        var quarter = float2(turn % 2 == 0 ? 1 : -1, turn < 2 ? 1 : -1);
        var team = quarter.y < 0 ? 0 : 1;
        var tone = TeamGlow(team);
        var boards = team == 0 ? Color(0.05, 0.11, 0.24) : Color(0.24, 0.1, 0.04);
        for (var at = 0; at + 1 < rim.count; at++)
        {
            var from = rim[at];
            var to = rim[at + 1];
            var mouth = at + 2 == rim.count;
            if (!mouth)
            {
                // The ramp: a quarter pipe from the grass into the wall
                for (var step = 0; step < 8; step++)
                {
                    var a = step * Math.PI / 16;
                    var b = (step + 1) * Math.PI / 16;
                    Strip(models.shell, models.shellFaces, from, to, quarter,
                          float2(RAMP - RAMP * Math.Sin(a), RAMP - RAMP * Math.Cos(a)), float2(RAMP - RAMP * Math.Sin(b), RAMP - RAMP * Math.Cos(b)),
                          float2(Math.Sin(a), Math.Cos(a)), float2(Math.Sin(b), Math.Cos(b)), boards, BOARDS);
                }
                // A lit line where the ramp ends and the glass begins
                Strip(models.shell, models.shellFaces, from, to, quarter, float2(0, RAMP), float2(0, RAMP + 0.14),
                      float2(1, 0), float2(1, 0), tone, GLOW);
                Strip(models.glass, models.glassFaces, from, to, quarter, float2(0, RAMP + 0.14), float2(0, GOAL_HEIGHT),
                      float2(1, 0), float2(1, 0), tone, 0);
            }
            Strip(models.glass, models.glassFaces, from, to, quarter, float2(0, GOAL_HEIGHT), float2(0, top),
                  float2(1, 0), float2(1, 0), glassTone, 0);
            for (var step = 0; step < 4; step++)
            {
                var a = step * Math.PI / 8;
                var b = (step + 1) * Math.PI / 8;
                Strip(models.glass, models.glassFaces, from, to, quarter,
                      float2(CEILING_RAMP - CEILING_RAMP * Math.Cos(a), top + CEILING_RAMP * Math.Sin(a)),
                      float2(CEILING_RAMP - CEILING_RAMP * Math.Cos(b), top + CEILING_RAMP * Math.Sin(b)),
                      float2(Math.Cos(a), -Math.Sin(a)), float2(Math.Cos(b), -Math.Sin(b)), glassTone, 0);
            }
            // The roof, as a fan from over the centre spot
            Wedge(models.glass, models.glassFaces, float3(0, CEILING, 0), Around(from, CEILING_RAMP, CEILING, quarter),
                  Around(to, CEILING_RAMP, CEILING, quarter), float3(0, -1, 0), glassTone, 0);

            // Behind the wall: a kerb, then rows of seats going up and back.
            // Behind a goal they start above it.
            if (!mouth)
            {
                Strip(models.shell, models.shellFaces, from, to, quarter, float2(-0.05, 0), float2(-0.05, STAND_START),
                      float2(1, 0), float2(1, 0), steel, MATTE);
                Strip(models.shell, models.shellFaces, from, to, quarter, float2(-0.05, STAND_START), float2(-STAND_START, STAND_START),
                      float2(0, 1), float2(0, 1), concrete, MATTE);
            }
            for (var row = mouth ? 8 : 0; row < SEAT_ROWS; row++)
            {
                var out = -STAND_START - row * SEAT_RUN;
                var height = STAND_START + row * SEAT_RISE;
                Strip(models.shell, models.shellFaces, from, to, quarter, float2(out, height), float2(out, height + SEAT_RISE),
                      float2(1, 0), float2(1, 0), Color.white, CROWD);
                Strip(models.shell, models.shellFaces, from, to, quarter, float2(out, height + SEAT_RISE), float2(out - SEAT_RUN, height + SEAT_RISE),
                      float2(0, 1), float2(0, 1), concrete, MATTE);
            }
            // The back of the stand, and the lit edge of the canopy over it
            var far = -STAND_START - SEAT_ROWS * SEAT_RUN;
            var high = STAND_START + SEAT_ROWS * SEAT_RISE;
            Strip(models.shell, models.shellFaces, from, to, quarter, float2(far, high), float2(far, high + 7),
                  float2(1, 0), float2(1, 0), steel, MATTE);
            Strip(models.shell, models.shellFaces, from, to, quarter, float2(far, high + 7), float2(far + 13, high + 9.5),
                  float2(0.2, -1), float2(0.2, -1), Color(0.5, 0.54, 0.6), MATTE);
            Strip(models.shell, models.shellFaces, from, to, quarter, float2(far + 13, high + 9.5), float2(far + 13, high + 10.3),
                  float2(1, 0), float2(1, 0), Color(1, 0.97, 0.9), GLOW);
            Strip(models.shell, models.shellFaces, from, to, quarter, float2(far + 13, high + 10.3), float2(far, high + 8.2),
                  float2(-0.2, 1), float2(-0.2, 1), Color(0.3, 0.33, 0.37), MATTE);
        }
        // Where a ramp stops at a goal, its end is a flat face beside the post
        var post = rim[rim.count - 2];
        var corner = Around(post, 0, 0, quarter);
        for (var step = 0; step < 8; step++)
        {
            var a = step * Math.PI / 16;
            var b = (step + 1) * Math.PI / 16;
            Wedge(models.shell, models.shellFaces, corner, Around(post, RAMP - RAMP * Math.Sin(a), RAMP - RAMP * Math.Cos(a), quarter),
                  Around(post, RAMP - RAMP * Math.Sin(b), RAMP - RAMP * Math.Cos(b), quarter), float3(-quarter.x, 0, 0), boards, BOARDS);
        }
    }
    MakeGoal(models, -1);
    MakeGoal(models, 1);

    // A screen over each end stand, floodlights at the corners, and the
    // ground outside as far as the eye goes
    var reach = STAND_START + SEAT_ROWS * SEAT_RUN;
    var crest = STAND_START + SEAT_ROWS * SEAT_RISE;
    for (var end = -1; end <= 1; end += 2)
    {
        var z = end * (BACK_WALL + reach - 1.2);
        Box(models.shell, models.shellFaces, float3(0, crest + 3.6, z), float3(34, 6.6, 0.8), steel);
        Quad(models.shell, models.shellFaces, float3(-16.2, crest + 0.9, z - end * 0.42), float3(16.2, crest + 0.9, z - end * 0.42),
             float3(16.2, crest + 6.3, z - end * 0.42), float3(-16.2, crest + 6.3, z - end * 0.42), float3(0, 0, -end), TeamColor(end < 0 ? 0 : 1), SCREEN);
        for (var side = -1; side <= 1; side += 2)
        {
            var foot = float3(side * (SIDE_WALL + reach * 0.62), 0, end * (BACK_WALL + reach * 0.62));
            Tube(models.shell, models.shellFaces, foot, foot + float3(0, crest + 22, 0), 0.75, 10, steel);
            var head = foot + float3(-side * 1.2, crest + 23, -end * 1.2);
            Box(models.shell, models.shellFaces, head, float3(7.5, 5, 7.5), steel);
            for (var lamp = 0; lamp < 9; lamp++)
            {
                var across = float3(side, 0, -end) * ((lamp % 3 - 1) * 1.9);
                Box(models.shell, models.shellFaces, head + across + float3(-side * 2.7, (lamp / 3 - 1) * 1.5, -end * 2.7),
                    float3(1.5, 1.2, 1.5), Color(1, 0.98, 0.92), GLOW);
            }
        }
    }
    Quad(models.shell, models.shellFaces, float3(-600, -0.4, -600), float3(600, -0.4, -600), float3(600, -0.4, 600), float3(-600, -0.4, 600),
         float3(0, 1, 0), Color(0.13, 0.19, 0.12));
}

void MakeModels(mut Models models)
{
    models.made = true;
    MakeCar(models);
    MakeShapes(models);
    MakeStadium(models);
}
