// The cars nobody has. A bot reads the same match every machine has and
// answers with the same controls a player sends, so it's part of the match.
// It keeps nothing between ticks: what it's doing is read off its own car.
const int PATH_STEPS = 120;
const float PATH_STEP = 1.0 / 40.0;

// The ball's next three seconds, if nothing touches it.
struct BallPath
{
    float3[PATH_STEPS] position;
    float3[PATH_STEPS] velocity;
    int goal = -1;      // The side whose goal it ends up in
    float goalIn;
}

void PredictBall(mut BallPath path, BallState from)
{
    mut var ball = from;
    path.goal = -1;
    for (var step = 0; step < PATH_STEPS; step++)
    {
        MoveBall(ball, PATH_STEP);
        path.position[step] = ball.position;
        path.velocity[step] = ball.velocity;
        if (path.goal >= 0) continue;
        var goal = GoalAt(ball.position, BALL_RADIUS);
        if (goal == 0) continue;
        path.goal = goal < 0 ? 0 : 1;
        path.goalIn = (step + 1) * PATH_STEP;
    }
}

float3 Flat(float3 value) { return float3(value.x, 0, value.z); }

// Seconds to cover a distance from this speed, speeding up to a top speed.
float TravelTime(float distance, float speed, float top, float gain)
{
    if (distance <= 0) return 0;
    var from = Math.Clamp(speed, 0, top);
    var spell = (top - from) / gain;
    var covered = from * spell + 0.5 * gain * spell * spell;
    if (covered >= distance) return (Math.Sqrt(from * from + 2 * gain * distance) - from) / gain;
    return spell + (distance - covered) / top;
}

// Seconds for a held jump to lift the car's middle to a height.
float RiseTime(float height)
{
    if (height <= 0.89) return Math.Max(0, (height - REST_HEIGHT) / 3.6);
    var left = Math.Min(height - 0.89, 1.45);
    return 0.2 + (4.4 - Math.Sqrt(19.36 - 13 * left)) / 6.5;
}

// How soon a car could be at the ball: turning, then driving.
float Eagerness(MatchState state, int seat)
{
    var car = state.cars[seat];
    if (car.wrecked > 0) return 1000;
    var way = TeamWay(TeamOf(seat));
    var toBall = Flat(state.ball.position - car.position);
    mut var cost = Math.Length(toBall) / 18;
    cost += (1 - Math.Dot(Math.Normalize(toBall), CarForward(car))) * 0.45;
    // Past the ball, it has to come back round it
    if (toBall.z * way < 0) cost += 1.1;
    return cost + seat * 0.001;
}

// The controls that take a car to a place on the pitch at a speed.
DriveInput DriveTo(CarState car, float3 target, float speed, bool boost)
{
    var local = Math.Rotate(Math.Conjugate(car.rotation), target - car.position);
    var angle = Math.Atan2(local.x, local.z);
    var pace = Math.Dot(car.velocity, CarForward(car));
    mut var input = DriveInput { steer = Math.Clamp(angle * 3.5, -1, 1) };
    // A place just behind is quicker backed into than turned for
    if (Math.Abs(angle) > 2.4 && Math.LengthSq(local) < 49 && pace < 6)
    {
        input.steer = Math.Clamp((angle > 0 ? Math.PI - angle : -Math.PI - angle) * 3.5, -1, 1);
        input.throttle = -1;
        return input;
    }
    // A tight turn at speed runs wide: slow for it, and slide round
    var wanted = Math.Abs(angle) > 0.9 ? Math.Min(speed, 9) : speed;
    input.throttle = pace < wanted - 0.2 ? 1 : pace > wanted + 2 ? -1 : 0;
    input.handbrake = Math.Abs(angle) > 1.5 && pace > 6;
    input.boost = boost && Math.Abs(angle) < 0.25 && pace < wanted - 1.5 && pace > 2;
    return input;
}

// In the air with nothing to hit: wheels down, nose along the flight.
DriveInput Land(CarState car)
{
    var back = Math.Conjugate(car.rotation);
    var sky = Math.Rotate(back, float3(0, 1, 0));
    var turning = Math.Rotate(back, car.spin);
    var flight = Math.Rotate(back, Flat(car.velocity));
    mut var input = DriveInput { throttle = 1 };
    input.roll = Math.Clamp(sky.x * 3 + turning.z * 0.5, -1, 1);
    input.pitch = Math.Clamp(sky.z * 3 + turning.x * 0.5, -1, 1);
    if (Math.LengthSq(flight) > 4) input.yaw = Math.Clamp(Math.Atan2(flight.x, flight.z) * 2 - turning.y * 0.4, -1, 1);
    return input;
}

// The nearest boost that's ready, big pads first, on a car's way to a place.
float3 BoostNear(MatchState state, CarState car, float3 place, bool bigOnly)
{
    mut var best = place;
    mut var least = bigOnly ? 60.0 : 9.0;
    for (var pad = 0; pad < PADS; pad++)
    {
        if (state.pads[pad] > 0.4 || bigOnly && !PadBig(pad)) continue;
        var at = PadPosition(pad);
        var detour = Math.Distance(car.position, at) + Math.Distance(at, place) - Math.Distance(car.position, place);
        var cost = PadBig(pad) ? detour * 0.5 : detour;
        if (cost >= least) continue;
        least = cost;
        best = at;
    }
    return best;
}

DriveInput BotDrive(MatchState state, BallPath path, int seat)
{
    var car = state.cars[seat];
    if (car.wrecked > 0 || !state.ball.live) return DriveInput { };
    var team = TeamOf(seat);
    var way = TeamWay(team);
    var forward = CarForward(car);
    var pace = Math.Dot(car.velocity, forward);
    // No two bots are alike, and none is the same from one kickoff to the
    // next: each has a moment's hesitation of its own, and a corner of the
    // goal it fancies for a couple of seconds at a time
    var nerve = Math.Hash(int3(state.kickoffs, seat, Random.seed));
    var fancy = (Math.Hash(int4(state.kickoffs, seat, int(state.played * 0.5), Random.seed)) % 1000) * 0.001 - 0.5;
    if (state.waiting && state.since < (nerve % 16) * 0.008) return DriveInput { };

    // On its roof, a jump rolls it over
    if (car.touching && car.wheels == 0 && CarUp(car).y < -0.7)
        return DriveInput { jump = state.ticks % 12 < 6 };

    // Who goes for the ball: the car that can be there soonest. The others
    // of its side hold back for the pass, and to be there when it comes back.
    var mine = Eagerness(state, seat);
    mut var rank = 0;
    for (var other = team; other < state.size * 2; other += 2)
        if (other != seat && Eagerness(state, other) < mine) rank += 1;
    var danger = state.threat == team || state.ball.position.z * way < -32 && path.velocity[0].z * way < 2;
    var going = rank == 0 || danger && rank == 1 && state.size > 1;

    if (!going)
    {
        // Behind the ball on its own side of it, wide of whoever is on it
        var depth = rank == 1 && state.size > 2 ? 20.0 : 34.0;
        mut var spot = float3(state.ball.position.x * (rank == 1 ? -0.35 : 0.25), 0, state.ball.position.z - way * depth);
        if (rank >= 2 || spot.z * way < -44) spot = float3(Math.Clamp(state.ball.position.x * 0.3, -6, 6), 0, -way * 45);
        spot.z = Math.Clamp(spot.z, -46, 46);
        spot.x = Math.Clamp(spot.x, -34, 34);
        if (car.boost < 40) spot = BoostNear(state, car, spot, true);
        if (!car.grounded && car.wheels == 0) return Land(car);
        var far = Math.Length(Flat(spot - car.position));
        if (far < 4)
        {
            // There: turn to face the play, and wait
            mut var waiting = DriveTo(car, state.ball.position, 0, false);
            waiting.throttle = Math.Abs(pace) > 1 ? (pace > 0 ? -1 : 1) : 0;
            return waiting;
        }
        return DriveTo(car, spot, Math.Clamp(far * 0.9, 6, 23), far > 30 && car.boost > 30);
    }

    // The first moment it can meet the ball, where the ball is low enough
    // for a car on its wheels or for a jump
    var useBoost = car.boost > 5;
    var top = useBoost ? 22.0 : 14.0;
    mut var step = PATH_STEPS - 1;
    for (var ahead = 0; ahead < PATH_STEPS; ahead += 2)
    {
        var where = path.position[ahead];
        if (where.y > 3.1) continue;
        var apart = Flat(where - car.position);
        var bearing = Math.Dot(Math.Normalize(apart), forward);
        var needed = TravelTime(Math.Length(apart) - 1.7, pace, top, useBoost ? 14 : 7) + (1 - bearing) * 0.45;
        if (needed > (ahead + 1) * PATH_STEP) continue;
        step = ahead;
        break;
    }
    var ball = path.position[step];
    var time = (step + 1) * PATH_STEP;
    var kickoff = state.waiting;

    // Where to send it: at the other goal, or out of its own end
    var goal = float3(fancy * 11, 0, way * (BACK_WALL + 2));
    mut var aim = Math.Normalize(Flat(goal - ball));
    if (ball.z * way < -28)
        aim = Math.Normalize(aim + Math.Normalize(float3(ball.x, 0, ball.z + way * BACK_WALL)) * 1.6);

    var toBall = Flat(ball - car.position);
    var distance = Math.Length(toBall);
    var line = toBall / Math.Max(distance, 0.01);
    // Chasing a ball back towards its own goal, a hit from behind only
    // helps it in: it goes for the side of the ball, and knocks it wide
    if (toBall.z * way < 0 && ball.z * way < 10)
        aim = Math.Normalize(float3(toBall.x >= 0 ? 1 : -1, 0, way * 0.25));
    var off = 1 - Math.Dot(line, aim);
    // Not lined up, it drives for a place behind the ball, nearer as it closes
    var lined = off < 0.12 || distance < 5 && off < 0.7 || danger && off < 1 || kickoff;
    var behind = lined ? 1.2 : Math.Min(distance * 0.6, 3 + off * 8);
    mut var target = ball - aim * behind;
    target.x = Math.Clamp(target.x, -SIDE_WALL + 1.5, SIDE_WALL - 1.5);
    target.z = Math.Clamp(target.z, -BACK_WALL + 1.5, BACK_WALL - 1.5);
    var local = Math.Rotate(Math.Conjugate(car.rotation), target - car.position);
    var angle = Math.Atan2(local.x, local.z);
    var reach = Math.Max(distance - 1.7, 0);
    var high = ball.y > 1.35;

    if (!car.grounded && car.wheels == 0)
    {
        // Jumped for it: a dodge into a low ball, a second jump for a high
        // one, and the dodge as it arrives
        var near = Math.Distance(state.ball.position, car.position);
        if (!car.jumped || car.flipped || car.doubleJumped || near > 9) return Land(car);
        mut var air = Land(car);
        var turn = Math.Atan2(Math.Rotate(Math.Conjugate(car.rotation), state.ball.position - car.position).x, 1.5);
        if (!high)
        {
            air.jump = car.jumpTime < 0.075 || car.jumpTime > 0.1;
            if (car.jumpTime > 0.1)
            {
                air.pitch = -1;
                air.yaw = Math.Clamp(turn * 1.5, -1, 1);
                air.roll = 0;
            }
            return air;
        }
        air.jump = car.jumpTime < 0.2;
        if (near < 2.6 && car.jumpTime > 0.22)
        {
            air.jump = true;
            air.pitch = -1;
            air.yaw = Math.Clamp(turn * 1.5, -1, 1);
            air.roll = 0;
        }
        return air;
    }

    // Arrive as the ball does: early is as bad as late for one in the air
    mut var speed = lined ? Math.Clamp(reach / Math.Max(time - 0.03, 0.05), 5, 23) : Math.Clamp(8 + distance * 0.5, 9, 20);
    if (lined && ball.y < 1.3 && Math.Length(path.velocity[step]) < 12) speed = 23;
    if (kickoff) speed = 23;
    mut var input = DriveTo(car, target, speed, useBoost && (lined || distance > 25));
    if (kickoff) input.boost = car.boost > 0 && Math.Abs(angle) < 0.4;
    // A small pad on the way costs nothing
    if (!lined && car.boost < 70 && distance > 12)
    {
        var pad = BoostNear(state, car, target, false);
        if (Math.DistanceSq(pad, target) > 0.01) input = DriveTo(car, pad, speed, false);
    }
    if (!lined || Math.Abs(angle) > 0.2 || pace < 5) return input;
    var contact = reach / Math.Max(pace, 1);
    if (!high)
    {
        // The dodge that makes a hit a shot
        input.jump = contact > 0.12 && contact < 0.26 && time < 0.4;
        return input;
    }
    input.jump = contact < RiseTime(ball.y - 0.55) + 0.03 && time < RiseTime(ball.y - 0.55) + 0.08;
    return input;
}
