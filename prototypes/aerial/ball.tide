// The ball: a sphere that bounces off the arena, spins as it scrapes along
// it, and takes a car's hit along the line from the car's middle to its own.
const float BALL_RADIUS = 0.9125;
const float BALL_MAX_SPEED = 60;
const float BALL_MAX_SPIN = 6;
const float BALL_BOUNCE = 0.6;
const float BALL_GRIP = 0.285;
// A solid sphere's spin from a push at its surface: 1 / (0.4 * radius)
const float BALL_SPIN_PER_PUSH = 2.5 / BALL_RADIUS;

struct BallState
{
    [Position] float3 position = float3(0, BALL_RADIUS, 0);
    [Rotation] quaternion rotation = quaternion.identity;
    float3 velocity;
    float3 spin;
    bool live = true;       // Gone between a goal and the next kickoff
    bool floored;           // On the pitch this tick
    float struck;           // How hard it hit the arena this tick, in m/s
}

// A tick of flight, then the arena. The same step runs ahead of the match,
// in bigger steps, to tell bots and the scoreboard where the ball is going.
void MoveBall(mut BallState ball, float dt)
{
    ball.velocity.y -= GRAVITY * dt;
    ball.velocity *= 1 - 0.0305 * dt;
    var speed = Math.Length(ball.velocity);
    if (speed > BALL_MAX_SPEED) ball.velocity *= BALL_MAX_SPEED / speed;
    var turning = Math.Length(ball.spin);
    if (turning > BALL_MAX_SPIN) ball.spin *= BALL_MAX_SPIN / turning;
    ball.position += ball.velocity * dt;
    ball.floored = false;
    ball.struck = 0;
    var surface = Arena(ball.position);
    if (surface.distance >= BALL_RADIUS) return;
    ball.position += surface.normal * (BALL_RADIUS - surface.distance);
    ball.floored = surface.normal.y > 0.9 && ball.position.y < BALL_RADIUS + 0.05;
    var closing = Math.Dot(ball.velocity, surface.normal);
    if (closing >= 0) return;
    // The part of its speed along the surface, with what its spin adds where
    // the two touch, is what the surface's grip works against.
    var into = surface.normal * closing;
    var slip = ball.velocity - into + Math.Cross(surface.normal, ball.spin) * BALL_RADIUS;
    var slipping = Math.Length(slip);
    mut var grip = float3(0);
    if (slipping > 0.0001) grip = slip * -(Math.Min(1, -2 * closing / slipping) * BALL_GRIP);
    // A ball that's only settling doesn't bounce
    ball.velocity += into * -(closing < -0.3 ? 1 + BALL_BOUNCE : 1.0) + grip;
    ball.spin += Math.Cross(grip, surface.normal) * BALL_SPIN_PER_PUSH;
    ball.struck = -closing;
}

void TurnBall(mut BallState ball, float dt)
{
    var turning = Math.Length(ball.spin);
    if (turning > 0.00001)
        ball.rotation = Math.Normalize(Math.Mul(quaternion.AxisAngle(ball.spin / turning, turning * dt), ball.rotation));
}

// A car's box against the ball: the two stop closing where they touch, and
// the ball rolls with the bodywork. Gives whether they touch.
bool CarMeetsBall(mut CarState car, mut BallState ball)
{
    if (car.wrecked > 0 || !ball.live) return false;
    var between = ball.position - car.position;
    if (Math.LengthSq(between) > 2.4 * 2.4) return false;
    var local = Math.Rotate(Math.Conjugate(car.rotation), between) - BOX_CENTRE;
    var nearest = Math.Clamp(local, -BOX_HALF, BOX_HALF);
    var gap = local - nearest;
    var distance = Math.Length(gap);
    if (distance >= BALL_RADIUS) return false;
    var normal = distance > 0.0001 ? Math.Rotate(car.rotation, gap / distance) : Math.Normalize(between);
    var offset = Math.Rotate(car.rotation, nearest + BOX_CENTRE);
    var surface = ball.velocity + Math.Cross(ball.spin, normal * -BALL_RADIUS) - VelocityAt(car, offset);
    var closing = Math.Dot(surface, normal);
    var ratio = CAR_MASS / BALL_MASS;
    ball.position += normal * (BALL_RADIUS - distance);
    if (closing >= 0) return true;
    var stop = -closing / (ratio + 1 / Heft(car, offset, normal));
    ball.velocity += normal * (stop * ratio);
    Push(car, normal * -stop, offset);
    var slide = surface - normal * closing;
    var sliding = Math.Length(slide);
    if (sliding < 0.001) return true;
    var along = slide / sliding;
    var grip = Math.Min(2 * stop, sliding / (ratio * 3.5 + 1 / Heft(car, offset, along)));
    var change = along * (-grip * ratio);
    ball.velocity += change;
    ball.spin += Math.Cross(change, normal) * BALL_SPIN_PER_PUSH;
    Push(car, along * grip, offset);
    return true;
}

// The sport's own punch on a fresh hit: away from the car's middle,
// flattened, a little along its nose, by how fast the two met. `before` is
// the ball's velocity as the tick found it, so two cars arriving together
// each get the hit they'd have had alone. Gives the speed they met at.
float PunchBall(mut CarState car, mut BallState ball, float3 before, float3 carBefore, int tick)
{
    // A ball carried on the roof is touched every tick, and punched once
    var fresh = tick > car.struck + 1 || car.struck > tick;
    car.struck = tick;
    var speed = Math.Min(Math.Length(before - carBefore), 46);
    if (!fresh || speed <= 0) return 0.01;
    var forward = CarForward(car);
    mut var way = Math.Normalize((ball.position - car.position) * float3(1, 0.35, 1));
    way = Math.Normalize(way - forward * (Math.Dot(way, forward) * 0.35));
    var scale = speed < 5 ? 0.65 : speed < 23 ? Along(speed, 5, 0.65, 23, 0.55) : Along(speed, 23, 0.55, 46, 0.3);
    ball.velocity += way * (speed * scale);
    return speed;
}
