// The car: one rigid body on four sprung wheels, with a box around it for
// everything the wheels don't reach. Lengths are metres and the numbers are
// the sport's familiar ones (a hundredth of their usual units): an Octane-like
// box, 23 m/s flat out, 6.5 m/s2 of gravity, a 1.25 second window for the
// second jump.
const int CARS = 6;
const float GRAVITY = 6.5;
const float CAR_MAX_SPEED = 23;
const float CAR_MAX_SPIN = 5.5;
const float SUPERSONIC_SPEED = 22;
const float BOOST_START = 100.0 / 3.0;
const float BOOST_PER_SECOND = 100.0 / 3.0;
const float BOOST_MIN_TIME = 0.1;
const float REST_HEIGHT = 0.1701;

// The hitbox, about a centre a little ahead of and above the body's own.
const float3 BOX_CENTRE = float3(0, 0.2075, 0.1388);
const float3 BOX_HALF = float3(0.421, 0.1808, 0.59005);
// Turning a torque into spin: one over the box's moment about each of the
// car's own axes (right, up, forward), per unit of mass.
const float3 SPIN_PER_TORQUE = float3(1 / 0.126945, 1 / 0.175128, 1 / 0.069981);
const float CAR_MASS = 180;
const float BALL_MASS = 30;

const float SUSPENSION_TRAVEL = 0.12;
const float SUSPENSION_STIFFNESS = 500;
const float SUSPENSION_COMPRESS = 25;
const float SUSPENSION_RELAX = 40;

struct DriveInput
{
    float throttle;
    float steer;
    float pitch;    // Up from -1, the nose down, to 1, the nose up
    float yaw;      // To the right above 0
    float roll;     // To the right above 0
    bool jump;
    bool boost;
    bool handbrake;
}

struct CarState
{
    [Position] float3 position;
    [Rotation] quaternion rotation = quaternion.identity;
    float3 velocity;
    float3 spin;                // Angular velocity, about the world's axes
    float boost = BOOST_START;
    float[4] travel;            // How far each spring is pressed in, for the wheels drawn
    float steer;                // The front wheels' angle
    int wheels;                 // On a surface this tick
    bool grounded;              // Three wheels or more
    bool touching;              // The bodywork was on the arena last tick
    float3 touched;             // ...and that surface's normal
    bool jumpHeld;
    bool jumping;
    bool jumped;
    bool doubleJumped;
    bool flipped;
    bool flipping;
    float jumpTime;
    float airTime;              // Since the first jump's push ended
    float flipTime;
    float2 flip;                // A dodge's direction: x forward, y to the right
    bool boosting;
    float boostTime;
    float handbrake;
    bool supersonic;
    float supersonicTime;
    float righting;             // Seconds left of turning back onto its wheels
    float rightingWay;
    float wrecked;              // Seconds until a demolished car is back
    float bumped;               // Seconds until this car can bump another again
    int struck = -1000;         // The tick the ball last took this car's punch
    int goals;
    int assists;
    int saves;
    int shots;
    int wrecks;
    int points;
}

struct WheelContact
{
    bool touching;
    float3 point;
    float3 normal;
    float pressed;
}

float3 WheelMount(int wheel)
{
    // Front right, front left, rear right, rear left
    float side = wheel % 2 == 0 ? 1 : -1;
    return wheel < 2 ? float3(side * 0.259, 0.20755, 0.5125) : float3(side * 0.295, 0.20755, -0.3375);
}

float WheelRadius(int wheel) { return wheel < 2 ? 0.125 : 0.15; }
float WheelReach(int wheel) { return wheel < 2 ? 0.26755 : 0.25055; }
float WheelSpring(int wheel) { return wheel < 2 ? 35.75 / CAR_MASS : 54.265 / CAR_MASS; }

float Along(float value, float fromX, float fromY, float toX, float toY)
{
    return fromY + (toY - fromY) * Math.Saturate((value - fromX) / (toX - fromX));
}

// How far the front wheels turn at full lock, by speed: tight when slow.
float SteerAngle(float speed)
{
    if (speed < 5) return Along(speed, 0, 0.53356, 5, 0.3193);
    if (speed < 10) return Along(speed, 5, 0.3193, 10, 0.18203);
    if (speed < 15) return Along(speed, 10, 0.18203, 15, 0.1057);
    if (speed < 17.5) return Along(speed, 15, 0.1057, 17.5, 0.08507);
    return Along(speed, 17.5, 0.08507, 30, 0.03454);
}

// The engine fades towards 14.1 m/s, which is as fast as wheels alone go.
float DriveScale(float speed)
{
    if (speed < 14) return Along(speed, 0, 1, 14, 0.1);
    return Along(speed, 14, 0.1, 14.1, 0);
}

float3 CarRight(CarState car) { return Math.Rotate(car.rotation, float3(1, 0, 0)); }
float3 CarUp(CarState car) { return Math.Rotate(car.rotation, float3(0, 1, 0)); }
float3 CarForward(CarState car) { return Math.Rotate(car.rotation, float3(0, 0, 1)); }

// The spin a torque gives, both about the world's axes, per unit of mass.
float3 SpinFrom(quaternion rotation, float3 torque)
{
    return Math.Rotate(rotation, Math.Rotate(Math.Conjugate(rotation), torque) * SPIN_PER_TORQUE);
}

float3 VelocityAt(CarState car, float3 offset)
{
    return car.velocity + Math.Cross(car.spin, offset);
}

// A push at a point of the body: `change` is the push over the car's mass.
void Push(mut CarState car, float3 change, float3 offset)
{
    car.velocity += change;
    car.spin += SpinFrom(car.rotation, Math.Cross(offset, change));
}

// How much of the car's mass a push along `way` at `offset` has to move.
float Heft(CarState car, float3 offset, float3 way)
{
    var turned = Math.Cross(SpinFrom(car.rotation, Math.Cross(offset, way)), offset);
    return 1 / (1 + Math.Dot(turned, way));
}

// A wheel's ray down its spring, stepped along the arena's distance.
WheelContact TraceWheel(CarState car, int wheel, float3 up)
{
    var start = car.position + Math.Rotate(car.rotation, WheelMount(wheel));
    var reach = WheelReach(wheel) + WheelRadius(wheel);
    mut var surface = Arena(start);
    mut var along = 0.0;
    for (var step = 0; step < 3; step++)
    {
        along = Math.Max(0, along + surface.distance / Math.Max(0.3, Math.Dot(surface.normal, up)));
        if (along > reach + 0.3) return WheelContact { };
        if (step < 2) surface = Arena(start - up * along);
    }
    if (along > reach) return WheelContact { };
    return WheelContact { touching = true, point = start - up * along, normal = surface.normal,
                          pressed = Math.Min(reach - along, SUSPENSION_TRAVEL) };
}

// A car as it starts, at rest on its wheels, with what it had on the scoresheet.
CarState Fresh(CarState sheet, float3 position, float3 facing)
{
    mut var car = CarState { position = position, rotation = quaternion.LookRotation(facing, float3(0, 1, 0)) };
    car.goals = sheet.goals; car.assists = sheet.assists; car.saves = sheet.saves;
    car.shots = sheet.shots; car.wrecks = sheet.wrecks; car.points = sheet.points;
    return car;
}

// Back from a demolition, in front of its own goal.
CarState Respawned(CarState sheet, int seat, int slot)
{
    float way = seat % 2 == 0 ? 1 : -1;
    float across = slot % 4 < 2 ? 23.04 : 26.88;
    return Fresh(sheet, float3((slot % 2 == 0 ? -across : across) * way, REST_HEIGHT, -46.08 * way), float3(0, 0, way));
}

// One tick of everything the driver and the wheels do to the car's velocity
// and spin. Where it ends up, and what it hits, comes after.
void DriveCar(mut CarState car, DriveInput input, int seat, float dt)
{
    if (car.wrecked > 0)
    {
        car.boosting = false;
        car.wrecked -= dt;
        if (car.wrecked <= 0) car = Respawned(car, seat, seat / 2);
        return;
    }
    var jumpPressed = input.jump && !car.jumpHeld;
    car.jumpHeld = input.jump;
    car.bumped = Math.Max(0, car.bumped - dt);
    var right = CarRight(car);
    var up = CarUp(car);
    var forward = CarForward(car);

    mut WheelContact[4] wheels = [WheelContact { }, WheelContact { }, WheelContact { }, WheelContact { }];
    mut var count = 0;
    mut var ground = float3(0);
    for (var wheel = 0; wheel < 4; wheel++)
    {
        wheels[wheel] = TraceWheel(car, wheel, up);
        car.travel[wheel] = wheels[wheel].touching ? wheels[wheel].pressed : 0;
        if (!wheels[wheel].touching) continue;
        count += 1;
        ground += wheels[wheel].normal;
    }
    ground = Math.Normalize(ground);
    car.wheels = count;
    car.grounded = count >= 3;

    car.handbrake = Math.Saturate(car.handbrake + (input.handbrake ? 5 : -2) * dt);
    var forwardSpeed = Math.Dot(car.velocity, forward);
    var pace = Math.Abs(forwardSpeed);
    var boostWanted = car.boost > 0 && (input.boost || car.boosting && car.boostTime < BOOST_MIN_TIME);
    float drive = boostWanted ? 1 : input.throttle;
    mut var engine = drive;
    mut var brake = 0.0;
    if (!input.handbrake)
    {
        if (Math.Abs(drive) >= 0.001)
        {
            // Throttle against the way it rolls is the brake
            if (pace > 0.25 && drive * forwardSpeed < 0)
            {
                brake = 1;
                engine = 0;
            }
        }
        else
        {
            engine = 0;
            brake = pace < 0.25 ? 1 : 0.15;
        }
    }
    var steerLock = Math.Lerp(SteerAngle(pace), Along(pace, 0, 0.39235, 25, 0.1261), car.handbrake);
    car.steer = steerLock * input.steer;

    // Jumping: a kick, then a push for as long as the button is held, up to 0.2 seconds
    if (car.grounded && !car.jumping && !(car.jumped && car.jumpTime < 0.05)) car.jumped = false;
    if (car.jumping)
        car.jumping = car.jumpTime < 0.025 || input.jump && car.jumpTime < 0.2;
    else if (car.grounded && jumpPressed)
    {
        car.jumping = true;
        car.jumpTime = 0;
        car.velocity += up * 2.91667;
    }
    if (car.jumping)
    {
        car.jumped = true;
        car.velocity += up * (14.58333 * (car.jumpTime < 0.025 ? 0.62 : 1) * dt);
    }
    if (car.jumping || car.jumped) car.jumpTime += dt;

    if (car.grounded)
    {
        car.doubleJumped = false;
        car.flipped = false;
        car.flipping = false;
        car.airTime = 0;
        car.flipTime = 0;
    }
    else
    {
        if (car.jumped && !car.jumping) car.airTime += dt;
        else car.airTime = 0;
        // On its roof, a jump is the one that rolls it back over, below
        var overturned = car.touching && car.touched.y > SQRT_HALF && up.y < -0.94;
        if (jumpPressed && car.airTime < 1.25 && !car.doubleJumped && !car.flipped && !overturned && car.righting <= 0)
        {
            if (Math.Abs(input.yaw) + Math.Abs(input.pitch) + Math.Abs(input.roll) >= 0.5)
            {
                // A dodge: a shove along the stick, and a flip about it
                car.flipping = true;
                car.flipped = true;
                car.flipTime = 0;
                mut var way = Math.Normalize(float2(-input.pitch, input.yaw + input.roll));
                if (Math.Abs(way.x) < 0.1) way.x = 0;
                if (Math.Abs(way.y) < 0.1) way.y = 0;
                car.flip = way;
                var ratio = pace / CAR_MAX_SPEED;
                var backwards = pace < 1 ? way.x < 0 : (way.x >= 0) != (forwardSpeed >= 0);
                mut var shove = way * 5;
                shove.x *= 1 + ((backwards ? 2.5 : 1.0) - 1) * ratio;
                shove.y *= 1 + 0.9 * ratio;
                if (backwards) shove.x *= 16.0 / 15.0;
                var flat = Math.Normalize(float3(forward.x, 0, forward.z));
                car.velocity += flat * shove.x + float3(flat.z, 0, -flat.x) * shove.y;
            }
            else
            {
                car.doubleJumped = true;
                car.velocity += up * 2.91667;
            }
        }
        if (car.flipping)
        {
            car.flipTime += dt;
            if (car.flipTime <= 0.65)
            {
                // A dodge holds its height: falling is damped while it turns
                if (car.flipTime >= 0.15 && (car.velocity.y < 0 || car.flipTime < 0.21))
                    car.velocity.y *= Math.Pow(0.65, dt * 120);
            }
            else car.flipping = false;
        }
        else if (car.flipped) car.flipTime += dt;

        mut var steering = count == 0 && car.righting <= 0;
        if (car.flipping && Math.LengthSq(car.flip) > 0)
        {
            // Pulling against a flip's pitch cancels it
            mut var pitchPart = car.flip.x;
            steering = false;
            if (pitchPart != 0 && input.pitch != 0 && pitchPart * input.pitch > 0)
            {
                pitchPart *= 1 - Math.Min(Math.Abs(input.pitch), 1);
                steering = count == 0 && car.righting <= 0;
            }
            car.spin += (right * (pitchPart * 224) - forward * (car.flip.y * 260)) * dt;
        }
        if (steering)
        {
            float pitchScale = car.flipping || car.flipped && car.flipTime < 0.95 ? 0 : 1;
            var turn = right * (-input.pitch * pitchScale * 12.46) + up * (input.yaw * 9.11) - forward * (input.roll * 38.34);
            var damp = right * (Math.Dot(right, car.spin) * 2.876 * (1 - Math.Abs(input.pitch * pitchScale)))
                     + up * (Math.Dot(up, car.spin) * 1.917 * (1 - Math.Abs(input.yaw)))
                     + forward * (Math.Dot(forward, car.spin) * 4.793);
            car.spin += (turn - damp) * dt;
        }
        // In the air the engine is a nudge, and half of that backwards
        if (count == 0) car.velocity += forward * (input.throttle * (input.throttle < 0 ? 0.33333 : 0.66667) * dt);

        // On its roof: a jump hops it off the ground and rolls it back over
        var surface = count > 0 ? ground : car.touched;
        if (jumpPressed && overturned)
        {
            car.righting = 0.4 * Math.Acos(Math.Clamp(up.y, -1, 1)) / Math.PI;
            car.rightingWay = right.y > 0 ? 1 : -1;
            car.velocity -= up * 2;
        }
        if (car.righting > 0)
        {
            car.spin += forward * (50 * car.rightingWay * dt);
            car.righting -= dt;
        }
        else if (count > 0 || car.touching)
        {
            // Half on the ground: lean towards the wheels
            car.spin += Math.Cross(up, surface) * (8 * dt);
            car.velocity -= surface * (1.0 * dt);
        }
    }

    if (count > 0)
    {
        // Tyres hold on: harder with the throttle down, on a wall most of all
        var hold = 0.5 + (drive != 0 || pace > 0.25 ? 1 - Math.Abs(ground.y) : 0);
        car.velocity -= ground * (hold * GRAVITY * dt);
    }

    // Springs first, then what the tyres do with the grip they have
    for (var wheel = 0; wheel < 4; wheel++)
    {
        if (!wheels[wheel].touching) continue;
        var offset = wheels[wheel].point - car.position;
        var facing = Math.Dot(wheels[wheel].normal, up);
        var gain = facing > 0.1 ? 1 / facing : 10.0;
        var closing = facing > 0.1 ? Math.Dot(wheels[wheel].normal, VelocityAt(car, offset)) * gain : 0.0;
        var spring = (SUSPENSION_STIFFNESS * wheels[wheel].pressed * gain
                   - (closing < 0 ? SUSPENSION_COMPRESS : SUSPENSION_RELAX) * closing) * WheelSpring(wheel);
        if (spring > 0) Push(car, wheels[wheel].normal * (spring * dt), offset);
    }
    var driveScale = DriveScale(pace) * (count < 3 ? 0.25 : 1);
    for (var wheel = 0; wheel < 4; wheel++)
    {
        if (!wheels[wheel].touching) continue;
        var normal = wheels[wheel].normal;
        var offset = wheels[wheel].point - car.position;
        mut var axle = right;
        if (wheel < 2) axle = right * Math.Cos(car.steer) - forward * Math.Sin(car.steer);
        axle = Math.Normalize(axle - normal * Math.Dot(axle, normal));
        var rolling = Math.Cross(axle, normal);
        var slipping = VelocityAt(car, offset);
        var sideways = Math.Dot(slipping, axle);
        var lengthways = Math.Dot(slipping, rolling);
        var slide = Math.Abs(sideways) > 0.05 ? Math.Abs(sideways) / (Math.Abs(lengthways) + Math.Abs(sideways)) : 0.0;
        mut var sideGrip = 1 - 0.8 * slide;
        mut var rollGrip = 1.0;
        if (car.handbrake > 0)
        {
            sideGrip *= Math.Lerp(1, 0.1, car.handbrake);
            rollGrip = Math.Lerp(1, 0.5 + 0.4 * slide, car.handbrake);
        }
        if (drive == 0)
        {
            // Coasting, tyres let go of a slope
            var loose = normal.y < 0.7075 ? Along(normal.y, 0, 0.1, 0.7075, 0.5) : Along(normal.y, 0.7075, 0.5, 1, 1);
            sideGrip *= loose;
            rollGrip *= loose;
        }
        mut var roll = engine * 4 * driveScale * dt;
        if (engine == 0 && brake > 0)
        {
            var most = brake * 8.75 * dt;
            roll = Math.Clamp(-lengthways * Heft(car, offset, rolling) * 60 / count * dt, -most, most);
        }
        var side = -sideways * Heft(car, offset, axle) * 12 * dt;
        // Grip pushes level with the body's centre: a car doesn't lean in a bend
        Push(car, rolling * (roll * rollGrip) + axle * (side * sideGrip), offset - up * Math.Dot(up, offset));
    }

    if (boostWanted)
    {
        car.boosting = true;
        car.boostTime += dt;
        car.boost = Math.Max(0, car.boost - BOOST_PER_SECOND * dt);
        var thrust = car.grounded ? (forwardSpeed > 6 ? 9.91667 * 0.928 : 9.91667) : 10.58333;
        car.velocity += forward * (thrust * dt);
    }
    else
    {
        car.boosting = false;
        car.boostTime = 0;
    }
    car.velocity.y -= GRAVITY * dt;
}

void LimitCar(mut CarState car, float dt)
{
    var speed = Math.Length(car.velocity);
    if (speed > CAR_MAX_SPEED) car.velocity *= CAR_MAX_SPEED / speed;
    var turning = Math.Length(car.spin);
    if (turning > CAR_MAX_SPIN) car.spin *= CAR_MAX_SPIN / turning;
    if (speed >= SUPERSONIC_SPEED)
    {
        car.supersonic = true;
        car.supersonicTime = 0;
    }
    else if (car.supersonic)
    {
        car.supersonicTime += dt;
        if (speed < SUPERSONIC_SPEED - 1 || car.supersonicTime > 1) car.supersonic = false;
    }
}

void MoveCar(mut CarState car, float dt)
{
    car.position += car.velocity * dt;
    var turning = Math.Length(car.spin);
    if (turning > 0.00001)
        car.rotation = Math.Normalize(Math.Mul(quaternion.AxisAngle(car.spin / turning, turning * dt), car.rotation));
}

// One of the box's corners and the middles of its edges, in the car's own axes.
float3 BoxPoint(int index)
{
    if (index < 8)
        return BOX_CENTRE + BOX_HALF * float3(index % 2 == 0 ? -1 : 1, index / 2 % 2 == 0 ? -1 : 1, index < 4 ? -1 : 1);
    var edge = index - 8;
    float a = edge % 2 == 0 ? -1 : 1;
    float b = edge / 2 % 2 == 0 ? -1 : 1;
    if (edge < 4) return BOX_CENTRE + BOX_HALF * float3(0, a, b);
    if (edge < 8) return BOX_CENTRE + BOX_HALF * float3(a, 0, b);
    return BOX_CENTRE + BOX_HALF * float3(a, b, 0);
}

// The bodywork against the arena: each corner that's gone into a surface is
// stopped there, with a little bounce and a scrape along it.
void CarOnArena(mut CarState car)
{
    car.touching = false;
    if (car.wrecked > 0) return;
    // Nothing of the box reaches a surface from the middle of the pitch
    if (Arena(car.position + Math.Rotate(car.rotation, BOX_CENTRE)).distance > 0.75) return;
    mut var deepest = 0.0;
    mut var out = float3(0);
    mut var normals = float3(0);
    var up = CarUp(car);
    for (var index = 0; index < 20; index++)
    {
        var offset = Math.Rotate(car.rotation, BoxPoint(index));
        var surface = Arena(car.position + offset);
        if (surface.distance >= 0) continue;
        car.touching = true;
        normals += surface.normal;
        if (-surface.distance > deepest)
        {
            deepest = -surface.distance;
            out = surface.normal;
        }
        var arriving = VelocityAt(car, offset);
        var closing = Math.Dot(arriving, surface.normal);
        if (closing >= 0) continue;
        // Under the wheels the box is the springs' bump stop: it takes the
        // load a hard landing or a ramp at speed puts on it, and rolls on
        var belly = car.wheels >= 2 && Math.Dot(surface.normal, up) > 0.7;
        var stop = -closing * (closing < -1.5 && !belly ? 1.3 : 1.0) * Heft(car, offset, surface.normal);
        Push(car, surface.normal * stop, offset);
        if (belly) continue;
        var scrape = arriving - surface.normal * closing;
        var scraping = Math.Length(scrape);
        if (scraping < 0.001) continue;
        var along = scrape / scraping;
        Push(car, along * -Math.Min(0.3 * stop, scraping * Heft(car, offset, along)), offset);
    }
    if (!car.touching) return;
    car.touched = Math.Normalize(normals);
    car.position += out * deepest;
}

// Where a point is in another car's box: how deep, and the way out.
Contact InBox(float3 local)
{
    var from = local - BOX_CENTRE;
    var depth = BOX_HALF - Math.Abs(from);
    if (depth.x <= 0 || depth.y <= 0 || depth.z <= 0) return Contact { distance = 1 };
    if (depth.x < depth.y && depth.x < depth.z) return Contact { distance = -depth.x, normal = float3(from.x < 0 ? -1 : 1, 0, 0) };
    if (depth.y < depth.z) return Contact { distance = -depth.y, normal = float3(0, from.y < 0 ? -1 : 1, 0) };
    return Contact { distance = -depth.z, normal = float3(0, 0, from.z < 0 ? -1 : 1) };
}

// The corners of `a` that are inside `b`, pushed back out. Gives how many were.
int BoxIntoBox(mut CarState a, mut CarState b)
{
    mut var hits = 0;
    var toB = Math.Conjugate(b.rotation);
    for (var index = 0; index < 20; index++)
    {
        var offset = Math.Rotate(a.rotation, BoxPoint(index));
        var point = a.position + offset;
        var inside = InBox(Math.Rotate(toB, point - b.position));
        if (inside.distance >= 0) continue;
        hits += 1;
        var normal = Math.Rotate(b.rotation, inside.normal);
        var other = point - b.position;
        var closing = Math.Dot(VelocityAt(a, offset) - VelocityAt(b, other), normal);
        a.position += normal * (-inside.distance * 0.25);
        b.position -= normal * (-inside.distance * 0.25);
        if (closing >= 0) continue;
        var stop = -closing * 1.1 / (1 / Heft(a, offset, normal) + 1 / Heft(b, other, normal));
        Push(a, normal * stop, offset);
        Push(b, normal * -stop, other);
    }
    return hits;
}

// Two cars meeting. The one that arrives nose first, faster than the other is
// leaving, shoves it; at supersonic speed that's a demolition. Gives who was
// wrecked: a bit for `a` and a bit for `b`, as two can wreck each other.
int CarsMeet(mut CarState a, mut CarState b, bool rivals)
{
    if (a.wrecked > 0 || b.wrecked > 0) return 0;
    if (Math.DistanceSq(a.position, b.position) > 2.6 * 2.6) return 0;
    var before = a.velocity;
    var beforeOther = b.velocity;
    if (BoxIntoBox(a, b) + BoxIntoBox(b, a) == 0) return 0;
    mut var wreck = 0;
    for (var turn = 0; turn < 2; turn++)
    {
        var from = turn == 0 ? a : b;
        var into = turn == 0 ? b : a;
        var arriving = turn == 0 ? before : beforeOther;
        var leaving = turn == 0 ? beforeOther : before;
        var between = into.position - from.position;
        if (from.bumped > 0 || Math.Dot(arriving, between) <= 0) continue;
        var way = Math.Normalize(arriving);
        var toward = Math.Dot(arriving, Math.Normalize(between));
        if (toward <= Math.Dot(leaving, way)) continue;
        // Only the front bumper counts
        if (Math.Dot(Math.Rotate(Math.Conjugate(from.rotation), between), float3(0, 0, 1)) < 0.645) continue;
        if (from.supersonic && rivals)
        {
            wreck |= turn == 0 ? 2 : 1;
            continue;
        }
        var shove = toward < 14 ? Along(toward, 0, 0.00833, 14, into.grounded ? 11 : 13.9)
                                : Along(toward, 14, into.grounded ? 11 : 13.9, 22, into.grounded ? 15.3 : 19.45);
        var lift = toward < 14 ? Along(toward, 0, 0.00333, 14, 2.78) : Along(toward, 14, 2.78, 22, 4.17);
        var change = way * shove + (into.grounded ? CarUp(into) : float3(0, 1, 0)) * lift;
        if (turn == 0)
        {
            b.velocity += change;
            a.bumped = 0.25;
        }
        else
        {
            a.velocity += change;
            b.bumped = 0.25;
        }
    }
    return wreck;
}
