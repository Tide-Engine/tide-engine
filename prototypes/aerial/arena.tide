// The pitch as one closed shape. Metres, y up, x across, z from the blue goal
// (-z) to the orange one (+z). Everything that touches the arena asks one
// function how far a point is from its nearest surface and which way that
// surface faces, so the ball, the wheels and the bodywork agree on its shape.
const float SIDE_WALL = 40.96;
const float BACK_WALL = 51.2;
const float CEILING = 20.48;
const float CORNER_CUT = 80.64;     // |x| + |z| along the diagonal walls
const float CORNER_ROUND = 4;       // Where a diagonal wall meets a straight one
const float RAMP = 2.56;            // Floor into wall
const float CEILING_RAMP = 2.56;    // Wall into ceiling
const float GOAL_HALF = 8.9275;
const float GOAL_HEIGHT = 6.42775;
const float GOAL_DEPTH = 8.8;
const float SQRT_HALF = 0.70710678;

struct Contact
{
    float distance;                     // Above 0 in the open
    float3 normal = float3(0, 1, 0);    // Into the open
}

Contact Nearer(Contact a, Contact b)
{
    return a.distance < b.distance ? a : b;
}

// Two walls joined by a quarter pipe of this radius. Their normals needn't be
// square to each other: the diagonal walls meet the straight ones at 45 degrees.
Contact Fillet(Contact a, Contact b, float radius)
{
    var u = radius - a.distance;
    var w = radius - b.distance;
    var g = Math.Dot(a.normal, b.normal);
    var alpha = u - g * w;
    var beta = w - g * u;
    if (alpha > 0 && beta > 0)
    {
        var toCentre = (a.normal * alpha + b.normal * beta) / (1 - g * g);
        var length = Math.Length(toCentre);
        if (length > 0.00001) return Contact { distance = radius - length, normal = toCentre / length };
    }
    return Nearer(a, b);
}

// The arena with its end walls whole, for a point folded into x >= 0, z >= 0.
Contact Shell(float3 folded)
{
    var side = Contact { distance = SIDE_WALL - folded.x, normal = float3(-1, 0, 0) };
    var diagonal = Contact { distance = (CORNER_CUT - folded.x - folded.z) * SQRT_HALF,
                             normal = float3(-SQRT_HALF, 0, -SQRT_HALF) };
    var back = Contact { distance = BACK_WALL - folded.z, normal = float3(0, 0, -1) };
    var wall = Nearer(Fillet(side, diagonal, CORNER_ROUND), Fillet(diagonal, back, CORNER_ROUND));
    var floor = Contact { distance = folded.y, normal = float3(0, 1, 0) };
    var roof = Contact { distance = CEILING - folded.y, normal = float3(0, -1, 0) };
    return Nearer(Fillet(wall, floor, RAMP), Fillet(wall, roof, CEILING_RAMP));
}

// The nearest surface of the arena, goals included.
Contact Arena(float3 point)
{
    var folded = float3(Math.Abs(point.x), point.y, Math.Abs(point.z));
    var open = Shell(folded);
    var besidePost = folded.x - GOAL_HALF;      // Under 0 between the posts
    var overBar = folded.y - GOAL_HEIGHT;       // Under 0 below the crossbar
    var behind = folded.z - BACK_WALL;          // Above 0 past the goal line
    mut var result = open;
    if (besidePost < 0 && overBar < 0)
    {
        // Between the posts: the end wall is open here. What's solid is the
        // wall beside the mouth (its ramp too, which ends in a flat face at
        // the post), the wall above it, the net and the floor.
        var beside = Math.Max(open.distance, 0);
        var post = Math.Sqrt(besidePost * besidePost + beside * beside);
        var above = Math.Max(-behind, 0);
        var bar = Math.Sqrt(overBar * overBar + above * above);
        result = Contact { distance = folded.y, normal = float3(0, 1, 0) };
        result = Nearer(result, Contact { distance = BACK_WALL + GOAL_DEPTH - folded.z, normal = float3(0, 0, -1) });
        if (post < result.distance)
            result = Contact { distance = post, normal = (float3(besidePost, 0, 0) + open.normal * beside) / Math.Max(post, 0.00001) };
        if (bar < result.distance)
            result = Contact { distance = bar, normal = float3(0, overBar, -above) / Math.Max(bar, 0.00001) };
    }
    else if (behind > 0)
    {
        // Inside the wall around a goal: out by the nearer way, back onto the
        // pitch or into the goal.
        var acrossX = Math.Max(besidePost, 0);
        var acrossY = Math.Max(overBar, 0);
        var across = Math.Sqrt(acrossX * acrossX + acrossY * acrossY);
        if (across < behind)
            result = Contact { distance = -across, normal = across > 0.00001 ? float3(-acrossX, -acrossY, 0) / across : float3(0, 0, -1) };
    }
    if (point.x < 0) result.normal.x = -result.normal.x;
    if (point.z < 0) result.normal.z = -result.normal.z;
    return result;
}

// Whether a ball centred here is wholly past a goal line: 0 for none, -1 for
// the blue goal and 1 for the orange one.
int GoalAt(float3 centre, float radius)
{
    if (Math.Abs(centre.z) < BACK_WALL + radius) return 0;
    if (Math.Abs(centre.x) > GOAL_HALF || centre.y > GOAL_HEIGHT) return 0;
    return centre.z < 0 ? -1 : 1;
}
