// How this machine draws the match: the light, the frags, the camera and
// the frame's passes. None of it is the match's, and none of it is sent.
using Rooms;

enum Layers { Prepare, Shadow, Scene, Present, Hud }

// A particle as the GPU draws it: a card that faces the eye, or one drawn
// out along `axis`.
struct Spark
{
    float3 position;
    float3 axis;
    float size;
    Color tint;
}

// ...and as this machine keeps it between frames
struct Mote
{
    float3 position;
    float3 velocity;
    float3 axis;        // A streak that stays where it was left
    Color tint;
    float size;
    float age;
    float life = 0.4;
    float stretch;      // Drawn out along its flight by this many seconds of it
    float drag;
    float lift;
    float grow;
    bool smoke;         // Laid over what's behind it, where the rest are light added to it
}

local singleton Look
{
    bool made;
    RenderTarget scene;
    RenderTarget bright;
    RenderTarget blurred;
    Texture glow;
    float2 pixel;
    float clock;
    float dt;
    // The camera
    float3 eye;
    float3 right = float3(1, 0, 0);
    float3 up = float3(0, 1, 0);
    float3 heading = float3(0, 0, 1);
    bool placed;
    bool ballCam = true;
    bool rear;              // Looking back, while its key is held
    float2 swivel;          // The right stick's look around
    float shake;
    float fov = 78;
    int seat;               // The car this machine's player has
    bool playing;           // ...or nobody's, behind the title
    float cheer;            // How loud the crowd is, from 0 to 1
    float flash;            // A goal's light over the frame
    Color flashTone;
    float[CARS] wheelTurn;
    List<Piece> cars;
    List<Piece> wheels;
    List<Piece> blots;
    List<Piece> pads;
    List<Piece> orbs;
    List<Piece> rings;
    List<Spark> sparks;
    List<Spark> puffs;
    List<Mote> motes;
    Piece ball;
    Random random;
}

local singleton Sun
{
    bool made;
    RenderTarget map;
    DepthTexture depth;
    float4x4 toLight;
}

float3 SunWay() { return Math.Normalize(float3(-0.45, 0.8, 0.4)); }

// How much of the sun reaches a place: four looks into its shadow map.
float Sunlit(DepthTexture depth, float4x4 toLight, float3 world, float3 normal)
{
    var seen = Math.Mul(toLight, float4(world + normal * 0.07, 1));
    if (Math.Max(Math.Abs(seen.x), Math.Abs(seen.y)) > 0.98) return 1;
    var uv = float2(seen.x * 0.5 + 0.5, 0.5 - seen.y * 0.5);
    var far = seen.z * 0.5 + 0.5 - 0.0012;
    float soft = 0.0005;
    return (depth.Compare(uv + float2(-soft, -soft), far) + depth.Compare(uv + float2(soft, -soft), far)
          + depth.Compare(uv + float2(-soft, soft), far) + depth.Compare(uv + float2(soft, soft), far)) * 0.25;
}

// Daylight on a surface: the sun, the sky from above, a highlight, and the
// haze a big stadium has at its far end.
Color Lit(Color paint, float3 normal, float3 world, float3 eye, float gloss, float glow, float sun)
{
    var toSun = SunWay();
    var view = Math.Normalize(eye - world);
    var direct = Math.Max(0, Math.Dot(normal, toSun)) * sun;
    var sky = 0.55 + 0.45 * normal.y;
    var shine = Math.Pow(Math.Max(0, Math.Dot(normal, Math.Normalize(toSun + view))), 70) * gloss * sun;
    mut var rgb = float3(paint.r, paint.g, paint.b) * (float3(0.4, 0.47, 0.58) * sky + float3(1, 0.95, 0.85) * (direct * 0.8) + float3(glow))
                + float3(1, 0.97, 0.9) * shine;
    var haze = Math.Saturate((Math.Distance(world, eye) - 70) / 300);
    rgb = Math.Lerp(rgb, float3(0.66, 0.79, 0.92), haze * haze * 0.85);
    return Color(rgb.x, rgb.y, rgb.z, paint.a);
}

// How near a point of a honeycomb is to the wall of its cell: 0 in the
// middle of a cell and 1 on the wall.
float Honeycomb(float2 at)
{
    mut var p = at;
    p.x += Math.Frac(Math.Floor(p.y) * 0.5);
    var cell = float2(Math.Frac(p.x) - 0.5, Math.Frac(p.y) - 0.5);
    return Math.Max(Math.Abs(cell.x), Math.Abs(cell.x) * 0.5 + Math.Abs(cell.y) * 0.866) * 2;
}

float Stroke(float distance)
{
    return 1 - Math.SmoothStep(0.07, 0.13, Math.Abs(distance));
}

frag SkyPaint(Solid vertex, out Color color, Look look)
{
    var way = Math.Normalize(vertex.position);
    mut var rgb = Math.Lerp(float3(0.72, 0.85, 0.97), float3(0.17, 0.43, 0.88), Math.Pow(Math.Saturate(way.y), 0.55));
    // Clouds on a flat ceiling far above, drifting
    var over = way.xz / (Math.Max(way.y, 0) + 0.22) * 1.3 + float2(look.clock * 0.006, 0);
    var cloud = Math.Perlin(over) * 0.55 + Math.Perlin(over * 2.3) * 0.3 + Math.Perlin(over * 5.1) * 0.15;
    rgb = Math.Lerp(rgb, float3(1, 1, 1), Math.SmoothStep(0.02, 0.5, cloud) * Math.Saturate(way.y * 5) * 0.9);
    var sun = Math.Max(0, Math.Dot(way, SunWay()));
    rgb += float3(1, 0.93, 0.76) * (Math.Pow(sun, 800) * 2.5 + Math.Pow(sun, 10) * 0.22);
    if (way.y < 0) rgb = Math.Lerp(float3(0.72, 0.85, 0.97), float3(0.2, 0.28, 0.22), Math.Saturate(-way.y * 8));
    color = Color(rgb.x, rgb.y, rgb.z, 1);
}

frag GrassPaint(Solid vertex, out Color color, Look look, Sun sun)
{
    var at = this.world.xz;
    var across = Math.Abs(at.x);
    var along = Math.Abs(at.y);
    var inGoal = across < GOAL_HALF && along < BACK_WALL + GOAL_DEPTH;
    if (!inGoal && (along > BACK_WALL || across + along > CORNER_CUT)) this.Discard();
    // Mown in squares, with the grain of the blades over them
    var square = Math.Floor((at.x + 204.8) / 6.4) + Math.Floor((at.y + 204.8) / 6.4);
    var mown = Math.Frac(square * 0.5) < 0.25 ? 1.0 : 0.84;
    var blade = Math.Perlin(at * 11) * 0.06 + Math.Perlin(at * 0.9) * 0.05;
    mut var paint = float3(0.12, 0.44, 0.1) * (mown + blade);
    // The lines: halfway, the centre circle and spot, and two boxes at each end
    mut var line = Math.Max(Stroke(at.y), Stroke(Math.Length(at) - 9.6));
    line = Math.Max(line, 1 - Math.SmoothStep(0.3, 0.38, Math.Length(at)));
    if (along < BACK_WALL)
    {
        line = Math.Max(line, Stroke(Math.Max(across - 13.2, BACK_WALL - 7.2 - along)));
        line = Math.Max(line, Stroke(Math.Max(across - 24, BACK_WALL - 18 - along)));
        if (across < GOAL_HALF) line = Math.Max(line, Stroke(along - BACK_WALL + 0.12));
    }
    paint = Math.Lerp(paint, float3(0.93, 0.96, 0.93), line * 0.92);
    // In a goal, the floor is its side's color
    if (along > BACK_WALL)
    {
        var tone = at.y < 0 ? float3(0.08, 0.25, 0.75) : float3(0.8, 0.33, 0.05);
        paint = Math.Lerp(paint, tone, 0.45);
    }
    var lit = Sunlit(sun.depth, sun.toLight, this.world, float3(0, 1, 0));
    color = Lit(Color(paint.x, paint.y, paint.z), float3(0, 1, 0), this.world, look.eye, 0.06, 0, lit);
}

frag ShellPaint(Solid vertex, out Color color, Look look, Sun sun)
{
    var normal = Math.Normalize(vertex.normal);
    var kind = vertex.material;
    var run = this.world.z * normal.x - this.world.x * normal.z;   // Along the wall
    mut var paint = vertex.color;
    mut var glow = 0.0;
    mut var gloss = 0.12;
    if (kind > 0.5 && kind < 1.5) glow = 1.6;
    if (kind > 5.5 && kind < 6.5)
    {
        // The crowd: a seat a cell, somebody in most of them, on their feet
        // when the ground is loud
        var seat = float2(run * 1.7, (this.world.y - STAND_START) / SEAT_RISE);
        var who = Math.Hash(int2(int(Math.Floor(seat.x)), int(Math.Floor(seat.y))));
        var bounce = (Math.Sin(look.clock * (5.0 + who % 7) + who % 31) * 0.5 + 0.5) * look.cheer * (who % 3 == 0 ? 0.3 : 0.14);
        var here = float2(Math.Frac(seat.x) - 0.5, Math.Frac(seat.y) - bounce);
        var shade = float(who % 100) * 0.01;
        var home = this.world.z < 0 ? float3(0.1, 0.36, 0.92) : float3(0.96, 0.45, 0.08);
        var shirt = who % 5 < 3 ? home * (0.7 + shade * 0.6) : float3(0.9, 0.9, 0.94) * (0.45 + shade * 0.6);
        mut var seen = float3(0.2, 0.24, 0.33);
        if (who % 9 != 0)
        {
            if (Math.Abs(here.x) < 0.3 && here.y < 0.56) seen = shirt;
            if (Math.LengthSq(float2(here.x, (here.y - 0.72) * 0.85)) < 0.03) seen = float3(0.86, 0.68, 0.54) * (0.55 + shade * 0.5);
        }
        paint = Color(seen.x, seen.y, seen.z);
        glow = 0.42;
    }
    if (kind > 6.5 && kind < 7.5)
    {
        // The ramps: dark panels in a honeycomb, lit along their joints
        var joint = Math.SmoothStep(0.86, 0.96, Honeycomb(float2(run, this.world.y * 1.25) * 0.5));
        paint = Color(paint.r * (1 + joint * 1.3), paint.g * (1 + joint * 1.3), paint.b * (1 + joint * 1.3));
        glow = joint * 0.2;
        gloss = 0.5;
    }
    if (kind > 7.5 && kind < 8.5)
    {
        // The big screens: bands of light sweeping across
        var band = Math.Sin(this.world.x * 0.7 + this.world.y * 0.9 - look.clock * 1.6) * 0.5 + 0.5;
        var dots = Math.Frac(this.world.y * 4) < 0.7 && Math.Frac(this.world.x * 4) < 0.7 ? 1.0 : 0.45;
        paint = Color(paint.r * (0.45 + band * 0.75) * dots, paint.g * (0.45 + band * 0.75) * dots, paint.b * (0.45 + band * 0.75) * dots);
        glow = 0.9;
    }
    var lit = this.world.y < 3 ? Sunlit(sun.depth, sun.toLight, this.world, normal) : 1.0;
    color = Lit(paint, normal, this.world, look.eye, gloss, glow, lit);
}

frag GlassPaint(Solid vertex, out Color color, Look look)
{
    var normal = vertex.normal;
    var run = this.world.z * normal.x - this.world.x * normal.z;
    var over = Math.Abs(normal.y) > 0.7;
    var net = vertex.material > 0.5;
    var cell = Honeycomb((over ? this.world.xz : float2(run, this.world.y * 1.15)) * (net ? 0.9 : 0.3));
    var wire = Math.SmoothStep(net ? 0.86 : 0.9, 0.96, cell);
    var far = Math.Saturate((Math.Distance(this.world, look.eye) - 10) / 90);
    var solid = (wire * (net ? 0.6 : over ? 0.1 : 0.2) + (net ? 0.06 : 0.02)) * (1 - far * (net ? 0.3 : 0.7));
    color = Color(vertex.color.r, vertex.color.g, vertex.color.b, solid);
}

frag CarPaint(Solid vertex, out Color color, Piece piece, Instance instance, Look look, Sun sun)
{
    var normal = instance.Normal(vertex.normal);
    var view = Math.Normalize(look.eye - this.world);
    var glance = 1 - Math.Max(0, Math.Dot(normal, view));
    var kind = vertex.material;
    mut var paint = vertex.color;
    mut var gloss = 0.3;
    mut var glow = 0.0;
    if (kind > 0.5 && kind < 1.5) glow = 1.8;
    if (kind > 1.5 && kind < 2.5)
    {
        // Paint under a clear coat: the sky shows in it where it turns away
        paint = Math.Lerp(piece.tint, Color(0.78, 0.88, 1), Math.Pow(glance, 3) * 0.5);
        gloss = 1.5;
    }
    if (kind > 2.5 && kind < 3.5)
    {
        paint = Math.Lerp(Color(0.03, 0.05, 0.08), Color(0.62, 0.8, 0.97), Math.Pow(glance, 2.4) * 0.75 + Math.Max(0, normal.y) * 0.22);
        gloss = 2.2;
    }
    if (kind > 3.5 && kind < 4.5)
    {
        // The rim: five spokes in the car's color
        var turn = Math.Atan2(vertex.position.z, vertex.position.y) / Math.TAU;
        var spoke = Math.Abs(Math.Frac(turn * 5) - 0.5);
        var radius = Math.Length(vertex.position.yz);
        paint = spoke > 0.27 || radius < 0.2 || radius > 0.55 ? Math.Lerp(piece.tint, Color.white, 0.35) : Color(0.015, 0.017, 0.02);
        gloss = 1.3;
    }
    if (kind > 4.5 && kind < 5.5)
    {
        var groove = Math.Frac(Math.Atan2(vertex.position.z, vertex.position.y) * 6.4);
        paint = groove < 0.16 ? Color(0.008, 0.009, 0.012) : Color(0.035, 0.037, 0.043);
        gloss = 0.1;
    }
    var lit = Sunlit(sun.depth, sun.toLight, this.world, normal);
    color = Lit(paint, normal, this.world, look.eye, gloss, glow + piece.glow, lit);
}

frag BallPaint(Solid vertex, out Color color, Piece piece, Instance instance, Look look, Sun sun)
{
    // Thirty-two panels, as a football has: twelve of five sides and twenty
    // of six, each the patch of the ball nearest its own middle
    var at = Math.Normalize(vertex.position);
    float golden = 1.618034;
    mut var best = -2.0;
    mut var next = -2.0;
    mut var five = false;
    for (var i = 0; i < 32; i++)
    {
        var a = i % 4 < 2 ? -1.0 : 1.0;
        var b = i % 2 == 0 ? -1.0 : 1.0;
        mut var middle = float3(0);
        if (i < 12) middle = (i < 4 ? float3(0, a, b * golden) : i < 8 ? float3(a, b * golden, 0) : float3(b * golden, 0, a)) / 1.902113;
        else if (i < 20) middle = float3(a, b, i < 16 ? -1 : 1) / 1.732051;
        else middle = (i < 24 ? float3(0, a / golden, b * golden) : i < 28 ? float3(a / golden, b * golden, 0) : float3(b * golden, 0, a / golden)) / 1.732051;
        var near = Math.Dot(at, middle) + (i < 12 ? -0.012 : 0.0);
        if (near > best)
        {
            next = best;
            best = near;
            five = i < 12;
        }
        else if (near > next) next = near;
    }
    var seam = Math.SmoothStep(0.004, 0.016, best - next);
    var panel = five ? float3(0.22, 0.25, 0.3) : float3(0.86, 0.88, 0.9);
    var tone = panel * (0.25 + seam * 0.75);
    var normal = instance.Normal(vertex.normal);
    var lit = Sunlit(sun.depth, sun.toLight, this.world, normal);
    color = Lit(Color(tone.x, tone.y, tone.z), normal, this.world, look.eye, 0.7, (1 - seam) * piece.glow, lit);
}

// A soft dark patch on the grass under whatever is over it.
frag BlotPaint(Solid vertex, out Color color, Piece piece)
{
    var edge = Math.Saturate(1 - Math.Length(vertex.position.xz));
    color = Color(0, 0.01, 0.02, edge * edge * piece.tint.a);
}

// The ring on the grass under the ball, which says where it comes down.
frag RingPaint(Solid vertex, out Color color, Piece piece)
{
    var radius = Math.Length(vertex.position.xz);
    var ring = Math.SmoothStep(0.72, 0.8, radius) * (1 - Math.SmoothStep(0.9, 0.98, radius));
    color = Color(piece.tint.r, piece.tint.g, piece.tint.b, ring * piece.tint.a);
}

frag PadPaint(Solid vertex, out Color color, Piece piece)
{
    var radius = Math.Length(vertex.position.xz);
    if (radius > 1) this.Discard();
    var rim = Math.SmoothStep(0.7, 0.8, radius) * (1 - Math.SmoothStep(0.9, 1, radius));
    var core = Math.Saturate(1 - radius * 1.6);
    var petal = Math.Frac(Math.Atan2(vertex.position.z, vertex.position.x) * 6 / Math.TAU) < 0.8 ? 1.0 : 0.3;
    color = Color(piece.tint.r, piece.tint.g, piece.tint.b, (rim * 0.85 * petal + core * 0.75 * piece.glow) * piece.tint.a);
}

frag OrbPaint(Solid vertex, out Color color, Piece piece, Instance instance, Look look)
{
    var normal = instance.Normal(vertex.normal);
    var glance = 1 - Math.Max(0, Math.Dot(normal, Math.Normalize(look.eye - this.world)));
    color = Color(piece.tint.r + glance * 0.5, piece.tint.g + glance * 0.4, piece.tint.b + glance * 0.2, piece.tint.a);
}

vert SparkPlace(mut Corner corner, Spark spark, Look look)
{
    mut var side = look.right;
    mut var lift = look.up * spark.size;
    if (Math.LengthSq(spark.axis) > 0.000001)
    {
        lift = spark.axis;
        side = Math.Normalize(Math.Cross(spark.axis, look.eye - spark.position));
    }
    corner.position = spark.position + side * (corner.uv.x * spark.size) + lift * corner.uv.y;
}

frag SparkPaint(Corner corner, out Color color, Spark spark)
{
    var soft = Math.Saturate(1 - corner.uv.x * corner.uv.x) * Math.Saturate(1 - corner.uv.y * corner.uv.y);
    color = Color(spark.tint.r, spark.tint.g, spark.tint.b, spark.tint.a * soft * soft);
}

frag BrightPaint(Vertex vertex, Texture source, out Color color)
{
    var seen = source.Sample(vertex.uv);
    var most = Math.Max(seen.r, Math.Max(seen.g, seen.b));
    var kept = Math.Saturate((most - 0.8) * 4);
    color = Color(seen.r * kept, seen.g * kept, seen.b * kept, 1);
}

struct BlurStep { float2 along; }

frag BlurPaint(Vertex vertex, Texture source, out Color color, BlurStep blur)
{
    var sum = source.Sample(vertex.uv) * 0.227
            + (source.Sample(vertex.uv + blur.along * 1.385) + source.Sample(vertex.uv - blur.along * 1.385)) * 0.316
            + (source.Sample(vertex.uv + blur.along * 3.23) + source.Sample(vertex.uv - blur.along * 3.23)) * 0.07;
    color = Color(sum.r, sum.g, sum.b, 1);
}

frag PresentPaint(Vertex vertex, Texture source, out Color color, Look look)
{
    var seen = source.Sample(vertex.uv);
    var glow = look.glow.Sample(vertex.uv);
    mut var rgb = float3(seen.r, seen.g, seen.b) + float3(glow.r, glow.g, glow.b) * 0.55;
    // A touch more contrast and color, and darker corners
    rgb = rgb * rgb * (3 - 2 * rgb) * 0.35 + rgb * 0.65;
    var gray = Math.Dot(rgb, float3(0.3, 0.59, 0.11));
    rgb = Math.Lerp(float3(gray), rgb, 1.12);
    var from = vertex.uv * 2 - float2(1);
    rgb *= 1 - Math.Dot(from, from) * 0.1;
    rgb += float3(look.flashTone.r, look.flashTone.g, look.flashTone.b) * (look.flash * 0.35);
    color = Color(rgb.x, rgb.y, rgb.z, 1);
}

void Burst(mut Look look, float3 at, Color tone, int count, float force, float life, float size)
{
    for (var i = 0; i < count && look.motes.count < 1800; i++)
    {
        var way = look.random.NextFloat3Direction();
        look.motes.Add(Mote { position = at, velocity = way * look.random.NextFloat(force * 0.25, force), tint = tone,
                              size = size * look.random.NextFloat(0.6, 1.3), life = life * look.random.NextFloat(0.6, 1.2),
                              drag = 1.6, lift = -5, stretch = 0.035 });
    }
}

void Smoke(mut Look look, float3 at, Color tone, int count, float force, float life, float size)
{
    for (var i = 0; i < count && look.motes.count < 1800; i++)
    {
        var way = look.random.NextFloat3Direction();
        look.motes.Add(Mote { position = at + way * (size * 0.5), velocity = way * look.random.NextFloat(force * 0.2, force), tint = tone,
                              size = size * look.random.NextFloat(0.7, 1.3), life = life * look.random.NextFloat(0.7, 1.2),
                              drag = 2.2, lift = 1.2, grow = 1.6, smoke = true });
    }
}

// Every particle a frame older, and the two lists the GPU draws them from.
void StepMotes(mut Look look)
{
    look.sparks.Clear();
    look.puffs.Clear();
    mut var index = 0;
    while (index < look.motes.count)
    {
        mut var mote = look.motes[index];
        mote.age += look.dt;
        if (mote.age >= mote.life)
        {
            look.motes[index] = look.motes[look.motes.count - 1];
            look.motes.RemoveAt(look.motes.count - 1);
            continue;
        }
        mote.velocity *= Math.Max(0, 1 - mote.drag * look.dt);
        mote.velocity.y += mote.lift * look.dt;
        mote.position += mote.velocity * look.dt;
        look.motes[index] = mote;
        index++;
        var left = 1 - mote.age / mote.life;
        var size = mote.size * (1 + mote.grow * (1 - left));
        mut var axis = mote.axis;
        if (mote.stretch > 0) axis = mote.velocity * mote.stretch + Math.Normalize(mote.velocity) * size;
        if (mote.smoke)
            look.puffs.Add(Spark { position = mote.position, axis = axis, size = size,
                tint = Color(mote.tint.r, mote.tint.g, mote.tint.b, mote.tint.a * left * Math.Min(1, (1 - left) * 8)) });
        else
            look.sparks.Add(Spark { position = mote.position, axis = axis, size = size * (0.4 + 0.6 * left),
                tint = Color(mote.tint.r, mote.tint.g, mote.tint.b, mote.tint.a * left) });
    }
}

// Where the camera is and which way it looks: behind the car, on the line
// from the ball through it with the ball camera on, and along the car's
// nose with it off.
quaternion AimCamera(mut Look look, CarState car, BallState ball)
{
    var speed = Math.Length(car.velocity);
    var focus = car.position + float3(0, 1.0, 0);
    mut var want = look.heading;
    if (look.ballCam && ball.live)
    {
        var toBall = ball.position - focus;
        if (Math.LengthSq(toBall) > 1) want = Math.Normalize(toBall);
        // From the grass the camera can only look so far up before the car
        // leaves the picture; from the air it can drop under the car
        want.y = Math.Clamp(want.y, -0.5, Math.Clamp((focus.y - 0.4) / 2.9, 0.4, 0.82));
    }
    else if (car.wheels >= 3) want = CarForward(car);
    else if (Math.LengthSq(Flat(car.velocity)) > 9) want = Math.Normalize(float3(car.velocity.x, car.velocity.y * 0.35, car.velocity.z));
    want = Math.Normalize(want);
    if (!look.placed) look.heading = want;
    look.placed = true;
    // Straight behind is no direction to turn through: go round by the side
    if (Math.Dot(look.heading, want) < -0.98) want = Math.Normalize(want + Math.Cross(float3(0, 1, 0), want) * 0.3);
    look.heading = Math.Normalize(Math.Lerp(look.heading, want, 1 - Math.Exp(-look.dt * (look.ballCam ? 10 : 6))));
    // Looking back is the car's own nose turned round, and the right stick
    // swivels whichever view it is
    mut var view = look.heading;
    if (look.rear) view = Math.Normalize(-Flat(CarForward(car)) + float3(0, 0.001, 0));
    if (Math.LengthSq(look.swivel) > 0)
    {
        view = Math.Rotate(quaternion.AxisAngle(float3(0, 1, 0), look.swivel.x * 2.6), view);
        view = Math.Rotate(quaternion.AxisAngle(Math.Normalize(Math.Cross(float3(0, 1, 0), view)), -look.swivel.y * 0.9), view);
    }
    // Up is the sky's, but for a car driving straight up a wall
    var steep = view.y * view.y;
    var over = Math.Normalize(float3(0, 1, 0) * (1 - steep) + CarUp(car) * steep + float3(0, 0.001, 0));
    mut var eye = focus - view * (2.7 + speed / CAR_MAX_SPEED * 0.4);
    eye.y = Math.Max(eye.y, 0.3);
    // The walls are glass, and the camera goes out through them behind a
    // car that's driving up one. The pitch, the kerb round it and the roof
    // hold it in.
    var room = Arena(eye);
    if (room.distance < 0.4 && (eye.y < 3.4 || room.normal.y < -0.5)) eye += room.normal * (0.4 - room.distance);
    look.eye = eye;
    return quaternion.LookRotation(Math.Normalize(view - over * 0.05), over);
}

[Stage(Layers.Prepare)]
view Prepare(mut Models models, mut Look look, MatchState match, Session session, Devices devices, Lobby lobby, Hand hand,
             query (Participant participant, Owner owner) players)
{
    if (!models.made) MakeModels(models);
    if (!look.made)
    {
        look.made = true;
        look.scene = RenderTarget.Window(samples: 4);
        look.bright = RenderTarget.Window(0.25);
        look.blurred = RenderTarget.Window(0.25);
        look.glow = look.bright.color;
    }
    var screen = float2(Math.Max(Screen.width, 1), Math.Max(Screen.height, 1));
    look.pixel = float2(1 / screen.x, 1 / screen.y);
    look.dt = Math.Min(Frame.dt, 0.05);
    look.clock += look.dt;
    look.shake = Math.Max(0, look.shake - look.dt * 2.2);
    look.flash = Math.Max(0, look.flash - look.dt * 1.4);
    look.playing = lobby.page != Page.Title;
    look.seat = 0;
    foreach (var player in players)
        if (player.owner.player == session.player) look.seat = player.participant.seat;
    // The cameras' keys, by the layout: Space and the middle button in
    // Classic, the middle button and Ctrl in Modern
    var classic = hand.layout == KeyLayout.Classic;
    if (lobby.playing && (devices.gamepad.buttonNorth.down || (classic ? devices.keyboard.space.down : devices.mouse.middle.down)))
        look.ballCam = !look.ballCam;
    look.rear = lobby.playing && (devices.gamepad.rightStickButton.pressed
        || (classic ? devices.mouse.middle.pressed : devices.keyboard.leftCtrl.pressed));
    look.swivel = lobby.playing ? float2(StickAxis(devices.gamepad.rightStick.x), StickAxis(devices.gamepad.rightStick.y)) : float2(0);

    // The crowd is loud after a goal, and rises as the ball nears one
    var near = match.ball.live ? Math.Saturate((Math.Abs(match.ball.position.z) - 25) / 30) * 0.5 : 0.0;
    var wanted = match.phase == MatchPhase.Goal || match.phase == MatchPhase.Finished ? 1.0 : 0.25 + near;
    look.cheer += (wanted - look.cheer) * Math.Min(1, look.dt * 3);

    // The camera
    var mine = match.cars[look.seat];
    mut var rotation = quaternion.identity;
    // The game's widest view, 110 degrees across a 16:9 screen, as the
    // angle that is up and down: a wider screen sees more to the sides
    mut var fov = 77.55;
    if (!look.playing || match.phase == MatchPhase.Finished)
    {
        // Round the stadium behind the title, and round the pitch at the end
        var turn = look.clock * (look.playing ? 0.12 : 0.05);
        var wide = look.playing ? float3(33, 14, 44) : float3(30, 12, 41);
        look.eye = float3(Math.Sin(turn) * wide.x, wide.y, -Math.Cos(turn) * wide.z);
        look.heading = Math.Normalize(float3(0, 3, 0) - look.eye);
        look.placed = false;
        rotation = quaternion.LookRotation(look.heading, float3(0, 1, 0));
        fov = Math.Min(fov, 62);
    }
    else
    {
        rotation = AimCamera(look, mine, match.ball);
    }
    look.fov = fov;
    var jolt = float3(Math.Sin(look.clock * 83), Math.Sin(look.clock * 71), Math.Sin(look.clock * 59)) * (look.shake * look.shake * 0.12);
    look.eye += jolt;
    look.right = Math.Rotate(rotation, float3(1, 0, 0));
    look.up = Math.Rotate(rotation, float3(0, 1, 0));
    look.scene.SetCamera(look.eye, rotation, fov);
    Audio.SetListener(look.eye, rotation);
    Audio.SetFalloff(6, 160);

    // The cars, their wheels, and what's on the grass under them
    look.cars.Clear(); look.wheels.Clear(); look.blots.Clear(); look.pads.Clear(); look.orbs.Clear(); look.rings.Clear();
    for (var seat = 0; seat < match.size * 2; seat++)
    {
        var car = match.cars[seat];
        if (car.wrecked > 0) continue;
        var team = TeamOf(seat);
        var forward = CarForward(car);
        var along = Math.Dot(car.velocity, forward);
        look.wheelTurn[seat] = Math.Frac((look.wheelTurn[seat] + along * look.dt / 0.14) / Math.TAU) * Math.TAU;
        var tint = TeamColor(team);
        look.cars.Add(Piece { transform = float4x4.TRS(car.position, car.rotation, float3(1)), tint = tint, glow = car.boosting ? 0.6 : 0.0 });
        for (var wheel = 0; wheel < 4; wheel++)
        {
            var mount = WheelMount(wheel);
            var radius = WheelRadius(wheel);
            var hub = float3(mount.x, mount.y - WheelReach(wheel) + car.travel[wheel], mount.z);
            var turned = Math.Mul(car.rotation, Math.Mul(quaternion.AxisAngle(float3(0, 1, 0), wheel < 2 ? car.steer : 0.0),
                                                         quaternion.AxisAngle(float3(1, 0, 0), look.wheelTurn[seat])));
            look.wheels.Add(Piece { transform = float4x4.TRS(car.position + Math.Rotate(car.rotation, hub), turned,
                                    float3(wheel < 2 ? 0.14 : 0.165, radius, radius)), tint = tint });
        }
        // A patch of shade under the car: fainter the higher it is
        var over = Arena(car.position);
        if (over.normal.y > 0.9)
            look.blots.Add(Piece { transform = float4x4.TRS(float3(car.position.x, 0.03, car.position.z),
                quaternion.AxisAngle(float3(0, 1, 0), Math.Atan2(forward.x, forward.z)), float3(0.62, 1, 0.9) * (1 + over.distance * 0.06)),
                tint = Color(0, 0, 0, Math.Saturate(0.55 - over.distance * 0.07)) });

        // Fire from the nozzle while it boosts, and streaks off the rear wheels at supersonic speed
        var nozzle = car.position + Math.Rotate(car.rotation, float3(0, 0.07, -0.64));
        if (car.boosting)
        {
            for (var i = 0; i < 3 && look.motes.count < 1800; i++)
                look.motes.Add(Mote { position = nozzle + look.random.NextFloat3Direction() * 0.03,
                    velocity = car.velocity - forward * look.random.NextFloat(5, 11) + look.random.NextFloat3Direction() * 0.9,
                    tint = i == 0 ? Color(1, 0.5, 0.2, 0.95) : Color(1, 0.16, 0.02, 0.85), size = look.random.NextFloat(0.11, 0.2),
                    life = look.random.NextFloat(0.12, 0.3), drag = 3, stretch = 0.012 });
            look.motes.Add(Mote { position = nozzle, tint = Color(1, 0.8, 0.45, 0.9), size = 0.3, life = 0.035 });
            if (look.random.NextInt(3) == 0)
                look.motes.Add(Mote { position = nozzle - forward * 0.6, velocity = car.velocity * 0.3 + look.random.NextFloat3Direction() * 0.6,
                    tint = Color(0.75, 0.75, 0.78, 0.22), size = 0.2, life = 0.7, drag = 2, lift = 0.8, grow = 2.5, smoke = true });
        }
        if (car.supersonic && car.wheels > 0)
            for (var side = -1; side <= 1; side += 2)
                look.motes.Add(Mote { position = car.position + Math.Rotate(car.rotation, float3(side * 0.3, -0.13, -0.42)),
                    axis = car.velocity * (look.dt * 1.2), tint = Color(0.8, 0.9, 1, 0.5), size = 0.07, life = 0.45 });
    }

    // The ball, the shade under it, and the ring that says where it's coming down
    var ball = match.ball;
    look.ball = Piece { transform = float4x4.TRS(ball.position, ball.rotation, float3(BALL_RADIUS)), tint = Color.white, glow = 0.25 };
    if (ball.live && Math.Abs(ball.position.z) < BACK_WALL + GOAL_DEPTH)
    {
        var height = ball.position.y - BALL_RADIUS;
        look.blots.Add(Piece { transform = float4x4.TRS(float3(ball.position.x, 0.035, ball.position.z), quaternion.identity,
            float3(1 + height * 0.05, 1, 1 + height * 0.05) * 1.05), tint = Color(0, 0, 0, Math.Saturate(0.62 - height * 0.03)) });
        look.rings.Add(Piece { transform = float4x4.TRS(float3(ball.position.x, 0.04, ball.position.z), quaternion.identity,
            float3(1.25)), tint = Color(1, 1, 1, Math.Saturate(height * 0.4) * 0.75) });
        // A fast ball draws a line of light behind it
        var pace = Math.Length(ball.velocity);
        if (pace > 22)
            look.motes.Add(Mote { position = ball.position, axis = ball.velocity * (look.dt * 1.5),
                tint = Color(1, 0.9, 0.7, Math.Saturate((pace - 22) / 20) * 0.6), size = 0.55, life = 0.35 });
    }

    for (var pad = 0; pad < PADS; pad++)
    {
        var at = PadPosition(pad);
        var big = PadBig(pad);
        var ready = match.pads[pad] <= 0;
        var pulse = 0.75 + Math.Sin(look.clock * 4 + pad) * 0.25;
        look.pads.Add(Piece { transform = float4x4.TRS(float3(at.x, 0.04, at.z), quaternion.identity, float3(big ? 1.9 : 0.85)),
            tint = ready ? Color(1, 0.72, 0.12, 1) : Color(0.5, 0.36, 0.14, 0.45), glow = ready ? pulse : 0.0 });
        if (big && ready)
            look.orbs.Add(Piece { transform = float4x4.TRS(float3(at.x, 0.95 + Math.Sin(look.clock * 2.4 + pad) * 0.12, at.z),
                quaternion.identity, float3(0.62)), tint = Color(1, 0.7, 0.12, 0.92) });
    }
    StepMotes(look);
}

[Stage(Layers.Shadow)]
view Cast(Models models, Look look, MatchState match, mut Sun sun)
{
    if (!sun.made)
    {
        sun.made = true;
        sun.map = RenderTarget(2048, 2048, 1, Format.Depth);
        sun.depth = sun.map.depth;
    }
    // The shadow map follows the play: the middle of the camera's car and the ball
    var mine = match.cars[look.seat].position;
    mut var middle = look.playing ? (mine + match.ball.position) * 0.5 : float3(0);
    middle.y = 0;
    var turned = quaternion.LookRotation(-SunWay(), float3(0, 1, 0));
    var light = float4x4.TRS(middle + SunWay() * 140, turned, float3(1));
    sun.map.SetCamera(light, float4x4.Ortho(92, 92, 1, 300));
    sun.toLight = sun.map.WorldToClip();
    sun.map.Clear(Color.white);
    sun.map.Instanced(models.body, models.bodyFaces, look.cars);
    sun.map.Instanced(models.wheel, models.wheelFaces, look.wheels);
    if (match.ball.live) sun.map.Mesh(models.globe, models.globeFaces, look.ball.transform);
    sun.map.Instanced(models.globe, models.globeFaces, look.orbs);
}

[Stage(Layers.Scene)]
view Paint(Models models, Look look, MatchState match)
{
    if (!look.made || !models.made) return;
    look.scene.Clear(Color(0.6, 0.76, 0.92));
    look.scene.Depth(Depth.None), look.scene.Cull(Cull.Front)
    {
        look.scene.Mesh(models.globe, models.globeFaces, float4x4.TRS(look.eye, quaternion.identity, float3(400)), SkyPaint);
    }
    look.scene.Mesh(models.pitch, models.pitchFaces, float4x4.identity, GrassPaint);
    look.scene.Cull(Cull.None)
    {
        look.scene.Mesh(models.shell, models.shellFaces, float4x4.identity, ShellPaint);
    }
    look.scene.Depth(Depth.Read)
    {
        look.scene.Instanced(models.disc, models.discFaces, look.blots, BlotPaint);
        look.scene.Instanced(models.disc, models.discFaces, look.pads, PadPaint);
        look.scene.Instanced(models.disc, models.discFaces, look.rings, RingPaint);
    }
    look.scene.Instanced(models.body, models.bodyFaces, look.cars, CarPaint);
    look.scene.Instanced(models.wheel, models.wheelFaces, look.wheels, CarPaint);
    if (match.ball.live) look.scene.Mesh(models.globe, models.globeFaces, look.ball.transform, BallPaint, look.ball);
    look.scene.Instanced(models.globe, models.globeFaces, look.orbs, OrbPaint);
    look.scene.Depth(Depth.Read), look.scene.Cull(Cull.None)
    {
        look.scene.Mesh(models.glass, models.glassFaces, float4x4.identity, GlassPaint);
        look.scene.Instanced(models.card, models.cardFaces, look.puffs, SparkPlace, SparkPaint);
    }
    look.scene.Blend(Blend.Add), look.scene.Depth(Depth.Read), look.scene.Cull(Cull.None)
    {
        look.scene.Instanced(models.card, models.cardFaces, look.sparks, SparkPlace, SparkPaint);
    }
}

[Stage(Layers.Present)]
view Present(Look look)
{
    if (!look.made) return;
    Draw.Blit(look.scene.color, look.bright, BrightPaint);
    Draw.Blit(look.bright.color, look.blurred, BlurPaint, BlurStep { along = float2(look.pixel.x * 4, 0) });
    Draw.Blit(look.blurred.color, look.bright, BlurPaint, BlurStep { along = float2(0, look.pixel.y * 4) });
    Draw.Blit(look.scene.color, Draw.window, PresentPaint);
}
