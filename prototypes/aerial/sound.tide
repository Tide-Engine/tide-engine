// What the match sounds like on this machine. Every clip is made by
// sfx/make_sounds.py; none of it is the match's, and none of it is sent.
using Rooms;

asset Clip engineClip = "sfx/engine.wav";
asset Clip boostClip = "sfx/boost.wav";
asset Clip crowdClip = "sfx/crowd.wav";
asset Clip hitClip = "sfx/hit.wav";
asset Clip bounceClip = "sfx/bounce.wav";
asset Clip jumpClip = "sfx/jump.wav";
asset Clip dodgeClip = "sfx/dodge.wav";
asset Clip goalClip = "sfx/goal.wav";
asset Clip cheerClip = "sfx/cheer.wav";
asset Clip beepClip = "sfx/beep.wav";
asset Clip goClip = "sfx/go.wav";
asset Clip padClip = "sfx/pad.wav";
asset Clip bigPadClip = "sfx/bigpad.wav";
asset Clip wreckClip = "sfx/wreck.wav";
asset Clip bumpClip = "sfx/bump.wav";
asset Clip sonicClip = "sfx/sonic.wav";
asset Clip endClip = "sfx/end.wav";

local singleton Ears
{
    Sound engine;
    Sound boost;
    Sound rival;        // The nearest other car that's boosting
    Sound crowd;
    int count = -1;     // The countdown's last number heard
    bool sonic;
    float quiet;        // Seconds until another thump may play
}

[Stage(Layers.Hud)]
view Listen(mut Ears ears, Look look, MatchState match, Lobby lobby)
{
    var dt = Math.Min(Frame.dt, 0.05);
    ears.quiet = Math.Max(0, ears.quiet - dt);
    var inGame = lobby.page == Page.Playing && match.phase != MatchPhase.Finished;
    var mine = match.cars[look.seat];
    var speed = Math.Length(mine.velocity);

    // This car's engine climbs with its speed, and its boost roars over it
    ears.engine.clip = engineClip;
    ears.engine.loop = true;
    ears.engine.playing = inGame && mine.wrecked <= 0;
    ears.engine.volume = 0.1 + Math.Min(speed / CAR_MAX_SPEED, 1) * 0.12;
    ears.engine.pitch = 0.7 + Math.Min(speed / CAR_MAX_SPEED, 1) * 1.1;
    ears.boost.clip = boostClip;
    ears.boost.loop = true;
    ears.boost.playing = inGame && mine.boosting;
    ears.boost.volume = 0.3;
    ears.boost.pitch = mine.supersonic ? 1.15 : 1.0;

    // ...and the nearest other one that's boosting is heard from where it is
    mut var nearest = -1;
    mut var least = 3600.0;
    for (var seat = 0; seat < match.size * 2; seat++)
    {
        if (seat == look.seat || !match.cars[seat].boosting) continue;
        var far = Math.DistanceSq(match.cars[seat].position, look.eye);
        if (far >= least) continue;
        least = far;
        nearest = seat;
    }
    ears.rival.clip = boostClip;
    ears.rival.loop = true;
    ears.rival.spatial = true;
    ears.rival.playing = inGame && nearest >= 0;
    ears.rival.volume = 0.5;
    if (nearest >= 0) ears.rival.position = match.cars[nearest].position;

    ears.crowd.clip = crowdClip;
    ears.crowd.loop = true;
    ears.crowd.playing = true;
    ears.crowd.volume = 0.05 + look.cheer * 0.2;
    ears.crowd.pitch = 0.95 + look.cheer * 0.12;

    // Three beeps to the kickoff, and a higher one to go
    var count = match.phase == MatchPhase.Countdown ? int(Math.Ceil(match.phaseTime)) : 0;
    if (lobby.page == Page.Playing && count != ears.count && ears.count >= 0)
    {
        if (count > 0) Audio.Play(beepClip, 0.4);
        else if (match.phase == MatchPhase.Playing) Audio.Play(goClip, 0.45);
    }
    ears.count = count;
    if (inGame && mine.supersonic && !ears.sonic) Audio.Play(sonicClip, 0.35);
    ears.sonic = mine.supersonic;
}

local event(BallTouched touch) HearTouch(mut Ears ears, MatchState match)
{
    if (ears.quiet > 0 && touch.force < 2) return;
    ears.quiet = 0.08;
    Audio.Play(hitClip, match.ball.position, 0.35 + touch.force * 0.3, 1.25 - touch.force * 0.12);
}

local event(BallBounced bounce) HearBounce(MatchState match)
{
    Audio.Play(bounceClip, match.ball.position, 0.25 + bounce.force * 0.25, 1.1 - bounce.force * 0.08);
}

local event(verified GoalScored goal) HearGoal()
{
    Audio.Play(goalClip, 0.6);
    Audio.Play(cheerClip, 0.5, goal.team == 0 ? 1.0 : 0.94);
}

local event(verified CarWrecked wreck) HearWreck(MatchState match)
{
    if (wreck.seat < 0 || wreck.seat >= CARS) return;
    Audio.Play(wreckClip, match.cars[wreck.seat].position, 1.0);
}

local event(CarsBumped bump) HearBump(MatchState match)
{
    if (bump.seat < 0 || bump.seat >= CARS) return;
    Audio.Play(bumpClip, match.cars[bump.seat].position, 0.8);
}

local event(PadTaken taken) HearPad(Look look)
{
    var at = PadPosition(taken.pad);
    if (taken.seat == look.seat) Audio.Play(PadBig(taken.pad) ? bigPadClip : padClip, PadBig(taken.pad) ? 0.5 : 0.3);
    else Audio.Play(PadBig(taken.pad) ? bigPadClip : padClip, at, 0.6);
}

local event(CarJumped jumped) HearJump(Look look, MatchState match)
{
    if (jumped.seat < 0 || jumped.seat >= CARS) return;
    var clip = jumped.dodge ? dodgeClip : jumpClip;
    if (jumped.seat == look.seat) Audio.Play(clip, 0.3);
    else Audio.Play(clip, match.cars[jumped.seat].position, 0.7);
}

local event(verified MatchEnded ended) HearEnd()
{
    Audio.Play(endClip, 0.5, ended.winner == 0 ? 1.0 : 0.95);
    Audio.Play(cheerClip, 0.6);
}
