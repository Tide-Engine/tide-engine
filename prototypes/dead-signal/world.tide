// Authored sector plans. '#' is solid; the rest is walkable.
// Plans are a fixed grid shared by deterministic collision and local geometry.
const int SECTORS = 6;
const int MAP_W = 41;
const int MAP_H = 33;
const float TILE = 2.4;

string SectorName(int sector)
{
    switch (sector)
    {
        case 0: return "01 / INTAKE";
        case 1: return "02 / FOUNDRY";
        case 2: return "03 / RESERVOIR";
        case 3: return "04 / CHOIR";
        case 4: return "05 / TRANSMISSION";
        case 5: return "06 / EXTRACTION";
    }
    return "DEAD SIGNAL";
}

string SectorBrief(int sector)
{
    switch (sector)
    {
        case 0: return "Find three purge relays. Keep each other alive.";
        case 1: return "The foundry is awake. Flank its armored custodians.";
        case 2: return "Drain the signal. Break the ranged batteries first.";
        case 3: return "Silence the choir. Do not give the hunters your back.";
        case 4: return "Cut the transmission. The core knows you are here.";
        case 5: return "Destroy the source. Both of you must reach extraction.";
    }
    return "";
}

string SectorPlan(int sector)
{
    switch (sector)
    {
        case 0: return "#####################################################################################.........###############...........######.........###############...........######...................................######....X........................f.....######...................................######.........#####...#######...##......######.........#####...#######............########...########...################...########...########...################.U.########...########...################...#####.........#...........###............#####.........#...........###............#####.........#...........###............#####......#........................#....#####...Ce.#.......Bd.............c.#....#####......#........................#....#####.........#...##......###...........######.........#...........###...........######.........#...........###...........####################...###########...########.....###########...###########...########..T..###########...#######...........####.....#######...........###...........#####...########...........###...........#####...########.......#.................#####........###.....a.#..........Ab.....#####..................#.................#####....S.................###...##......#####......................###...........######.......#################...........############################################";
        case 1: return "############################################.........################################.........###########.............########.........###########.............########....X.......................#....########..........................f.#....########............................#....########.........#######...#.............###########...##########...#................########...##########...##############...#####.........#######...##############.U.#####.........#######...##############...#####.........####.........##............#####......................##............#####...Ce.................##............#####...................#................#####..##............Bd.#.........c......#####...................#................#####...........##.........##...##......##############...##.........##...........##############...##.........##...........##############...###############...##########.....#####...###############...##########..T..#####...###############...##########.....##.........#######.............######...###.........#######.............######...###........................#....######..........a................Ab.#....######..............................#....######...S....##.....#######.............######...............#######.............######.......#########################################################################";
        case 2: return "#####################################################################################.........#############.............######.........#############.............######...................................######....X.......................f......######...................................######.........######...####....##.......######.........######...####..............########...#########...###############...########...#########...######..........U.#####.........##...........##............#####.........##...........##............#####.........##...........##............#####......#........................#....#####...Ce.#........Bd............c.#....#####......#........................#....#####.........##...##......##...........######.........##...........##...........######.........##...........##...........####################...#######...........####################...###########...########.....###########...########.........#####..T..###########...########.........#####.....#######...........####.........######...########...........####.........######...########.......#..........Ab....######........###.....a.#................######..................#.........##.....######....S.................####.........######......................####.........#######.......########################################################################";
        case 3: return "#####################################################################################.........#############.............######.........#############...#.........######...................................######....X.......................f......######...................................######.........#####...#####.........#...######.........#####...#####..............########...########...################...########...####...........############.U.#####.........#...........#..............#####.........#...........#..............#####.#.......#..#........#...#..........#####....................................#####...Ce.........Bd............c.......#####....................................#####.......#.#........#..#.........#...######.........#...........#.............######.........#...........#.............################...........#######...########################...###########...########.....###########...#######...........####..T..###########...#######...........####.....#######...........###..#........#####...########..#........###...........#####...########..................Ab.....#####........###.....a...................#####.................................#..#####....S..............#..###...........#####......................###...........######.......########################################################################";
        case 4: return "#####################################################################################.........#############.............######.........#############.............######...................................######....X.......................f......######...................................######.........######...####....##.......######.........######...####..............########...#########...###############...########...#########...###############.U.#####.........##...........##............#####.........##...........##............#####.........##...........##............#####......#........................#....#####...Ce.#........Bd............c.#....#####......#........................#....#####.........##...##......##...........######.........##...........##...........######.........##...........##...........###################...############...#######################...############...########.....##########...########...........####..T..##########...########...........####.....######...........####...........#####...#######...........####...........#####...#######.......#...........Ab.....#####.......###.....a.#..................#####.................#..........##......#####...S.................####...........#####.....................####...........#####.......#########################################################################";
        case 5: return "#####################################################################################.........#############.............######.........#############...#.........######...................................######....X.......................f......######...................................######.........######...####.........#...######.........######...####..............########...#########...###############...########...#####...........###########.U.#####.........##...........##............#####.........##...........##............#####.#.......##..#........##..#.........#####....................................#####...Ce..........Bd............c......#####....................................#####.......#.##........#..##........#..######.........##...........##...........######.........##...........##...........#################...........######...#######################...############...########.....##########...########...........####..T..##########...########...........####.....######...........####..#........#####...#######..#........####...........#####...#######...................Ab.....#####.......###.....a....................#####.................................#..#####...S..............#..####...........#####.....................####...........#####.......#########################################################################";
    }
    return "";
}

char Cell(int sector, int x, int z)
{
    if (x < 0 || z < 0 || x >= MAP_W || z >= MAP_H) return '#';
    var plan = SectorPlan(sector);
    if (plan.length != MAP_W * MAP_H) return '#';
    return plan[z * MAP_W + x];
}

float2 CellCenter(int x, int z) { return float2((x + 0.5) * TILE, (z + 0.5) * TILE); }

float2 MarkerPoint(int sector, char marker)
{
    var plan = SectorPlan(sector);
    for (var i = 0; i < plan.length; i++)
        if (plan[i] == marker) return CellCenter(i % MAP_W, i / MAP_W);
    return CellCenter(6, 29);
}

float2 SpawnPoint(int sector, int seat)
{
    // The entrance faces east: pairs start side by side, with the next pair
    // behind, so a teammate's back doesn't fill the initial first-person view.
    return MarkerPoint(sector, 'S') + float2(-(seat / 2) * 1.6, (seat % 2) * 1.8 - 0.9);
}

float2 RelayPoint(int sector, int index)
{
    if (index == 0) return MarkerPoint(sector, 'A');
    if (index == 1) return MarkerPoint(sector, 'B');
    return MarkerPoint(sector, 'C');
}
float2 ExitPoint(int sector) { return MarkerPoint(sector, 'X'); }
float2 CachePoint(int sector, int index) { return MarkerPoint(sector, index == 0 ? 'T' : 'U'); }
float2 EncounterPoint(int sector, int index)
{
    switch (index)
    {
        case 0: return MarkerPoint(sector, 'a');
        case 1: return MarkerPoint(sector, 'b');
        case 2: return MarkerPoint(sector, 'c');
        case 3: return MarkerPoint(sector, 'd');
        case 4: return MarkerPoint(sector, 'e');
        case 5: return MarkerPoint(sector, 'f');
    }
    return ExitPoint(sector);
}

bool SolidAt(int sector, float2 p)
{
    return Cell(sector, int(Math.Floor(p.x / TILE)), int(Math.Floor(p.y / TILE))) == '#';
}

bool Walkable(int sector, float2 p, float radius)
{
    // Circle against each overlapping tile's AABB, including map bounds.
    var lo = int2(int(Math.Floor((p.x - radius) / TILE)), int(Math.Floor((p.y - radius) / TILE)));
    var hi = int2(int(Math.Floor((p.x + radius) / TILE)), int(Math.Floor((p.y + radius) / TILE)));
    for (var z = lo.y; z <= hi.y; z++)
    for (var x = lo.x; x <= hi.x; x++)
    {
        if (Cell(sector, x, z) != '#') continue;
        var corner = Math.Clamp(p, float2(x * TILE, z * TILE), float2((x + 1) * TILE, (z + 1) * TILE));
        if (Math.DistanceSq(p, corner) < radius * radius || radius == 0 && Math.DistanceSq(p, corner) == 0) return false;
    }
    return true;
}

float2 MoveClear(int sector, float2 from, float2 step, float radius)
{
    // Substeps prevent dash tunneling; axis separation slides along walls.
    var count = Math.Max(1, int(Math.Ceil(Math.Length(step) / 0.25)));
    mut var at = from;
    var part = step / count;
    for (var i = 0; i < count; i++)
    {
        var x = at + float2(part.x, 0);
        if (Walkable(sector, x, radius)) at = x;
        var z = at + float2(0, part.y);
        if (Walkable(sector, z, radius)) at = z;
    }
    return at;
}

float WallRayDistance(int sector, float2 from, float2 way, float limit)
{
    if (SolidAt(sector, from)) return 0;
    mut var cell = int2(int(Math.Floor(from.x / TILE)), int(Math.Floor(from.y / TILE)));
    var stepX = way.x < 0 ? -1 : 1;
    var stepZ = way.y < 0 ? -1 : 1;
    var deltaX = Math.Abs(way.x) > 0.00001 ? TILE / Math.Abs(way.x) : 100000;
    var deltaZ = Math.Abs(way.y) > 0.00001 ? TILE / Math.Abs(way.y) : 100000;
    mut var nextX = Math.Abs(way.x) > 0.00001 ? ((cell.x + (stepX > 0 ? 1 : 0)) * TILE - from.x) / way.x : 100000;
    mut var nextZ = Math.Abs(way.y) > 0.00001 ? ((cell.y + (stepZ > 0 ? 1 : 0)) * TILE - from.y) / way.y : 100000;
    for (var i = 0; i < MAP_W + MAP_H + 4; i++)
    {
        mut float distance = 0;
        if (nextX <= nextZ)
        {
            distance = nextX;
            nextX += deltaX;
            cell.x += stepX;
        }
        else
        {
            distance = nextZ;
            nextZ += deltaZ;
            cell.y += stepZ;
        }
        if (distance >= limit) return limit;
        if (Cell(sector, cell.x, cell.y) == '#') return Math.Max(distance, 0);
    }
    return limit;
}

bool RayClear(int sector, float2 from, float2 to)
{
    var distance = Math.Distance(from, to);
    return distance < 0.001 || WallRayDistance(sector, from, (to - from) / distance, distance) >= distance;
}

float3 FloorPoint(float2 p) { return float3(p.x, 0, p.y); }
float3 SectorStart(int sector, int seat) { return FloorPoint(SpawnPoint(sector, seat)); }
float3 EncounterAt(int sector, int encounter) { return FloorPoint(EncounterPoint(sector, encounter)); }
int EncounterCount(int sector) { return sector == 0 || sector == 1 || sector == 5 ? 5 : 6; }
int SectorGoal(int sector) { return sector >= 0 && sector < SECTORS ? 3 : 0; }
bool SolidAt(float3 at, float radius, int sector) { return !Walkable(sector, float2(at.x, at.z), radius); }
bool ClearLine(float3 a, float3 b, int sector) { return RayClear(sector, float2(a.x, a.z), float2(b.x, b.z)); }
float3 ExitAt(int sector) { return FloorPoint(ExitPoint(sector)); }

float3 SpawnAt(int sector, int encounter, int index)
{
    var center = EncounterPoint(sector, encounter);
    for (var attempt = 0; attempt < 16; attempt++)
    {
        var turn = (index * 0.618034 + attempt * 0.3125) * Math.TAU;
        var ring = 3.8 + (index % 3) * 1.1;
        var at = center + float2(Math.Cos(turn), Math.Sin(turn)) * ring;
        if (Walkable(sector, at, 0.6)) return FloorPoint(at);
    }
    return FloorPoint(center);
}
