// Static blacksite architecture. The floor and wall planes follow world.tide;
// the service hardware is baked once, rather than assembled from cube instances.
const float ENV_CONCRETE = 10;
const float ENV_STEEL = 11;
const float ENV_DECK = 12;
const float ENV_ENAMEL = 13;
const float ENV_CAUTION = 14;
const float ENV_SCREEN = 15;
const float ENV_LIGHT = 16;
const float ENV_RUBBER = 17;
const float ENV_ROOF = 18;
const float ENV_PAINT = 19;

Color FacilityWall(int sector)
{
    switch (sector)
    {
        case 0: return Color(0.47, 0.52, 0.48); // institutional sage enamel
        case 1: return Color(0.40, 0.34, 0.28); // foundry oxide and ochre
        case 2: return Color(0.32, 0.45, 0.43); // reservoir oxidized copper
        case 3: return Color(0.40, 0.38, 0.46); // choir porcelain and violet
        case 4: return Color(0.43, 0.32, 0.31); // transmission red primer
    }
    return Color(0.39, 0.45, 0.51);             // extraction cold naval steel
}

Color FacilityFloor(int sector)
{
    switch (sector)
    {
        case 1: return Color(0.28, 0.25, 0.21);
        case 2: return Color(0.22, 0.29, 0.27);
        case 3: return Color(0.27, 0.26, 0.30);
        case 4: return Color(0.29, 0.24, 0.23);
    }
    return Color(0.27, 0.29, 0.28);
}

Color FacilityTint(Color color, float scale)
{
    return Color(color.r * scale, color.g * scale, color.b * scale);
}

float3 WallPoint(float3 start, float3 along, float3 inward, float at, float height, float relief = 0)
{
    return start + along * at + float3(0, height, 0) + inward * relief;
}

void WallSheet(mut Art art, float3 start, float3 along, float3 inward,
               float from, float to, float bottom, float top, float relief, Color color, float kind)
{
    Quad(art.level, art.levelIndices,
         WallPoint(start, along, inward, from, bottom, relief), WallPoint(start, along, inward, to, bottom, relief),
         WallPoint(start, along, inward, to, top, relief), WallPoint(start, along, inward, from, top, relief),
         inward, color, kind);
}

// Bevels catch the light at grazing angles: structural ribs have a broad face
// and sloping cheeks, rather than a square column's silhouette.
void WallRib(mut Art art, float3 start, float3 along, float3 inward, float at,
             float width, float bottom, float top, float depth, Color color)
{
    var left = at - width * 0.5;
    var right = at + width * 0.5;
    var cheek = width * 0.22;
    WallSheet(art, start, along, inward, left + cheek, right - cheek, bottom, top, depth, color, ENV_STEEL);
    Quad(art.level, art.levelIndices,
        WallPoint(start, along, inward, left, bottom), WallPoint(start, along, inward, left + cheek, bottom, depth),
        WallPoint(start, along, inward, left + cheek, top, depth), WallPoint(start, along, inward, left, top),
        Math.Normalize(inward * cheek - along * depth), FacilityTint(color, 0.72), ENV_STEEL);
    Quad(art.level, art.levelIndices,
        WallPoint(start, along, inward, right - cheek, bottom, depth), WallPoint(start, along, inward, right, bottom),
        WallPoint(start, along, inward, right, top), WallPoint(start, along, inward, right - cheek, top, depth),
        Math.Normalize(inward * cheek + along * depth), FacilityTint(color, 1.16), ENV_STEEL);
}

void WallVent(mut Art art, float3 start, float3 along, float3 inward, float at, Color frame)
{
    WallSheet(art, start, along, inward, at - 0.49, at + 0.49, 1.52, 2.13, 0.043, frame, ENV_STEEL);
    WallSheet(art, start, along, inward, at - 0.43, at + 0.43, 1.57, 2.08, 0.045,
              Color(0.045, 0.055, 0.052), ENV_RUBBER);
    for (var slat = 0; slat < 6; slat++)
    {
        var y = 1.60 + slat * 0.078;
        Quad(art.level, art.levelIndices,
            WallPoint(start, along, inward, at - 0.42, y, 0.045),
            WallPoint(start, along, inward, at + 0.42, y, 0.045),
            WallPoint(start, along, inward, at + 0.42, y + 0.043, 0.085),
            WallPoint(start, along, inward, at - 0.42, y + 0.043, 0.085),
            Math.Normalize(inward * 0.043 - float3(0, 0.04, 0)), FacilityTint(frame, 0.84), ENV_STEEL);
    }
}

void FacilityWallRun(mut Art art, float3 start, float3 along, float3 inward, float length, int sector, int seed)
{
    var panel = FacilityWall(sector);
    var structure = Color(0.19, 0.22, 0.21);
    var concrete = Color(0.31, 0.32, 0.29);
    WallSheet(art, start, along, inward, 0, length, 0, 3.8, 0, structure, ENV_CONCRETE);
    WallSheet(art, start, along, inward, 0, length, 0.04, 0.55, 0.012, concrete, ENV_CONCRETE);
    WallSheet(art, start, along, inward, 0, length, 0.55, 0.61, 0.033, structure, ENV_STEEL);
    WallSheet(art, start, along, inward, 0, length, 2.77, 2.86, 0.047, structure, ENV_STEEL);
    // A continuous sloped crown breaks the rectangular tunnel outline.
    Quad(art.level, art.levelIndices,
        WallPoint(start, along, inward, 0, 3.18), WallPoint(start, along, inward, length, 3.18),
        WallPoint(start, along, inward, length, 3.79, 0.28), WallPoint(start, along, inward, 0, 3.79, 0.28),
        Math.Normalize(inward - float3(0, 0.46, 0)), FacilityTint(panel, 0.57), ENV_STEEL);
    var panels = int(Math.Ceil(length / 1.6));
    var span = length / Math.Max(panels, 1);
    for (var i = 0; i < panels; i++)
    {
        var from = i * span + 0.012;
        var to = (i + 1) * span - 0.012;
        var fade = 0.95 + ((Math.Hash(int2(seed, i)) & 31) / 31.0) * 0.08;
        WallSheet(art, start, along, inward, from, to, 0.63, 2.75, 0.021,
                  FacilityTint(panel, fade), ENV_ENAMEL);
        // Recessed access flaps and vent banks interrupt the panel rhythm.
        if ((i + seed) % 7 == 2 && span > 1.1) WallVent(art, start, along, inward, (from + to) * 0.5, panel);
        if ((i + seed) % 9 == 4)
        {
            var middle = (from + to) * 0.5;
            WallSheet(art, start, along, inward, middle - 0.31, middle + 0.31, 0.92, 1.38, 0.026,
                      FacilityTint(panel, 0.71), ENV_STEEL);
            WallSheet(art, start, along, inward, middle + 0.20, middle + 0.25, 1.07, 1.25, 0.035,
                      Color(0.09, 0.11, 0.10), ENV_RUBBER);
            WallSheet(art, start, along, inward, middle - 0.27, middle - 0.12, 1.27, 1.32, 0.036,
                      Color(0.72, 0.68, 0.48), ENV_PAINT);
        }
        if (i % 3 == 0)
        {
            WallRib(art, start, along, inward, i * span + 0.09, 0.17, 0.1, 3.77, 0.10, structure);
            WallSheet(art, start, along, inward, i * span + 0.045, i * span + 0.135, 0.65, 1.02, 0.102,
                      Color(0.65, 0.48, 0.18), ENV_CAUTION);
        }
    }
    // Upper wall pipes remain outside the player's movement/shot-height band.
    for (var pipe = 0; pipe < 2; pipe++)
    {
        var y = 2.94 + pipe * 0.15;
        var radius = pipe == 0 ? 0.058 : 0.031;
        var color = pipe == 0 ? Color(0.42, 0.39, 0.31) : FacilityTint(Accent(sector), 0.48);
        ModelTube(art.level, art.levelIndices, WallPoint(start, along, inward, 0, y, 0.09),
                  WallPoint(start, along, inward, length, y, 0.09), float2(radius), float2(radius), 6, color, ENV_STEEL);
        for (var at = 0.6; at < length; at += 2.8)
            ModelTube(art.level, art.levelIndices, WallPoint(start, along, inward, at - 0.035, y, 0.09),
                      WallPoint(start, along, inward, at + 0.035, y, 0.09), float2(radius + 0.015),
                      float2(radius + 0.015), 6, structure, ENV_STEEL);
    }
}

void FacilityLamp(mut Art art, float3 center, bool sideways, Color ink)
{
    var along = sideways ? float3(0, 0, 1) : float3(1, 0, 0);
    var across = sideways ? float3(1, 0, 0) : float3(0, 0, 1);
    var a = center - along * 0.8 - across * 0.17;
    var b = center + along * 0.8 - across * 0.17;
    var c = center + along * 0.8 + across * 0.17;
    var d = center - along * 0.8 + across * 0.17;
    Quad(art.level, art.levelIndices, a, b, c, d, float3(0, -1, 0), Color(0.12, 0.14, 0.13), ENV_STEEL);
    var down = float3(0, -0.025, 0);
    Quad(art.level, art.levelIndices, a + along * 0.08 + across * 0.065 + down,
         b - along * 0.08 + across * 0.065 + down, c - along * 0.08 - across * 0.065 + down,
         d + along * 0.08 - across * 0.065 + down, float3(0, -1, 0), Color(0.83, 0.84, 0.66), ENV_LIGHT);
    ModelTube(art.level, art.levelIndices, center - along * 0.9 + float3(0, 0.10, 0),
              center + along * 0.9 + float3(0, 0.10, 0), float2(0.018), float2(0.018), 5, ink, ENV_RUBBER);
}

void FloorMark(mut Art art, float2 at, float2 size, Color ink, float kind = ENV_PAINT)
{
    var p = Raise(at, 0.007);
    Quad(art.level, art.levelIndices, p + float3(-size.x, 0, -size.y) * 0.5,
         p + float3(size.x, 0, -size.y) * 0.5, p + float3(size.x, 0, size.y) * 0.5,
         p + float3(-size.x, 0, size.y) * 0.5, float3(0, 1, 0), ink, kind);
}

void FacilityTerminal(mut Art art, float2 at, int sector)
{
    var dark = Color(0.13, 0.18, 0.17);
    var shell = Color(0.42, 0.47, 0.42);
    var ink = Accent(sector);
    // An eight-sided tapered pedestal and leaning instrument head.
    ModelTube(art.level, art.levelIndices, Raise(at, 0.025), Raise(at, 0.18), float2(0.42, 0.33),
              float2(0.32, 0.25), 8, dark, ENV_STEEL);
    ModelTube(art.level, art.levelIndices, Raise(at, 0.18), Raise(at, 0.93), float2(0.22, 0.17),
              float2(0.17, 0.13), 6, shell, ENV_ENAMEL);
    ModelWedge(art.level, art.levelIndices, Raise(at, 1.14), float3(0.89, 0.43, 0.53), 0.16, shell, ENV_STEEL);
    // CRT and button deck are separate sloped faces, visible at eye height.
    var p = Raise(at, 0);
    Quad(art.level, art.levelIndices, p + float3(-0.34, 0.99, -0.276), p + float3(0.34, 0.99, -0.276),
         p + float3(0.34, 1.30, -0.276), p + float3(-0.34, 1.30, -0.276), float3(0, 0, -1),
         dark, ENV_RUBBER);
    Quad(art.level, art.levelIndices, p + float3(-0.28, 1.06, -0.279), p + float3(0.22, 1.06, -0.279),
         p + float3(0.22, 1.25, -0.279), p + float3(-0.28, 1.25, -0.279), float3(0, 0, -1),
         ink, ENV_SCREEN);
    ModelTube(art.level, art.levelIndices, p + float3(0.30, 1.35, 0.13), p + float3(0.30, 1.68, 0.13),
              float2(0.026), float2(0.026), 6, Color(0.75, 0.23, 0.12), ENV_LIGHT);
    ModelTube(art.level, art.levelIndices, p + float3(-0.20, 0.08, 0.23), p + float3(-0.30, 0.48, 0.23),
              float2(0.035), float2(0.035), 6, dark, ENV_RUBBER);
    // Painted service perimeter is flat and leaves collision unchanged.
    FloorMark(art, at + float2(0, -0.73), float2(1.7, 0.11), Color(0.64, 0.52, 0.22), ENV_CAUTION);
    FloorMark(art, at + float2(-0.78, 0), float2(0.10, 1.5), ink);
    FloorMark(art, at + float2(0.78, 0), float2(0.10, 1.5), ink);
}

void FacilityCache(mut Art art, float2 at)
{
    var shell = Color(0.39, 0.35, 0.24);
    var rim = Color(0.12, 0.14, 0.12);
    ModelTube(art.level, art.levelIndices, Raise(at, 0.02), Raise(at, 0.12), float2(0.47, 0.32),
              float2(0.42, 0.28), 8, rim, ENV_STEEL);
    ModelTube(art.level, art.levelIndices, Raise(at, 0.12), Raise(at, 0.47), float2(0.42, 0.28),
              float2(0.42, 0.28), 8, shell, ENV_ENAMEL);
    ModelTube(art.level, art.levelIndices, Raise(at, 0.47), Raise(at, 0.56), float2(0.42, 0.28),
              float2(0.32, 0.21), 8, FacilityTint(shell, 1.3), ENV_STEEL);
    FloorMark(art, at + float2(0, -0.54), float2(1.1, 0.09), Color(0.74, 0.62, 0.28));
    Quad(art.level, art.levelIndices, Raise(at, 0.23) + float3(-0.13, 0, -0.285),
         Raise(at, 0.23) + float3(0.13, 0, -0.285), Raise(at, 0.37) + float3(0.13, 0, -0.285),
         Raise(at, 0.37) + float3(-0.13, 0, -0.285), float3(0, 0, -1), Color(0.80, 0.72, 0.40), ENV_LIGHT);
}

void Bake(mut Art art, int sector)
{
    art.sector = sector;
    art.level.Clear(); art.levelIndices.Clear();
    var plan = SectorPlan(sector);
    var floor = FacilityFloor(sector);
    var roof = FacilityTint(FacilityWall(sector), 0.40);
    // The underlying walk surface stays exactly flat at y=0. Adjacent pieces
    // share continuous material coordinates, so the collision grid is invisible.
    for (var z = 0; z < MAP_H; z++)
    {
        for (var x = 0; x < MAP_W; x++)
        {
            if (PlanCell(plan, x, z) == '#') continue;
            var x0 = x * TILE;
            var z0 = z * TILE;
            var x1 = x0 + TILE;
            var z1 = z0 + TILE;
            var narrowX = PlanCell(plan, x - 1, z) == '#' || PlanCell(plan, x + 1, z) == '#';
            var narrowZ = PlanCell(plan, x, z - 1) == '#' || PlanCell(plan, x, z + 1) == '#';
            var deck = sector == 1 || sector == 4;
            Quad(art.level, art.levelIndices, float3(x0, 0, z0), float3(x1, 0, z0), float3(x1, 0, z1), float3(x0, 0, z1),
                 float3(0, 1, 0), deck ? FacilityTint(floor, 0.88) : floor, deck ? ENV_DECK : ENV_CONCRETE);
            Quad(art.level, art.levelIndices, float3(x0, 3.8, z0), float3(x1, 3.8, z0), float3(x1, 3.8, z1), float3(x0, 3.8, z1),
                 float3(0, -1, 0), roof, ENV_ROOF);
            if ((x * 7 + z * 11) % 17 == 0 || (x % 5 == 0 && narrowZ))
                FacilityLamp(art, float3((x + 0.5) * TILE, 3.66, (z + 0.5) * TILE), narrowX, Accent(sector));
            // Corridor portals: splayed upper haunches, one uninterrupted clear
            // walking opening, and a narrow safety sill painted on the floor.
            if (x % 5 == 0 && narrowZ && PlanCell(plan, x, z - 1) == '#' && PlanCell(plan, x, z + 1) == '#')
            {
                ModelTube(art.level, art.levelIndices, float3(x0 + 0.2, 3.38, z0 + 0.18),
                          float3(x0 + 0.2, 3.38, z1 - 0.18), float2(0.09), float2(0.09), 4,
                          Color(0.20, 0.23, 0.21), ENV_STEEL);
                FloorMark(art, float2(x0 + 0.2, (z0 + z1) * 0.5), float2(0.08, TILE),
                          Color(0.58, 0.48, 0.26), ENV_PAINT);
            }
        }
    }
    // Merge the exposed grid edges into long architectural runs. The panel
    // spacing is independent of TILE, with continuous pipes across joins.
    for (var face = 0; face < 4; face++)
    {
        var vertical = face < 2;
        var fixedCount = vertical ? MAP_W : MAP_H;
        var alongCount = vertical ? MAP_H : MAP_W;
        for (var fixed = 0; fixed < fixedCount; fixed++)
        {
            mut var begin = -1;
            for (var at = 0; at <= alongCount; at++)
            {
                var x = vertical ? fixed : at;
                var z = vertical ? at : fixed;
                var nx = x + (face == 0 ? -1 : face == 1 ? 1 : 0);
                var nz = z + (face == 2 ? -1 : face == 3 ? 1 : 0);
                var exposed = at < alongCount && PlanCell(plan, x, z) != '#' && PlanCell(plan, nx, nz) == '#';
                if (exposed && begin < 0) begin = at;
                if (!exposed && begin >= 0)
                {
                    var start = vertical ? float3((fixed + (face == 1 ? 1 : 0)) * TILE, 0, begin * TILE)
                                         : float3(begin * TILE, 0, (fixed + (face == 3 ? 1 : 0)) * TILE);
                    var inward = float3(face == 0 ? 1 : face == 1 ? -1 : 0, 0, face == 2 ? 1 : face == 3 ? -1 : 0);
                    FacilityWallRun(art, start, vertical ? float3(0, 0, 1) : float3(1, 0, 0), inward,
                                    (at - begin) * TILE, sector, fixed * 13 + begin * 7 + face * 3);
                    begin = -1;
                }
            }
        }
    }
    for (var relay = 0; relay < 3; relay++) FacilityTerminal(art, RelayPoint(sector, relay), sector);
    for (var cache = 0; cache < 2; cache++) FacilityCache(art, CachePoint(sector, cache));
    var exit = ExitPoint(sector);
    // Extraction reads as a painted landing pad, not a raised checkerboard tile.
    var ink = Accent(sector);
    FloorMark(art, exit + float2(0, -1.5), float2(3.1, 0.10), ink);
    FloorMark(art, exit + float2(0, 1.5), float2(3.1, 0.10), ink);
    FloorMark(art, exit + float2(-1.5, 0), float2(0.10, 3.1), ink);
    FloorMark(art, exit + float2(1.5, 0), float2(0.10, 3.1), ink);
    for (var i = 0; i < 3; i++)
    {
        var p = Raise(exit + float2(0, i * 0.44 - 0.5), 0.009);
        Quad(art.level, art.levelIndices, p + float3(-0.55, 0, -0.06), p + float3(0, 0, 0.22),
             p + float3(0.55, 0, -0.06), p + float3(0, 0, 0.10), float3(0, 1, 0), ink, ENV_PAINT);
    }
}

float FacilityGrain(float2 uv, float scale)
{
    return (Math.Hash(int2(int(Math.Floor(uv.x * scale)), int(Math.Floor(uv.y * scale)))) & 255) / 255.0;
}

frag LevelPaint(Surface surface, out Color color, ScenePaint room)
{
    var world = this.world;
    var horizontal = Math.Abs(surface.normal.y) > 0.7;
    var uv = horizontal ? world.xz : float2(Math.Abs(surface.normal.x) > 0.7 ? world.z : world.x, world.y);
    var grain = FacilityGrain(uv, 24);
    var fine = FacilityGrain(uv + float2(17, 39), 48);
    mut var tone = float3(surface.color.r, surface.color.g, surface.color.b);
    mut var glow = 0.0;
    if (surface.kind < ENV_CONCRETE + 0.5)
    {
        var stain = Math.Perlin(uv * 0.52 + float2(13, 5));
        tone *= 0.92 + grain * 0.11 + stain * 0.08;
        if (fine < 0.012) tone *= 0.83;
        if (!horizontal) tone *= 0.71 + Math.Saturate(world.y * 1.8) * 0.29;
        // A hairline expansion cut, deliberately much larger than the world
        // tiles and only one pixel wide in the near field.
        if (horizontal && Math.Min(Math.Frac(uv.x / 7.2), Math.Frac(uv.y / 10.8)) < 0.0015) tone *= 0.62;
    }
    else if (surface.kind < ENV_STEEL + 0.5)
    {
        tone *= 0.945 + grain * 0.075;
        if (Math.Frac(uv.y * 33) < 0.16) tone *= 0.95;
    }
    else if (surface.kind < ENV_DECK + 0.5)
    {
        var row = Math.Floor(uv.y / 3.6);
        var across = uv.x + Math.Frac(row * 0.5) * 0.68;
        tone *= 0.935 + grain * 0.095;
        if (Math.Frac(across / 1.35) < 0.006 || Math.Frac(uv.y / 3.6) < 0.003) tone *= 0.46;
        var tread = Math.Abs(Math.Frac(uv.x * 7 + uv.y * 7) - 0.5);
        if (tread < 0.075 && Math.Frac(uv.x * 3.5 - uv.y * 3.5) < 0.35) tone *= 1.07;
    }
    else if (surface.kind < ENV_ENAMEL + 0.5)
    {
        tone *= 0.955 + grain * 0.065;
        var drip = FacilityGrain(float2(uv.x, 0), 4);
        var dirt = Math.Saturate(0.91 - uv.y) * (0.06 + drip * 0.15);
        tone *= 1 - dirt;
        if (grain < 0.008 && fine > 0.83) tone *= float3(0.78, 0.73, 0.68);
    }
    else if (surface.kind < ENV_CAUTION + 0.5)
    {
        tone = Math.Frac(uv.x * 3.2 + uv.y * 3.2) < 0.46 ? tone : float3(0.09, 0.105, 0.09);
        tone *= 0.915 + grain * 0.10;
    }
    else if (surface.kind < ENV_SCREEN + 0.5)
    {
        var line = Math.Frac(uv.y * 57);
        var data = Math.Frac(Math.Floor(uv.y * 29) * 0.618 + Math.Floor(uv.x * 27) * 0.173);
        tone *= line < 0.32 ? 0.35 : data > 0.65 ? 1.05 : 0.58;
        glow = 0.78;
    }
    else if (surface.kind < ENV_LIGHT + 0.5)
    {
        tone *= 0.96 + fine * 0.06;
        glow = 0.88;
    }
    else if (surface.kind < ENV_RUBBER + 0.5) tone *= 0.925 + grain * 0.065;
    else if (surface.kind < ENV_ROOF + 0.5)
    {
        tone *= 0.985 + grain * 0.025;
        if (Math.Frac(uv.x / 1.6) < 0.003) tone *= 0.78;
    }
    else tone *= grain < 0.035 ? 0.84 : 0.97 + fine * 0.03;
    color = Shade(Color(tone.x, tone.y, tone.z), surface.normal, world, glow, room, this.position);
}
