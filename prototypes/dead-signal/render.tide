// Private Dead Signal presentation. The simulation never reads this state.
using Rooms;

enum RenderLayers { Prepare, World, Actors, Effects, Weapon, Present, HUD }

asset Clip scatterSound = "sfx/shotgun.wav";
asset Clip nailSound = "sfx/pistol.wav";
asset Clip arcSound = "sfx/pulse.wav";
asset Clip hitSound = "sfx/hit.wav";
asset Clip killSound = "sfx/kill.wav";
asset Clip hurtSound = "sfx/hurt.wav";
asset Clip stepSound = "sfx/step.wav";
asset Clip reviveSound = "sfx/revive.wav";
asset Clip relaySound = "sfx/relay.wav";
asset Clip alarmSound = "sfx/alarm.wav";
asset Clip pickupSound = "sfx/pickup.wav";
asset Clip humSound = "sfx/hum.wav";

local singleton Aim
{
    float yaw;
    float pitch;
    bool playing;
    Entity self;
    int generation = -1;
    int seat = -1;
}

struct Surface
{
    float3 position;
    float3 normal;
    Color color = Color.white;
    float kind;
}

struct Piece
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
    float glow;
}

struct Ember
{
    float3 position;
    float3 velocity;
    Color color;
    float age;
    float life = 0.35;
    float size = 0.08;
}

local singleton Art
{
    List<Surface> cube;
    List<int> cubeIndices;
    List<Surface> level;
    List<int> levelIndices;
    List<Piece> scenery;
    List<Piece> actors;
    List<Piece> lights;
    List<Piece> gun;
    bool made;
    int sector = -1;
}

local singleton Lens
{
    [Filter(Filter.Point)] RenderTarget scene;
    bool made;
    int width;
}

local singleton ScenePaint
{
    float3 eye;
    float2 pixels;
    Color fog;
    float time;
    float flash;
    float damage;
    float4x4 worldToClip;
}

local singleton Feedback
{
    Random random;
    List<Ember> sparks;
    float clock;
    float kick;
    float hit;
    float hurt;
    float notice;
    string message;
    float walk;
    float foot;
    int sector = -1;
    int encounter = -1;
    int previousKills;
    int relays;
    bool emergency;
    Phase phase;
    Sound hum;
}

[Before(Rooms.Pages)]
view TerminalTheme(Expedition run)
{
    GUI.SetTheme(GUITheme { text = Color(0.86, 0.92, 0.87), panel = Color(0.035, 0.055, 0.06),
                           control = Color(0.095, 0.16, 0.16), hot = Color(0.16, 0.27, 0.26),
                           pressed = Color(0.06, 0.12, 0.13), field = Color(0.02, 0.035, 0.04),
                           fieldHot = Color(0.06, 0.1, 0.11), accent = Accent(run.sector), radius = 2 });
}

Color Accent(int sector)
{
    switch (sector)
    {
        case 0: return Color(0.4, 0.82, 0.74);
        case 1: return Color(1, 0.4, 0.16);
        case 2: return Color(0.5, 0.86, 0.3);
        case 3: return Color(0.8, 0.5, 0.94);
        case 4: return Color(1, 0.28, 0.34);
    }
    return Color(0.35, 0.64, 1);
}

Color SeatColor(int seat)
{
    switch (seat)
    {
        case 0: return Color(0.35, 0.85, 0.95);
        case 1: return Color(1, 0.71, 0.28);
        case 2: return Color(0.7, 0.55, 1);
    }
    return Color(0.55, 0.96, 0.58);
}

float3 Raise(float2 at, float height)
{
    return float3(at.x, height, at.y);
}

void Quad(mut List<Surface> vertices, mut List<int> indices,
          float3 a, float3 b, float3 c, float3 d, float3 normal, Color color, float kind)
{
    var first = vertices.count;
    var forward = Math.Dot(Math.Cross(b - a, c - a), normal) > 0;
    vertices.Add(Surface { position = a, normal = normal, color = color, kind = kind });
    vertices.Add(Surface { position = forward ? b : d, normal = normal, color = color, kind = kind });
    vertices.Add(Surface { position = c, normal = normal, color = color, kind = kind });
    vertices.Add(Surface { position = forward ? d : b, normal = normal, color = color, kind = kind });
    indices.Add(first); indices.Add(first + 1); indices.Add(first + 2);
    indices.Add(first); indices.Add(first + 2); indices.Add(first + 3);
}

void BoxMesh(mut List<Surface> vertices, mut List<int> indices)
{
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        var way = face % 2 == 0 ? 1.0 : -1.0;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        Quad(vertices, indices, (normal - across - up) * 0.5, (normal + across - up) * 0.5,
             (normal + across + up) * 0.5, (normal - across + up) * 0.5, normal, Color.white, 0);
    }
}

void Block(mut List<Piece> pieces, float3 at, float3 size, Color color, float glow = 0)
{
    pieces.Add(Piece { transform = float4x4.TRS(at, quaternion.identity, size), tint = color, glow = glow });
}

void TurnedBlock(mut List<Piece> pieces, float3 at, float3 size, quaternion turn, Color color, float glow = 0)
{
    pieces.Add(Piece { transform = float4x4.TRS(at, turn, size), tint = color, glow = glow });
}

void Bake(mut Art art, int sector)
{
    art.sector = sector;
    art.level.Clear(); art.levelIndices.Clear(); art.scenery.Clear();
    var ink = Accent(sector);
    var wall = Color(0.32 + sector * 0.006, 0.34, 0.35);
    var floor = Color(0.19, 0.22, 0.24);
    var roof = Color(0.15, 0.17, 0.19);
    var plan = SectorPlan(sector);
    for (var z = 0; z < MAP_H; z++)
    {
        for (var x = 0; x < MAP_W; x++)
        {
            if (PlanCell(plan, x, z) == '#') continue;
            var x0 = x * TILE;
            var z0 = z * TILE;
            var x1 = x0 + TILE;
            var z1 = z0 + TILE;
            Quad(art.level, art.levelIndices, float3(x0, 0, z0), float3(x1, 0, z0), float3(x1, 0, z1), float3(x0, 0, z1),
                 float3(0, 1, 0), floor, 0);
            Quad(art.level, art.levelIndices, float3(x0, 3.8, z0), float3(x1, 3.8, z0), float3(x1, 3.8, z1), float3(x0, 3.8, z1),
                 float3(0, -1, 0), roof, 2);
            if (PlanCell(plan, x - 1, z) == '#')
                Quad(art.level, art.levelIndices, float3(x0, 0, z0), float3(x0, 3.8, z0), float3(x0, 3.8, z1), float3(x0, 0, z1),
                     float3(1, 0, 0), wall, 1);
            if (PlanCell(plan, x + 1, z) == '#')
                Quad(art.level, art.levelIndices, float3(x1, 0, z0), float3(x1, 0, z1), float3(x1, 3.8, z1), float3(x1, 3.8, z0),
                     float3(-1, 0, 0), wall, 1);
            if (PlanCell(plan, x, z - 1) == '#')
                Quad(art.level, art.levelIndices, float3(x0, 0, z0), float3(x1, 0, z0), float3(x1, 3.8, z0), float3(x0, 3.8, z0),
                     float3(0, 0, 1), wall, 1);
            if (PlanCell(plan, x, z + 1) == '#')
                Quad(art.level, art.levelIndices, float3(x0, 0, z1), float3(x0, 3.8, z1), float3(x1, 3.8, z1), float3(x1, 0, z1),
                     float3(0, 0, -1), wall, 1);
            // Ceiling strips and suspended beams make spaces readable without dynamic lights.
            if ((x * 7 + z * 11) % 13 == 0)
            {
                var at = float3((x + 0.5) * TILE, 3.73, (z + 0.5) * TILE);
                Block(art.scenery, at, float3(1.2, 0.12, 0.18), Color(0.65, 0.73, 0.68), 0.55);
                Block(art.scenery, at + float3(0, -0.1, 0), float3(1.05, 0.07, 0.1), ink, 1);
            }
            if (z % 5 == 0 && x % 4 == 0)
                Block(art.scenery, float3((x + 0.5) * TILE, 3.55, (z + 0.5) * TILE), float3(TILE, 0.18, 0.13), Color(0.21, 0.23, 0.25));
        }
    }
    for (var i = 0; i < 3; i++)
    {
        var p = RelayPoint(sector, i);
        Block(art.scenery, Raise(p, 0.56), float3(0.95, 1.12, 0.6), Color(0.16, 0.2, 0.23));
        Block(art.scenery, Raise(p, 1.25), float3(0.78, 0.4, 0.5), Color(0.35, 0.4, 0.42));
        Block(art.scenery, Raise(p, 1.34) + float3(0, 0, -0.27), float3(0.6, 0.2, 0.04), ink, 0.8);
    }
    var exit = ExitPoint(sector);
    Block(art.scenery, Raise(exit, 0.04), float3(2.0, 0.08, 2.0), ink, 0.3);
    for (var i = 0; i < 2; i++)
    {
        var p = CachePoint(sector, i);
        Block(art.scenery, Raise(p, 0.25), float3(0.75, 0.5, 0.55), Color(0.43, 0.36, 0.17));
        Block(art.scenery, Raise(p, 0.51), float3(0.55, 0.05, 0.35), Color(0.95, 0.72, 0.26), 0.3);
    }
}

char PlanCell(string plan, int x, int z)
{
    if (x < 0 || z < 0 || x >= MAP_W || z >= MAP_H) return '#';
    return plan[z * MAP_W + x];
}

vert PixelSnap(mut Surface vertex, out float4 clip, ScenePaint room)
{
    clip = this.clip;
    if (clip.w > 0.05)
    {
        mut var pixel = (clip.xy / clip.w * 0.5 + float2(0.5)) * room.pixels;
        pixel = Math.Floor(pixel + float2(0.5));
        clip.xy = (pixel / room.pixels * 2 - float2(1)) * clip.w;
    }
}

Color Shade(Color tint, float3 normal, float3 world, float glow, ScenePaint room, float2 pixel)
{
    var dist = Math.Distance(world, room.eye);
    mut var light = 0.44 + 0.40 * Math.Max(Math.Dot(normal, Math.Normalize(float3(-0.4, 0.8, -0.35))), 0);
    light += Math.Saturate(1 - dist / 9) * (0.23 + room.flash * 0.7);
    mut var paint = float3(tint.r, tint.g, tint.b) * (light + glow);
    mut var mist = Math.Saturate((dist - 7) / 36);
    mist = mist * mist * 0.92;
    paint += (float3(room.fog.r, room.fog.g, room.fog.b) - paint) * mist;
    var checker = Math.Frac(Math.Floor(pixel.x) * 0.5 + Math.Floor(pixel.y) * 0.25);
    paint = Math.Floor(paint * 28 + float3(checker * 0.65)) / 28;
    return Color(paint.x, paint.y, paint.z, 1);
}

frag LevelPaint(Surface surface, out Color color, ScenePaint room)
{
    mut var tone = float3(surface.color.r, surface.color.g, surface.color.b);
    var world = this.world;
    mut var glow = 0.0;
    if (surface.kind < 0.5)
    {
        var seam = Math.Min(Math.Frac(world.x / TILE), Math.Frac(world.z / TILE));
        if (seam < 0.025) tone *= 0.45;
        var plate = (int(Math.Floor(world.x * 4)) + int(Math.Floor(world.z * 4))) % 2;
        if (plate == 0) tone *= 0.88;
    }
    else if (surface.kind < 1.5)
    {
        var along = Math.Abs(surface.normal.x) > 0.5 ? world.z : world.x;
        if (Math.Frac(along / TILE) < 0.03) tone *= 0.4;
        if (world.y < 0.22 || world.y > 3.15) tone *= 0.52;
        if (world.y > 0.84 && world.y < 1.02)
        {
            var stripe = Math.Frac(along * 0.7 + world.y * 0.7);
            tone = stripe < 0.5 ? float3(0.48, 0.36, 0.13) : float3(0.1, 0.12, 0.13);
        }
        if (world.y > 2.42 && world.y < 2.46)
        {
            tone = float3(0.18, 0.38, 0.36);
            glow = 0.3;
        }
    }
    else
    {
        if (Math.Frac(world.x / TILE) < 0.04 || Math.Frac(world.z / TILE) < 0.04) tone *= 0.45;
    }
    color = Shade(Color(tone.x, tone.y, tone.z), surface.normal, world, glow, room, this.position);
}

frag ActorPaint(Surface surface, out Color color, Piece piece, Instance instance, ScenePaint room)
{
    color = Shade(piece.tint, instance.Normal(surface.normal), this.world, piece.glow, room, this.position);
}

frag GunPaint(Surface surface, out Color color, Piece piece, Instance instance)
{
    var normal = instance.Normal(surface.normal);
    var light = 0.45 + Math.Max(Math.Dot(normal, Math.Normalize(float3(-0.5, 0.75, -0.5))), 0) * 0.7 + piece.glow;
    var paint = float3(piece.tint.r, piece.tint.g, piece.tint.b) * light;
    color = Color(paint.x, paint.y, paint.z, 1);
}

frag Present(Vertex vertex, Texture source, out Color color, ScenePaint room)
{
    var sampled = source.Sample(vertex.uv, Filter.Point);
    var centered = vertex.uv * 2 - float2(1);
    var vignette = 1 - Math.Saturate(Math.Dot(centered, centered) * 0.17);
    mut var rgb = float3(sampled.r, sampled.g, sampled.b) * vignette;
    rgb += float3(0.45, 0.025, 0.005) * room.damage * Math.Saturate(Math.Length(centered) - 0.1);
    color = Color(rgb.x, rgb.y, rgb.z, 1);
}

void SparkAt(mut Feedback fx, float3 at, Color tone, int count, float force)
{
    for (var i = 0; i < count; i++)
    {
        var way = fx.random.NextFloat3Direction();
        fx.sparks.Add(Ember { position = at, velocity = way * fx.random.NextFloat(force * 0.3, force), color = tone,
                            life = fx.random.NextFloat(0.2, 0.55), size = fx.random.NextFloat(0.025, 0.08) });
    }
}

local event(Shot shot) HeardShot(mut Feedback fx, Aim hand)
{
    if (shot.seat == hand.seat) fx.kick = 1;
    var emergency = shot.seat == hand.seat && fx.emergency;
    Audio.Play(emergency ? nailSound : shot.weapon == Weapon.Scattergun || shot.weapon == Weapon.Launcher ? scatterSound
               : shot.weapon == Weapon.Arc ? arcSound : nailSound, shot.at, shot.seat == hand.seat ? 0.42 : 0.3,
               !emergency && shot.weapon == Weapon.Launcher ? 0.65 : 1);
    SparkAt(fx, shot.at + shot.way * 0.45, Color(1, 0.7, 0.2), 3, 1.6);
}

local event(Hurt hurt) HeardHurt(mut Feedback fx, Aim hand)
{
    if (hurt.seat != hand.seat) return;
    fx.hurt = Math.Max(fx.hurt, 0.55);
    Audio.Play(hurtSound, 0.5);
}

local event(EnemyFell fell) HeardDeath(mut Feedback fx)
{
    SparkAt(fx, fell.at + float3(0, 0.9, 0), Color(0.7, 0.15, 0.1), 11, 3.5);
    Audio.Play(killSound, fell.at, 0.28, fell.kind == EnemyKind.Warden ? 0.6 : 1);
    if (fell.crossfire) { fx.message = "CROSSFIRE"; fx.notice = 1.2; }
}

local event(Revived revived) HeardRevive(mut Feedback fx)
{
    SparkAt(fx, revived.at + float3(0, 0.6, 0), Color(0.3, 0.9, 0.75), 15, 1.8);
    Audio.Play(reviveSound, revived.at, 0.55);
    fx.message = $"OPERATIVE {revived.seat + 1} BACK ON THEIR FEET";
    fx.notice = 2;
}

local event(SectorChanged changed) HeardSector(mut Feedback fx)
{
    Audio.Play(relaySound, 0.48);
    fx.message = SectorName(changed.sector);
    fx.notice = 3;
    fx.sparks.Clear();
}

local event(EncounterStarted started) HeardEncounter(mut Feedback fx)
{
    Audio.Play(alarmSound, 0.32);
    fx.message = $"{SectorName(started.sector)} — THE SIGNAL HAS FOUND YOU";
    fx.notice = 2;
}

local event(RelicChosen chosen) HeardRelic(mut Feedback fx)
{
    Audio.Play(pickupSound, 0.5);
    fx.message = RelicName(chosen.relic);
    fx.notice = 1.5;
}

[Stage(RenderLayers.Prepare)]
view PrepareFrame(mut Art art, mut Lens lens, mut Aim hand, mut Feedback fx, mut ScenePaint room,
                  Expedition run, Devices devices, Session session, Lobby lobby, query (Marine marine, Pose pose, Owner owner) all)
{
    var dt = Math.Min(Frame.dt, 0.05);
    fx.clock += dt;
    fx.kick = Math.Max(0, fx.kick - dt * 7);
    fx.hit = Math.Max(0, fx.hit - dt * 5);
    fx.hurt = Math.Max(0, fx.hurt - dt * 1.7);
    fx.notice = Math.Max(0, fx.notice - dt);
    art.actors.Clear(); art.lights.Clear(); art.gun.Clear();
    if (!art.made)
    {
        art.made = true;
        BoxMesh(art.cube, art.cubeIndices);
    }
    if (art.sector != run.sector) Bake(art, run.sector);
    if (fx.sector != run.sector) { fx.sector = run.sector; fx.relays = run.relays; }
    if (run.relays != fx.relays)
    {
        var gained = (run.relays & ~fx.relays) != 0;
        fx.relays = run.relays;
        if (gained)
        {
            Audio.Play(relaySound, 0.4);
            fx.message = $"RELAY STABLE  /  {run.objective} OF 3";
            fx.notice = 2;
        }
    }
    var width = int(Math.Clamp(Math.Floor(270 * Screen.width / Math.Max(Screen.height, 1) + 0.5), 240, 960));
    if (!lens.made)
    {
        lens.made = true;
        lens.width = width;
        lens.scene = RenderTarget(width, 270, 1);
    }
    else if (lens.width != width) { lens.width = width; lens.scene.Resize(width, 270); }
    room.pixels = float2(width, 270);
    room.time = fx.clock;
    room.flash = fx.kick;
    room.damage = fx.hurt;
    room.fog = Color(0.045, 0.06, 0.065);
    hand.self = default; hand.seat = -1;
    hand.playing = lobby.playing && run.phase == Phase.Fight;
    room.eye = Raise(SpawnPoint(run.sector, 0), STANDING_EYE);
    foreach (var row in all)
    {
        if (row.owner.player != session.player) continue;
        hand.self = row.entity;
        hand.seat = row.marine.seat;
        fx.emergency = row.marine.downed || Ammo(row.marine) <= 0;
        if (row.marine.generation == run.generation && hand.generation != row.marine.generation)
        {
            hand.generation = row.marine.generation;
            hand.yaw = row.marine.yaw;
            hand.pitch = row.marine.pitch;
        }
        room.eye = row.pose.position + float3(0, row.marine.downed ? DOWNED_EYE : STANDING_EYE, 0);
        var speed = Math.Length(row.pose.velocity.xz);
        fx.walk += speed * dt * 1.7;
        fx.foot -= dt;
        if (speed > 0.8 && fx.foot <= 0 && !row.marine.downed && hand.playing)
        {
            Audio.Play(stepSound, 0.12, fx.random.NextFloat(0.88, 1.08));
            fx.foot = 0.34;
        }
        if (row.marine.kills > fx.previousKills) fx.hit = 1;
        fx.previousKills = row.marine.kills;
        var bob = Math.Sin(fx.walk * 2) * Math.Min(speed * 0.003, 0.025);
        room.eye.y += bob;
    }
    if (hand.playing)
    {
        Cursor.Lock();
        if (Cursor.locked)
        {
            hand.yaw += devices.mouse.delta.x * 0.0025;
            hand.pitch -= devices.mouse.delta.y * 0.0025;
        }
        var stick = devices.gamepad.rightStick;
        if (Math.Length(stick) > 0.14)
        {
            hand.yaw += stick.x * dt * 2.4;
            hand.pitch -= stick.y * dt * 1.8;
        }
        hand.pitch = Math.Clamp(hand.pitch, -PITCH_LIMIT, PITCH_LIMIT);
        hand.yaw -= Math.Floor((hand.yaw + Math.PI) / Math.TAU) * Math.TAU;
    }
    var rotation = quaternion.Euler(float3(hand.pitch + fx.hurt * Math.Sin(fx.clock * 55) * 0.012, hand.yaw, 0));
    lens.scene.SetCamera(room.eye, rotation, 72);
    room.worldToClip = lens.scene.WorldToClip();
    lens.scene.Clear(room.fog);
    Audio.SetListener(room.eye, rotation);
    Audio.SetFalloff(1, 42);
    fx.hum.clip = humSound; fx.hum.loop = true; fx.hum.playing = true; fx.hum.volume = 0.15;
}

[Stage(RenderLayers.World)]
view DrawLevel(Art art, Lens lens)
{
    if (!lens.made) return;
    lens.scene.Mesh(art.level, art.levelIndices, float4x4.identity, PixelSnap, LevelPaint);
    lens.scene.Instanced(art.cube, art.cubeIndices, art.scenery, PixelSnap, ActorPaint);
}

void Figure(mut Art art, float3 at, float yaw, Color color, float height, bool downed, float walk, float glow)
{
    var turn = quaternion.Euler(float3(0, yaw, downed ? Math.PI * 0.5 : 0));
    var root = float4x4.TRS(at, turn, float3(height / 1.7));
    var torso = Math.Transform(root, float3(0, 1.04, 0));
    TurnedBlock(art.actors, torso, float3(0.5, 0.62, 0.3) * (height / 1.7), turn, color, glow);
    TurnedBlock(art.actors, Math.Transform(root, float3(0, 1.4, 0)), float3(0.17, 0.15, 0.18) * (height / 1.7), turn,
                Color(0.12, 0.14, 0.15));
    TurnedBlock(art.actors, Math.Transform(root, float3(0, 1.59, 0)), float3(0.33, 0.3, 0.33) * (height / 1.7), turn,
                Color(0.2, 0.23, 0.24), glow * 0.4);
    TurnedBlock(art.actors, Math.Transform(root, float3(0, 1.6, 0.17)), float3(0.29, 0.07, 0.03) * (height / 1.7), turn,
                color, 1);
    TurnedBlock(art.actors, Math.Transform(root, float3(0, 1.07, -0.19)), float3(0.32, 0.45, 0.18) * (height / 1.7), turn,
                Color(0.12, 0.14, 0.15));
    for (var leg = 0; leg < 2; leg++)
    {
        var side = leg == 0 ? -1.0 : 1.0;
        var step = Math.Sin(walk) * side * 0.16;
        TurnedBlock(art.actors, Math.Transform(root, float3(side * 0.16, 0.38, step)), float3(0.18, 0.68, 0.22) * (height / 1.7),
                    turn, Color(0.16, 0.18, 0.19));
        TurnedBlock(art.actors, Math.Transform(root, float3(side * 0.16, 0.08, step + 0.07)), float3(0.21, 0.14, 0.33) * (height / 1.7),
                    turn, Color(0.085, 0.095, 0.1));
        TurnedBlock(art.actors, Math.Transform(root, float3(side * 0.33, 1.03, 0.09)), float3(0.17, 0.52, 0.18) * (height / 1.7),
                    turn, color, glow);
        TurnedBlock(art.actors, Math.Transform(root, float3(side * 0.33, 1.27, 0)), float3(0.26, 0.2, 0.25) * (height / 1.7),
                    turn, Color(color.r * 0.65, color.g * 0.65, color.b * 0.65), glow);
    }
    TurnedBlock(art.actors, Math.Transform(root, float3(0.36, 1.1, 0.39)), float3(0.12, 0.13, 0.65) * (height / 1.7), turn,
                Color(0.12, 0.14, 0.15));
}

[Stage(RenderLayers.Actors)]
view DrawActors(mut Art art, Lens lens, Aim hand, Feedback fx, Expedition run,
                query (Marine marine, Pose pose) players, query (Enemy enemy, Pose pose) enemies,
                query (Projectile projectile, Pose pose) projectiles, query (Supply supply, Pose pose) supplies)
{
    if (!lens.made) return;
    foreach (var row in players)
    {
        if (row.entity == hand.self) continue;
        Figure(art, row.pose.position, row.marine.yaw, SeatColor(row.marine.seat), 1.7, row.marine.downed,
               fx.clock * 11 + row.marine.seat, 0);
    }
    foreach (var row in enemies)
    {
        if (row.enemy.dead || row.enemy.generation != run.generation) continue;
        var kind = row.enemy.kind;
        var height = kind == EnemyKind.Warden ? 2.9 : kind == EnemyKind.Bulwark ? 2.2 : kind == EnemyKind.Rush ? 1.35 : 1.8;
        var tint = kind == EnemyKind.Warden ? Color(0.68, 0.25, 0.78) : kind == EnemyKind.Bulwark ? Color(0.61, 0.47, 0.28)
                   : kind == EnemyKind.Rush ? Color(0.74, 0.2, 0.14) : Color(0.54, 0.27, 0.21);
        var yaw = Math.Atan2(row.enemy.aim.x, row.enemy.aim.z);
        Figure(art, row.pose.position, yaw, tint, height, false, fx.clock * (kind == EnemyKind.Rush ? 17 : 8),
               row.enemy.flash > 0 ? 0.75 : row.enemy.windup > 0 ? 0.32 : 0);
        var turn = quaternion.Euler(float3(0, yaw, 0));
        var body = float4x4.TRS(row.pose.position, turn, float3(height / 1.7));
        if (kind == EnemyKind.Rush)
        {
            // The hunter's exposed spine and long blades make its rush readable in silhouette.
            TurnedBlock(art.actors, Math.Transform(body, float3(0, 1.26, -0.2)), float3(0.12, 0.55, 0.17), turn, Color(0.75, 0.66, 0.51));
            for (var side = -1; side <= 1; side += 2)
                TurnedBlock(art.actors, Math.Transform(body, float3(side * 0.35, 0.87, 0.3)), float3(0.045, 0.08, 0.54), turn, Color(0.83, 0.69, 0.47), 0.1);
        }
        if (kind == EnemyKind.Trooper)
        {
            TurnedBlock(art.actors, Math.Transform(body, float3(0, 1.12, 0.17)), float3(0.3, 0.31, 0.07), turn, Color(0.16, 0.18, 0.17));
            TurnedBlock(art.lights, Math.Transform(body, float3(0, 1.14, 0.22)), float3(0.1, 0.065, 0.035), turn, Color(1, 0.5, 0.16), 1);
        }
        if (kind == EnemyKind.Bulwark)
        {
            TurnedBlock(art.actors, row.pose.position + float3(0, 1.05, 0) + row.enemy.aim * 0.43,
                        float3(0.82, 1.3, 0.14), turn, Color(0.34, 0.36, 0.33));
            TurnedBlock(art.actors, Math.Transform(body, float3(0, 1.76, 0)), float3(0.63, 0.17, 0.4), turn, Color(0.39, 0.33, 0.23));
        }
        if (kind == EnemyKind.Warden)
        {
            Block(art.lights, row.pose.position + float3(0, 3.08, 0), float3(0.6, 0.1, 0.6), Accent(run.sector), 1.4);
        }
    }
    foreach (var row in projectiles)
    {
        var color = row.projectile.hostile ? Color(1, 0.3, 0.13) : Color(0.4, 0.86, 1);
        Block(art.lights, row.pose.position, float3(row.projectile.radius * 1.7), color, 1.5);
    }
    for (var i = 0; i < 3; i++)
    {
        var completed = (run.relays & (1 << i)) != 0;
        var tint = completed ? Color(0.2, 0.82, 0.46) : Accent(run.sector);
        var p = RelayPoint(run.sector, i);
        Block(art.lights, Raise(p, 1.6), float3(0.17, 0.17, 0.17), tint, 1);
        if (!completed)
            Block(art.lights, Raise(p, 2.0 + Math.Sin(fx.clock * 3) * 0.08), float3(0.09, 0.35, 0.09), tint, 1.5);
    }
    foreach (var row in supplies)
    {
        if (row.supply.taken || row.supply.generation != run.generation) continue;
        var p = row.pose.position + float3(0, 0.2 + Math.Sin(fx.clock * 3) * 0.07, 0);
        var medkit = row.supply.kind == 0;
        Block(art.actors, p, float3(0.35, 0.23, 0.35), medkit ? Color(0.76, 0.77, 0.68) : Color(0.41, 0.38, 0.21));
        if (medkit)
        {
            Block(art.lights, p + float3(0, 0.13, 0), float3(0.08, 0.02, 0.23), Color(0.3, 0.92, 0.49), 0.65);
            Block(art.lights, p + float3(0, 0.13, 0), float3(0.23, 0.02, 0.08), Color(0.3, 0.92, 0.49), 0.65);
        }
        else Block(art.lights, p + float3(0, 0.13, 0), float3(0.24, 0.02, 0.24), Color(0.95, 0.71, 0.25), 0.5);
    }
    for (var i = 0; i < EncounterCount(run.sector); i++)
    {
        if ((run.cleared & (1 << i)) != 0) continue;
        var p = EncounterAt(run.sector, i) + float3(0, 2.7, 0);
        Block(art.lights, p, float3(0.24, 0.13, 0.24), Color(0.95, 0.48, 0.16), 1.2);
    }
    lens.scene.Instanced(art.cube, art.cubeIndices, art.actors, PixelSnap, ActorPaint);
    lens.scene.Instanced(art.cube, art.cubeIndices, art.lights, PixelSnap, ActorPaint);
}

[Stage(RenderLayers.Effects)]
view DrawSparks(mut Feedback fx, mut Art art, Lens lens)
{
    if (!lens.made) return;
    art.lights.Clear();
    mut var index = 0;
    var dt = Math.Min(Frame.dt, 0.05);
    while (index < fx.sparks.count)
    {
        mut var spark = fx.sparks[index];
        spark.age += dt;
        if (spark.age >= spark.life) { fx.sparks.RemoveAt(index); continue; }
        spark.velocity.y -= dt * 7;
        spark.position += spark.velocity * dt;
        fx.sparks[index] = spark;
        var size = spark.size * (1 - spark.age / spark.life);
        Block(art.lights, spark.position, float3(size), spark.color, 0.8);
        index++;
    }
    lens.scene.Instanced(art.cube, art.cubeIndices, art.lights, PixelSnap, ActorPaint);
}

[Stage(RenderLayers.Weapon)]
view DrawWeapon(Marine marine, mut Art art, Lens lens, Feedback fx, Aim hand, with ownership)
{
    if (!lens.made || !hand.playing) return;
    var emergency = marine.downed || Ammo(marine) <= 0;
    var kick = fx.kick * fx.kick;
    var sway = Math.Sin(fx.walk) * 0.014;
    var at = float3(0.29 + sway, -0.29 - kick * 0.055, 0.85 - kick * 0.11);
    var steel = Color(0.35, 0.39, 0.42);
    var dark = Color(0.1, 0.13, 0.15);
    var stock = Color(0.36, 0.23, 0.15);
    if (emergency)
    {
        var grip = at + float3(-0.07, 0.025, 0);
        Block(art.gun, grip, float3(0.09, 0.09, 0.27), steel);
        Block(art.gun, grip + float3(0, -0.09, -0.08), float3(0.075, 0.19, 0.1), dark);
        Block(art.gun, grip + float3(0, 0.01, 0.19), float3(0.065, 0.06, 0.15), dark);
        Block(art.gun, grip + float3(0, 0.065, 0.18), float3(0.018, 0.025, 0.025), Color(0.9, 0.75, 0.35), 0.2);
        Block(art.gun, grip + float3(0.035, -0.09, -0.11), float3(0.12, 0.14, 0.24), Color(0.49, 0.35, 0.27));
    }
    else
    {
    Block(art.gun, at + float3(0.01, -0.075, -0.1), float3(0.18, 0.19, 0.4), stock);
    Block(art.gun, at, float3(0.18, 0.12, 0.43), steel);
    Block(art.gun, at + float3(0, -0.16, -0.21), float3(0.13, 0.29, 0.13), dark);
    Block(art.gun, at + float3(-0.1, -0.16, -0.2), float3(0.14, 0.16, 0.26), Color(0.49, 0.35, 0.27));
    Block(art.gun, at + float3(0.12, -0.17, 0.05), float3(0.13, 0.14, 0.27), Color(0.49, 0.35, 0.27));
    if (marine.weapon == Weapon.Scattergun)
    {
        Block(art.gun, at + float3(-0.052, 0.013, 0.33), float3(0.065, 0.07, 0.59), steel);
        Block(art.gun, at + float3(0.052, 0.013, 0.33), float3(0.065, 0.07, 0.59), steel);
        Block(art.gun, at + float3(0, -0.035, 0.32), float3(0.15, 0.1, 0.24), stock);
    }
    else if (marine.weapon == Weapon.Nailgun)
    {
        Block(art.gun, at + float3(0, 0, 0.31), float3(0.07, 0.09, 0.45), dark);
        Block(art.gun, at + float3(0, 0.13, 0.03), float3(0.16, 0.18, 0.25), Color(0.54, 0.46, 0.27));
    }
    else if (marine.weapon == Weapon.Launcher)
    {
        Block(art.gun, at + float3(0, 0.08, 0.25), float3(0.28, 0.23, 0.69), Color(0.34, 0.4, 0.27));
        Block(art.gun, at + float3(0, 0.08, 0.61), float3(0.24, 0.19, 0.035), dark);
    }
    else
    {
        Block(art.gun, at + float3(0, 0.04, 0.29), float3(0.13, 0.13, 0.5), dark);
        Block(art.gun, at + float3(-0.11, 0.045, 0.32), float3(0.055, 0.085, 0.3), Color(0.3, 0.8, 1), 0.45);
        Block(art.gun, at + float3(0.11, 0.045, 0.32), float3(0.055, 0.085, 0.3), Color(0.3, 0.8, 1), 0.45);
    }
    }
    if (fx.kick > 0.66)
    {
        var color = !emergency && marine.weapon == Weapon.Arc ? Color(0.3, 0.8, 1) : Color(1, 0.7, 0.18);
        Block(art.gun, at + (emergency ? float3(-0.07, 0.035, 0.28) : float3(0, 0.05, 0.77)),
              emergency ? float3(0.07, 0.09, 0.035) : float3(0.14, 0.16, 0.06), color, 1.8);
    }
    lens.scene.SetCamera(float3(0), quaternion.identity, 72);
    lens.scene.Depth(Depth.None)
    {
        lens.scene.Instanced(art.cube, art.cubeIndices, art.gun, GunPaint);
    }
}

[Stage(RenderLayers.Present)]
view ShowFrame(Lens lens)
{
    if (!lens.made) return;
    Draw.Blit(lens.scene.color, Draw.window, Present);
}

string GunName(Weapon weapon)
{
    return WeaponName(weapon);
}

int Ammo(Marine marine)
{
    switch (marine.weapon)
    {
        case Weapon.Scattergun: return marine.shells;
        case Weapon.Nailgun: return marine.nails;
        case Weapon.Launcher: return marine.rockets;
    }
    return marine.cells;
}

void Label(string text, float2 at, float size, Color color, Anchor anchor = Anchor.UpperLeft)
{
    Draw.Text(text, at + float2(1, 2), size, Color(0, 0, 0, 0.85), anchor, Font.Bold);
    Draw.Text(text, at, size, color, anchor, Font.Bold);
}

void Panel(Rect rect, Color color)
{
    Draw.Rect(float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5), float2(rect.width, rect.height), color);
}

string WrapLabel(string text, float size, float width)
{
    mut var output = "";
    mut var line = "";
    mut var word = "";
    for (var i = 0; i <= text.length; i++)
    {
        var letter = i == text.length ? ' ' : text[i];
        if (letter != ' ') { word += letter; continue; }
        if (word.length == 0) continue;
        var candidate = line.length == 0 ? word : line + " " + word;
        if (line.length > 0 && Draw.MeasureText(candidate, size, Font.Bold).x > width)
        {
            output += line + "\n";
            line = word;
        }
        else line = candidate;
        word = "";
    }
    return output + line;
}

int NearestContact(Expedition run, float3 from)
{
    mut var nearest = -1;
    mut var distance = 1000000.0;
    for (var i = 0; i < EncounterCount(run.sector); i++)
    {
        if ((run.cleared & (1 << i)) != 0) continue;
        var gap = Math.Distance(from, EncounterAt(run.sector, i));
        if (gap < distance) { distance = gap; nearest = i; }
    }
    return nearest;
}

int NearestRelay(Expedition run, float3 from)
{
    mut var nearest = -1;
    mut var distance = 1000000.0;
    for (var i = 0; i < 3; i++)
    {
        if ((run.relays & (1 << i)) != 0) continue;
        var gap = Math.Distance(from, Raise(RelayPoint(run.sector, i), 0));
        if (gap < distance) { distance = gap; nearest = i; }
    }
    return nearest;
}

local event(Impact impact) HeardImpact(mut Feedback fx, Aim hand)
{
    var tone = impact.hostile ? Color(1, 0.3, 0.1) : impact.hit ? Color(1, 0.55, 0.22) : Color(0.68, 0.76, 0.72);
    SparkAt(fx, impact.at, tone, impact.damage > 25 ? 9 : 4, 2.0);
    if (!impact.hostile && impact.hit && impact.seat == hand.seat)
    {
        fx.hit = 1;
        Audio.Play(hitSound, 0.18);
    }
}

[Stage(RenderLayers.HUD)]
view Readout(Expedition run, Session session, Lobby lobby, Aim hand, Feedback fx, ScenePaint room,
             Devices devices, query (Marine marine, Pose pose, Owner owner) players, query (Enemy enemy) enemies)
{
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var scale = Math.Clamp(w / 1100, 0.68, 1.25);
    var accent = Accent(run.sector);
    var pale = Color(0.85, 0.9, 0.87);
    var muted = Color(0.57, 0.67, 0.65);
    mut var mine = Marine { };
    mut var found = false;
    mut var myPosition = float3(0);
    foreach (var row in players)
    {
        if (row.owner.player == session.player) { mine = row.marine; myPosition = row.pose.position; found = true; }
    }
    // Framed as a field terminal, with plenty of space left for the weapon and arena.
    Panel(Rect(0, 0, w, 64 * scale), Color(0.015, 0.025, 0.025, 0.86));
    Panel(Rect(0, 64 * scale, w, 2), accent);
    Label("DEAD SIGNAL", float2(18 * scale, 11 * scale), 20 * scale, pale);
    Label(SectorName(run.sector), float2(18 * scale, 37 * scale), 11 * scale, muted);
    Label(run.phase == Phase.Fight ? $"PURGED {run.encounter}/{EncounterCount(run.sector)}   /   {run.remaining} HOSTILES"
          : run.phase == Phase.Relic ? "RELAY STABLE  /  CHOOSE AN IMPRINT" : "LINK ESTABLISHED", float2(w * 0.5, 13 * scale), 13 * scale, accent, Anchor.UpperCenter);
    Label($"RELAYS {run.objective}/3   |   {int(run.elapsed / 60):D2}:{int(run.elapsed) % 60:D2}",
          float2(w * 0.5, 37 * scale), 11 * scale, pale, Anchor.UpperCenter);
    if (session.open)
        Label($"ROOM {session.room}", float2(w - 18 * scale, 13 * scale), 12 * scale, pale, Anchor.UpperRight);
    Label($"{run.players} OPERATIVES", float2(w - 18 * scale, 37 * scale), 11 * scale, muted, Anchor.UpperRight);
    if (lobby.page != Page.Playing) return;

    var bottom = h - 83 * scale;
    Panel(Rect(0, bottom, w, 83 * scale), Color(0.015, 0.025, 0.025, 0.82));
    Panel(Rect(0, bottom, w, 2), Color(accent.r, accent.g, accent.b, 0.6));
    if (found)
    {
        Label($"{int(Math.Max(mine.health, 0))}", float2(19 * scale, bottom + 9 * scale), 32 * scale,
              mine.health < 30 ? Color(1, 0.31, 0.23) : pale);
        Label("VITALS", float2(22 * scale, bottom + 47 * scale), 10 * scale, muted);
        Label($"{int(mine.armour)}", float2(115 * scale, bottom + 12 * scale), 24 * scale, accent);
        Label("ARMOUR", float2(115 * scale, bottom + 47 * scale), 10 * scale, muted);
        var rounds = Ammo(mine);
        var emergency = mine.downed || rounds <= 0;
        Label(emergency ? "INF" : $"{rounds}", float2(w - 21 * scale, bottom + 9 * scale), 32 * scale,
              emergency || rounds <= 4 ? Color(1, 0.53, 0.2) : pale, Anchor.UpperRight);
        Label(emergency ? "EMERGENCY PISTOL" : GunName(mine.weapon), float2(w - 21 * scale, bottom + 47 * scale), 10 * scale,
              emergency ? Color(1, 0.53, 0.2) : muted, Anchor.UpperRight);
        var status = mine.downed ? $"DOWNED  /  REVIVE {int(Math.Saturate(mine.revive / REVIVE_TIME) * 100)}%"
                     : "1 SCATTER  2 NAILS" + (WeaponUnlocked(run, Weapon.Launcher) ? "  3 ROCKETS" : "  3 LOCKED")
                       + (WeaponUnlocked(run, Weapon.Arc) ? "  4 ARC" : "  4 LOCKED");
        Label(status, float2(w * 0.5, bottom + 15 * scale), 11 * scale, mine.downed ? Color(1, 0.6, 0.28) : pale, Anchor.UpperCenter);
        Label("WASD MOVE    LMB FIRE    E INTERACT / REVIVE    Q NEXT WEAPON    M MAP",
              float2(w * 0.5, bottom + 40 * scale), 9 * scale, muted, Anchor.UpperCenter);
    }
    mut var index = 0;
    foreach (var row in players)
    {
        if (row.entity == hand.self) continue;
        var color = SeatColor(row.marine.seat);
        var y = 86 * scale + index * 36 * scale;
        Label($"{row.marine.seat + 1}  {int(Math.Max(row.marine.health, 0))} HP" + (row.marine.downed ? "  DOWN" : ""),
              float2(18 * scale, y), 12 * scale, row.marine.downed ? Color(1, 0.52, 0.26) : color);
        Panel(Rect(18 * scale, y + 22 * scale, 104 * scale, 3), Color(0.1, 0.15, 0.15, 0.8));
        Panel(Rect(18 * scale, y + 22 * scale, 104 * scale * Math.Saturate(row.marine.health / Math.Max(row.marine.maximum, 1)), 3), color);
        var seen = Math.Mul(room.worldToClip, float4(row.pose.position + float3(0, row.marine.downed ? 0.75 : 2.1, 0), 1));
        if (seen.w > 0 && Math.Abs(seen.x) < seen.w && Math.Abs(seen.y) < seen.w)
        {
            var on = float2((seen.x / seen.w * 0.5 + 0.5) * w, (0.5 - seen.y / seen.w * 0.5) * h);
            Label(row.marine.downed ? $"REVIVE {row.marine.seat + 1}" : $"ALLY {row.marine.seat + 1}", on, 11 * scale, color, Anchor.MiddleCenter);
        }
        index++;
    }

    if (run.phase == Phase.Fight && found)
    {
        var center = float2(w * 0.5, h * 0.5);
        var size = (!mine.downed && Ammo(mine) > 0 && mine.weapon == Weapon.Scattergun ? 12.0 : 6.0) * scale + fx.kick * 6;
        var ink = fx.hit > 0 ? Color(1, 0.73, 0.22) : Color(0.85, 0.92, 0.87, 0.9);
        Draw.Line(center + float2(-size - 5, 0), center + float2(-size, 0), 2, ink);
        Draw.Line(center + float2(size, 0), center + float2(size + 5, 0), 2, ink);
        Draw.Line(center + float2(0, -size - 5), center + float2(0, -size), 2, ink);
        Draw.Line(center + float2(0, size), center + float2(0, size + 5), 2, ink);
        Panel(Rect(center.x - 1, center.y - 1, 2, 2), ink);
        if (fx.hit > 0)
        {
            Draw.Line(center + float2(-7, -7), center + float2(-3, -3), 2, ink);
            Draw.Line(center + float2(7, -7), center + float2(3, -3), 2, ink);
            Draw.Line(center + float2(-7, 7), center + float2(-3, 3), 2, ink);
            Draw.Line(center + float2(7, 7), center + float2(3, 3), 2, ink);
        }
        if (!Cursor.locked && !devices.gamepad.connected)
            Label("CLICK TO CAPTURE MOUSE  /  ESC RELEASES", float2(w * 0.5, h * 0.65), 12 * scale, pale, Anchor.MiddleCenter);
    }
    if (fx.notice > 0)
        Label(fx.message, float2(w * 0.5, 92 * scale), 20 * scale, accent, Anchor.UpperCenter);
    if (run.phase == Phase.Fight)
    {
        foreach (var row in enemies)
        {
            if (row.enemy.kind != EnemyKind.Warden || row.enemy.serial != 999 || row.enemy.dead || row.enemy.generation != run.generation) continue;
            Label($"SOURCE WARDEN  /  PHASE {run.finalePhase + 1}", float2(w * 0.5, 133 * scale), 12 * scale,
                  Color(0.86, 0.46, 1), Anchor.UpperCenter);
            Panel(Rect(w * 0.5 - 160 * scale, 153 * scale, 320 * scale, 7 * scale), Color(0.11, 0.06, 0.13, 0.9));
            Panel(Rect(w * 0.5 - 160 * scale, 153 * scale,
                       320 * scale * Math.Saturate(row.enemy.health / Math.Max(row.enemy.maximum, 1)), 7 * scale), Color(0.7, 0.28, 0.91));
        }
        for (var i = 0; i < EncounterCount(run.sector); i++)
        {
            if (!run.queued[i] || run.reinforcement[i] > 0.65) continue;
            Label("CONTACTS INBOUND", float2(w * 0.5, 173 * scale), 12 * scale, Color(1, 0.52, 0.2), Anchor.UpperCenter);
            break;
        }
    }
    if (run.phase == Phase.Fight && found)
    {
        var contact = NearestContact(run, myPosition);
        var relay = NearestRelay(run, myPosition);
        var target = contact >= 0 ? EncounterAt(run.sector, contact) : relay >= 0 ? Raise(RelayPoint(run.sector, relay), 0) : ExitAt(run.sector);
        var gap = Math.Distance(target, myPosition);
        var angle = Math.Atan2(target.x - myPosition.x, target.z - myPosition.z) - hand.yaw;
        var difference = angle - Math.Floor((angle + Math.PI) / Math.TAU) * Math.TAU;
        var bearing = Math.Abs(difference) < 0.35 ? "AHEAD" : difference < 0 ? "LEFT" : "RIGHT";
        var mission = mine.downed ? "HOLD ON — A TEAMMATE CAN REVIVE YOU"
            : run.remaining > 0 ? $"PURGE THE CONTACTS   /   {run.remaining} REMAINING"
            : contact >= 0 ? $"INVESTIGATE CONTACT {contact + 1}   /   {int(gap)} M {bearing}"
            : relay >= 0 ? $"RELAY {relay + 1}   /   {int(gap)} M {bearing}   /   TWO OPERATIVES HOLD E"
            : $"EXTRACTION   /   {int(gap)} M {bearing}   /   SQUAD HOLD E";
        Label(mission, float2(w * 0.5, h - 107 * scale), 12 * scale, mine.downed ? Color(1, 0.55, 0.25) : accent, Anchor.MiddleCenter);
        foreach (var row in players)
        {
            if (!row.marine.downed || row.entity == hand.self || mine.downed) continue;
            if (Math.Distance(row.pose.position, myPosition) > 2.8) continue;
            Label($"HOLD E TO REVIVE OPERATIVE {row.marine.seat + 1}   {int(Math.Saturate(row.marine.revive / REVIVE_TIME) * 100)}%",
                  float2(w * 0.5, h * 0.65), 14 * scale, SeatColor(row.marine.seat), Anchor.MiddleCenter);
        }
        for (var i = 0; i < 3; i++)
        {
            if ((run.relays & (1 << i)) != 0 || Math.Distance(myPosition, Raise(RelayPoint(run.sector, i), 0)) > 4.2) continue;
            var percent = int(Math.Saturate(run.relayHold[i] / 1.8) * 100);
            Label($"RELAY {i + 1} — CLEAR THE AREA, THEN TWO OPERATIVES HOLD E   {percent}%",
                  float2(w * 0.5, h * 0.69), 13 * scale, accent, Anchor.MiddleCenter);
        }
    }
    if (run.suspended && run.phase == Phase.Fight)
    {
        Panel(Rect(w * 0.5 - 225 * scale, h * 0.5 - 40 * scale, 450 * scale, 80 * scale), Color(0.02, 0.035, 0.04, 0.94));
        Label("LINK LOST — WAITING FOR A SECOND OPERATIVE", float2(w * 0.5, h * 0.5 - 12 * scale), 14 * scale, accent, Anchor.MiddleCenter);
        Label("The expedition waits here. Share the room code to reconnect.", float2(w * 0.5, h * 0.5 + 13 * scale), 10 * scale, pale, Anchor.MiddleCenter);
    }
    if (devices.keyboard.m.pressed)
    {
        var cell = Math.Min(7 * scale, Math.Min((w - 80) / MAP_W, (h - 130) / MAP_H));
        var left = (w - MAP_W * cell) * 0.5;
        var top = (h - MAP_H * cell) * 0.5;
        Panel(Rect(left - 12, top - 30, MAP_W * cell + 24, MAP_H * cell + 42), Color(0.015, 0.025, 0.03, 0.95));
        Label("SECTOR SCAN", float2(w * 0.5, top - 22), 12 * scale, accent, Anchor.UpperCenter);
        var plan = SectorPlan(run.sector);
        for (var z = 0; z < MAP_H; z++)
        {
            for (var x = 0; x < MAP_W; x++)
            {
                if (PlanCell(plan, x, z) == '#') continue;
                Panel(Rect(left + x * cell, top + z * cell, cell - 1, cell - 1), Color(0.24, 0.31, 0.31));
            }
        }
        for (var i = 0; i < 3; i++)
        {
            var p = RelayPoint(run.sector, i);
            Draw.Circle(float2(left + p.x / TILE * cell, top + p.y / TILE * cell), 3, (run.relays & (1 << i)) != 0 ? Color.green : accent);
        }
        for (var i = 0; i < EncounterCount(run.sector); i++)
        {
            var p = EncounterAt(run.sector, i);
            var done = (run.cleared & (1 << i)) != 0;
            Draw.Circle(float2(left + p.x / TILE * cell, top + p.z / TILE * cell), 3,
                        done ? Color(0.25, 0.48, 0.3) : Color(1, 0.43, 0.18));
        }
        for (var i = 0; i < 2; i++)
        {
            if ((run.caches & (1 << i)) != 0) continue;
            var p = CachePoint(run.sector, i);
            Panel(Rect(left + p.x / TILE * cell - 2, top + p.y / TILE * cell - 2, 4, 4), Color(0.97, 0.74, 0.25));
        }
        var exit = ExitPoint(run.sector);
        Draw.WireRect(float2(left + exit.x / TILE * cell, top + exit.y / TILE * cell), float2(8, 8), Color.white);
        foreach (var row in players)
            Draw.Circle(float2(left + row.pose.position.x / TILE * cell, top + row.pose.position.z / TILE * cell), 3.5, SeatColor(row.marine.seat));
        Label("ORANGE CONTACTS   TEAL RELAYS   GOLD SUPPLIES   WHITE EXIT", float2(w * 0.5, top + MAP_H * cell + 8), 9 * scale, pale, Anchor.UpperCenter);
    }
    if (run.phase == Phase.Lobby)
    {
        var box = Rect(w * 0.5 - 250 * scale, h * 0.5 - 120 * scale, 500 * scale, 230 * scale);
        Panel(box, Color(0.02, 0.035, 0.04, 0.95));
        Label("ENTER THE TRANSMISSION", float2(w * 0.5, box.y + 20 * scale), 22 * scale, accent, Anchor.UpperCenter);
        Label("Two to four operatives. Six sectors. One living signal.", float2(w * 0.5, box.y + 61 * scale), 12 * scale, pale, Anchor.UpperCenter);
        Label("Keep moving. Cover a revive. Crossfire breaks armoured threats.", float2(w * 0.5, box.y + 87 * scale), 11 * scale, muted, Anchor.UpperCenter);
        Label($"{run.players}/2 REQUIRED    {Bits(run.ready & run.manned)}/{run.players} READY", float2(w * 0.5, box.y + 117 * scale), 14 * scale, pale, Anchor.UpperCenter);
        GUI.Navigate();
        if (GUI.Button(Rect(w * 0.5 - 115 * scale, box.y + 155 * scale, 230 * scale, 42 * scale), mine.ready ? "Unready" : "Ready up"))
            Send(Ready { value = !mine.ready });
        Label("Host a room from Menu, then share its code.", float2(w * 0.5, box.y + 207 * scale), 10 * scale, muted, Anchor.UpperCenter);
    }
    if (run.phase == Phase.Relic)
    {
        Panel(Rect(w * 0.5 - 340 * scale, h * 0.5 - 132 * scale, 680 * scale, 260 * scale), Color(0.02, 0.035, 0.04, 0.95));
        Label("THE SIGNAL LEAVES AN IMPRINT", float2(w * 0.5, h * 0.5 - 112 * scale), 22 * scale, accent, Anchor.UpperCenter);
        Label("Choose a relic for this expedition. All operatives choose before departure.",
              float2(w * 0.5, h * 0.5 - 75 * scale), 11 * scale, pale, Anchor.UpperCenter);
        GUI.Navigate();
        for (var i = 0; i < 3; i++)
        {
            var id = i == 0 ? run.offers.x : i == 1 ? run.offers.y : run.offers.z;
            var x = w * 0.5 + (i - 1) * 211 * scale;
            var rect = Rect(x - 99 * scale, h * 0.5 - 35 * scale, 198 * scale, 64 * scale);
            GUI.Disabled(mine.selected >= 0)
            {
                if (GUI.Button(rect, RelicName(id))) Send(PickRelic { choice = i, sector = run.sector });
            }
            Label(WrapLabel(RelicDetail(id), 10 * scale, 192 * scale), float2(x, h * 0.5 + 45 * scale), 10 * scale, muted, Anchor.UpperCenter);
        }
        Label(mine.selected >= 0 ? "IMPRINT LOCKED  /  WAITING FOR THE SQUAD" : "Choose deliberately. Your partner can build differently.",
              float2(w * 0.5, h * 0.5 + 94 * scale), 12 * scale, pale, Anchor.UpperCenter);
    }
    if (run.phase == Phase.Wipe || run.phase == Phase.Victory)
    {
        Panel(Rect(w * 0.5 - 260 * scale, h * 0.5 - 124 * scale, 520 * scale, 250 * scale), Color(0.02, 0.035, 0.04, 0.96));
        var won = run.phase == Phase.Victory;
        Label(won ? "THE SIGNAL IS SILENT" : "SQUAD SIGNAL LOST", float2(w * 0.5, h * 0.5 - 95 * scale), 27 * scale,
              won ? accent : Color(1, 0.4, 0.24), Anchor.UpperCenter);
        Label(won ? "You made it out together." : "The relay retains your last checkpoint.", float2(w * 0.5, h * 0.5 - 47 * scale), 14 * scale, pale, Anchor.UpperCenter);
        Label($"{run.kills} HOSTILES PURGED    {int(run.elapsed / 60)} MINUTES    {run.wipes} RECOVERIES",
              float2(w * 0.5, h * 0.5 - 10 * scale), 11 * scale, muted, Anchor.UpperCenter);
        GUI.Navigate();
        if (GUI.Button(Rect(w * 0.5 - 125 * scale, h * 0.5 + 37 * scale, 250 * scale, 44 * scale), won ? "Another expedition" : "Retry this sector"))
        {
            if (won) Send(NewExpedition { }); else Send(Retry { });
        }
        Label(won ? "PRIVATE PROTOTYPE  /  THANK YOU FOR PLAYING" : "Stay close enough to recover. Split angles to break armour.",
              float2(w * 0.5, h * 0.5 + 103 * scale), 10 * scale, muted, Anchor.UpperCenter);
    }
}

override string Rooms.Title() { return "DEAD SIGNAL"; }
override string Rooms.Tagline() { return "Private co-op prototype. Two operatives minimum."; }
override Rect Rooms.MenuButton(float2 screen) { return Rect(screen.x - 90, 85, 80, 32); }
