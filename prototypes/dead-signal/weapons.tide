// Original first-person models. All coordinates are camera-local, looking
// along +Z. Shapes are authored surfaces, tapered tubes and bevelled hulls;
// their materials live in Surface.color rather than an instance's tint.

void WeaponBore(mut List<Surface> mesh, mut List<int> indices, float3 from, float3 to,
    float radius, float inner, int sides, Color steel)
{
    var dark = Color(0.035, 0.045, 0.048);
    for (var i = 0; i < sides; i++)
    {
        var a = Math.TAU * i / sides;
        var b = Math.TAU * (i + 1) / sides;
        var ra = float3(Math.Cos(a), Math.Sin(a), 0);
        var rb = float3(Math.Cos(b), Math.Sin(b), 0);
        var outsideA = from + ra * radius;
        var outsideB = from + rb * radius;
        var endA = to + ra * radius;
        var endB = to + rb * radius;
        var insetA = to + ra * inner;
        var insetB = to + rb * inner;
        var deepA = to - float3(0, 0, 0.07) + ra * inner;
        var deepB = to - float3(0, 0, 0.07) + rb * inner;
        ModelQuad(mesh, indices, outsideA, outsideB, endB, endA, steel);
        ModelQuad(mesh, indices, endA, endB, insetB, insetA, Color(0.47, 0.51, 0.51));
        ModelQuad(mesh, indices, insetA, insetB, deepB, deepA, dark);
        ModelTriangle(mesh, indices, to - float3(0, 0, 0.071), deepA, deepB, dark);
        ModelTriangle(mesh, indices, from, outsideB, outsideA, steel);
    }
}

// A few deliberately placed chips follow the receiver's sloped roof. Their
// broad irregular shapes survive the low-resolution image without noise.
void WeaponWear(mut List<Surface> mesh, mut List<int> indices, float3 center,
    float3 size, float slope, Color exposed)
{
    for (var i = 0; i < 5; i++)
    {
        var x = center.x + size.x * (-0.35 + i * 0.16);
        var z = center.z + size.z * (i % 2 == 0 ? -0.29 : 0.23);
        var wide = size.x * (i % 2 == 0 ? 0.065 : 0.09);
        var chipLength = size.z * 0.045;
        var a = float3(x - wide, center.y + size.y * 0.5 + slope * (z - chipLength - center.z) / size.z + 0.001, z - chipLength);
        var b = float3(x + wide * 0.25, center.y + size.y * 0.5 + slope * (z + chipLength - center.z) / size.z + 0.001, z + chipLength);
        var c = float3(x + wide, center.y + size.y * 0.5 + slope * (z - center.z) / size.z + 0.001, z);
        ModelTriangle(mesh, indices, a, b, c, exposed);
    }
}

void WeaponHull(mut List<Surface> mesh, mut List<int> indices, float3 center,
    float3 size, float slope, Color paint)
{
    ModelWedge(mesh, indices, center, size, slope, paint);
    WeaponWear(mesh, indices, center, size, slope, Color(0.57, 0.58, 0.53));
}

// Hard chamfers around a tapered receiver: the camera-facing shoulder is
// narrower than the front housing, so the working parts stay visible.
void WeaponTaper(mut List<Surface> mesh, mut List<int> indices, float3 from,
    float3 to, float2 back, float2 front, Color paint, Color trim)
{
    for (var i = 0; i < 8; i++)
    {
        var a = ModelBevelCorner(7 - i, back);
        var b = ModelBevelCorner(7 - (i + 1) % 8, back);
        var c = ModelBevelCorner(7 - (i + 1) % 8, front);
        var d = ModelBevelCorner(7 - i, front);
        var p = from + float3(a.x, a.y, 0);
        var q = from + float3(b.x, b.y, 0);
        var r = to + float3(c.x, c.y, 0);
        var s = to + float3(d.x, d.y, 0);
        ModelQuad(mesh, indices, p, q, r, s, i == 0 || i == 7 ? trim : paint);
        ModelTriangle(mesh, indices, from, q, p, trim);
        ModelTriangle(mesh, indices, to, s, r, paint);
    }
}

void WeaponGlove(mut List<Surface> mesh, mut List<int> indices, float3 wrist, float3 palm, bool left)
{
    var fabric = Color(0.14, 0.17, 0.16);
    var worn = Color(0.25, 0.26, 0.21);
    var rubber = Color(0.075, 0.09, 0.085);
    var sign = left ? -1 : 1;
    ModelTube(mesh, indices, wrist, palm, float2(0.058, 0.047), float2(0.065, 0.052), 6, fabric);
    for (var finger = 0; finger < 4; finger++)
    {
        var x = (finger - 1.5) * 0.026;
        var a = palm + float3(x, 0.025, 0.042);
        var b = palm + float3(x, -0.023, 0.076 - Math.Abs(finger - 1.5) * 0.007);
        ModelTube(mesh, indices, a - float3(0, -0.006, 0.025), a + float3(0, 0.004, 0.005),
            float2(0.015, 0.017), float2(0.014, 0.015), 5, worn);
        ModelTube(mesh, indices, a, b, float2(0.014, 0.016), float2(0.012, 0.014), 4, fabric);
        ModelTube(mesh, indices, b, b + float3(0, -0.018, -0.018), float2(0.012, 0.014), float2(0.01, 0.012), 4, rubber);
    }
    var thumb = palm + float3(sign * 0.067, -0.006, -0.025);
    ModelTube(mesh, indices, thumb, palm + float3(sign * 0.075, 0.018, 0.025),
        float2(0.021, 0.023), float2(0.017, 0.019), 5, worn);
    ModelTube(mesh, indices, wrist - float3(0, 0.025, 0.015), wrist + float3(0, 0.005, 0.018),
        float2(0.07, 0.058), float2(0.065, 0.052), 6, rubber);
}

void WeaponArms(mut List<Surface> mesh, mut List<int> indices, float3 rightPalm, float3 leftPalm)
{
    var sleeve = Color(0.31, 0.30, 0.22);
    var seam = Color(0.30, 0.29, 0.22);
    var rightWrist = rightPalm + float3(0.075, -0.13, -0.11);
    var leftWrist = leftPalm + float3(-0.105, -0.11, -0.075);
    ModelTube(mesh, indices, float3(0.49, -0.67, 0.28), rightWrist,
        float2(0.095, 0.08), float2(0.066, 0.056), 6, sleeve);
    ModelTube(mesh, indices, float3(-0.29, -0.64, 0.32), leftWrist,
        float2(0.09, 0.077), float2(0.063, 0.052), 6, sleeve);
    ModelTube(mesh, indices, rightWrist - float3(0.006, 0.018, 0.018), rightWrist + float3(0.012, 0.025, 0.012),
        float2(0.069, 0.058), float2(0.067, 0.057), 6, seam);
    ModelTube(mesh, indices, leftWrist - float3(0.015, 0.017, 0.01), leftWrist + float3(0.018, 0.025, 0.015),
        float2(0.066, 0.055), float2(0.064, 0.054), 6, seam);
    WeaponGlove(mesh, indices, rightWrist, rightPalm, false);
    WeaponGlove(mesh, indices, leftWrist, leftPalm, true);
}

void ScatterModel(mut List<Surface> mesh, mut List<int> indices)
{
    mesh.Clear(); indices.Clear();
    var steel = Color(0.28, 0.33, 0.34);
    var dark = Color(0.095, 0.115, 0.12);
    var wood = Color(0.43, 0.25, 0.13);
    // The narrow stock opens into an eight-facet break-action breech. A
    // tapered rear avoids the broad flat block that would dominate the view.
    ModelTube(mesh, indices, float3(0.245, -0.272, 0.615), float3(0.245, -0.245, 0.67),
        float2(0.05, 0.044), float2(0.063, 0.05), 8, steel);
    ModelTube(mesh, indices, float3(0.245, -0.245, 0.67), float3(0.241, -0.242, 0.865),
        float2(0.063, 0.05), float2(0.085, 0.055), 8, steel);
    WeaponBore(mesh, indices, float3(0.20, -0.225, 0.84), float3(0.20, -0.225, 1.35), 0.039, 0.027, 8, steel);
    WeaponBore(mesh, indices, float3(0.282, -0.225, 0.84), float3(0.282, -0.225, 1.35), 0.039, 0.027, 8, steel);
    ModelTube(mesh, indices, float3(0.241, -0.291, 0.875), float3(0.241, -0.285, 1.12),
        float2(0.086, 0.044), float2(0.076, 0.04), 7, wood);
    for (var i = 0; i < 4; i++)
    {
        var z = 0.91 + i * 0.052;
        ModelTube(mesh, indices, float3(0.241, -0.289, z), float3(0.241, -0.289, z + 0.009),
            float2(0.085 - i * 0.003, 0.045), float2(0.085 - i * 0.003, 0.045), 7, Color(0.25, 0.15, 0.095));
    }
    var stock = Color(0.25, 0.145, 0.08);
    ModelTube(mesh, indices, float3(0.28, -0.335, 0.45), float3(0.245, -0.276, 0.64),
        float2(0.048, 0.052), float2(0.055, 0.044), 7, stock);
    ModelTube(mesh, indices, float3(0.28, -0.335, 0.44), float3(0.279, -0.332, 0.46),
        float2(0.052, 0.056), float2(0.052, 0.056), 7, dark);
    ModelTube(mesh, indices, float3(0.25, -0.30, 0.645), float3(0.32, -0.48, 0.53),
        float2(0.045, 0.052), float2(0.042, 0.047), 6, wood);
    ModelWedge(mesh, indices, float3(0.241, -0.178, 1.015), float3(0.018, 0.011, 0.50), 0, dark);
    ModelWedge(mesh, indices, float3(0.241, -0.168, 1.29), float3(0.017, 0.019, 0.025), 0.003, Color(0.76, 0.55, 0.22));
    // Exposed locking pin, ejector and two spare brass-backed shells.
    ModelTube(mesh, indices, float3(0.168, -0.267, 0.76), float3(0.316, -0.267, 0.76),
        float2(0.012), float2(0.012), 6, Color(0.57, 0.58, 0.51));
    for (var i = 0; i < 2; i++)
    {
        var x = 0.175 + i * 0.027;
        ModelTube(mesh, indices, float3(x, -0.32, 0.65), float3(x, -0.32, 0.74),
            float2(0.011), float2(0.011), 6, Color(0.46, 0.12, 0.07));
        ModelTube(mesh, indices, float3(x, -0.32, 0.64), float3(x, -0.32, 0.66),
            float2(0.012), float2(0.012), 6, Color(0.66, 0.47, 0.19));
    }
    WeaponArms(mesh, indices, float3(0.31, -0.365, 0.565), float3(0.185, -0.36, 0.965));
}

void NailModel(mut List<Surface> mesh, mut List<int> indices)
{
    mesh.Clear(); indices.Clear();
    var oxide = Color(0.24, 0.34, 0.29);
    var dark = Color(0.09, 0.115, 0.11);
    var steel = Color(0.36, 0.39, 0.37);
    WeaponTaper(mesh, indices, float3(0.245, -0.258, 0.635), float3(0.245, -0.236, 0.89),
        float2(0.05, 0.049), float2(0.081, 0.057), oxide, dark);
    WeaponWear(mesh, indices, float3(0.245, -0.247, 0.7625), float3(0.10, 0.106, 0.255),
        0.03, Color(0.48, 0.51, 0.43));
    WeaponBore(mesh, indices, float3(0.245, -0.225, 0.88), float3(0.245, -0.225, 1.15), 0.054, 0.022, 8, steel);
    ModelTube(mesh, indices, float3(0.245, -0.225, 1.035), float3(0.245, -0.225, 1.10),
        float2(0.065), float2(0.06), 8, dark);
    // An offset nail drum gives the compact driver a different outline.
    ModelTube(mesh, indices, float3(0.32, -0.245, 0.835), float3(0.455, -0.245, 0.835),
        float2(0.08), float2(0.076), 8, Color(0.48, 0.39, 0.23));
    ModelTube(mesh, indices, float3(0.452, -0.245, 0.835), float3(0.465, -0.245, 0.835),
        float2(0.06), float2(0.06), 8, dark);
    ModelTube(mesh, indices, float3(0.255, -0.31, 0.65), float3(0.31, -0.48, 0.53),
        float2(0.05, 0.058), float2(0.045, 0.052), 6, dark);
    ModelWedge(mesh, indices, float3(0.255, -0.325, 0.89), float3(0.095, 0.075, 0.13), 0.025, dark);
    ModelWedge(mesh, indices, float3(0.245, -0.168, 0.88), float3(0.022, 0.014, 0.25), 0.012, steel);
    for (var i = 0; i < 4; i++)
    {
        var z = 0.695 + i * 0.045;
        var x = 0.245 - (0.05 + (z - 0.635) / 0.255 * 0.031) - 0.001;
        var nextX = x - 0.027 / 0.255 * 0.031;
        ModelQuad(mesh, indices, float3(x, -0.238, z), float3(nextX, -0.236, z + 0.027),
            float3(nextX, -0.214, z + 0.027), float3(x, -0.215, z), dark);
    }
    ModelTube(mesh, indices, float3(0.18, -0.205, 0.70), float3(0.16, -0.19, 0.86),
        float2(0.012), float2(0.012), 5, Color(0.65, 0.36, 0.14));
    ModelTube(mesh, indices, float3(0.16, -0.19, 0.86), float3(0.19, -0.19, 0.95),
        float2(0.012), float2(0.012), 5, Color(0.65, 0.36, 0.14));
    WeaponArms(mesh, indices, float3(0.305, -0.365, 0.57), float3(0.195, -0.36, 0.91));
}

void LauncherModel(mut List<Surface> mesh, mut List<int> indices)
{
    mesh.Clear(); indices.Clear();
    var olive = Color(0.33, 0.36, 0.23);
    var steel = Color(0.32, 0.37, 0.37);
    var dark = Color(0.095, 0.12, 0.11);
    // A seven-sided pressure tube, flared muzzle and orange safety collar.
    WeaponBore(mesh, indices, float3(0.265, -0.22, 0.72), float3(0.265, -0.22, 1.20), 0.09, 0.072, 7, olive);
    ModelTube(mesh, indices, float3(0.265, -0.22, 0.67), float3(0.265, -0.22, 0.73),
        float2(0.066), float2(0.09), 7, olive);
    ModelTube(mesh, indices, float3(0.265, -0.22, 0.79), float3(0.265, -0.22, 0.85),
        float2(0.098), float2(0.098), 7, Color(0.68, 0.42, 0.12));
    ModelTube(mesh, indices, float3(0.265, -0.22, 1.005), float3(0.265, -0.22, 1.045),
        float2(0.096), float2(0.096), 7, dark);
    WeaponBore(mesh, indices, float3(0.265, -0.22, 1.16), float3(0.265, -0.22, 1.25), 0.113, 0.072, 7, steel);
    ModelTube(mesh, indices, float3(0.265, -0.22, 0.655), float3(0.265, -0.22, 0.676),
        float2(0.063), float2(0.068), 7, dark);
    WeaponHull(mesh, indices, float3(0.275, -0.32, 0.80), float3(0.12, 0.065, 0.24), 0.025, steel);
    ModelTube(mesh, indices, float3(0.28, -0.33, 0.75), float3(0.335, -0.49, 0.59),
        float2(0.052, 0.058), float2(0.046, 0.051), 6, dark);
    // Raised bridge sight has open space below its angled struts.
    ModelTube(mesh, indices, float3(0.17, -0.14, 0.81), float3(0.17, -0.045, 0.85),
        float2(0.014), float2(0.014), 4, steel);
    ModelTube(mesh, indices, float3(0.17, -0.14, 1.06), float3(0.17, -0.045, 1.00),
        float2(0.014), float2(0.014), 4, steel);
    ModelWedge(mesh, indices, float3(0.17, -0.039, 0.925), float3(0.03, 0.018, 0.22), 0, dark);
    ModelWedge(mesh, indices, float3(0.17, -0.02, 0.98), float3(0.014, 0.03, 0.025), 0, Color(0.75, 0.58, 0.23));
    WeaponArms(mesh, indices, float3(0.33, -0.39, 0.59), float3(0.18, -0.36, 0.95));
}

void ArcModel(mut List<Surface> mesh, mut List<int> indices)
{
    mesh.Clear(); indices.Clear();
    var ceramic = Color(0.68, 0.67, 0.54);
    var dark = Color(0.10, 0.14, 0.15);
    var copper = Color(0.55, 0.31, 0.14);
    var blue = Color(0.25, 0.91, 0.86);
    WeaponTaper(mesh, indices, float3(0.25, -0.276, 0.65), float3(0.25, -0.24, 0.90),
        float2(0.06, 0.055), float2(0.105, 0.06), ceramic, dark);
    WeaponWear(mesh, indices, float3(0.25, -0.258, 0.775), float3(0.12, 0.115, 0.25),
        0.041, Color(0.42, 0.45, 0.41));
    ModelTube(mesh, indices, float3(0.25, -0.32, 0.64), float3(0.31, -0.49, 0.53),
        float2(0.055, 0.06), float2(0.048, 0.05), 6, dark);
    // Two insulated emitters form a tuning-fork silhouette, with exposed
    // copper windings and a luminous discharge gap between the tips.
    for (var i = 0; i < 2; i++)
    {
        var x = 0.155 + i * 0.19;
        ModelTube(mesh, indices, float3(x, -0.21, 0.83), float3(x, -0.21, 1.12),
            float2(0.041), float2(0.034), 6, dark);
        for (var ring = 0; ring < 5; ring++)
        {
            var z = 0.875 + ring * 0.041;
            ModelTube(mesh, indices, float3(x, -0.21, z), float3(x, -0.21, z + 0.016),
                float2(0.047), float2(0.047), 6, copper);
        }
        var tipX = x + (i == 0 ? 0.029 : -0.029);
        ModelTube(mesh, indices, float3(x, -0.21, 1.11), float3(tipX, -0.21, 1.24),
            float2(0.036), float2(0.022), 6, ceramic);
        ModelTube(mesh, indices, float3(tipX, -0.21, 1.235), float3(tipX, -0.21, 1.265),
            float2(0.025), float2(0.02), 6, blue, 8);
    }
    ModelTube(mesh, indices, float3(0.184, -0.21, 1.25), float3(0.245, -0.19, 1.25),
        float2(0.006), float2(0.006), 4, blue, 8);
    ModelTube(mesh, indices, float3(0.245, -0.19, 1.25), float3(0.316, -0.21, 1.25),
        float2(0.006), float2(0.006), 4, blue, 8);
    ModelWedge(mesh, indices, float3(0.25, -0.184, 0.82), float3(0.06, 0.015, 0.105), 0.012, dark);
    ModelWedge(mesh, indices, float3(0.25, -0.172, 0.825), float3(0.036, 0.007, 0.075), 0.008, blue, 8);
    ModelTube(mesh, indices, float3(0.18, -0.29, 0.68), float3(0.12, -0.32, 0.83),
        float2(0.015), float2(0.015), 5, copper);
    ModelTube(mesh, indices, float3(0.12, -0.32, 0.83), float3(0.16, -0.26, 0.94),
        float2(0.015), float2(0.015), 5, copper);
    WeaponArms(mesh, indices, float3(0.31, -0.37, 0.56), float3(0.17, -0.36, 0.89));
}

void PistolModel(mut List<Surface> mesh, mut List<int> indices)
{
    mesh.Clear(); indices.Clear();
    var steel = Color(0.33, 0.38, 0.39);
    var dark = Color(0.075, 0.10, 0.11);
    WeaponHull(mesh, indices, float3(0.25, -0.245, 0.79), float3(0.115, 0.10, 0.31), -0.016, steel);
    ModelWedge(mesh, indices, float3(0.25, -0.30, 0.76), float3(0.105, 0.065, 0.24), -0.02, dark);
    WeaponBore(mesh, indices, float3(0.25, -0.245, 0.89), float3(0.25, -0.245, 0.965), 0.024, 0.012, 7, Color(0.51, 0.55, 0.54));
    ModelTube(mesh, indices, float3(0.25, -0.32, 0.705), float3(0.30, -0.47, 0.59),
        float2(0.045, 0.05), float2(0.043, 0.046), 6, Color(0.23, 0.26, 0.24));
    // Open trigger bow, rear notch and a brass front blade.
    ModelTube(mesh, indices, float3(0.25, -0.32, 0.77), float3(0.25, -0.39, 0.81),
        float2(0.009), float2(0.009), 4, dark);
    ModelTube(mesh, indices, float3(0.25, -0.39, 0.81), float3(0.25, -0.40, 0.72),
        float2(0.009), float2(0.009), 4, dark);
    ModelWedge(mesh, indices, float3(0.25, -0.184, 0.68), float3(0.047, 0.022, 0.025), 0, dark);
    ModelWedge(mesh, indices, float3(0.25, -0.19, 0.925), float3(0.014, 0.025, 0.026), 0, Color(0.75, 0.58, 0.23));
    ModelQuad(mesh, indices, float3(0.19, -0.26, 0.735), float3(0.19, -0.26, 0.80),
        float3(0.19, -0.22, 0.80), float3(0.19, -0.22, 0.735), dark);
    WeaponArms(mesh, indices, float3(0.30, -0.36, 0.63), float3(0.215, -0.405, 0.66));
}

void BuildWeapons(mut Art art)
{
    ScatterModel(art.scatterMesh, art.scatterIndices);
    NailModel(art.nailMesh, art.nailIndices);
    LauncherModel(art.launcherMesh, art.launcherIndices);
    ArcModel(art.arcMesh, art.arcIndices);
    PistolModel(art.pistolMesh, art.pistolIndices);
}
