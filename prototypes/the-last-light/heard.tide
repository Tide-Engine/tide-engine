asset Clip roomTone = "sfx/room.wav";
asset Clip knocking = "sfx/knock.wav";
asset Clip oldBell = "sfx/bell.wav";
asset Clip scraping = "sfx/scrape.wav";
asset Clip paperSound = "sfx/paper.wav";
asset Clip breathing = "sfx/breath.wav";

local singleton Hearing { Sound room; Sound breath; }

view RoomSounds(Rite rite, Me me, mut Hearing hearing)
{
    hearing.room.clip = roomTone;
    hearing.room.loop = true;
    hearing.room.playing = true;
    hearing.room.volume = rite.phase == Phase.Won ? 0.18 : 0.48 + rite.act * 0.04;
    hearing.breath.clip = breathing;
    hearing.breath.loop = true;
    hearing.breath.playing = rite.phase == Phase.Vigil;
    hearing.breath.spatial = true;
    hearing.breath.position = float3(0.8, 1.5, 5.8);
    hearing.breath.volume = SeatOf(rite, me.player) == rite.active ? 0.8 : 0.28;
    Audio.SetFalloff(1.5, 30);
}

// These are match events heard once locally, including when prediction rolls back.
local event(RitualCue cue) HearRitual(Me me)
{
    bool pilgrim = me.seat == cue.active;
    if (cue.kind == 0) Audio.Play(paperSound, 0.7);
    else if (cue.kind == 1) Audio.Play(knocking, pilgrim ? 0.68 : 0.32);
    else if (cue.kind == 2) Audio.Play(oldBell, 0.38, 1.35);
    else if (cue.kind == 3) Audio.Play(scraping, pilgrim ? 0.72 : 0.4);
    else if (cue.kind == 4) Audio.Play(paperSound, 0.65, 0.76);
    else if (cue.kind == 5) Audio.Play(oldBell, 0.6, 0.7);
    else if (cue.kind == 6) Audio.Play(oldBell, 0.42);
    else if (cue.kind == 7) Audio.Play(scraping, 0.45, 0.62);
}
