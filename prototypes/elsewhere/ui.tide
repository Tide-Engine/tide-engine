local singleton Menu
{
    bool open = true;
    bool begun;
    bool looking;
    bool help;
    string code;
    string message;
    float volume = 0.7;
    float arrived;
    int realm = -1;
    bool touch;
    bool joining;
}

const Color INK = Color(0.96, 0.93, 0.81);
const Color QUIET = Color(0.72, 0.78, 0.66);
const Color GOLD = Color(0.97, 0.77, 0.43);

string PlaceName(int realm)
{
    return realm switch { 0 => "THE CONSERVATORY", 1 => "THE SUNWELL", 2 => "THE STILLWATER GARDEN", _ => "THE WHISPERING ORCHARD" };
}

string SourceName(int realm)
{
    return realm switch { 1 => "Turn the sunwheel", 2 => "Let the water flow", _ => "Wake the wind chimes" };
}

string SeedName(int seed)
{
    return seed switch { 1 => "a seed of sunlight", 2 => "a seed of stillwater", _ => "a seed of whispering wind" };
}

void Label(string text, float2 at, float size, Color tint, Anchor anchor)
{
    Draw.Text(text, at + float2(0, 1.5), size, Color(0.06, 0.10, 0.07, 0.7), anchor);
    Draw.Text(text, at, size, tint, anchor);
}

bool Choice(Rect rect, string label, bool primary)
{
    var control = GUI.Control(rect);
    var hot = control.hovered || control.focused;
    var center = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
    Draw.RoundRect(center, float2(rect.width, rect.height), 7, primary ? (hot ? Color(0.89, 0.74, 0.46) : GOLD) : Color(0.63, 0.72, 0.57, hot ? 0.22 : 0.08));
    Draw.Text(label, center, 17, primary ? Color(0.16, 0.21, 0.15) : INK, Anchor.MiddleCenter);
    return control.clicked;
}

[Before(Render)]
view ReadMenu(Devices devices, Session session, mut Menu menu, mut Hands hands, mut Optics optics)
{
    if (!menu.begun && session.state == SessionState.Connected && (session.open || !session.server))
    {
        menu.open = false;
        menu.begun = true;
    }
    if (devices.keyboard.escape.down || (menu.looking && !Cursor.locked)) menu.open = true;
    menu.looking = Cursor.locked;
    if (devices.keyboard.h.down && !menu.open) menu.help = !menu.help;
    if (devices.keyboard.f.down && !menu.open) optics.photo = !optics.photo;
    if (devices.touchscreen.touches.count > 0)
    {
        foreach (var finger in devices.touchscreen.touches) if (finger.press.pressed) menu.touch = true;
    }
    hands.playing = menu.begun && !menu.open && session.state == SessionState.Connected;
    hands.touchMove = float2(0);
    hands.touchLook = float2(0);
    hands.touchUse = false;
    if (hands.playing && menu.touch)
    {
        foreach (var finger in devices.touchscreen.touches)
        {
            var at = Screen.Flip(finger.startPosition);
            if (finger.press.pressed && at.x > Screen.width * 0.45 && at.y > 110 && at.y < Screen.height - 205)
                hands.touchLook += finger.delta * 0.004;
        }
    }
    if (hands.playing && !menu.touch) Cursor.Lock();
}

local event(Connected connected) Welcome(mut Menu menu)
{
    if (menu.joining)
    {
        menu.open = false;
        menu.begun = true;
        menu.joining = false;
    }
    menu.message = "";
}

local event(Disconnected gone) Lost(mut Menu menu, mut Hands hands)
{
    menu.open = true;
    menu.looking = false;
    hands.playing = false;
    menu.message = gone.reason == DisconnectReason.Kicked ? gone.message : "The room closed. You can begin a new garden or join again.";
}

[After(Render)]
view FrontDoor(Session session, mut Menu menu, mut Hands hands)
{
    if (!menu.open) return;
    Draw.SetScreen();
    GUI.Navigate();
    GUI.SetTheme(GUITheme { text = INK, field = Color(0.16, 0.22, 0.17), fieldHot = Color(0.23, 0.3, 0.21), accent = GOLD, radius = 7 });
    var pad = Math.Clamp(Screen.width * 0.055, 22, 80);
    var width = Math.Min(386, Screen.width - pad * 2);
    var compact = Screen.height < 650;
    var top = compact ? 28.0 : Screen.height * 0.16;
    // A quiet translucent wash leaves the live conservatory visible.
    var edge = width + pad * 2;
    Draw.Mesh([Vertex { position = float2(0, 0), color = Color(0.065, 0.12, 0.09, 0.9) },
               Vertex { position = float2(edge, 0), color = Color(0.065, 0.12, 0.09, 0.9) },
               Vertex { position = float2(edge, Screen.height), color = Color(0.065, 0.12, 0.09, 0.9) },
               Vertex { position = float2(0, Screen.height), color = Color(0.065, 0.12, 0.09, 0.9) },
               Vertex { position = float2(edge + 200, 0), color = Color(0.065, 0.12, 0.09, 0) },
               Vertex { position = float2(edge + 200, Screen.height), color = Color(0.065, 0.12, 0.09, 0) }],
              [0, 1, 2, 0, 2, 3, 1, 4, 5, 1, 5, 2]);
    Draw.Text("A WORLD WITHIN A WORLD", float2(pad, top), 11, GOLD);
    Draw.Text("Elsewhere", float2(pad - 3, top + 20), Math.Min(65, width / 5.3), INK);
    Draw.Line(float2(pad, top + 104), float2(pad + 54, top + 104), 2, GOLD);
    Draw.Text("Somewhere to get a little lost.\nSomeone to find it with.", float2(pad, top + 124), 19, QUIET);
    var buttons = top + (compact ? 190 : 214);
    if (Choice(Rect(pad, buttons, width, 47), menu.begun ? "Return to the garden" : "Begin wandering", true))
    {
        if (session.state == SessionState.Offline) Session.Start();
        menu.open = false; menu.begun = true; hands.playing = true;
        if (!menu.touch) Cursor.Lock();
    }
    if (Choice(Rect(pad, buttons + 57, width, 43), session.open ? "Copy room code" : "Invite a friend", false))
    {
        if (session.open)
        {
            Clipboard.Copy(session.room);
            menu.message = "Room code copied. A friend can join from this screen.";
        }
        else
        {
            if (session.state == SessionState.Offline) Session.Start();
            Session.Open();
            menu.message = "Opening a room...";
        }
    }
    GUI.TextField(Rect(pad, buttons + 113, width - 90, 40), "Room code", menu.code, out var entered);
    var join = Choice(Rect(pad + width - 82, buttons + 113, 82, 40), "Join", false);
    if ((join || entered) && menu.code != "")
    {
        menu.joining = true;
        Session.Join(menu.code);
        menu.message = "Finding your friend...";
    }
    var status = session.room != "" ? $"YOUR ROOM  {session.room}" : session.state == SessionState.Connecting ? "CONNECTING..." : menu.message;
    Draw.Text(status, float2(pad, buttons + 166), 13, GOLD, Anchor.UpperLeft);
    GUI.Slider(Rect(pad, buttons + 201, width, 30), "Sound", menu.volume, 0, 1);
    if (menu.begun && Choice(Rect(pad, buttons + 242, width, 34), "Begin a fresh garden together", false)) Send(BeginAgain { });
    if (!compact) Draw.Text("Three gardens. Three seeds. One place to call home.", float2(pad, Screen.height - 70), Math.Min(13, width / 35), QUIET);
    Draw.Text("WASD  wander     MOUSE  look     E  tend\nH  field guide     F  photograph     ESC  menu", float2(pad, Screen.height - 46), 11, QUIET);
}

void Marker(float3 point, string text, Optics optics)
{
    var to = point - optics.eye;
    if (Math.Dot(to, Math.Rotate(optics.turn, float3(0, 0, 1))) <= 0.5 || Math.Length(to) > 11) return;
    Draw.SetCamera(optics.eye, optics.turn, 66);
    var projected = Draw.WorldToScreen(point);
    if (projected.z < 0 || projected.x < 18 || projected.x > Screen.width - 18 || projected.y < 70 || projected.y > Screen.height - 90) return;
    Draw.SetScreen();
    Draw.Circle(projected.xy, 3, GOLD);
    Label(text, projected.xy + float2(0, 14), 12, INK, Anchor.UpperCenter);
}

[After(FrontDoor)]
view FieldGuide(Gardener person, with ownership, verified Garden garden, Session session, mut Menu menu, Optics optics, mut Hands hands)
{
    if (menu.open || !menu.begun || optics.photo) return;
    Draw.SetScreen();
    if (menu.realm != person.realm)
    {
        menu.realm = person.realm;
        menu.arrived = 4.5;
    }
    menu.arrived = Math.Max(0, menu.arrived - Frame.dt);
    var pad = Math.Clamp(Screen.width * 0.028, 18, 36);
    Label("E L S E W H E R E", float2(pad, 24), 12, INK, Anchor.UpperLeft);
    Label(PlaceName(person.realm), float2(pad, 46), 10, QUIET, Anchor.UpperLeft);
    Label($"{garden.flowers} / 3   SEEDS BROUGHT HOME", float2(Screen.width - pad, 24), 11, INK, Anchor.UpperRight);
    if (session.room != "") Label($"ROOM {session.room}", float2(Screen.width - pad, 45), 10, QUIET, Anchor.UpperRight);
    if (menu.arrived > 0 && person.realm != 0)
    {
        var opacity = Math.Min(1, menu.arrived);
        Label(PlaceName(person.realm), float2(Screen.width * 0.5, Screen.height * 0.22), Math.Min(22, Screen.width / 21), Color(0.97, 0.94, 0.82, opacity), Anchor.MiddleCenter);
    }
    if (person.realm != 0)
    {
        Marker(SourceAt() + float3(0, 2.1, 0), SourceName(person.realm), optics);
        if (!garden.harvested[person.realm - 1]) Marker(SproutAt() + float3(0, 1.5, -1.25), "The sleeping seed", optics);
    }
    else if (person.seed > 0) Marker(SocketAt(person.seed) + float3(0, 1.1, 0), "Bring this seed home", optics);
    Draw.SetScreen();
    var near = Nearby(person, garden);
    mut string action = "";
    if (near == 1) action = $"[ E ]   {SourceName(person.realm)}";
    if (near == 2)
    {
        var index = person.realm - 1;
        action = garden.growth[index] >= 1 ? "[ E ]   Take the seed" : garden.source[index] > 0 ? "HOLD  [ E ]   Tend the seed" : "Wake the source, then tend this seed";
        var width = 154.0;
        Draw.RoundRect(float2(Screen.width * 0.5, Screen.height - 98), float2(width, 3), 1.5, Color(0.15, 0.24, 0.18, 0.6));
        var amount = garden.growth[index];
        Draw.RoundRect(float2(Screen.width * 0.5 - width * (1 - amount) * 0.5, Screen.height - 98), float2(width * amount, 3), 1.5, GOLD);
    }
    if (near == 3) action = "[ E ]   Plant your seed";
    if (near == 4) action = person.sitting ? "[ E ]   Stand up" : "[ E ]   Sit a little while";
    if (action != "") Label(action, float2(Screen.width * 0.5, Screen.height - 72), Math.Min(16, Screen.width / 26), INK, Anchor.MiddleCenter);
    if (person.seed > 0)
        Label($"Carrying {SeedName(person.seed)}", float2(Screen.width * 0.5, Screen.height - 45), 12, GOLD, Anchor.MiddleCenter);
    else if (garden.flowers == 3)
        Label("You brought the garden home. Stay as long as you like.", float2(Screen.width * 0.5, Screen.height - 42), Math.Min(15, Screen.width / 32), GOLD, Anchor.MiddleCenter);
    else if (near == 0)
        Label(person.realm == 0 ? "Find a seed in each garden. Bring it home to bloom." : "Wake the source. Tend the tree. Bring its seed home.", float2(Screen.width * 0.5, Screen.height - 42), Math.Min(13, Screen.width / 36), INK, Anchor.MiddleCenter);
    Draw.Circle(float2(Screen.width * 0.5, Screen.height * 0.5), 1.5, Color(0.98, 0.94, 0.78, 0.58));
    if (menu.help)
    {
        var w = Math.Min(560, Screen.width - 40);
        var center = float2(Screen.width * 0.5, Screen.height * 0.5);
        Draw.RoundRect(center, float2(w, 254), 12, Color(0.07, 0.14, 0.10, 0.95));
        Draw.Text("A small field guide", center + float2(0, -91), 24, INK, Anchor.MiddleCenter);
        Draw.Text("Walk through the brass windows into the gardens.\nUse E by a sunwheel, spring or chime to wake it.\nThen hold E beside the tree to grow its seed.\nRelease E, take the seed, and bring it home.\n\nWith a friend, one can keep the source awake\nwhile the other tends. You can wander separately.", center + float2(-w * 0.5 + 23, -60), Math.Min(15, w / 34), QUIET);
        Draw.Text("H  close guide", center + float2(0, 107), 11, GOLD, Anchor.MiddleCenter);
    }
    if (menu.touch)
    {
        var size = Math.Min(48, Screen.width / 8);
        var left = float2(70, Screen.height - 140);
        var forward = GUI.Control(Rect(left.x - size * 0.5, left.y - size * 1.5, size, size));
        var back = GUI.Control(Rect(left.x - size * 0.5, left.y + size * 0.5, size, size));
        var l = GUI.Control(Rect(left.x - size * 1.5, left.y - size * 0.5, size, size));
        var r = GUI.Control(Rect(left.x + size * 0.5, left.y - size * 0.5, size, size));
        hands.touchMove = float2((r.pressed ? 1 : 0) - (l.pressed ? 1 : 0), (forward.pressed ? 1 : 0) - (back.pressed ? 1 : 0));
        Draw.WireCircle(left, size * 1.2, 1, Color(0.96, 0.93, 0.81, 0.4));
        Label("W", left - float2(0, size), 13, INK, Anchor.MiddleCenter);
        Label("S", left + float2(0, size), 13, INK, Anchor.MiddleCenter);
        Label("A", left - float2(size, 0), 13, INK, Anchor.MiddleCenter);
        Label("D", left + float2(size, 0), 13, INK, Anchor.MiddleCenter);
        Label("WANDER", left + float2(0, size * 1.7), 10, INK, Anchor.MiddleCenter);
        var use = GUI.Control(Rect(Screen.width - 88, Screen.height - 160, 68, 68));
        hands.touchUse = use.pressed;
        Draw.WireCircle(float2(Screen.width - 54, Screen.height - 126), 32, 1, GOLD);
        Label("TEND", float2(Screen.width - 54, Screen.height - 126), 11, INK, Anchor.MiddleCenter);
        if (Choice(Rect(Screen.width - 88, 66, 68, 32), "Menu", false)) menu.open = true;
    }
}
