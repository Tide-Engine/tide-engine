asset Clip music = "art/music.wav";
asset Clip air = "art/air.wav";
asset Clip water = "art/water.wav";
asset Clip note = "art/chime.wav";
asset Clip bloomSound = "art/bloom.wav";

local singleton Ears
{
    Sound music;
    Sound air;
    Sound water;
    int realm;
    int flowers;
    int seed;
    float noteWait;
}

[After(Render)]
view Soundscape(Optics optics, Menu menu, Garden garden, mut Ears ears)
{
    Audio.SetVolume(0, menu.volume);
    Audio.SetListener(optics.eye, optics.turn);
    ears.music.clip = music; ears.music.loop = true; ears.music.playing = true; ears.music.volume = 0.52;
    ears.air.clip = air; ears.air.loop = true; ears.air.playing = true; ears.air.volume = optics.realm == 3 ? 0.38 : 0.19;
    ears.water.clip = water; ears.water.loop = true; ears.water.playing = true; ears.water.volume = optics.realm == 2 ? 0.4 : 0.04;
    if (garden.flowers > ears.flowers) Audio.Play(bloomSound, 0.5, 0.9 + garden.flowers * 0.08);
    ears.flowers = garden.flowers;
    if (optics.realm != ears.realm && menu.begun) Audio.Play(note, 0.27, optics.realm == 2 ? 0.75 : 1.0);
    ears.realm = optics.realm;
    ears.noteWait = Math.Max(0, ears.noteWait - Frame.dt);
}

[After(Soundscape)]
view TendingSound(Gardener person, with ownership, mut Ears ears, Garden garden)
{
    if (person.seed != ears.seed && person.seed > 0) Audio.Play(note, 0.48, 1.25);
    ears.seed = person.seed;
    if (person.realm > 0 && garden.source[person.realm - 1] > 23.5 && Nearby(person, garden) == 1 && ears.noteWait <= 0)
    {
        Audio.Play(note, 0.24, person.realm == 1 ? 1 : person.realm == 2 ? 0.8 : 1.5);
        ears.noteWait = 0.8;
    }
}
