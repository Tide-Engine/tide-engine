settings
{
    title = "Elsewhere";
    tickRate = 60;
    maxPlayers = 2;
    hostMigration = true;
}

scene Main { }

singleton Garden
{
    Entity[2] people;
    PlayerID[2] players;
    int joined;
    int arrivals;
    float[3] source;
    float[3] growth;
    bool[3] harvested;
    bool[3] planted;
    int flowers;
    float finale;
}

component Gardener
{
    int seat;
    int realm;
    [Position] float3 position = float3(-2, 0, -8);
    [Rotation] float yaw;
    float pitch;
    float crossing;
    int seed;
    bool sitting;
    float walked;
}

local singleton Hands
{
    bool playing;
    float sensitivity = 0.0025;
    float2 touchMove;
    float2 touchLook;
    bool touchUse;
}

input Wander
{
    [Clamp(-1, 1)] float2 move;
    [DontPredict, Clamp(-0.3, 0.3)] float2 look;
    bool use;
    bool hurry;

    Sample(Devices devices, Hands hands)
    {
        if (!hands.playing) return;
        var keys = devices.keyboard;
        move = float2((keys.d.pressed ? 1 : 0) - (keys.a.pressed ? 1 : 0),
                      (keys.w.pressed ? 1 : 0) - (keys.s.pressed ? 1 : 0));
        move += devices.gamepad.leftStick + hands.touchMove;
        if (Cursor.locked) look = devices.mouse.delta * hands.sensitivity;
        look += devices.gamepad.rightStick * 0.035 + hands.touchLook;
        look.x += ((keys.rightArrow.pressed ? 1 : 0) - (keys.leftArrow.pressed ? 1 : 0)) * 0.025;
        look.y += ((keys.upArrow.pressed ? 1 : 0) - (keys.downArrow.pressed ? 1 : 0)) * 0.018;
        use = keys.e.pressed || devices.mouse.left.pressed || devices.gamepad.buttonWest.pressed || hands.touchUse;
        hurry = keys.leftShift.pressed || devices.gamepad.leftStickButton.pressed;
    }
}

struct Doorway
{
    float3 at;
    float3 to;
    int realm;
    float facing = -1;
}

// Each garden is its own coordinate chart. The same translation maps a
// traveller and the destination camera; no position depends on presentation.
Doorway Door(int realm, int index)
{
    if (realm == 0)
    {
        var x = (index - 1) * 7.0;
        return Doorway { at = float3(x, 1.9, index == 1 ? 10 : 6), to = float3(0, 1.9, -10), realm = index + 1 };
    }
    if (index == 0)
    {
        var from = Door(0, realm - 1);
        return Doorway { at = from.to, to = from.at, realm = 0, facing = 1 };
    }
    // A second window makes a cycle of the gardens, although their doors
    // all occupy the same coordinates. It is an actual traversable loop.
    return Doorway { at = float3(5, 1.9, 10), to = float3(0, 1.9, -10), realm = realm % 3 + 1 };
}

float3 SourceAt() { return float3(-5, 0, 1); }
float3 SproutAt() { return float3(0, 0, 5); }
float3 SocketAt(int seed) { return float3((seed - 2) * 3.0, 0, -1); }
float3 BenchAt() { return float3(6, 0, -5); }

int Nearby(Gardener person, Garden garden)
{
    if (person.realm == 0)
    {
        if (person.seed > 0 && Math.Distance(person.position, SocketAt(person.seed)) < 2.2) return 3;
        if (Math.Distance(person.position, BenchAt()) < 2.2) return 4;
        return 0;
    }
    if (Math.Distance(person.position, SourceAt()) < 2.3) return 1;
    if (Math.Distance(person.position, SproutAt()) < 2.7 && !garden.harvested[person.realm - 1]) return 2;
    return 0;
}

event(PlayerJoined joined) Arrive(mut Garden garden)
{
    for (var i = 0; i < 2; i++)
    {
        if (garden.players[i] == joined.player) return;
    }
    for (var i = 0; i < 2; i++)
    {
        if (garden.players[i] != default) continue;
        garden.players[i] = joined.player;
        garden.people[i] = Spawn(Gardener { seat = i, position = float3(i == 0 ? -2 : 2, 0, -8), yaw = i == 0 ? 0.13 : -0.13 }, Owner { player = joined.player });
        garden.joined += 1;
        garden.arrivals += 1;
        return;
    }
}

event(PlayerLeft left) Depart(mut Garden garden, World world)
{
    for (var i = 0; i < 2; i++)
    {
        if (garden.players[i] != left.player) continue;
        var person = world.Get<Gardener>(garden.people[i]);
        // A seed is never lost when its carrier leaves.
        if (person.seed > 0 && !garden.planted[person.seed - 1]) garden.harvested[person.seed - 1] = false;
        garden.people[i].Destroy();
        garden.people[i] = default;
        garden.players[i] = default;
        garden.joined = Math.Max(0, garden.joined - 1);
    }
}

system Seasons(mut Garden garden, Time time)
{
    for (var i = 0; i < 3; i++) garden.source[i] = Math.Max(0, garden.source[i] - time.dt);
    if (garden.flowers == 3) garden.finale = Math.Min(1, garden.finale + time.dt * 0.11);
}

bool Walkable(float3 p, int realm)
{
    if (Math.Abs(p.x) > 10.5 || p.z < -13 || p.z > 13) return false;
    var trunk = realm == 0 ? float3(0, 0, 3) : SproutAt();
    if (Math.Distance(p, trunk) < 1.2) return false;
    if (realm != 0 && Math.Distance(p, SourceAt()) < 0.65) return false;
    return true;
}

system Walk(Wander input, mut Gardener person, Time time)
{
    person.crossing = Math.Max(0, person.crossing - time.dt);
    person.yaw += input.look.x;
    if (person.yaw > Math.PI) person.yaw -= Math.TAU;
    if (person.yaw < -Math.PI) person.yaw += Math.TAU;
    person.pitch = Math.Clamp(person.pitch - input.look.y, -1.15, 1.15);
    if (Math.LengthSq(input.move) > 0.01) person.sitting = false;
    if (person.sitting) return;
    var move = Math.LengthSq(input.move) > 1 ? Math.Normalize(input.move) : input.move;
    var forward = float3(Math.Sin(person.yaw), 0, Math.Cos(person.yaw));
    var side = float3(forward.z, 0, -forward.x);
    var velocity = (side * move.x + forward * move.y) * (input.hurry ? 4.8 : 3.1);
    var before = person.position;
    var next = before + velocity * time.dt;
    if (Walkable(float3(next.x, 0, before.z), person.realm)) person.position.x = next.x;
    if (Walkable(float3(person.position.x, 0, next.z), person.realm)) person.position.z = next.z;
    person.walked += Math.Distance(person.position, before);
    if (person.crossing > 0) return;
    for (var i = 0; i < (person.realm == 0 ? 3 : 2); i++)
    {
        var door = Door(person.realm, i);
        if (Math.Abs(person.position.x - door.at.x) > 1.35) continue;
        if ((before.z - door.at.z) * door.facing <= 0 || (person.position.z - door.at.z) * door.facing > 0) continue;
        person.position += door.to - door.at;
        person.realm = door.realm;
        person.crossing = 0.6;
        this.Snap();
        return;
    }
}

// Source energy remains for 24 seconds: partners can tend simultaneously,
// and a lone visitor has ample time to walk from the source to the tree.
system Tend(Wander input, mut Gardener person, mut Garden garden, Time time)
{
    var nearby = Nearby(person, garden);
    if (!input.use) return;
    if (nearby == 1) garden.source[person.realm - 1] = 24;
    if (nearby == 2 && person.seed == 0)
    {
        var index = person.realm - 1;
        if (garden.source[index] > 0 && garden.growth[index] < 1)
            garden.growth[index] = Math.Min(1, garden.growth[index] + time.dt / 3.5);
        else if (garden.growth[index] >= 1 && input.use.down)
        {
            person.seed = person.realm;
            garden.harvested[index] = true;
        }
    }
    if (nearby == 3 && input.use.down)
    {
        var index = person.seed - 1;
        if (!garden.planted[index])
        {
            garden.planted[index] = true;
            garden.flowers += 1;
        }
        person.seed = 0;
    }
    if (nearby == 4 && input.use.down) person.sitting = !person.sitting;
}

command BeginAgain { }
command(BeginAgain restart, PlayerID sender) ResetGarden(mut Garden garden, mut World world)
{
    if (sender != garden.players[0] && sender != garden.players[1]) return;
    garden.source = default;
    garden.growth = default;
    garden.harvested = default;
    garden.planted = default;
    garden.flowers = 0;
    garden.finale = 0;
    for (var i = 0; i < 2; i++)
    {
        if (garden.players[i] == default) continue;
        world.Set<Gardener>(garden.people[i], Gardener { seat = i, position = float3(i == 0 ? -2 : 2, 0, -8), yaw = 0.13 });
    }
}
