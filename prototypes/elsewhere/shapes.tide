// Original procedural art. All geometry belongs to this game; no external
// models, textures or runtime hooks are required.
struct Corner
{
    float3 position;
    float3 normal;
    float3 paint;
    float kind;
}
struct Sculpture
{
    List<Corner> vertices;
    List<int> indices;
}
struct Twig
{
    float3 at;
    float3 way;
    float length;
    float radius;
}

const float3 LIMESTONE = float3(0.86, 0.82, 0.67);
const float3 BRASS = float3(0.69, 0.44, 0.18);
const float3 WOOD = float3(0.24, 0.145, 0.09);
const float3 MOSS = float3(0.26, 0.42, 0.22);

float Variation(float index) { return Math.Frac(Math.Sin(index * 127.1 + 311.7) * 43758.5453); }

void Triangle(mut Sculpture mesh, float3 a, float3 b, float3 c, float3 normal, float3 paint, float kind)
{
    var first = mesh.vertices.count;
    mesh.vertices.Add(Corner { position = a, normal = normal, paint = paint, kind = kind });
    mesh.vertices.Add(Corner { position = b, normal = normal, paint = paint, kind = kind });
    mesh.vertices.Add(Corner { position = c, normal = normal, paint = paint, kind = kind });
    mesh.indices.Add(first);
    mesh.indices.Add(first + 1);
    mesh.indices.Add(first + 2);
}

void Quad(mut Sculpture mesh, float3 a, float3 b, float3 c, float3 d, float3 normal, float3 paint, float kind)
{
    if (Math.Dot(Math.Cross(b - a, c - a), normal) > 0)
    {
        Triangle(mesh, a, b, c, normal, paint, kind);
        Triangle(mesh, a, c, d, normal, paint, kind);
    }
    else
    {
        Triangle(mesh, a, c, b, normal, paint, kind);
        Triangle(mesh, a, d, c, normal, paint, kind);
    }
}

void Block(mut Sculpture mesh, float3 at, float3 size, float3 paint, float kind)
{
    for (var i = 0; i < 6; i++)
    {
        var normal = i < 2 ? float3(i == 0 ? 1 : -1, 0, 0) : i < 4 ? float3(0, i == 2 ? 1 : -1, 0) : float3(0, 0, i == 4 ? 1 : -1);
        var side = i < 2 ? float3(0, 0, 1) : float3(1, 0, 0);
        var up = i < 2 || i > 3 ? float3(0, 1, 0) : float3(0, 0, 1);
        Quad(mesh, at + (normal - side - up) * size * 0.5, at + (normal + side - up) * size * 0.5,
                   at + (normal + side + up) * size * 0.5, at + (normal - side + up) * size * 0.5, normal, paint, kind);
    }
}

void Pebble(mut Sculpture mesh, float3 at, float3 size, float3 paint, float kind)
{
    var first = mesh.vertices.count;
    for (var ring = 0; ring <= 8; ring++)
    {
        for (var step = 0; step <= 12; step++)
        {
            var down = ring * Math.PI / 8;
            var across = step * Math.TAU / 12;
            var p = float3(Math.Sin(down) * Math.Cos(across), Math.Cos(down), Math.Sin(down) * Math.Sin(across));
            mesh.vertices.Add(Corner { position = at + p * size, normal = Math.Normalize(p / Math.Max(size, float3(0.001))), paint = paint, kind = kind });
            if (ring == 8 || step == 12) continue;
            var index = first + ring * 13 + step;
            mesh.indices.Add(index); mesh.indices.Add(index + 1); mesh.indices.Add(index + 13);
            mesh.indices.Add(index + 1); mesh.indices.Add(index + 14); mesh.indices.Add(index + 13);
        }
    }
}

void Stem(mut Sculpture mesh, float3 a, float3 b, float bottom, float top, float3 paint, float kind)
{
    var way = Math.Normalize(b - a);
    var axis = Math.Abs(way.y) > 0.9 ? float3(1, 0, 0) : float3(0, 1, 0);
    var right = Math.Normalize(Math.Cross(way, axis));
    var up = Math.Cross(right, way);
    for (var i = 0; i < 8; i++)
    {
        var f = i * Math.TAU / 8;
        var g = (i + 1) * Math.TAU / 8;
        var n = right * Math.Cos(f) + up * Math.Sin(f);
        var m = right * Math.Cos(g) + up * Math.Sin(g);
        Quad(mesh, a + n * bottom, a + m * bottom, b + m * top, b + n * top, Math.Normalize(n + m), paint, kind);
        Triangle(mesh, b, b + n * top, b + m * top, way, paint, kind);
    }
}

void Tree(mut Sculpture mesh, float3 at, float size, float3 leaves, int seed)
{
    mut List<Twig> branches = [];
    branches.Add(Twig { at = at, way = float3(0.05, 1, 0.03), length = size * 0.44, radius = size * 0.055 });
    for (var layer = 0; layer < 4; layer++)
    {
        var count = branches.count;
        for (var j = 0; j < count; j++)
        {
            var branch = branches[j];
            if (branch.length <= 0) continue;
            var end = branch.at + branch.way * branch.length;
            Stem(mesh, branch.at, end, branch.radius, branch.radius * 0.61, WOOD, 1);
            branches[j] = Twig { };
            if (layer == 3)
            {
                for (var cluster = 0; cluster < 3; cluster++)
                {
                    var v = Variation(seed + j * 13 + cluster);
                    var offset = float3(Math.Cos(v * Math.TAU), 0.25 + v * 0.5, Math.Sin(v * Math.TAU)) * size * 0.09;
                    Pebble(mesh, end + offset, float3(0.65, 0.38, 0.65) * size * (0.12 + v * 0.06), leaves * (0.78 + v * 0.35), 3);
                }
            }
            else
            {
                for (var fork = 0; fork < 3; fork++)
                {
                    var angle = fork * Math.TAU / 3 + seed * 0.73 + j * 1.91;
                    var direction = Math.Normalize(branch.way * 0.62 + float3(Math.Cos(angle) * 0.65, 0.24, Math.Sin(angle) * 0.65));
                    branches.Add(Twig { at = end, way = direction, length = branch.length * 0.66, radius = branch.radius * 0.58 });
                }
            }
        }
    }
    // Buttress roots grow into the moss rather than ending at a flat trunk.
    for (var i = 0; i < 7; i++)
    {
        var angle = i * Math.TAU / 7;
        Stem(mesh, at + float3(0, 0.7, 0), at + float3(Math.Cos(angle) * size * 0.17, 0.02, Math.Sin(angle) * size * 0.17), size * 0.037, 0.04, WOOD, 1);
    }
}

void Fern(mut Sculpture mesh, float3 at, float scale, float turn, float3 paint)
{
    for (var leaf = 0; leaf < 5; leaf++)
    {
        var a = turn + leaf * Math.TAU / 5;
        var way = float3(Math.Cos(a), 0, Math.Sin(a));
        var side = float3(-way.z, 0.1, way.x);
        var start = at + float3(0, 0.08, 0);
        for (var node = 1; node <= 5; node++)
        {
            var t = node / 5.0;
            var p = start + way * t * scale + float3(0, Math.Sin(t * Math.PI * 0.7) * scale * 0.48, 0);
            var width = Math.Sin(t * Math.PI) * 0.26 * scale + 0.015;
            Quad(mesh, p - way * 0.12 * scale, p - side * width + way * 0.05, p + way * 0.17 * scale, p + side * width + way * 0.05, float3(0, 1, 0), paint, 3);
        }
    }
}

void Arch(mut Sculpture mesh, Doorway door, float3 color)
{
    var base = door.at - float3(0, 1.9, 0);
    for (var side = -1; side <= 1; side += 2)
    {
        Block(mesh, base + float3(side * 1.62, 1.15, 0), float3(0.25, 2.3, 0.38), LIMESTONE, 0);
        Stem(mesh, base + float3(side * 1.49, 0, -0.22), base + float3(side * 1.49, 2.1, -0.22), 0.055, 0.055, color, 2);
        Pebble(mesh, base + float3(side * 1.62, 0.16, 0), float3(0.36, 0.16, 0.43), LIMESTONE, 0);
    }
    for (var i = 0; i < 20; i++)
    {
        var a = i * Math.PI / 20;
        var b = (i + 1) * Math.PI / 20;
        var p = base + float3(Math.Cos(a) * 1.6, 2.1 + Math.Sin(a) * 1.8, 0);
        var q = base + float3(Math.Cos(b) * 1.6, 2.1 + Math.Sin(b) * 1.8, 0);
        Stem(mesh, p, q, 0.13, 0.13, LIMESTONE, 0);
        Stem(mesh, p + float3(0, 0, -0.2), q + float3(0, 0, -0.2), 0.035, 0.035, color, 2);
    }
    Block(mesh, base + float3(0, -0.04, 0), float3(3.6, 0.08, 0.85), LIMESTONE, 0);
    for (var i = 0; i < 8; i++) Fern(mesh, base + float3(1.9, i * 0.38, 0), 0.32, i * 1.3, MOSS);
}

float3 RealmLeaves(int realm)
{
    return realm == 2 ? float3(0.23, 0.51, 0.52) : realm == 3 ? float3(0.73, 0.34, 0.33) : float3(0.35, 0.52, 0.20);
}

Sculpture MakeGarden(int realm)
{
    mut Sculpture mesh = default;
    var leaves = RealmLeaves(realm);
    // A continuous, safe terrace on a root-bound island suspended in clouds.
    Block(mesh, float3(0, -0.34, 0), float3(23, 0.65, 29), LIMESTONE, 0);
    Pebble(mesh, float3(0, -2.2, 0), float3(12.7, 2.2, 15.7), float3(0.29, 0.32, 0.24), 0);
    for (var i = 0; i < 32; i++)
    {
        var angle = i * Math.TAU / 32;
        var p = float3(Math.Cos(angle) * 12, -1.2, Math.Sin(angle) * 15);
        Stem(mesh, p, p * float3(0.7, 1, 0.7) - float3(0, 3 + Variation(i) * 3, 0), 0.24, 0.025, WOOD, 1);
    }
    for (var i = 0; i < 90; i++)
    {
        var x = (Variation(i * 3 + realm * 93) - 0.5) * 21;
        var z = (Variation(i * 5 + 49) - 0.5) * 26;
        if (Math.Abs(x) < 4 || Math.Abs(z + 10) < 1.6 || Math.Abs(z - 6) < 1.4) continue;
        Pebble(mesh, float3(x, 0.08, z), float3(0.6, 0.09, 0.9), leaves * 0.56, 3);
        Fern(mesh, float3(x, 0.1, z), 0.45 + Variation(i) * 0.6, i * 2.4, leaves);
    }
    for (var i = 0; i < 1600; i++)
    {
        var x = (Variation(i * 3 + 27) - 0.5) * 21.5;
        var z = (Variation(i * 7 + realm * 55) - 0.5) * 27;
        if (Math.Abs(x) < 3.8 || (Math.Abs(x - 7) < 1.6 && z > 2 && z < 8) || (Math.Abs(x + 7) < 1.6 && z > 2 && z < 8)) continue;
        var h = 0.12 + Variation(i * 9) * 0.31;
        Triangle(mesh, float3(x - 0.026, 0.02, z), float3(x + 0.026, 0.02, z), float3(x + 0.06, h, z + 0.08), float3(0, 0.7, -0.7), leaves * (0.6 + Variation(i) * 0.5), 3);
    }
    Tree(mesh, realm == 0 ? float3(0, 0, 3) : SproutAt(), realm == 0 ? 7.4 : 8.7, leaves, realm + 3);
    Tree(mesh, float3(-8.7, 0, -6.4), 4.2, leaves, 41 + realm);
    Tree(mesh, float3(9, 0, 8.8), 4.8, leaves, 71 + realm);
    // Sunken beds, small blossoms and hanging vines give the empty terrace
    // the density of a tended place. The paths and window mouths stay clear.
    for (var bed = 0; bed < 6; bed++)
    {
        var at = float3(bed < 3 ? -8.8 : 8.8, 0, -9 + (bed % 3) * 7.5);
        Block(mesh, at + float3(0, 0.05, 0), float3(3.2, 0.15, 3.8), WOOD, 1);
        Block(mesh, at + float3(0, 0.14, 0), float3(2.9, 0.08, 3.5), MOSS * 0.4, 0);
        for (var plant = 0; plant < 22; plant++)
        {
            var p = at + float3((Variation(plant + bed * 36) - 0.5) * 2.5, 0.21, (Variation(plant * 13 + bed) - 0.5) * 3.2);
            Fern(mesh, p, 0.5 + Variation(plant * 7) * 0.7, plant * 2.4, leaves * 0.88);
            var flower = realm == 2 ? float3(0.56, 0.72, 0.91) : realm == 3 ? float3(0.98, 0.59, 0.54) : float3(0.94, 0.76, 0.47);
            var tip = p + float3(0, 0.36 + Variation(plant) * 0.45, 0);
            Stem(mesh, p, tip, 0.018, 0.012, MOSS, 3);
            for (var petal = 0; petal < 5; petal++)
            {
                var a = petal * Math.TAU / 5;
                Pebble(mesh, tip + float3(Math.Cos(a) * 0.09, 0, Math.Sin(a) * 0.09), float3(0.08, 0.035, 0.08), flower, 6);
            }
        }
    }
    if (realm == 0)
    {
        for (var vine = 0; vine < 16; vine++)
        {
            var start = float3(vine < 8 ? -7.5 : 7.5, 7.9, -11 + (vine % 8) * 3.1);
            var length = 1.3 + Variation(vine) * 2.1;
            for (var node = 0; node < 12; node++)
            {
                var p = start - float3(Math.Sin(node * 0.6) * 0.13, node / 12.0 * length, 0);
                Stem(mesh, p, p - float3(0, length / 12, 0), 0.016, 0.015, MOSS, 3);
                Pebble(mesh, p + float3(node % 2 == 0 ? -0.11 : 0.11, -0.04, 0), float3(0.13, 0.055, 0.08), leaves * 0.84, 3);
            }
        }
    }
    // Distant terrariums repeat at three scales. These are scenery; the
    // traversable impossible connections are the windows themselves.
    for (var i = 0; i < 10; i++)
    {
        var angle = i * 2.39996 + realm;
        var distance = 36 + i * 14.0;
        var p = float3(Math.Cos(angle) * distance, -8 + Variation(i + 97) * 23, Math.Sin(angle) * distance);
        var size = 4.5 + Variation(i * 13) * 7;
        for (var puff = 0; puff < 5; puff++)
        {
            var cloud = p + float3((puff - 2) * size * 0.7, -8 - Math.Sin(puff) * size * 0.2, -size * 0.3);
            Pebble(mesh, cloud, float3(size * 1.2, size * 0.35, size), float3(0.98, 0.95, 0.87), 8);
        }
        Pebble(mesh, p - float3(0, size * 0.4, 0), float3(size, size * 0.4, size), float3(0.42, 0.44, 0.35), 0);
        Tree(mesh, p, size * 0.8, leaves, i + 109);
        for (var ring = 0; ring < 30; ring++)
        {
            var a = ring * Math.TAU / 30;
            var b = (ring + 1) * Math.TAU / 30;
            Stem(mesh, p + float3(Math.Cos(a) * size * 1.2, Math.Sin(a) * size * 1.2 + size, 0),
                       p + float3(Math.Cos(b) * size * 1.2, Math.Sin(b) * size * 1.2 + size, 0), 0.035, 0.035, BRASS, 2);
        }
    }
    for (var i = 0; i < (realm == 0 ? 3 : 2); i++) Arch(mesh, Door(realm, i), BRASS);
    if (realm == 0)
    {
        // Tall brass-and-glass conservatory ribs, traced as true curved tubes.
        for (var rib = 0; rib < 8; rib++)
        {
            var z = -13.4 + rib * 3.85;
            for (var segment = 0; segment < 24; segment++)
            {
                var a = segment * Math.PI / 24;
                var b = (segment + 1) * Math.PI / 24;
                var p = float3(Math.Cos(a) * 11.3, 2.7 + Math.Sin(a) * 7.2, z);
                var q = float3(Math.Cos(b) * 11.3, 2.7 + Math.Sin(b) * 7.2, z);
                Stem(mesh, p, q, 0.07, 0.07, BRASS, 2);
            }
            for (var side = -1; side <= 1; side += 2)
                Stem(mesh, float3(side * 11.3, 0, z), float3(side * 11.3, 2.7, z), 0.09, 0.09, BRASS, 2);
        }
        for (var rail = 0; rail < 7; rail++)
        {
            var angle = (rail + 1) * Math.PI / 8;
            Stem(mesh, float3(Math.Cos(angle) * 11.3, 2.7 + Math.Sin(angle) * 7.2, -13.4),
                       float3(Math.Cos(angle) * 11.3, 2.7 + Math.Sin(angle) * 7.2, 13.6), 0.04, 0.04, BRASS, 2);
        }
        for (var i = 1; i <= 3; i++)
        {
            var at = SocketAt(i);
            Pebble(mesh, at + float3(0, 0.17, 0), float3(0.65, 0.17, 0.65), LIMESTONE, 0);
            Pebble(mesh, at + float3(0, 0.3, 0), float3(0.43, 0.14, 0.43), WOOD, 1);
        }
        var bench = BenchAt();
        Block(mesh, bench + float3(0, 0.45, 0), float3(2.8, 0.16, 0.7), WOOD, 1);
        Block(mesh, bench + float3(0, 0.83, 0.34), float3(2.8, 0.63, 0.1), WOOD, 1);
        for (var side = -1; side <= 1; side += 2)
            Block(mesh, bench + float3(side * 1.15, 0.23, 0), float3(0.13, 0.46, 0.6), BRASS, 2);
    }
    else
    {
        var source = SourceAt();
        Pebble(mesh, source + float3(0, 0.35, 0), float3(0.7, 0.35, 0.7), LIMESTONE, 0);
        Stem(mesh, source + float3(0, 0.3, 0), source + float3(0, 1.35, 0), 0.17, 0.12, BRASS, 2);
        Pebble(mesh, source + float3(0, 1.5, 0), float3(0.37), BRASS, 2);
        Pebble(mesh, SproutAt() + float3(0, 0.16, 0), float3(1.65, 0.16, 1.65), LIMESTONE, 0);
        if (realm == 1)
        {
            // A monumental three-ring sun instrument rises behind the tree.
            // Its lowest parts stay above the walking paths.
            for (var ring = 0; ring < 3; ring++)
            {
                var rotation = quaternion.Euler(0, ring * 0.35, (ring - 1) * 0.18);
                var center = float3(0, 6.2, 8.2);
                for (var segment = 0; segment < 64; segment++)
                {
                    var a = segment * Math.TAU / 64;
                    var b = (segment + 1) * Math.TAU / 64;
                    var radius = 4.2 + ring * 0.36;
                    var p = Math.Rotate(rotation, float3(Math.Cos(a) * radius, Math.Sin(a) * radius, 0));
                    var q = Math.Rotate(rotation, float3(Math.Cos(b) * radius, Math.Sin(b) * radius, 0));
                    Stem(mesh, center + p, center + q, 0.047, 0.047, BRASS * 1.2, 2);
                    if (segment % 8 == 0) Pebble(mesh, center + p, float3(0.13), float3(0.97, 0.76, 0.36), 5);
                }
            }
            // A heliostat ring, with a suspended lens and ornamental sun spokes.
            for (var i = 0; i < 32; i++)
            {
                var a = i * Math.TAU / 32;
                var b = (i + 1) * Math.TAU / 32;
                Stem(mesh, source + float3(Math.Cos(a) * 1.12, 1.6 + Math.Sin(a) * 1.12, 0), source + float3(Math.Cos(b) * 1.12, 1.6 + Math.Sin(b) * 1.12, 0), 0.045, 0.045, BRASS, 2);
            }
        }
        if (realm == 2)
        {
            for (var i = 0; i < 11; i++)
            {
                var at = float3(6.5 + Math.Sin(i * 2.4) * 2.2, 0.15, -3 + Math.Cos(i * 2.4) * 2.7);
                for (var petal = 0; petal < 5; petal++)
                {
                    var a = petal * Math.TAU / 5;
                    Pebble(mesh, at + float3(Math.Cos(a) * 0.13, 0, Math.Sin(a) * 0.13), float3(0.13, 0.06, 0.13), float3(0.66, 0.82, 0.9), 6);
                }
            }
            Pebble(mesh, float3(6.5, 0.035, -3), float3(3, 0.035, 4), float3(0.09, 0.35, 0.43), 4);
            for (var i = 0; i < 48; i++)
            {
                var a = i * Math.TAU / 48;
                var b = (i + 1) * Math.TAU / 48;
                Stem(mesh, float3(6.5 + Math.Cos(a) * 3.1, 0.08, -3 + Math.Sin(a) * 4.1),
                           float3(6.5 + Math.Cos(b) * 3.1, 0.08, -3 + Math.Sin(b) * 4.1), 0.06, 0.06, LIMESTONE, 0);
            }
            Block(mesh, float3(-5, 0.025, 5), float3(0.5, 0.04, 8), float3(0.12, 0.47, 0.52), 4);
            Block(mesh, float3(-2.5, 0.025, 8.75), float3(5.5, 0.04, 0.5), float3(0.12, 0.47, 0.52), 4);
            for (var i = 0; i < 14; i++)
                Pebble(mesh, float3(-7 + Math.Cos(i * 0.8) * 0.3, 0.25, -8 + i * 1.3), float3(0.6, 0.25, 0.9), float3(0.35, 0.46, 0.49), 0);
        }
        if (realm == 3)
        {
            // Rosewood pergolas lead beneath the hanging lanterns, making
            // this garden a sheltered orchard rather than another terrace.
            for (var arch = 0; arch < 4; arch++)
            {
                var z = -5 + arch * 4.0;
                for (var segment = 0; segment < 24; segment++)
                {
                    var a = segment * Math.PI / 24;
                    var b = (segment + 1) * Math.PI / 24;
                    var p = float3(Math.Cos(a) * 7.4, 2.2 + Math.Sin(a) * 3.1, z);
                    var q = float3(Math.Cos(b) * 7.4, 2.2 + Math.Sin(b) * 3.1, z);
                    Stem(mesh, p, q, 0.095, 0.095, WOOD, 1);
                    if (segment % 3 == 0) Pebble(mesh, p + float3(0, 0.13, 0), float3(0.45, 0.17, 0.36), leaves, 3);
                }
                for (var side = -1; side <= 1; side += 2)
                    Stem(mesh, float3(side * 7.4, 0, z), float3(side * 7.4, 2.2, z), 0.11, 0.1, WOOD, 1);
            }
            for (var i = 0; i < 9; i++)
            {
                var p = float3(-7 + i * 1.8, 4.3 + Math.Sin(i) * 0.6, 4);
                Stem(mesh, p + float3(0, 1.8, 0), p, 0.018, 0.018, BRASS, 2);
                Pebble(mesh, p, float3(0.16, 0.55, 0.16), float3(1, 0.67, 0.31), 5);
            }
        }
    }
    // Rails are low and airy. Collision follows the continuous terrace inset.
    for (var side = -1; side <= 1; side += 2)
    {
        Stem(mesh, float3(side * 11.2, 0.72, -13.7), float3(side * 11.2, 0.72, 13.7), 0.035, 0.035, BRASS, 2);
        for (var i = 0; i < 14; i++) Stem(mesh, float3(side * 11.2, 0, -13 + i * 2), float3(side * 11.2, 0.72, -13 + i * 2), 0.025, 0.025, BRASS, 2);
    }
    return mesh;
}

Sculpture MakePerson()
{
    mut Sculpture mesh = default;
    Pebble(mesh, float3(0, 0.64, 0), float3(0.27, 0.5, 0.23), float3(0.58, 0.69, 0.49), 6);
    Pebble(mesh, float3(0, 1.28, 0), float3(0.24, 0.25, 0.23), float3(0.95, 0.9, 0.73), 6);
    Pebble(mesh, float3(0, 1.48, 0), float3(0.39, 0.055, 0.35), float3(0.73, 0.55, 0.24), 1);
    Pebble(mesh, float3(0, 1.56, 0), float3(0.24, 0.14, 0.23), float3(0.73, 0.55, 0.24), 1);
    for (var side = -1; side <= 1; side += 2)
    {
        Stem(mesh, float3(side * 0.24, 0.95, 0), float3(side * 0.34, 0.43, 0.06), 0.09, 0.065, float3(0.58, 0.69, 0.49), 6);
        Pebble(mesh, float3(side * 0.12, 0.13, 0.07), float3(0.11, 0.14, 0.22), WOOD, 1);
        Pebble(mesh, float3(side * 0.075, 1.29, 0.214), float3(0.032, 0.05, 0.02), WOOD, 1);
    }
    return mesh;
}
