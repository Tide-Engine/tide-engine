using Rooms;

settings
{
    title = "Inside Out";
    tickRate = 30;
    maxPlayers = 2;
    hostMigration = true;
}

const int MAX_ROOMS = 4;
const int MAX_CRATES = 8;
const int MAX_REFERENCES = 4;
const int MAX_BOXES = 8;
const int MAX_DEPTH = 8;
const int LEVEL_COUNT = 12;
const int UNDO_LIMIT = 128;

enum Tile { Floor, Wall, Target, Exit }
struct RoomLayout
{
    Tile[49] tiles;
    int width = 5;
    int height = 5;
    int doors;
    int north = -1;
    int east = -1;
    int south = -1;
    int west = -1;
    int2 dock = int2(-1);
    int dockRoom = -1;
}
struct ReferenceLayout
{
    int destination;
}
struct LevelLayout
{
    Tile[49] tiles;
    int width = 7;
    int height = 7;
    RoomLayout[4] rooms;
    ReferenceLayout[4] references;
    int roomCount;
    int crateCount;
    int referenceCount;
}
struct Entry
{
    int box = -1;
}
struct Traveler
{
    int room = -1;
    int2 position;
    Entry[8] trail;
    int depth;
}
struct RoomShell { int room = -1; int2 position; }
struct Cargo { int room = -1; int2 position; bool active; }
struct Puzzle
{
    Traveler[2] actors;
    RoomShell[4] rooms;
    RoomShell[4] references;
    Cargo[8] crates;
    int moves;
    bool solved;
}
singleton Workshop
{
    LevelLayout layout;
    Puzzle puzzle;
    Puzzle[128] history;
    int historyCount;
    int level;
    int serial;
    int completed;
    bool initialized;
    Map<PlayerID, int> seats;
    PlayerID[2] players;
    bool[2] present;
}

scene Main { }
event PuzzleCue { int kind; int seat; int direction = -1; Traveler source; }
command Move { int serial; int direction; }
command Undo { int serial; }
command Reset { int serial; }
command Next { int serial; }
command ChooseLevel { int serial; int level; }

int SeatOf(Workshop workshop, PlayerID player)
{
    if (!workshop.seats.Has(player)) return -1;
    var seat = workshop.seats[player];
    return seat >= 0 && seat < 2 && workshop.present[seat] ? seat : -1;
}
bool Together(Workshop workshop) { return workshop.present[0] && workshop.present[1]; }
bool CellEqual(int2 a, int2 b) { return a.x == b.x && a.y == b.y; }
int CellIndex(int2 at, int size) { return at.y * size + at.x; }
int RoomWidth(LevelLayout layout, int room)
{
    return Math.Clamp(room == -1 ? layout.width : layout.rooms[room].width, 1, 7);
}
int RoomHeight(LevelLayout layout, int room)
{
    return Math.Clamp(room == -1 ? layout.height : layout.rooms[room].height, 1, 7);
}
bool OnRoomGrid(LevelLayout layout, int room, int2 at)
{
    return (room == -1 || ValidRoom(layout, room)) && at.x >= 0 && at.y >= 0 && at.x < RoomWidth(layout, room) && at.y < RoomHeight(layout, room);
}
float2 RoomCenter(LevelLayout layout, int room)
{
    return float2(RoomWidth(layout, room) - 1, RoomHeight(layout, room) - 1) * 0.5;
}
int2 Direction(int direction)
{
    if (direction == 0) return int2(0, -1);
    if (direction == 1) return int2(1, 0);
    if (direction == 2) return int2(0, 1);
    if (direction == 3) return int2(-1, 0);
    return int2(0);
}
int2 DoorCell(LevelLayout layout, int room, int direction)
{
    if (direction < 0 || direction > 3 || (room != -1 && !ValidRoom(layout, room))) return int2(-1);
    var width = RoomWidth(layout, room);
    var height = RoomHeight(layout, room);
    mut var offset = -1;
    if (room >= 0)
    {
        if (direction == 0) offset = layout.rooms[room].north;
        else if (direction == 1) offset = layout.rooms[room].east;
        else if (direction == 2) offset = layout.rooms[room].south;
        else offset = layout.rooms[room].west;
    }
    var length = direction % 2 == 0 ? width : height;
    if (offset == -1) offset = length / 2;
    if (offset < 0 || offset >= length) return int2(-1);
    if (direction == 0) return int2(offset, 0);
    if (direction == 1) return int2(width - 1, offset);
    if (direction == 2) return int2(offset, height - 1);
    return int2(0, offset);
}
bool ValidRoom(LevelLayout layout, int room)
{
    return room >= 0 && room < layout.roomCount && room < MAX_ROOMS;
}
bool ValidBox(LevelLayout layout, int box)
{
    return box >= 0 && (box < MAX_ROOMS ? ValidRoom(layout, box) : box < MAX_BOXES && box - MAX_ROOMS < layout.referenceCount);
}
int BoxDestination(LevelLayout layout, int box)
{
    if (!ValidBox(layout, box)) return -2;
    return box < MAX_ROOMS ? box : layout.references[box - MAX_ROOMS].destination;
}
RoomShell BoxPlacement(LevelLayout layout, Puzzle puzzle, int box)
{
    if (!ValidBox(layout, box)) return RoomShell { };
    return box < MAX_ROOMS ? puzzle.rooms[box] : puzzle.references[box - MAX_ROOMS];
}
int BoxAt(LevelLayout layout, Puzzle puzzle, int parent, int2 at)
{
    for (var box = 0; box < MAX_BOXES; box++)
    {
        if (!ValidBox(layout, box)) continue;
        var placement = BoxPlacement(layout, puzzle, box);
        if (placement.room == parent && CellEqual(placement.position, at)) return box;
    }
    return -1;
}
int ActorAt(Puzzle puzzle, int room, int2 at)
{
    for (var seat = 0; seat < 2; seat++)
        if (puzzle.actors[seat].room == room && CellEqual(puzzle.actors[seat].position, at)) return seat;
    return -1;
}
int CargoAt(LevelLayout layout, Puzzle puzzle, int room, int2 at)
{
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && puzzle.crates[crate].room == room && CellEqual(puzzle.crates[crate].position, at)) return crate;
    return -1;
}
Tile TileAt(LevelLayout layout, int room, int2 at)
{
    if (!OnRoomGrid(layout, room, at)) return Tile.Wall;
    var index = CellIndex(at, RoomWidth(layout, room));
    return room == -1 ? layout.tiles[index] : layout.rooms[room].tiles[index];
}
bool EmptyCell(LevelLayout layout, Puzzle puzzle, int room, int2 at)
{
    return TileAt(layout, room, at) != Tile.Wall && BoxAt(layout, puzzle, room, at) < 0 && CargoAt(layout, puzzle, room, at) < 0 && ActorAt(puzzle, room, at) < 0;
}

// Objects exit through their containing room's physical shell. Travelers
// instead return through the particular doorway in their finite entry trail.
bool PhysicalStep(LevelLayout layout, Puzzle puzzle, int room, int2 from, int direction, out int nextRoom, out int2 next)
{
    nextRoom = room;
    next = from + Direction(direction);
    if (direction < 0 || direction > 3) return false;
    if (OnRoomGrid(layout, room, next)) return TileAt(layout, room, next) != Tile.Wall;
    if (!ValidRoom(layout, room) || !CellEqual(from, DoorCell(layout, room, direction)) || (layout.rooms[room].doors & (1 << direction)) == 0) return false;
    nextRoom = puzzle.rooms[room].room;
    next = puzzle.rooms[room].position + Direction(direction);
    return TileAt(layout, nextRoom, next) != Tile.Wall;
}

// Resolve one doorway only. Occupied destination doorways block instead of
// silently following an unbounded chain of recursive references.
bool Gateway(LevelLayout layout, Puzzle puzzle, int room, int2 at, int direction, out int destination, out int2 entry, out Entry trail)
{
    destination = room;
    entry = at;
    trail = Entry { };
    var box = BoxAt(layout, puzzle, room, at);
    if (!ValidBox(layout, box)) return false;
    var opposite = (direction + 2) % 4;
    destination = BoxDestination(layout, box);
    trail = Entry { box = box };
    if (!ValidRoom(layout, destination) || (layout.rooms[destination].doors & (1 << opposite)) == 0) return false;
    entry = DoorCell(layout, destination, opposite);
    return TileAt(layout, destination, entry) != Tile.Wall;
}
// Twice a doorway's distance along its wall from the middle of the box, in
// cells of that room. Scaled by the other room's longest edge, two of these
// compare exactly in the containing cell both boxes fill.
int DoorReach(LevelLayout layout, int room, int direction)
{
    var cell = DoorCell(layout, room, direction);
    return direction % 2 == 0 ? cell.x * 2 - (RoomWidth(layout, room) - 1) : cell.y * 2 - (RoomHeight(layout, room) - 1);
}
int RoomSpan(LevelLayout layout, int room) { return Math.Max(RoomWidth(layout, room), RoomHeight(layout, room)); }

// Two boxes side by side connect only where their open doorways physically
// face each other at the same place along the shared edge.
bool DoorsMeet(LevelLayout layout, int from, int direction, int to)
{
    var opposite = (direction + 2) % 4;
    if (direction < 0 || direction > 3 || !ValidRoom(layout, from) || !ValidRoom(layout, to)) return false;
    if ((layout.rooms[from].doors & (1 << direction)) == 0 || (layout.rooms[to].doors & (1 << opposite)) == 0) return false;
    if (DoorCell(layout, from, direction).x < 0 || DoorCell(layout, to, opposite).x < 0) return false;
    return DoorReach(layout, from, direction) * RoomSpan(layout, to) == DoorReach(layout, to, opposite) * RoomSpan(layout, from);
}

bool ObjectDestination(LevelLayout layout, Puzzle puzzle, int room, int2 from, int direction, out int nextRoom, out int2 next)
{
    if (!PhysicalStep(layout, puzzle, room, from, direction, out nextRoom, out next)) return false;
    var box = BoxAt(layout, puzzle, nextRoom, next);
    if (box >= 0)
    {
        // Leaving one box straight into its neighbor needs facing doorways;
        // from the open floor an object is carried to whichever doorway faces it.
        if (!OnRoomGrid(layout, room, from + Direction(direction)) && !DoorsMeet(layout, room, direction, BoxDestination(layout, box))) return false;
        if (!Gateway(layout, puzzle, nextRoom, next, direction, out var destination, out var entry, out _)) return false;
        nextRoom = destination;
        next = entry;
    }
    return EmptyCell(layout, puzzle, nextRoom, next);
}
bool PushCargo(LevelLayout layout, mut Puzzle puzzle, int crate, int direction)
{
    if (crate < 0 || crate >= layout.crateCount || crate >= MAX_CRATES || !puzzle.crates[crate].active) return false;
    var item = puzzle.crates[crate];
    if (!ObjectDestination(layout, puzzle, item.room, item.position, direction, out var room, out var next)) return false;
    puzzle.crates[crate].room = room;
    puzzle.crates[crate].position = next;
    return true;
}
bool PushBox(LevelLayout layout, mut Puzzle puzzle, int box, int direction)
{
    if (!ValidBox(layout, box) || !ValidRoom(layout, BoxDestination(layout, box))) return false;
    var placement = BoxPlacement(layout, puzzle, box);
    if (!ObjectDestination(layout, puzzle, placement.room, placement.position, direction, out var room, out var next)) return false;
    if (box < MAX_ROOMS)
    {
        puzzle.rooms[box].room = room;
        puzzle.rooms[box].position = next;
    }
    else
    {
        puzzle.references[box - MAX_ROOMS].room = room;
        puzzle.references[box - MAX_ROOMS].position = next;
    }
    return true;
}
bool TravelerStep(LevelLayout layout, Puzzle puzzle, Traveler actor, int direction, out int room, out int2 next, out int depth)
{
    room = actor.room;
    next = actor.position + Direction(direction);
    depth = actor.depth;
    if (OnRoomGrid(layout, room, next)) return TileAt(layout, room, next) != Tile.Wall;
    if (!ValidRoom(layout, room) || depth <= 0 || depth > MAX_DEPTH || !CellEqual(actor.position, DoorCell(layout, room, direction)) || (layout.rooms[room].doors & (1 << direction)) == 0) return false;
    var back = actor.trail[depth - 1];
    if (!ValidBox(layout, back.box)) return false;
    var placement = BoxPlacement(layout, puzzle, back.box);
    room = placement.room;
    next = placement.position + Direction(direction);
    depth -= 1;
    return TileAt(layout, room, next) != Tile.Wall;
}

int EntryDestination(LevelLayout layout, Entry entry)
{
    return BoxDestination(layout, entry.box);
}
bool RebaseTrail(LevelLayout layout, Puzzle puzzle, mut Traveler actor, int room, int depth)
{
    actor.depth = depth;
    if (room == -1) actor.depth = 0;
    else if (depth == 0 || EntryDestination(layout, actor.trail[depth - 1]) != room)
    {
        // Changed box parentage invalidates an old prefix. Rebuild the
        // canonical primary ancestry; a genuine cycle contributes each
        // room once and never invents a containing outer room.
        mut int[4] ancestors = default;
        mut var count = 0;
        mut var parent = room;
        while (parent != -1)
        {
            if (!ValidRoom(layout, parent)) return false;
            mut var repeated = false;
            for (var prior = 0; prior < count; prior++)
                if (ancestors[prior] == parent) repeated = true;
            if (repeated) break;
            if (count >= MAX_ROOMS) return false;
            ancestors[count] = parent;
            count += 1;
            parent = puzzle.rooms[parent].room;
        }
        actor.depth = count;
        for (var step = 0; step < count; step++) actor.trail[count - step - 1] = Entry { box = ancestors[step] };
    }
    for (var entry = actor.depth; entry < MAX_DEPTH; entry++) actor.trail[entry] = Entry { };
    return true;
}

bool IsSolved(LevelLayout layout, Puzzle puzzle)
{
    for (var seat = 0; seat < 2; seat++)
        if (TileAt(layout, puzzle.actors[seat].room, puzzle.actors[seat].position) != Tile.Exit) return false;
    if (puzzle.actors[0].room == puzzle.actors[1].room && CellEqual(puzzle.actors[0].position, puzzle.actors[1].position)) return false;
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && TileAt(layout, puzzle.crates[crate].room, puzzle.crates[crate].position) != Tile.Target) return false;
    var outerWidth = RoomWidth(layout, -1);
    for (var cell = 0; cell < outerWidth * RoomHeight(layout, -1); cell++)
        if (layout.tiles[cell] == Tile.Target && CargoAt(layout, puzzle, -1, int2(cell % outerWidth, cell / outerWidth)) < 0) return false;
    for (var room = 0; room < Math.Min(MAX_ROOMS, layout.roomCount); room++)
    {
        var dock = layout.rooms[room].dock;
        if (dock.x >= 0 && (puzzle.rooms[room].room != layout.rooms[room].dockRoom || !CellEqual(puzzle.rooms[room].position, dock))) return false;
        var width = RoomWidth(layout, room);
        for (var cell = 0; cell < width * RoomHeight(layout, room); cell++)
            if (layout.rooms[room].tiles[cell] == Tile.Target && CargoAt(layout, puzzle, room, int2(cell % width, cell / width)) < 0) return false;
    }
    return true;
}
// What one step does: the move handler applies it, and each screen asks the
// same question of a copy to show its own dummy what a direction will do.
enum Step { Blocked, Walk, Push, Enter }
bool MovePuzzle(LevelLayout layout, mut Puzzle puzzle, int seat, int direction, out Step step)
{
    step = Step.Blocked;
    if (puzzle.solved || seat < 0 || seat > 1 || direction < 0 || direction > 3) return false;
    mut var trial = puzzle;
    mut var actor = trial.actors[seat];
    if (actor.depth < 0 || actor.depth > MAX_DEPTH) return false;
    if (!TravelerStep(layout, trial, actor, direction, out mut var room, out mut var next, out mut var depth)) return false;
    var leaving = depth < actor.depth;
    var source = actor.room;
    if (leaving)
    {
        if (!RebaseTrail(layout, trial, actor, room, depth)) return false;
        trial.actors[seat] = actor;
        depth = actor.depth;
    }
    var box = BoxAt(layout, trial, room, next);
    mut var pushed = false;
    mut var entered = false;
    // Facing doorways are one passage for dummies, parcels and boxes alike:
    // a dummy walks straight through instead of pushing the neighbor.
    var meets = leaving && box >= 0 && DoorsMeet(layout, source, direction, BoxDestination(layout, box));
    if (box >= 0 && !meets)
    {
        // A physical room moves whenever its destination is available. If
        // pushing fails, doorway entry starts from the unchanged candidate.
        mut var pushTrial = trial;
        if (PushBox(layout, pushTrial, box, direction))
        {
            trial = pushTrial;
            pushed = true;
        }
    }
    if (!pushed && box >= 0)
    {
        // A dummy in a doorway never stood on the open floor outside, so a
        // neighbor that neither moves nor faces that doorway is a wall.
        if (leaving && !meets) return false;
        if (depth >= MAX_DEPTH || !Gateway(layout, trial, room, next, direction, out var destination, out var entry, out var back)) return false;
        room = destination;
        next = entry;
        entered = true;
        trial.actors[seat].trail[depth] = back;
        depth += 1;
        if (BoxAt(layout, trial, room, next) >= 0) return false;
    }
    var occupant = ActorAt(trial, room, next);
    if (occupant >= 0 && occupant != seat) return false;
    var crate = CargoAt(layout, trial, room, next);
    if (crate >= 0 && !PushCargo(layout, trial, crate, direction)) return false;
    trial.actors[seat].room = room;
    trial.actors[seat].position = next;
    trial.actors[seat].depth = depth;
    // Clear popped slots so equivalent paths have identical state bytes.
    for (var entry = depth; entry < MAX_DEPTH; entry++) trial.actors[seat].trail[entry] = Entry { };
    trial.moves += 1;
    trial.solved = IsSolved(layout, trial);
    puzzle = trial;
    step = entered ? Step.Enter : pushed ? Step.Push : Step.Walk;
    return true;
}

void Remember(mut Workshop workshop, Puzzle before)
{
    if (workshop.historyCount == UNDO_LIMIT)
    {
        for (var i = 1; i < UNDO_LIMIT; i++) workshop.history[i - 1] = workshop.history[i];
        workshop.historyCount -= 1;
    }
    workshop.history[workshop.historyCount] = before;
    workshop.historyCount += 1;
}
void OpenLevel(mut Workshop workshop, int level)
{
    workshop.level = Math.Clamp(level, 0, LEVEL_COUNT - 1);
    LoadLevel(workshop.level, workshop.layout, workshop.puzzle);
    workshop.historyCount = 0;
    workshop.serial += 1;
    workshop.initialized = true;
}
bool Authorized(Workshop workshop, PlayerID sender, int serial)
{
    return workshop.initialized && Together(workshop) && serial == workshop.serial && SeatOf(workshop, sender) >= 0;
}
bool Pushed(Puzzle before, Puzzle after)
{
    for (var room = 0; room < MAX_ROOMS; room++)
        if (before.rooms[room].room != after.rooms[room].room || !CellEqual(before.rooms[room].position, after.rooms[room].position)) return true;
    for (var reference = 0; reference < MAX_REFERENCES; reference++)
        if (before.references[reference].room != after.references[reference].room || !CellEqual(before.references[reference].position, after.references[reference].position)) return true;
    for (var crate = 0; crate < MAX_CRATES; crate++)
        if (before.crates[crate].room != after.crates[crate].room || !CellEqual(before.crates[crate].position, after.crates[crate].position)) return true;
    return false;
}

system BeginWorkshop(mut Workshop workshop)
{
    if (!workshop.initialized) OpenLevel(workshop, 0);
}
event(PlayerJoined joined) JoinWorkshop(mut Workshop workshop)
{
    if (SeatOf(workshop, joined.player) >= 0) return;
    mut var seat = -1;
    if (workshop.seats.Has(joined.player)) seat = workshop.seats[joined.player];
    else
    {
        if (!workshop.present[0]) seat = 0;
        else if (!workshop.present[1]) seat = 1;
        if (seat < 0) return;
        workshop.seats.Remove(workshop.players[seat]);
        workshop.seats[joined.player] = seat;
    }
    if (seat < 0 || seat > 1 || workshop.present[seat]) return;
    workshop.players[seat] = joined.player;
    workshop.present[seat] = true;
    workshop.serial += 1;
}
event(PlayerLeft left) LeaveWorkshop(mut Workshop workshop)
{
    var seat = SeatOf(workshop, left.player);
    if (seat < 0) return;
    workshop.present[seat] = false;
    workshop.serial += 1;
}
command(Move move, PlayerID sender) MoveHand(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, move.serial)) return;
    var seat = SeatOf(workshop, sender);
    var before = workshop.puzzle;
    if (!MovePuzzle(workshop.layout, workshop.puzzle, seat, move.direction, out _))
    {
        Send(PuzzleCue { kind = 6, seat = seat });
        return;
    }
    Remember(workshop, before);
    var source = before.actors[seat];
    var travel = source.room != workshop.puzzle.actors[seat].room || source.depth != workshop.puzzle.actors[seat].depth ||
        !OnRoomGrid(workshop.layout, source.room, source.position + Direction(move.direction));
    Send(PuzzleCue { kind = travel ? 2 : Pushed(before, workshop.puzzle) ? 1 : 0, seat = seat,
        direction = travel ? move.direction : -1, source = travel ? source : Traveler { } });
    if (workshop.puzzle.solved)
    {
        workshop.completed |= 1 << workshop.level;
        Send(PuzzleCue { kind = 5, seat = seat });
    }
}
command(Undo undo, PlayerID sender) UndoMove(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, undo.serial) || workshop.historyCount <= 0) return;
    workshop.historyCount -= 1;
    workshop.puzzle = workshop.history[workshop.historyCount];
    workshop.serial += 1;
    Send(PuzzleCue { kind = 3, seat = SeatOf(workshop, sender) });
}
command(Reset reset, PlayerID sender) ResetPuzzle(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, reset.serial)) return;
    OpenLevel(workshop, workshop.level);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
command(Next next, PlayerID sender) NextPuzzle(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, next.serial) || !workshop.puzzle.solved || workshop.level >= LEVEL_COUNT - 1) return;
    OpenLevel(workshop, workshop.level + 1);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
command(ChooseLevel choice, PlayerID sender) ExplorePuzzle(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, choice.serial) || choice.level < 0 || choice.level >= LEVEL_COUNT) return;
    OpenLevel(workshop, choice.level);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
