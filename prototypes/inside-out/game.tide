using Rooms;

settings
{
    title = "Inside Out";
    tickRate = 30;
    maxPlayers = 2;
    hostMigration = true;
}

// Every room has exactly one box, and a box's id is its room's.
const int MAX_ROOMS = 4;
const int MAX_CRATES = 8;
const int MAX_DEPTH = 8;
const int LEVEL_COUNT = 20;
// Puzzles apart from the campaign, each with a budget of moves (hall.tide).
const int CHALLENGE_COUNT = 3;
const int PUZZLE_COUNT = LEVEL_COUNT + CHALLENGE_COUNT;
const int UNDO_LIMIT = 128;
const int CLOSE_TICKS = 36;
const int NAME_FADE_TICKS = 12;
const int NAME_HOLD_TICKS = 90;
const int INTRO_TICKS = NAME_FADE_TICKS * 2 + NAME_HOLD_TICKS;
const int REVEAL_TICKS = 36;

// A plate and a shutter for each of two channels, A and B. A clamp holds the
// box standing on it where it is: it never moves again, but it goes with
// the room it is in, and anything can still walk or be pushed over the clamp.
enum Tile { Floor, Wall, Target, Exit, PlateA, ShutterA, PlateB, ShutterB, Clamp }
struct RoomLayout
{
    Tile[49] tiles;
    int width = 5;
    int height = 5;
    int doors;
    int north = -1;
    int east = -1;
    int south = -1;
    int west = -1;
    int2 dock = int2(-1);
    int dockRoom = -1;
}
struct LevelLayout
{
    Tile[49] tiles;
    int width = 7;
    int height = 7;
    RoomLayout[MAX_ROOMS] rooms;
    int roomCount;
    int crateCount;
    // A challenge's budget: no move is taken once this many are. 0 for none.
    int moveLimit;
}
struct Entry
{
    int box = -1;
}
struct Traveler
{
    int room = -1;
    int2 position;
    Entry[8] trail;
    int depth;
    // The way it last moved, which is the way it faces.
    int facing = 2;
}
// Where a room's box stands: the room it is in (-1 is the table) and its cell.
struct RoomShell { int room = -1; int2 position; }
struct Cargo { int room = -1; int2 position; bool active; }
struct Puzzle
{
    Traveler[2] actors;
    RoomShell[MAX_ROOMS] rooms;
    Cargo[8] crates;
    int moves;
    bool solved;
}
singleton Workshop
{
    LevelLayout layout;
    Puzzle puzzle;
    Puzzle[128] history;
    int historyCount;
    int level;
    int serial;
    int completed;
    int solvedTick = -1;
    int openedTick;
    int introTicks;
    bool initialized;
    // In a chapter's hall (hall.tide), the puzzle is that hall's floor and
    // `level` is the puzzle last played.
    bool inHall;
    int hall;
    int arrival;
    // The exhibit whose post both robots are in, and when they got there.
    int departStation = -1;
    int departTick = -1;
    // A chapter whose lift has just been powered, and whether the last solve
    // was the campaign's last.
    int opened = -1;
    bool finale;
    // A bit for each hall whose lift up works, and each hall's arrangement
    // as the pair left it (`hallKept` has a bit for each kept).
    int unlocked;
    Puzzle[CHAPTER_COUNT] halls;
    int hallKept;
    // Every chapter is open, and puzzles can be chosen from the menu.
    bool playtest;
    Map<PlayerID, int> seats;
    PlayerID[2] players;
    bool[2] present;
}

scene Main { }
event PuzzleCue { int kind; int seat; int direction = -1; Traveler source; }
command Move { int serial; int direction; }
command Undo { int serial; }
command Reset { int serial; }
command ChooseLevel { int serial; int level; }
command ToHall { int serial; }
// What a player's machine has solved before, and whether it plays with
// every chapter open. The room's progress is what either of them has solved.
command Progress { int completed; int unlocked; bool playtest; }

int SeatOf(Workshop workshop, PlayerID player)
{
    if (!workshop.seats.Has(player)) return -1;
    var seat = workshop.seats[player];
    return seat >= 0 && seat < 2 && workshop.present[seat] ? seat : -1;
}
bool Together(Workshop workshop) { return workshop.present[0] && workshop.present[1]; }
bool CellEqual(int2 a, int2 b) { return a.x == b.x && a.y == b.y; }
int CellIndex(int2 at, int size) { return at.y * size + at.x; }
int RoomWidth(LevelLayout layout, int room)
{
    return Math.Clamp(room == -1 ? layout.width : layout.rooms[room].width, 1, 7);
}
int RoomHeight(LevelLayout layout, int room)
{
    return Math.Clamp(room == -1 ? layout.height : layout.rooms[room].height, 1, 7);
}
bool OnRoomGrid(LevelLayout layout, int room, int2 at)
{
    return (room == -1 || ValidRoom(layout, room)) && at.x >= 0 && at.y >= 0 && at.x < RoomWidth(layout, room) && at.y < RoomHeight(layout, room);
}
float2 RoomCenter(LevelLayout layout, int room)
{
    return float2(RoomWidth(layout, room) - 1, RoomHeight(layout, room) - 1) * 0.5;
}
int2 Direction(int direction)
{
    if (direction == 0) return int2(0, -1);
    if (direction == 1) return int2(1, 0);
    if (direction == 2) return int2(0, 1);
    if (direction == 3) return int2(-1, 0);
    return int2(0);
}
int2 DoorCell(LevelLayout layout, int room, int direction)
{
    if (direction < 0 || direction > 3 || (room != -1 && !ValidRoom(layout, room))) return int2(-1);
    var width = RoomWidth(layout, room);
    var height = RoomHeight(layout, room);
    mut var offset = -1;
    if (room >= 0)
    {
        if (direction == 0) offset = layout.rooms[room].north;
        else if (direction == 1) offset = layout.rooms[room].east;
        else if (direction == 2) offset = layout.rooms[room].south;
        else offset = layout.rooms[room].west;
    }
    var length = direction % 2 == 0 ? width : height;
    if (offset == -1) offset = length / 2;
    if (offset < 0 || offset >= length) return int2(-1);
    if (direction == 0) return int2(offset, 0);
    if (direction == 1) return int2(width - 1, offset);
    if (direction == 2) return int2(offset, height - 1);
    return int2(0, offset);
}
bool ValidRoom(LevelLayout layout, int room)
{
    return room >= 0 && room < layout.roomCount && room < MAX_ROOMS;
}
// The box standing at a cell of a room, which is the room it holds; -1 for none.
int BoxAt(LevelLayout layout, Puzzle puzzle, int parent, int2 at)
{
    for (var box = 0; box < MAX_ROOMS; box++)
        if (ValidRoom(layout, box) && puzzle.rooms[box].room == parent && CellEqual(puzzle.rooms[box].position, at)) return box;
    return -1;
}
int ActorAt(Puzzle puzzle, int room, int2 at)
{
    for (var seat = 0; seat < 2; seat++)
        if (puzzle.actors[seat].room == room && CellEqual(puzzle.actors[seat].position, at)) return seat;
    return -1;
}
int CargoAt(LevelLayout layout, Puzzle puzzle, int room, int2 at)
{
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && puzzle.crates[crate].room == room && CellEqual(puzzle.crates[crate].position, at)) return crate;
    return -1;
}
Tile TileAt(LevelLayout layout, int room, int2 at)
{
    if (!OnRoomGrid(layout, room, at)) return Tile.Wall;
    var index = CellIndex(at, RoomWidth(layout, room));
    return room == -1 ? layout.tiles[index] : layout.rooms[room].tiles[index];
}

// Plates and shutters belong to channel 0 (A) or 1 (B); -1 is any other tile.
int PlateChannel(Tile tile)
{
    if (tile == Tile.PlateA) return 0;
    if (tile == Tile.PlateB) return 1;
    return -1;
}
int ShutterChannel(Tile tile)
{
    if (tile == Tile.ShutterA) return 0;
    if (tile == Tile.ShutterB) return 1;
    return -1;
}
// A channel is powered while anything stands on one of its plates, in any
// room or on the table: a bot, a battery, or a box on a plate of the room it
// stands in. The wiring is the whole level's.
bool Powered(LevelLayout layout, Puzzle puzzle, int channel)
{
    if (channel < 0 || channel > 1) return false;
    for (var seat = 0; seat < 2; seat++)
        if (PlateChannel(TileAt(layout, puzzle.actors[seat].room, puzzle.actors[seat].position)) == channel) return true;
    for (var box = 0; box < MAX_ROOMS; box++)
        if (ValidRoom(layout, box) && PlateChannel(TileAt(layout, puzzle.rooms[box].room, puzzle.rooms[box].position)) == channel) return true;
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && PlateChannel(TileAt(layout, puzzle.crates[crate].room, puzzle.crates[crate].position)) == channel) return true;
    return false;
}
// A bit for each powered channel.
int Power(LevelLayout layout, Puzzle puzzle)
{
    return (Powered(layout, puzzle, 0) ? 1 : 0) | (Powered(layout, puzzle, 1) ? 2 : 0);
}
bool ShutterOpen(int channel, int power) { return channel >= 0 && channel <= 1 && (power & (1 << channel)) != 0; }
// An occupied shutter stays down until its cell is clear. Occupancy and
// channel power are both read before the atomic move, so the whole row
// follows a pushed object across it just as on any other floor.
bool ShutterPassable(LevelLayout layout, Puzzle puzzle, int room, int2 at, int power = -1)
{
    var channel = ShutterChannel(TileAt(layout, room, at));
    return channel < 0 || ShutterOpen(channel, power < 0 ? Power(layout, puzzle) : power) ||
        ThingAt(layout, puzzle, room, at).kind >= 0;
}
// Whether anything can step, be pushed or go through a doorway into a cell.
// `power` and the puzzle describe where things stood before the move.
bool Passable(LevelLayout layout, Puzzle puzzle, int room, int2 at, int power)
{
    var tile = TileAt(layout, room, at);
    return tile != Tile.Wall && ShutterPassable(layout, puzzle, room, at, power);
}

// One step from a cell, for a bot, a parcel or a box alike. Inside the room it
// is the next cell. Outward from a doorway cell it is the cell beyond the
// room's box: a room has one box that is its outside, and everything in it
// leaves beside that box, however it came in. Where the box stands inside its
// own room, that is the same room again. The cell is set even when it cannot
// be entered.
bool StepFrom(LevelLayout layout, Puzzle puzzle, int power, int room, int2 from, int direction, out int nextRoom, out int2 next)
{
    nextRoom = room;
    next = from + Direction(direction);
    if (direction < 0 || direction > 3) return false;
    if (OnRoomGrid(layout, room, next)) return Passable(layout, puzzle, room, next, power);
    if (!ValidRoom(layout, room) || !CellEqual(from, DoorCell(layout, room, direction)) ||
        (layout.rooms[room].doors & (1 << direction)) == 0) return false;
    nextRoom = puzzle.rooms[room].room;
    next = puzzle.rooms[room].position + Direction(direction);
    return Passable(layout, puzzle, nextRoom, next, power);
}

// Whether a box stands on a clamp of the room it is in, which holds it there.
bool Clamped(LevelLayout layout, Puzzle puzzle, int box)
{
    return ValidRoom(layout, box) && TileAt(layout, puzzle.rooms[box].room, puzzle.rooms[box].position) == Tile.Clamp;
}
// The doorway of the box at a cell that faces something coming at it, and the
// cell inside that it leads to: the box's room's door cell on that side. Where
// there is such a doorway, `entry` is set even when it cannot be entered; it
// is off every grid where there is none.
bool Gateway(LevelLayout layout, Puzzle puzzle, int power, int room, int2 at, int direction, out int destination, out int2 entry)
{
    destination = room;
    entry = int2(-1);
    var box = BoxAt(layout, puzzle, room, at);
    if (box < 0) return false;
    var opposite = (direction + 2) % 4;
    destination = box;
    if ((layout.rooms[destination].doors & (1 << opposite)) == 0) return false;
    entry = DoorCell(layout, destination, opposite);
    return Passable(layout, puzzle, destination, entry, power);
}

// Whatever stands in a cell: kind 0 is a bot, 1 a box, 2 a parcel, -1 nothing.
struct Thing { int kind = -1; int index; }
struct Spot { int room; int2 cell; }
Thing ThingAt(LevelLayout layout, Puzzle puzzle, int room, int2 at)
{
    var seat = ActorAt(puzzle, room, at);
    if (seat >= 0) return Thing { kind = 0, index = seat };
    var box = BoxAt(layout, puzzle, room, at);
    if (box >= 0) return Thing { kind = 1, index = box };
    var crate = CargoAt(layout, puzzle, room, at);
    if (crate >= 0) return Thing { kind = 2, index = crate };
    return Thing { };
}
Spot SpotOf(Puzzle puzzle, Thing thing)
{
    if (thing.kind == 0) return Spot { room = puzzle.actors[thing.index].room, cell = puzzle.actors[thing.index].position };
    if (thing.kind == 1) return Spot { room = puzzle.rooms[thing.index].room, cell = puzzle.rooms[thing.index].position };
    return Spot { room = puzzle.crates[thing.index].room, cell = puzzle.crates[thing.index].position };
}
void PutThing(mut Puzzle puzzle, Thing thing, Spot spot)
{
    if (thing.kind == 0)
    {
        puzzle.actors[thing.index].room = spot.room;
        puzzle.actors[thing.index].position = spot.cell;
    }
    else if (thing.kind == 1)
    {
        puzzle.rooms[thing.index].room = spot.room;
        puzzle.rooms[thing.index].position = spot.cell;
    }
    else
    {
        puzzle.crates[thing.index].room = spot.room;
        puzzle.crates[thing.index].position = spot.cell;
    }
}

bool RebaseTrail(LevelLayout layout, Puzzle puzzle, mut Traveler actor, int room, int depth)
{
    actor.depth = depth;
    if (room == -1) actor.depth = 0;
    else if (depth == 0 || !ValidRoom(layout, room) || actor.trail[depth - 1].box != room)
    {
        // Changed box parentage invalidates an old prefix. Rebuild the
        // ancestry: the room's box, the room that box is in, and so on. A
        // cycle (a box inside itself, or two inside each other) contributes
        // each room once and never invents a containing outer room.
        mut int[4] ancestors = default;
        mut var count = 0;
        mut var parent = room;
        while (parent != -1)
        {
            if (!ValidRoom(layout, parent)) return false;
            mut var repeated = false;
            for (var prior = 0; prior < count; prior++)
                if (ancestors[prior] == parent) repeated = true;
            if (repeated) break;
            if (count >= MAX_ROOMS) return false;
            ancestors[count] = parent;
            count += 1;
            parent = puzzle.rooms[parent].room;
        }
        actor.depth = count;
        for (var step = 0; step < count; step++) actor.trail[count - step - 1] = Entry { box = ancestors[step] };
    }
    for (var entry = actor.depth; entry < MAX_DEPTH; entry++) actor.trail[entry] = Entry { };
    return true;
}

bool BoxDocked(LevelLayout layout, Puzzle puzzle, int room)
{
    var dock = layout.rooms[room];
    return dock.dock.x >= 0 && puzzle.rooms[room].room == dock.dockRoom && CellEqual(puzzle.rooms[room].position, dock.dock);
}
bool IsSolved(LevelLayout layout, Puzzle puzzle)
{
    for (var seat = 0; seat < 2; seat++)
        if (TileAt(layout, puzzle.actors[seat].room, puzzle.actors[seat].position) != Tile.Exit) return false;
    if (puzzle.actors[0].room == puzzle.actors[1].room && CellEqual(puzzle.actors[0].position, puzzle.actors[1].position)) return false;
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && TileAt(layout, puzzle.crates[crate].room, puzzle.crates[crate].position) != Tile.Target) return false;
    var outerWidth = RoomWidth(layout, -1);
    for (var cell = 0; cell < outerWidth * RoomHeight(layout, -1); cell++)
        if (layout.tiles[cell] == Tile.Target && CargoAt(layout, puzzle, -1, int2(cell % outerWidth, cell / outerWidth)) < 0) return false;
    for (var room = 0; room < Math.Min(MAX_ROOMS, layout.roomCount); room++)
    {
        var dock = layout.rooms[room].dock;
        if (dock.x >= 0 && (puzzle.rooms[room].room != layout.rooms[room].dockRoom || !CellEqual(puzzle.rooms[room].position, dock))) return false;
        var width = RoomWidth(layout, room);
        for (var cell = 0; cell < width * RoomHeight(layout, room); cell++)
            if (layout.rooms[room].tiles[cell] == Tile.Target && CargoAt(layout, puzzle, room, int2(cell % width, cell / width)) < 0) return false;
    }
    return true;
}
// What one step does: the move handler applies it, and each screen asks the
// same question of a copy of the puzzle to show its own robot what a
// direction will do.
enum Step { Blocked, Walk, Push, Enter }
// One bot's step, and everything it sets moving. The same rule moves a bot,
// a parcel and a box:
// - A thing steps to the next cell. If something stands there, that is
//   pushed the same way first, and whatever is beyond it, however long the
//   row: nothing in a row holds it back.
// - Only a wall (a closed shutter is one), a bot or a clamped box stops a
//   row. The thing against the stop cannot move. The thing behind it goes
//   into it instead, if the stopped thing is a box with a doorway facing it,
//   pushing on whatever stands in that doorway. Failing that, if the thing
//   behind is a box with a doorway facing the stopped thing, the stopped
//   thing goes into it, unless it is a bot or clamped: in by that doorway,
//   pushing on whatever stands there further in, while the box takes its
//   place. If neither can be, it is stopped too, and the same is asked of
//   the thing behind it, back to the bot that pushed.
// - A shutter stays lowered while powered or occupied. A row follows
//   normally across it; it rises only after its last occupant leaves.
// So a bot gets into a box only when the box cannot be pushed, and the one
// thing that can be put in a box's way and taken out again is the other bot.
// Every step is worked out from where things stood, which shutters are open
// included, and then all move at once.
bool Shove(LevelLayout layout, mut Puzzle puzzle, int seat, int direction, out Step step)
{
    step = Step.Blocked;
    var power = Power(layout, puzzle);
    mut Thing[20] row = default;
    mut Spot[20] goals = default;
    // The way each moves: a thing taken into the box behind it goes back
    // along the row, and pushes what is inside that way.
    mut int[20] ways = default;
    row[0] = Thing { kind = 0, index = seat };
    ways[0] = direction;
    mut var count = 1;
    mut var entered = false;
    mut var decided = false; // The last of the row already has its goal: a doorway
    // A bit for each place in the row where the box there took in the thing
    // ahead of it, so that is not tried again once it has led nowhere.
    mut var taken = 0;
    for (var guard = 0; guard < 96; guard++)
    {
        var last = count - 1;
        mut var free = true;
        if (!decided)
        {
            var from = SpotOf(puzzle, row[last]);
            free = StepFrom(layout, puzzle, power, from.room, from.cell, ways[last], out var room, out var cell) &&
                !(row[last].kind == 1 && Clamped(layout, puzzle, row[last].index));
            goals[last] = Spot { room = room, cell = cell };
        }
        decided = false;
        if (free)
        {
            var ahead = ThingAt(layout, puzzle, goals[last].room, goals[last].cell);
            if (ahead.kind < 0)
            {
                for (var moved = 0; moved < count; moved++) PutThing(puzzle, row[moved], goals[moved]);
                step = entered ? Step.Enter : count > 1 ? Step.Push : Step.Walk;
                return true;
            }
            mut var stopped = ahead.kind == 0 || count >= 20;
            for (var earlier = 0; earlier < count; earlier++)
                if (row[earlier].kind == ahead.kind && row[earlier].index == ahead.index) stopped = true;
            if (!stopped)
            {
                row[count] = ahead;
                ways[count] = ways[last];
                count += 1;
                continue;
            }
            // A bot, or the row come round on itself, stands there like a
            // wall. What stood before it is asked whether it can be entered.
            if (count < 20)
            {
                row[count] = ahead;
                ways[count] = ways[last];
                count += 1;
            }
        }
        // The last of the row cannot move. Whatever is behind it goes into
        // it, if it is a box with a doorway this way; else it goes into what
        // is behind it, if that is a box with a doorway facing it. A doorway
        // closed by a shutter is a wall only when it is empty and unpowered.
        mut var found = false;
        while (count >= 2 && !found)
        {
            var into = row[count - 1];
            count -= 1;
            var behind = row[count - 1];
            var way = ways[count - 1];
            if (into.kind == 1)
            {
                var at = SpotOf(puzzle, into);
                if (Gateway(layout, puzzle, power, at.room, at.cell, way, out var destination, out var entry))
                {
                    goals[count - 1] = Spot { room = destination, cell = entry };
                    decided = true;
                    found = true;
                    if (count == 1) entered = true;
                    continue;
                }
            }
            var place = 1 << (count - 1);
            if ((taken & place) != 0)
            {
                taken &= ~place;
                continue;
            }
            mut var again = false;
            for (var earlier = 0; earlier < count - 1; earlier++)
                if (row[earlier].kind == into.kind && row[earlier].index == into.index) again = true;
            if (behind.kind != 1 || into.kind == 0 || again || into.kind == 1 && Clamped(layout, puzzle, into.index)) continue;
            var door = DoorCell(layout, behind.index, way);
            if ((layout.rooms[behind.index].doors & (1 << way)) == 0 || !Passable(layout, puzzle, behind.index, door, power)) continue;
            // The box behind takes the stopped thing in, and its own step
            // is to where that stood.
            row[count] = into;
            goals[count] = Spot { room = behind.index, cell = door };
            ways[count] = (way + 2) % 4;
            taken |= place;
            count += 1;
            decided = true;
            found = true;
        }
        if (!found) return false;
    }
    return false;
}

bool MovePuzzle(LevelLayout layout, mut Puzzle puzzle, int seat, int direction, out Step step)
{
    step = Step.Blocked;
    if (puzzle.solved || seat < 0 || seat > 1 || direction < 0 || direction > 3) return false;
    if (layout.moveLimit > 0 && puzzle.moves >= layout.moveLimit) return false;
    mut var trial = puzzle;
    if (!Shove(layout, trial, seat, direction, out step))
    {
        step = Step.Blocked;
        return false;
    }
    trial.actors[seat].facing = direction;
    // What a bot is inside of is its room's box, and that box's room's, and
    // so on: worked out again for both, as a box either is in may have moved.
    for (var who = 0; who < 2; who++)
    {
        mut var actor = trial.actors[who];
        if (!RebaseTrail(layout, trial, actor, actor.room, 0)) return false;
        trial.actors[who] = actor;
    }
    trial.moves += 1;
    trial.solved = IsSolved(layout, trial);
    puzzle = trial;
    return true;
}

void Remember(mut Workshop workshop, Puzzle before)
{
    if (workshop.historyCount == UNDO_LIMIT)
    {
        for (var i = 1; i < UNDO_LIMIT; i++) workshop.history[i - 1] = workshop.history[i];
        workshop.historyCount -= 1;
    }
    workshop.history[workshop.historyCount] = before;
    workshop.historyCount += 1;
}
void OpenLevel(mut Workshop workshop, int level, int tick)
{
    KeepHall(workshop);
    var next = Math.Clamp(level, 0, PUZZLE_COUNT - 1);
    workshop.introTicks = !workshop.initialized || workshop.inHall || workshop.level != next ? INTRO_TICKS : 0;
    workshop.inHall = false;
    workshop.departStation = -1;
    workshop.departTick = -1;
    workshop.opened = -1;
    workshop.finale = false;
    workshop.level = next;
    LoadLevel(workshop.level, workshop.layout, workshop.puzzle);
    workshop.historyCount = 0;
    workshop.solvedTick = -1;
    workshop.openedTick = tick;
    workshop.serial += 1;
    workshop.initialized = true;
}
bool Authorized(Workshop workshop, PlayerID sender, int serial)
{
    return workshop.initialized && Together(workshop) && serial == workshop.serial && SeatOf(workshop, sender) >= 0;
}
bool Pushed(Puzzle before, Puzzle after)
{
    for (var room = 0; room < MAX_ROOMS; room++)
        if (before.rooms[room].room != after.rooms[room].room || !CellEqual(before.rooms[room].position, after.rooms[room].position)) return true;
    for (var crate = 0; crate < MAX_CRATES; crate++)
        if (before.crates[crate].room != after.crates[crate].room || !CellEqual(before.crates[crate].position, after.crates[crate].position)) return true;
    return false;
}

system BeginWorkshop(mut Workshop workshop, Time time)
{
    if (!workshop.initialized) OpenLevel(workshop, 0, time.tick);
}

[After(BeginWorkshop)]
system ContinueWorkshop(mut Workshop workshop, Time time)
{
    if (workshop.inHall)
    {
        ContinueHall(workshop, time.tick);
        return;
    }
    if (!workshop.puzzle.solved)
    {
        workshop.solvedTick = -1;
        return;
    }
    if (workshop.solvedTick < 0) workshop.solvedTick = time.tick;
    // A solved puzzle closes, holds a moment, and both are back in its hall.
    var wait = workshop.finale ? CLOSE_TICKS + ENDING_HOLD_TICKS : RETURN_TICKS;
    if (!Together(workshop) || time.tick - workshop.solvedTick < wait) return;
    OpenHall(workshop, LevelChapter(workshop.level), 1, time.tick);
    Send(PuzzleCue { kind = 4, seat = -1 });
}
event(PlayerJoined joined) JoinWorkshop(mut Workshop workshop, Time time)
{
    if (SeatOf(workshop, joined.player) >= 0) return;
    mut var seat = -1;
    if (workshop.seats.Has(joined.player)) seat = workshop.seats[joined.player];
    else
    {
        if (!workshop.present[0]) seat = 0;
        else if (!workshop.present[1]) seat = 1;
        if (seat < 0) return;
        workshop.seats.Remove(workshop.players[seat]);
        workshop.seats[joined.player] = seat;
    }
    if (seat < 0 || seat > 1 || workshop.present[seat]) return;
    workshop.players[seat] = joined.player;
    workshop.present[seat] = true;
    workshop.serial += 1;
    // Both players must get the readable hold, even after a long absence.
    if (Together(workshop))
    {
        if (workshop.puzzle.solved) workshop.solvedTick = time.tick;
        else if (workshop.puzzle.moves == 0 && workshop.introTicks > 0)
            workshop.openedTick = time.tick;
    }
}
event(PlayerLeft left) LeaveWorkshop(mut Workshop workshop)
{
    var seat = SeatOf(workshop, left.player);
    if (seat < 0) return;
    workshop.present[seat] = false;
    workshop.serial += 1;
}
command(Move move, PlayerID sender) MoveHand(mut Workshop workshop, Time time)
{
    if (!Authorized(workshop, sender, move.serial) || Leaving(workshop, time.tick)) return;
    var seat = SeatOf(workshop, sender);
    var before = workshop.puzzle;
    mut var step = Step.Blocked;
    var moved = workshop.inHall ? HallMove(HallOf(workshop), workshop.layout, workshop.puzzle, seat, move.direction, out step) :
        MovePuzzle(workshop.layout, workshop.puzzle, seat, move.direction, out step);
    if (!moved)
    {
        Send(PuzzleCue { kind = 6, seat = seat });
        return;
    }
    Remember(workshop, before);
    if (workshop.inHall) PowerLift(workshop);
    var source = before.actors[seat];
    var now = workshop.puzzle.actors[seat];
    var stepped = source.room != now.room || !CellEqual(source.position, now.position);
    var travel = step == Step.Enter || stepped && (source.room != now.room || source.depth != now.depth ||
        !OnRoomGrid(workshop.layout, source.room, source.position + Direction(move.direction)));
    Send(PuzzleCue { kind = travel ? 2 : Pushed(before, workshop.puzzle) ? 1 : 0, seat = seat,
        direction = travel ? move.direction : -1, source = travel ? source : Traveler { } });
    if (workshop.puzzle.solved)
    {
        workshop.solvedTick = time.tick;
        var earlier = workshop.completed;
        workshop.completed |= 1 << workshop.level;
        workshop.finale = !CampaignDone(earlier) && CampaignDone(workshop.completed);
        Send(PuzzleCue { kind = 5, seat = seat });
    }
}
command(Undo undo, PlayerID sender) UndoMove(mut Workshop workshop, Time time)
{
    if (!Authorized(workshop, sender, undo.serial) || Leaving(workshop, time.tick) || workshop.historyCount <= 0) return;
    workshop.historyCount -= 1;
    workshop.puzzle = workshop.history[workshop.historyCount];
    workshop.serial += 1;
    Send(PuzzleCue { kind = 3, seat = SeatOf(workshop, sender) });
}
command(Reset reset, PlayerID sender) ResetPuzzle(mut Workshop workshop, Time time)
{
    if (!Authorized(workshop, sender, reset.serial) || Leaving(workshop, time.tick)) return;
    if (workshop.inHall) ResetHall(workshop, time.tick);
    else OpenLevel(workshop, workshop.level, time.tick);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
command(ChooseLevel choice, PlayerID sender) ExplorePuzzle(mut Workshop workshop, Time time)
{
    if (!Authorized(workshop, sender, choice.serial) || choice.level < 0 || choice.level >= PUZZLE_COUNT) return;
    OpenLevel(workshop, choice.level, time.tick);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
command(ToHall leave, PlayerID sender) LeaveForHall(mut Workshop workshop, Time time)
{
    if (!Authorized(workshop, sender, leave.serial) || workshop.inHall) return;
    OpenHall(workshop, LevelChapter(workshop.level), 1, time.tick);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
command(Progress progress, PlayerID sender) ShareProgress(mut Workshop workshop, Time time)
{
    if (!workshop.initialized || SeatOf(workshop, sender) < 0) return;
    workshop.completed |= progress.completed & ((1 << PUZZLE_COUNT) - 1);
    workshop.unlocked |= progress.unlocked & ((1 << (CHAPTER_COUNT - 1)) - 1);
    if (progress.playtest) workshop.playtest = true;
    // A pair that has solved the first puzzle before starts in the hall
    // they last reached, unless the first puzzle is already under way.
    if (!workshop.inHall && workshop.level == 0 && workshop.puzzle.moves == 0 && !workshop.puzzle.solved && Solved(workshop.completed, 0))
        OpenHall(workshop, Frontier(HallOf(workshop)), 0, time.tick);
}
