using Rooms;

settings
{
    title = "Inside Out";
    tickRate = 30;
    maxPlayers = 2;
    hostMigration = true;
}

const int OUTER_SIZE = 7;
const int INNER_SIZE = 5;
const int MAX_ROOMS = 4;
const int MAX_CRATES = 8;
const int MAX_PORTALS = 4;
const int MAX_DEPTH = 8;
const int LEVEL_COUNT = 12;
const int UNDO_LIMIT = 128;

enum Tile { Floor, Wall, Target, Exit, Hatch, Switch }
struct RoomLayout
{
    Tile[25] tiles;
    int doors;
    int2 dock = int2(-1);
    int dockRoom = -1;
    bool latched;
}
struct PortalLayout
{
    int room = -1;
    int2 position;
    int destination;
    int doors = 15;
}
struct LevelLayout
{
    Tile[49] tiles;
    RoomLayout[4] rooms;
    PortalLayout[4] portals;
    int roomCount;
    int crateCount;
    int portalCount;
}
struct Entry
{
    int shell = -1;
    int room = -1;
    int2 position;
}
struct Traveler
{
    int room = -1;
    int2 position;
    Entry[8] trail;
    int depth;
}
struct RoomShell { int room = -1; int2 position; }
struct Cargo { int room = -1; int2 position; bool active; }
struct Puzzle
{
    Traveler[2] actors;
    RoomShell[4] rooms;
    Cargo[8] crates;
    int moves;
    bool solved;
}
singleton Workshop
{
    LevelLayout layout;
    Puzzle puzzle;
    Puzzle[128] history;
    int historyCount;
    int level;
    int serial;
    int completed;
    bool initialized;
    Map<PlayerID, int> seats;
    PlayerID[2] players;
    bool[2] present;
}

scene Main { }
event PuzzleCue { int kind; int seat; }
command Move { int serial; int direction; bool push; }
command Undo { int serial; }
command Reset { int serial; }
command Next { int serial; }
command ChooseLevel { int serial; int level; }

int SeatOf(Workshop workshop, PlayerID player)
{
    if (!workshop.seats.Has(player)) return -1;
    var seat = workshop.seats[player];
    return seat >= 0 && seat < 2 && workshop.present[seat] ? seat : -1;
}
bool Together(Workshop workshop) { return workshop.present[0] && workshop.present[1]; }
bool CellEqual(int2 a, int2 b) { return a.x == b.x && a.y == b.y; }
bool OnGrid(int2 at, int size) { return at.x >= 0 && at.y >= 0 && at.x < size && at.y < size; }
int CellIndex(int2 at, int size) { return at.y * size + at.x; }
int RoomSize(int room) { return room < 0 ? OUTER_SIZE : INNER_SIZE; }
int2 Direction(int direction)
{
    if (direction == 0) return int2(0, -1);
    if (direction == 1) return int2(1, 0);
    if (direction == 2) return int2(0, 1);
    if (direction == 3) return int2(-1, 0);
    return int2(0);
}
int2 DoorCell(int direction)
{
    if (direction == 0) return int2(2, 0);
    if (direction == 1) return int2(4, 2);
    if (direction == 2) return int2(2, 4);
    return int2(0, 2);
}
bool ValidRoom(LevelLayout layout, int room)
{
    return room >= 0 && room < layout.roomCount && room < MAX_ROOMS;
}
int RoomAt(LevelLayout layout, Puzzle puzzle, int parent, int2 at)
{
    for (var room = 0; room < Math.Min(MAX_ROOMS, layout.roomCount); room++)
        if (puzzle.rooms[room].room == parent && CellEqual(puzzle.rooms[room].position, at)) return room;
    return -1;
}
int PortalAt(LevelLayout layout, int parent, int2 at)
{
    for (var portal = 0; portal < Math.Min(MAX_PORTALS, layout.portalCount); portal++)
        if (layout.portals[portal].room == parent && CellEqual(layout.portals[portal].position, at)) return portal;
    return -1;
}
int ActorAt(Puzzle puzzle, int room, int2 at)
{
    for (var seat = 0; seat < 2; seat++)
        if (puzzle.actors[seat].room == room && CellEqual(puzzle.actors[seat].position, at)) return seat;
    return -1;
}
int CargoAt(LevelLayout layout, Puzzle puzzle, int room, int2 at)
{
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && puzzle.crates[crate].room == room && CellEqual(puzzle.crates[crate].position, at)) return crate;
    return -1;
}
Tile TileAt(LevelLayout layout, int room, int2 at)
{
    if (room == -1) return OnGrid(at, OUTER_SIZE) ? layout.tiles[CellIndex(at, OUTER_SIZE)] : Tile.Wall;
    if (!ValidRoom(layout, room) || !OnGrid(at, INNER_SIZE)) return Tile.Wall;
    return layout.rooms[room].tiles[CellIndex(at, INNER_SIZE)];
}
bool RoomUnlocked(LevelLayout layout, Puzzle puzzle, int room)
{
    if (!ValidRoom(layout, room)) return false;
    if (!layout.rooms[room].latched) return true;
    for (var seat = 0; seat < 2; seat++)
        if (puzzle.actors[seat].room == room && TileAt(layout, room, puzzle.actors[seat].position) == Tile.Switch) return true;
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && puzzle.crates[crate].room == room && TileAt(layout, room, puzzle.crates[crate].position) == Tile.Switch) return true;
    return false;
}
bool EmptyCell(LevelLayout layout, Puzzle puzzle, int room, int2 at)
{
    return TileAt(layout, room, at) != Tile.Wall && RoomAt(layout, puzzle, room, at) < 0 && PortalAt(layout, room, at) < 0 && CargoAt(layout, puzzle, room, at) < 0 && ActorAt(puzzle, room, at) < 0;
}

// Objects exit through their containing room's physical shell. Travelers
// instead return through the particular doorway in their finite entry trail.
bool PhysicalStep(LevelLayout layout, Puzzle puzzle, int room, int2 from, int direction, out int nextRoom, out int2 next)
{
    nextRoom = room;
    next = from + Direction(direction);
    if (direction < 0 || direction > 3) return false;
    if (OnGrid(next, RoomSize(room))) return TileAt(layout, room, next) != Tile.Wall;
    if (!ValidRoom(layout, room) || !CellEqual(from, DoorCell(direction)) || (layout.rooms[room].doors & (1 << direction)) == 0) return false;
    nextRoom = puzzle.rooms[room].room;
    next = puzzle.rooms[room].position + Direction(direction);
    return TileAt(layout, nextRoom, next) != Tile.Wall;
}

// Resolve one doorway only. Occupied destination doorways block instead of
// silently following an unbounded chain of recursive references.
bool Gateway(LevelLayout layout, Puzzle puzzle, int room, int2 at, int direction, out int destination, out int2 entry, out Entry trail)
{
    destination = room;
    entry = at;
    trail = Entry { };
    var shell = RoomAt(layout, puzzle, room, at);
    var portal = PortalAt(layout, room, at);
    if (shell < 0 && portal < 0) return false;
    var opposite = (direction + 2) % 4;
    if (shell >= 0)
    {
        destination = shell;
        trail = Entry { shell = shell };
    }
    else
    {
        var door = layout.portals[portal];
        if ((door.doors & (1 << opposite)) == 0) return false;
        destination = door.destination;
        trail = Entry { room = room, position = at };
    }
    if (!ValidRoom(layout, destination) || (layout.rooms[destination].doors & (1 << opposite)) == 0) return false;
    entry = DoorCell(opposite);
    return TileAt(layout, destination, entry) != Tile.Wall;
}
bool ObjectDestination(LevelLayout layout, Puzzle puzzle, int room, int2 from, int direction, out int nextRoom, out int2 next)
{
    if (!PhysicalStep(layout, puzzle, room, from, direction, out nextRoom, out next)) return false;
    if (RoomAt(layout, puzzle, nextRoom, next) >= 0 || PortalAt(layout, nextRoom, next) >= 0)
    {
        if (!Gateway(layout, puzzle, nextRoom, next, direction, out var destination, out var entry, out _)) return false;
        nextRoom = destination;
        next = entry;
    }
    return EmptyCell(layout, puzzle, nextRoom, next);
}
bool PushCargo(LevelLayout layout, mut Puzzle puzzle, int crate, int direction)
{
    if (crate < 0 || crate >= layout.crateCount || crate >= MAX_CRATES || !puzzle.crates[crate].active) return false;
    var item = puzzle.crates[crate];
    if (!ObjectDestination(layout, puzzle, item.room, item.position, direction, out var room, out var next)) return false;
    puzzle.crates[crate].room = room;
    puzzle.crates[crate].position = next;
    return true;
}
bool AcyclicPlacement(LevelLayout layout, Puzzle puzzle, int shell, int parent)
{
    mut var room = parent;
    for (var step = 0; step <= MAX_ROOMS; step++)
    {
        if (room == -1) return true;
        if (room == shell || !ValidRoom(layout, room)) return false;
        room = puzzle.rooms[room].room;
    }
    return false;
}
bool PushShell(LevelLayout layout, mut Puzzle puzzle, int shell, int direction)
{
    if (!RoomUnlocked(layout, puzzle, shell)) return false;
    var box = puzzle.rooms[shell];
    if (!ObjectDestination(layout, puzzle, box.room, box.position, direction, out var room, out var next) || !AcyclicPlacement(layout, puzzle, shell, room)) return false;
    puzzle.rooms[shell].room = room;
    puzzle.rooms[shell].position = next;
    return true;
}
bool TravelerStep(LevelLayout layout, Puzzle puzzle, Traveler actor, int direction, out int room, out int2 next, out int depth)
{
    room = actor.room;
    next = actor.position + Direction(direction);
    depth = actor.depth;
    if (OnGrid(next, RoomSize(room))) return TileAt(layout, room, next) != Tile.Wall;
    if (!ValidRoom(layout, room) || depth <= 0 || depth > MAX_DEPTH || !CellEqual(actor.position, DoorCell(direction)) || (layout.rooms[room].doors & (1 << direction)) == 0) return false;
    var back = actor.trail[depth - 1];
    if (back.shell >= 0)
    {
        if (!ValidRoom(layout, back.shell)) return false;
        room = puzzle.rooms[back.shell].room;
        next = puzzle.rooms[back.shell].position + Direction(direction);
    }
    else
    {
        room = back.room;
        next = back.position + Direction(direction);
    }
    depth -= 1;
    return TileAt(layout, room, next) != Tile.Wall;
}

int EntryDestination(LevelLayout layout, Entry entry)
{
    if (entry.shell >= 0) return ValidRoom(layout, entry.shell) ? entry.shell : -2;
    var portal = PortalAt(layout, entry.room, entry.position);
    return portal >= 0 ? layout.portals[portal].destination : -2;
}
bool RebaseTrail(LevelLayout layout, Puzzle puzzle, mut Traveler actor, int room, int depth)
{
    actor.depth = depth;
    if (room == -1) actor.depth = 0;
    else if (depth == 0 || EntryDestination(layout, actor.trail[depth - 1]) != room)
    {
        // A shell may have changed parent while someone was inside. Its
        // occupant returns into that new parent's physical ancestry, rather
        // than keeping a stale path or becoming stranded with no exit.
        mut int[4] ancestors = default;
        mut var count = 0;
        mut var parent = room;
        while (parent != -1 && count < MAX_ROOMS)
        {
            if (!ValidRoom(layout, parent)) return false;
            ancestors[count] = parent;
            count += 1;
            parent = puzzle.rooms[parent].room;
        }
        if (parent != -1) return false;
        actor.depth = count;
        for (var step = 0; step < count; step++) actor.trail[count - step - 1] = Entry { shell = ancestors[step] };
    }
    for (var entry = actor.depth; entry < MAX_DEPTH; entry++) actor.trail[entry] = Entry { };
    return true;
}

bool IsSolved(LevelLayout layout, Puzzle puzzle)
{
    for (var seat = 0; seat < 2; seat++)
        if (TileAt(layout, puzzle.actors[seat].room, puzzle.actors[seat].position) != Tile.Exit) return false;
    if (puzzle.actors[0].room == puzzle.actors[1].room && CellEqual(puzzle.actors[0].position, puzzle.actors[1].position)) return false;
    for (var crate = 0; crate < Math.Min(MAX_CRATES, layout.crateCount); crate++)
        if (puzzle.crates[crate].active && TileAt(layout, puzzle.crates[crate].room, puzzle.crates[crate].position) != Tile.Target) return false;
    for (var cell = 0; cell < OUTER_SIZE * OUTER_SIZE; cell++)
        if (layout.tiles[cell] == Tile.Target && CargoAt(layout, puzzle, -1, int2(cell % OUTER_SIZE, cell / OUTER_SIZE)) < 0) return false;
    for (var room = 0; room < Math.Min(MAX_ROOMS, layout.roomCount); room++)
    {
        var dock = layout.rooms[room].dock;
        if (dock.x >= 0 && (puzzle.rooms[room].room != layout.rooms[room].dockRoom || !CellEqual(puzzle.rooms[room].position, dock))) return false;
        for (var cell = 0; cell < INNER_SIZE * INNER_SIZE; cell++)
            if (layout.rooms[room].tiles[cell] == Tile.Target && CargoAt(layout, puzzle, room, int2(cell % INNER_SIZE, cell / INNER_SIZE)) < 0) return false;
    }
    return true;
}
bool MovePuzzle(LevelLayout layout, mut Puzzle puzzle, int seat, int direction, bool push = false)
{
    if (puzzle.solved || seat < 0 || seat > 1 || direction < 0 || direction > 3) return false;
    mut var trial = puzzle;
    mut var actor = trial.actors[seat];
    if (actor.depth < 0 || actor.depth > MAX_DEPTH) return false;
    if (!TravelerStep(layout, trial, actor, direction, out mut var room, out mut var next, out mut var depth)) return false;
    if (depth < actor.depth)
    {
        if (!RebaseTrail(layout, trial, actor, room, depth)) return false;
        trial.actors[seat] = actor;
        depth = actor.depth;
    }
    var shell = RoomAt(layout, trial, room, next);
    var portal = PortalAt(layout, room, next);
    if (shell >= 0 && push)
    {
        if (!PushShell(layout, trial, shell, direction)) return false;
    }
    else if (shell >= 0 || portal >= 0)
    {
        if (depth >= MAX_DEPTH || !Gateway(layout, trial, room, next, direction, out var destination, out var entry, out var back)) return false;
        room = destination;
        next = entry;
        trial.actors[seat].trail[depth] = back;
        depth += 1;
        if (RoomAt(layout, trial, room, next) >= 0 || PortalAt(layout, room, next) >= 0) return false;
    }
    var occupant = ActorAt(trial, room, next);
    if (occupant >= 0 && occupant != seat) return false;
    var crate = CargoAt(layout, trial, room, next);
    if (crate >= 0 && !PushCargo(layout, trial, crate, direction)) return false;
    trial.actors[seat].room = room;
    trial.actors[seat].position = next;
    trial.actors[seat].depth = depth;
    // Clear popped slots so equivalent paths have identical state bytes.
    for (var entry = depth; entry < MAX_DEPTH; entry++) trial.actors[seat].trail[entry] = Entry { };
    trial.moves += 1;
    trial.solved = IsSolved(layout, trial);
    puzzle = trial;
    return true;
}

void Remember(mut Workshop workshop, Puzzle before)
{
    if (workshop.historyCount == UNDO_LIMIT)
    {
        for (var i = 1; i < UNDO_LIMIT; i++) workshop.history[i - 1] = workshop.history[i];
        workshop.historyCount -= 1;
    }
    workshop.history[workshop.historyCount] = before;
    workshop.historyCount += 1;
}
void OpenLevel(mut Workshop workshop, int level)
{
    workshop.level = Math.Clamp(level, 0, LEVEL_COUNT - 1);
    LoadLevel(workshop.level, workshop.layout, workshop.puzzle);
    workshop.historyCount = 0;
    workshop.serial += 1;
    workshop.initialized = true;
}
bool Authorized(Workshop workshop, PlayerID sender, int serial)
{
    return workshop.initialized && Together(workshop) && serial == workshop.serial && SeatOf(workshop, sender) >= 0;
}
bool Pushed(Puzzle before, Puzzle after)
{
    for (var room = 0; room < MAX_ROOMS; room++)
        if (before.rooms[room].room != after.rooms[room].room || !CellEqual(before.rooms[room].position, after.rooms[room].position)) return true;
    for (var crate = 0; crate < MAX_CRATES; crate++)
        if (before.crates[crate].room != after.crates[crate].room || !CellEqual(before.crates[crate].position, after.crates[crate].position)) return true;
    return false;
}

system BeginWorkshop(mut Workshop workshop)
{
    if (!workshop.initialized) OpenLevel(workshop, 0);
}
event(PlayerJoined joined) JoinWorkshop(mut Workshop workshop)
{
    if (SeatOf(workshop, joined.player) >= 0) return;
    mut var seat = -1;
    if (workshop.seats.Has(joined.player)) seat = workshop.seats[joined.player];
    else
    {
        if (!workshop.present[0]) seat = 0;
        else if (!workshop.present[1]) seat = 1;
        if (seat < 0) return;
        workshop.seats.Remove(workshop.players[seat]);
        workshop.seats[joined.player] = seat;
    }
    if (seat < 0 || seat > 1 || workshop.present[seat]) return;
    workshop.players[seat] = joined.player;
    workshop.present[seat] = true;
    workshop.serial += 1;
}
event(PlayerLeft left) LeaveWorkshop(mut Workshop workshop)
{
    var seat = SeatOf(workshop, left.player);
    if (seat < 0) return;
    workshop.present[seat] = false;
    workshop.serial += 1;
}
command(Move move, PlayerID sender) MoveHand(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, move.serial)) return;
    var seat = SeatOf(workshop, sender);
    var before = workshop.puzzle;
    if (!MovePuzzle(workshop.layout, workshop.puzzle, seat, move.direction, move.push))
    {
        Send(PuzzleCue { kind = 6, seat = seat });
        return;
    }
    Remember(workshop, before);
    var travel = before.actors[seat].room != workshop.puzzle.actors[seat].room || before.actors[seat].depth != workshop.puzzle.actors[seat].depth;
    Send(PuzzleCue { kind = Pushed(before, workshop.puzzle) ? 1 : travel ? 2 : 0, seat = seat });
    if (workshop.puzzle.solved)
    {
        workshop.completed |= 1 << workshop.level;
        Send(PuzzleCue { kind = 5, seat = seat });
    }
}
command(Undo undo, PlayerID sender) UndoMove(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, undo.serial) || workshop.historyCount <= 0) return;
    workshop.historyCount -= 1;
    workshop.puzzle = workshop.history[workshop.historyCount];
    workshop.serial += 1;
    Send(PuzzleCue { kind = 3, seat = SeatOf(workshop, sender) });
}
command(Reset reset, PlayerID sender) ResetPuzzle(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, reset.serial)) return;
    OpenLevel(workshop, workshop.level);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
command(Next next, PlayerID sender) NextPuzzle(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, next.serial) || !workshop.puzzle.solved || workshop.level >= LEVEL_COUNT - 1) return;
    OpenLevel(workshop, workshop.level + 1);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
command(ChooseLevel choice, PlayerID sender) ExplorePuzzle(mut Workshop workshop)
{
    if (!Authorized(workshop, sender, choice.serial) || choice.level < 0 || choice.level >= LEVEL_COUNT) return;
    OpenLevel(workshop, choice.level);
    Send(PuzzleCue { kind = 4, seat = SeatOf(workshop, sender) });
}
