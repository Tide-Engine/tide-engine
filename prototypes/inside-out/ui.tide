using Rooms;

enum ArtStage { Backdrop, Prepare, Board, Controls, Sound }

const Color INK = Color(0.84, 0.83, 0.76);
const Color PAPER = Color(0.105, 0.11, 0.12);
const Color MUTED = Color(0.52, 0.53, 0.51);
const Color TEAL = Color(0.22, 0.53, 0.48);
const Color AMBER = Color(0.85, 0.48, 0.27);
// Factory paints shared by the scene and its controls.
// A painted model under a lamp: brass, soft black rubber, bone white, slate.
const Color HAZARD = Color(0.84, 0.64, 0.22);
const Color RUBBER = Color(0.11, 0.11, 0.13);
const Color DECAL = Color(0.90, 0.88, 0.82);
// The table the model stands on, and the frame around it.
const Color STEEL = Color(0.33, 0.235, 0.165);
const Color FRAME = Color(0.50, 0.36, 0.24);
// The bots' paints in the scene; the words about them use AMBER and TEAL.
const Color BOT_AMBER = Color(0.93, 0.50, 0.21);
const Color BOT_TEAL = Color(0.16, 0.60, 0.56);
// Marks that glow.
const Color GLOW_GOAL = Color(0.40, 0.80, 0.70);
const Color GLOW_TARGET = Color(0.98, 0.76, 0.30);
const GUITheme ROOM_THEME = GUITheme {
    text = INK, panel = PAPER, control = Color(0.20, 0.21, 0.23),
    hot = Color(0.28, 0.29, 0.31), pressed = Color(0.14, 0.15, 0.16),
    field = Color(0.07, 0.075, 0.08), fieldHot = Color(0.20, 0.21, 0.23),
    accent = HAZARD, radius = 0
};

local singleton Hands
{
    PlayerID player;
    int seat = -1;
    int level = -1;
    int serial = -1;
    int held = -1;
    bool release;
    float repeat;
    int hint;
    bool hintOpen;
    bool journal;
    bool quiet;
    bool music = true;
    bool guide;
    bool reduceMotion;
    // How much longer each seat's bot shakes after a step that could not be
    // taken. Every screen shows it for both, so a partner sees the bump too.
    float[2] blockTime;
    float portalTime;
    Step[4] ahead;
}

void Label(string text, float2 at, float size = 16, Color color = INK, Anchor anchor = Anchor.MiddleLeft)
{
    Draw.Text(text, at, size, color, anchor);
}

void Paragraph(string words, float2 at, float width, float size = 15, Color tone = INK)
{
    mut var rest = words;
    mut var line = "";
    mut var row = 0;
    while (rest.length > 0)
    {
        var space = rest.IndexOf(' ');
        var word = space < 0 ? rest : rest.Substring(0, space);
        var next = line == "" ? word : $"{line} {word}";
        if (line != "" && Draw.MeasureText(next, size).x > width)
        {
            Label(line, at + float2(0, row * (size + 6)), size, tone);
            line = word;
            row++;
        }
        else line = next;
        rest = space < 0 ? "" : rest.Substring(space + 1);
    }
    if (line != "") Label(line, at + float2(0, row * (size + 6)), size, tone);
}

int WrappedLines(string words, float width, float size)
{
    mut var rest = words;
    mut var line = "";
    mut var rows = 1;
    while (rest.length > 0)
    {
        var space = rest.IndexOf(' ');
        var word = space < 0 ? rest : rest.Substring(0, space);
        var next = line == "" ? word : $"{line} {word}";
        if (line != "" && Draw.MeasureText(next, size).x > width)
        {
            line = word;
            rows++;
        }
        else line = next;
        rest = space < 0 ? "" : rest.Substring(space + 1);
    }
    return rows;
}

bool PaperButton(string text, Rect rect, bool enabled = true, bool accent = false)
{
    mut var clicked = false;
    GUI.Disabled(!enabled)
    {
        var control = GUI.Control(rect);
        var at = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
        var base = accent ? Color(0.46, 0.36, 0.08) : Color(0.20, 0.21, 0.23);
        var fill = !enabled ? Color(0.14, 0.15, 0.16) : control.pressed ? Math.Lerp(base, Color.black, 0.18) : control.hovered ? Math.Lerp(base, INK, 0.12) : base;
        Draw.RoundRect(at + float2(0, 2), float2(rect.width, rect.height), 0, Color(0.03, 0.03, 0.035));
        Draw.RoundRect(at, float2(rect.width, rect.height), 0, fill);
        Draw.WireRoundRect(at, float2(rect.width, rect.height), 0, 1, control.focused ? HAZARD : Color(0.36, 0.38, 0.40));
        Label(text, at, rect.height < 35 ? 12.0 : 14.0, !enabled ? MUTED : INK, Anchor.MiddleCenter);
        clicked = control.clicked;
    }
    return clicked;
}

[Stage(ArtStage.Prepare)]
[Before(Rooms.Begin, Rooms.Pages)]
view PrepareHands(Session session, mut Hands hands)
{
    hands.player = session.player;
    for (var seat = 0; seat < 2; seat++) hands.blockTime[seat] = Math.Max(0, hands.blockTime[seat] - Frame.dt);
    hands.portalTime = Math.Max(0, hands.portalTime - Frame.dt);
    GUI.SetTheme(ROOM_THEME);
}

local event(PuzzleCue cue) FeelPuzzle(mut Hands hands)
{
    if (cue.kind == 6 && cue.seat >= 0 && cue.seat < 2) hands.blockTime[cue.seat] = 0.20;
    if (cue.seat != hands.seat) return;
    if (cue.kind == 2) hands.portalTime = 0.36;
}

string DimensionName(int room) { return room < 0 ? "Outer room" : RoomName(room); }

override string Rooms.Tagline() { return "Two test dummies. Rooms within rooms. Find your way out."; }
override Rect Rooms.MenuButton(float2 screen) { return Rect(screen.x - 84, 19, 66, 34); }

override void Rooms.TitlePage(Session session, mut Rooms.Lobby lobby)
{
    Draw.SetScreen();
    var width = Math.Min(Screen.width - 32, 570);
    var at = float2(Screen.width * 0.5, Screen.height * 0.52);
    Draw.RoundRect(at + float2(0, 5), float2(width, 268), 0, Color(0.02, 0.02, 0.025));
    Draw.RoundRect(at, float2(width, 268), 0, PAPER);
    Draw.WireRoundRect(at, float2(width, 268), 0, 1, MUTED);
    Label("DUMMY TEST LINE  /  PACKING TRIAL", at + float2(0, -96), 12, HAZARD, Anchor.MiddleCenter);
    Label("Find your way out together.", at + float2(0, -56), Screen.width < 550 ? 24.0 : 30.0, INK, Anchor.MiddleCenter);
    Paragraph("You are two test dummies packed in a box within another room. Move boxes, make space for each other, and follow rooms back into themselves.", at + float2(-width * 0.5 + 28, -15), width - 56, 15, MUTED);
    var buttonWidth = (width - 68) * 0.5;
    if (PaperButton("Host a room", Rect(at.x - width * 0.5 + 28, at.y + 64, buttonWidth, 43), session.state == SessionState.Connected, true))
    {
        Rooms.Host(lobby);
        lobby.page = Rooms.Page.Playing;
    }
    if (PaperButton("Join a friend", Rect(at.x + 6, at.y + 64, buttonWidth, 43))) Rooms.ShowJoin(lobby);
    Label(lobby.message != "" ? lobby.message : "12 puzzles  /  2 players  /  explore at your pace", at + float2(0, 120), 12, MUTED, Anchor.MiddleCenter);
}

[Stage(ArtStage.Prepare, 1)]
view Roster(Workshop workshop, mut Hands hands, mut Rooms.Lobby lobby)
{
    hands.seat = SeatOf(workshop, hands.player);
    lobby.seats = 2;
    lobby.manned = (workshop.present[0] ? 1 : 0) | (workshop.present[1] ? 2 : 0);
    lobby.mine = hands.seat;
    lobby.offersNewGame = false;
    lobby.offersBots = false;
    if (hands.level != workshop.level)
    {
        hands.level = workshop.level;
        hands.hint = 0;
        hands.hintOpen = false;
    }
    if (hands.serial != workshop.serial)
    {
        hands.serial = workshop.serial;
        hands.held = -1;
        hands.release = true;
        hands.repeat = 0.25;
    }
}

int KeyDirection(Devices devices, bool edge)
{
    var key = devices.keyboard;
    if (edge ? key.w.down || key.upArrow.down : key.w.pressed || key.upArrow.pressed) return 0;
    if (edge ? key.d.down || key.rightArrow.down : key.d.pressed || key.rightArrow.pressed) return 1;
    if (edge ? key.s.down || key.downArrow.down : key.s.pressed || key.downArrow.pressed) return 2;
    if (edge ? key.a.down || key.leftArrow.down : key.a.pressed || key.leftArrow.pressed) return 3;
    return -1;
}

Color StepTone(Step step)
{
    if (step == Step.Push) return HAZARD;
    if (step == Step.Enter) return Color(0.48, 0.74, 0.48);
    return step == Step.Blocked ? MUTED : TEAL;
}

// A direction's arrow says what the step will do: a solid block ahead of it
// is a box it pushes, an open frame around its tip a doorway it enters, and
// a bar across its tip a step that cannot happen.
void StepMark(float2 at, int direction, float size, Step step)
{
    var tone = StepTone(step);
    var axis = float2(Direction(direction));
    var cross = float2(-axis.y, axis.x);
    DirectionMark(at, direction, size, tone);
    var tip = at + axis * size;
    if (step == Step.Push) Draw.Rect(tip + axis * size * 0.75, float2(size * 0.9), tone);
    if (step == Step.Enter) Draw.WireRoundRect(tip - axis * size * 0.1, float2(size * 1.7), 0, 1.5, tone);
    if (step == Step.Blocked) Draw.Line(tip + axis * 2 - cross * size * 0.7, tip + axis * 2 + cross * size * 0.7, 1.5, tone);
}

void DirectionMark(float2 at, int direction, float size, Color tone)
{
    var step = Direction(direction);
    var axis = float2(step);
    var cross = float2(-axis.y, axis.x);
    var tip = at + axis * size;
    Draw.Line(at - axis * size, tip, 1.5, tone);
    Draw.Line(tip, tip - axis * size * 0.65 + cross * size * 0.40, 1.5, tone);
    Draw.Line(tip, tip - axis * size * 0.65 - cross * size * 0.40, 1.5, tone);
}

string DirectionKey(int direction)
{
    if (direction == 0) return "W";
    if (direction == 1) return "D";
    if (direction == 2) return "S";
    return "A";
}

void Compass(float2 at, int held)
{
    for (var d = 0; d < 4; d++)
    {
        var step = Direction(d);
        var axis = float2(step);
        DirectionMark(at + axis * 13, d, 5, held == d ? TEAL : MUTED);
        Label(DirectionKey(d), at + axis * 27, 10, held == d ? TEAL : MUTED, Anchor.MiddleCenter);
    }
}

[Stage(ArtStage.Controls)]
[Before(Rooms.Pages)]
view WorkshopControls(Workshop workshop, Session session, Devices devices, Rooms.Lobby lobby, mut Hands hands)
{
    Draw.SetScreen();
    if (lobby.page != Rooms.Page.Playing) return;
    var width = Screen.width;
    var height = Screen.height;
    bool narrow = width < 720;
    bool compactHeader = width < 1050;
    bool together = Together(workshop);
    bool playing = lobby.playing && together && hands.seat >= 0 && !hands.journal && !hands.guide;
    // Ask the real move rule about a copy of the puzzle, so the answer is
    // never a guess. Workbench draws the same answers beside the dummy.
    for (var d = 0; d < 4; d++)
    {
        hands.ahead[d] = Step.Blocked;
        if (!playing || workshop.puzzle.solved) continue;
        mut var trial = workshop.puzzle;
        MovePuzzle(workshop.layout, trial, hands.seat, d, out var step);
        hands.ahead[d] = step;
    }
    var key = devices.keyboard;
    var bottom = height - (narrow ? 140.0 : 64.0);
    var actionWidth = narrow ? 65.0 : 92.0;
    var left = narrow ? 14.0 : Math.Max(24, (width - 1100) * 0.5);

    if (!together)
    {
        var boxWidth = Math.Min(width - 36, 520);
        var at = float2(width * 0.5, height - 139);
        Draw.RoundRect(at, float2(boxWidth, 122), 2, PAPER);
        Label("A place for your partner", at + float2(0, -38), 21, INK, Anchor.MiddleCenter);
        Label("The puzzle waits until both of you are here.", at + float2(0, -10), 13, MUTED, Anchor.MiddleCenter);
        if (session.room != "")
        {
            if (PaperButton($"Copy invite  /  {session.room}", Rect(at.x - boxWidth * 0.5 + 22, at.y + 11, boxWidth - 44, 36), true, true))
                Clipboard.Copy($"https://tide-engine.dev/prototypes/inside-out/?join={session.room}");
        }
        else if (session.server && !session.open)
        {
            if (PaperButton("Open a room", Rect(at.x - boxWidth * 0.5 + 22, at.y + 11, boxWidth - 44, 36), true, true)) Session.Open();
        }
        else Label("Opening your room...", at + float2(0, 32), 13, MUTED, Anchor.MiddleCenter);
        return;
    }

    for (var seat = 0; seat < 2; seat++)
    {
        var actor = workshop.puzzle.actors[seat];
        var name = seat == 0 ? "Amber" : "Teal";
        var who = seat == hands.seat ? $"You: {name}" : name;
        var location = DimensionName(actor.room);
        var status = actor.depth > 1 ? $"{location} / {actor.depth} layers" : location;
        var x = left + seat * (compactHeader ? (width - 28) * 0.5 : 260.0);
        if (compactHeader) Label($"{who}  /  {status}", float2(x, 99.0), narrow ? 10.0 : 12.0, seat == 0 ? AMBER : TEAL);
        else
        {
            // On a wide window the header is one slim row: who is where sits
            // on two plates along the bottom instead.
            var plate = float2(left + 110 + seat * 232, height - 14);
            Chip(plate, float2(224, 20));
            Label($"{who}  /  {status}", plate - float2(104, 0), 12, seat == 0 ? AMBER : TEAL);
        }
    }
    var toolbarY = compactHeader ? 54.0 : 19.0;
    if (PaperButton("Puzzles", Rect(compactHeader ? left + 82 : width - 244, toolbarY, 78, 34))) hands.journal = !hands.journal;
    if (PaperButton("?", Rect(compactHeader ? left + 171 : width - 155, toolbarY, 28, 34))) hands.guide = !hands.guide;
    if (PaperButton(hands.quiet ? "Muted" : "Sound", Rect(compactHeader ? left : width - 326, toolbarY, 72, 34))) hands.quiet = !hands.quiet;

    if (PaperButton("Undo / Z", Rect(left, bottom, actionWidth, 40), workshop.historyCount > 0 && playing) || playing && (key.z.down || key.backspace.down))
        Send(Undo { serial = workshop.serial });
    if (PaperButton("Reset / R", Rect(left + actionWidth + 8, bottom, actionWidth, 40), playing) || playing && key.r.down)
        Send(Reset { serial = workshop.serial });
    if (PaperButton("Hint / H", Rect(left + (actionWidth + 8) * 2, bottom, actionWidth, 40), !hands.journal && !hands.guide) || playing && key.h.down)
        hands.hintOpen = !hands.hintOpen;
    if (narrow)
    {
        Chip(float2(left + Math.Max(110, width - 164) * .5 - 2, bottom + 70), float2(Math.Max(110, width - 164) + 8, 38));
        Paragraph("Push a room until blocked, then step inside.", float2(left, bottom + 62), Math.Max(110, width - 164), 11, MUTED);
    }

    // Every move is a bounded command from this browser's actual player.
    // A held direction waits before repeating, so precise taps stay precise.
    hands.repeat -= Math.Min(Frame.dt, 0.1);
    var direction = KeyDirection(devices, false);
    var edge = KeyDirection(devices, true);
    if (direction < 0) hands.release = false;
    if (!playing || workshop.puzzle.solved) { hands.held = -1; hands.repeat = 0.25; hands.release = direction >= 0; }
    else if (direction < 0) { hands.held = -1; hands.repeat = 0; }
    else if (!hands.release && (edge >= 0 || direction != hands.held || hands.repeat <= 0))
    {
        Send(Move { serial = workshop.serial, direction = edge >= 0 ? edge : direction });
        hands.repeat = hands.held == direction ? 0.16 : 0.28;
        hands.held = direction;
    }

    // Pointer controls also make the prototype playable without a keyboard.
    var arrowSize = narrow ? 40.0 : 42.0;
    var pad = float2(width - (narrow ? 66.0 : 90.0), height - (narrow ? 67.0 : 65.0));
    for (var d = 0; d < 4; d++)
    {
        var offset = float2(Direction(d)) * arrowSize;
        var at = pad + offset;
        var enabled = playing && !workshop.puzzle.solved;
        if (PaperButton("", Rect(at.x - arrowSize * 0.5, at.y - arrowSize * 0.5, arrowSize - 3, arrowSize - 3), enabled))
            Send(Move { serial = workshop.serial, direction = d });
        if (enabled) StepMark(at + float2(-1.5, -7), d, 6, hands.ahead[d]);
        else DirectionMark(at + float2(-1.5, -7), d, 6, MUTED);
        Label(DirectionKey(d), at + float2(-1.5, 8), 11, enabled ? INK : MUTED, Anchor.MiddleCenter);
    }
    if (!narrow && compactHeader)
    {
        Chip(float2(left + 268, height - 14), float2(552, 20));
        Label("WASD / arrows to walk and push. When a room cannot move, step into its doorway to enter.", float2(left, height - 14), 12, MUTED);
    }

    if (hands.hintOpen)
    {
        var hintWidth = Math.Min(width - 32, 590);
        var hintText = LevelHint(workshop.level, hands.hint);
        var hintHeight = Math.Max(160, 120 + WrappedLines(hintText, hintWidth - 36, 14) * 20);
        var hintAt = float2(width * 0.5, bottom - 12 - hintHeight * 0.5);
        Draw.RoundRect(hintAt, float2(hintWidth, hintHeight), 2, PAPER);
        Label($"A nudge  /  {hands.hint + 1} of 3", hintAt + float2(-hintWidth * 0.5 + 18, -hintHeight * 0.5 + 21), 12, TEAL);
        Paragraph(hintText, hintAt + float2(-hintWidth * 0.5 + 18, -hintHeight * 0.5 + 48), hintWidth - 36, 14);
        var hintButtons = hintAt.y + hintHeight * 0.5 - 43;
        Label("W up / D right / S down / A left", float2(hintAt.x - hintWidth * 0.5 + 18, hintButtons - 22), 11, MUTED);
        Label("Push a room until blocked, then step inside", float2(hintAt.x - hintWidth * 0.5 + 18, hintButtons - 8), 11, MUTED);
        if (PaperButton(hands.hint < 2 ? "More help" : "Start hints over", Rect(hintAt.x + hintWidth * 0.5 - 126, hintButtons, 108, 29))) hands.hint = (hands.hint + 1) % 3;
        if (PaperButton("Close", Rect(hintAt.x - hintWidth * 0.5 + 18, hintButtons, 65, 29))) hands.hintOpen = false;
    }

    if (workshop.puzzle.solved && !hands.journal && !hands.guide)
    {
        var at = float2(width * 0.5, height - 164);
        var boxWidth = Math.Min(width - 32, 480);
        Draw.RoundRect(at, float2(boxWidth, 139), 2, PAPER);
        Draw.WireRoundRect(at, float2(boxWidth, 139), 2, 1, MUTED);
        Label(workshop.level == LEVEL_COUNT - 1 ? "A way out, together." : "Another room beyond.", at + float2(0, -38), narrow ? 21.0 : 25.0, INK, Anchor.MiddleCenter);
        Label($"{workshop.puzzle.moves} shared moves  /  another way found", at + float2(0, -7), 13, MUTED, Anchor.MiddleCenter);
        if (workshop.level < LEVEL_COUNT - 1)
        {
            if (PaperButton("Next puzzle / Enter", Rect(at.x - 122, at.y + 18, 244, 43), together, true) || playing && key.enter.down)
                Send(Next { serial = workshop.serial });
        }
        else if (PaperButton("Visit the puzzle shelf", Rect(at.x - 122, at.y + 18, 244, 43), true, true)) hands.journal = true;
    }

    if (hands.journal)
    {
        GUILayout.Modal(Anchor.MiddleCenter, hands.journal)
        {
            GUILayout.Label("THE PUZZLE SHELF");
            GUILayout.Label("Choose your next room together.");
            GUILayout.Label("Changing puzzles resets this one.");
            for (var level = 0; level < LEVEL_COUNT; level++)
                if (GUILayout.Button($"{((workshop.completed & (1 << level)) != 0 ? "+" : " ")} {level + 1}. {LevelName(level)}"))
                {
                    Send(ChooseLevel { serial = workshop.serial, level = level });
                    hands.journal = false;
                }
            if (GUILayout.Button("Back to the room")) hands.journal = false;
        }
    }
    if (hands.guide)
    {
        GUILayout.Modal(Anchor.MiddleCenter, hands.guide)
        {
            GUILayout.Label("FIND A WAY OUT");
            GUILayout.Label("Two test dummies begin inside boxes and work outward.");
            GUILayout.Label("Your view follows your dummy between rooms.");
            GUILayout.Label("The containing world is visible beyond the walls.");
            GUILayout.Label("WASD / arrows: walk and push parcels or rooms.");
            GUILayout.Label("Rooms move first. Block a room to step inside.");
            GUILayout.Label("Beside a box: a yellow bar pushes it, a green arrow enters.");
            GUILayout.Label("Walk out through an edge door to leave.");
            GUILayout.Label("A wall, another box or your partner can stop a room.");
            GUILayout.Label("Touch: use the same directional arrows.");
            GUILayout.Label("Rooms can carry people and other rooms.");
            GUILayout.Label("Boxes can move into their own interiors.");
            GUILayout.Label("Copies of a room share its contents and people.");
            GUILayout.Label("1 is a primary box. 1' is a movable copy.");
            GUILayout.Label("Pushed objects exit beside the primary box.");
            GUILayout.Label("Boxes side by side join only where doorways line up.");
            GUILayout.Label("Joined doorways are walked through, not pushed.");
            GUILayout.Label("You return beside the entrance you used.");
            GUILayout.Label("You can enter up to eight layers deep.");
            GUILayout.Label("Box icons need parcels.");
            GUILayout.Label("Coloured outlines need their room boxes.");
            GUILayout.Label("Both dummies must reach player-marked goals.");
            GUILayout.Label("Doorways can be anywhere along a room edge.");
            GUILayout.Label("Z: shared undo. R: reset. H: three gentle hints.");
            GUILayout.Label("Talk to each other. There is no time limit.");
            GUILayout.Toggle("Ambience", hands.music);
            GUILayout.Toggle("Reduced motion", hands.reduceMotion);
            if (GUILayout.Button("Back to exploring")) hands.guide = false;
        }
    }
}
