using Rooms;

extern string InsideOutInviteBase();

void CopyInvite(mut Rooms.Lobby lobby, string room)
{
    Clipboard.Copy($"{InsideOutInviteBase()}?join={room}");
    lobby.copied = 0;
}

enum ArtStage { Backdrop, Prepare, Board, Controls, Sound }

const Color INK = Color(0.94, 0.90, 0.80);
const Color PAPER = Color(0.13, 0.105, 0.085, 0.97);
const Color MUTED = Color(0.66, 0.61, 0.53);
const Color BRASS = Color(0.76, 0.59, 0.32);
const Color SAGE = Color(0.55, 0.71, 0.55);
const Color TEAL = Color(0.22, 0.53, 0.48);
const Color AMBER = Color(0.85, 0.48, 0.27);
// Factory paints shared by the scene and its controls.
// A painted model under a lamp: brass, soft black rubber, bone white, slate.
const Color HAZARD = Color(0.84, 0.64, 0.22);
const Color RUBBER = Color(0.11, 0.11, 0.13);
const Color DECAL = Color(0.90, 0.88, 0.82);
// The table the model stands on, and the frame around it.
const Color STEEL = Color(0.33, 0.235, 0.165);
const Color FRAME = Color(0.50, 0.36, 0.24);
// The bots' paints in the scene; the words about them use AMBER and TEAL.
const Color BOT_AMBER = Color(0.93, 0.50, 0.21);
const Color BOT_TEAL = Color(0.16, 0.60, 0.56);
// Marks that glow.
const Color GLOW_GOAL = Color(0.40, 0.80, 0.70);
const Color GLOW_TARGET = Color(0.98, 0.76, 0.30);
const GUITheme ROOM_THEME = GUITheme {
    text = INK, panel = PAPER, control = Color(0.23, 0.19, 0.15),
    hot = Color(0.32, 0.26, 0.20), pressed = Color(0.17, 0.14, 0.11),
    field = Color(0.08, 0.065, 0.055), fieldHot = Color(0.22, 0.18, 0.14),
    accent = BRASS, radius = 6
};

local singleton Hands
{
    PlayerID player;
    int seat = -1;
    int level = -1;
    int serial = -1;
    int held = -1;
    bool release;
    float repeat;
    bool journal;
    bool reduceMotion;
    bool preview = true;
    int chapter;
    int pendingLevel = -1;
    bool pendingReset;
    bool confirmFromPlaying;
    float clock;
    Rooms.Page pageAtStart;
    bool preferencesLoaded;
    string savedPreferences;
    int completed;
    int swipeId = -1;
    bool swipeReady;
    float2 swipeStart;
    // How much longer each seat's bot shakes after a step that could not be
    // taken. Every screen shows it for both, so a partner sees the bump too.
    float[2] blockTime;
    float portalTime;
    Step[4] ahead;
}

void Label(string text, float2 at, float size = 16, Color color = INK, Anchor anchor = Anchor.MiddleLeft)
{
    Draw.Text(text, at, size, color, anchor);
}

void Paragraph(string words, float2 at, float width, float size = 15, Color tone = INK)
{
    mut var rest = words;
    mut var line = "";
    mut var row = 0;
    while (rest.length > 0)
    {
        var space = rest.IndexOf(' ');
        var word = space < 0 ? rest : rest.Substring(0, space);
        var next = line == "" ? word : $"{line} {word}";
        if (line != "" && Draw.MeasureText(next, size).x > width)
        {
            Label(line, at + float2(0, row * (size + 6)), size, tone);
            line = word;
            row++;
        }
        else line = next;
        rest = space < 0 ? "" : rest.Substring(space + 1);
    }
    if (line != "") Label(line, at + float2(0, row * (size + 6)), size, tone);
}

int WrappedLines(string words, float width, float size)
{
    mut var rest = words;
    mut var line = "";
    mut var rows = 1;
    while (rest.length > 0)
    {
        var space = rest.IndexOf(' ');
        var word = space < 0 ? rest : rest.Substring(0, space);
        var next = line == "" ? word : $"{line} {word}";
        if (line != "" && Draw.MeasureText(next, size).x > width)
        {
            line = word;
            rows++;
        }
        else line = next;
        rest = space < 0 ? "" : rest.Substring(space + 1);
    }
    return rows;
}

bool PaperButton(string text, Rect rect, bool enabled = true, bool accent = false)
{
    mut var clicked = false;
    GUI.Disabled(!enabled)
    {
        var control = GUI.Control(rect);
        var at = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
        var base = accent ? Color(0.45, 0.34, 0.19) : Color(0.23, 0.19, 0.15);
        var fill = !enabled ? Color(0.16, 0.135, 0.11) : control.pressed ? Math.Lerp(base, Color.black, 0.18) : control.hovered ? Math.Lerp(base, INK, 0.12) : base;
        Draw.RoundRect(at + float2(0, 3), float2(rect.width, rect.height), 6, Color(0.035, 0.025, 0.02, 0.5));
        Draw.RoundRect(at, float2(rect.width, rect.height), 6, fill);
        Draw.WireRoundRect(at, float2(rect.width, rect.height), 6, control.focused ? 2.0 : 1.0, control.focused || accent ? BRASS : Color(0.38, 0.31, 0.24));
        Label(text, at, rect.height < 35 ? 12.0 : 15.0, !enabled ? MUTED : INK, Anchor.MiddleCenter);
        if (control.hovered) Send(UiHover { x = rect.x, y = rect.y });
        if (control.clicked) UiSound(UiCue.Click);
        clicked = control.clicked;
    }
    return clicked;
}

[Stage(ArtStage.Prepare)]
[Before(Rooms.Begin, Rooms.Pages)]
view PrepareHands(Session session, Rooms.Lobby lobby, mut Hands hands, mut InterfaceFeedback feedback)
{
    hands.player = session.player;
    for (var seat = 0; seat < 2; seat++) hands.blockTime[seat] = Math.Max(0, hands.blockTime[seat] - Frame.dt);
    hands.portalTime = Math.Max(0, hands.portalTime - Frame.dt);
    hands.clock += Math.Min(Frame.dt, 0.1);
    hands.pageAtStart = lobby.page;
    feedback.remaining = Math.Max(0, feedback.remaining - Frame.dt);
    GUI.SetTheme(ROOM_THEME);
}

local event(PuzzleCue cue) FeelPuzzle(mut Hands hands)
{
    if (cue.kind == 6 && cue.seat >= 0 && cue.seat < 2) hands.blockTime[cue.seat] = 0.20;
    if (cue.seat != hands.seat) return;
    if (cue.kind == 2) hands.portalTime = 0.36;
}

string DimensionName(int room) { return room < 0 ? "Outer room" : RoomName(room); }

override string Rooms.Tagline() { return "Two test robots. Rooms within rooms. Find your way out."; }
override Rect Rooms.MenuButton(float2 screen) { return Rect(screen.x - 88, 16, 72, 42); }

override void Rooms.TitlePage(Session session, mut Rooms.Lobby lobby)
{
}

override void Rooms.JoinPage(Session session, mut Rooms.Lobby lobby) { }
override void Rooms.RoomPage(Session session, string room, mut Rooms.Lobby lobby) { }
override void Rooms.SettingsPage(mut Rooms.Lobby lobby) { }

[Stage(ArtStage.Prepare, 1)]
view Roster(Workshop workshop, mut Hands hands, mut Rooms.Lobby lobby)
{
    hands.seat = SeatOf(workshop, hands.player);
    lobby.seats = 2;
    lobby.manned = (workshop.present[0] ? 1 : 0) | (workshop.present[1] ? 2 : 0);
    lobby.mine = hands.seat;
    lobby.offersNewGame = false;
    lobby.offersBots = false;
    if (hands.level != workshop.level)
    {
        hands.level = workshop.level;
        hands.chapter = LevelChapter(workshop.level);
        hands.pendingLevel = -1;
        hands.pendingReset = false;
    }
    if (hands.serial != workshop.serial)
    {
        hands.serial = workshop.serial;
        hands.held = -1;
        hands.release = true;
        hands.repeat = 0.25;
        hands.swipeReady = false;
        hands.swipeId = -1;
    }
}

int KeyDirection(Devices devices, bool edge)
{
    var key = devices.keyboard;
    if (edge ? key.w.down || key.upArrow.down : key.w.pressed || key.upArrow.pressed) return 0;
    if (edge ? key.d.down || key.rightArrow.down : key.d.pressed || key.rightArrow.pressed) return 1;
    if (edge ? key.s.down || key.downArrow.down : key.s.pressed || key.downArrow.pressed) return 2;
    if (edge ? key.a.down || key.leftArrow.down : key.a.pressed || key.leftArrow.pressed) return 3;
    return -1;
}

[Stage(ArtStage.Controls)]
[Before(Rooms.Pages)]
view WorkshopControls(Workshop workshop, Time time, Session session, Devices devices, mut Rooms.Lobby lobby, mut Hands hands)
{
    Draw.SetScreen();
    if (lobby.page != Rooms.Page.Playing) return;
    // This game sends commands from a view rather than sampling an input.
    // Keep gameplay keys here so arrows cannot start navigating HUD widgets.
    GUI.ClaimKeyboard();
    var key = devices.keyboard;
    if (key.escape.down || devices.gamepad.start.down)
    {
        lobby.page = Rooms.Page.Room;
        lobby.resume = true;
        UiSound(UiCue.Open);
        return;
    }
    var width = Screen.width;
    var height = Screen.height;
    var narrow = width < 720;
    var together = Together(workshop);
    var overlay = hands.journal || hands.pendingReset || hands.pendingLevel >= 0;
    var playing = lobby.playing && together && hands.seat >= 0 && !overlay;
    var revealing = time.tick - workshop.openedTick < REVEAL_TICKS;
    for (var d = 0; d < 4; d++)
    {
        hands.ahead[d] = Step.Blocked;
        if (!playing || revealing || workshop.puzzle.solved || !hands.preview) continue;
        mut var trial = workshop.puzzle;
        MovePuzzle(workshop.layout, trial, hands.seat, d, out var step);
        hands.ahead[d] = step;
    }
    if (overlay) return;
    if (!together)
    {
        var boxWidth = Math.Min(width - 32, 480);
        var at = float2(width * .5, height * .53);
        Panel(at, float2(boxWidth, 270));
        Heading("A place for your partner", at + float2(0, -95), narrow ? 22.0 : 28.0);
        Label("Share your invite with a friend.", at + float2(0, -55), 14, MUTED, Anchor.MiddleCenter);
        if (session.room != "")
        {
            Heading(session.room, at + float2(0, -6), 38, BRASS);
            var buttonWidth = (boxWidth - 60) * .5;
            if (PaperButton(lobby.copied < 1.5 ? "Copied" : "Copy invite", Rect(at.x - boxWidth * .5 + 24, at.y + 26, buttonWidth, 44), true, true))
                CopyInvite(lobby, session.room);
            if (PaperButton("Copy code", Rect(at.x + 6, at.y + 26, buttonWidth, 44))) Rooms.CopyCode(lobby, session.room);
        }
        else if (session.server && !session.open)
        {
            if (PaperButton("Open a room", Rect(at.x - 100, at.y + 26, 200, 44), session.state == SessionState.Connected, true)) Session.Open();
        }
        else Label("Opening your room...", at + float2(0, 32), 15, MUTED, Anchor.MiddleCenter);
        Label("The puzzle begins when you're both here.", at + float2(0, 102), narrow ? 12.0 : 14.0, MUTED, Anchor.MiddleCenter);
        return;
    }
    var left = narrow ? 16.0 : 24.0;
    for (var seat = 0; seat < 2; seat++)
    {
        var actor = workshop.puzzle.actors[seat];
        var name = seat == 0 ? "Amber" : "Teal";
        var who = seat == hands.seat ? $"You: {name}" : name;
        var plateWidth = narrow ? (width - 40) * .5 : 224.0;
        var plate = float2(left + plateWidth * .5 + seat * (plateWidth + 8), height - (narrow ? 148.0 : 28.0));
        Chip(plate, float2(plateWidth, 28));
        Label($"{who} / {DimensionName(actor.room)}", plate, narrow ? 10.0 : 12.0, seat == 0 ? AMBER : TEAL, Anchor.MiddleCenter);
    }
    var bottom = height - 92;
    if (PaperButton("Undo", Rect(left, bottom, 82, 40), workshop.historyCount > 0 && playing) || playing && (key.z.down || key.backspace.down))
        Send(Undo { serial = workshop.serial });
    if (PaperButton("Restart", Rect(left + 90, bottom, 82, 40), playing) || playing && key.r.down)
    {
        hands.pendingReset = true;
        hands.confirmFromPlaying = true;
        lobby.page = Rooms.Page.Room;
        lobby.resume = true;
        UiSound(UiCue.Open);
    }
    hands.repeat -= Math.Min(Frame.dt, .1);
    var direction = KeyDirection(devices, false);
    var edge = KeyDirection(devices, true);
    if (direction < 0) hands.release = false;
    if (!playing || revealing || workshop.puzzle.solved)
    {
        hands.held = -1;
        hands.repeat = .25;
        hands.release = direction >= 0;
        hands.swipeReady = false;
    }
    else if (direction < 0) { hands.held = -1; hands.repeat = 0; }
    else if (!hands.release && (edge >= 0 || direction != hands.held || hands.repeat <= 0))
    {
        Send(Move { serial = workshop.serial, direction = edge >= 0 ? edge : direction });
        hands.repeat = hands.held == direction ? .16 : .28;
        hands.held = direction;
    }
    // One deliberate swipe is one step. No persistent directional overlay
    // occupies either the desktop or a phone's board.
    var touch = devices.touchscreen.primaryTouch;
    if (playing && !revealing && !workshop.puzzle.solved)
    {
        if (touch.press.down)
        {
            hands.swipeId = touch.id;
            hands.swipeStart = touch.position;
            hands.swipeReady = true;
        }
        if (hands.swipeReady && touch.press.pressed && touch.id == hands.swipeId)
        {
            var swipe = touch.position - hands.swipeStart;
            if (Math.Length(swipe) >= 28)
            {
                var dir = Math.Abs(swipe.x) > Math.Abs(swipe.y) ? (swipe.x > 0 ? 1 : 3) : (swipe.y > 0 ? 0 : 2);
                Send(Move { serial = workshop.serial, direction = dir });
                hands.swipeReady = false;
            }
        }
    }
    if (!touch.press.pressed) hands.swipeReady = false;
}

// Hover events carry the control's position so moving between controls makes
// one quiet tick, rather than a sound every frame the pointer rests on one.
local event UiHover { float x; float y; }
local singleton InterfaceFeedback { float x = -1; float y = -1; float remaining; }
local event(UiHover hover) HearHover(mut InterfaceFeedback feedback)
{
    if (feedback.remaining <= 0 || feedback.x != hover.x || feedback.y != hover.y) UiSound(UiCue.Hover);
    feedback.x = hover.x;
    feedback.y = hover.y;
    feedback.remaining = .1;
}

void Heading(string text, float2 at, float size = 28, Color tone = INK)
{
    Draw.Text(text, at, size, tone, Anchor.MiddleCenter, Font.Bold);
}

void Panel(float2 at, float2 size)
{
    Draw.RoundRect(at + float2(0, 6), size, 8, Color(.025, .018, .012, .5));
    Draw.RoundRect(at, size, 8, PAPER);
    Draw.WireRoundRect(at, size, 8, 1, Color(.39, .31, .23));
}

Rect MenuCard(float width, float height)
{
    var fittedHeight = Math.Min(Screen.height - 32, height);
    return Rect((Screen.width - Math.Min(Screen.width - 32, width)) * .5, (Screen.height - fittedHeight) * .5,
        Math.Min(Screen.width - 32, width), fittedHeight);
}

void PagePanel(Rect card, string title, string subtitle = "")
{
    GUI.Navigate();
    GUI.ClaimPointer(Rect(0, 0, Screen.width, Screen.height));
    Draw.Rect(float2(Screen.width, Screen.height) * .5, float2(Screen.width, Screen.height), Color(.045, .03, .02, .72));
    Panel(float2(card.x + card.width * .5, card.y + card.height * .5), float2(card.width, card.height));
    Heading(title, float2(Screen.width * .5, card.y + 38), 30);
    if (subtitle != "") Paragraph(subtitle, float2(card.x + 24, card.y + 78), card.width - 48, 14, MUTED);
}

bool MenuBack(Rect card)
{
    var back = PaperButton("Back", Rect(card.x + 24, card.y + card.height - 66, card.width - 48, 44));
    if (back) UiSound(UiCue.Back);
    return back;
}

struct Preferences
{
    int version = 1;
    float master = 1;
    float music = .8;
    float effects = 1;
    float interface = .8;
    bool muted;
    bool reducedMotion;
    bool preview = true;
    int completed;
}

Preferences CurrentPreferences(Rooms.Lobby lobby, Mixer mixer, Hands hands)
{
    return Preferences { master = lobby.volume, music = mixer.music, effects = mixer.effects, interface = mixer.interface,
        muted = mixer.muted, reducedMotion = hands.reduceMotion, preview = hands.preview, completed = hands.completed };
}

void WritePreferences(string text) fails IOError
{
    try Directory.CreateDirectory(Application.persistentDataPath);
    try File.WriteAllText(Path.Combine(Application.persistentDataPath, "preferences.json"), text);
}

[Stage(ArtStage.Prepare, -1)]
[Before(PrepareHands, Rooms.Begin, Rooms.Volume)]
view ReadPreferences(mut Rooms.Lobby lobby, mut Hands hands, mut Mixer mixer)
{
    if (hands.preferencesLoaded) return;
    hands.preferencesLoaded = true;
    if (File.ReadAllText(Path.Combine(Application.persistentDataPath, "preferences.json")) is string text)
    {
        if (Json.Read<Preferences>(text) is Preferences saved)
        {
            lobby.volume = Math.Clamp(saved.master, 0, 1);
            mixer.music = Math.Clamp(saved.music, 0, 1);
            mixer.effects = Math.Clamp(saved.effects, 0, 1);
            mixer.interface = Math.Clamp(saved.interface, 0, 1);
            mixer.muted = saved.muted;
            hands.reduceMotion = saved.reducedMotion;
            hands.preview = saved.preview;
            hands.completed = saved.completed & ((1 << LEVEL_COUNT) - 1);
        }
    }
    hands.savedPreferences = Json.Write(CurrentPreferences(lobby, mixer, hands));
}

[Stage(ArtStage.Sound, -1)]
view SavePreferences(Workshop workshop, Rooms.Lobby lobby, Mixer mixer, mut Hands hands)
{
    if (!hands.preferencesLoaded) return;
    hands.completed |= workshop.completed;
    var text = Json.Write(CurrentPreferences(lobby, mixer, hands));
    if (text == hands.savedPreferences) return;
    hands.savedPreferences = text;
    // Disk and browser-storage failures leave the running settings intact.
    if (WritePreferences(text) is IOError) return;
}

[Stage(ArtStage.Controls, 1)]
[After(Rooms.Pages)]
view GamePages(Workshop workshop, Session session, Devices devices, mut Rooms.Lobby lobby, mut Hands hands, mut Mixer mixer)
{
    Draw.SetScreen();
    mut var escape = devices.keyboard.escape.down || devices.gamepad.buttonEast.down;
    // The Escape that opened Rooms' menu is not also its Back action.
    if (hands.pageAtStart != lobby.page) escape = false;
    if (hands.pendingReset || hands.pendingLevel >= 0)
    {
        var card = MenuCard(480, 300);
        PagePanel(card, hands.pendingReset ? "Restart this puzzle?" : "Change puzzle?", "This restarts the puzzle for both of you. Your shared undo history will be cleared.");
        if (PaperButton(hands.pendingReset ? "Restart puzzle" : "Choose puzzle", Rect(card.x + 24, card.y + 166, card.width - 48, 44), Together(workshop), true))
        {
            if (hands.pendingReset) Send(Reset { serial = workshop.serial });
            else Send(ChooseLevel { serial = workshop.serial, level = hands.pendingLevel });
            hands.pendingReset = false;
            hands.pendingLevel = -1;
            hands.journal = false;
            Rooms.Resume(lobby);
        }
        if (MenuBack(card) || escape)
        {
            hands.pendingReset = false;
            hands.pendingLevel = -1;
            if (hands.confirmFromPlaying) Rooms.Resume(lobby);
            hands.confirmFromPlaying = false;
            UiSound(UiCue.Back);
        }
        return;
    }
    if (hands.journal)
    {
        var card = MenuCard(740, Math.Min(Screen.height - 40, 650));
        PagePanel(card, "Choose puzzle", "Find your next room together.");
        var tabs = (card.width - 48) / CHAPTER_COUNT;
        for (var ch = 0; ch < CHAPTER_COUNT; ch++)
        {
            if (PaperButton($"{ch + 1}", Rect(card.x + 24 + ch * tabs, card.y + 114, tabs - 6, 40), true, ch == hands.chapter))
                hands.chapter = ch;
        }
        Label($"CHAPTER {hands.chapter + 1} / {ChapterName(hands.chapter)}", float2(card.x + 24, card.y + 180), 14, BRASS);
        mut var row = 0;
        for (var level = 0; level < LEVEL_COUNT; level++)
        {
            if (LevelChapter(level) != hands.chapter) continue;
            var solved = ((workshop.completed | hands.completed) & (1 << level)) != 0;
            var label = $"{level + 1:D2}   {LevelName(level)}";
            if (PaperButton(label, Rect(card.x + 24, card.y + 204 + row * 57, card.width - 48, 48), Together(workshop), level == workshop.level))
            {
                if (level == workshop.level) { hands.journal = false; Rooms.Resume(lobby); }
                else if (workshop.puzzle.moves > 0) hands.pendingLevel = level;
                else
                {
                    Send(ChooseLevel { serial = workshop.serial, level = level });
                    hands.journal = false;
                    Rooms.Resume(lobby);
                }
            }
            if (solved)
            {
                var tick = float2(card.x + card.width - 42, card.y + 228 + row * 57);
                Draw.Line(tick - float2(7, 0), tick - float2(2, -5), 2, SAGE);
                Draw.Line(tick - float2(2, -5), tick + float2(8, -7), 2, SAGE);
            }
            row++;
        }
        if (MenuBack(card) || escape) { hands.journal = false; UiSound(UiCue.Back); }
        return;
    }
    if (lobby.page == Rooms.Page.Playing) return;

    if (lobby.page == Rooms.Page.Title)
    {
        var card = MenuCard(510, 500);
        GUI.Navigate();
        GUI.ClaimPointer(Rect(0, 0, Screen.width, Screen.height));
        Draw.Rect(float2(Screen.width, Screen.height) * .5, float2(Screen.width, Screen.height), Color(.075, .055, .035));
        // Finite nested frames give the title a gentle, endless inward drift.
        for (var i = 0; i < 12; i++)
        {
            var phase = hands.reduceMotion ? .4 : hands.clock * .09 - Math.Floor(hands.clock * .09);
            var side = Math.Pow(.73, i + phase) * Math.Max(Screen.width, Screen.height) * 1.5;
            Draw.WireRoundRect(float2(Screen.width * .5, Screen.height * .46), float2(side), 8, 2, Math.Lerp(RoomColor(i % 4), Color(.075, .055, .035), .68));
        }
        Panel(float2(Screen.width * .5, Screen.height * .5), float2(card.width, card.height));
        for (var i = 0; i < 4; i++)
            Draw.WireRoundRect(float2(Screen.width * .5, card.y + 50), float2(44 - i * 10), 2, 3, RoomColor(i));
        Heading("inside out", float2(Screen.width * .5, card.y + 117), 54);
        Label("Small rooms. A little perspective. Two of you.", float2(Screen.width * .5, card.y + 164), Screen.width < 720 ? 13.0 : 15.0, MUTED, Anchor.MiddleCenter);
        var x = card.x + 32;
        var w = card.width - 64;
        if (PaperButton("Host a room", Rect(x, card.y + 212, w, 48), session.state == SessionState.Connected, true))
        {
            Rooms.Host(lobby);
            Rooms.Resume(lobby);
            UiSound(UiCue.Open);
        }
        if (PaperButton("Join a friend", Rect(x, card.y + 272, w, 48))) { Rooms.ShowJoin(lobby); UiSound(UiCue.Open); }
        if (PaperButton("Settings", Rect(x, card.y + 332, w, 48))) { Rooms.ShowSettings(lobby); UiSound(UiCue.Open); }
        Label($"{LEVEL_COUNT} puzzles / {CHAPTER_COUNT} chapters", float2(Screen.width * .5, card.y + 412), 13, BRASS, Anchor.MiddleCenter);
        Label("A puzzle game for two. Play together online.", float2(Screen.width * .5, card.y + 444), Screen.width < 720 ? 12.0 : 14.0, MUTED, Anchor.MiddleCenter);
        if (lobby.message != "") Paragraph(lobby.message, float2(x, card.y + 473), w, 12, AMBER);
        return;
    }
    if (lobby.page == Rooms.Page.Join)
    {
        var busy = lobby.joining && session.state == SessionState.Connecting;
        var card = MenuCard(480, 360);
        PagePanel(card, busy ? "Joining your friend" : "Join a friend", busy ? "Making a little room for you..." : "Enter the room code your friend is hosting.");
        if (busy) Heading(lobby.code, float2(Screen.width * .5, card.y + 172), 38, BRASS);
        else
        {
            GUI.TextField(Rect(card.x + 24, card.y + 130, card.width - 48, 52), "Code", lobby.code, out var entered);
            lobby.code = lobby.code.ToUpper();
            var code = lobby.code.Trim();
            if ((PaperButton("Join", Rect(card.x + 24, card.y + 198, card.width - 48, 46), code != "", true) || entered) && code != "")
                Rooms.Join(lobby, code);
            if (lobby.message != "") Paragraph(lobby.message, float2(card.x + 24, card.y + 267), card.width - 48, 12, AMBER);
        }
        if (MenuBack(card) || escape) { Rooms.LeaveJoin(session, lobby); UiSound(UiCue.Back); }
        return;
    }
    if (lobby.page == Rooms.Page.Settings)
    {
        var card = MenuCard(520, 570);
        var compact = card.height / 570;
        PagePanel(card, "Settings", "Make yourself at home. These settings are yours.");
        Label("SOUND", float2(card.x + 24, card.y + 120 * compact), 12, BRASS);
        if (GUI.Slider(Rect(card.x + 24, card.y + 142 * compact, card.width - 48, 36), "Master", lobby.volume, 0, 1)) UiSound(UiCue.Slide);
        if (GUI.Slider(Rect(card.x + 24, card.y + 188 * compact, card.width - 48, 36), "Music", mixer.music, 0, 1)) UiSound(UiCue.Slide);
        if (GUI.Slider(Rect(card.x + 24, card.y + 234 * compact, card.width - 48, 36), "Effects", mixer.effects, 0, 1)) UiSound(UiCue.Slide);
        if (GUI.Slider(Rect(card.x + 24, card.y + 280 * compact, card.width - 48, 36), "Interface", mixer.interface, 0, 1)) UiSound(UiCue.Slide);
        if (GUI.Toggle(Rect(card.x + 24, card.y + 326 * compact, card.width - 48, 38), "Mute all sound", mixer.muted)) UiSound(UiCue.Toggle);
        Label("GAMEPLAY", float2(card.x + 24, card.y + 393 * compact), 12, BRASS);
        if (GUI.Toggle(Rect(card.x + 24, card.y + 414 * compact, card.width - 48, 38), "Reduced motion", hands.reduceMotion)) UiSound(UiCue.Toggle);
        if (GUI.Toggle(Rect(card.x + 24, card.y + 460 * compact, card.width - 48, 38), "Step preview", hands.preview)) UiSound(UiCue.Toggle);
        if (MenuBack(card) || escape) { Rooms.LeaveSettings(lobby); UiSound(UiCue.Back); }
        return;
    }
    if (lobby.page == Rooms.Page.Room)
    {
        var card = MenuCard(500, 590);
        var compact = card.height / 590;
        PagePanel(card, "Menu", "The game keeps going for your partner.");
        var x = card.x + 24;
        var w = card.width - 48;
        if (PaperButton("Resume", Rect(x, card.y + 122 * compact, w, 46), true, true)) { Rooms.Resume(lobby); UiSound(UiCue.Back); }
        if (PaperButton("Restart puzzle", Rect(x, card.y + 180 * compact, w, 46), Together(workshop)))
        {
            hands.pendingReset = true;
            hands.confirmFromPlaying = false;
        }
        if (PaperButton("Choose puzzle", Rect(x, card.y + 238 * compact, w, 46))) { hands.journal = true; UiSound(UiCue.Open); }
        if (PaperButton("Settings", Rect(x, card.y + 296 * compact, w, 46))) { Rooms.ShowSettings(lobby); UiSound(UiCue.Open); }
        Label(session.room != "" ? $"ROOM / {session.room}" : "Opening your room...", float2(Screen.width * .5, card.y + 381 * compact), 17, BRASS, Anchor.MiddleCenter);
        if (PaperButton(lobby.copied < 1.5 ? "Copied" : "Copy invite", Rect(x, card.y + 406 * compact, (w - 12) * .5, 42), session.room != "", true)) CopyInvite(lobby, session.room);
        if (PaperButton("Copy code", Rect(x + (w + 12) * .5, card.y + 406 * compact, (w - 12) * .5, 42), session.room != "")) Rooms.CopyCode(lobby, session.room);
        if (PaperButton("Leave the room", Rect(x, card.y + 482 * compact, w, 44))) { Rooms.Leave(session, lobby); UiSound(UiCue.Back); }
        Label("Escape to return", float2(Screen.width * .5, card.y + 552 * compact), 12, MUTED, Anchor.MiddleCenter);
        if (escape) { Rooms.Resume(lobby); UiSound(UiCue.Back); }
    }
}
