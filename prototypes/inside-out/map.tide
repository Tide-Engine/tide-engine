// All dimensions use the same stable paper map on both players' screens.
struct MapLens
{
    float2 center;
    float2 size;
    float2 origin;
    float tile;
}

MapLens WorkshopLens(float2 screen, int roomCount, int room)
{
    var narrow = screen.x < 720;
    var width = Math.Min(screen.x - 36, 1180);
    var left = (screen.x - width) * 0.5;
    var top = screen.x < 1050 ? 154.0 : 126.0;
    var height = Math.Max(200, screen.y - top - (narrow ? 200 : 110));
    var mainWidth = narrow ? width : width * 0.56 - 8;
    var mainHeight = narrow ? height * (roomCount <= 2 ? 0.59 : 0.50) : height;
    mut var center = float2(left + mainWidth * 0.5, top + mainHeight * 0.5);
    mut var size = float2(mainWidth, mainHeight);
    if (room >= 0)
    {
        var columns = narrow ? (roomCount == 1 ? 1 : 2) : (roomCount <= 2 ? 1 : 2);
        var rows = (Math.Max(1, roomCount) + columns - 1) / columns;
        var regionWidth = narrow ? width : width - mainWidth - 24;
        var regionHeight = narrow ? height - mainHeight - 12 : height;
        var cardWidth = (regionWidth - (columns - 1) * 12) / columns;
        var cardHeight = (regionHeight - (rows - 1) * 12) / rows;
        var cardLeft = narrow ? left : left + mainWidth + 24;
        var cardTop = narrow ? top + mainHeight + 12 : top;
        size = float2(cardWidth, cardHeight);
        center = float2(cardLeft + (room % columns) * (cardWidth + 12) + cardWidth * 0.5,
            cardTop + (room / columns) * (cardHeight + 12) + cardHeight * 0.5);
    }
    var cells = room < 0 ? OUTER_SIZE : INNER_SIZE;
    var tile = Math.Max(5, Math.Min(size.x - (room < 0 ? 42 : 24), size.y - (room < 0 ? 66 : 44)) / cells);
    var origin = center + float2(0, room < 0 ? 6 : 1) - float2((cells - 1) * tile * 0.5);
    return MapLens { center = center, size = size, origin = origin, tile = tile };
}

float2 MapPoint(float2 cell, MapLens lens) { return lens.origin + cell * lens.tile; }

void InfinityMark(float2 at, float size, Color tone)
{
    // Geometric loops remain clear even on fonts without an infinity glyph.
    Draw.WireEllipse(at + float2(-size * 0.18, 0), float2(size * 0.25, size * 0.17), Math.Max(1, size * 0.055), tone);
    Draw.WireEllipse(at + float2(size * 0.18, 0), float2(size * 0.25, size * 0.17), Math.Max(1, size * 0.055), tone);
}

void DoorNotches(float2 center, float width, int doors, Color tone)
{
    for (var direction = 0; direction < 4; direction++)
    {
        if ((doors & (1 << direction)) == 0) continue;
        var delta = float2(Direction(direction));
        var edge = center + delta * width * 0.5;
        var across = float2(-delta.y, delta.x);
        Draw.Line(edge - across * width * 0.12, edge + across * width * 0.12, Math.Max(2, width * 0.10), Color(1, 0.95, 0.71));
        Draw.Line(edge - across * width * 0.09, edge + across * width * 0.09, Math.Max(1, width * 0.035), tone);
    }
}
