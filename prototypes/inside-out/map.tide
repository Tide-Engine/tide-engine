// A box's longest edge fills one containing cell. Its miniature, focused
// room and doorway passage all use this same rectangular transform.
const float PASSAGE_SECONDS = 0.55;
float RoomScale(LevelLayout layout, int room)
{
    return 1.0 / Math.Max(RoomWidth(layout, room), RoomHeight(layout, room));
}
float2 RoomDimensions(LevelLayout layout, int room)
{
    return float2(RoomWidth(layout, room), RoomHeight(layout, room));
}

struct MapLens
{
    float2 center;
    float2 size;
    float2 origin;
    float tile;
}

MapLens WorkshopLens(LevelLayout layout, float2 screen, int room)
{
    var narrow = screen.x < 720;
    var width = Math.Min(screen.x - 36, 1180);
    var left = (screen.x - width) * 0.5;
    var top = screen.x < 1050 ? 154.0 : 126.0;
    var height = Math.Max(200, screen.y - top - (narrow ? 200 : 110));
    var center = float2(left + width * 0.5, top + height * 0.5);
    var size = float2(width, height);
    var cells = Math.Max(RoomWidth(layout, room), RoomHeight(layout, room));
    var side = Math.Min(size.x - 24, size.y - 62);
    // Fixed room framing includes a slice of a maker beside its outer shell.
    // The partner's position never changes this scale or center.
    var tile = Math.Max(5, room < 0 ? side * 0.96 / cells : side / (cells + 6));
    var origin = center + float2(0, 9) - RoomCenter(layout, room) * tile;
    return MapLens { center = center, size = size, origin = origin, tile = tile };
}

float2 MapPoint(float2 cell, MapLens lens) { return lens.origin + cell * lens.tile; }

struct RoomSurround
{
    int room = -1;
    float2 anchor;
    int box = -1;
    bool reference;
}

// A maker has one visible pose while crossing a doorway. Its position and
// size live in the actual containing room, so every camera projects the same
// passage rather than interpolating unrelated grid coordinates.
struct MakerPassage
{
    bool active;
    bool entering;
    bool sourceInside;
    bool visualInside;
    bool bridge;
    int child = -1;
    int side;
    int fromChild = -1;
    int fromSide;
    RoomSurround gate;
    RoomSurround fromGate;
    float2 source;
    float sourceScale = 1;
    float2 target;
    float2 lip;
    float2 fromLip;
    float age;
    float2 position;
    float scale = 1;
    float2 aliasSource;
    float2 aliasPosition;
    float aliasFrom;
    float aliasAlpha;
}

float2 PassageAnchor(RoomSurround gate, Picture picture)
{
    return gate.box >= 0 && gate.box < 8 ? picture.boxes[gate.box] : gate.anchor;
}

bool SameGate(RoomSurround a, RoomSurround b)
{
    return a.room == b.room && a.box == b.box;
}

bool SameEntrance(Traveler a, Traveler b)
{
    if (a.depth != b.depth) return false;
    if (a.depth <= 0 || a.depth > MAX_DEPTH) return true;
    var first = a.trail[a.depth - 1];
    var second = b.trail[b.depth - 1];
    return first.box == second.box;
}

float PassageEase(float value)
{
    var t = Math.Clamp(value, 0, 1);
    return t * t * (3 - 2 * t);
}

int PassageSide(float2 outward)
{
    if (Math.Abs(outward.x) > Math.Abs(outward.y)) return outward.x < 0 ? 3 : 1;
    return outward.y < 0 ? 0 : 2;
}

float2 DoorLip(LevelLayout layout, int room, int side)
{
    // Move only the outward coordinate to the footprint edge. An offset
    // doorway retains its exact tangent, including a corner entrance.
    return (float2(DoorCell(layout, room, side)) - RoomCenter(layout, room) +
        float2(Direction(side)) * 0.5) * RoomScale(layout, room);
}

MakerPassage BeginPassage(Workshop workshop, Picture picture, int seat, Traveler before, Traveler after, bool capturedSource = false)
{
    var destination = ReturnSurround(workshop, after, picture);
    var previous = ReturnSurround(workshop, before, picture);
    mut var trip = MakerPassage { child = after.room, target = float2(after.position) };
    if (before.room >= 0 && after.room >= 0 && before.depth == after.depth &&
        previous.room == destination.room && !SameGate(previous, destination))
    {
        trip.entering = true;
        trip.bridge = true;
        trip.sourceInside = true;
        trip.gate = destination;
        trip.fromGate = previous;
        trip.fromChild = before.room;
        trip.fromSide = PassageSide(destination.anchor - previous.anchor);
        trip.side = (trip.fromSide + 2) % 4;
    }
    else if (after.depth > before.depth && destination.room == before.room)
    {
        trip.entering = true;
        trip.gate = destination;
        trip.side = PassageSide(float2(before.position) - destination.anchor);
    }
    else if (previous.room == after.room && before.room >= 0)
    {
        trip.child = before.room;
        trip.gate = previous;
        trip.sourceInside = true;
        trip.side = PassageSide(float2(after.position) - previous.anchor);
    }
    else if (after.room != before.room && destination.room == before.room)
    {
        trip.entering = true;
        trip.gate = destination;
        trip.side = PassageSide(float2(before.position) - destination.anchor);
    }
    else if (before.room >= 0 && after.room >= 0 && previous.room == destination.room)
    {
        // One production action can leave a room and immediately enter an
        // adjacent doorway, without changing trail depth.
        trip.entering = true;
        trip.bridge = true;
        trip.sourceInside = true;
        trip.gate = destination;
        trip.fromGate = previous;
        trip.fromChild = before.room;
        trip.fromSide = PassageSide(destination.anchor - previous.anchor);
        trip.side = (trip.fromSide + 2) % 4;
    }
    else return trip;
    trip.active = true;
    var scale = RoomScale(workshop.layout, trip.child);
    var center = RoomCenter(workshop.layout, trip.child);
    trip.lip = DoorLip(workshop.layout, trip.child, trip.side);
    if (trip.bridge) trip.fromLip = DoorLip(workshop.layout, trip.fromChild, trip.fromSide);
    var old = picture.passages[seat];
    if (old.active && old.gate.room == trip.gate.room)
    {
        trip.source = old.position;
        trip.sourceScale = old.scale;
        if (SameGate(old.gate, trip.gate)) trip.sourceInside = old.visualInside;
    }
    else if (before.room == trip.gate.room && !trip.sourceInside)
    {
        trip.source = capturedSource ? float2(before.position) : picture.actors[seat];
        trip.sourceScale = capturedSource ? 1.0 : picture.actorScale[seat];
    }
    else
    {
        var from = trip.bridge ? previous : trip.gate;
        var cell = capturedSource ? float2(before.position) : picture.actors[seat];
        trip.source = PassageAnchor(from, picture) + (cell - RoomCenter(workshop.layout, before.room)) * RoomScale(workshop.layout, before.room);
        trip.sourceScale = (capturedSource ? 1.0 : picture.actorScale[seat]) * RoomScale(workshop.layout, before.room);
    }
    trip.position = trip.source;
    trip.scale = trip.sourceScale;
    trip.visualInside = trip.sourceInside;
    trip.aliasSource = trip.entering ? trip.lip / scale + center :
        (trip.source - PassageAnchor(trip.gate, picture)) / scale + center;
    trip.aliasFrom = trip.entering ? 0.0 : 1.0;
    if (old.active && old.child == trip.child)
    {
        trip.aliasSource = old.aliasPosition;
        trip.aliasFrom = old.aliasAlpha;
    }
    trip.aliasPosition = trip.aliasSource;
    trip.aliasAlpha = trip.aliasFrom;
    return trip;
}

void PassagePose(LevelLayout layout, mut MakerPassage trip, Picture picture)
{
    var progress = Math.Min(1, trip.age / PASSAGE_SECONDS);
    var scale = RoomScale(layout, trip.child);
    var center = RoomCenter(layout, trip.child);
    var anchor = PassageAnchor(trip.gate, picture);
    var lip = anchor + trip.lip;
    var destination = trip.entering ? anchor + (trip.target - center) * scale : trip.target;
    var approach = lip + float2(Direction(trip.side)) * 0.24;
    if (trip.bridge)
    {
        var oldLip = PassageAnchor(trip.fromGate, picture) + trip.fromLip;
        var fromScale = RoomScale(layout, trip.fromChild);
        var halfway = (oldLip + lip) * 0.5;
        if (progress < 0.20)
        {
            var blend = PassageEase(progress / 0.20);
            trip.position = Math.Lerp(trip.source, oldLip, blend);
            trip.scale = Math.Lerp(trip.sourceScale, fromScale, blend);
        }
        else if (progress < 0.50)
        {
            var blend = PassageEase((progress - 0.20) / 0.30);
            trip.position = Math.Lerp(oldLip, halfway, blend);
            trip.scale = Math.Lerp(fromScale, 1, blend);
        }
        else if (progress < 0.80)
        {
            var blend = PassageEase((progress - 0.50) / 0.30);
            trip.position = Math.Lerp(halfway, lip, blend);
            trip.scale = Math.Lerp(1, scale, blend);
        }
        else
        {
            trip.position = Math.Lerp(lip, destination, PassageEase((progress - 0.80) / 0.20));
            trip.scale = scale;
        }
        trip.visualInside = progress >= 0.80;
    }
    else if (trip.entering && !trip.sourceInside)
    {
        if (progress < 0.35)
        {
            trip.position = Math.Lerp(trip.source, approach, PassageEase(progress / 0.35));
            trip.scale = trip.sourceScale;
        }
        else if (progress < 0.70)
        {
            var blend = PassageEase((progress - 0.35) / 0.35);
            trip.position = Math.Lerp(approach, lip, blend);
            trip.scale = Math.Lerp(trip.sourceScale, scale, blend);
        }
        else
        {
            trip.position = Math.Lerp(lip, destination, PassageEase((progress - 0.70) / 0.30));
            trip.scale = scale;
        }
        trip.visualInside = progress >= 0.70;
    }
    else if (!trip.entering && trip.sourceInside)
    {
        if (progress < 0.30)
        {
            var blend = PassageEase(progress / 0.30);
            trip.position = Math.Lerp(trip.source, lip, blend);
            trip.scale = Math.Lerp(trip.sourceScale, scale, blend);
        }
        else if (progress < 0.65)
        {
            var blend = PassageEase((progress - 0.30) / 0.35);
            trip.position = Math.Lerp(lip, approach, blend);
            trip.scale = Math.Lerp(scale, 1, blend);
        }
        else
        {
            trip.position = Math.Lerp(approach, destination, PassageEase((progress - 0.65) / 0.35));
            trip.scale = 1;
        }
        trip.visualInside = progress < 0.30;
    }
    else
    {
        var blend = PassageEase(progress);
        trip.position = Math.Lerp(trip.source, destination, blend);
        trip.scale = Math.Lerp(trip.sourceScale, trip.entering ? scale : 1.0, blend);
        trip.visualInside = trip.sourceInside;
    }
    // Canonical copies can occur through a movable reference or a containment
    // cycle. Their edge passage crossfades with the actual gateway pose, using
    // the same policy for every box rather than popping recursive aliases.
    var aliasBlend = trip.entering ? PassageEase((progress - (trip.bridge ? 0.80 : 0.70)) / (trip.bridge ? 0.20 : 0.30)) : PassageEase(progress / 0.30);
    trip.aliasPosition = Math.Lerp(trip.aliasSource, trip.entering ? trip.target : trip.lip / scale + center, aliasBlend);
    trip.aliasAlpha = Math.Lerp(trip.aliasFrom, trip.entering ? 1.0 : 0.0, aliasBlend);
    if (!trip.entering && trip.gate.room == trip.child && progress > 0.65)
    {
        // A self exit reaches another occurrence of the same shared room.
        // Its canonical copies arrive at the parent pose before completion,
        // rather than suddenly reappearing when the passage is retired.
        trip.aliasPosition = trip.position;
        trip.aliasAlpha = PassageEase((progress - 0.65) / 0.35);
    }
}

RoomSurround AncestorSurround(Workshop workshop, Traveler actor, int room, int layer, Picture picture)
{
    mut var surround = RoomSurround { };
    if (room < 0 || room >= workshop.layout.roomCount) return surround;
    mut var entry = Entry { box = room };
    var step = actor.depth - 1 - layer;
    if (step >= 0 && step < MAX_DEPTH && EntryDestination(workshop.layout, actor.trail[step]) == room)
        entry = actor.trail[step];
    if (ValidBox(workshop.layout, entry.box))
    {
        surround.room = BoxPlacement(workshop.layout, workshop.puzzle, entry.box).room;
        surround.anchor = picture.boxes[entry.box];
        surround.box = entry.box;
        surround.reference = entry.box >= MAX_ROOMS;
    }
    return surround;
}

RoomSurround ReturnSurround(Workshop workshop, Traveler actor, Picture picture)
{
    return AncestorSurround(workshop, actor, actor.room, 0, picture);
}

MapLens InteriorLens(LevelLayout layout, int room, MapLens parent, float2 anchor)
{
    var tile = parent.tile * RoomScale(layout, room);
    var center = MapPoint(anchor, parent);
    return MapLens { center = parent.center, size = parent.size,
        origin = center - RoomCenter(layout, room) * tile, tile = tile };
}

MapLens ContainingLens(LevelLayout layout, int room, MapLens focus, RoomSurround surround)
{
    var tile = focus.tile / RoomScale(layout, room);
    var center = focus.origin + RoomCenter(layout, room) * focus.tile;
    var origin = center - surround.anchor * tile;
    return MapLens { center = focus.center, size = focus.size, origin = origin, tile = tile };
}

MapLens BlendLens(MapLens source, MapLens target, float amount)
{
    return MapLens { center = target.center, size = target.size,
        origin = Math.Lerp(source.origin, target.origin, amount), tile = Math.Lerp(source.tile, target.tile, amount) };
}

float2 SmoothCell(float2 current, float2 target, float blend)
{
    var next = Math.Lerp(current, target, blend);
    return Math.Abs(next.x - target.x) < 0.001 && Math.Abs(next.y - target.y) < 0.001 ? target : next;
}

bool InPlayfield(float2 at, float side, MapLens viewport)
{
    var left = viewport.center - viewport.size * 0.5 + float2(12, 40);
    var right = viewport.center + viewport.size * 0.5 - float2(12, 22);
    return at.x + side * 0.5 >= left.x && at.x - side * 0.5 <= right.x &&
        at.y + side * 0.5 >= left.y && at.y - side * 0.5 <= right.y;
}
