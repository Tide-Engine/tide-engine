// Every interior uses exactly this fraction of its containing tile. Camera
// entry/exit are inverse affine transforms of the same miniature geometry.
const float ROOM_SCALE = 0.16;

struct MapLens
{
    float2 center;
    float2 size;
    float2 origin;
    float tile;
}

MapLens WorkshopLens(float2 screen, int room)
{
    var narrow = screen.x < 720;
    var width = Math.Min(screen.x - 36, 1180);
    var left = (screen.x - width) * 0.5;
    var top = screen.x < 1050 ? 154.0 : 126.0;
    var height = Math.Max(200, screen.y - top - (narrow ? 200 : 110));
    var center = float2(left + width * 0.5, top + height * 0.5);
    var size = float2(width, height);
    var cells = room < 0 ? OUTER_SIZE : INNER_SIZE;
    var side = Math.Min(size.x - 24, size.y - 62) * (room < 0 ? 0.96 : 0.62);
    var tile = Math.Max(5, side / cells);
    var origin = center + float2(0, 9) - float2((cells - 1) * tile * 0.5);
    return MapLens { center = center, size = size, origin = origin, tile = tile };
}

float2 MapPoint(float2 cell, MapLens lens) { return lens.origin + cell * lens.tile; }

struct RoomSurround
{
    int room = -1;
    float2 anchor;
    int shell = -1;
    int portal = -1;
    bool reference;
}

// A maker has one visible pose while crossing a doorway. Its position and
// size live in the actual containing room, so every camera projects the same
// passage rather than interpolating unrelated grid coordinates.
struct MakerPassage
{
    bool active;
    bool entering;
    bool sourceInside;
    bool visualInside;
    bool bridge;
    int child = -1;
    RoomSurround gate;
    RoomSurround fromGate;
    float2 source;
    float sourceScale = 1;
    float2 target;
    float2 lip;
    float2 fromLip;
    float age;
    float2 position;
    float scale = 1;
    float2 aliasSource;
    float2 aliasPosition;
    float aliasFrom;
    float aliasAlpha;
}

float2 PassageAnchor(RoomSurround gate, Picture picture)
{
    return gate.shell >= 0 && gate.shell < MAX_ROOMS ? picture.rooms[gate.shell] : gate.anchor;
}

bool SameGate(RoomSurround a, RoomSurround b)
{
    return a.room == b.room && a.shell == b.shell && a.portal == b.portal && a.reference == b.reference;
}

bool SameEntrance(Traveler a, Traveler b)
{
    if (a.depth != b.depth) return false;
    if (a.depth <= 0 || a.depth > MAX_DEPTH) return true;
    var first = a.trail[a.depth - 1];
    var second = b.trail[b.depth - 1];
    return first.shell == second.shell && first.room == second.room && CellEqual(first.position, second.position);
}

float PassageEase(float value)
{
    var t = Math.Clamp(value, 0, 1);
    return t * t * (3 - 2 * t);
}

float2 DoorLip(float2 doorCell)
{
    return (doorCell - float2(2)) * ((INNER_SIZE + 0.22) / (INNER_SIZE - 1)) * ROOM_SCALE;
}

MakerPassage BeginPassage(Workshop workshop, Picture picture, int seat, Traveler before, Traveler after)
{
    var destination = ReturnSurround(workshop, after, picture);
    var previous = ReturnSurround(workshop, before, picture);
    mut var trip = MakerPassage { child = after.room, target = float2(after.position) };
    if (before.room >= 0 && after.room >= 0 && before.depth == after.depth &&
        previous.room == destination.room && !SameGate(previous, destination))
    {
        trip.entering = true;
        trip.bridge = true;
        trip.sourceInside = true;
        trip.gate = destination;
        trip.fromGate = previous;
        trip.lip = DoorLip(float2(after.position));
        trip.fromLip = DoorLip(float2(before.position));
    }
    else if (after.depth > before.depth && destination.room == before.room)
    {
        trip.entering = true;
        trip.gate = destination;
        trip.lip = DoorLip(float2(after.position));
    }
    else if (previous.room == after.room && before.room >= 0)
    {
        trip.child = before.room;
        trip.gate = previous;
        trip.sourceInside = true;
        trip.lip = DoorLip(float2(before.position));
    }
    else if (after.room != before.room && destination.room == before.room)
    {
        trip.entering = true;
        trip.gate = destination;
        trip.lip = DoorLip(float2(after.position));
    }
    else if (before.room >= 0 && after.room >= 0 && previous.room == destination.room)
    {
        // One production action can leave a room and immediately enter an
        // adjacent doorway, without changing trail depth.
        trip.entering = true;
        trip.bridge = true;
        trip.sourceInside = true;
        trip.gate = destination;
        trip.fromGate = previous;
        trip.lip = DoorLip(float2(after.position));
        trip.fromLip = DoorLip(float2(before.position));
    }
    else return trip;
    trip.active = true;
    var old = picture.passages[seat];
    if (old.active && old.gate.room == trip.gate.room)
    {
        trip.source = old.position;
        trip.sourceScale = old.scale;
        if (SameGate(old.gate, trip.gate)) trip.sourceInside = old.visualInside;
    }
    else if (before.room == trip.gate.room && !trip.sourceInside)
    {
        trip.source = picture.actors[seat];
        trip.sourceScale = picture.actorScale[seat];
    }
    else
    {
        var from = trip.bridge ? previous : trip.gate;
        trip.source = PassageAnchor(from, picture) + (picture.actors[seat] - float2(2)) * ROOM_SCALE;
        trip.sourceScale = picture.actorScale[seat] * ROOM_SCALE;
    }
    trip.position = trip.source;
    trip.scale = trip.sourceScale;
    trip.visualInside = trip.sourceInside;
    trip.aliasSource = trip.entering ? trip.lip / ROOM_SCALE + float2(2) :
        (trip.source - PassageAnchor(trip.gate, picture)) / ROOM_SCALE + float2(2);
    trip.aliasFrom = trip.entering ? 0.0 : 1.0;
    if (old.active && old.child == trip.child && old.gate.reference)
    {
        trip.aliasSource = old.aliasPosition;
        trip.aliasFrom = old.aliasAlpha;
    }
    trip.aliasPosition = trip.aliasSource;
    trip.aliasAlpha = trip.aliasFrom;
    return trip;
}

void PassagePose(mut MakerPassage trip, Picture picture)
{
    var progress = Math.Min(1, trip.age / 0.42);
    var anchor = PassageAnchor(trip.gate, picture);
    var lip = anchor + trip.lip;
    var destination = trip.entering ? anchor + (trip.target - float2(2)) * ROOM_SCALE : trip.target;
    if (trip.bridge)
    {
        var oldLip = PassageAnchor(trip.fromGate, picture) + trip.fromLip;
        if (progress < 0.25)
        {
            var blend = PassageEase(progress / 0.25);
            trip.position = Math.Lerp(trip.source, oldLip, blend);
            trip.scale = Math.Lerp(trip.sourceScale, ROOM_SCALE, blend);
        }
        else if (progress < 0.75)
        {
            var blend = PassageEase((progress - 0.25) / 0.50);
            trip.position = Math.Lerp(oldLip, lip, blend);
            trip.scale = Math.Lerp(ROOM_SCALE, 1, 1 - Math.Abs(blend * 2 - 1));
        }
        else
        {
            trip.position = Math.Lerp(lip, destination, PassageEase((progress - 0.75) / 0.25));
            trip.scale = ROOM_SCALE;
        }
        trip.visualInside = progress >= 0.75;
    }
    else if (trip.entering && !trip.sourceInside)
    {
        var first = PassageEase(progress / 0.65);
        trip.position = progress < 0.65 ? Math.Lerp(trip.source, lip, first) : Math.Lerp(lip, destination, PassageEase((progress - 0.65) / 0.35));
        trip.scale = progress < 0.65 ? Math.Lerp(trip.sourceScale, ROOM_SCALE, first) : ROOM_SCALE;
        trip.visualInside = progress >= 0.65;
    }
    else if (!trip.entering && trip.sourceInside)
    {
        var last = PassageEase((progress - 0.35) / 0.65);
        trip.position = progress < 0.35 ? Math.Lerp(trip.source, lip, PassageEase(progress / 0.35)) : Math.Lerp(lip, destination, last);
        trip.scale = progress < 0.35 ? Math.Lerp(trip.sourceScale, ROOM_SCALE, PassageEase(progress / 0.35)) : Math.Lerp(ROOM_SCALE, 1, last);
        trip.visualInside = progress < 0.35;
    }
    else
    {
        var blend = PassageEase(progress);
        trip.position = Math.Lerp(trip.source, destination, blend);
        trip.scale = Math.Lerp(trip.sourceScale, trip.entering ? ROOM_SCALE : 1.0, blend);
        trip.visualInside = trip.sourceInside;
    }
    // A fixed reference also has canonical copies elsewhere. Their edge
    // passage crossfades with the actual gateway pose instead of popping to a
    // different cell/scale when a stationary observer sees a recursive copy.
    var aliasBlend = trip.entering ? PassageEase((progress - (trip.bridge ? 0.75 : 0.65)) / (trip.bridge ? 0.25 : 0.35)) : PassageEase(progress / 0.35);
    trip.aliasPosition = Math.Lerp(trip.aliasSource, trip.entering ? trip.target : trip.lip / ROOM_SCALE + float2(2), aliasBlend);
    trip.aliasAlpha = Math.Lerp(trip.aliasFrom, trip.entering ? 1.0 : 0.0, aliasBlend);
}

RoomSurround AncestorSurround(Workshop workshop, Traveler actor, int room, int layer, Picture picture)
{
    mut var surround = RoomSurround { };
    if (room < 0 || room >= workshop.layout.roomCount) return surround;
    mut var entry = Entry { shell = room };
    var step = actor.depth - 1 - layer;
    if (step >= 0 && step < MAX_DEPTH && EntryDestination(workshop.layout, actor.trail[step]) == room)
        entry = actor.trail[step];
    if (entry.shell >= 0 && entry.shell < workshop.layout.roomCount)
    {
        surround.room = workshop.puzzle.rooms[entry.shell].room;
        surround.anchor = picture.rooms[entry.shell];
        surround.shell = entry.shell;
    }
    else
    {
        surround.room = entry.room;
        surround.anchor = float2(entry.position);
        surround.portal = PortalAt(workshop.layout, entry.room, entry.position);
        surround.reference = true;
    }
    return surround;
}

RoomSurround ReturnSurround(Workshop workshop, Traveler actor, Picture picture)
{
    return AncestorSurround(workshop, actor, actor.room, 0, picture);
}

MapLens InteriorLens(MapLens parent, float2 anchor)
{
    var tile = parent.tile * ROOM_SCALE;
    var center = MapPoint(anchor, parent);
    return MapLens { center = parent.center, size = parent.size,
        origin = center - float2((INNER_SIZE - 1) * tile * 0.5), tile = tile };
}

MapLens ContainingLens(MapLens focus, RoomSurround surround)
{
    var tile = focus.tile / ROOM_SCALE;
    var center = focus.origin + float2((INNER_SIZE - 1) * focus.tile * 0.5);
    var origin = center - surround.anchor * tile;
    return MapLens { center = focus.center, size = focus.size, origin = origin, tile = tile };
}

MapLens BlendLens(MapLens source, MapLens target, float amount)
{
    return MapLens { center = target.center, size = target.size,
        origin = Math.Lerp(source.origin, target.origin, amount), tile = Math.Lerp(source.tile, target.tile, amount) };
}

int OutsideMakers(Workshop workshop, RoomSurround surround, int localSeat)
{
    mut var mask = 0;
    for (var seat = 0; seat < 2; seat++)
        if (seat != localSeat && workshop.present[seat] && workshop.puzzle.actors[seat].room == surround.room)
            mask |= 1 << seat;
    return mask;
}

MapLens FocusLens(float2 screen, Workshop workshop, Traveler actor, RoomSurround surround, Picture picture, int localSeat)
{
    var normal = WorkshopLens(screen, actor.room);
    if (actor.room < 0 || OutsideMakers(workshop, surround, localSeat) == 0) return normal;
    // Fit the current interior and real makers outside together. Self-reference
    // never uses the local maker's repeated depiction as another person.
    mut var low = float2(-0.45);
    mut var high = float2(0.45);
    for (var seat = 0; seat < 2; seat++)
    {
        if (seat == localSeat || !workshop.present[seat] || workshop.puzzle.actors[seat].room != surround.room) continue;
        var relative = picture.actors[seat] - surround.anchor;
        low = Math.Min(low, relative - float2(0.40));
        high = Math.Max(high, relative + float2(0.40));
    }
    var span = high - low;
    var parentTile = Math.Min(normal.tile / ROOM_SCALE,
        Math.Min((normal.size.x - 40) / span.x, (normal.size.y - 78) / span.y));
    var tile = parentTile * ROOM_SCALE;
    var origin = normal.center + float2(0, 9) - (low + high) * 0.5 * parentTile - float2(2 * tile);
    return MapLens { center = normal.center, size = normal.size, origin = origin, tile = tile };
}

float2 SmoothCell(float2 current, float2 target, float blend)
{
    var next = Math.Lerp(current, target, blend);
    return Math.Abs(next.x - target.x) < 0.001 && Math.Abs(next.y - target.y) < 0.001 ? target : next;
}

bool InPlayfield(float2 at, float side, MapLens viewport)
{
    var left = viewport.center - viewport.size * 0.5 + float2(12, 40);
    var right = viewport.center + viewport.size * 0.5 - float2(12, 22);
    return at.x + side * 0.5 >= left.x && at.x - side * 0.5 <= right.x &&
        at.y + side * 0.5 >= left.y && at.y - side * 0.5 <= right.y;
}

void InfinityMark(float2 at, float size, Color tone)
{
    // Geometric loops remain clear even on fonts without an infinity glyph.
    Draw.WireEllipse(at + float2(-size * 0.18, 0), float2(size * 0.25, size * 0.17), Math.Max(1, size * 0.055), tone);
    Draw.WireEllipse(at + float2(size * 0.18, 0), float2(size * 0.25, size * 0.17), Math.Max(1, size * 0.055), tone);
}

void DoorNotches(float2 center, float width, int doors, Color tone)
{
    for (var direction = 0; direction < 4; direction++)
    {
        if ((doors & (1 << direction)) == 0) continue;
        var delta = float2(Direction(direction));
        var edge = center + delta * width * 0.5;
        var across = float2(-delta.y, delta.x);
        Draw.Line(edge - across * width * 0.12, edge + across * width * 0.12, Math.Max(2, width * 0.10), Color(1, 0.95, 0.71));
        Draw.Line(edge - across * width * 0.09, edge + across * width * 0.09, Math.Max(1, width * 0.035), tone);
    }
}
