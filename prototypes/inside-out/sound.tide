asset Clip roomAmbience = "sfx/ambience.wav";
asset Clip woodenStep = "sfx/step.wav";
asset Clip woodenPush = "sfx/push.wav";
asset Clip doorwayRustle = "sfx/enter.wav";
asset Clip littleUndo = "sfx/undo.wav";
asset Clip littleReset = "sfx/reset.wav";
asset Clip littleSolve = "sfx/solve.wav";
asset Clip woodenStop = "sfx/stop.wav";

local singleton Hearing { Sound music; }

[Stage(ArtStage.Sound)]
view WorkshopSound(Hands hands, mut Hearing hearing)
{
    hearing.music.clip = roomAmbience;
    hearing.music.loop = true;
    hearing.music.playing = hands.music && !hands.quiet;
    hearing.music.volume = 0.27;
}

local event(PuzzleCue cue) HearPuzzle(Hands hands)
{
    if (hands.quiet) return;
    if (cue.kind == 0) Audio.Play(woodenStep, cue.seat == hands.seat ? 0.30 : 0.15, cue.seat == 0 ? 0.95 : 1.10);
    else if (cue.kind == 1) Audio.Play(woodenPush, 0.37);
    else if (cue.kind == 2) Audio.Play(doorwayRustle, 0.26);
    else if (cue.kind == 3) Audio.Play(littleUndo, 0.28);
    else if (cue.kind == 4) Audio.Play(littleReset, 0.27);
    else if (cue.kind == 5) Audio.Play(littleSolve, 0.53);
    else if (cue.kind == 6) Audio.Play(woodenStop, cue.seat == hands.seat ? 0.18 : 0.09);
}
