// How the hall's exhibits (hall.tide) are drawn: each post carries a model
// of its puzzle as it starts, a lift, or a covered challenge, with its two
// pads in front. Entering a puzzle, the view closes in on its model; coming
// back, it comes out of the model again.

// Every puzzle's start, loaded the first time a hall shows its model.
local singleton Gallery
{
    LevelLayout[PUZZLE_COUNT] layouts;
    Puzzle[PUZZLE_COUNT] puzzles;
    bool[PUZZLE_COUNT] loaded;
}

void LoadModel(mut Gallery gallery, int level)
{
    if (level < 0 || level >= PUZZLE_COUNT || gallery.loaded[level]) return;
    mut var layout = LevelLayout { };
    mut var puzzle = Puzzle { };
    LoadLevel(level, layout, puzzle);
    gallery.layouts[level] = layout;
    gallery.puzzles[level] = puzzle;
    gallery.loaded[level] = true;
}

// Where a post stands and how high its top is, in its tile: on the table's
// low slab, or on top of a room's wall, whose block is 0.33 tall.
float PostBase(int room) { return room < 0 ? .078 : .328; }
float PostTop(int room) { return room < 0 ? .30 : .40; }
// A model's longest side, in its post's tile.
const float MODEL_SPAN = .80;
const Color POST_WOOD = Color(.29, .20, .14);
const Color SOLVED_GLOW = Color(.52, .90, .56);
const Color LOCKED_PAD = Color(.30, .28, .27);

// The part of a model's table that has anything on it: the cells that are
// not wall, and the ones boxes stand on. Most tables are wall round one box.
int4 ModelSpan(LevelLayout layout, Puzzle puzzle)
{
    mut var low = int2(7);
    mut var high = int2(-1);
    for (var y = 0; y < RoomHeight(layout, -1); y++)
        for (var x = 0; x < RoomWidth(layout, -1); x++)
        {
            var cell = int2(x, y);
            if (TileAt(layout, -1, cell) == Tile.Wall && BoxAt(layout, puzzle, -1, cell) < 0) continue;
            low = Math.Min(low, cell);
            high = Math.Max(high, cell);
        }
    if (high.x < 0) return int4(0, 0, RoomWidth(layout, -1) - 1, RoomHeight(layout, -1) - 1);
    return int4(low.x, low.y, high.x, high.y);
}
// Where a model's table stands, drawn over a post at `at`: its span fills
// the post's top.
MapLens ModelLens(int4 span, float2 at, float tile, float ground, float top)
{
    var cells = Math.Max(span.z - span.x, span.w - span.y) + 1;
    var model = tile * MODEL_SPAN / cells;
    var center = at - float2(0, tile * top * SCENE_COS);
    var middle = float2(span.x + span.z, span.y + span.w) * .5;
    return MapLens { origin = center - middle * model, tile = model, floor = ground + tile * top };
}

// One room of a model, still, as its puzzle starts.
void ModelRoom(mut Sculpture sculpture, LevelLayout layout, Puzzle puzzle, int room, MapLens lens, int4 span)
{
    sculpture.ground = lens.floor;
    sculpture.surfaceOrigin = lens.origin;
    sculpture.surfaceTile = lens.tile;
    sculpture.surface = SurfaceRole.Prop;
    var tone = room < 0 ? STEEL : RoomColor(room);
    var power = Power(layout, puzzle);
    for (var y = 0; y < RoomHeight(layout, room); y++)
        for (var x = 0; x < RoomWidth(layout, room); x++)
        {
            var cell = int2(x, y);
            if (room < 0 && (x < span.x || y < span.y || x > span.z || y > span.w)) continue;
            var tile = TileAt(layout, room, cell);
            var at = MapPoint(float2(cell), lens);
            if (tile == Tile.Wall)
            {
                var paint = room < 0 && sculpture.look >= 0 ? ChapterTable(sculpture.look, (x + y) % 2) : tone;
                WallTile(sculpture, at, lens.tile, paint, lens.floor, room < 0 ? .06 : .31, room < 0 ? SurfaceRole.Table : SurfaceRole.Wall);
                continue;
            }
            mut var rise = 0.0;
            if (PlateChannel(tile) >= 0 && ThingAt(layout, puzzle, room, cell).kind < 0) rise = 1;
            if (ShutterChannel(tile) >= 0 && !ShutterPassable(layout, puzzle, room, cell, power)) rise = 1;
            TilePaint(sculpture, tile, at, lens.tile, CargoAt(layout, puzzle, room, cell) >= 0, x + y, lens.floor, rise,
                room < 0 ? SurfaceRole.Table : SurfaceRole.Floor);
        }
    for (var shell = 0; shell < layout.roomCount; shell++)
    {
        var dock = layout.rooms[shell];
        if (dock.dockRoom != room || dock.dock.x < 0) continue;
        DockMark(sculpture, MapPoint(float2(dock.dock), lens), lens.tile, RoomColor(shell), shell,
            BoxAt(layout, puzzle, room, dock.dock) >= 0, BoxDocked(layout, puzzle, shell), lens.floor);
    }
    for (var crate = 0; crate < layout.crateCount; crate++)
    {
        var cargo = puzzle.crates[crate];
        if (!cargo.active || cargo.room != room) continue;
        Crate(sculpture, MapPoint(float2(cargo.position), lens), lens.tile, BatterySeated(layout, cargo), lens.floor + lens.tile * .004);
    }
    for (var seat = 0; seat < 2; seat++)
        if (puzzle.actors[seat].room == room)
            Maker(sculpture, MapPoint(float2(puzzle.actors[seat].position), lens), lens.tile * .90, seat,
                lens.floor + lens.tile * .004, BotPose { facing = puzzle.actors[seat].facing });
    if (room >= 0) RoomTrim(sculpture, layout, puzzle, room, lens);
}

// A whole model: its table and the rooms in it, as deep as they show.
void ModelScene(mut Sculpture sculpture, LevelLayout layout, Puzzle puzzle, MapLens lens, int4 span)
{
    mut SceneLens[16] pending = default;
    pending[0] = SceneLens { room = -1, lens = lens };
    mut var count = 1;
    for (var index = 0; index < count; index++)
    {
        var item = pending[index];
        var center = MapPoint(RoomCenter(layout, item.room), item.lens);
        var dims = RoomDimensions(layout, item.room);
        if (!InPlayfield(center, Math.Max(dims.x, dims.y) * item.lens.tile, item.lens)) continue;
        ModelRoom(sculpture, layout, puzzle, item.room, item.lens, span);
        for (var box = 0; box < layout.roomCount; box++)
        {
            if (puzzle.rooms[box].room != item.room) continue;
            var interior = InteriorLens(layout, box, item.lens, float2(puzzle.rooms[box].position));
            if (item.depth < 2 && count < 16 && interior.tile >= 1.5)
            {
                pending[count] = SceneLens { room = box, lens = interior, depth = item.depth + 1 };
                count++;
                continue;
            }
            sculpture.ground = interior.floor;
            sculpture.surface = SurfaceRole.Wall;
            Cuboid(sculpture, MapPoint(float2(puzzle.rooms[box].position), item.lens), float2(item.lens.tile), interior.tile * .20,
                RoomColor(box), interior.floor, interior.tile);
            sculpture.surface = SurfaceRole.Prop;
        }
    }
}

// How the pads of a lane look: their paint, and whether they glow.
Color LanePaint(HallState workshop, Station station, bool open)
{
    if (!open) return LOCKED_PAD;
    if (station.kind == StationKind.Level) return Solved(workshop.completed, station.level) ? SOLVED_GLOW : GLOW_TARGET;
    return GLOW_GOAL;
}

// A lift: a cab in the post with its doors shut, and an arrow on its roof.
// The lift up has a light for each battery it takes, lit as its sockets
// fill; it works, its arrow lit, once they are full.
void LiftPost(mut Sculpture sculpture, HallState workshop, Station station, float2 at, float tile, float ground, bool open)
{
    var floor = ground + tile * PostBase(station.room);
    var top = ground + tile * PostTop(station.room);
    Cuboid(sculpture, at, float2(tile * .86), top - floor, Math.Lerp(POST_WOOD, RUBBER, .35), floor, tile);
    Cuboid(sculpture, at, float2(tile * .86), tile * .012, BRASS, top, tile);
    Cuboid(sculpture, at, float2(tile * .62, tile * .50), tile * .010, Color(.16, .15, .16), top + tile * .012, tile);
    var crown = top + tile * .024;
    var up = station.kind == StationKind.Up ? -1.0 : 1.0;
    var tip = at + float2(0, up * tile * .16);
    var arrow = open ? GLOW_GOAL : Color(.36, .34, .32);
    sculpture.glow = open ? 1 : 0;
    FloorLine(sculpture, tip, tip + float2(-tile * .16, -up * tile * .16), tile * .06, arrow, crown, tile);
    FloorLine(sculpture, tip, tip + float2(tile * .16, -up * tile * .16), tile * .06, arrow, crown, tile);
    FloorLine(sculpture, tip - float2(0, up * tile * .02), tip - float2(0, up * tile * .30), tile * .06, arrow, crown, tile);
    sculpture.glow = 0;
    if (station.kind != StationKind.Up || workshop.need <= 0) return;
    var lit = open ? workshop.need : Math.Min(workshop.need, workshop.seated);
    for (var i = 0; i < workshop.need; i++)
    {
        var light = at + float2((i - (workshop.need - 1) * .5) * tile * .15, tile * .32);
        sculpture.glow = i < lit ? 1 : 0;
        Cuboid(sculpture, light, float2(tile * .09), tile * .02, i < lit ? SOLVED_GLOW : RUBBER, crown, tile);
        sculpture.glow = 0;
    }
}

// A puzzle's post. Its model shows how the puzzle starts; a ring round the
// post's top glows green once it is solved. A model too small to read is
// a plain block.
void PuzzlePost(mut Sculpture sculpture, HallState workshop, mut Gallery gallery, Station station, float2 at, float tile, float ground, bool open)
{
    var floor = ground + tile * PostBase(station.room);
    var top = ground + tile * PostTop(station.room);
    var solved = Solved(workshop.completed, station.level);
    var challenge = IsChallenge(station.level);
    Cuboid(sculpture, at, float2(tile * .90), top - floor, challenge ? Math.Lerp(POST_WOOD, BRASS, .25) : POST_WOOD, floor, tile);
    sculpture.glow = solved ? 1 : 0;
    FloorOutline(sculpture, at, float2(tile * .90), Math.Max(.8, tile * .035), solved ? SOLVED_GLOW : open ? BRASS : RUBBER, top, tile);
    sculpture.glow = 0;
    if (!open || tile < 14)
    {
        Cuboid(sculpture, at, float2(tile * .70), tile * .08, open ? Color(.42, .40, .38) : Color(.20, .17, .16), top, tile);
        return;
    }
    LoadModel(gallery, station.level);
    if (!gallery.loaded[station.level]) return;
    var layout = gallery.layouts[station.level];
    var surfaceGround = sculpture.ground;
    var origin = sculpture.surfaceOrigin;
    var surfaceTile = sculpture.surfaceTile;
    var puzzle = gallery.puzzles[station.level];
    var span = ModelSpan(layout, puzzle);
    ModelScene(sculpture, layout, puzzle, ModelLens(span, at, tile, ground, PostTop(station.room)), span);
    sculpture.ground = surfaceGround;
    sculpture.surfaceOrigin = origin;
    sculpture.surfaceTile = surfaceTile;
    sculpture.surface = SurfaceRole.Prop;
}

// The fraction of a lane's charge: from the moment both stand in it to its
// pads being full.
float LaneCharge(HallState workshop, int index, float now)
{
    if (workshop.departStation != index || workshop.departTick < 0) return 0;
    return Math.Saturate((now - workshop.departTick) / CHARGE_TICKS);
}

// The posts and pads of the hall that stand in one room, wherever that room
// is drawn: RoomScene calls this for each drawing.
void HallRoom(mut Sculpture sculpture, HallState workshop, mut Gallery gallery, int room, MapLens lens, float now)
{
    if (!workshop.inHall || lens.tile < 3) return;
    for (var index = 0; index < MAX_STATIONS; index++)
    {
        var station = HallStation(workshop.hall, index);
        if (station.kind == StationKind.None || station.room != room) continue;
        var open = StationOpen(workshop, workshop.hall, station);
        var post = MapPoint(float2(station.post), lens);
        if (!InPlayfield(post, lens.tile * 2, lens)) continue;
        sculpture.ground = lens.floor;
        sculpture.surfaceOrigin = lens.origin;
        sculpture.surfaceTile = lens.tile;
        sculpture.surface = SurfaceRole.Prop;
        if (station.kind == StationKind.Level) PuzzlePost(sculpture, workshop, gallery, station, post, lens.tile, lens.floor, open);
        else LiftPost(sculpture, workshop, station, post, lens.tile, lens.floor, open);
        // The two pads: an inlay with a line round it that glows while the
        // lane is open, and fills with light as both stand in it.
        var paint = LanePaint(workshop, station, open);
        var charge = LaneCharge(workshop, index, now);
        for (var pad = 0; pad < 2; pad++)
        {
            var at = MapPoint(float2(pad == 0 ? station.near : station.far), lens);
            var top = lens.floor + lens.tile * .006;
            Cuboid(sculpture, at, float2(lens.tile * .80), lens.tile * .003, Math.Lerp(PLASTER, RUBBER, .45), top, lens.tile);
            sculpture.glow = open ? 1 : 0;
            FloorOutline(sculpture, at, float2(lens.tile * .70), FloorStroke(lens.tile), paint, top + lens.tile * .004, lens.tile);
            if (charge > 0)
                Cuboid(sculpture, at, float2(lens.tile * .62 * charge), lens.tile * .004, Math.Lerp(paint, Color.white, .25),
                    top + lens.tile * .004, lens.tile);
            sculpture.glow = 0;
        }
    }
}

// How far the view has closed in on a post's model: going into its puzzle,
// or coming back out of it into the hall. 0 is the hall as it stands.
float HallDive(HallState workshop, float now, out Station post)
{
    post = Station { };
    if (!workshop.inHall) return 0;
    if (workshop.departStation >= 0 && workshop.departTick >= 0)
    {
        post = HallStation(workshop.hall, workshop.departStation);
        if (post.kind != StationKind.Level) return 0;
        return PassageEase((now - workshop.departTick - CHARGE_TICKS) / DIVE_TICKS);
    }
    var back = StationOf(workshop.hall, workshop.level);
    if (workshop.arrival != 1 || back < 0) return 0;
    post = HallStation(workshop.hall, back);
    return 1 - PassageEase((now - workshop.openedTick) / EMERGE_TICKS);
}

// The hall's lens closed in on a post by `amount`: at 1 its model fills the
// view, a little beyond its edges.
MapLens DiveLens(MapLens lens, Station station, float amount, float2 screen)
{
    if (amount <= 0) return lens;
    var post = station.post;
    var height = PostTop(station.room);
    var start = MapPoint(float2(post), lens) - float2(0, lens.tile * height * SCENE_COS);
    var reach = Math.Max(1, SceneSide(screen) * 1.3 / (lens.tile * MODEL_SPAN));
    var tile = lens.tile * Math.Pow(reach, amount);
    var center = Math.Lerp(start, SceneCenter(screen), PassageEase(amount * 1.5));
    mut var next = lens;
    next.tile = tile;
    next.origin = center + float2(0, tile * height * SCENE_COS) - float2(post) * tile;
    return next;
}
