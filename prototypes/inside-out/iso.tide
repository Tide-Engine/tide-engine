// Screen-space projection for the workshop's little wooden dioramas.
// Heights are pixel offsets; grid coordinates remain the match's plain cells.
float2 IsoPoint(float2 cell, float2 origin, float tile)
{
    return origin + float2((cell.x - cell.y) * tile * 0.5, (cell.x + cell.y) * tile * 0.25);
}

void IsoTop(float2 center, float tile, float inset, Color tone)
{
    var halfWidth = tile * 0.5 * inset;
    var halfHeight = tile * 0.25 * inset;
    Draw.Mesh([
        Vertex { position = center + float2(0, -halfHeight), color = tone },
        Vertex { position = center + float2(-halfWidth, 0), color = tone },
        Vertex { position = center + float2(0, halfHeight), color = tone },
        Vertex { position = center + float2(halfWidth, 0), color = tone }
    ], [0, 1, 2, 0, 2, 3]);
}

void IsoBlock(float2 center, float tile, float inset, float height, Color top, Color left, Color right)
{
    var halfWidth = tile * 0.5 * inset;
    var halfHeight = tile * 0.25 * inset;
    var raised = center - float2(0, Math.Max(0, height));
    var west = float2(-halfWidth, 0);
    var east = float2(halfWidth, 0);
    var north = float2(0, -halfHeight);
    var south = float2(0, halfHeight);
    // Separate face vertices retain the warm light/shadow colours. Draw the
    // two front sides before the lid, with no camera or depth-state changes.
    Draw.Mesh([
        Vertex { position = raised + west, color = left },
        Vertex { position = raised + south, color = left },
        Vertex { position = center + south, color = left },
        Vertex { position = center + west, color = left },
        Vertex { position = raised + south, color = right },
        Vertex { position = raised + east, color = right },
        Vertex { position = center + east, color = right },
        Vertex { position = center + south, color = right },
        Vertex { position = raised + north, color = top },
        Vertex { position = raised + west, color = top },
        Vertex { position = raised + south, color = top },
        Vertex { position = raised + east, color = top }
    ], [0, 1, 2, 0, 2, 3, 4, 5, 6, 4, 6, 7, 8, 9, 10, 8, 10, 11]);
}

void IsoOutline(float2 center, float tile, float inset, float thickness, Color tone)
{
    var halfWidth = tile * 0.5 * inset;
    var halfHeight = tile * 0.25 * inset;
    var north = center + float2(0, -halfHeight);
    var west = center + float2(-halfWidth, 0);
    var south = center + float2(0, halfHeight);
    var east = center + float2(halfWidth, 0);
    Draw.Line(north, west, thickness, tone);
    Draw.Line(west, south, thickness, tone);
    Draw.Line(south, east, thickness, tone);
    Draw.Line(east, north, thickness, tone);
}
