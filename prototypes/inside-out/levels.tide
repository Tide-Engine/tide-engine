// Outward journeys through physically nested boxes and shared interiors.
void WorkshopTile(mut LevelLayout layout, int room, int2 at, Tile tile)
{
    if (room < 0) layout.tiles[at.y * layout.width + at.x] = tile;
    else layout.rooms[room].tiles[at.y * layout.rooms[room].width + at.x] = tile;
}
void WorkshopBlank(mut LevelLayout layout, mut Puzzle puzzle)
{
    layout = LevelLayout { width = 7, height = 7 };
    puzzle = Puzzle { };
    for (var room = 0; room < MAX_ROOMS; room++) layout.rooms[room] = RoomLayout { };
    for (var cell = 0; cell < 49; cell++) layout.tiles[cell] = Tile.Wall;
}
void WorkshopRoom(mut LevelLayout layout, mut Puzzle puzzle, int room, int2 at, int2 dock,
    int width = 5, int height = 5, int doors = 15, int parent = -1, int dockParent = -1,
    int north = -1, int east = -1, int south = -1, int west = -1)
{
    layout.roomCount = Math.Max(layout.roomCount, room + 1);
    layout.rooms[room] = RoomLayout { width = width, height = height, doors = doors,
        north = north, east = east, south = south, west = west, dock = dock, dockRoom = dockParent };
    puzzle.rooms[room] = RoomShell { room = parent, position = at };
    for (var cell = 0; cell < 49; cell++) layout.rooms[room].tiles[cell] = Tile.Wall;
    for (var y = 1; y < height - 1; y++)
        for (var x = 1; x < width - 1; x++) WorkshopTile(layout, room, int2(x, y), Tile.Floor);
    for (var side = 0; side < 4; side++)
        if ((doors & (1 << side)) != 0) WorkshopTile(layout, room, DoorCell(layout, room, side), Tile.Floor);
}
void WorkshopWalker(mut Puzzle puzzle, int seat, int room, int2 at)
{
    puzzle.actors[seat] = Traveler { room = room, position = at };
}
void WorkshopCargo(mut LevelLayout layout, mut Puzzle puzzle, int room, int2 at)
{
    puzzle.crates[layout.crateCount] = Cargo { room = room, position = at, active = true };
    layout.crateCount += 1;
}
void WorkshopPatch(mut LevelLayout layout, int room, int x0, int y0, int x1, int y1, Tile tile = Tile.Floor)
{
    for (var y = y0; y <= y1; y++)
        for (var x = x0; x <= x1; x++) WorkshopTile(layout, room, int2(x, y), tile);
}
void WorkshopClear(mut LevelLayout layout, int room)
{
    for (var cell = 0; cell < 49; cell++) layout.rooms[room].tiles[cell] = Tile.Wall;
}
void WorkshopContaining(mut LevelLayout layout, mut Puzzle puzzle, int room, int width = 7, int height = 5, int doors = 0)
{
    WorkshopTile(layout, -1, int2(3, 3), Tile.Floor);
    WorkshopRoom(layout, puzzle, room, int2(3, 3), int2(3, 3), width, height, doors);
}
void WorkshopCarryingFloor(mut LevelLayout layout, int parent)
{
    WorkshopClear(layout, parent);
    WorkshopPatch(layout, parent, 1, 2, 2, 4);
    WorkshopPatch(layout, parent, 3, 2, 3, 4);
    WorkshopPatch(layout, parent, 4, 2, 5, 2);
}
void WorkshopSeed(mut LevelLayout layout, mut Puzzle puzzle)
{
    for (var seat = 0; seat < 2; seat++)
    {
        mut var actor = puzzle.actors[seat];
        RebaseTrail(layout, puzzle, actor, actor.room, 0);
        puzzle.actors[seat] = actor;
    }
}

// Every box is a square grid, so its miniature fills the cell it stands in.
// A room authored longer one way is packed out with rows or columns of wall,
// the odd one below or to the right (above or to the left with `low`), and
// everything in it moves with it. A
// doorway on a packed side reaches the new edge along a corridor of floor.
void SquareRoom(mut LevelLayout layout, mut Puzzle puzzle, int room, bool low)
{
    var old = layout.rooms[room];
    var width = old.width;
    var height = old.height;
    if (width == height) return;
    var span = Math.Max(width, height);
    var odd = low ? 1 : 0;
    var shift = int2((span - width + odd) / 2, (span - height + odd) / 2);
    mut int2[4] doors = default;
    for (var side = 0; side < 4; side++) doors[side] = DoorCell(layout, room, side);
    mut var next = old;
    next.width = span;
    next.height = span;
    for (var cell = 0; cell < 49; cell++) next.tiles[cell] = Tile.Wall;
    for (var y = 0; y < height; y++)
        for (var x = 0; x < width; x++) next.tiles[(y + shift.y) * span + x + shift.x] = old.tiles[y * width + x];
    for (var side = 0; side < 4; side++)
    {
        if ((old.doors & (1 << side)) == 0 || doors[side].x < 0) continue;
        var at = doors[side] + shift;
        if (side == 0) next.north = at.x;
        if (side == 1) next.east = at.y;
        if (side == 2) next.south = at.x;
        if (side == 3) next.west = at.y;
        mut var walk = at;
        while (walk.x >= 0 && walk.y >= 0 && walk.x < span && walk.y < span)
        {
            if (next.tiles[walk.y * span + walk.x] == Tile.Wall) next.tiles[walk.y * span + walk.x] = Tile.Floor;
            walk = walk + Direction(side);
        }
    }
    layout.rooms[room] = next;
    for (var seat = 0; seat < 2; seat++)
        if (puzzle.actors[seat].room == room) puzzle.actors[seat].position = puzzle.actors[seat].position + shift;
    for (var crate = 0; crate < MAX_CRATES; crate++)
        if (puzzle.crates[crate].active && puzzle.crates[crate].room == room) puzzle.crates[crate].position = puzzle.crates[crate].position + shift;
    for (var box = 0; box < MAX_ROOMS; box++)
    {
        if (puzzle.rooms[box].room == room && box < layout.roomCount) puzzle.rooms[box].position = puzzle.rooms[box].position + shift;
        if (layout.rooms[box].dockRoom == room && layout.rooms[box].dock.x >= 0) layout.rooms[box].dock = layout.rooms[box].dock + shift;
    }
}

// Squaring a room leaves it a second row or column of wall where it was
// packed out. These cells of that doubled wall are floor instead, so a room
// fills its square: each was opened only while the puzzle's witness still
// solved it and still showed what the campaign asks of it.
void WidenRooms(int level, mut LevelLayout layout)
{
    switch (level)
    {
        case 0:
            WorkshopTile(layout, 1, int2(1, 2), Tile.Floor);
            WorkshopTile(layout, 1, int2(2, 2), Tile.Floor);
            break;
        case 1:
            WorkshopTile(layout, 0, int2(2, 3), Tile.Floor);
            WorkshopTile(layout, 0, int2(3, 3), Tile.Floor);
            WorkshopTile(layout, 1, int2(1, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(2, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(3, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(4, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(5, 5), Tile.Floor);
            WorkshopTile(layout, 0, int2(1, 3), Tile.Floor);
            break;
        case 2:
            WorkshopTile(layout, 0, int2(2, 3), Tile.Floor);
            WorkshopTile(layout, 0, int2(3, 3), Tile.Floor);
            WorkshopTile(layout, 1, int2(3, 1), Tile.Floor);
            WorkshopTile(layout, 1, int2(3, 2), Tile.Floor);
            WorkshopTile(layout, 1, int2(3, 3), Tile.Floor);
            WorkshopTile(layout, 2, int2(1, 5), Tile.Floor);
            WorkshopTile(layout, 2, int2(2, 5), Tile.Floor);
            WorkshopTile(layout, 2, int2(3, 5), Tile.Floor);
            WorkshopTile(layout, 2, int2(4, 5), Tile.Floor);
            WorkshopTile(layout, 2, int2(5, 5), Tile.Floor);
            WorkshopTile(layout, 0, int2(1, 3), Tile.Floor);
            break;
        case 3:
            WorkshopTile(layout, 1, int2(1, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(2, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(3, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(4, 5), Tile.Floor);
            WorkshopTile(layout, 1, int2(5, 5), Tile.Floor);
            break;
    }
}

void LoadLevel(int level, mut LevelLayout layout, mut Puzzle puzzle)
{
    WorkshopBlank(layout, puzzle);
    switch (Math.Clamp(level, 0, LEVEL_COUNT - 1))
    {
        case 0:
            WorkshopContaining(layout, puzzle, 1, 4, 3, 2);
            WorkshopRoom(layout, puzzle, 0, int2(1, 1), int2(1, 1), 3, 3, 10, 1, 1);
            WorkshopWalker(puzzle, 0, 0, int2(2, 1));
            WorkshopWalker(puzzle, 1, 0, int2(0, 1));
            WorkshopCargo(layout, puzzle, 0, int2(1, 1));
            WorkshopPatch(layout, -1, 4, 2, 4, 4);
            WorkshopTile(layout, -1, int2(5, 3), Tile.Target);
            WorkshopTile(layout, -1, int2(4, 2), Tile.Exit);
            WorkshopTile(layout, -1, int2(4, 4), Tile.Exit);
            break;
        case 1:
            // The outside maker cannot re-enter after docking. Carry the
            // inside maker to an export route, rather than move an empty box.
            WorkshopContaining(layout, puzzle, 1, 7, 6);
            WorkshopCarryingFloor(layout, 1);
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 2), 5, 4, 3, 1, 1, 1, 1);
            WorkshopTile(layout, 0, int2(1, 2), Tile.Wall);
            WorkshopWalker(puzzle, 0, 0, int2(1, 0));
            WorkshopWalker(puzzle, 1, 0, int2(1, 1));
            WorkshopCargo(layout, puzzle, 0, int2(2, 1));
            WorkshopTile(layout, 1, int2(5, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(2, 4), Tile.Exit);
            WorkshopTile(layout, 1, int2(4, 2), Tile.Exit);
            break;
        case 2:
            WorkshopContaining(layout, puzzle, 2, 7, 6);
            WorkshopCarryingFloor(layout, 2);
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 2), 5, 4, 3, 2, 2, 1, 1);
            WorkshopTile(layout, 0, int2(1, 2), Tile.Wall);
            WorkshopRoom(layout, puzzle, 1, int2(5, 2), int2(5, 2), 4, 5, 8, 2, 2, -1, -1, -1, 1);
            WorkshopWalker(puzzle, 0, 1, int2(1, 3));
            WorkshopWalker(puzzle, 1, 0, int2(1, 1));
            WorkshopCargo(layout, puzzle, 0, int2(2, 1));
            WorkshopTile(layout, 1, int2(2, 1), Tile.Target);
            WorkshopTile(layout, 2, int2(2, 4), Tile.Exit);
            WorkshopTile(layout, 2, int2(4, 2), Tile.Exit);
            break;
        case 3:
            WorkshopContaining(layout, puzzle, 1, 7, 5);
            WorkshopPatch(layout, 1, 1, 0, 5, 0);
            WorkshopTile(layout, 1, int2(2, 1), Tile.Wall);
            WorkshopRoom(layout, puzzle, 0, int2(2, 2), int2(3, 2), 5, 5, 12, 1, 1);
            WorkshopWalker(puzzle, 0, 0, int2(1, 1));
            WorkshopWalker(puzzle, 1, 0, int2(3, 1));
            WorkshopCargo(layout, puzzle, 0, int2(2, 2));
            WorkshopTile(layout, 1, int2(1, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(5, 3), Tile.Exit);
            break;
        case 4:
            // A row moves as one, however long: a battery, a box and nothing
            // to stop them.
            WorkshopContaining(layout, puzzle, 1, 7, 7);
            WorkshopRoom(layout, puzzle, 0, int2(1, 3), int2(1, 3), 5, 5, 2, 1, 1);
            WorkshopRoom(layout, puzzle, 2, int2(4, 3), int2(5, 3), 3, 3, 8, 1, 1);
            WorkshopWalker(puzzle, 0, 0, int2(3, 2));
            WorkshopWalker(puzzle, 1, 0, int2(2, 2));
            WorkshopCargo(layout, puzzle, 1, int2(3, 3));
            WorkshopTile(layout, 1, int2(4, 3), Tile.Target);
            WorkshopTile(layout, 1, int2(2, 1), Tile.Exit);
            WorkshopTile(layout, 1, int2(2, 5), Tile.Exit);
            break;
        case 5:
            // A box only lets a bot in while it cannot move, and this one
            // has open floor behind its outline: the partner is the wall.
            // The room is a figure of eight round two blocks, so either bot
            // can reach either side of the small box, and nothing else can
            // be put behind it. The home is in a corner and cannot be moved.
            WorkshopContaining(layout, puzzle, 1, 7, 7);
            WorkshopClear(layout, 1);
            WorkshopPatch(layout, 1, 1, 1, 5, 1);
            WorkshopPatch(layout, 1, 1, 3, 5, 3);
            WorkshopPatch(layout, 1, 1, 5, 5, 5);
            WorkshopTile(layout, 1, int2(1, 2), Tile.Floor);
            WorkshopTile(layout, 1, int2(5, 2), Tile.Floor);
            WorkshopTile(layout, 1, int2(1, 4), Tile.Floor);
            WorkshopTile(layout, 1, int2(5, 4), Tile.Floor);
            WorkshopRoom(layout, puzzle, 0, int2(1, 1), int2(1, 1), 5, 5, 6, 1, 1);
            WorkshopRoom(layout, puzzle, 2, int2(2, 3), int2(3, 3), 5, 5, 8, 1, 1);
            WorkshopWalker(puzzle, 0, 0, int2(2, 3));
            WorkshopWalker(puzzle, 1, 0, int2(3, 2));
            WorkshopCargo(layout, puzzle, 2, int2(2, 2));
            WorkshopTile(layout, 2, int2(3, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(4, 3), Tile.Exit);
            break;
        case 6:
            // A battery goes into a box that cannot move, and so does the bot
            // behind it. The room is the figure of eight of the puzzle before,
            // so the partner can stand behind the box.
            WorkshopContaining(layout, puzzle, 1, 7, 7);
            WorkshopClear(layout, 1);
            WorkshopPatch(layout, 1, 1, 1, 5, 1);
            WorkshopPatch(layout, 1, 1, 3, 5, 3);
            WorkshopPatch(layout, 1, 1, 5, 5, 5);
            WorkshopTile(layout, 1, int2(1, 2), Tile.Floor);
            WorkshopTile(layout, 1, int2(5, 2), Tile.Floor);
            WorkshopTile(layout, 1, int2(1, 4), Tile.Floor);
            WorkshopTile(layout, 1, int2(5, 4), Tile.Floor);
            WorkshopRoom(layout, puzzle, 0, int2(1, 1), int2(1, 1), 5, 5, 6, 1, 1);
            WorkshopRoom(layout, puzzle, 2, int2(3, 3), int2(3, 3), 3, 3, 8, 1, 1);
            WorkshopWalker(puzzle, 0, 0, int2(2, 3));
            WorkshopWalker(puzzle, 1, 0, int2(3, 2));
            WorkshopCargo(layout, puzzle, 1, int2(2, 3));
            WorkshopTile(layout, 2, int2(1, 1), Tile.Target);
            WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(4, 3), Tile.Exit);
            break;
    }
    for (var room = 0; room < layout.roomCount; room++) SquareRoom(layout, puzzle, room, false);
    WidenRooms(Math.Clamp(level, 0, LEVEL_COUNT - 1), layout);
    WorkshopSeed(layout, puzzle);
}
string LevelName(int level)
{
    switch (level)
    {
        case 0: return "A room outside";
        case 1: return "No handle inside";
        case 2: return "The other opening";
        case 3: return "A place to stand";
        case 4: return "All in a row";
        case 5: return "Hold it steady";
        case 6: return "Posted";
    }
    return "Inside Out";
}
string LevelLesson(int level)
{
    if (level == 0) return "Seat the battery beyond both boxes. Find a goal for each robot.";
    if (level == 1) return "Move the home onto its outline and seat its battery in the containing room.";
    if (level == 2) return "Park the home and seat its battery inside the other box.";
    if (level == 3) return "Leave the battery in the left socket and the home on the right outline.";
    if (level == 4) return "Seat the battery and park the small box. A row of things moves as one.";
    if (level == 5) return "Park the small box on its outline with its battery seated inside. A box only lets you in while it cannot move.";
    return "Seat the battery inside the small box without moving the box off its outline.";
}
string LevelHint(int level, int tier)
{
    var detail = Math.Clamp(tier, 0, 2);
    if (level == 0)
    {
        if (detail == 0) return "Where does your doorway lead? What is standing in the battery's path?";
        if (detail == 1) return "One of you leaves by the east door and clears the landing outside. The other pushes the battery out after.";
        return "Amber leaves east twice and steps aside. Teal pushes the battery east out of both boxes onto the socket; then each takes a goal.";
    }
    if (level == 1)
    {
        if (detail == 0) return "After the box moves, will the robot outside still have a way back in?";
        if (detail == 1) return "Someone stays inside the home while the other goes round to its south side and pushes it north.";
        return "Amber leaves by the north door, circles round the left side and pushes the occupied home north onto its outline. Teal then pushes the battery east out to the socket.";
    }
    if (level == 2)
    {
        if (detail == 0) return "Who can reach the place to push from outside? Who must stay with the battery?";
        if (detail == 1) return "Empty the tall room of its robot first. Move the occupied home north to line its east opening up with the tall room.";
        return "Amber leaves the tall room, goes round and pushes the home north. Teal pushes the battery east out of the home and into the tall room, onto its socket.";
    }
    if (level == 3)
    {
        if (detail == 0) return "Does a seated battery leave somewhere to stand beside the home?";
        if (detail == 1) return "The battery's socket is also where you stand to push the home east. Put the battery aside first.";
        return "Take the battery out and leave it off its socket. Push the home east onto its outline from the socket's cell, then bring the battery back to the socket.";
    }
    if (level == 4)
    {
        if (detail == 0) return "What happens to a box when the thing beside it is pushed into it, and nothing stands behind?";
        if (detail == 1) return "Nothing in a row holds it back. One push from the west moves the battery and the box together.";
        return "Amber leaves the home east and keeps going: the battery slides onto its socket and the box onto its outline in one push. Then each takes a goal.";
    }
    if (level == 5)
    {
        if (detail == 0) return "Walking into a box pushes it along. What could stand behind this one so that it stays where it is?";
        if (detail == 1) return "Your partner can be the wall. One of you goes round to the far side of the outline and waits there; then the other can walk in.";
        return "Teal leaves the home east and goes round to the goal just east of the outline. Amber leaves south, pushes the small box one step east onto its outline, then walks into it again: Teal stops the push, so Amber goes inside. Amber pushes the battery east onto its socket, comes back out west and steps onto the goal.";
    }
    if (detail == 0) return "A battery pushed at a box that cannot move goes in through its door. What can stop this box?";
    if (detail == 1) return "Your partner stands behind the box. Push the battery at it once and it goes in; push again and you follow, pushing it on.";
    return "Teal goes round to the goal east of the box. Amber leaves south and pushes the battery east: it goes into the box. Amber pushes again, goes in after it and seats it, then comes back out west onto the goal.";
}
