// Outward journeys through physically nested boxes and shared interiors.
void WorkshopTile(mut LevelLayout layout, int room, int2 at, Tile tile)
{
    if (room < 0) layout.tiles[at.y * layout.width + at.x] = tile;
    else layout.rooms[room].tiles[at.y * layout.rooms[room].width + at.x] = tile;
}
void WorkshopBlank(mut LevelLayout layout, mut Puzzle puzzle)
{
    layout = LevelLayout { width = 7, height = 7 };
    puzzle = Puzzle { };
    for (var room = 0; room < MAX_ROOMS; room++) layout.rooms[room] = RoomLayout { };
    for (var cell = 0; cell < 49; cell++) layout.tiles[cell] = Tile.Wall;
}
void WorkshopRoom(mut LevelLayout layout, mut Puzzle puzzle, int room, int2 at, int2 dock,
    int width = 5, int height = 5, int doors = 15, int parent = -1, int dockParent = -1,
    int north = -1, int east = -1, int south = -1, int west = -1)
{
    layout.roomCount = Math.Max(layout.roomCount, room + 1);
    layout.rooms[room] = RoomLayout { width = width, height = height, doors = doors,
        north = north, east = east, south = south, west = west, dock = dock, dockRoom = dockParent };
    puzzle.rooms[room] = RoomShell { room = parent, position = at };
    for (var cell = 0; cell < 49; cell++) layout.rooms[room].tiles[cell] = Tile.Wall;
    for (var y = 1; y < height - 1; y++)
        for (var x = 1; x < width - 1; x++) WorkshopTile(layout, room, int2(x, y), Tile.Floor);
    for (var side = 0; side < 4; side++)
        if ((doors & (1 << side)) != 0) WorkshopTile(layout, room, DoorCell(layout, room, side), Tile.Floor);
}
void WorkshopWalker(mut Puzzle puzzle, int seat, int room, int2 at)
{
    puzzle.actors[seat] = Traveler { room = room, position = at };
}
void WorkshopCargo(mut LevelLayout layout, mut Puzzle puzzle, int room, int2 at)
{
    puzzle.crates[layout.crateCount] = Cargo { room = room, position = at, active = true };
    layout.crateCount += 1;
}
void WorkshopReference(mut LevelLayout layout, mut Puzzle puzzle, int room, int2 at, int destination)
{
    layout.references[layout.referenceCount] = ReferenceLayout { destination = destination };
    puzzle.references[layout.referenceCount] = RoomShell { room = room, position = at };
    layout.referenceCount += 1;
}
void WorkshopPatch(mut LevelLayout layout, int room, int x0, int y0, int x1, int y1, Tile tile = Tile.Floor)
{
    for (var y = y0; y <= y1; y++)
        for (var x = x0; x <= x1; x++) WorkshopTile(layout, room, int2(x, y), tile);
}
void WorkshopClear(mut LevelLayout layout, int room)
{
    for (var cell = 0; cell < 49; cell++) layout.rooms[room].tiles[cell] = Tile.Wall;
}
void WorkshopContaining(mut LevelLayout layout, mut Puzzle puzzle, int room, int width = 7, int height = 5, int doors = 0)
{
    WorkshopTile(layout, -1, int2(3, 3), Tile.Floor);
    WorkshopRoom(layout, puzzle, room, int2(3, 3), int2(3, 3), width, height, doors);
}
void WorkshopCarryingFloor(mut LevelLayout layout, int parent)
{
    WorkshopClear(layout, parent);
    WorkshopPatch(layout, parent, 1, 2, 2, 4);
    WorkshopPatch(layout, parent, 3, 2, 3, 4);
    WorkshopPatch(layout, parent, 4, 2, 5, 2);
}
void WorkshopSeed(mut LevelLayout layout, mut Puzzle puzzle)
{
    for (var seat = 0; seat < 2; seat++)
    {
        mut var actor = puzzle.actors[seat];
        RebaseTrail(layout, puzzle, actor, actor.room, 0);
        puzzle.actors[seat] = actor;
    }
}

// Every box is a square grid, so its miniature fills the cell it stands in.
// A room authored longer one way is packed out with rows or columns of wall,
// the odd one below or to the right (above or to the left with `low`), and
// everything in it moves with it. A
// doorway on a packed side reaches the new edge along a corridor of floor.
void SquareRoom(mut LevelLayout layout, mut Puzzle puzzle, int room, bool low)
{
    var old = layout.rooms[room];
    var width = old.width;
    var height = old.height;
    if (width == height) return;
    var span = Math.Max(width, height);
    var odd = low ? 1 : 0;
    var shift = int2((span - width + odd) / 2, (span - height + odd) / 2);
    mut int2[4] doors = default;
    for (var side = 0; side < 4; side++) doors[side] = DoorCell(layout, room, side);
    mut var next = old;
    next.width = span;
    next.height = span;
    for (var cell = 0; cell < 49; cell++) next.tiles[cell] = Tile.Wall;
    for (var y = 0; y < height; y++)
        for (var x = 0; x < width; x++) next.tiles[(y + shift.y) * span + x + shift.x] = old.tiles[y * width + x];
    for (var side = 0; side < 4; side++)
    {
        if ((old.doors & (1 << side)) == 0 || doors[side].x < 0) continue;
        var at = doors[side] + shift;
        if (side == 0) next.north = at.x;
        if (side == 1) next.east = at.y;
        if (side == 2) next.south = at.x;
        if (side == 3) next.west = at.y;
        mut var walk = at;
        while (walk.x >= 0 && walk.y >= 0 && walk.x < span && walk.y < span)
        {
            if (next.tiles[walk.y * span + walk.x] == Tile.Wall) next.tiles[walk.y * span + walk.x] = Tile.Floor;
            walk = walk + Direction(side);
        }
    }
    layout.rooms[room] = next;
    for (var seat = 0; seat < 2; seat++)
        if (puzzle.actors[seat].room == room) puzzle.actors[seat].position = puzzle.actors[seat].position + shift;
    for (var crate = 0; crate < MAX_CRATES; crate++)
        if (puzzle.crates[crate].active && puzzle.crates[crate].room == room) puzzle.crates[crate].position = puzzle.crates[crate].position + shift;
    for (var box = 0; box < MAX_ROOMS; box++)
    {
        if (puzzle.rooms[box].room == room && box < layout.roomCount) puzzle.rooms[box].position = puzzle.rooms[box].position + shift;
        if (layout.rooms[box].dockRoom == room && layout.rooms[box].dock.x >= 0) layout.rooms[box].dock = layout.rooms[box].dock + shift;
    }
    for (var copy = 0; copy < layout.referenceCount; copy++)
        if (puzzle.references[copy].room == room) puzzle.references[copy].position = puzzle.references[copy].position + shift;
}

void LoadLevel(int level, mut LevelLayout layout, mut Puzzle puzzle)
{
    WorkshopBlank(layout, puzzle);
    switch (Math.Clamp(level, 0, LEVEL_COUNT - 1))
    {
        case 0:
            WorkshopContaining(layout, puzzle, 1, 4, 3, 2);
            WorkshopRoom(layout, puzzle, 0, int2(1, 1), int2(1, 1), 3, 3, 10, 1, 1);
            WorkshopWalker(puzzle, 0, 0, int2(2, 1));
            WorkshopWalker(puzzle, 1, 0, int2(0, 1));
            WorkshopCargo(layout, puzzle, 0, int2(1, 1));
            WorkshopPatch(layout, -1, 4, 2, 4, 4);
            WorkshopTile(layout, -1, int2(5, 3), Tile.Target);
            WorkshopTile(layout, -1, int2(4, 2), Tile.Exit);
            WorkshopTile(layout, -1, int2(4, 4), Tile.Exit);
            break;
        case 1:
            // The outside maker cannot re-enter after docking. Carry the
            // inside maker to an export route, rather than move an empty box.
            WorkshopContaining(layout, puzzle, 1, 7, 6);
            WorkshopCarryingFloor(layout, 1);
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 2), 5, 4, 3, 1, 1, 1, 1);
            WorkshopTile(layout, 0, int2(1, 2), Tile.Wall);
            WorkshopWalker(puzzle, 0, 0, int2(1, 0));
            WorkshopWalker(puzzle, 1, 0, int2(1, 1));
            WorkshopCargo(layout, puzzle, 0, int2(2, 1));
            WorkshopTile(layout, 1, int2(5, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(2, 4), Tile.Exit);
            WorkshopTile(layout, 1, int2(4, 2), Tile.Exit);
            break;
        case 2:
            WorkshopContaining(layout, puzzle, 2, 7, 6);
            WorkshopCarryingFloor(layout, 2);
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 2), 5, 4, 3, 2, 2, 1, 1);
            WorkshopTile(layout, 0, int2(1, 2), Tile.Wall);
            WorkshopRoom(layout, puzzle, 1, int2(5, 2), int2(5, 2), 4, 5, 8, 2, 2, -1, -1, -1, 1);
            WorkshopWalker(puzzle, 0, 1, int2(1, 3));
            WorkshopWalker(puzzle, 1, 0, int2(1, 1));
            WorkshopCargo(layout, puzzle, 0, int2(2, 1));
            WorkshopTile(layout, 1, int2(2, 1), Tile.Target);
            WorkshopTile(layout, 2, int2(2, 4), Tile.Exit);
            WorkshopTile(layout, 2, int2(4, 2), Tile.Exit);
            break;
        case 3:
            WorkshopContaining(layout, puzzle, 1, 7, 5);
            WorkshopPatch(layout, 1, 1, 0, 5, 0);
            WorkshopTile(layout, 1, int2(2, 1), Tile.Wall);
            WorkshopRoom(layout, puzzle, 0, int2(2, 2), int2(3, 2), 5, 5, 12, 1, 1);
            WorkshopWalker(puzzle, 0, 0, int2(1, 1));
            WorkshopWalker(puzzle, 1, 0, int2(3, 1));
            WorkshopCargo(layout, puzzle, 0, int2(2, 2));
            WorkshopTile(layout, 1, int2(1, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(5, 3), Tile.Exit);
            break;
        case 4:
            WorkshopContaining(layout, puzzle, 2, 7, 5);
            WorkshopClear(layout, 2);
            WorkshopPatch(layout, 2, 1, 2, 5, 3);
            WorkshopTile(layout, 2, int2(3, 1), Tile.Floor);
            WorkshopTile(layout, 2, int2(3, 0), Tile.Floor);
            WorkshopRoom(layout, puzzle, 0, int2(2, 2), int2(4, 2), 4, 4, 15, 2, 2, 1, 1, 2, 2);
            WorkshopRoom(layout, puzzle, 1, int2(4, 2), int2(2, 2), 5, 3, 10, 2, 2);
            WorkshopWalker(puzzle, 0, 0, int2(1, 2));
            WorkshopWalker(puzzle, 1, 1, int2(3, 1));
            WorkshopCargo(layout, puzzle, 0, int2(2, 1));
            WorkshopTile(layout, 1, int2(3, 1), Tile.Target);
            WorkshopTile(layout, 2, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 2, int2(5, 3), Tile.Exit);
            break;
        case 5:
            WorkshopContaining(layout, puzzle, 1, 7, 5);
            WorkshopClear(layout, 1);
            WorkshopPatch(layout, 1, 2, 3, 4, 3);
            WorkshopTile(layout, 1, int2(3, 2), Tile.Floor);
            WorkshopRoom(layout, puzzle, 0, int2(3, 2), int2(3, 2), 5, 6, 15, 1, 1, 1, 2, 3, 3);
            WorkshopTile(layout, 0, int2(2, 3), Tile.Wall);
            WorkshopReference(layout, puzzle, 0, int2(3, 2), 0);
            WorkshopWalker(puzzle, 0, 0, int2(4, 2));
            WorkshopWalker(puzzle, 1, 0, int2(2, 1));
            WorkshopCargo(layout, puzzle, 0, int2(1, 1));
            WorkshopTile(layout, 0, int2(1, 4), Tile.Target);
            WorkshopTile(layout, 1, int2(2, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(4, 3), Tile.Exit);
            break;
        case 6:
            WorkshopContaining(layout, puzzle, 2, 7, 5);
            WorkshopTile(layout, 2, int2(4, 0), Tile.Floor);
            WorkshopTile(layout, 2, int2(3, 1), Tile.Wall);
            WorkshopTile(layout, 2, int2(5, 1), Tile.Wall);
            WorkshopRoom(layout, puzzle, 0, int2(4, 2), int2(4, 1), 5, 4, 15, 2, 2, 2, 1, 3, 1);
            WorkshopPatch(layout, 0, 1, 0, 3, 0);
            WorkshopRoom(layout, puzzle, 1, int2(3, 2), int2(0, 1), 4, 5, 15, 2, 0, 1, 1, 1, 3);
            WorkshopWalker(puzzle, 0, 0, int2(3, 2));
            WorkshopWalker(puzzle, 1, 1, int2(1, 3));
            WorkshopCargo(layout, puzzle, 1, int2(2, 1));
            WorkshopTile(layout, 0, int2(2, 2), Tile.Target);
            WorkshopTile(layout, 2, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 2, int2(5, 3), Tile.Exit);
            break;
        case 7:
            WorkshopContaining(layout, puzzle, 2, 7, 5, 4);
            WorkshopPatch(layout, 2, 1, 0, 5, 0);
            WorkshopTile(layout, 2, int2(3, 1), Tile.Wall);
            WorkshopRoom(layout, puzzle, 0, int2(4, 2), int2(4, 1), 5, 4, 15, 2, 2, 2, 1, 3, 1);
            WorkshopRoom(layout, puzzle, 1, int2(3, 2), int2(0, 1), 5, 3, 10, 2, 0);
            WorkshopWalker(puzzle, 0, 1, int2(3, 1));
            WorkshopWalker(puzzle, 1, 0, int2(1, 1));
            WorkshopCargo(layout, puzzle, 1, int2(2, 1));
            WorkshopTile(layout, 2, int2(2, 2), Tile.Target);
            WorkshopPatch(layout, -1, 2, 4, 4, 4);
            WorkshopTile(layout, -1, int2(2, 4), Tile.Exit);
            WorkshopTile(layout, -1, int2(4, 4), Tile.Exit);
            break;
        case 8:
            WorkshopContaining(layout, puzzle, 2, 7, 5);
            WorkshopClear(layout, 2);
            WorkshopPatch(layout, 2, 2, 3, 5, 3);
            WorkshopTile(layout, 2, int2(3, 2), Tile.Floor);
            WorkshopTile(layout, 2, int2(5, 2), Tile.Floor);
            WorkshopRoom(layout, puzzle, 0, int2(3, 2), int2(3, 2), 5, 5, 15, 2, 2, 1, 2, 3, 2);
            WorkshopPatch(layout, 0, 1, 4, 3, 4);
            WorkshopRoom(layout, puzzle, 1, int2(5, 2), int2(5, 2), 4, 5, 15, 2, 2, 1, 2, 1, 2);
            WorkshopTile(layout, 1, int2(3, 1), Tile.Floor);
            WorkshopReference(layout, puzzle, 0, int2(3, 3), 1);
            WorkshopReference(layout, puzzle, 1, int2(1, 2), 0);
            WorkshopWalker(puzzle, 0, 0, int2(2, 3));
            WorkshopWalker(puzzle, 1, 1, int2(1, 3));
            WorkshopCargo(layout, puzzle, 0, int2(1, 1));
            WorkshopCargo(layout, puzzle, 0, int2(1, 2));
            WorkshopTile(layout, 0, int2(1, 3), Tile.Target);
            WorkshopTile(layout, 0, int2(3, 2), Tile.Target);
            WorkshopTile(layout, 2, int2(2, 3), Tile.Exit);
            WorkshopTile(layout, 2, int2(4, 3), Tile.Exit);
            break;
        case 9:
            WorkshopContaining(layout, puzzle, 1, 6, 6);
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 2), 5, 6, 15, 1, 1, 2, 2, 2, 2);
            WorkshopTile(layout, 1, int2(1, 4), Tile.Wall);
            WorkshopTile(layout, 1, int2(2, 4), Tile.Wall);
            WorkshopTile(layout, 0, int2(2, 1), Tile.Wall);
            WorkshopPatch(layout, 0, 0, 3, 0, 5);
            WorkshopTile(layout, 0, int2(1, 5), Tile.Floor);
            WorkshopReference(layout, puzzle, 1, int2(2, 3), 0);
            WorkshopWalker(puzzle, 0, 0, int2(2, 0));
            WorkshopWalker(puzzle, 1, 0, int2(1, 1));
            WorkshopCargo(layout, puzzle, 0, int2(1, 2));
            WorkshopCargo(layout, puzzle, 0, int2(2, 3));
            WorkshopTile(layout, 0, int2(1, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(1, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(4, 2), Tile.Exit);
            break;
        case 10:
            WorkshopContaining(layout, puzzle, 2, 7, 6);
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(1, 4), 5, 6, 15, 2, 1, 2, 2, 2, 2);
            WorkshopRoom(layout, puzzle, 1, int2(5, 4), int2(5, 4), 3, 5, 15, 2, 2, 1, 1, 1, 2);
            WorkshopClear(layout, 2);
            WorkshopPatch(layout, 2, 2, 3, 5, 3);
            WorkshopTile(layout, 2, int2(5, 4), Tile.Floor);
            WorkshopPatch(layout, 1, 2, 2, 2, 4);
            WorkshopTile(layout, 0, int2(0, 1), Tile.Floor);
            WorkshopTile(layout, 0, int2(0, 3), Tile.Floor);
            WorkshopTile(layout, 0, int2(1, 5), Tile.Floor);
            WorkshopReference(layout, puzzle, 2, int2(4, 3), 0);
            WorkshopReference(layout, puzzle, 0, int2(0, 1), 1);
            WorkshopWalker(puzzle, 0, 0, int2(0, 2));
            WorkshopWalker(puzzle, 1, 0, int2(4, 2));
            WorkshopCargo(layout, puzzle, 0, int2(1, 3));
            WorkshopTile(layout, 0, int2(1, 3), Tile.Target);
            WorkshopTile(layout, 2, int2(2, 3), Tile.Exit);
            WorkshopTile(layout, 2, int2(5, 3), Tile.Exit);
            break;
        case 11:
            WorkshopContaining(layout, puzzle, 3, 7, 6);
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 0), 5, 5, 15, 3, 2);
            WorkshopRoom(layout, puzzle, 1, int2(4, 2), int2(4, 2), 5, 5, 15, 0, 0);
            WorkshopRoom(layout, puzzle, 2, int2(5, 4), int2(5, 4), 5, 4, 15, 3, 3, 2, 1, 2, 2);
            WorkshopClear(layout, 3);
            WorkshopPatch(layout, 3, 2, 3, 5, 3);
            WorkshopPatch(layout, 3, 4, 4, 5, 4);
            WorkshopReference(layout, puzzle, 3, int2(4, 3), 1);
            WorkshopReference(layout, puzzle, 1, int2(0, 3), 2);
            WorkshopTile(layout, 1, int2(0, 1), Tile.Floor);
            WorkshopTile(layout, 1, int2(0, 3), Tile.Floor);
            WorkshopPatch(layout, 2, 1, 0, 3, 0);
            WorkshopTile(layout, 2, int2(3, 3), Tile.Floor);
            WorkshopWalker(puzzle, 0, 0, int2(0, 2));
            WorkshopWalker(puzzle, 1, 0, int2(2, 0));
            WorkshopCargo(layout, puzzle, 0, int2(3, 2));
            WorkshopTile(layout, 3, int2(5, 3), Tile.Target);
            WorkshopTile(layout, 3, int2(2, 3), Tile.Exit);
            WorkshopTile(layout, 3, int2(4, 4), Tile.Exit);
            break;
    }
    for (var room = 0; room < layout.roomCount; room++) SquareRoom(layout, puzzle, room, level == 8 && room == 1);
    WorkshopSeed(layout, puzzle);
}
string ChapterName(int level)
{
    if (level < 4) return "Beyond the first walls";
    if (level < 8) return "Borrowed space";
    return "The same place again";
}
string LevelName(int level)
{
    switch (level)
    {
        case 0: return "A room outside";
        case 1: return "No handle inside";
        case 2: return "The other opening";
        case 3: return "A place to stand";
        case 4: return "Passing place";
        case 5: return "The same corner";
        case 6: return "Carried together";
        case 7: return "Before it moves";
        case 8: return "Two ways home";
        case 9: return "Return address";
        case 10: return "Folded landing";
        case 11: return "Crossed return";
    }
    return "Inside Out";
}
string LevelLesson(int level)
{
    if (level == 0) return "Deliver the parcel beyond both boxes. Find a player goal for each dummy.";
    if (level == 1) return "Move the home onto its outline and deliver its parcel into the containing room.";
    if (level == 2) return "Dock the home and deliver its parcel inside the other box.";
    if (level == 3) return "Leave the parcel on the left target and the home on the right outline.";
    if (level == 4) return "Trade the two boxes' places and deliver the parcel into the long room.";
    if (level == 5) return "Deliver the parcel down the left corridor, then leave this room together.";
    if (level == 6) return "Nest the narrow box, deliver the parcel inside the larger box, and park it.";
    if (level == 7) return "Deliver the parcel, pack the boxes onto their outlines, then leave both enclosing rooms.";
    if (level == 8) return "Deliver both parcels in the same interior and return to the containing room.";
    if (level == 9) return "Move the home onto its outline, keep one parcel inside, and deliver the other outward.";
    if (level == 10) return "Park the home inside the narrow room, restore its parcel, and leave both rooms.";
    if (level == 11) return "Park the home inside the third room and deliver the parcel into the larger containing space.";
    return "Deliver every parcel, match the box outlines, and reach the larger space's player goals.";
}
string LevelHint(int level, int tier)
{
    var detail = Math.Clamp(tier, 0, 2);
    if (level == 0)
    {
        if (detail == 0) return "Where does your doorway lead? What is standing in the parcel's path?";
        if (detail == 1) return "Let Amber leave through the east door and clear the outside landing. Teal can push the parcel east through both boxes.";
        return "Amber: east three times, then north. Teal: east five times, then south. Both finish in the larger outside space.";
    }
    if (level == 1)
    {
        if (detail == 0) return "After the box moves, will the dummy outside still have a way back in?";
        if (detail == 1) return "Someone must stay inside the left box while the other reaches its south side and pushes it north.";
        return "Keep the parcel's dummy inside. Leave by the north door, circle around the left side, and push the occupied box north. Its east doorway now reaches the delivery route.";
    }
    if (level == 2)
    {
        if (detail == 0) return "Who can reach the outside pushing stance? Who must stay with the parcel?";
        if (detail == 1) return "Empty the tall receiving room of its dummy first. Move the occupied home north to align its east opening with the receiver.";
        return "Amber: north twice, west four times, south twice, east, north. Teal: east six times delivers the parcel, then west twice returns. Amber finishes west, south.";
    }
    if (level == 3)
    {
        if (detail == 0) return "Does a finished parcel leave somewhere to stand beside the home?";
        if (detail == 1) return "The parcel's target is also the stance for pushing the home east. Store the parcel one cell north, move the occupied home, then restore the parcel from above.";
        return "Teal exports the parcel west. Amber leaves south, pushes that parcel north, and pushes the home east twice. Circle over the top to restore the parcel; approach the home from its right and push it west onto the outline. Teal can finally leave west.";
    }
    if (level == 4)
    {
        if (detail == 0) return "How can two boxes pass in a corridor that is only one cell wide at the top?";
        if (detail == 1) return "Deliver before trading places. Use the bay at the top for the long room, and keep a dummy above it to push it back out.";
        return "Amber posts the parcel east out of the home. Teal leaves the long room east and waits behind it to stop its push, so Amber can push the parcel in and follow it. Deliver inside, then Amber waits at the top of the bay while Teal brings the long room left; park it north at the middle bay. Teal moves the home right, Amber releases the parked room, then Teal leaves the home west to put the long room on its left outline.";
    }
    if (level == 5)
    {
        if (detail == 0) return "Where is the standing tile above the parcel? Can a doorway lead back into this room?";
        if (detail == 1) return "Move the small copy one cell left. Its south backstop makes entry from above reach the home room's shifted north door.";
        return "Amber pushes the copy west, then leaves by the south door. Teal enters the copy from its north side and pushes the parcel down three cells. Return north through the same copy, take the right corridor, and leave south.";
    }
    if (level == 6)
    {
        if (detail == 0) return "The narrow box can travel inside the larger one. Who should be in it when it goes?";
        if (detail == 1) return "Nest the narrow box first, with Teal still inside it. Teal can then deliver the parcel from inside the larger room before that room is parked.";
        return "Amber leaves south, walks round and pushes the narrow box east into the larger room with Teal inside. Teal leaves the narrow box east, pushing the parcel along, steps round it and pushes it down onto its target, then leaves the larger room east. Amber pushes the larger room north onto its outline, and both walk to their goals.";
    }
    if (level == 7)
    {
        if (detail == 0) return "Where would this parcel emerge after its box changes parent?";
        if (detail == 1) return "Export the parcel west before nesting its home. Empty its target briefly to recover the stance for pushing the occupied box east.";
        return "Amber posts the parcel west and stays inside. Teal leaves south, stores the parcel one cell north, and nests Amber's box east. Amber leaves the nested box through its right door, circles over the top to restore the parcel, then parks the containing box north. Both leave through the largest room's south door.";
    }
    if (level == 8)
    {
        if (detail == 0) return "Which parcel must move first to clear a standing tile for the other?";
        if (detail == 1) return "Use the other room's movable copy to reach the home's west door. After moving that copy right, its north approach reaches the home's shifted north doorway.";
        return "Amber walks east six times through the two copies, delivering the lower parcel right. Teal moves north twice and east twice, then enters south and delivers the remaining parcel down. Teal returns north through the copy and leaves the narrow room south. Amber returns west through the copy; leaving that room south brings Amber back to the original home's south door, then outward.";
    }
    if (level == 9)
    {
        if (detail == 0) return "What happens to a copy's outward address when its containing box moves?";
        if (detail == 1) return "Put the copy inside its own home, then move the occupied home north. Empty the upper parcel's target temporarily to reach the stance for extracting the copy.";
        return "Amber leaves north, circles left and pushes the copy east into the home. Shift the occupied home north onto its outline. Teal moves the upper parcel down, reaches the copy's right side and exports it west. Amber stores that copy north to free the outside route. Teal posts the other parcel west and restores the first from the lower alcove; then both leave the home.";
    }
    if (level == 10)
    {
        if (detail == 0) return "Can a box pass into its own interior before reaching the room on its outline?";
        if (detail == 1) return "Push the home through its outside copy. Inside the resulting self-containment, the west-side copy of the narrow room can receive the home from below.";
        return "Amber leaves west and pushes the home east into its own copy. Teal leaves the cycle, moves the parcel down to recover the west standing tile, then pushes the home north through the narrow-room copy. Restore the parcel from its lower alcove. Leave the home north, cross the narrow room's offset east corridor, and leave north into the larger space.";
    }
    if (level == 11)
    {
        if (detail == 0) return "Which doorway can change a closed pair of boxes into an outward route?";
        if (detail == 1) return "Push the home into the box already inside it. The copy on that box's lower west edge can extract the home into the third room's north doorway.";
        return "Amber leaves west and pushes the home east into its child, making a two-box cycle. Teal uses the north doorway to reach the child, then pushes the home south through the third-room copy. Post the parcel west into the third room and move the home right onto its outline, clearing the north doorway. Teal delivers the parcel south into the larger space and returns through that doorway to leave at the offset east goal. Amber finishes at the left goal.";
    }
    return "Explore the openings together. Shared undo returns to a clear arrangement.";
}
