// The puzzles, drawn as text: one function for each, which draws the table
// and each room as a map.
//
//     Room(draft, 0, [
//         "#####  .....",
//         "#...#  .@...",
//         "...o#  ..+..",
//         "#...#  .....",
//         "#####  .....",
//     ]);
//
// A map is the table's (room -1) or a room's (0 to 3, which is also the id of
// the box that holds it; the game names it Box 1 to 4). It is square, one
// string a row, at the room's own size: 3 to 7 for a box, 1 to 7 for the
// table. A table nobody draws is 7 by 7 and all wall. Each row is the tiles,
// then spaces, then what stands on them, the same width:
//
//   Tiles                                  What stands on them
//   #    wall                              .    nothing
//   .    floor                             @    Amber, the first robot (seat 0)
//   o    socket, where a battery goes      &    Teal, the second robot (seat 1)
//   x    goal, where a robot ends          +    a battery
//   a A  plate A, shutter A                0-3  box 0 to 3
//   b B  plate B, shutter B
//   0-3  floor with the outline of box 0 to 3: where that box has to end
//
// So a robot on a goal is an x under an @, a battery on a plate an a under
// a +, and a box on its own outline its digit in both halves.
// - Doorways come from a room's edge, which is wall but for them: an open
//   cell (anything but #) on a side, not at a corner, is that side's
//   doorway, one a side at most. The table has none.
// - A box stands where its digit is in the other half of a map: a box in
//   its own room's map is inside itself, two boxes in each other's are a
//   cycle. Every room that is drawn has its box somewhere.
// - Batteries are numbered in the order they are drawn.
// A map that breaks one of these stops the game with what is wrong, on the
// first load of that puzzle (the campaign test loads them all).

// A puzzle as it is drawn, with what has been drawn so far.
struct Draft
{
    LevelLayout layout;
    Puzzle puzzle;
    int level;
    // A bit for each map drawn: the table's is the first, then each room's.
    int drawn;
    // A bit for each box that stands somewhere, and each robot.
    int placed;
    int robots;
}

string MapName(Draft draft, int room)
{
    return room < 0 ? $"Puzzle {draft.level + 1}, the table" : $"Puzzle {draft.level + 1}, room {room}";
}
void SetTile(mut LevelLayout layout, int room, int2 at, Tile tile)
{
    if (room < 0) layout.tiles[at.y * layout.width + at.x] = tile;
    else layout.rooms[room].tiles[at.y * layout.rooms[room].width + at.x] = tile;
}
// What a mark in a map's tiles is. A digit is floor with a box's outline on it.
Tile MapTile(char mark, out bool known)
{
    known = true;
    switch (mark)
    {
        case '#': return Tile.Wall;
        case 'o': return Tile.Target;
        case 'x': return Tile.Exit;
        case 'a': return Tile.PlateA;
        case 'A': return Tile.ShutterA;
        case 'b': return Tile.PlateB;
        case 'B': return Tile.ShutterB;
        case '.':
        case '0':
        case '1':
        case '2':
        case '3':
            return Tile.Floor;
    }
    known = false;
    return Tile.Wall;
}
void DrawTile(mut Draft draft, int room, int2 at, char mark)
{
    var tile = MapTile(mark, out var known);
    Debug.Assert(known, $"{MapName(draft, room)}: '{mark}' at {at} is no tile");
    SetTile(draft.layout, room, at, tile);
    if (mark < '0' || mark > '3') return;
    var box = mark - '0';
    Debug.Assert(draft.layout.rooms[box].dock.x < 0, $"{MapName(draft, room)}: box {box} has a second outline at {at}");
    draft.layout.rooms[box].dock = at;
    draft.layout.rooms[box].dockRoom = room;
}
void DrawThing(mut Draft draft, int room, int2 at, char mark)
{
    if (mark == '.') return;
    var where = MapName(draft, room);
    Debug.Assert(TileAt(draft.layout, room, at) != Tile.Wall, $"{where}: '{mark}' at {at} stands in a wall");
    if (mark == '@' || mark == '&')
    {
        var seat = mark == '@' ? 0 : 1;
        Debug.Assert((draft.robots & (1 << seat)) == 0, $"{where}: robot '{mark}' is drawn twice");
        draft.robots |= 1 << seat;
        draft.puzzle.actors[seat] = Traveler { room = room, position = at };
    }
    else if (mark == '+')
    {
        Debug.Assert(draft.layout.crateCount < MAX_CRATES, $"{where}: more than {MAX_CRATES} batteries");
        if (draft.layout.crateCount >= MAX_CRATES) return;
        draft.puzzle.crates[draft.layout.crateCount] = Cargo { room = room, position = at, active = true };
        draft.layout.crateCount += 1;
    }
    else if (mark >= '0' && mark <= '3')
    {
        var box = mark - '0';
        Debug.Assert((draft.placed & (1 << box)) == 0, $"{where}: box {box} stands in two places");
        draft.placed |= 1 << box;
        draft.puzzle.rooms[box] = RoomShell { room = room, position = at };
    }
    else Debug.Assert(false, $"{where}: '{mark}' at {at} is nothing that stands on a tile");
}
string SideName(int side)
{
    if (side == 0) return "north";
    if (side == 1) return "east";
    return side == 2 ? "south" : "west";
}
// A room's doorways are the open cells of its edge, one a side at most, and
// none at a corner. One in the middle of its side is the default (-1).
void Doorways(mut Draft draft, int room)
{
    var size = draft.layout.rooms[room].width;
    var last = size - 1;
    var where = MapName(draft, room);
    for (var corner = 0; corner < 4; corner++)
    {
        var at = int2(corner % 2 == 0 ? 0 : last, corner < 2 ? 0 : last);
        Debug.Assert(TileAt(draft.layout, room, at) == Tile.Wall, $"{where}: the corner at {at} is open; a doorway is on a side, not at a corner");
    }
    mut var doors = 0;
    for (var side = 0; side < 4; side++)
    {
        mut var door = -1;
        mut var count = 0;
        for (var along = 1; along < last; along++)
        {
            var at = side == 0 ? int2(along, 0) : side == 1 ? int2(last, along) : side == 2 ? int2(along, last) : int2(0, along);
            if (TileAt(draft.layout, room, at) == Tile.Wall) continue;
            count += 1;
            if (door < 0) door = along;
        }
        Debug.Assert(count <= 1, $"{where}: {count} doorways on the {SideName(side)} side; a side has one at most");
        if (door >= 0) doors |= 1 << side;
        var offset = door == size / 2 ? -1 : door;
        if (side == 0) draft.layout.rooms[room].north = offset;
        else if (side == 1) draft.layout.rooms[room].east = offset;
        else if (side == 2) draft.layout.rooms[room].south = offset;
        else draft.layout.rooms[room].west = offset;
    }
    draft.layout.rooms[room].doors = doors;
}
// One map: the table's (room -1) or a room's. See the top of this file.
void Room(mut Draft draft, int room, List<string> rows)
{
    var where = MapName(draft, room);
    Debug.Assert(room >= -1 && room < MAX_ROOMS, $"{where}: there are rooms 0 to {MAX_ROOMS - 1} and the table, -1");
    if (room < -1 || room >= MAX_ROOMS) return;
    Debug.Assert((draft.drawn & (1 << (room + 1))) == 0, $"{where} is drawn twice");
    draft.drawn |= 1 << (room + 1);
    var least = room < 0 ? 1 : 3;
    Debug.Assert(rows.count >= least && rows.count <= 7, $"{where} has {rows.count} rows, and is {least} to 7 square");
    var size = Math.Clamp(rows.count, least, 7);
    if (room < 0)
    {
        draft.layout.width = size;
        draft.layout.height = size;
    }
    else
    {
        draft.layout.roomCount = Math.Max(draft.layout.roomCount, room + 1);
        draft.layout.rooms[room].width = size;
        draft.layout.rooms[room].height = size;
        for (var cell = 0; cell < 49; cell++) draft.layout.rooms[room].tiles[cell] = Tile.Wall;
    }
    for (var y = 0; y < size; y++)
    {
        var row = rows[y];
        var gap = row.IndexOf(' ');
        var tiles = gap < 0 ? row : row.Substring(0, gap);
        var things = gap < 0 ? "" : row.Substring(gap).Trim();
        Debug.Assert(tiles.length == size && things.length == size, $"{where}, row {y}: {size} tiles, spaces, then {size} things");
        for (var x = 0; x < size; x++) DrawTile(draft, room, int2(x, y), tiles[x]);
        for (var x = 0; x < size; x++) DrawThing(draft, room, int2(x, y), things[x]);
    }
    if (room >= 0) Doorways(draft, room);
}

// 1. Two robots in a corridor of a box, in a room on the table.
void ARoomOutside(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "####x##  .......",
        "###1.o#  ...1...",
        "####x##  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "###  ...",
        "...  &+@",
        "###  ...",
    ]);
    Room(draft, 1, [
        "####  ....",
        "#0..  .0..",
        "#..#  ....",
        "####  ....",
    ]);
}
// 2. The robot outside cannot get back in once the home is parked: carry the
// one inside to the way out, rather than move an empty box.
void NoHandleInside(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#.###  .@...",
        "#....  .&+..",
        "##..#  .....",
        "#...#  .....",
        "#####  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#######  .......",
        "#..0xo#  .......",
        "#...###  ...0...",
        "#.x.###  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
}
// 3. The home's battery goes into the tall room beside it, once the home is
// pushed to line its east opening up with the tall room's west one.
void TheOtherOpening(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###2###  ...2...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#.###  .....",
        "#....  .&+..",
        "##..#  .....",
        "#...#  .....",
        "#####  .....",
    ]);
    Room(draft, 1, [
        "#####  .....",
        "..o.#  .....",
        "#...#  .....",
        "#...#  .@...",
        "#####  .....",
    ]);
    Room(draft, 2, [
        "#######  .......",
        "#######  .......",
        "#..0x1#  .....1.",
        "#...###  ...0...",
        "#.x.###  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
}
// 4. The socket is the cell to push the home from: leave the battery inside
// until the home is on its outline, then deliver it through the west door.
void APlaceToStand(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#####  .....",
        "#...#  .@.&.",
        "....#  ..+..",
        "#...#  .....",
        "##.##  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#.....#  .......",
        "#.#...#  .......",
        "#o.0..#  ..0....",
        "#x...x#  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
}
// 5. A row moves as one, however long: a battery, a box and nothing to stop
// them.
void AllInARow(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#####  .....",
        "#...#  .....",
        "#....  ..&@.",
        "#...#  .....",
        "#####  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#.x...#  .......",
        "#.....#  .......",
        "#0..o2#  .0.+2..",
        "#.....#  .......",
        "#.x...#  .......",
        "#######  .......",
    ]);
    Room(draft, 2, [
        "###  ...",
        "..#  ...",
        "###  ...",
    ]);
}
// 6. A box only lets a robot in while it cannot move, and this one has open
// floor behind its outline: the partner is the wall. The room is a figure of
// eight round two blocks, so either robot can reach either side of the small
// box, and nothing else can be put behind it. The home is in a corner and
// cannot be moved.
void HoldItSteady(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#####  .....",
        "#...#  .....",
        "#....  ...&.",
        "#...#  ..@..",
        "##.##  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#0....#  .0.....",
        "#.###.#  .......",
        "#x.2x.#  ..2....",
        "#.###.#  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
    Room(draft, 2, [
        "#####  .....",
        "#...#  .....",
        "...o#  ..+..",
        "#...#  .....",
        "#####  .....",
    ]);
}
// 7. A battery goes into a box that cannot move, and so does the robot
// behind it. The room is the figure of eight of the puzzle before, so the
// partner can stand behind the box.
void Posted(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#####  .....",
        "#...#  .....",
        "#....  ...&.",
        "#...#  ..@..",
        "##.##  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#0....#  .0.....",
        "#.###.#  .......",
        "#x.2x.#  ..+2...",
        "#.###.#  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
    Room(draft, 2, [
        "###  ...",
        ".o#  ...",
        "###  ...",
    ]);
}

// Reposition the box first, then exchange which side is held steady.
void ChangeEnds(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#1#  .1.", "###  ..."]);
    Room(draft, 0, [
        "#####  .....", "#...#  .....", "#....  ...&.",
        "#...#  ..@..", "##.##  .....",
    ]);
    Room(draft, 1, [
        "#######  .......", "#0....#  .0.....", "#.###.#  .......",
        "#x.2.x#  ..2....", "#.###.#  .......", "#.....#  .......", "#######  .......",
    ]);
    Room(draft, 2, [
        "#####  .....", "#...#  .....", ".o...  ..+..", "#...#  .....", "#####  .....",
    ]);
}
// The posted battery needs a turn inside; do not push it beyond that turn.
void AroundTheCorner(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#1#  .1.", "###  ..."]);
    Room(draft, 0, [
        "#####  .....", "#...#  .....", "#....  ...&.",
        "#...#  ..@..", "##.##  .....",
    ]);
    Room(draft, 1, [
        "#######  .......", "#0....#  .0.....", "#.###.#  .......",
        "#x.2x.#  ..+2...", "#.###.#  .......", "#.....#  .......", "#######  .......",
    ]);
    Room(draft, 2, [
        "#####  .....", "#.o.#  .....", "....#  .....", "#...#  .....", "#####  .....",
    ]);
}
// A separate plate holder lets the battery pass the dividing shutter.
void HoldTheLine(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#..#..#  .......", "#..A.o#  .&+....",
        "#..#..#  .......", "#a.#..#  .@.....", "#x.#.x#  .......", "#######  .......",
    ]);
}
// Wiring crosses room boundaries, even while the plate holder is inside.
void LongWire(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#1.#..#  .1.....", "#..#..#  .......",
        "#..A.o#  .&+....", "#..#..#  .......", "#x.#.x#  .......", "#######  .......",
    ]);
    Room(draft, 1, ["###  ...", "#a#  .@.", "#.#  ..."]);
}
// The far-side plate frees the first holder, so both can cross.
void PassItOn(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#..#..#  .......", "#..A.o#  .&+....",
        "#..#..#  .......", "#a.#.a#  .@.....", "#..#xx#  .......", "#######  .......",
    ]);
}
// The second circuit opens a different route for the first plate holder.
void BorrowedPower(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#..#..#  .......", "#..A.o#  .&+....",
        "#..#..#  .......", "#a.B.b#  .@.....", "#..#xx#  .......", "#######  .......",
    ]);
}
// A battery inside the box powers the shutter the occupied box passes.
// The inside robot then becomes the backstop that lets its partner aboard.
void CarryTheCurrent(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#..#..#  .......", "#..#.x#  .......",
        "#..A1x#  .@1....", "#..#..#  .......", "#..#..#  .......", "#######  .......",
    ]);
    Room(draft, 1, [
        "#####  .....", "#.o.#  .....", "..a..  ..+..", "#...#  ..&..", "#####  .....",
    ]);
}
// Leaving north seats the battery beside the very box that contains it.
// The arriving partner then holds that box so the other robot can enter it.
void BesideItself(mut Draft draft)
{
    Room(draft, 0, [
        "#####.#  .......", "#o###.#  .......", "#x###.#  .+.....",
        "#0###.#  .0...&.", "#.###.#  .@.....", "#####x#  .......", "#####.#  .......",
    ]);
}
// Move a self-containing box to move where its north doorway comes out.
void ShiftTheExit(mut Draft draft)
{
    Room(draft, 0, [
        "#####.#  .......", "#x###.#  .@...+.", "#.###.#  .0...&.",
        "#o###.#  .......", "#0###.#  .......", "#.###x#  .......", "#####.#  .......",
    ]);
}
// Move the outside box in the other room before sending the battery out.
// The receiving robot's alcove cannot be reached from the delivery landing.
void ReturnDelivery(mut Draft draft)
{
    Room(draft, 0, [
        "#####  .....", "#1..#  .1...", "#.x..  ..@+.", "#...#  .....", "#####  .....",
    ]);
    Room(draft, 1, [
        "#####  .....", "#x#.#  .&...", "#.#.#  .0...", "#0o.#  .....", "#####  .....",
    ]);
}

// Exchange the two circuits while the box moves within its own interior.
// The first exit delivers the battery and supplies the backstop for entry.
void TradingPlaces(mut Draft draft)
{
    Room(draft, 0, [
        "#####.#  .......", "#o###A#  .......", "#b###x#  .+.....",
        "#.###x#  .0...&.", "#a###a#  .@.....", "#0###B#  .......", "#####.#  .......",
    ]);
}

void LoadLevel(int level, mut LevelLayout layout, mut Puzzle puzzle)
{
    var chosen = Math.Clamp(level, 0, LEVEL_COUNT - 1);
    mut var draft = Draft { level = chosen };
    draft.layout = LevelLayout { width = 7, height = 7 };
    draft.puzzle = Puzzle { };
    for (var room = 0; room < MAX_ROOMS; room++) draft.layout.rooms[room] = RoomLayout { };
    for (var cell = 0; cell < 49; cell++) draft.layout.tiles[cell] = Tile.Wall;
    switch (chosen)
    {
        case 0: ARoomOutside(draft); break;
        case 1: NoHandleInside(draft); break;
        case 2: TheOtherOpening(draft); break;
        case 3: APlaceToStand(draft); break;
        case 4: AllInARow(draft); break;
        case 5: HoldItSteady(draft); break;
        case 6: Posted(draft); break;
        case 7: ChangeEnds(draft); break;
        case 8: AroundTheCorner(draft); break;
        case 9: HoldTheLine(draft); break;
        case 10: LongWire(draft); break;
        case 11: PassItOn(draft); break;
        case 12: BorrowedPower(draft); break;
        case 13: CarryTheCurrent(draft); break;
        case 14: BesideItself(draft); break;
        case 15: ShiftTheExit(draft); break;
        case 16: ReturnDelivery(draft); break;
        case 17: TradingPlaces(draft); break;
    }
    var rooms = (1 << draft.layout.roomCount) - 1;
    Debug.Assert(draft.robots == 3, $"Puzzle {chosen + 1}: both robots, @ and &, are drawn once");
    Debug.Assert(draft.drawn >> 1 == rooms, $"Puzzle {chosen + 1}: the rooms drawn are 0 to {draft.layout.roomCount - 1}, with none left out");
    Debug.Assert(draft.placed == rooms, $"Puzzle {chosen + 1}: the box of every room drawn, and no other, stands somewhere");
    layout = draft.layout;
    puzzle = draft.puzzle;
    // Where each robot is inside of: its room's box, that box's room's, and so on.
    for (var seat = 0; seat < 2; seat++)
    {
        mut var actor = puzzle.actors[seat];
        RebaseTrail(layout, puzzle, actor, actor.room, 0);
        puzzle.actors[seat] = actor;
    }
}

// The campaign's chapters, each a run of puzzles that teaches one thing.
const int CHAPTER_COUNT = 5;
int LevelChapter(int level)
{
    if (level < 5) return 0;
    if (level < 9) return 1;
    if (level < 14) return 2;
    if (level < 17) return 3;
    return 4;
}
string ChapterName(int chapter)
{
    switch (chapter)
    {
        case 0: return "Boxes";
        case 1: return "Each other";
        case 2: return "Power";
        case 3: return "Itself";
        case 4: return "Everything";
    }
    return "";
}

string LevelName(int level)
{
    switch (level)
    {
        case 0: return "A room outside";
        case 1: return "No handle inside";
        case 2: return "The other opening";
        case 3: return "A place to stand";
        case 4: return "All in a row";
        case 5: return "Hold it steady";
        case 6: return "Posted";
        case 7: return "Change ends";
        case 8: return "Around the corner";
        case 9: return "Hold the line";
        case 10: return "Long wire";
        case 11: return "Pass it on";
        case 12: return "Borrowed power";
        case 13: return "Carry the current";
        case 14: return "Beside itself";
        case 15: return "Shift the exit";
        case 16: return "Return delivery";
        case 17: return "Trading places";
    }
    return "Inside Out";
}
string LevelLesson(int level)
{
    if (level == 0) return "Seat the battery beyond both boxes. Find a goal for each robot.";
    if (level == 1) return "Move the home onto its outline and seat its battery in the containing room.";
    if (level == 2) return "Park the home and seat its battery inside the other box.";
    if (level == 3) return "Leave the battery in the left socket and the home on the right outline.";
    if (level == 4) return "Seat the battery and park the small box. A row of things moves as one.";
    if (level == 5) return "Park the small box on its outline with its battery seated inside. A box only lets you in while it cannot move.";
    if (level == 6) return "Seat the battery inside the small box without moving the box off its outline.";
    if (level == 7) return "Park the small box, then hold its other side to seat the battery.";
    if (level == 8) return "Post the battery into the small box, then turn it towards its socket.";
    if (level == 9) return "One robot holds the circuit while the other delivers the battery.";
    if (level == 10) return "A plate inside a room powers the shutter outside it.";
    if (level == 11) return "Use the far plate to bring the first plate holder across.";
    if (level == 12) return "Trade circuits to bring both robots to the far side.";
    if (level == 13) return "Carry a live battery inside the box, then help the outside robot aboard.";
    if (level == 14) return "This box contains its own room. Leave it to arrive beside it, in the same room.";
    if (level == 15) return "Moving a box inside itself moves where its own doorway comes out.";
    if (level == 16) return "Each room's outside is in the other. Move the receiving box before delivery.";
    if (level == 17) return "Exchange circuits, then move the box inside itself to bring your partner through.";
    return "";
}
string LevelHint(int level, int tier)
{
    var detail = Math.Clamp(tier, 0, 2);
    if (level == 7)
    {
        if (detail == 0) return "Which side of the battery do you need to stand on?";
        if (detail == 1) return "Push the box onto its outline first. Then swap the pusher and the backstop to enter from the east.";
        return "Amber pushes the small box east onto its outline. Teal goes round to its east side; Amber waits west of it. Teal enters from the east, pushes the battery west, then both return to the outside goals.";
    }
    if (level == 8)
    {
        if (detail == 0) return "The socket is above the battery's path, rather than at its end.";
        if (detail == 1) return "Hold the box from the east. Push the battery just far enough to stand below it inside.";
        return "Teal holds the box from the east. Amber posts the battery through the west door, follows it two cells in, goes below it and pushes north into the socket. Come back out west.";
    }
    if (level == 9)
    {
        if (detail == 0) return "What keeps the shutter open?";
        if (detail == 1) return "The plate is away from the battery's pushing position. Someone must stay on it.";
        return "Amber waits on the ring plate. Teal pushes the battery east through the shutter onto its socket. Once Teal is across, Amber can leave the plate; take one goal on each side.";
    }
    if (level == 10)
    {
        if (detail == 0) return "Does the wiring stop at a box's walls?";
        if (detail == 1) return "Keep the inside robot on its plate until the battery is through the shutter.";
        return "Amber stays on the plate in the little box. Teal delivers the battery east. Amber then leaves south and goes to the left goal; Teal takes the right goal.";
    }
    if (level == 11)
    {
        if (detail == 0) return "Both goals are beyond the shutter. Who lets the first holder leave?";
        if (detail == 1) return "There are two plates on the same channel. The second holder can take over.";
        return "Teal delivers the battery and stands on the far ring plate. Amber leaves the near plate and crosses the shutter. Once both are across, step onto the two goals.";
    }
    if (level == 12)
    {
        if (detail == 0) return "The lower shutter has a different shape from the upper one.";
        if (detail == 1) return "The far diamond plate opens a second crossing for the first holder.";
        return "Amber holds the ring plate while Teal delivers the battery through the upper shutter. Teal stands on the far diamond plate. Amber crosses the lower shutter; then both take the goals.";
    }
    if (level == 13)
    {
        if (detail == 0) return "What is powering the shutter? Where will the outside robot stand after the box moves?";
        if (detail == 1) return "Keep the battery on its plate while pushing the occupied box across. The robot inside can become its backstop.";
        return "Amber pushes the box east twice. Teal seats the inside battery, then leaves east and holds the box from outside. Amber enters from the west. Teal steps north onto a goal so Amber can leave east onto the other.";
    }
    if (level == 14)
    {
        if (detail == 0) return "Follow the north doorway to the outside of this very box.";
        if (detail == 1) return "The robot in the right-hand passage can deliver the battery by leaving north.";
        return "Teal leaves north, pushing the battery onto its socket in the left column. Teal now holds the box steady from above. Amber enters it from below and steps north onto the right goal.";
    }
    if (level == 15)
    {
        if (detail == 0) return "Which cell will the battery land on when it leaves north?";
        if (detail == 1) return "Move the box down one cell before sending the battery out. Then use a row push.";
        return "Amber pushes the box south once and steps back north. Teal pushes the battery north out of the room. Amber pushes the delivered battery and the box south together, seating the battery and parking the box. Take the two goals.";
    }
    if (level == 16)
    {
        if (detail == 0) return "The east doorway comes out beside this room's box, in the other room.";
        if (detail == 1) return "The robot in the narrow left alcove controls where the battery will arrive.";
        return "Teal pushes the box south onto its outline. Amber sends the battery east out of its room, landing on the socket in Teal's room, then backs up to the goal. Teal steps back north.";
    }
    if (level == 17)
    {
        if (detail == 0) return "The north and south doorways lead beside the same box. Each circuit is needed at a different time.";
        if (detail == 1) return "Teal leaves north while Amber holds the ring plate. Teal then holds the diamond plate and becomes Amber's backstop.";
        return "Teal leaves north and seats the battery. Amber enters the box from below, passes the diamond shutter and holds the far ring plate. Teal pushes the box south onto its outline, enters from above and passes the ring shutter. Finish on the two right-hand goals.";
    }
    if (level == 0)
    {
        if (detail == 0) return "Where does your doorway lead? What is standing in the battery's path?";
        if (detail == 1) return "One of you leaves by the east door and clears the landing outside. The other pushes the battery out after.";
        return "Amber leaves east twice and steps aside. Teal pushes the battery east out of both boxes onto the socket; then each takes a goal.";
    }
    if (level == 1)
    {
        if (detail == 0) return "After the box moves, will the robot outside still have a way back in?";
        if (detail == 1) return "Someone stays inside the home while the other goes round to its south side and pushes it north.";
        return "Amber leaves by the north door, circles round the left side and pushes the occupied home north onto its outline. Teal then pushes the battery east out to the socket.";
    }
    if (level == 2)
    {
        if (detail == 0) return "Who can reach the place to push from outside? Who must stay with the battery?";
        if (detail == 1) return "Empty the tall room of its robot first. Move the occupied home north to line its east opening up with the tall room.";
        return "Amber leaves the tall room, goes round and pushes the home north. Teal pushes the battery east out of the home and into the tall room, onto its socket.";
    }
    if (level == 3)
    {
        if (detail == 0) return "Does a seated battery leave somewhere to stand beside the home?";
        if (detail == 1) return "The battery's socket is also where you stand to push the home east. Leave the battery inside until the home is parked.";
        return "Amber leaves west, stands on the socket and pushes the home east onto its outline, then goes to the right goal. Teal pushes the battery west out of the home onto its socket and takes the left goal.";
    }
    if (level == 4)
    {
        if (detail == 0) return "What happens to a box when the thing beside it is pushed into it, and nothing stands behind?";
        if (detail == 1) return "Nothing in a row holds it back. One push from the west moves the battery and the box together.";
        return "Amber leaves the home east and keeps going: the battery slides onto its socket and the box onto its outline in one push. Then each takes a goal.";
    }
    if (level == 5)
    {
        if (detail == 0) return "Walking into a box pushes it along. What could stand behind this one so that it stays where it is?";
        if (detail == 1) return "Your partner can be the wall. One of you goes round to the far side of the outline and waits there; then the other can walk in.";
        return "Teal leaves the home east and goes round to the goal just east of the outline. Amber leaves south, pushes the small box one step east onto its outline, then walks into it again: Teal stops the push, so Amber goes inside. Amber pushes the battery east onto its socket, comes back out west and steps onto the goal.";
    }
    if (detail == 0) return "A battery pushed at a box that cannot move goes in through its door. What can stop this box?";
    if (detail == 1) return "Your partner stands behind the box. Push the battery at it once and it goes in; push again and you follow, pushing it on.";
    return "Teal goes round to the goal east of the box. Amber leaves south and pushes the battery east: it goes into the box. Amber pushes again, goes in after it and seats it, then comes back out west onto the goal.";
}
