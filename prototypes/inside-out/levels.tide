// The puzzles, drawn as text: one function for each, which draws the table
// and each room as a map.
//
//     Room(draft, 0, [
//         "#####  .....",
//         "#...#  .@...",
//         "...o#  ..+..",
//         "#...#  .....",
//         "#####  .....",
//     ]);
//
// A map is the table's (room -1) or a room's (0 to 3, which is also the id of
// the box that holds it; the game names it Box 1 to 4). It is square, one
// string a row, at the room's own size: 3 to 7 for a box, 1 to 7 for the
// table. A table nobody draws is 7 by 7 and all wall. Each row is the tiles,
// then spaces, then what stands on them, the same width:
//
//   Tiles                                  What stands on them
//   #    wall                              .    nothing
//   .    floor                             @    Amber, the first robot (seat 0)
//   o    socket, where a battery goes      &    Teal, the second robot (seat 1)
//   x    goal, where a robot ends          +    a battery
//   a A  plate A, shutter A                0-3  box 0 to 3
//   b B  plate B, shutter B
//   *    clamp: a box on it never moves
//   0-3  floor with the outline of box 0 to 3: where that box has to end
//
// So a robot on a goal is an x under an @, a battery on a plate an a under
// a +, and a box on its own outline its digit in both halves.
// - Doorways come from a room's edge, which is wall but for them: an open
//   cell (anything but #) on a side, not at a corner, is that side's
//   doorway, one a side at most. The table has none.
// - A box stands where its digit is in the other half of a map: a box in
//   its own room's map is inside itself, two boxes in each other's are a
//   cycle. Every room that is drawn has its box somewhere.
// - Batteries are numbered in the order they are drawn.
// A map that breaks one of these stops the game with what is wrong, on the
// first load of that puzzle (the campaign test loads them all).

// A puzzle as it is drawn, with what has been drawn so far.
struct Draft
{
    LevelLayout layout;
    Puzzle puzzle;
    int level;
    // A bit for each map drawn: the table's is the first, then each room's.
    int drawn;
    // A bit for each box that stands somewhere, and each robot.
    int placed;
    int robots;
}

string MapName(Draft draft, int room)
{
    return room < 0 ? $"Puzzle {draft.level + 1}, the table" : $"Puzzle {draft.level + 1}, room {room}";
}
void SetTile(mut LevelLayout layout, int room, int2 at, Tile tile)
{
    if (room < 0) layout.tiles[at.y * layout.width + at.x] = tile;
    else layout.rooms[room].tiles[at.y * layout.rooms[room].width + at.x] = tile;
}
// What a mark in a map's tiles is. A digit is floor with a box's outline on it.
Tile MapTile(char mark, out bool known)
{
    known = true;
    switch (mark)
    {
        case '#': return Tile.Wall;
        case 'o': return Tile.Target;
        case 'x': return Tile.Exit;
        case 'a': return Tile.PlateA;
        case 'A': return Tile.ShutterA;
        case 'b': return Tile.PlateB;
        case 'B': return Tile.ShutterB;
        case '*': return Tile.Clamp;
        case '.':
        case '0':
        case '1':
        case '2':
        case '3':
            return Tile.Floor;
    }
    known = false;
    return Tile.Wall;
}
void DrawTile(mut Draft draft, int room, int2 at, char mark)
{
    var tile = MapTile(mark, out var known);
    Debug.Assert(known, $"{MapName(draft, room)}: '{mark}' at {at} is no tile");
    SetTile(draft.layout, room, at, tile);
    if (mark < '0' || mark > '3') return;
    var box = mark - '0';
    Debug.Assert(draft.layout.rooms[box].dock.x < 0, $"{MapName(draft, room)}: box {box} has a second outline at {at}");
    draft.layout.rooms[box].dock = at;
    draft.layout.rooms[box].dockRoom = room;
}
void DrawThing(mut Draft draft, int room, int2 at, char mark)
{
    if (mark == '.') return;
    var where = MapName(draft, room);
    Debug.Assert(TileAt(draft.layout, room, at) != Tile.Wall, $"{where}: '{mark}' at {at} stands in a wall");
    if (mark == '@' || mark == '&')
    {
        var seat = mark == '@' ? 0 : 1;
        Debug.Assert((draft.robots & (1 << seat)) == 0, $"{where}: robot '{mark}' is drawn twice");
        draft.robots |= 1 << seat;
        draft.puzzle.actors[seat] = Traveler { room = room, position = at };
    }
    else if (mark == '+')
    {
        Debug.Assert(draft.layout.crateCount < MAX_CRATES, $"{where}: more than {MAX_CRATES} batteries");
        if (draft.layout.crateCount >= MAX_CRATES) return;
        draft.puzzle.crates[draft.layout.crateCount] = Cargo { room = room, position = at, active = true };
        draft.layout.crateCount += 1;
    }
    else if (mark >= '0' && mark <= '3')
    {
        var box = mark - '0';
        Debug.Assert((draft.placed & (1 << box)) == 0, $"{where}: box {box} stands in two places");
        draft.placed |= 1 << box;
        draft.puzzle.rooms[box] = RoomShell { room = room, position = at };
    }
    else Debug.Assert(false, $"{where}: '{mark}' at {at} is nothing that stands on a tile");
}
string SideName(int side)
{
    if (side == 0) return "north";
    if (side == 1) return "east";
    return side == 2 ? "south" : "west";
}
// A room's doorways are the open cells of its edge, one a side at most, and
// none at a corner. One in the middle of its side is the default (-1).
void Doorways(mut Draft draft, int room)
{
    var size = draft.layout.rooms[room].width;
    var last = size - 1;
    var where = MapName(draft, room);
    for (var corner = 0; corner < 4; corner++)
    {
        var at = int2(corner % 2 == 0 ? 0 : last, corner < 2 ? 0 : last);
        Debug.Assert(TileAt(draft.layout, room, at) == Tile.Wall, $"{where}: the corner at {at} is open; a doorway is on a side, not at a corner");
    }
    mut var doors = 0;
    for (var side = 0; side < 4; side++)
    {
        mut var door = -1;
        mut var count = 0;
        for (var along = 1; along < last; along++)
        {
            var at = side == 0 ? int2(along, 0) : side == 1 ? int2(last, along) : side == 2 ? int2(along, last) : int2(0, along);
            if (TileAt(draft.layout, room, at) == Tile.Wall) continue;
            count += 1;
            if (door < 0) door = along;
        }
        Debug.Assert(count <= 1, $"{where}: {count} doorways on the {SideName(side)} side; a side has one at most");
        if (door >= 0) doors |= 1 << side;
        var offset = door == size / 2 ? -1 : door;
        if (side == 0) draft.layout.rooms[room].north = offset;
        else if (side == 1) draft.layout.rooms[room].east = offset;
        else if (side == 2) draft.layout.rooms[room].south = offset;
        else draft.layout.rooms[room].west = offset;
    }
    draft.layout.rooms[room].doors = doors;
}
// One map: the table's (room -1) or a room's. See the top of this file.
void Room(mut Draft draft, int room, List<string> rows)
{
    var where = MapName(draft, room);
    Debug.Assert(room >= -1 && room < MAX_ROOMS, $"{where}: there are rooms 0 to {MAX_ROOMS - 1} and the table, -1");
    if (room < -1 || room >= MAX_ROOMS) return;
    Debug.Assert((draft.drawn & (1 << (room + 1))) == 0, $"{where} is drawn twice");
    draft.drawn |= 1 << (room + 1);
    var least = room < 0 ? 1 : 3;
    Debug.Assert(rows.count >= least && rows.count <= 7, $"{where} has {rows.count} rows, and is {least} to 7 square");
    var size = Math.Clamp(rows.count, least, 7);
    if (room < 0)
    {
        draft.layout.width = size;
        draft.layout.height = size;
    }
    else
    {
        draft.layout.roomCount = Math.Max(draft.layout.roomCount, room + 1);
        draft.layout.rooms[room].width = size;
        draft.layout.rooms[room].height = size;
        for (var cell = 0; cell < 49; cell++) draft.layout.rooms[room].tiles[cell] = Tile.Wall;
    }
    for (var y = 0; y < size; y++)
    {
        var row = rows[y];
        var gap = row.IndexOf(' ');
        var tiles = gap < 0 ? row : row.Substring(0, gap);
        var things = gap < 0 ? "" : row.Substring(gap).Trim();
        Debug.Assert(tiles.length == size && things.length == size, $"{where}, row {y}: {size} tiles, spaces, then {size} things");
        for (var x = 0; x < size; x++) DrawTile(draft, room, int2(x, y), tiles[x]);
        for (var x = 0; x < size; x++) DrawThing(draft, room, int2(x, y), things[x]);
    }
    if (room >= 0) Doorways(draft, room);
}

// 1. Two robots in a corridor of a box, in a room on the table.
void ARoomOutside(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "####x##  .......",
        "###1.o#  ...1...",
        "####x##  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "###  ...",
        "...  &+@",
        "###  ...",
    ]);
    Room(draft, 1, [
        "####  ....",
        "#0..  .0..",
        "#..#  ....",
        "####  ....",
    ]);
}
// 2. The robot outside cannot get back in once the home is parked: carry the
// one inside to the way out, rather than move an empty box.
void NoHandleInside(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#.###  .@...",
        "#....  .&+..",
        "##..#  .....",
        "#...#  .....",
        "#####  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#######  .......",
        "#..0xo#  .......",
        "#...###  ...0...",
        "#.x.###  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
}
// 3. The home's battery goes into the tall room beside it, once the home is
// pushed to line its east opening up with the tall room's west one.
void TheOtherOpening(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###2###  ...2...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#.###  .....",
        "#....  .&+..",
        "##..#  .....",
        "#...#  .....",
        "#####  .....",
    ]);
    Room(draft, 1, [
        "#####  .....",
        "..o.#  .....",
        "#...#  .....",
        "#...#  .@...",
        "#####  .....",
    ]);
    Room(draft, 2, [
        "#######  .......",
        "#######  .......",
        "#..0x1#  .....1.",
        "#...###  ...0...",
        "#.x.###  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
}
// 4. The socket is the cell to push the home from: leave the battery inside
// until the home is on its outline, then deliver it through the west door.
void APlaceToStand(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#####  .....",
        "#...#  .@.&.",
        "....#  ..+..",
        "#...#  .....",
        "##.##  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#.....#  .......",
        "#.#...#  .......",
        "#o.0..#  ..0....",
        "#x...x#  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
}
// 5. A row moves as one, however long: a battery, a box and nothing to stop
// them.
void AllInARow(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#####  .....",
        "#...#  .....",
        "#....  ..&@.",
        "#...#  .....",
        "#####  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#.x...#  .......",
        "#.....#  .......",
        "#0..o2#  .0.+2..",
        "#.....#  .......",
        "#.x...#  .......",
        "#######  .......",
    ]);
    Room(draft, 2, [
        "###  ...",
        "..#  ...",
        "###  ...",
    ]);
}
// 6. A box only lets a robot in while it cannot move, and this one has open
// floor behind its outline: the partner is the wall. The room is a figure of
// eight round two blocks, so either robot can reach either side of the small
// box, and nothing else can be put behind it. The home is in a corner and
// cannot be moved.
void HoldItSteady(mut Draft draft)
{
    Room(draft, -1, [
        "#######  .......",
        "#######  .......",
        "#######  .......",
        "###1###  ...1...",
        "#######  .......",
        "#######  .......",
        "#######  .......",
    ]);
    Room(draft, 0, [
        "#####  .....",
        "#...#  .....",
        "#....  ...&.",
        "#...#  ..@..",
        "##.##  .....",
    ]);
    Room(draft, 1, [
        "#######  .......",
        "#0....#  .0.....",
        "#.###.#  .......",
        "#x.2x.#  ..2....",
        "#.###.#  .......",
        "#.....#  .......",
        "#######  .......",
    ]);
    Room(draft, 2, [
        "#####  .....",
        "#...#  .....",
        "...o#  ..+..",
        "#...#  .....",
        "#####  .....",
    ]);
}
// 7. Cargo is packed inside a second room while the receiving room is held.
// Its outline is inside the receiver, not beside it in the containing room.
void Posted(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#1#  .1.", "###  ..."]);
    Room(draft, 0, [
        "#####  .....", "#...#  .....", ".....  .@+..",
        "#...#  .....", "#####  .....",
    ]);
    Room(draft, 1, [
        "#######  .......", "#.....#  .......", "#.....#  .......",
        "#...2x#  ..0.2..", "#.....#  .....&.", "#.....#  .......", "#######  .......",
    ]);
    Room(draft, 2, [
        "#####  .....", "#...#  .....", "..0o#  .....",
        "#..x#  .....", "#####  .....",
    ]);
}

// Two disconnected compartments unload and receive their batteries again.
// The outside becomes a buffer; the robots exchange backstop sides.
void ChangeEnds(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#x....#  .......", "#.....#  .......",
        "#..1..#  ...1...", "#.....#  .......", "#....x#  .......", "#######  .......",
    ]);
    Room(draft, 1, [
        "#.#####  .......", "#..####  .......", "..o####  .+@....",
        "#######  .......", "####o..  ....&+.", "####..#  .......", "#######  .......",
    ]);
}
// The obstructed warehouse needs working space, not a straight row push.
// Its open outside floor provides no temporary wall to replace the partner.
void AroundTheCorner(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#.....#  .......", "#.....#  .......",
        "#x.1x.#  ..@1.&.", "#.....#  .......", "#.....#  .......", "#######  .......",
    ]);
    Room(draft, 1, [
        "#######  .......", "#....##  .......", "#o#...#  .......",
        "......#  ...++..", "#..#..#  .......", "#o....#  .......", "#######  .......",
    ]);
}
// Two shipments share a circuit; a battery must temporarily power a plate.
void HoldTheLine(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#a.#.o#  .......", "#..A..#  .&+....",
        "#..#x.#  .@.....", "#..A.a#  ..+....", "#..#xo#  .......", "#######  .......",
    ]);
}
// The occupied room must leave its outline to deliver its battery. Its
// passenger returns it from the far side after the battery leaves its plate.
void PassItOn(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "####o.#  .......", "####..#  .......",
        "#x.1Ax#  .&.1...", "####..#  .......", "####..#  .......", "#######  .......",
    ]);
    Room(draft, 1, [
        "##.##  .....", "#...#  .....", "#.a.#  ..+..", "#...#  ..@..", "#####  .....",
    ]);
}
// Borrow a seated battery to release the partner through circuit B. They
// leave their own goal to hold circuit A, then restore the borrowed battery.
void BorrowedPower(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#..A.o#  ....+..", "#.ob.x#  .@+....",
        "###xa##  .......", "###B###  .......", "###.###  ...&...", "#######  .......",
    ]);
}
// A battery inside the box powers the shutter the occupied box passes.
// The inside robot then becomes the backstop that lets its partner aboard.
void CarryTheCurrent(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#..#..#  .......", "#..#.x#  .......",
        "#..A1x#  .@1....", "#..#..#  .......", "#..#..#  .......", "#######  .......",
    ]);
    Room(draft, 1, [
        "#####  .....", "#.o.#  .....", "..a..  ..+..", "#...#  ..&..", "#####  .....",
    ]);
}
// A battery must leave north and return east. Moving the receiving room
// exchanges holding and pushing positions across both circuits.
void LongWire(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#...#.#  .......", "#...Ax#  .......",
        "#.1.A.#  ..1....", "#..b#a#  ...@...", "#...#x#  .......", "#######  .......",
    ]);
    Room(draft, 1, [
        "##.##  .....", "#..##  .....", "#.B.#  ..+..", "##ao.  ...&.", "#####  .....",
    ]);
}
// Clear the isolated battery before changing sides through the self-box.
// Its moved south landing serves the second delivery; dock only afterwards.
void BesideItself(mut Draft draft)
{
    Room(draft, 0, [
        "#####.#  .......", "#.0o#.#  .@+....", "##..#.#  .....+.",
        "#o..#.#  ..0..&.", "#...#x#  .......", "#...#x#  .......", "#####.#  .......",
    ]);
}
// A two-battery queue shares a recursive exit. Clear the first arrival by
// moving its containing box before the second battery can come through.
void ShiftTheExit(mut Draft draft)
{
    Room(draft, 0, [
        "#####.#  .......", "#x#...#  .@.....", "#o#...#  .0..+&.",
        "#o#...#  .....+.", "#0#...#  .......", "#.#..x#  .......", "#####.#  .......",
    ]);
}
// Exchange two deliveries across a real cycle. The receiving alcove and
// doorway positions require both robots before either can finish alone.
void ReturnDelivery(mut Draft draft)
{
    Room(draft, 0, [
        "##.##  .....", "#xo..  ..@+.", "#.1.#  ..1..", "#...#  .....", "#####  .....",
    ]);
    Room(draft, 1, [
        "#####.#  .......", "#x##..#  .&.....", "#.##..#  .0...+.",
        "#0o...#  .......", "####..#  .......", "####.x#  .......", "#######  .......",
    ]);
}

// A clamped room never moves, so the cargo room pushed at it goes in by its
// doorway, and on to its outline. The partner holds the cargo room still for
// its rider first, and later holds the plate for the rider's way out.
void HeldFast(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#x...x#  .......", "#.....#  ..@....",
        "#.....#  ..1....", "#..*..#  ...2...", "#a....#  ....&..", "#######  .......",
    ]);
    Room(draft, 1, ["###  ...", "...  .+.", "###  ..."]);
    Room(draft, 2, ["##.##  .....", "#.1o#  .....", "#...#  .....", "#...#  .....", "##A##  ....."]);
}
// The room's own box is clamped inside it. Pushed down into the box, a
// battery comes out at the top doorway, but only a robot already waiting in
// that corridor can push it; pushed out of the side doorway, the other comes
// back in beside the box, onto its socket.
void StillPoint(mut Draft draft)
{
    Room(draft, 0, [
        "###o###  .......", "###.###  .......", "#x...##  .@.....",
        "#..*o..  ...0.+.", "#....##  ..+....", "#....x#  ....&..", "#######  .......",
    ]);
}

// Two rooms contain each other. Two circuits govern the deliveries and
// the return journey; completed cargo can become a temporary power source.
void TradingPlaces(mut Draft draft)
{
    Room(draft, 0, [
        "##B##  .....", "#xo.A  ..@+.", "#.1.#  ..1..", "#...#  .....", "#####  .....",
    ]);
    Room(draft, 1, [
        "#####B#  .......", "#x.#..#  .&.....", "#a.#..#  .0...+.",
        "#0bo..#  .......", "#.....#  .......", "#.....#  .......", "#######  .......",
    ]);
}

// Challenges: small puzzles apart from the campaign, solved within a budget
// of moves (`ChallengeBudget`), which is each one's shortest solution.

// The box has a socket in each doorway. Teal starts outside, on the table,
// and one line of pushes from the doorway can load both batteries.
void Freight(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0.  .0&", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#x...x#  .......", "#....##  .+.....",
        "#......  .@.1.+.", "#....##  .......", "#.....#  .......", "#######  .......",
    ]);
    Room(draft, 1, ["###  ...", "o.o  ...", "###  ..."]);
}
// The parked box takes a battery at each doorway, and only while the partner
// stands on its far side: the two robots change sides between the two.
void Backstage(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#x...x#  .......", "#.....#  ..+.@..",
        "#..1..#  ...1...", "#.....#  .&..+..", "#.....#  .......", "#######  .......",
    ]);
    Room(draft, 1, ["###  ...", "o.o  ...", "###  ..."]);
}
// Each half's plate opens the other half's shutter, so each robot holds the
// way open for the other's battery, and nobody stays to hold the last one.
void Overload(mut Draft draft)
{
    Room(draft, -1, ["###  ...", "#0#  .0.", "###  ..."]);
    Room(draft, 0, [
        "#######  .......", "#o.A.a#  .......", "#..#..#  ....+..",
        "#x.#.x#  .@...&.", "#..#..#  ....+..", "#b.B.o#  .......", "#######  .......",
    ]);
}
int ChallengeBudget(int level)
{
    if (level == LEVEL_COUNT) return 16;
    if (level == LEVEL_COUNT + 1) return 21;
    if (level == LEVEL_COUNT + 2) return 22;
    return 0;
}

void LoadLevel(int level, mut LevelLayout layout, mut Puzzle puzzle)
{
    var chosen = Math.Clamp(level, 0, PUZZLE_COUNT - 1);
    mut var draft = Draft { level = chosen };
    draft.layout = LevelLayout { width = 7, height = 7 };
    draft.puzzle = Puzzle { };
    for (var room = 0; room < MAX_ROOMS; room++) draft.layout.rooms[room] = RoomLayout { };
    for (var cell = 0; cell < 49; cell++) draft.layout.tiles[cell] = Tile.Wall;
    switch (chosen)
    {
        case 0: ARoomOutside(draft); break;
        case 1: NoHandleInside(draft); break;
        case 2: TheOtherOpening(draft); break;
        case 3: APlaceToStand(draft); break;
        case 4: AllInARow(draft); break;
        case 5: HoldItSteady(draft); break;
        case 6: Posted(draft); break;
        case 7: ChangeEnds(draft); break;
        case 8: AroundTheCorner(draft); break;
        case 9: HoldTheLine(draft); break;
        case 10: PassItOn(draft); break;
        case 11: BorrowedPower(draft); break;
        case 12: CarryTheCurrent(draft); break;
        case 13: LongWire(draft); break;
        case 14: BesideItself(draft); break;
        case 15: ShiftTheExit(draft); break;
        case 16: ReturnDelivery(draft); break;
        case 17: HeldFast(draft); break;
        case 18: StillPoint(draft); break;
        case 19: TradingPlaces(draft); break;
        case 20: Freight(draft); break;
        case 21: Backstage(draft); break;
        case 22: Overload(draft); break;
    }
    draft.layout.moveLimit = ChallengeBudget(chosen);
    var rooms = (1 << draft.layout.roomCount) - 1;
    Debug.Assert(draft.robots == 3, $"Puzzle {chosen + 1}: both robots, @ and &, are drawn once");
    Debug.Assert(draft.drawn >> 1 == rooms, $"Puzzle {chosen + 1}: the rooms drawn are 0 to {draft.layout.roomCount - 1}, with none left out");
    Debug.Assert(draft.placed == rooms, $"Puzzle {chosen + 1}: the box of every room drawn, and no other, stands somewhere");
    layout = draft.layout;
    puzzle = draft.puzzle;
    // Where each robot is inside of: its room's box, that box's room's, and so on.
    for (var seat = 0; seat < 2; seat++)
    {
        mut var actor = puzzle.actors[seat];
        RebaseTrail(layout, puzzle, actor, actor.room, 0);
        puzzle.actors[seat] = actor;
    }
}

// The campaign's chapters, each a run of puzzles that teaches one thing.
const int CHAPTER_COUNT = 6;
int LevelChapter(int level)
{
    // A challenge stands in the hall of the chapter it follows.
    if (level >= LEVEL_COUNT) return Math.Min(level - LEVEL_COUNT, CHAPTER_COUNT - 1);
    if (level < 5) return 0;
    if (level < 9) return 1;
    if (level < 14) return 2;
    if (level < 17) return 3;
    if (level < 19) return 4;
    return 5;
}
string ChapterName(int chapter)
{
    switch (chapter)
    {
        case 0: return "Boxes";
        case 1: return "Each other";
        case 2: return "Power";
        case 3: return "Itself";
        case 4: return "Held";
        case 5: return "Everything";
    }
    return "";
}

string LevelName(int level)
{
    switch (level)
    {
        case 0: return "A room outside";
        case 1: return "No handle inside";
        case 2: return "The other opening";
        case 3: return "A place to stand";
        case 4: return "All in a row";
        case 5: return "Hold it steady";
        case 6: return "Inside the shipment";
        case 7: return "Return to sender";
        case 8: return "Working room";
        case 9: return "Two shipments";
        case 10: return "Off its mark";
        case 11: return "Borrowed power";
        case 12: return "Carry the current";
        case 13: return "Long way home";
        case 14: return "Beside itself";
        case 15: return "Shift the exit";
        case 16: return "Return delivery";
        case 17: return "Held fast";
        case 18: return "Still point";
        case 19: return "Trading places";
        case 20: return "Freight";
        case 21: return "Backstage";
        case 22: return "Overload";
    }
    return "Inside Out";
}
string LevelLesson(int level)
{
    if (level == 0) return "Seat the battery beyond both boxes. Find a goal for each robot.";
    if (level == 1) return "Move the home onto its outline and seat its battery in the containing room.";
    if (level == 2) return "Park the home and seat its battery inside the other box.";
    if (level == 3) return "Leave the battery in the left socket and the home on the right outline.";
    if (level == 4) return "Seat the battery and park the small box. A row of things moves as one.";
    if (level == 5) return "Park the small box on its outline with its battery seated inside. A box only lets you in while it cannot move.";
    if (level == 6) return "Dock the cargo room inside the receiving room and seat its battery beyond it.";
    if (level == 7) return "Return both batteries to their compartments, with the containing box on its outline.";
    if (level == 8) return "Seat two batteries in the obstructed warehouse, retaining its outside docking position.";
    if (level == 9) return "Deliver two batteries through the shared circuit and finish both robots beyond it.";
    if (level == 10) return "Deliver the occupied room's battery and return that room to its original outline.";
    if (level == 11) return "Complete the second delivery while recovering a battery that starts seated.";
    if (level == 12) return "Carry a live battery inside the box, then help the outside robot aboard.";
    if (level == 13) return "Return the battery to its room through another doorway, and restore the moved room.";
    if (level == 14) return "Seat both batteries, dock the self-containing box and reunite both robots inside it.";
    if (level == 15) return "Deliver a two-battery queue through a shared recursive exit and dock its containing box.";
    if (level == 16) return "Exchange two deliveries across a real two-room cycle and retain both box outlines.";
    if (level == 17) return "Push the occupied cargo room into the clamped room and onto its outline, seat its battery and leave by the shutter.";
    if (level == 18) return "Seat one battery through the clamped self-box at the top doorway and the other beside the box, from its side doorway.";
    if (level == 19) return "Complete both deliveries and restore both boxes across a two-circuit recursive cycle.";
    if (level == 20) return "In 16 moves: seat both batteries in the box's doorways and reach both goals.";
    if (level == 21) return "In 21 moves: seat both batteries in the parked box, each while the partner holds it.";
    if (level == 22) return "In 22 moves: carry both batteries across, each robot holding the other's shutter open.";
    return "";
}
