// Twelve hand-built workshop puzzles. Checked-in witnesses use the actual
// two-player directional Move commands in test/campaign.c.
// Both travelers share canonical room interiors and can enter nested shells
// or fixed recursive doorways. Physical shells have acyclic parentage.

void WorkshopFloor(mut LevelLayout layout)
{
    for (var y = 0; y < OUTER_SIZE; y++)
        for (var x = 0; x < OUTER_SIZE; x++)
            layout.tiles[y * OUTER_SIZE + x] = x == 0 || y == 0 || x == OUTER_SIZE - 1 || y == OUTER_SIZE - 1 ? Tile.Wall : Tile.Floor;
}

void WorkshopRoom(mut LevelLayout layout, mut Puzzle puzzle, int room, int2 at, int2 dock, int doors = 15, int parent = -1, int dockParent = -1)
{
    layout.roomCount = Math.Max(layout.roomCount, room + 1);
    layout.rooms[room].doors = doors;
    layout.rooms[room].dock = dock;
    layout.rooms[room].dockRoom = dockParent;
    puzzle.rooms[room] = RoomShell { room = parent, position = at };
    for (var y = 0; y < INNER_SIZE; y++)
        for (var x = 0; x < INNER_SIZE; x++)
            layout.rooms[room].tiles[y * INNER_SIZE + x] = x >= 1 && x <= 3 && y >= 1 && y <= 3 ? Tile.Floor : Tile.Wall;
    for (var direction = 0; direction < 4; direction++)
    {
        if ((doors & (1 << direction)) == 0) continue;
        var door = DoorCell(direction);
        layout.rooms[room].tiles[CellIndex(door, INNER_SIZE)] = Tile.Floor;
    }
    layout.rooms[room].tiles[CellIndex(int2(2, 2), INNER_SIZE)] = Tile.Hatch;
}

void WorkshopPortal(mut LevelLayout layout, int parent, int2 at, int destination, int doors = 15)
{
    layout.portals[layout.portalCount] = PortalLayout { room = parent, position = at, destination = destination, doors = doors };
    layout.portalCount += 1;
}

void WorkshopWalker(mut Puzzle puzzle, int seat, int2 at)
{
    puzzle.actors[seat] = Traveler { room = -1, position = at };
}

void WorkshopRow(mut LevelLayout layout, int room, int y)
{
    for (var x = 1; x <= 3; x++) WorkshopTile(layout, room, int2(x, y), Tile.Floor);
}

void WorkshopTile(mut LevelLayout layout, int room, int2 at, Tile tile)
{
    if (room < 0) layout.tiles[CellIndex(at, OUTER_SIZE)] = tile;
    else layout.rooms[room].tiles[CellIndex(at, INNER_SIZE)] = tile;
}

void WorkshopCargo(mut LevelLayout layout, mut Puzzle puzzle, int room, int2 at)
{
    puzzle.crates[layout.crateCount] = Cargo { room = room, position = at, active = true };
    layout.crateCount += 1;
}

// Final layouts replayed through production typed commands by campaign.c.
// The checked-in witnesses demonstrate the required dependencies.
void WorkshopLateLevel(int level, mut LevelLayout layout, mut Puzzle puzzle)
{
    layout = LevelLayout { };
    puzzle = Puzzle { };
    for (var room = 0; room < MAX_ROOMS; room++) layout.rooms[room].dock = int2(-1);
    WorkshopFloor(layout);

    if (level == 9)
    {
        // Loan counter: the northern target cannot be filled from any ordinary
        // standing tile. The small room must be nested for its north export.
        // Its original dock then requires un-filling the occupied push access.
        WorkshopWalker(puzzle, 0, int2(1, 3));
        WorkshopWalker(puzzle, 1, int2(2, 4));
        WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 3));
        WorkshopTile(layout, -1, int2(3, 4), Tile.Wall);
        WorkshopRow(layout, 0, 0);
        WorkshopRow(layout, 0, 4);
        WorkshopTile(layout, 0, int2(2, 1), Tile.Wall);
        WorkshopRoom(layout, puzzle, 1, int2(2, 3), int2(2, 3), 13);
        layout.rooms[1].latched = true;
        WorkshopTile(layout, 1, int2(1, 1), Tile.Switch);
        WorkshopCargo(layout, puzzle, 1, int2(2, 2));
        WorkshopCargo(layout, puzzle, 0, int2(1, 2));
        WorkshopTile(layout, 0, int2(0, 1), Tile.Target);
        WorkshopTile(layout, 0, int2(1, 2), Tile.Target);
        WorkshopTile(layout, 0, int2(1, 3), Tile.Exit);
        WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
        return;
    }

    if (level == 10)
    {
        // Shared address: A -> B -> A is a genuine shared-state cycle. The
        // north standing tile above A's parcel has no physical approach.
        // Delivering the other parcel closes the old north return, requiring
        // a planned return through B's south edge and A's bottom walkway.
        WorkshopWalker(puzzle, 0, int2(3, 4));
        WorkshopWalker(puzzle, 1, int2(2, 3));
        WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 3));
        WorkshopRow(layout, 0, 4);
        WorkshopRoom(layout, puzzle, 1, int2(5, 2), int2(5, 2));
        WorkshopTile(layout, -1, int2(3, 2), Tile.Wall);
        WorkshopTile(layout, -1, int2(4, 3), Tile.Wall);
        WorkshopTile(layout, -1, int2(5, 1), Tile.Wall);
        WorkshopTile(layout, -1, int2(5, 3), Tile.Wall);
        WorkshopTile(layout, -1, int2(4, 2), Tile.Wall);
        WorkshopPortal(layout, 0, int2(3, 3), 1);
        WorkshopPortal(layout, 1, int2(2, 2), 0);
        WorkshopCargo(layout, puzzle, 0, int2(2, 1));
        WorkshopCargo(layout, puzzle, 0, int2(1, 2));
        WorkshopTile(layout, 0, int2(2, 3), Tile.Target);
        WorkshopTile(layout, 0, int2(3, 2), Tile.Target);
        WorkshopTile(layout, -1, int2(2, 4), Tile.Exit);
        WorkshopTile(layout, -1, int2(4, 4), Tile.Exit);
        return;
    }

    // Borrowed space: A's filled lower target is the only standing tile for
    // docking the newly nested latched room. Post that parcel into the child,
    // move the child, then the partner posts it back. A -> C -> A supplies
    // essential north access; a third parcel first blocks C's return door.
    WorkshopWalker(puzzle, 0, int2(1, 3));
    WorkshopWalker(puzzle, 1, int2(2, 4));
    WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 3));
    WorkshopRow(layout, 0, 4);
    WorkshopTile(layout, 0, int2(0, 1), Tile.Floor);
    WorkshopTile(layout, 0, int2(0, 4), Tile.Floor);
    WorkshopRoom(layout, puzzle, 1, int2(2, 3), int2(0, 1), 15, -1, 0);
    layout.rooms[1].latched = true;
    WorkshopTile(layout, 1, int2(1, 1), Tile.Switch);
    WorkshopRoom(layout, puzzle, 2, int2(5, 2), int2(5, 2));
    WorkshopRow(layout, 2, 0);
    WorkshopTile(layout, -1, int2(3, 2), Tile.Wall);
        WorkshopTile(layout, -1, int2(4, 3), Tile.Wall);
    WorkshopTile(layout, -1, int2(5, 1), Tile.Wall);
    WorkshopTile(layout, -1, int2(5, 3), Tile.Wall);
    WorkshopTile(layout, -1, int2(4, 2), Tile.Wall);
    WorkshopPortal(layout, 0, int2(3, 3), 2);
    WorkshopPortal(layout, 2, int2(2, 2), 0);
    WorkshopCargo(layout, puzzle, 0, int2(0, 3));
    WorkshopCargo(layout, puzzle, 0, int2(2, 1));
    WorkshopCargo(layout, puzzle, 2, int2(2, 1));
    WorkshopTile(layout, 0, int2(0, 3), Tile.Target);
    WorkshopTile(layout, 0, int2(2, 3), Tile.Target);
    WorkshopTile(layout, 2, int2(3, 1), Tile.Target);
    WorkshopTile(layout, 0, int2(0, 2), Tile.Exit);
    WorkshopTile(layout, 0, int2(1, 3), Tile.Exit);
}

void LoadLevel(int level, mut LevelLayout layout, mut Puzzle puzzle)
{
    layout = LevelLayout { };
    puzzle = Puzzle { };
    for (var room = 0; room < MAX_ROOMS; room++) layout.rooms[room].dock = int2(-1);
    WorkshopFloor(layout);
    WorkshopWalker(puzzle, 0, int2(1, 3));
    WorkshopWalker(puzzle, 1, int2(2, 4));
    switch (Math.Clamp(level, 0, LEVEL_COUNT - 1))
    {
        case 0:
            WorkshopWalker(puzzle, 0, int2(1, 2));
            WorkshopWalker(puzzle, 1, int2(3, 3));
            WorkshopRoom(layout, puzzle, 0, int2(2, 2), int2(3, 2));
            WorkshopTile(layout, -1, int2(3, 1), Tile.Wall);
            WorkshopTile(layout, -1, int2(4, 2), Tile.Wall);
            WorkshopCargo(layout, puzzle, 0, int2(2, 2));
            WorkshopTile(layout, 0, int2(2, 1), Tile.Target);
            WorkshopTile(layout, 0, int2(1, 2), Tile.Exit);
            WorkshopTile(layout, -1, int2(1, 4), Tile.Exit);
            break;
        case 1:
            WorkshopWalker(puzzle, 0, int2(3, 4));
            WorkshopRoom(layout, puzzle, 0, int2(2, 3), int2(4, 3));
            layout.rooms[0].latched = true;
            WorkshopTile(layout, 0, int2(1, 2), Tile.Switch);
            WorkshopCargo(layout, puzzle, -1, int2(3, 3));
            WorkshopTile(layout, -1, int2(3, 1), Tile.Target);
            WorkshopCargo(layout, puzzle, 0, int2(3, 2));
            WorkshopTile(layout, 0, int2(3, 1), Tile.Target);
            WorkshopTile(layout, 0, int2(2, 3), Tile.Exit);
            WorkshopTile(layout, -1, int2(1, 5), Tile.Exit);
            break;
        case 2:
            WorkshopWalker(puzzle, 0, int2(3, 4));
            WorkshopWalker(puzzle, 1, int2(4, 3));
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 3));
            WorkshopRow(layout, 0, 4);
            WorkshopTile(layout, -1, int2(3, 2), Tile.Wall);
            WorkshopTile(layout, -1, int2(2, 3), Tile.Wall);
            WorkshopTile(layout, 0, int2(0, 3), Tile.Floor);
            WorkshopRoom(layout, puzzle, 1, int2(2, 2), int2(2, 2), 15, 0, 0);
            layout.rooms[1].latched = true;
            WorkshopTile(layout, 1, int2(2, 2), Tile.Switch);
            WorkshopCargo(layout, puzzle, 0, int2(2, 3));
            WorkshopTile(layout, 0, int2(2, 1), Tile.Target);
            WorkshopTile(layout, 0, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, -1, int2(3, 5), Tile.Exit);
            break;
        case 3:
            // A parcel must be handed over before the latched room boxes
            // trade places. Moving either room requires the partner inside it.
            WorkshopWalker(puzzle, 1, int2(2, 4));
            for (var cell = 0; cell < OUTER_SIZE * OUTER_SIZE; cell++) layout.tiles[cell] = Tile.Wall;
            for (var y = 2; y <= 4; y++)
                for (var x = 1; x <= 5; x++) WorkshopTile(layout, -1, int2(x, y), Tile.Floor);
            for (var x = 2; x <= 4; x++) WorkshopTile(layout, -1, int2(x, 1), Tile.Floor);
            WorkshopRoom(layout, puzzle, 0, int2(2, 3), int2(4, 3));
            WorkshopRoom(layout, puzzle, 1, int2(4, 3), int2(2, 3));
            layout.rooms[0].latched = true;
            layout.rooms[1].latched = true;
            WorkshopTile(layout, 0, int2(1, 1), Tile.Switch);
            WorkshopTile(layout, 1, int2(1, 1), Tile.Switch);
            WorkshopCargo(layout, puzzle, 0, int2(2, 2));
            WorkshopTile(layout, 1, int2(3, 2), Tile.Target);
            WorkshopTile(layout, 1, int2(3, 3), Tile.Exit);
            WorkshopTile(layout, -1, int2(1, 4), Tile.Exit);
            break;
        case 4:
            // The ordinary shell is surrounded on three sides. Only entering
            // its self-door can reach the standing tile above the parcel.
            WorkshopWalker(puzzle, 0, int2(2, 3));
            WorkshopWalker(puzzle, 1, int2(4, 4));
            WorkshopRoom(layout, puzzle, 0, int2(2, 2), int2(2, 2));
            WorkshopRow(layout, 0, 4);
            WorkshopTile(layout, -1, int2(1, 2), Tile.Wall);
            WorkshopTile(layout, -1, int2(2, 1), Tile.Wall);
            WorkshopTile(layout, -1, int2(3, 2), Tile.Wall);
            WorkshopPortal(layout, 0, int2(3, 3), 0);
            WorkshopCargo(layout, puzzle, 0, int2(2, 1));
            WorkshopTile(layout, 0, int2(2, 3), Tile.Target);
            WorkshopRoom(layout, puzzle, 1, int2(4, 3), int2(3, 3));
            layout.rooms[1].latched = true;
            WorkshopTile(layout, 1, int2(2, 2), Tile.Switch);
            WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, -1, int2(4, 2), Tile.Exit);
            break;
        case 5:
            // The exported parcel fills a target that is also the standing
            // tile for docking its room. It must be put aside and restored.
            WorkshopWalker(puzzle, 0, int2(3, 4));
            WorkshopWalker(puzzle, 1, int2(4, 3));
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(3, 3));
            WorkshopTile(layout, -1, int2(3, 2), Tile.Wall);
            WorkshopTile(layout, -1, int2(2, 3), Tile.Wall);
            WorkshopRow(layout, 0, 0);
            WorkshopRow(layout, 0, 4);
            WorkshopRoom(layout, puzzle, 1, int2(2, 2), int2(3, 2), 15, 0, 0);
            layout.rooms[1].latched = true;
            WorkshopTile(layout, 1, int2(1, 1), Tile.Switch);
            WorkshopCargo(layout, puzzle, 1, int2(2, 2));
            WorkshopTile(layout, 0, int2(1, 2), Tile.Target);
            WorkshopTile(layout, 0, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(3, 3), Tile.Exit);
            break;
        case 6:
            // Importing a latched shell changes where its parcel is posted.
            // The holder then changes switches before the containing room moves.
            WorkshopWalker(puzzle, 1, int2(2, 4));
            WorkshopRoom(layout, puzzle, 0, int2(3, 3), int2(4, 3));
            WorkshopRoom(layout, puzzle, 1, int2(2, 3), int2(0, 2), 15, -1, 0);
            layout.rooms[0].latched = true;
            layout.rooms[1].latched = true;
            WorkshopTile(layout, 0, int2(2, 3), Tile.Switch);
            WorkshopTile(layout, 1, int2(1, 1), Tile.Switch);
            WorkshopCargo(layout, puzzle, 1, int2(2, 2));
            WorkshopTile(layout, 0, int2(2, 1), Tile.Target);
            WorkshopTile(layout, 0, int2(3, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(3, 3), Tile.Exit);
            break;
        case 7:
            // Two fixed doors form a loop through shared room state. The
            // physical north approaches are absent even after docking.
            WorkshopWalker(puzzle, 0, int2(1, 2));
            WorkshopWalker(puzzle, 1, int2(2, 3));
            WorkshopRoom(layout, puzzle, 0, int2(2, 2), int2(3, 2));
            WorkshopRoom(layout, puzzle, 1, int2(4, 2), int2(4, 2));
            WorkshopRow(layout, 1, 4);
            layout.rooms[0].latched = true;
            WorkshopTile(layout, 0, int2(3, 2), Tile.Switch);
            for (var x = 1; x <= 5; x++) WorkshopTile(layout, -1, int2(x, 1), Tile.Wall);
            WorkshopPortal(layout, 0, int2(3, 3), 1);
            WorkshopPortal(layout, 1, int2(3, 3), 0);
            WorkshopCargo(layout, puzzle, 0, int2(2, 1));
            WorkshopCargo(layout, puzzle, 1, int2(2, 1));
            WorkshopTile(layout, 0, int2(2, 3), Tile.Target);
            WorkshopTile(layout, 1, int2(2, 3), Tile.Target);
            WorkshopTile(layout, 0, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(1, 3), Tile.Exit);
            break;
        case 8:
            // The outside delivery must precede nesting: afterward the same
            // doorway exports into the receiving room. Its target is also a
            // necessary pushing stance, so it must be emptied and restored.
            WorkshopWalker(puzzle, 0, int2(3, 4));
            WorkshopWalker(puzzle, 1, int2(3, 2));
            WorkshopRoom(layout, puzzle, 0, int2(4, 3), int2(4, 2));
            WorkshopTile(layout, -1, int2(4, 1), Tile.Wall);
            WorkshopRoom(layout, puzzle, 1, int2(3, 3), int2(0, 2), 15, -1, 0);
            layout.rooms[0].latched = true;
            layout.rooms[1].latched = true;
            WorkshopTile(layout, 0, int2(3, 2), Tile.Switch);
            WorkshopTile(layout, 1, int2(1, 1), Tile.Switch);
            WorkshopCargo(layout, puzzle, 1, int2(2, 2));
            WorkshopTile(layout, -1, int2(2, 3), Tile.Target);
            WorkshopTile(layout, 0, int2(1, 3), Tile.Exit);
            WorkshopTile(layout, 1, int2(3, 3), Tile.Exit);
            break;
        case 9:
        case 10:
        case 11:
            WorkshopLateLevel(level, layout, puzzle);
            break;
        default:
            break;
    }
}
string ChapterName(int level)
{
    if (level < 4) return "The shared workshop";
    if (level < 8) return "Doors within doors";
    return "Addresses and returns";
}

string LevelName(int level)
{
    switch (level)
    {
        case 0: return "First delivery";
        case 1: return "Hold that thought";
        case 2: return "Reserved space";
        case 3: return "Passing place";
        case 4: return "A door to itself";
        case 5: return "Return post";
        case 6: return "Packed together";
        case 7: return "The round trip";
        case 8: return "Change of address";
        case 9: return "Loan counter";
        case 10: return "Shared address";
        case 11: return "Borrowed space";
    }
    return "Workshop";
}

// The always-visible brief gives the objective, never a planned move order.
string LevelLesson(int level)
{
    switch (level)
    {
        case 0: return "Fill the box target, dock the numbered room, and bring both makers to player goals.";
        case 1: return "Deliver both parcels, dock the latched room, and find the two player goals.";
        case 2: return "Deliver the parcel upstairs. Both rooms must finish on their own outlines.";
        case 3: return "The parcel belongs in the other room. Match both numbered outlines and reach the player goals.";
        case 4: return "Complete the delivery, dock the latched room, and find a player goal for each maker.";
        case 5: return "The parcel belongs in the containing room. Match both room outlines and reach both player goals.";
        case 6: return "Room 2 belongs inside Room 1. Deliver its parcel and match both numbered outlines.";
        case 7: return "Complete a delivery in each room, dock the moving room, and reach the two player goals.";
        case 8: return "Deliver the parcel to the workshop floor. Both rooms must reach their numbered outlines.";
        case 9: return "Deliver both parcels and return each room to its numbered outline. Reach the two player goals.";
        case 10: return "Complete both deliveries in Room 1 and bring both makers to the workshop's player goals.";
        case 11: return "Deliver all three parcels, match every room outline, and reach both player goals in Room 1.";
    }
    return "Take your time. Every move can be undone.";
}

// Three opt-in tiers: a question, a useful arrangement, and a recovery plan.
string LevelHint(int level, int tier)
{
    var detail = Math.Clamp(tier, 0, 2);
    switch (level)
    {
        case 0:
            if (detail == 0) return "What needs to be parked before you both leave?";
            if (detail == 1) return "The room outline is one square east. The parcel target is north of the parcel.";
            return "Amber: move east once to dock the room. Teal: move north three times, then west to a player goal. Amber: west, south, south to the other player goal. A blocked room push enters its doorway instead.";
        case 1:
            if (detail == 0) return "Which delivery is taking up the room's route? Who can release its latch?";
            if (detail == 1) return "Clear the outside parcel northward. A maker on the room's west switch can hold the latch while the room moves east.";
            return "Clear the outside parcel onto its target. Inside, reach the west switch without moving the other parcel. Hold it while the partner docks the room two squares east. Then push the inside parcel north and take both player goals.";
        case 2:
            if (detail == 0) return "After making space for the parcel, where will you need to stand to put the small room back?";
            if (detail == 1) return "Hold the small room's switch and move it west. Push the parcel north, then use the containing room's lower-left passage to get behind the small room.";
            return "One maker holds the child room's switch. The other pushes that room west, delivers the parcel north, and circles through the open lower-left edge to its west doorway. Push the child east onto its outline before the holder leaves south.";
        case 3:
            if (detail == 0) return "When the boxes trade places, what delivery route will disappear?";
            if (detail == 1) return "Deliver while the rooms touch. The upper middle square can hold the left room while the right room passes underneath.";
            return "Hold the left switch, move that room east and send the parcel through. Park the left room in the upper bay. Change to the right switch, move its room west twice, then return to the left switch while its room goes east and south onto its outline.";
        case 4:
            if (detail == 0) return "The parcel needs a maker above it. Can a doorway lead to the room you are already in?";
            if (detail == 1) return "Approach the striped self-door from its north side. It leads to this same room's north entrance, with the same parcel still present.";
            return "Enter the self-door southward from the square above it. Push the parcel south twice. Leave that entry northward to return beside the striped door, then leave the physical room southward. The partner holds the other room's centre switch while it is pushed west.";
        case 5:
            if (detail == 0) return "A filled target looks finished. Does it also occupy a square you will need later?";
            if (detail == 1) return "The exported parcel blocks the west pushing stance for its own room. Store it one square north while the room moves east.";
            return "Enter the child before its switch is held, then keep a maker on that switch. Export its parcel west into the containing room. Leave the child southward, push the parcel north off its target, then dock the child east. Use the upper row to push the stored parcel south onto its target again.";
        case 6:
            if (detail == 0) return "Once a room is packed inside another, where does its parcel doorway lead?";
            if (detail == 1) return "Hold Room 2's switch while it enters Room 1's west doorway. Then its holder can leave east and hold the containing room's south switch.";
            return "Pack Room 2 through Room 1's west door. Change the holding job to Room 1's south switch and dock Room 1 east. Return inside the child and post its parcel east into the parent. Stop at the centre, get below it, and push north onto its target.";
        case 7:
            if (detail == 0) return "Neither parcel has an ordinary north approach. Which doorway changes the side you arrive from?";
            if (detail == 1) return "Hold the east switch while the left room is docked east. Approach each striped doorway from above to arrive north of the other room's parcel.";
            return "Dock the left room while its switch is held. Enter its striped door southward and push the other parcel south twice. Enter that room's striped door the same way and push the first parcel south twice. Leave the most recent entry northward, then take one player goal in each room.";
        case 8:
            if (detail == 0) return "Will Room 2's west doorway still lead to the workshop after it is packed away?";
            if (detail == 1) return "Make the outside delivery before nesting. Its target is also the standing tile for pushing Room 2, so the parcel cannot stay there yet.";
            return "Enter the child before holding its switch, then export its parcel west onto the outside target. Push that parcel north temporarily and pack the child east into Room 1. Restore the parcel from above. The holder leaves east and holds the parent switch while the partner docks the parent north.";
        case 9:
            if (detail == 0) return "The upper-left target has no ordinary pushing stance. Whose doorway could supply the missing approach?";
            if (detail == 1) return "Nest Room 2 in Room 1's west door and post its parcel north. The other filled target blocks the stance needed to bring Room 2 back out.";
            return "Hold Room 2's switch while it is packed east. Push its parcel north through the child door onto the corner target, then return to the switch. The partner stores Room 1's parcel south, pushes the child west out to its original outline, and restores the stored parcel from below.";
        case 10:
            if (detail == 0) return "Which return route will the eastward delivery close? Is the doorway you entered the only way back?";
            if (detail == 1) return "Room 1's striped door leads to Room 2. Enter Room 2's centre door from above to arrive north of Room 1's parcel. Plan to return southward.";
            return "One maker follows both striped doors to Room 1's north entrance. The partner delivers the west parcel east and leaves south. Push the north parcel south twice, then use south edge exits for both recorded entries. Room 1's bottom walkway leads back to the workshop player goals.";
        case 11:
            if (detail == 0) return "Which finished square will you need to stand on? What is blocking the other room's return doorway?";
            if (detail == 1) return "Nest Room 2, post the lower-left parcel into it, and move the child north. Room 3's parcel must move sideways before its striped door can provide Room 1's north approach.";
            return "Keep Room 2's switch held. Pack it east, post the lower-left parcel north into it, and dock it north. The holder can post that parcel back south later. Enter Room 3 through Room 1's striped door, push Room 3's parcel east from its west side, then enter its centre door southward. Push Room 1's north parcel south twice and reach both player goals.";
    }
    return "Undo is shared: take back the last move, whoever made it.";
}
