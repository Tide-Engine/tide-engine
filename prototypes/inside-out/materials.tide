// Local, opt-in art studies. These do not assign a look to the campaign.
enum SurfaceRole { Prop, Floor, Wall, Table, Trim }

Color ChapterFloor(int look, int checker)
{
    var lift = checker * .018;
    if (look == 0) return Color(.91 + lift, .83 + lift, .65 + lift);
    if (look == 1) return Color(.76 + lift, .81 + lift, .82 + lift);
    if (look == 2) return Color(.31 + lift, .34 + lift, .36 + lift);
    if (look == 3) return Color(.88 + lift, .91 + lift, .90 + lift);
    return Color(.75 + lift, .74 + lift, .67 + lift);
}

Color ChapterTable(int look, int checker)
{
    var lift = checker * .012;
    if (look == 0) return Color(.55 + lift, .39 + lift, .23 + lift);
    if (look == 1) return Color(.44 + lift, .50 + lift, .56 + lift);
    if (look == 2) return Color(.20 + lift, .23 + lift, .25 + lift);
    if (look == 3) return Color(.16 + lift, .24 + lift, .35 + lift);
    return Color(.36 + lift, .23 + lift, .15 + lift);
}

Color ChapterFrame(int look)
{
    if (look == 0) return Color(.63, .46, .28);
    if (look == 1) return Color(.66, .73, .77);
    if (look == 2) return Color(.56, .43, .26);
    if (look == 3) return Color(.19, .29, .43);
    return Color(.68, .53, .31);
}

float3 ChapterFill(int look)
{
    if (look == 0) return float3(.83, .87, .94);
    if (look == 1) return float3(.78, .88, 1.04);
    if (look == 2) return float3(.76, .83, .97);
    if (look == 3) return float3(.78, .87, 1.09);
    return float3(.85, .85, .96);
}

float3 ChapterLamp(int look)
{
    if (look == 0) return float3(1.12, 1.02, .84);
    if (look == 1) return float3(.99, 1.05, 1.12);
    if (look == 2) return float3(1.18, 1.02, .76);
    if (look == 3) return float3(1.03, 1.06, 1.13);
    return float3(1.15, 1.04, .84);
}

float ChapterShadow(int look)
{
    if (look == 0) return 1.35;
    if (look == 1) return .85;
    if (look == 2) return .75;
    if (look == 3) return 1.55;
    return 1.15;
}

// Smooth value noise in a room's own tile units. Fine layers fade with the
// occurrence's projected size, keeping grain fixed while a room scales.
float MaterialHash(int2 cell) { return (Math.Hash(cell) & 65535) / 65535.0; }
float MaterialNoise(float2 point)
{
    var cell = int2(Math.Floor(point));
    var part = point - Math.Floor(point);
    var blend = part * part * (3 - 2 * part);
    return Math.Lerp(Math.Lerp(MaterialHash(cell), MaterialHash(cell + int2(1, 0)), blend.x),
        Math.Lerp(MaterialHash(cell + int2(0, 1)), MaterialHash(cell + int2(1, 1)), blend.x), blend.y);
}

float MaterialWood(float2 uv, float pixels)
{
    // Short, stepped paint flecks rather than smoothly warped wood grain.
    // Their grid belongs to the room, so zooming never rephases the pattern.
    var streak = MaterialHash(int2(Math.Floor(uv * float2(4, 32))));
    var fleck = MaterialHash(int2(Math.Floor(uv * 32)));
    var band = Math.Floor(streak * 3) - 1;
    var pore = fleck > .94 ? -.018 : fleck < .06 ? .012 : 0.0;
    return band * .028 * Math.SmoothStep(8, 32, pixels) +
        pore * Math.SmoothStep(32, 80, pixels);
}

float MaterialStone(float2 uv, float pixels)
{
    // A small palette of square mineral flecks, without cloudy marble veins.
    var patch = MaterialHash(int2(Math.Floor(uv * 6)));
    var fleck = MaterialHash(int2(Math.Floor(uv * 32)));
    var base = (Math.Floor(patch * 3) - 1) * .012;
    var mineral = fleck > .90 ? -.022 : fleck < .08 ? .016 : 0.0;
    return base * Math.SmoothStep(4, 20, pixels) + mineral * Math.SmoothStep(24, 80, pixels);
}

float MaterialBrush(float2 uv, float pixels)
{
    var lines = MaterialNoise(float2(uv.x * .8, uv.y * 20));
    var fine = MaterialNoise(float2(uv.x * 2, uv.y * 80));
    return (lines - .5) * .05 * Math.SmoothStep(24, 100, pixels) +
        (fine - .5) * .06 * Math.SmoothStep(100, 300, pixels);
}

// RGB is the surface paint; A is satin response for the lighting pass, not
// opacity. Gameplay props and glowing marks never receive these patterns.
float4 ChapterMaterial(float3 paint, float3 point, float3 normal, SurfaceRole role, int look, float pixels)
{
    if (look < 0 || role == SurfaceRole.Prop) return float4(paint, 0);
    var top = normal.y > .5;
    var uv = top ? float2(point.x, point.z) : Math.Abs(normal.x) > .5 ? float2(point.z, point.y) : float2(point.x, point.y);
    var coarse = MaterialNoise(uv * 3.1);
    mut var detail = (coarse - .5) * .025;
    mut var satin = .10;
    if (look == 0)
    {
        // Painted timber with a restrained, deliberately pixel-like grain.
        detail = MaterialWood(uv, pixels) * (role == SurfaceRole.Wall ? .40 : 1.0);
        satin = role == SurfaceRole.Wall ? .12 : .16;
        if (top && role == SurfaceRole.Table)
        {
            var joint = uv.y * 2 - Math.Floor(uv.y * 2);
            if (joint < .008) detail -= .035 * Math.SmoothStep(8, 32, pixels);
        }
    }
    else if (look == 1)
    {
        // Enamel and an aluminium work surface, with directional brushing.
        detail = role == SurfaceRole.Wall ? (coarse - .5) * .035 : MaterialBrush(uv, pixels);
        satin = role == SurfaceRole.Wall ? .38 : .50;
    }
    else if (look == 2)
    {
        // Fine powder coat and graphite; only the outer hardware is brass.
        detail = (coarse - .5) * .07 + (MaterialNoise(uv * 25) - .5) * .06 * Math.SmoothStep(48, 120, pixels);
        satin = role == SurfaceRole.Trim ? .52 : .12;
        if (role == SurfaceRole.Trim) detail += MaterialBrush(uv, pixels);
    }
    else if (look == 3)
    {
        // Porcelain has broad, quiet glaze variation rather than grit.
        detail = (MaterialNoise(uv * 1.4) - .5) * .045;
        satin = role == SurfaceRole.Table || role == SurfaceRole.Trim ? .14 : .44;
    }
    else
    {
        if (role == SurfaceRole.Table) detail = MaterialWood(uv, pixels);
        else if (role == SurfaceRole.Floor) detail = MaterialStone(uv, pixels);
        else detail = MaterialStone(uv, pixels) * .45;
        satin = role == SurfaceRole.Trim ? .58 : role == SurfaceRole.Floor ? .24 : .18;
    }
    var tone = paint * (1 + detail);
    return float4(Math.Clamp(tone, float3(0), float3(1)), satin);
}
