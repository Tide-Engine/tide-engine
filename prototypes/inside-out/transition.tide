// Both sides of the aperture follow match ticks. A slow or reconnecting
// screen joins the same passage instead of starting a local countdown.
void FoldFrame(float2 center, float half, float angle, Color color, float stroke)
{
    var across = float2(Math.Cos(angle), Math.Sin(angle));
    var along = float2(-across.y, across.x);
    var a = center + (across + along) * half;
    var b = center + (across - along) * half;
    var c = center - (across + along) * half;
    var d = center - (across - along) * half;
    Draw.Line(a, b, stroke, color);
    Draw.Line(b, c, stroke, color);
    Draw.Line(c, d, stroke, color);
    Draw.Line(d, a, stroke, color);
}

void RoomAperture(float closed, float turn, bool reduced)
{
    var screen = float2(Screen.width, Screen.height);
    var center = screen * .5;
    var reach = Math.Max(screen.x, screen.y) * .75;
    var half = Math.Lerp(reach, 0, Math.SmoothStep(0, 1, closed));
    var left = Math.Max(0, center.x - half);
    var top = Math.Max(0, center.y - half);
    var right = Math.Min(screen.x, center.x + half);
    var bottom = Math.Min(screen.y, center.y + half);
    var ink = Color(.075, .055, .035);
    Draw.Rect(float2(left * .5, center.y), float2(left, screen.y), ink);
    Draw.Rect(float2((right + screen.x) * .5, center.y), float2(screen.x - right, screen.y), ink);
    Draw.Rect(float2(center.x, top * .5), float2(Math.Max(0, right - left), top), ink);
    Draw.Rect(float2(center.x, (bottom + screen.y) * .5), float2(Math.Max(0, right - left), screen.y - bottom), ink);
    if (reduced) return;
    for (var frame = 0; frame < 8; frame++)
    {
        var scale = half + frame * 34 + 2;
        var angle = turn * frame * .025;
        FoldFrame(center, scale, angle, Math.Lerp(RoomColor(frame % 4), ink, frame * .07), Math.Max(1, 4 - frame * .35));
    }
}

void TransitionCover(float closed, bool reduced)
{
    if (reduced)
        Draw.Rect(float2(Screen.width, Screen.height) * .5, float2(Screen.width, Screen.height),
            Color(.075, .055, .035, Math.SmoothStep(0, 1, closed)));
    else RoomAperture(closed, closed, false);
}

void TransitionName(int level, float alpha, bool ending = false)
{
    if (alpha <= 0) return;
    var center = float2(Screen.width, Screen.height) * .5;
    var tone = Color(INK.r, INK.g, INK.b, alpha);
    if (ending)
    {
        Heading("inside out", center - float2(0, 18), Screen.width < 720 ? 40.0 : 56.0, tone);
        Label("Made it, together.", center + float2(0, 36), 18,
            Color(SAGE.r, SAGE.g, SAGE.b, alpha), Anchor.MiddleCenter);
        return;
    }
    var challenge = IsChallenge(level);
    Label(challenge ? $"{ChapterName(LevelChapter(level))} / challenge" : ChapterName(LevelChapter(level)), center - float2(0, 34), 12,
        Color(BRASS.r, BRASS.g, BRASS.b, alpha), Anchor.MiddleCenter);
    FittedHeading(challenge ? LevelName(level) : $"{level + 1:D2}. {LevelName(level)}", center + float2(0, 12), tone);
    if (challenge)
        Label($"in {ChallengeBudget(level)} moves", center + float2(0, 52), 16, Color(MUTED.r, MUTED.g, MUTED.b, alpha), Anchor.MiddleCenter);
}

void FittedHeading(string title, float2 at, Color tone)
{
    var nominal = Screen.width < 720 ? 28.0 : 38.0;
    var size = Math.Min(nominal, (Screen.width - 48) * nominal / Math.Max(1, Draw.MeasureText(title, nominal, Font.Bold).x));
    Heading(title, at, size, tone);
}

// What a solve did, held on the closed aperture before the hall opens.
void SolvedSummary(Workshop workshop, float alpha)
{
    if (alpha <= 0) return;
    var center = float2(Screen.width, Screen.height) * .5;
    var chapter = LevelChapter(workshop.level);
    Label(IsChallenge(workshop.level) ? "CHALLENGE MET" : "SOLVED", center - float2(0, 34), 12,
        Color(SAGE.r, SAGE.g, SAGE.b, alpha), Anchor.MiddleCenter);
    FittedHeading(LevelName(workshop.level), center + float2(0, 12), Color(INK.r, INK.g, INK.b, alpha));
    var count = $"{ChapterName(chapter)}: {ChapterSolved(workshop.completed, chapter)} of {ChapterSize(chapter)} solved";
    // A new battery waits in the gallery until the hall's lift works.
    var waiting = !IsChallenge(workshop.level) && (workshop.unlocked & (1 << chapter)) == 0 && ChapterNeed(chapter) > 0;
    var line = waiting ? $"{count}. Its battery is waiting in the hall." : count;
    Label(line, center + float2(0, 52), 15, Color(MUTED.r, MUTED.g, MUTED.b, alpha), Anchor.MiddleCenter);
    // Its stars, and this solve's moves against par and the room's best.
    var level = workshop.level;
    var best = workshop.best[level];
    var stars = Stars(true, best, level);
    for (var star = 0; star < 3; star++)
        StarMark(center + float2((star - 1) * 34, 92), 13, star < stars ? Color(BRASS.r, BRASS.g, BRASS.b, alpha) :
            Color(.30, .26, .22, alpha), star < stars);
    var moves = workshop.puzzle.moves;
    var detail = moves > best ? $"{moves} moves, best {best}, par {LevelPar(level)}" : $"{moves} moves, par {LevelPar(level)}";
    Label(detail, center + float2(0, 124), 13, Color(MUTED.r, MUTED.g, MUTED.b, alpha), Anchor.MiddleCenter);
}

// A five-pointed star drawn as its outline's five strokes, point up, and
// filled at its middle once earned.
void StarMark(float2 at, float radius, Color tone, bool earned)
{
    if (earned) Draw.Ellipse(at, float2(radius * .45), tone);
    for (var point = 0; point < 5; point++)
    {
        var from = Math.TAU * point / 5 - Math.PI * .5;
        var to = Math.TAU * (point + 2) / 5 - Math.PI * .5;
        Draw.Line(at + float2(Math.Cos(from), Math.Sin(from)) * radius, at + float2(Math.Cos(to), Math.Sin(to)) * radius, radius * .26, tone);
    }
}

// A lift's two doors meeting in the middle of the screen; reduced motion
// fades instead.
void LiftDoors(float closed, bool reduced)
{
    var screen = float2(Screen.width, Screen.height);
    var shut = Math.SmoothStep(0, 1, closed);
    var ink = Color(.075, .055, .035);
    if (reduced)
    {
        Draw.Rect(screen * .5, screen, Color(ink.r, ink.g, ink.b, shut));
        return;
    }
    var width = screen.x * .5 * shut;
    if (width <= 0) return;
    for (var side = 0; side < 2; side++)
    {
        var x = side == 0 ? width * .5 : screen.x - width * .5;
        Draw.Rect(float2(x, screen.y * .5), float2(width, screen.y), ink);
        // A brass edge on each leaf, broken where a name is read, and a
        // groove down its middle.
        var edge = side == 0 ? width - 2 : screen.x - width + 2;
        var gap = 80.0;
        var length = screen.y * .5 - gap;
        Draw.Rect(float2(edge, length * .5), float2(4, length), Color(BRASS.r, BRASS.g, BRASS.b, .85));
        Draw.Rect(float2(edge, screen.y - length * .5), float2(4, length), Color(BRASS.r, BRASS.g, BRASS.b, .85));
        Draw.Rect(float2(side == 0 ? width * .5 : screen.x - width * .5, screen.y * .5), float2(2, screen.y), Color(.13, .10, .07));
    }
}

void HallName(int chapter, float alpha)
{
    if (alpha <= 0) return;
    var center = float2(Screen.width, Screen.height) * .5;
    Label($"CHAPTER {chapter + 1}", center - float2(0, 34), 12, Color(BRASS.r, BRASS.g, BRASS.b, alpha), Anchor.MiddleCenter);
    FittedHeading(ChapterName(chapter), center + float2(0, 12), Color(INK.r, INK.g, INK.b, alpha));
}

// The hall's arrivals and departures, on match ticks like the rest.
void HallTransition(HallState workshop, float now, bool reduced)
{
    var age = now - workshop.openedTick;
    if (workshop.arrival != 1)
    {
        // By the lift, or a pair's first hall: the doors stay shut while
        // the chapter's name is read, then open on the hall.
        if (age < workshop.introTicks)
        {
            LiftDoors(1, reduced);
            HallName(workshop.hall, Math.Min(Math.Saturate(age / NAME_FADE_TICKS),
                Math.Saturate((workshop.introTicks - age) / NAME_FADE_TICKS)));
        }
        else if (age < workshop.introTicks + REVEAL_TICKS) LiftDoors(1 - (age - workshop.introTicks) / REVEAL_TICKS, reduced);
    }
    // Back from a puzzle, the aperture opens as the view leaves its model.
    else if (age < REVEAL_TICKS) TransitionCover(1 - age / REVEAL_TICKS, reduced);
    if (workshop.departStation < 0 || workshop.departTick < 0) return;
    var going = (now - workshop.departTick - CHARGE_TICKS) / DIVE_TICKS;
    if (going <= 0) return;
    if (HallStation(workshop.hall, workshop.departStation).kind == StationKind.Level) TransitionCover(Math.Saturate(going), reduced);
    else LiftDoors(Math.Saturate(going), reduced);
}

float TransitionNameAlpha(int age)
{
    return Math.Min(Math.Saturate(float(age) / NAME_FADE_TICKS),
        Math.Saturate(float(INTRO_TICKS - age) / NAME_FADE_TICKS));
}

local singleton AperturePicture
{
    int openedTick = -1;
    bool solved;
    float closed;
    float undoCover;
}

[Stage(ArtStage.Controls, 2)]
view PuzzleTransition(Workshop workshop, Time time, Rooms.Lobby lobby, Hands hands, mut AperturePicture picture)
{
    if (!workshop.initialized || lobby.page != Rooms.Page.Playing || !Together(workshop)) return;
    Draw.SetScreen();
    var center = float2(Screen.width, Screen.height) * .5;
    if (workshop.inHall)
    {
        picture.openedTick = workshop.openedTick;
        picture.solved = false;
        picture.undoCover = 0;
        picture.closed = 0;
        HallTransition(HallOf(workshop), time.t / time.dt, hands.reduceMotion);
        return;
    }
    var solved = workshop.puzzle.solved && workshop.solvedTick >= 0;
    if (picture.openedTick != workshop.openedTick) picture.undoCover = 0;
    else if (picture.solved && !solved) picture.undoCover = picture.closed;
    picture.openedTick = workshop.openedTick;
    picture.solved = solved;
    picture.closed = 0;
    if (solved)
    {
        var age = Math.Max(0, time.tick - workshop.solvedTick);
        var closed = Math.Saturate(float(age) / CLOSE_TICKS);
        picture.closed = closed;
        if (age < CLOSE_TICKS) TransitionCover(closed, hands.reduceMotion);
        else
            // A quiet, fully opaque hold gives the name room to be read.
            Draw.Rect(center, float2(Screen.width, Screen.height), Color(.075, .055, .035));
        if (age < CLOSE_TICKS * .7)
        {
            var tone = Color(SAGE.r, SAGE.g, SAGE.b, 1 - Math.Saturate(float(age) / (CLOSE_TICKS * .7)));
            var tick = center + float2(0, -10);
            Draw.Line(tick - float2(24, 0), tick - float2(6, -18), 4, tone);
            Draw.Line(tick - float2(6, -18), tick + float2(28, -22), 4, tone);
        }
        // The hold says what was solved and what it opened, or, after the
        // campaign's last puzzle, how it ends; then both are in the hall.
        var shown = Math.Saturate(float(age - CLOSE_TICKS) / NAME_FADE_TICKS);
        if (workshop.finale) TransitionName(workshop.level, shown, true);
        else SolvedSummary(workshop, shown);
        return;
    }
    var age = time.tick - workshop.openedTick;
    if (age >= 0 && age < workshop.introTicks)
    {
        picture.closed = 1;
        Draw.Rect(center, float2(Screen.width, Screen.height), Color(.075, .055, .035));
        TransitionName(workshop.level, TransitionNameAlpha(age));
        return;
    }
    var revealAge = age - workshop.introTicks;
    if (revealAge >= 0 && revealAge < REVEAL_TICKS)
    {
        var closed = 1 - float(revealAge) / REVEAL_TICKS;
        picture.closed = closed;
        TransitionCover(closed, hands.reduceMotion);
        return;
    }
    if (picture.undoCover > 0)
    {
        // Undo cancels the match deadline immediately. Only the remaining
        // cover unwinds locally, without retaining the cancelled title.
        picture.undoCover = Math.Max(0, picture.undoCover - Math.Min(Frame.dt, .1) * 30 / REVEAL_TICKS);
        TransitionCover(picture.undoCover, hands.reduceMotion);
    }
}
