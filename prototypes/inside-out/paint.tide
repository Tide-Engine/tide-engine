local singleton Picture
{
    bool ready;
    int level = -1;
    int serial = -1;
    int openedTick = -1;
    int moves;
    float2[2] actors;
    int[2] actorRoom;
    float[2] actorScale;
    int[2] actorFacing;
    float[2] actorStride;
    float[2] actorWobble;
    float2 focusHalf;
    Transit[MAX_ROOMS] boxTransit;
    Transit[8] crateTransit;
    float focusTile;
    Traveler[2] travelers;
    MakerPassage[2] passages;
    int[2] passageMove;
    bool[2] doorwayPending;
    int[2] doorwayDirection;
    Traveler[2] doorwaySource;
    float2[MAX_ROOMS] boxes;
    int[MAX_ROOMS] boxParent;
    float2[8] crates;
    int[8] cargoRoom;
    // How far each plate and shutter stands up, eased (`CellRise`): the
    // table's 49 cells, then each room's.
    float[(MAX_ROOMS + 1) * 49] cellRise;
    float clock;
    float celebration;
    bool solved;
    int focusRoom = -2;
    int focusParent = -2;
    int focusBox = -2;
    int focusDepth = -1;
    float cameraBlend = 1;
    bool cameraOutward;
    bool cameraBridge;
    MapLens cameraLens;
    MapLens cameraFrom;
    RoomSurround cameraSurround;
    Traveler cameraActor;
}

local event(PuzzleCue cue) RememberDoorway(mut Picture picture)
{
    if (cue.kind == 3 || cue.kind == 4)
    {
        picture.doorwayPending[0] = false;
        picture.doorwayPending[1] = false;
    }
    if (cue.kind != 2 || cue.seat < 0 || cue.seat > 1 || cue.direction < 0 || cue.direction > 3) return;
    picture.doorwayPending[cue.seat] = true;
    picture.doorwayDirection[cue.seat] = cue.direction;
    picture.doorwaySource[cue.seat] = cue.source;
}

Color RoomColor(int room)
{
    // Matte model paints: sage, slate blue, plum, terracotta.
    if (room == 0) return Color(0.44, 0.61, 0.50);
    if (room == 1) return Color(0.37, 0.50, 0.74);
    if (room == 2) return Color(0.62, 0.45, 0.72);
    return Color(0.82, 0.46, 0.38);
}
// The signal paints of plates and shutters, one to a channel, apart from
// every box, bot, socket and goal paint: A magenta, B lime.
Color ChannelColor(int channel)
{
    return channel == 0 ? Color(0.90, 0.24, 0.55) : Color(0.60, 0.84, 0.16);
}
string RoomName(int room)
{
    if (room == 0) return "Box 1";
    if (room == 1) return "Box 2";
    if (room == 2) return "Box 3";
    if (room == 3) return "Box 4";
    return "Outer room";
}

// A plus sign: what a battery's top and the socket it belongs in both carry.
void PlusMark(mut Sculpture sculpture, float2 at, float size, Color tone, float floor, float scale)
{
    var stroke = Math.Max(.5, size * .16);
    FloorLine(sculpture, at - float2(size * .5, 0), at + float2(size * .5, 0), stroke, tone, floor, scale);
    FloorLine(sculpture, at - float2(0, size * .5), at + float2(0, size * .5), stroke, tone, floor, scale);
}

void PlayerMark(mut Sculpture sculpture, float2 at, float size, Color tone, float floor, float scale)
{
    Cuboid(sculpture, at - float2(0, size * .25), float2(size * .32), scale * .008, tone, floor, scale);
    Cuboid(sculpture, at + float2(0, size * .20), float2(size * .60, size * .46), scale * .008, tone, floor, scale);
}

// A battery: a dark cell with a copper top, a plus on it and a terminal at
// one edge. Seated in a socket, its top turns green.
void Crate(mut Sculpture sculpture, float2 at, float size, bool onTarget, float floor)
{
    var side = size * .72;
    var height = size * .36;
    var cap = onTarget ? Color(.62, .68, .40) : Color(.76, .60, .38);
    Cuboid(sculpture, at, float2(side), height, Color(.17, .18, .22), floor, size);
    Cuboid(sculpture, at, float2(side * .89), height * .12, cap, floor + height, size);
    var top = floor + height * 1.12 + size * .003;
    PlusMark(sculpture, at + float2(0, side * .06), side * .46, Color(.36, .26, .15), top, size);
    Cuboid(sculpture, at - float2(0, side * .36), float2(side * .26, side * .10), height * .16, Color(.86, .72, .48), floor + height * 1.12, size);
}

// How a seat's bot stands this frame. At rest it faces the way it last
// moved, on the floor, antenna still.
struct BotPose { int facing = 2; float lift; float sway; }
BotPose PoseOf(Picture picture, int seat)
{
    return BotPose { facing = picture.actorFacing[seat],
        lift = Math.Abs(Math.Sin(picture.actorStride[seat] * Math.TAU)) * .09,
        sway = Math.Sin(picture.clock * 22) * picture.actorWobble[seat] };
}

// A little test rig on treads in its seat's paint: a visor that looks where
// it is going, a bumper to push with, the yellow and black calibration mark
// on its head, and an antenna that whips about while it moves. It hops as
// it rolls. `across` and `along` are sizes to its right and ahead of it.
void BotPart(mut Sculpture sculpture, float2 at, int facing, float2 offset, float across, float along, float height, Color tone, float floor, float size)
{
    var ahead = float2(Direction(facing));
    var right = float2(-ahead.y, ahead.x);
    Cuboid(sculpture, at + (right * offset.x + ahead * offset.y) * size,
        facing % 2 == 0 ? float2(across * size, along * size) : float2(along * size, across * size), height * size, tone, floor, size);
}
void Maker(mut Sculpture sculpture, float2 at, float size, int seat, float floor, BotPose pose)
{
    var tone = seat == 0 ? BOT_AMBER : BOT_TEAL;
    var light = seat == 0 ? Color(1.0, .80, .46) : Color(.56, .98, .92);
    var up = floor + pose.lift * size;
    var tracks = floor + pose.lift * size * .35;
    BotPart(sculpture, at, pose.facing, float2(-.225, 0), .12, .46, .12, RUBBER, tracks, size);
    BotPart(sculpture, at, pose.facing, float2(.225, 0), .12, .46, .12, RUBBER, tracks, size);
    // The body: a chassis between the tracks under a wider shoulder plate.
    BotPart(sculpture, at, pose.facing, float2(0, 0), .34, .40, .20, tone, up + size * .08, size);
    BotPart(sculpture, at, pose.facing, float2(0, -.01), .44, .30, .05, Color(tone.r * .84, tone.g * .84, tone.b * .84), up + size * .28, size);
    BotPart(sculpture, at, pose.facing, float2(0, .215), .34, .03, .05, RUBBER, up + size * .05, size);
    // The head: bone white, in two steps, on a short neck.
    BotPart(sculpture, at, pose.facing, float2(0, -.02), .14, .14, .04, RUBBER, up + size * .33, size);
    BotPart(sculpture, at, pose.facing, float2(0, -.02), .30, .26, .13, DECAL, up + size * .37, size);
    BotPart(sculpture, at, pose.facing, float2(0, -.03), .21, .18, .05, Color(DECAL.r * .90, DECAL.g * .90, DECAL.b * .90), up + size * .50, size);
    BotPart(sculpture, at, pose.facing, float2(-.10, -.11), .025, .025, .14, RUBBER, up + size * .50, size);
    // What glows: a visor across the face and the tip of the antenna, in
    // the bot's own colour. Neither lights anything.
    sculpture.glow = 1;
    BotPart(sculpture, at, pose.facing, float2(0, .116), .22, .03, .055, light, up + size * .405, size);
    BotPart(sculpture, at, pose.facing, float2(-.10 + pose.sway * .05, -.11), .055, .055, .05, light, up + size * .64, size);
    sculpture.glow = 0;
}

// The one width of every line painted on a floor.
float FloorStroke(float size) { return Math.Max(.9, size * .03); }

void GoldTarget(mut Sculpture sculpture, float2 at, float size, bool occupied, float floor)
{
    // A socket glows amber until a battery is seated in it, then green.
    var tone = occupied ? Color(.52, .90, .56) : GLOW_TARGET;
    var top = floor + size * .009;
    sculpture.glow = 1;
    FloorOutline(sculpture, at, float2(size * .79), FloorStroke(size), tone, top, size);
    PlusMark(sculpture, at, size * .34, tone, top, size);
    sculpture.glow = 0;
}

// A line of a mark, run on past its ends so that lines meeting at a corner
// close it.
void MarkLine(mut Sculpture sculpture, float2 from, float2 to, float stroke, float extend, Color tone, float floor, float scale)
{
    var along = to - from;
    var length = Math.Length(along);
    if (length <= .001) return;
    var reach = along * (extend / length);
    FloorLine(sculpture, from - reach, to + reach, stroke, tone, floor, scale);
}

// A channel's shape, for players who cannot tell the two paints apart: a
// ring for A, a diamond for B. `size` is across.
void ChannelMark(mut Sculpture sculpture, int channel, float2 at, float size, Color tone, float floor, float scale, float minimumStroke = .6)
{
    var stroke = Math.Max(minimumStroke, size * .15);
    var radius = size * .5;
    if (channel == 0)
    {
        for (var i = 0; i < 12; i++)
        {
            var a = i * Math.TAU / 12;
            var b = (i + 1) * Math.TAU / 12;
            MarkLine(sculpture, at + float2(Math.Cos(a), Math.Sin(a)) * radius, at + float2(Math.Cos(b), Math.Sin(b)) * radius,
                stroke, stroke * .14, tone, floor, scale);
        }
        return;
    }
    for (var i = 0; i < 4; i++)
    {
        var a = float2(Direction(i)) * radius;
        var b = float2(Direction((i + 1) % 4)) * radius;
        MarkLine(sculpture, at + a, at + b, stroke, stroke * .5, tone, floor, scale);
    }
}

// The dark of a groove cut in the floor, and the floor's plaster.
const Color SEAM = Color(.30, .29, .28);
const Color PLASTER = Color(.86, .83, .77);

// A pressure plate: a low square pad in its channel's paint, set in a groove
// in the floor, with the channel's shape on it. `rise` is 1 standing proud,
// 0 pressed down, when it sits lower and its shape glows, and so does the
// groove, which shows round whatever stands on it.
void PlateTile(mut Sculpture sculpture, int channel, float2 at, float size, float rise, float floor)
{
    var tone = ChannelColor(channel);
    var pad = Math.Lerp(tone, PLASTER, .30);
    var height = size * (.010 + .034 * rise);
    if (size < 11)
    {
        Cuboid(sculpture, at, float2(size * .70), height, pad, floor, size);
        var top = floor + height + size * .003;
        if (channel == 0) FloorOutline(sculpture, at, float2(size * .43), Math.Max(.45, size * .10), RUBBER, top, size);
        else Cuboid(sculpture, at, float2(size * .34), size * .008, RUBBER, top, size);
        return;
    }
    var pressed = rise < .5;
    var light = Math.Lerp(tone, Color.white, .12);
    Cuboid(sculpture, at, float2(size * .80), size * .003, SEAM, floor, size);
    Cuboid(sculpture, at, float2(size * .68), height, Math.Lerp(pad, RUBBER, .30), floor, size);
    Cuboid(sculpture, at, float2(size * .68), size * .006, pad, floor + height, size);
    var top = floor + height + size * .006;
    sculpture.glow = pressed ? 1 : 0;
    if (pressed) FloorOutline(sculpture, at, float2(size * .74), FloorStroke(size), light, floor + size * .003, size);
    ChannelMark(sculpture, channel, at, size * .40, pressed ? light : Math.Lerp(tone, RUBBER, .62), top, size);
    sculpture.glow = 0;
}

// How tall a closed shutter stands, below a wall's 0.31 of a tile.
const float SHUTTER_TALL = .22;

// One physical slab at every height: the same paint, stripes and channel
// mark remain visible when it lowers flush into its groove. Occupancy and
// power both lower it completely; an occupied cell never grows a collar.
void ShutterTile(mut Sculpture sculpture, int channel, float2 at, float size, float rise, float floor)
{
    var tone = ChannelColor(channel);
    var side = Math.Lerp(tone, RUBBER, .40);
    var height = size * SHUTTER_TALL * Math.Saturate(rise);
    var slot = size * .80;
    Cuboid(sculpture, at, float2(size * .86), size * .003, SEAM, floor, size);
    FloorOutline(sculpture, at, float2(size * .87), Math.Min(FloorStroke(size), size * .045), tone, floor + size * .004, size);
    var base = floor + size * .004;
    Cuboid(sculpture, at, float2(slot), height, side, base, size);
    Cuboid(sculpture, at, float2(slot), size * .012, tone, base + height, size);
    // Three dark stripes across the top, at a slant that mirrors for B.
    var top = base + height + size * .012;
    var half = slot * .5 * .86;
    var dark = Math.Lerp(tone, RUBBER, .72);
    var flip = channel == 0 ? 1.0 : -1.0;
    for (var i = -1; i <= 1; i++)
    {
        var shift = i * half * .95;
        var from = shift >= 0 ? float2(-half + shift, -half) : float2(-half, -half - shift);
        var to = shift >= 0 ? float2(half, half - shift) : float2(half + shift, half);
        FloorLine(sculpture, at + float2(from.x, from.y * flip), at + float2(to.x, to.y * flip), size * .085, dark, top, size);
    }
    // The channel shape is painted directly over the uninterrupted stripes.
    // A light outline remains legible on both the paint and dark bands;
    // there is no raised solid badge hiding the middle of the shutter.
    var clearance = Math.Max(.02, size * .003);
    var mark = top + FloorRelief(size) + clearance;
    ChannelMark(sculpture, channel, at, size * .32, Math.Lerp(tone, DECAL, .80), mark, size, Math.Min(.6, size * .055));
}

// A clamp: a steel plate let into the floor, and at each corner a raised jaw
// that stands just outside the cell and above a box's walls, so it shows
// round the box it holds.
void ClampTile(mut Sculpture sculpture, float2 at, float size, float floor)
{
    var steel = Color(.38, .41, .46);
    var edge = Color(.64, .68, .74);
    Cuboid(sculpture, at, float2(size * .84), size * .004, Color(.27, .29, .33), floor, size);
    FloorOutline(sculpture, at, float2(size * .72), Math.Max(.5, size * .02), Color(.50, .54, .60), floor + size * .004, size);
    var tall = size * .09;
    for (var corner = 0; corner < 4; corner++)
    {
        var side = float2(corner % 2 == 0 ? -1 : 1, corner < 2 ? -1 : 1);
        var point = at + side * size * .52;
        var along = point - float2(side.x * size * .10, 0);
        var across = point - float2(0, side.y * size * .10);
        Cuboid(sculpture, along, float2(size * .27, size * .08), tall, steel, floor, size);
        Cuboid(sculpture, across, float2(size * .08, size * .27), tall, steel, floor, size);
        Cuboid(sculpture, point, float2(size * .08), size * .012, edge, floor + tall, size);
    }
}

// The rise of a plate or a shutter cell, eased by Workbench.
int RiseIndex(LevelLayout layout, int room, int2 at)
{
    if (room < -1 || room >= MAX_ROOMS || !OnRoomGrid(layout, room, at)) return -1;
    return (room + 1) * 49 + CellIndex(at, RoomWidth(layout, room));
}
float CellRise(Picture picture, LevelLayout layout, int room, int2 at)
{
    var index = RiseIndex(layout, room, at);
    return index < 0 ? 0.0 : picture.cellRise[index];
}

bool ShutterFootprint(float2 position, int2 cell, float reach)
{
    var delta = position - float2(cell);
    return Math.Abs(delta.x) < reach && Math.Abs(delta.y) < reach;
}

// Match occupancy decides passability immediately. Its departing drawing
// must also clear before the slab starts rising, so it cannot grow through
// a battery, maker or room that is still interpolating away from the cell.
bool ShutterDrawingOccupied(Workshop workshop, Picture picture, int room, int2 cell)
{
    for (var box = 0; box < workshop.layout.roomCount; box++)
        if (ShownRoom(picture.boxTransit[box], picture.boxParent[box]) == room &&
            ShutterFootprint(ShownAt(picture.boxTransit[box], picture.boxes[box]), cell, .98)) return true;
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
        if (workshop.puzzle.crates[crate].active && ShownRoom(picture.crateTransit[crate], picture.cargoRoom[crate]) == room &&
            ShutterFootprint(ShownAt(picture.crateTransit[crate], picture.crates[crate]), cell, .85)) return true;
    for (var seat = 0; seat < 2; seat++)
    {
        if (!workshop.present[seat]) continue;
        var trip = picture.passages[seat];
        if (!trip.active)
        {
            if (picture.actorRoom[seat] == room && ShutterFootprint(picture.actors[seat], cell, .85)) return true;
        }
        else
        {
            if (trip.gate.room == room && trip.aliasAlpha < 1 && ShutterFootprint(trip.position, cell, .4 + .45 * trip.scale)) return true;
            if (trip.child == room && trip.aliasAlpha > 0 && ShutterFootprint(trip.aliasPosition, cell, .85)) return true;
        }
    }
    return false;
}

void TilePaint(mut Sculpture sculpture, Tile tile, float2 at, float size, bool occupied, int variation, float floor, float rise = 0, SurfaceRole surface = SurfaceRole.Floor)
{
    // One pale plaster floor: cells meet without a joint, and only a faint
    // change of shade from one to the next keeps them countable.
    var tone = sculpture.look < 0 ? (variation % 2 == 0 ? PLASTER : Color(.835, .805, .745)) :
        surface == SurfaceRole.Table ? ChapterTable(sculpture.look, variation % 2) : ChapterFloor(sculpture.look, variation % 2);
    var thickness = Math.Max(.08, size * .010);
    sculpture.surface = surface;
    Cuboid(sculpture, at, float2(size), thickness, Color(.40, .38, .36), floor - thickness, size);
    Cuboid(sculpture, at, float2(size), thickness * .24, tone, floor, size);
    // Game pieces and their symbols retain their own paints and materials.
    sculpture.surface = SurfaceRole.Prop;
    if (PlateChannel(tile) >= 0) PlateTile(sculpture, PlateChannel(tile), at, size, rise, floor + thickness * .25);
    else if (ShutterChannel(tile) >= 0) ShutterTile(sculpture, ShutterChannel(tile), at, size, rise, floor + thickness * .25);
    else if (tile == Tile.Target) GoldTarget(sculpture, at, size, occupied, floor + thickness * .25);
    else if (tile == Tile.Clamp) ClampTile(sculpture, at, size, floor + thickness * .25);
    else if (tile == Tile.Exit)
    {
        var top = floor + size * .006;
        // A bot's place: a dark inlay with a ring and a figure that glow.
        Cuboid(sculpture, at, float2(size * .82), size * .003, Color(.13, .25, .26), top, size);
        sculpture.glow = 1;
        FloorOutline(sculpture, at, float2(size * .72), FloorStroke(size), GLOW_GOAL, top + size * .004, size);
        PlayerMark(sculpture, at, size * .56, Color(.46, .78, .70), top + size * .004, size);
        sculpture.glow = 0;
    }
}

// A wall cell: a block in its box's paint. Cells that touch are one block,
// as each fills its cell and they share a paint.
void WallTile(mut Sculpture sculpture, float2 at, float size, Color tone, float floor, float tall = .31, SurfaceRole surface = SurfaceRole.Wall)
{
    // One paint on top, right to its edges. A darker rim round a raised face
    // read as a stain on the huge blocks of a containing room.
    var height = size * tall;
    sculpture.surface = surface;
    Cuboid(sculpture, at, float2(size), height, Math.Lerp(tone, RUBBER, .30), floor, size);
    Cuboid(sculpture, at, float2(size), size * .018, tone, floor + height, size);
    sculpture.surface = SurfaceRole.Prop;
}

[Stage(ArtStage.Backdrop)]
view WorkshopBackdrop()
{
    Draw.SetScreen();
    Draw.Clear(Color(0.065, 0.045, 0.03));
    var screen = float2(Screen.width, Screen.height);
    for (var i = 0; i < 14; i++)
    {
        var y = i * screen.y / 13;
        Draw.Line(float2(0, y), float2(screen.x, y), 1, Color(0.45, 0.34, 0.23, 0.07));
    }
    Draw.Rect(float2(screen.x * 0.5, 0), float2(screen.x * 0.54, 3), Color(BRASS.r, BRASS.g, BRASS.b, 0.30));
}

// A dark plate behind words that lie over the scene.
void Chip(float2 at, float2 size)
{
    Draw.RoundRect(at + float2(0, 3), size, 6, Color(.025, .018, .012, .45));
    Draw.RoundRect(at, size, 6, Color(PAPER.r, PAPER.g, PAPER.b));
    Draw.WireRoundRect(at, size, 6, 1, Color(.39, .31, .23));
}

void DimensionFloor(mut Sculpture sculpture, Workshop workshop, int room, MapLens lens, Picture picture)
{
    var tone = room < 0 ? STEEL : RoomColor(room);
    for (var y = 0; y < RoomHeight(workshop.layout, room); y++)
        for (var x = 0; x < RoomWidth(workshop.layout, room); x++)
        {
            var position = int2(x, y);
            var tile = TileAt(workshop.layout, room, position);
            var at = MapPoint(float2(position), lens);
            if (!InPlayfield(at, lens.tile * 1.10, lens)) continue;
            var occupied = CargoAt(workshop.layout, workshop.puzzle, room, position) >= 0;
            if (tile == Tile.Wall)
            {
                // The outermost room is the table: a low top, not walls.
                var paint = room < 0 && sculpture.look >= 0 ? ChapterTable(sculpture.look, (x + y) % 2) : tone;
                WallTile(sculpture, at, lens.tile, paint, lens.floor, room < 0 ? .06 : .31,
                    room < 0 ? SurfaceRole.Table : SurfaceRole.Wall);
            }
            else
            {
                var box = BoxAt(workshop.layout, workshop.puzzle, room, position);
                var channel = PlateChannel(tile) >= 0 ? PlateChannel(tile) : ShutterChannel(tile);
                mut var covered = box >= 0 && channel >= 0;
                // Keep signals below an arriving or departing miniature as
                // well as a settled box: its rendered footprint is still here.
                for (var shell = 0; shell < workshop.layout.roomCount && !covered && channel >= 0; shell++)
                {
                    var shown = ShownAt(picture.boxTransit[shell], picture.boxes[shell]) - float2(position);
                    if (ShownRoom(picture.boxTransit[shell], picture.boxParent[shell]) == room &&
                        Math.Abs(shown.x) < .98 && Math.Abs(shown.y) < .98) covered = true;
                }
                TilePaint(sculpture, covered ? Tile.Floor : tile, at, lens.tile, occupied, x + y, lens.floor,
                    CellRise(picture, workshop.layout, room, position), room < 0 ? SurfaceRole.Table : SurfaceRole.Floor);
                if (covered)
                {
                    // Signals under boxes must stay below the miniature's
                    // floor. Show them just outside the box's footprint.
                    sculpture.glow = PlateChannel(tile) >= 0 ? 1.0 : 0.0;
                    FloorOutline(sculpture, at, float2(lens.tile * 1.04), lens.tile * .02,
                        ChannelColor(channel), lens.floor + lens.tile * .004, lens.tile);
                    ChannelMark(sculpture, channel, at + float2(lens.tile * .60, -lens.tile * .60), lens.tile * .18,
                        ChannelColor(channel), lens.floor + lens.tile * .004, lens.tile);
                    sculpture.glow = 0;
                }
            }
        }
    for (var shell = 0; shell < workshop.layout.roomCount; shell++)
    {
        var layout = workshop.layout.rooms[shell];
        if (layout.dockRoom != room || layout.dock.x < 0) continue;
        // A box standing on an outline, or passing over it, hides its pad:
        // none of it shows through that box's doorways. The brackets round
        // it stay outside the box, and glow once its own box has settled.
        mut var covered = BoxAt(workshop.layout, workshop.puzzle, room, layout.dock) >= 0;
        for (var instance = 0; instance < workshop.layout.roomCount && !covered; instance++)
        {
            var shown = ShownAt(picture.boxTransit[instance], picture.boxes[instance]) - float2(layout.dock);
            if (ShownRoom(picture.boxTransit[instance], picture.boxParent[instance]) == room &&
                Math.Abs(shown.x) < .98 && Math.Abs(shown.y) < .98) covered = true;
        }
        var settled = picture.boxTransit[shell].via == -2 && Math.Length(picture.boxes[shell] - float2(layout.dock)) < .02;
        var home = BoxDocked(workshop.layout, workshop.puzzle, shell) && settled;
        var here = MapPoint(float2(layout.dock), lens);
        DockMark(sculpture, here, lens.tile, RoomColor(shell), shell, covered, home, lens.floor);
    }
}

// Where a box has to end: a pad in its paint with its number. A box standing
// on it hides the pad, so then brackets at its corners, just outside the
// cell, say whose place it is; with its own box settled there they glow
// green, as a socket does with its battery seated.
void DockMark(mut Sculpture sculpture, float2 at, float tile, Color tone, int box, bool covered, bool home, float floor)
{
    var top = floor + tile * .014;
    if (!covered)
    {
        Cuboid(sculpture, at, float2(tile * .84), tile * .006, Math.Lerp(tone, PLASTER, .55), floor + tile * .004, tile);
        FloorOutline(sculpture, at, float2(tile * .91), FloorStroke(tile), tone, top, tile);
        if (tile > 18) FloorNumber(sculpture, box + 1, at + float2(tile * .31, -tile * .30), tile * .17, RUBBER, top, tile);
        return;
    }
    var paint = home ? Color(.52, .90, .56) : Math.Lerp(tone, Color.white, .35);
    // Thin at any size: at a containing room's scale a share of the tile
    // would be a broad glowing bar.
    var stroke = Math.Clamp(tile * .045, .8, 4);
    var reach = tile * .57;
    var arm = tile * .22;
    sculpture.glow = home ? 1 : 0;
    for (var corner = 0; corner < 4; corner++)
    {
        var side = float2(corner % 2 == 0 ? -1 : 1, corner < 2 ? -1 : 1);
        var point = at + side * reach;
        MarkLine(sculpture, point, point - float2(side.x * arm, 0), stroke, stroke * .5, paint, top, tile);
        MarkLine(sculpture, point, point - float2(0, side.y * arm), stroke, stroke * .5, paint, top, tile);
    }
    sculpture.glow = 0;
}

void DimensionPieces(mut Sculpture sculpture, Workshop workshop, int room, MapLens lens, Picture picture, Hands hands)
{
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
    {
        if (!workshop.puzzle.crates[crate].active) continue;
        // A parcel crossing a doorway is drawn where it is on its way.
        var crossing = picture.crateTransit[crate];
        if (ShownRoom(crossing, workshop.puzzle.crates[crate].room) != room) continue;
        var landed = crossing.via == -2 && TileAt(workshop.layout, room, workshop.puzzle.crates[crate].position) == Tile.Target;
        Crate(sculpture, MapPoint(ShownAt(crossing, picture.crates[crate]), lens), lens.tile * ShownScale(crossing), landed, lens.floor + lens.tile * .004);
    }
    for (var seat = 0; seat < 2; seat++)
        if (workshop.present[seat])
        {
            var trip = picture.passages[seat];
            if (trip.active)
            {
                if (room == trip.child && trip.aliasAlpha > 0)
                {
                    sculpture.alpha = trip.aliasAlpha;
                    Maker(sculpture, MapPoint(trip.aliasPosition, lens), lens.tile * .90, seat, lens.floor + lens.tile * .004, PoseOf(picture, seat));
                    sculpture.alpha = 1;
                }
                continue;
            }
            if (workshop.puzzle.actors[seat].room != room) continue;
            mut var at = MapPoint(picture.actors[seat], lens);
            if (hands.blockTime[seat] > 0)
            {
                FloorOutline(sculpture, at, float2(lens.tile * .88), Math.Max(.8, lens.tile * .035), Color(.82, .43, .26, hands.blockTime[seat] * 4), lens.floor + lens.tile * .020, lens.tile);
                if (!hands.reduceMotion) at.x += Math.Sin(hands.blockTime[seat] * 70) * lens.tile * 0.025;
            }
            if (seat == hands.seat && hands.portalTime > 0)
                FloorOutline(sculpture, at, float2(lens.tile * .92), Math.Max(.8, lens.tile * .025), Color(.33, .61, .54, hands.portalTime * 1.8), lens.floor + lens.tile * .015, lens.tile);
            Maker(sculpture, at, lens.tile * .90, seat, lens.floor + lens.tile * .004, PoseOf(picture, seat));
        }
}

// The same aperture mask is used by colour, depth and the shadow pass.
// Its ground-plane test admits the approaching body only through the gap.
void DoorwayMaker(mut Sculpture sculpture, LevelLayout layout, MakerPassage trip, Picture picture, MapLens parent, int seat)
{
    var at = MapPoint(trip.position, parent);
    var size = parent.tile * trip.scale * .90;
    var mouth = MapPoint(PassageAnchor(trip.gate, picture) + trip.lip, parent);
    var scale = RoomScale(layout, trip.child);
    var gap = parent.tile * scale * .82;
    var nested = Math.Clamp((1 - trip.scale) / Math.Max(.001, 1 - scale), 0, 1);
    var floor = parent.floor + parent.tile * .018 * nested;
    sculpture.ground = floor;
    sculpture.aperture = float4(mouth.x, mouth.y, gap * .5, 0);
    sculpture.apertureSide = trip.side;
    Maker(sculpture, at, size, seat, floor + size * .004, PoseOf(picture, seat));
    sculpture.apertureSide = -1;
}

void PassageMaker(mut Sculpture sculpture, Workshop workshop, Picture picture, Hands hands, int seat, MapLens[4] contexts, int[4] dimensions, int contextCount)
{
    var trip = picture.passages[seat];
    if (!trip.active || !workshop.present[seat]) return;
    mut var parent = contexts[0];
    mut var found = false;
    if (seat == hands.seat)
    {
        if (trip.entering) parent = ContainingLens(workshop.layout, trip.child, parent, RoomSurround { anchor = PassageAnchor(trip.gate, picture) });
        found = true;
    }
    else
    {
        for (var layer = 0; layer < contextCount; layer++)
            if (!found && dimensions[layer] == trip.gate.room)
            {
                parent = contexts[layer];
                found = true;
            }
        // The played room is the one it crosses into or out of.
        if (!found && dimensions[0] == trip.child)
        {
            parent = ContainingLens(workshop.layout, trip.child, parent, RoomSurround { anchor = PassageAnchor(trip.gate, picture) });
            found = true;
        }
    }
    if (!found)
    {
        // Locate a visible nested containing room with the same finite bounds
        // used for miniature artwork. This also covers a partner in a sibling.
        mut SceneLens[48] pending = default;
        pending[0] = SceneLens { room = dimensions[0], lens = contexts[0] };
        mut var count = 1;
        for (var index = 0; index < count && !found; index++)
        {
            var item = pending[index];
            if (item.room == trip.gate.room)
            {
                parent = item.lens;
                found = true;
                break;
            }
            if (item.depth >= 3) continue;
            for (var box = 0; box < MAX_ROOMS && count < 48; box++)
                if (ValidRoom(workshop.layout, box) && workshop.puzzle.rooms[box].room == item.room)
                {
                    pending[count] = SceneLens { room = box, lens = InteriorLens(workshop.layout, box, item.lens, picture.boxes[box]), depth = item.depth + 1 };
                    count++;
                }
        }
    }
    if (found)
    {
        sculpture.alpha = 1 - trip.aliasAlpha;
        DoorwayMaker(sculpture, workshop.layout, trip, picture, parent, seat);
        sculpture.alpha = 1;
    }
}

// The edge of a room where its outermost cell is floor: a narrow run of the
// same block the wall cells are, as tall and in the same two paints.
void WallStrip(mut Sculpture sculpture, float2 from, float2 to, float thickness, Color tone, float floor, float tile, float tall = .31, SurfaceRole surface = SurfaceRole.Wall)
{
    mut var size = float2(Math.Abs(to.x - from.x), Math.Abs(to.y - from.y));
    if (size.x < 0.001 && size.y < 0.001) return;
    if (size.x < 0.001) size.x = thickness;
    if (size.y < 0.001) size.y = thickness;
    var height = tile * tall;
    sculpture.surface = surface;
    Cuboid(sculpture, (from + to) * .5, size, height, Math.Lerp(tone, RUBBER, .30), floor, tile);
    Cuboid(sculpture, (from + to) * .5, size, tile * .018, tone, floor + height, tile);
    sculpture.surface = SurfaceRole.Prop;
}

// The walls sit inside the exact room footprint. Where the outermost cell is
// wall, that block already runs to the edge and nothing more is drawn. A
// doorway is a plain open edge cell: the wall blockout is its whole frame.
void RoomWalls(mut Sculpture sculpture, LevelLayout layout, int room, MapLens lens)
{
    var thickness = lens.tile * 0.11;
    var tone = room < 0 ? STEEL : RoomColor(room);
    for (var side = 0; side < 4; side++)
    {
        var horizontal = side % 2 == 0;
        var normal = float2(Direction(side));
        var tangent = horizontal ? float2(1, 0) : float2(0, 1);
        var door = DoorCell(layout, room, side);
        var open = room >= 0 && (layout.rooms[room].doors & (1 << side)) != 0 && OnRoomGrid(layout, room, door);
        var length = horizontal ? RoomWidth(layout, room) : RoomHeight(layout, room);
        for (var along = 0; along < length; along++)
        {
            var cell = side == 0 ? int2(along, 0) : side == 1 ? int2(RoomWidth(layout, room) - 1, along) :
                side == 2 ? int2(along, RoomHeight(layout, room) - 1) : int2(0, along);
            if (room >= 0 && TileAt(layout, room, cell) == Tile.Wall) continue;
            // Inset by half its thickness: nothing protrudes into a neighbor's
            // cell or changes a miniature's physical footprint.
            var mouth = MapPoint(float2(cell), lens) + normal * (lens.tile - thickness) * 0.5;
            var first = mouth - tangent * lens.tile * 0.5;
            var last = mouth + tangent * lens.tile * 0.5;
            if (room < 0)
            {
                // The table has a raised frame all the way round.
                var frame = sculpture.look >= 0 ? ChapterFrame(sculpture.look) : FRAME;
                WallStrip(sculpture, first, last, thickness, frame, lens.floor, lens.tile, .13, SurfaceRole.Trim);
                continue;
            }
            if (!open || !CellEqual(cell, door))
            {
                WallStrip(sculpture, first, last, thickness, tone, lens.floor, lens.tile);
                continue;
            }
        }
    }
}

void RoomTrim(mut Sculpture sculpture, LevelLayout layout, int room, MapLens lens)
{
    RoomWalls(sculpture, layout, room, lens);
    if (room < 0 || lens.tile < 3) return;
    var badge = lens.origin + float2(lens.tile * 0.12, lens.tile * 0.12);
    FloorNumber(sculpture, room + 1, badge, Math.Max(3, lens.tile * .30), DECAL, lens.floor + lens.tile * .015, lens.tile);
}

struct SceneLens { int room; MapLens lens; int depth; }

// Full rooms and miniatures share every geometric primitive. Drawing is finite
// even when a box stands inside its own room or two boxes inside each other.
void RoomScene(mut Sculpture sculpture, Workshop workshop, int room, MapLens lens, Picture picture, Hands hands, int hideBox = -1)
{
    mut SceneLens[48] pending = default;
    pending[0] = SceneLens { room = room, lens = lens };
    mut var count = 1;
    for (var index = 0; index < count && index < 48; index++)
    {
        var item = pending[index];
        var dims = RoomDimensions(workshop.layout, item.room);
        var center = MapPoint(RoomCenter(workshop.layout, item.room), item.lens);
        if (!InPlayfield(center, Math.Max(dims.x, dims.y) * item.lens.tile, lens)) continue;
        sculpture.shown.Add(item);
        sculpture.ground = item.lens.floor;
        // Procedural finishes use the canonical room's coordinates, shared
        // by every tile and carried with its miniature through a doorway.
        sculpture.surfaceOrigin = item.lens.origin;
        sculpture.surfaceTile = item.lens.tile;
        sculpture.surface = SurfaceRole.Prop;
        DimensionFloor(sculpture, workshop, item.room, item.lens, picture);
        DimensionPieces(sculpture, workshop, item.room, item.lens, picture, hands);
        RoomTrim(sculpture, workshop.layout, item.room, item.lens);
        for (var box = 0; box < MAX_ROOMS; box++)
        {
            if (!ValidRoom(workshop.layout, box) || (index == 0 && box == hideBox)) continue;
            // A box crossing a doorway is drawn where it is on its way, at
            // the size it has there, with its inside still in it.
            var crossing = picture.boxTransit[box];
            if (ShownRoom(crossing, workshop.puzzle.rooms[box].room) != item.room) continue;
            var stands = ShownAt(crossing, picture.boxes[box]);
            mut var interior = InteriorLens(workshop.layout, box, item.lens, stands);
            if (crossing.via != -2)
            {
                interior.tile = interior.tile * crossing.scale;
                interior.origin = MapPoint(stands, item.lens) - RoomCenter(workshop.layout, box) * interior.tile;
            }
            if (item.depth < 3 && count < 48 && interior.tile >= 0.65)
            {
                pending[count] = SceneLens { room = box, lens = interior, depth = item.depth + 1 };
                count++;
            }
            else
            {
                sculpture.ground = interior.floor;
                sculpture.surfaceOrigin = interior.origin;
                sculpture.surfaceTile = interior.tile;
                sculpture.surface = SurfaceRole.Wall;
                Cuboid(sculpture, MapPoint(stands, item.lens), float2(item.lens.tile * ShownScale(crossing)), interior.tile * .20, RoomColor(box), interior.floor, interior.tile);
                sculpture.ground = item.lens.floor;
                sculpture.surfaceOrigin = item.lens.origin;
                sculpture.surfaceTile = item.lens.tile;
                sculpture.surface = SurfaceRole.Prop;
            }
        }
    }
}

// The HUD is screen-space and independent of the room's camera.
[Stage(ArtStage.Board, 2)]
view WorkbenchLabels(Workshop workshop, Rooms.Lobby lobby)
{
    if (!workshop.initialized || lobby.page != Rooms.Page.Playing) return;
    Draw.SetScreen();
    var narrow = Screen.width < 720;
    var title = $"{workshop.level + 1:D2} / {LEVEL_COUNT}";
    Label($"CHAPTER {LevelChapter(workshop.level) + 1} / {ChapterName(LevelChapter(workshop.level))}", float2(20, 22), 11, BRASS);
    Draw.Text(title, float2(20, 47), narrow ? 17.0 : 24.0, INK, Anchor.MiddleLeft, Font.Bold);
    Label($"{workshop.puzzle.moves} moves", float2(Screen.width - (narrow ? 20.0 : 108.0), narrow ? 68.0 : 37.0), 14, MUTED, Anchor.MiddleRight);
}

[Stage(ArtStage.Board)]
view Workbench(Workshop workshop, Rooms.Lobby lobby, Hands hands, ThemePreview preview, mut Picture picture, mut Sculpture sculpture, mut SceneRender render)
{
    render.pending = false;
    Draw.SetScreen();
    var dt = Math.Min(Frame.dt, 0.08);
    picture.clock += dt;
    if (picture.clock > 1000) picture.clock -= 1000;
    if (workshop.puzzle.solved && !picture.solved) picture.celebration = 0;
    picture.solved = workshop.puzzle.solved;
    if (picture.solved) picture.celebration += dt;
    var first = !picture.ready;
    var levelChanged = picture.level != workshop.level;
    var reopened = levelChanged || picture.openedTick != workshop.openedTick;
    var undo = !reopened && picture.serial != workshop.serial && workshop.puzzle.moves < picture.moves;
    var snap = first || reopened || hands.reduceMotion;
    // Plates sink while pressed. A shutter stays fully lowered while powered
    // or occupied, and raises only once its departing drawing has cleared.
    // Shared undo eases the same slab back with the moving pieces.
    var power = Power(workshop.layout, workshop.puzzle);
    for (var room = -1; room < MAX_ROOMS; room++)
    {
        if (room >= 0 && !ValidRoom(workshop.layout, room)) continue;
        var width = RoomWidth(workshop.layout, room);
        for (var cell = 0; cell < width * RoomHeight(workshop.layout, room); cell++)
        {
            var at = int2(cell % width, cell / width);
            var tile = TileAt(workshop.layout, room, at);
            var channel = ShutterChannel(tile);
            if (PlateChannel(tile) < 0 && channel < 0) continue;
            var held = ThingAt(workshop.layout, workshop.puzzle, room, at).kind >= 0;
            mut var goal = 0.0;
            if (PlateChannel(tile) >= 0) goal = held ? 0.0 : 1.0;
            else if (!ShutterPassable(workshop.layout, workshop.puzzle, room, at, power) &&
                (snap || !ShutterDrawingOccupied(workshop, picture, room, at))) goal = 1.0;
            var index = RiseIndex(workshop.layout, room, at);
            if (index < 0) continue;
            var now = picture.cellRise[index];
            picture.cellRise[index] = snap || Math.Abs(goal - now) < .01 ? goal : Math.Lerp(now, goal, Math.Min(1, dt * 16));
        }
    }
    mut var localCycleExit = false;
    mut var localCycleEntry = false;
    for (var box = 0; box < MAX_ROOMS; box++)
    {
        if (!ValidRoom(workshop.layout, box)) continue;
        var placement = workshop.puzzle.rooms[box];
        picture.boxTransit[box] = FollowPushed(workshop.layout, workshop.puzzle, picture.boxTransit[box], picture.boxParent[box], picture.boxes[box],
            placement.room, placement.position, snap, undo, dt, out var drawn);
        picture.boxes[box] = drawn;
        picture.boxParent[box] = placement.room;
    }
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
    {
        var cargo = workshop.puzzle.crates[crate];
        picture.crateTransit[crate] = FollowPushed(workshop.layout, workshop.puzzle, picture.crateTransit[crate], picture.cargoRoom[crate], picture.crates[crate],
            cargo.room, cargo.position, snap || !cargo.active, undo, dt, out var drawn);
        picture.crates[crate] = drawn;
        picture.cargoRoom[crate] = cargo.room;
    }
    for (var seat = 0; seat < 2; seat++)
    {
        var actor = workshop.puzzle.actors[seat];
        var before = picture.travelers[seat];
        var passageSnap = snap;
        var was = picture.actors[seat];
        var makerBlend = passageSnap ? 1.0 : Math.Min(1, dt * 20);
        var travel = actor.room != before.room || !SameEntrance(before, actor);
        var cueSource = picture.doorwaySource[seat];
        var cueDirection = picture.doorwayDirection[seat];
        // Undo can cross a self-room doorway without changing room/trail.
        // Infer the action being reversed from its saved facing and the
        // two canonical cells, then restart from the current rendered pose.
        var reversed = undo && !travel && (!CellEqual(before.position, actor.position) || picture.passageMove[seat] == picture.moves);
        var undoEntry = reversed && EnteredBox(workshop, actor, before, before.facing) >= 0;
        var undoExit = reversed && !undoEntry && ValidRoom(workshop.layout, actor.room) &&
            workshop.puzzle.rooms[actor.room].room == actor.room &&
            CellEqual(actor.position, DoorCell(workshop.layout, actor.room, before.facing)) &&
            !OnRoomGrid(workshop.layout, actor.room, actor.position + Direction(before.facing)) &&
            CellEqual(before.position, workshop.puzzle.rooms[actor.room].position + Direction(before.facing));
        // Out of a room whose box stands inside it: beside that box, in the
        // same room, so the room and depth are unchanged.
        var cueBox = cueSource.room;
        var cuePlacement = ValidRoom(workshop.layout, cueBox) ? workshop.puzzle.rooms[cueBox] : RoomShell { };
        var cycleExit = undoEntry || picture.doorwayPending[seat] && !travel && !passageSnap &&
            cueSource.room >= 0 && cueSource.room == actor.room && SameEntrance(cueSource, actor) &&
            ValidRoom(workshop.layout, cueBox) && cuePlacement.room == actor.room &&
            CellEqual(actor.position, cuePlacement.position + Direction(cueDirection)) &&
            CellEqual(cueSource.position, DoorCell(workshop.layout, cueSource.room, cueDirection)) &&
            !OnRoomGrid(workshop.layout, cueSource.room, cueSource.position + Direction(cueDirection));
        var cycleEntry = undoExit || picture.doorwayPending[seat] && !travel && !passageSnap && !cycleExit &&
            cueSource.room == actor.room && EnteredBox(workshop, cueSource, actor, cueDirection) >= 0;
        var captured = cycleExit || cycleEntry;
        var moveDirection = undoEntry || undoExit ? (before.facing + 2) % 4 : picture.doorwayPending[seat] ? cueDirection : -1;
        picture.doorwayPending[seat] = false;
        if (passageSnap)
        {
            picture.passages[seat] = MakerPassage { };
            picture.passageMove[seat] = -1;
            picture.actors[seat] = float2(actor.position);
            picture.actorScale[seat] = 1;
        }
        else
        {
            if (travel || captured)
            {
                picture.passages[seat] = BeginPassage(workshop, picture, seat, captured && !undoEntry && !undoExit ? cueSource : before, actor, captured,
                    moveDirection);
                if (!undo && moveDirection >= 0) picture.passageMove[seat] = workshop.puzzle.moves;
                if (undoEntry || undoExit) picture.passageMove[seat] = -1;
            }
            if (cycleExit && seat == (hands.seat >= 0 && hands.seat < 2 ? hands.seat : 0)) localCycleExit = true;
            if (cycleEntry && seat == (hands.seat >= 0 && hands.seat < 2 ? hands.seat : 0)) localCycleEntry = true;
            mut var trip = picture.passages[seat];
            if (trip.active)
            {
                if (!travel && !captured)
                {
                    trip.age += dt;
                    // Input stays responsive during the passage. Follow later
                    // inner steps continuously instead of arriving at a stale
                    // doorway cell and snapping to the latest match position.
                    trip.target = SmoothCell(trip.target, float2(actor.position), makerBlend);
                }
                PassagePose(workshop.layout, trip, picture);
                var scale = RoomScale(workshop.layout, trip.child);
                picture.actors[seat] = trip.entering ? (trip.position - PassageAnchor(trip.gate, picture)) / scale + RoomCenter(workshop.layout, trip.child) : trip.position;
                picture.actorScale[seat] = trip.entering ? trip.scale / scale : trip.scale;
                if (trip.age >= PASSAGE_SECONDS)
                {
                    picture.actors[seat] = trip.target;
                    picture.actorScale[seat] = 1;
                    trip.active = false;
                }
                picture.passages[seat] = trip;
            }
            else
            {
                picture.actors[seat] = SmoothCell(picture.actors[seat], float2(actor.position), travel ? 1.0 : makerBlend);
                picture.actorScale[seat] = 1;
            }
        }
        // The bot turns to where it goes and hops along; left alone for a
        // moment it turns back to the camera, so a settled scene depends on
        // the puzzle alone.
        var rolling = picture.passages[seat];
        var rolled = Math.Length(picture.actors[seat] - was);
        // It faces the way it last moved, which the match keeps, so an undo
        // turns it back; through a doorway, the way it is crossing.
        picture.actorFacing[seat] = rolling.active && !passageSnap ? (rolling.entering ? (rolling.side + 2) % 4 : rolling.side) : actor.facing;
        if (!passageSnap && (rolling.active || rolled > .0005))
        {
            picture.actorStride[seat] += Math.Min(rolled, .5);
            picture.actorWobble[seat] = 1;
        }
        else
        {
            picture.actorWobble[seat] = 0;
            picture.actorStride[seat] = 0;
        }
        picture.actorRoom[seat] = actor.room;
        picture.travelers[seat] = actor;
    }
    picture.ready = true;
    picture.level = workshop.level;
    picture.serial = workshop.serial;
    picture.openedTick = workshop.openedTick;
    picture.moves = workshop.puzzle.moves;
    var screen = float2(Screen.width, Screen.height);
    if (!workshop.initialized || lobby.page != Rooms.Page.Playing) return;
    var localSeat = hands.seat >= 0 && hands.seat < 2 ? hands.seat : 0;
    var actor = workshop.puzzle.actors[localSeat];
    var surround = ReturnSurround(workshop, actor, picture);
    var target = WorkshopLens(workshop.layout, screen, actor.room);
    var firstView = picture.focusRoom == -2;
    var resized = picture.cameraLens.size.x != target.size.x || picture.cameraLens.size.y != target.size.y || picture.cameraLens.center.y != target.center.y;
    var crossing = localCycleExit || localCycleEntry || actor.room != picture.focusRoom || surround.room != picture.focusParent ||
        surround.box != picture.focusBox || actor.depth != picture.focusDepth;
    var transitioning = picture.cameraBlend < 1;
    if (firstView || reopened || resized || hands.reduceMotion)
    {
        picture.cameraFrom = target;
        picture.cameraLens = target;
        picture.cameraBlend = 1;
    }
    else if (crossing)
    {
        mut var source = picture.cameraLens;
        if (localCycleExit)
            source = ContainingLens(workshop.layout, actor.room, source, picture.passages[localSeat].gate);
        else if (picture.passages[localSeat].active && picture.passages[localSeat].entering && !picture.passages[localSeat].bridge)
            // Into a box: the view closes in on the box that was entered.
            source = InteriorLens(workshop.layout, actor.room, source, PassageAnchor(picture.passages[localSeat].gate, picture));
        else if (actor.depth > picture.focusDepth && surround.room == picture.focusRoom)
            source = InteriorLens(workshop.layout, actor.room, source, surround.anchor);
        else if ((actor.room != picture.focusRoom || surround.box != picture.focusBox) &&
            surround.room == picture.cameraSurround.room && actor.room >= 0 && picture.focusRoom >= 0)
            source = InteriorLens(workshop.layout, actor.room, ContainingLens(workshop.layout, picture.focusRoom, source, picture.cameraSurround), surround.anchor);
        else if (actor.room != picture.focusRoom && picture.cameraSurround.room == actor.room && actor.depth >= picture.focusDepth)
            source = ContainingLens(workshop.layout, picture.focusRoom, source, picture.cameraSurround);
        else if (actor.depth < picture.focusDepth)
        {
            mut var oldRoom = picture.cameraActor.room;
            for (var layer = 0; layer < MAX_DEPTH && oldRoom >= 0; layer++)
            {
                var previous = layer == 0 ? picture.cameraSurround : AncestorSurround(workshop, oldRoom, picture);
                source = ContainingLens(workshop.layout, oldRoom, source, previous);
                oldRoom = previous.room;
                if (oldRoom == actor.room && picture.cameraActor.depth - layer - 1 <= actor.depth) break;
            }
        }
        picture.cameraFrom = source;
        picture.cameraLens = source;
        picture.cameraBlend = 0;
        var trip = picture.passages[localSeat];
        picture.cameraOutward = trip.active ? !trip.entering : actor.depth < picture.focusDepth;
        picture.cameraBridge = trip.active && (trip.bridge || trip.sourceInside == trip.entering);
    }
    else picture.cameraBlend = Math.Min(1, picture.cameraBlend + dt / PASSAGE_SECONDS);
    picture.focusRoom = actor.room;
    picture.focusParent = surround.room;
    picture.focusBox = surround.box;
    picture.focusDepth = actor.depth;
    // Camera and maker cross the same opening on one finite clock. The
    // containing world stays still while the maker approaches its threshold.
    var eased = picture.cameraBridge ? PassageEase(picture.cameraBlend) : picture.cameraOutward ?
        1 - PassageEase((1 - picture.cameraBlend - 0.35) / 0.65) : PassageEase((picture.cameraBlend - 0.35) / 0.65);
    if (picture.cameraBlend < 1) picture.cameraLens = BlendLens(picture.cameraFrom, target, eased);
    else
    {
        var close = Math.Abs(picture.cameraLens.tile - target.tile) < 0.01 &&
            Math.Abs(picture.cameraLens.origin.x - target.origin.x) < 0.10 && Math.Abs(picture.cameraLens.origin.y - target.origin.y) < 0.10;
        picture.cameraLens = BlendLens(picture.cameraLens, target,
            hands.reduceMotion || firstView || levelChanged || resized || transitioning || close ? 1.0 : Math.Min(1, dt * 9));
    }
    picture.cameraActor = actor;
    picture.cameraSurround = surround;
    var lens = picture.cameraLens;
    // The scene fills the window below the heading; the room keeps its
    // place and size in it, and the controls lie over what surrounds it.
    var sceneTop = SceneTop(screen);
    var region = Rect(0, sceneTop, screen.x, screen.y - sceneTop);
    Draw.Rect(float2(screen.x * .5, sceneTop + region.height * .5), float2(region.width, region.height), Color(0.022, 0.026, 0.04));
    Draw.Rect(float2(screen.x * .5, sceneTop - 1), float2(screen.x, 1), Color(HAZARD.r, HAZARD.g, HAZARD.b, 0.45));
    var viewCenter = SceneCenter(screen);
    Draw.Clip(region)
    {
        BeginSculpture(sculpture, lens.tile, region);
        sculpture.look = preview.look;
        mut MapLens[4] contexts = default;
        mut RoomSurround[3] ancestors = default;
        mut int[4] dimensions = default;
        contexts[0] = lens;
        dimensions[0] = actor.room;
        mut var contextCount = 1;
        for (var layer = 0; layer < 3 && dimensions[layer] >= 0; layer++)
        {
            ancestors[layer] = AncestorSurround(workshop, dimensions[layer], picture);
            dimensions[layer + 1] = ancestors[layer].room;
            contexts[layer + 1] = ContainingLens(workshop.layout, dimensions[layer], contexts[layer], ancestors[layer]);
            contextCount++;
        }
        sculpture.shadowFloor = contexts[contextCount - 1].floor;
        for (var layer = 0; layer < contextCount; layer++)
            sculpture.layers.Add(SceneLens { room = dimensions[layer], lens = contexts[layer], depth = layer });
        for (var layer = contextCount - 1; layer >= 0; layer--)
        {
            var hiddenBox = layer > 0 ? ancestors[layer - 1].box : -1;
            RoomScene(sculpture, workshop, dimensions[layer], contexts[layer], picture, hands, hiddenBox);
        }
        for (var seat = 0; seat < 2; seat++) PassageMaker(sculpture, workshop, picture, hands, seat, contexts, dimensions, contextCount);
        if (hands.seat == localSeat && !picture.passages[localSeat].active && picture.cameraBlend >= 1)
        {
            // What the next step does to a box beside this screen's dummy:
            // a yellow bumper against one it pushes, a green arrow into one
            // it enters. Plain walks and blocked steps are left unmarked.
            sculpture.ground = lens.floor;
            var top = lens.floor + lens.tile * .022;
            for (var d = 0; d < 4; d++)
            {
                var axis = float2(Direction(d));
                var cross = float2(-axis.y, axis.x);
                var edge = MapPoint(picture.actors[localSeat], lens) + axis * lens.tile * .43;
                sculpture.glow = 1;
                if (hands.ahead[d] == Step.Push)
                    FloorLine(sculpture, edge - cross * lens.tile * .26, edge + cross * lens.tile * .26, lens.tile * .08, GLOW_TARGET, top, lens.tile);
                if (hands.ahead[d] == Step.Enter)
                {
                    var green = GLOW_GOAL;
                    FloorLine(sculpture, edge, edge - axis * lens.tile * .16 + cross * lens.tile * .18, lens.tile * .07, green, top, lens.tile);
                    FloorLine(sculpture, edge, edge - axis * lens.tile * .16 - cross * lens.tile * .18, lens.tile * .07, green, top, lens.tile);
                }
                sculpture.glow = 0;
            }
        }
        var rotation = quaternion.Euler(float3(SCENE_PITCH, 0, 0));
        // Depth bounds follow the local view's containing scales, never a
        // moving or absent partner. The orthographic ground projection is fixed.
        var distance = Math.Max(Screen.width, Screen.height) * 8 + contexts[contextCount - 1].tile * 2;
        var camera = float4x4.TRS(-Math.Forward(rotation) * distance, rotation, float3(1));
        var projection = float4x4.Ortho(Screen.width, Screen.height, .1, distance * 2);
        RenderScene(sculpture.vertices, sculpture.indices, sculpture.objects, camera, projection,
            region, viewCenter, lens.tile, render);
        // What the lens keeps sharp is the played room as it will sit once
        // the camera has settled, eased from the last room's: it must not
        // follow the zoom, or the focus would leap as a doorway is crossed.
        var sharp = RoomDimensions(workshop.layout, actor.room) * target.tile * (actor.room < 0 ? .48 : .5);
        // A new puzzle or window is simply in focus: there is no room to ease from.
        var settle = firstView || levelChanged || resized || hands.reduceMotion;
        picture.focusHalf = picture.focusHalf.x <= 0 || settle ? sharp : Math.Lerp(picture.focusHalf, sharp, Math.Min(1, dt * 5));
        if (Math.Abs(picture.focusHalf.x - sharp.x) < .05 && Math.Abs(picture.focusHalf.y - sharp.y) < .05) picture.focusHalf = sharp;
        render.focusHalf = picture.focusHalf;
        // The same for the margin left sharp around it, which is in tiles.
        picture.focusTile = picture.focusTile <= 0 || settle ? target.tile : Math.Lerp(picture.focusTile, target.tile, Math.Min(1, dt * 5));
        if (Math.Abs(picture.focusTile - target.tile) < .05) picture.focusTile = target.tile;
        render.focusTile = picture.focusTile;
    }
}
