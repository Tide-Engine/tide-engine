local singleton Picture
{
    bool ready;
    int level = -1;
    int serial = -1;
    float2[2] actors;
    int[2] actorRoom;
    float2[4] rooms;
    int[4] roomParent;
    float2[8] crates;
    int[8] cargoRoom;
    float clock;
    float celebration;
    bool solved;
}

Color RoomColor(int room)
{
    if (room == 0) return Color(0.39, 0.66, 0.55);
    if (room == 1) return Color(0.88, 0.57, 0.41);
    if (room == 2) return Color(0.60, 0.57, 0.78);
    return Color(0.83, 0.68, 0.32);
}
string RoomName(int room)
{
    if (room == 0) return "Mint";
    if (room == 1) return "Peach";
    if (room == 2) return "Lilac";
    if (room == 3) return "Honey";
    return "Workshop";
}

void Leaf(float2 at, float size, Color tone)
{
    Draw.Ellipse(at, float2(size * 0.23, size * 0.09), -0.45, tone);
    Draw.Line(at + float2(-size * 0.20, size * 0.09), at + float2(size * 0.19, -size * 0.09), Math.Max(1, size * 0.025), PAPER);
}

void Crate(float2 at, float size, bool onTarget = false)
{
    var side = size * 0.70;
    var tone = onTarget ? Color(0.76, 0.79, 0.47) : Color(0.90, 0.70, 0.40);
    Draw.RoundRect(at + float2(0, size * 0.06), float2(side), size * 0.08, Color(0.32, 0.27, 0.18, 0.19));
    Draw.RoundRect(at, float2(side), size * 0.07, Color(0.60, 0.42, 0.25));
    Draw.RoundRect(at + float2(0, -size * 0.025), float2(side * 0.91), size * 0.055, tone);
    for (var plank = -1; plank <= 1; plank++)
        Draw.Line(at + float2(-side * 0.40, plank * side * 0.24), at + float2(side * 0.40, plank * side * 0.24), Math.Max(0.7, size * 0.012), Color(0.55, 0.39, 0.22, 0.42));
    Draw.Line(at + float2(-side * 0.34, -side * 0.34), at + float2(side * 0.34, side * 0.34), Math.Max(1, size * 0.075), Color(0.99, 0.83, 0.51));
    Draw.Line(at + float2(side * 0.34, -side * 0.34), at + float2(-side * 0.34, side * 0.34), Math.Max(1, size * 0.075), Color(0.99, 0.83, 0.51));
    if (size > 19)
        for (var bolt = 0; bolt < 4; bolt++)
            Draw.Circle(at + float2((bolt % 2 == 0 ? -1.0 : 1.0) * side * 0.34, (bolt < 2 ? -1.0 : 1.0) * side * 0.34), size * 0.022, Color(0.54, 0.39, 0.24));
}

void Maker(float2 at, float size, int seat, bool mine, float clock)
{
    var tone = seat == 0 ? AMBER : TEAL;
    var pulse = mine ? 1 + Math.Sin(clock * 2.6) * 0.035 : 1.0;
    Draw.Ellipse(at + float2(0, size * 0.14), float2(size * 0.34, size * 0.20), Color(0.28, 0.28, 0.19, 0.17));
    Draw.Circle(at, size * 0.38 * pulse, PAPER);
    Draw.WireCircle(at, size * 0.38 * pulse, Math.Max(1.3, size * 0.045), tone);
    Draw.RoundRect(at + float2(0, size * 0.11), float2(size * 0.43, size * 0.36), size * 0.11, tone);
    Draw.Circle(at + float2(0, -size * 0.10), size * 0.24, Color(0.98, 0.86, 0.65));
    Draw.Ellipse(at + float2(0, -size * 0.26), float2(size * 0.30, size * 0.075), Math.Lerp(tone, INK, 0.08));
    Draw.RoundRect(at + float2(0, -size * 0.31), float2(size * 0.32, size * 0.15), size * 0.035, tone);
    if (size >= 18)
    {
        Draw.Circle(at + float2(-size * 0.07, -size * 0.10), size * 0.021, INK);
        Draw.Circle(at + float2(size * 0.07, -size * 0.10), size * 0.021, INK);
        Draw.Arc(at + float2(0, -size * 0.085), size * 0.085, 0.28, 2.84, Math.Max(0.8, size * 0.018), Color(0.61, 0.37, 0.24));
        Label($"{seat + 1}", at + float2(0, size * 0.16), Math.Max(8, size * 0.19), PAPER, Anchor.MiddleCenter);
    }
}

void GoldTarget(float2 at, float size, bool occupied)
{
    var tone = occupied ? Color(0.48, 0.63, 0.31) : Color(0.75, 0.56, 0.21);
    var side = size * 0.79;
    Draw.RoundRect(at, float2(side), size * 0.12, Color(tone.r, tone.g, tone.b, 0.12));
    Draw.WireRoundRect(at, float2(side), size * 0.12, Math.Max(1.2, size * 0.035), tone);
    Draw.Circle(at, size * 0.09, Color(tone.r, tone.g, tone.b, 0.48));
}

void TilePaint(Tile tile, float2 at, float size, bool occupied, int variation)
{
    var tone = variation % 2 == 0 ? Color(0.96, 0.93, 0.83) : Color(0.94, 0.91, 0.80);
    Draw.Rect(at, float2(size - 0.7), tone);
    if (tile == Tile.Target) GoldTarget(at, size, occupied);
    else if (tile == Tile.Exit)
    {
        Draw.RoundRect(at, float2(size * 0.82), size * 0.12, Color(0.76, 0.84, 0.66));
        Draw.WireRoundRect(at, float2(size * 0.72), size * 0.10, Math.Max(1, size * 0.025), TEAL);
        Leaf(at, size * 1.15, TEAL);
    }
    else if (tile == Tile.Switch)
    {
        Draw.RoundRect(at, float2(size * 0.64), size * 0.11, Color(0.57, 0.49, 0.32));
        Draw.RoundRect(at - float2(0, size * (occupied ? 0.01 : 0.055)), float2(size * 0.52), size * 0.075, occupied ? Color(0.68, 0.80, 0.40) : Color(0.92, 0.68, 0.32));
        Draw.Circle(at, size * 0.08, occupied ? PAPER : Color(0.53, 0.43, 0.27));
    }
}

void WallTile(float2 at, float size, Color tone)
{
    Draw.Rect(at, float2(size + 0.1), Math.Lerp(tone, INK, 0.15));
    Draw.Rect(at - float2(0, size * 0.035), float2(size - 1.3, size * 0.88), Math.Lerp(tone, PAPER, 0.18));
    if (size > 13)
    {
        Draw.Line(at + float2(-size * 0.36, -size * 0.20), at + float2(size * 0.29, -size * 0.20), Math.Max(0.7, size * 0.014), Color(0.27, 0.30, 0.22, 0.14));
        Draw.Line(at + float2(-size * 0.23, size * 0.13), at + float2(size * 0.35, size * 0.13), Math.Max(0.7, size * 0.014), Color(0.27, 0.30, 0.22, 0.12));
    }
}

[Stage(ArtStage.Backdrop)]
view WorkshopBackdrop()
{
    Draw.SetScreen();
    Draw.Clear(Color(0.91, 0.88, 0.78));
    var screen = float2(Screen.width, Screen.height);
    for (var i = 0; i < 18; i++)
    {
        var y = i * screen.y / 17;
        Draw.Line(float2(0, y), float2(screen.x, y), 1, Color(0.61, 0.53, 0.38, 0.07));
        Draw.Line(float2(screen.x * 0.12, y + 7), float2(screen.x * 0.74, y + 7), 1, Color(0.61, 0.53, 0.38, 0.03));
    }
    Draw.Shape(Shape { center = float2(screen.x * 0.18, screen.y * 0.31), size = float2(screen.x * 0.9, screen.y), ellipse = true, soft = 110, color = Color(1, 0.98, 0.87, 0.30) });
}

void Panel(float2 at, float2 size)
{
    Draw.Shape(Shape { center = at + float2(0, 5), size = size, radius = 15, color = Color(0.34, 0.29, 0.19, 0.13), soft = 8 });
    Draw.RoundRect(at, size, 15, PAPER);
    Draw.WireRoundRect(at, size, 15, 1, Color(0.72, 0.65, 0.49, 0.24));
}

struct PreviewLens { int room; float2 center; float size; int depth; int seen; }

void PreviewBase(Workshop workshop, int room, float2 at, float size, Picture picture)
{
    var tone = RoomColor(room);
    Draw.RoundRect(at + float2(0, size * 0.045), float2(size), size * 0.09, Math.Lerp(tone, INK, 0.27));
    Draw.RoundRect(at, float2(size), size * 0.09, tone);
    var step = size * 0.80 / INNER_SIZE;
    var origin = at - float2(step * 2);
    for (var y = 0; y < INNER_SIZE; y++)
        for (var x = 0; x < INNER_SIZE; x++)
        {
            var position = int2(x, y);
            var tile = TileAt(workshop.layout, room, position);
            var here = origin + float2(position) * step;
            Draw.Rect(here, float2(Math.Max(0.1, step - 0.25)), tile == Tile.Wall ? Math.Lerp(tone, INK, 0.16) : Color(0.98, 0.95, 0.84));
            if (tile == Tile.Target) Draw.WireRect(here, float2(step * 0.68), Math.Max(0.6, step * 0.12), Color(0.75, 0.56, 0.21));
            if (tile == Tile.Exit) Draw.Rect(here, float2(step * 0.70), TEAL);
            if (tile == Tile.Switch)
            {
                var held = CargoAt(workshop.layout, workshop.puzzle, room, position) >= 0 || ActorAt(workshop.puzzle, room, position) >= 0;
                Draw.Circle(here, step * 0.29, held ? Color(0.57, 0.72, 0.37) : AMBER);
            }
        }
    DoorNotches(at, size, workshop.layout.rooms[room].doors, INK);
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
        if (workshop.puzzle.crates[crate].active && workshop.puzzle.crates[crate].room == room)
            Draw.RoundRect(origin + picture.crates[crate] * step, float2(step * 0.68), step * 0.12, Color(0.89, 0.67, 0.31));
    for (var seat = 0; seat < 2; seat++)
        if (workshop.present[seat] && workshop.puzzle.actors[seat].room == room)
        {
            var here = origin + picture.actors[seat] * step;
            Draw.Circle(here, step * 0.36, PAPER);
            Draw.Circle(here, step * 0.25, seat == 0 ? AMBER : TEAL);
        }
}

// Breadth-first previews are bounded to three visible scales, including cycles.
void RoomPreview(Workshop workshop, int room, float2 at, float size, Picture picture, bool portal = false)
{
    mut PreviewLens[48] pending = default;
    pending[0] = PreviewLens { room = room, center = at, size = size, seen = 1 << room };
    mut var count = 1;
    for (var index = 0; index < count && index < 48; index++)
    {
        var item = pending[index];
        PreviewBase(workshop, item.room, item.center, item.size, picture);
        var step = item.size * 0.80 / INNER_SIZE;
        var origin = item.center - float2(step * 2);
        for (var child = 0; child < workshop.layout.roomCount; child++)
        {
            if (workshop.puzzle.rooms[child].room != item.room) continue;
            var here = origin + picture.rooms[child] * step;
            if (item.depth < 2 && count < 48)
            {
                pending[count] = PreviewLens { room = child, center = here, size = step * 0.89, depth = item.depth + 1, seen = item.seen | (1 << child) };
                count++;
            }
            else
            {
                Draw.RoundRect(here, float2(step * 0.85), step * 0.1, RoomColor(child));
                Draw.WireRect(here, float2(step * 0.58), Math.Max(0.5, step * 0.08), PAPER);
            }
        }
        for (var gate = 0; gate < workshop.layout.portalCount; gate++)
        {
            var target = workshop.layout.portals[gate];
            if (target.room != item.room) continue;
            var here = origin + float2(target.position) * step;
            var repeated = (item.seen & (1 << target.destination)) != 0;
            if (item.depth < 2 && count < 48)
            {
                pending[count] = PreviewLens { room = target.destination, center = here, size = step * 0.86, depth = item.depth + 1, seen = item.seen | (1 << target.destination) };
                count++;
            }
            else
            {
                Draw.RoundRect(here, float2(step * 0.80), step * 0.1, RoomColor(target.destination));
                if (repeated) InfinityMark(here, step * 0.74, PAPER);
            }
        }
    }
    var tone = RoomColor(room);
    Draw.WireRoundRect(at, float2(size), size * 0.09, Math.Max(1, size * 0.026), portal ? INK : Math.Lerp(tone, INK, 0.28));
    if (size >= 18)
    {
        var badge = at + float2(-size * 0.34, -size * 0.34);
        Draw.Circle(badge, Math.Max(5, size * 0.135), tone);
        Draw.WireCircle(badge, Math.Max(5, size * 0.135), Math.Max(1, size * 0.018), PAPER);
        Label($"{room + 1}", badge, Math.Max(8, size * 0.19), PAPER, Anchor.MiddleCenter);
        if (portal)
        {
            Draw.Circle(at + float2(size * 0.32, size * 0.31), size * 0.16, INK);
            InfinityMark(at + float2(size * 0.32, size * 0.31), size * 0.25, PAPER);
        }
    }
}

void DimensionFloor(Workshop workshop, int room, MapLens lens)
{
    var cells = RoomSize(room);
    var tone = room < 0 ? Color(0.74, 0.66, 0.48) : RoomColor(room);
    var center = lens.origin + float2((cells - 1) * lens.tile * 0.5);
    Draw.RoundRect(center + float2(0, 3), float2(cells * lens.tile + 9), 9, Math.Lerp(tone, INK, 0.22));
    Draw.RoundRect(center, float2(cells * lens.tile + 9), 9, tone);
    for (var y = 0; y < cells; y++)
        for (var x = 0; x < cells; x++)
        {
            var position = int2(x, y);
            var tile = TileAt(workshop.layout, room, position);
            var at = MapPoint(float2(position), lens);
            var occupied = CargoAt(workshop.layout, workshop.puzzle, room, position) >= 0 || (tile == Tile.Switch && ActorAt(workshop.puzzle, room, position) >= 0);
            if (tile == Tile.Wall) WallTile(at, lens.tile, tone);
            else TilePaint(tile, at, lens.tile, occupied, x + y);
        }
    for (var shell = 0; shell < workshop.layout.roomCount; shell++)
    {
        var layout = workshop.layout.rooms[shell];
        if (layout.dockRoom != room || layout.dock.x < 0) continue;
        var here = MapPoint(float2(layout.dock), lens);
        Draw.WireRoundRect(here, float2(lens.tile * 0.91), lens.tile * 0.12, Math.Max(1.2, lens.tile * 0.035), RoomColor(shell));
        Draw.Circle(here + float2(lens.tile * 0.31, -lens.tile * 0.30), Math.Max(3, lens.tile * 0.12), RoomColor(shell));
        if (lens.tile > 18) Label($"{shell + 1}", here + float2(lens.tile * 0.31, -lens.tile * 0.30), lens.tile * 0.17, PAPER, Anchor.MiddleCenter);
    }
    if (room >= 0)
    {
        for (var direction = 0; direction < 4; direction++)
        {
            if ((workshop.layout.rooms[room].doors & (1 << direction)) == 0) continue;
            var delta = float2(Direction(direction));
            var here = MapPoint(float2(DoorCell(direction)), lens) + delta * lens.tile * 0.46;
            var across = float2(-delta.y, delta.x);
            Draw.Line(here - across * lens.tile * 0.26, here + across * lens.tile * 0.26, Math.Max(3, lens.tile * 0.13), Color(0.98, 0.87, 0.55));
            Draw.Line(here - delta * lens.tile * 0.10, here + delta * lens.tile * 0.12, Math.Max(1, lens.tile * 0.025), INK);
        }
    }
}

void DimensionPieces(Workshop workshop, int room, MapLens lens, Picture picture, Hands hands)
{
    for (var shell = 0; shell < workshop.layout.roomCount; shell++)
    {
        if (workshop.puzzle.rooms[shell].room != room) continue;
        for (var direction = 0; direction < 4; direction++)
        {
            if ((workshop.layout.rooms[shell].doors & (1 << direction)) == 0) continue;
            var neighbor = RoomAt(workshop.layout, workshop.puzzle, room, workshop.puzzle.rooms[shell].position + Direction(direction));
            if (neighbor <= shell || (workshop.layout.rooms[neighbor].doors & (1 << ((direction + 2) % 4))) == 0) continue;
            var delta = float2(Direction(direction)) * lens.tile * 0.40;
            var from = MapPoint(picture.rooms[shell], lens) + delta;
            var to = MapPoint(picture.rooms[neighbor], lens) - delta;
            Draw.Line(from, to, Math.Max(2, lens.tile * 0.12), Color(0.98, 0.87, 0.55));
            Draw.Line(from, to, Math.Max(0.8, lens.tile * 0.025), Color(0.66, 0.51, 0.26));
        }
    }
    for (var gate = 0; gate < workshop.layout.portalCount; gate++)
    {
        var portal = workshop.layout.portals[gate];
        if (portal.room != room) continue;
        var here = MapPoint(float2(portal.position), lens);
        Draw.WireRoundRect(here, float2(lens.tile * 0.98), lens.tile * 0.14, Math.Max(1.5, lens.tile * 0.06), Color(0.99, 0.84, 0.45));
        RoomPreview(workshop, portal.destination, here, lens.tile * 0.80, picture, true);
        DoorNotches(here, lens.tile * 0.82, portal.doors, INK);
    }
    for (var shell = 0; shell < workshop.layout.roomCount; shell++)
        if (workshop.puzzle.rooms[shell].room == room)
        {
            var here = MapPoint(picture.rooms[shell], lens);
            RoomPreview(workshop, shell, here, lens.tile * 0.86, picture);
            if (workshop.layout.rooms[shell].latched && !RoomUnlocked(workshop.layout, workshop.puzzle, shell))
            {
                var badge = here + float2(lens.tile * 0.28, -lens.tile * 0.28);
                Draw.Circle(badge, lens.tile * 0.15, INK);
                Draw.Arc(badge - float2(0, lens.tile * 0.04), lens.tile * 0.07, 3.14, 6.28, Math.Max(1, lens.tile * 0.026), PAPER);
                Draw.RoundRect(badge + float2(0, lens.tile * 0.025), float2(lens.tile * 0.13, lens.tile * 0.11), lens.tile * 0.025, PAPER);
            }
        }
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
        if (workshop.puzzle.crates[crate].active && workshop.puzzle.crates[crate].room == room)
            Crate(MapPoint(picture.crates[crate], lens), lens.tile, TileAt(workshop.layout, room, workshop.puzzle.crates[crate].position) == Tile.Target);
    for (var seat = 0; seat < 2; seat++)
        if (workshop.present[seat] && workshop.puzzle.actors[seat].room == room)
        {
            mut var at = MapPoint(picture.actors[seat], lens);
            if (seat == hands.seat && hands.blockTime > 0)
            {
                Draw.WireCircle(at, lens.tile * 0.44, Math.Max(1.5, lens.tile * 0.035), Color(0.82, 0.43, 0.26, hands.blockTime * 4));
                if (!hands.reduceMotion) at.x += Math.Sin(hands.blockTime * 70) * lens.tile * 0.025;
            }
            if (seat == hands.seat && hands.portalTime > 0)
                Draw.WireCircle(at, lens.tile * (hands.reduceMotion ? 0.46 : 0.42 + (0.36 - hands.portalTime) * 0.50), Math.Max(1.5, lens.tile * 0.035), Color(0.33, 0.61, 0.54, hands.portalTime * 1.8));
            Maker(at, lens.tile * 0.90, seat, false, 0);
        }
}

void DimensionCard(Workshop workshop, int room, MapLens lens)
{
    Panel(lens.center, lens.size);
    var topLeft = lens.center - lens.size * 0.5;
    if (room < 0)
    {
        Label("THE WORKSHOP", topLeft + float2(18, 20), Screen.width < 720 ? 11.0 : 12.0, MUTED);
        Label($"{workshop.puzzle.moves} moves", topLeft + float2(lens.size.x - 16, 21), 14, MUTED, Anchor.MiddleRight);
        Label("Every pocket opens into the same shared world", lens.center + float2(0, lens.size.y * 0.5 - 16), Screen.width < 720 ? 9.0 : 11.0, MUTED, Anchor.MiddleCenter);
    }
    else
    {
        var tone = RoomColor(room);
        Draw.Circle(topLeft + float2(16, 15), 8, tone);
        Label($"{room + 1}", topLeft + float2(16, 15), 10, PAPER, Anchor.MiddleCenter);
        Label(RoomName(room), topLeft + float2(29, 15), lens.size.x < 200 ? 11.0 : 14.0, INK);
        if (workshop.layout.rooms[room].latched)
            Label(RoomUnlocked(workshop.layout, workshop.puzzle, room) ? "OPEN" : "LATCHED", topLeft + float2(lens.size.x - 11, 15), lens.size.x < 200 ? 8.0 : 10.0, RoomUnlocked(workshop.layout, workshop.puzzle, room) ? TEAL : AMBER, Anchor.MiddleRight);
        var parent = workshop.puzzle.rooms[room].room;
        Label($"in {RoomName(parent)}", lens.center + float2(0, lens.size.y * 0.5 - 12), lens.size.x < 200 ? 9.0 : 11.0, MUTED, Anchor.MiddleCenter);
        var occupiers = (workshop.present[0] && workshop.puzzle.actors[0].room == room ? 1 : 0) | (workshop.present[1] && workshop.puzzle.actors[1].room == room ? 2 : 0);
        if (occupiers != 0)
        {
            for (var seat = 0; seat < 2; seat++)
                if ((occupiers & (1 << seat)) != 0)
                    Draw.Circle(topLeft + float2(lens.size.x - 15 - seat * 11, lens.size.y - 12), 3.5, seat == 0 ? AMBER : TEAL);
        }
    }
}

void DimensionLinks(Workshop workshop, float2 screen)
{
    // The coloured thread and breadcrumb tie each lens to its movable shell.
    for (var room = 0; room < workshop.layout.roomCount; room++)
    {
        var parent = workshop.puzzle.rooms[room].room;
        var source = WorkshopLens(screen, workshop.layout.roomCount, parent);
        var target = WorkshopLens(screen, workshop.layout.roomCount, room);
        var a = MapPoint(float2(workshop.puzzle.rooms[room].position), source);
        var narrow = screen.x < 720;
        var b = narrow ? target.center - float2(0, target.size.y * 0.5 - 2) : target.center - float2(target.size.x * 0.5 - 2, 0);
        var tone = RoomColor(room);
        var ink = Color(tone.r, tone.g, tone.b, 0.28);
        if (narrow)
        {
            var route = source.center.y + source.size.y * 0.5 + 6;
            Draw.Line(a, float2(a.x, route), 2, ink);
            Draw.Line(float2(a.x, route), float2(b.x, route), 2, ink);
            Draw.Line(float2(b.x, route), b, 2, ink);
        }
        else
        {
            var route = (source.center.x + source.size.x * 0.5 + target.center.x - target.size.x * 0.5) * 0.5;
            Draw.Line(a, float2(route, a.y), 2, ink);
            Draw.Line(float2(route, a.y), float2(route, b.y), 2, ink);
            Draw.Line(float2(route, b.y), b, 2, ink);
        }
        Draw.Circle(b, 3, tone);
    }
}

[Stage(ArtStage.Board)]
view Workbench(Workshop workshop, Rooms.Lobby lobby, Hands hands, mut Picture picture)
{
    Draw.SetScreen();
    var dt = Math.Min(Frame.dt, 0.08);
    picture.clock += dt;
    if (picture.clock > 1000) picture.clock -= 1000;
    if (workshop.puzzle.solved && !picture.solved) picture.celebration = 0;
    picture.solved = workshop.puzzle.solved;
    if (picture.solved) picture.celebration += dt;
    var snap = !picture.ready || picture.level != workshop.level || picture.serial != workshop.serial || hands.reduceMotion;
    var blend = snap ? 1.0 : Math.Min(1, dt * 20);
    for (var seat = 0; seat < 2; seat++)
    {
        var actor = workshop.puzzle.actors[seat];
        picture.actors[seat] = Math.Lerp(picture.actors[seat], float2(actor.position), snap || actor.room != picture.actorRoom[seat] ? 1.0 : blend);
        picture.actorRoom[seat] = actor.room;
    }
    for (var room = 0; room < workshop.layout.roomCount; room++)
    {
        var shell = workshop.puzzle.rooms[room];
        picture.rooms[room] = Math.Lerp(picture.rooms[room], float2(shell.position), snap || shell.room != picture.roomParent[room] ? 1.0 : blend);
        picture.roomParent[room] = shell.room;
    }
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
    {
        var cargo = workshop.puzzle.crates[crate];
        picture.crates[crate] = Math.Lerp(picture.crates[crate], float2(cargo.position), snap || cargo.room != picture.cargoRoom[crate] ? 1.0 : blend);
        picture.cargoRoom[crate] = cargo.room;
    }
    picture.ready = true;
    picture.level = workshop.level;
    picture.serial = workshop.serial;
    var screen = float2(Screen.width, Screen.height);
    var narrow = screen.x < 720;
    var compact = screen.x < 1050;
    var width = Math.Min(screen.x - 36, 1180);
    var left = (screen.x - width) * 0.5;
    Label("inside out", float2(left, 37), narrow ? 29.0 : 36.0, INK);
    if (!compact) Label("rooms within rooms. a way together.", float2(left, 66), 14, MUTED);
    if (workshop.initialized)
    {
        var progress = float2(compact ? left : left + 255, compact ? 133 : 37);
        Label($"{workshop.level + 1:D2} / {LEVEL_COUNT}   {LevelName(workshop.level)}", progress, compact ? 13.0 : 18.0, INK);
        if (!compact) Paragraph(LevelLesson(workshop.level), progress + float2(0, 30), width - 440, 13, MUTED);
    }
    if (!workshop.initialized || lobby.page != Rooms.Page.Playing) return;
    for (var dimension = -1; dimension < workshop.layout.roomCount; dimension++)
        DimensionCard(workshop, dimension, WorkshopLens(screen, workshop.layout.roomCount, dimension));
    DimensionLinks(workshop, screen);
    for (var dimension = -1; dimension < workshop.layout.roomCount; dimension++)
    {
        var lens = WorkshopLens(screen, workshop.layout.roomCount, dimension);
        DimensionFloor(workshop, dimension, lens);
        DimensionPieces(workshop, dimension, lens, picture, hands);
    }
    if (workshop.puzzle.solved && picture.celebration < 2 && !hands.reduceMotion)
    {
        var main = WorkshopLens(screen, workshop.layout.roomCount, -1);
        var gridWidth = main.tile * OUTER_SIZE;
        var gridLeft = main.origin.x - main.tile * 0.5;
        var gridTop = main.origin.y - main.tile * 0.5;
        Draw.Clip(Rect(gridLeft, gridTop, gridWidth, gridWidth))
        {
            for (var spark = 0; spark < 22; spark++)
            {
                var fall = picture.celebration * 85;
                var at = float2(gridLeft + (spark * 47 + 29) % int(gridWidth), Math.Max(gridTop + 6, (compact ? 154.0 : 126.0) + 65) + fall + (spark * 31) % 80);
                Draw.Rect(at, float2(4, 7), picture.clock + spark, spark % 2 == 0 ? AMBER : TEAL);
            }
        }
    }
}
