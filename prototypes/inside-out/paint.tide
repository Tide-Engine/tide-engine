local singleton Picture
{
    bool ready;
    int level = -1;
    int serial = -1;
    float2[2] actors;
    int[2] actorRoom;
    float2[4] rooms;
    int[4] roomParent;
    float2[8] crates;
    int[8] cargoRoom;
    float clock;
    float celebration;
    bool solved;
    int focusRoom = -2;
    int focusParent = -2;
    int focusShell = -2;
    int focusPortal = -2;
    int focusDepth = -1;
    int focusOutside;
    float cameraBlend = 1;
    MapLens cameraLens;
    MapLens cameraFrom;
    RoomSurround cameraSurround;
    Traveler cameraActor;
}

Color RoomColor(int room)
{
    if (room == 0) return Color(0.39, 0.66, 0.55);
    if (room == 1) return Color(0.88, 0.57, 0.41);
    if (room == 2) return Color(0.60, 0.57, 0.78);
    return Color(0.83, 0.68, 0.32);
}
string RoomName(int room)
{
    if (room == 0) return "Mint";
    if (room == 1) return "Peach";
    if (room == 2) return "Lilac";
    if (room == 3) return "Honey";
    return "Workshop";
}

void Leaf(float2 at, float size, Color tone)
{
    Draw.Ellipse(at, float2(size * 0.23, size * 0.09), -0.45, tone);
    Draw.Line(at + float2(-size * 0.20, size * 0.09), at + float2(size * 0.19, -size * 0.09), Math.Max(1, size * 0.025), PAPER);
}

void Crate(float2 at, float size, bool onTarget = false)
{
    var side = size * 0.70;
    var tone = onTarget ? Color(0.76, 0.79, 0.47) : Color(0.90, 0.70, 0.40);
    Draw.RoundRect(at + float2(0, size * 0.06), float2(side), size * 0.08, Color(0.32, 0.27, 0.18, 0.19));
    Draw.RoundRect(at, float2(side), size * 0.07, Color(0.60, 0.42, 0.25));
    Draw.Shape(Shape { center = at + float2(0, -size * 0.025), size = float2(side * 0.91), radius = size * 0.055,
        color = Math.Lerp(tone, Color.white, 0.13), color2 = Math.Lerp(tone, Color(0.59, 0.40, 0.23), 0.14) });
    Draw.WireRoundRect(at + float2(0, -size * 0.025), float2(side * 0.84), size * 0.045, Math.Max(0.7, size * 0.014), Color(1, 0.91, 0.65, 0.65));
    for (var plank = -1; plank <= 1; plank++)
        Draw.Line(at + float2(-side * 0.40, plank * side * 0.24), at + float2(side * 0.40, plank * side * 0.24), Math.Max(0.7, size * 0.012), Color(0.55, 0.39, 0.22, 0.42));
    Draw.Line(at + float2(-side * 0.34, -side * 0.34), at + float2(side * 0.34, side * 0.34), Math.Max(1, size * 0.075), Color(0.99, 0.83, 0.51));
    Draw.Line(at + float2(side * 0.34, -side * 0.34), at + float2(-side * 0.34, side * 0.34), Math.Max(1, size * 0.075), Color(0.99, 0.83, 0.51));
    if (size > 19)
        for (var bolt = 0; bolt < 4; bolt++)
            Draw.Circle(at + float2((bolt % 2 == 0 ? -1.0 : 1.0) * side * 0.34, (bolt < 2 ? -1.0 : 1.0) * side * 0.34), size * 0.022, Color(0.54, 0.39, 0.24));
}

void Maker(float2 at, float size, int seat, bool mine, float clock)
{
    var tone = seat == 0 ? AMBER : TEAL;
    var pulse = mine ? 1 + Math.Sin(clock * 2.6) * 0.035 : 1.0;
    Draw.Ellipse(at + float2(0, size * 0.14), float2(size * 0.34, size * 0.20), Color(0.28, 0.28, 0.19, 0.17));
    Draw.Circle(at, size * 0.38 * pulse, PAPER);
    Draw.WireCircle(at, size * 0.38 * pulse, Math.Max(1.3, size * 0.045), tone);
    Draw.RoundRect(at + float2(0, size * 0.11), float2(size * 0.43, size * 0.36), size * 0.11, tone);
    Draw.Circle(at + float2(0, -size * 0.10), size * 0.24, Color(0.98, 0.86, 0.65));
    Draw.Ellipse(at + float2(0, -size * 0.26), float2(size * 0.30, size * 0.075), Math.Lerp(tone, INK, 0.08));
    Draw.RoundRect(at + float2(0, -size * 0.31), float2(size * 0.32, size * 0.15), size * 0.035, tone);
    Draw.Line(at + float2(-size * 0.11, -size * 0.34), at + float2(size * 0.06, -size * 0.34), Math.Max(0.7, size * 0.023), Math.Lerp(tone, Color.white, 0.27));
    if (size >= 18)
    {
        Draw.Circle(at + float2(-size * 0.07, -size * 0.10), size * 0.021, INK);
        Draw.Circle(at + float2(size * 0.07, -size * 0.10), size * 0.021, INK);
        Draw.Arc(at + float2(0, -size * 0.085), size * 0.085, 0.28, 2.84, Math.Max(0.8, size * 0.018), Color(0.61, 0.37, 0.24));
        Label($"{seat + 1}", at + float2(0, size * 0.16), Math.Max(8, size * 0.19), PAPER, Anchor.MiddleCenter);
    }
}

void GoldTarget(float2 at, float size, bool occupied)
{
    var tone = occupied ? Color(0.48, 0.63, 0.31) : Color(0.75, 0.56, 0.21);
    var side = size * 0.79;
    Draw.RoundRect(at, float2(side), size * 0.12, Color(tone.r, tone.g, tone.b, 0.12));
    Draw.WireRoundRect(at, float2(side), size * 0.12, Math.Max(1.2, size * 0.035), tone);
    Draw.Circle(at, size * 0.09, Color(tone.r, tone.g, tone.b, 0.48));
}

void TilePaint(Tile tile, float2 at, float size, bool occupied, int variation)
{
    var tone = variation % 2 == 0 ? Color(0.96, 0.93, 0.83) : Color(0.94, 0.91, 0.80);
    Draw.Shape(Shape { center = at, size = float2(Math.Max(0.1, size - Math.Min(0.7, size * 0.02))), color = tone, color2 = Math.Lerp(tone, Color(0.85, 0.76, 0.58), 0.055) });
    if (size > 19)
    {
        for (var grain = 0; grain < 3; grain++)
        {
            var y = (grain - 1) * size * 0.27;
            var offset = (variation % 3 - 1) * size * 0.05;
            Draw.Line(at + float2(-size * 0.35 + offset, y), at + float2(size * 0.24 + offset, y), Math.Max(0.6, size * 0.009), Color(0.67, 0.54, 0.33, 0.065));
        }
    }
    if (tile == Tile.Target) GoldTarget(at, size, occupied);
    else if (tile == Tile.Exit)
    {
        Draw.RoundRect(at, float2(size * 0.82), size * 0.12, Color(0.76, 0.84, 0.66));
        Draw.WireRoundRect(at, float2(size * 0.72), size * 0.10, Math.Max(1, size * 0.025), TEAL);
        Leaf(at, size * 1.15, TEAL);
    }
    else if (tile == Tile.Switch)
    {
        Draw.RoundRect(at, float2(size * 0.64), size * 0.11, Color(0.57, 0.49, 0.32));
        Draw.RoundRect(at - float2(0, size * (occupied ? 0.01 : 0.055)), float2(size * 0.52), size * 0.075, occupied ? Color(0.68, 0.80, 0.40) : Color(0.92, 0.68, 0.32));
        Draw.Circle(at, size * 0.08, occupied ? PAPER : Color(0.53, 0.43, 0.27));
    }
}

void WallTile(float2 at, float size, Color tone)
{
    Draw.Rect(at, float2(size + 0.1), Math.Lerp(tone, INK, 0.22));
    Draw.Shape(Shape { center = at - float2(0, size * 0.035), size = float2(Math.Max(0.1, size - Math.Min(1.3, size * 0.03)), size * 0.88),
        color = Math.Lerp(tone, PAPER, 0.28), color2 = Math.Lerp(tone, INK, 0.05) });
    Draw.Line(at + float2(-size * 0.46, -size * 0.46), at + float2(size * 0.46, -size * 0.46), Math.Max(0.8, size * 0.024), Math.Lerp(tone, PAPER, 0.42));
    if (size > 13)
    {
        Draw.Line(at + float2(-size * 0.36, -size * 0.20), at + float2(size * 0.29, -size * 0.20), Math.Max(0.7, size * 0.014), Color(0.27, 0.30, 0.22, 0.14));
        Draw.Line(at + float2(-size * 0.23, size * 0.13), at + float2(size * 0.35, size * 0.13), Math.Max(0.7, size * 0.014), Color(0.27, 0.30, 0.22, 0.12));
    }
}

[Stage(ArtStage.Backdrop)]
view WorkshopBackdrop()
{
    Draw.SetScreen();
    Draw.Clear(Color(0.91, 0.88, 0.78));
    var screen = float2(Screen.width, Screen.height);
    for (var i = 0; i < 18; i++)
    {
        var y = i * screen.y / 17;
        Draw.Line(float2(0, y), float2(screen.x, y), 1, Color(0.61, 0.53, 0.38, 0.07));
        Draw.Line(float2(screen.x * 0.12, y + 7), float2(screen.x * 0.74, y + 7), 1, Color(0.61, 0.53, 0.38, 0.03));
    }
    Draw.Shape(Shape { center = float2(screen.x * 0.18, screen.y * 0.31), size = float2(screen.x * 0.9, screen.y), ellipse = true, soft = 110, color = Color(1, 0.98, 0.87, 0.30) });
}

void Panel(float2 at, float2 size)
{
    Draw.Shape(Shape { center = at + float2(0, 5), size = size, radius = 15, color = Color(0.34, 0.29, 0.19, 0.13), soft = 8 });
    Draw.RoundRect(at, size, 15, PAPER);
    Draw.WireRoundRect(at, size, 15, 1, Color(0.72, 0.65, 0.49, 0.24));
}

void DimensionFloor(Workshop workshop, int room, MapLens lens)
{
    var cells = RoomSize(room);
    var tone = room < 0 ? Color(0.74, 0.66, 0.48) : RoomColor(room);
    var center = lens.origin + float2((cells - 1) * lens.tile * 0.5);
    Draw.Shape(Shape { center = center + float2(0, lens.tile * 0.08), size = float2((cells + 0.36) * lens.tile), radius = lens.tile * 0.18,
        color = Color(0.22, 0.26, 0.17, 0.23), soft = lens.tile * 0.10 });
    Draw.RoundRect(center + float2(0, lens.tile * 0.045), float2((cells + 0.28) * lens.tile), lens.tile * 0.18, Math.Lerp(tone, INK, 0.22));
    Draw.RoundRect(center, float2((cells + 0.22) * lens.tile), lens.tile * 0.18, tone);
    for (var y = 0; y < cells; y++)
        for (var x = 0; x < cells; x++)
        {
            var position = int2(x, y);
            var tile = TileAt(workshop.layout, room, position);
            var at = MapPoint(float2(position), lens);
            if (!InPlayfield(at, lens.tile * 1.10, lens)) continue;
            var occupied = CargoAt(workshop.layout, workshop.puzzle, room, position) >= 0 || (tile == Tile.Switch && ActorAt(workshop.puzzle, room, position) >= 0);
            if (tile == Tile.Wall) WallTile(at, lens.tile, tone);
            else TilePaint(tile, at, lens.tile, occupied, x + y);
        }
    for (var shell = 0; shell < workshop.layout.roomCount; shell++)
    {
        var layout = workshop.layout.rooms[shell];
        if (layout.dockRoom != room || layout.dock.x < 0) continue;
        var here = MapPoint(float2(layout.dock), lens);
        Draw.WireRoundRect(here, float2(lens.tile * 0.91), lens.tile * 0.12, Math.Max(1.2, lens.tile * 0.035), RoomColor(shell));
        Draw.Circle(here + float2(lens.tile * 0.31, -lens.tile * 0.30), Math.Max(3, lens.tile * 0.12), RoomColor(shell));
        if (lens.tile > 18) Label($"{shell + 1}", here + float2(lens.tile * 0.31, -lens.tile * 0.30), lens.tile * 0.17, PAPER, Anchor.MiddleCenter);
    }
    if (room >= 0)
    {
        for (var direction = 0; direction < 4; direction++)
        {
            if ((workshop.layout.rooms[room].doors & (1 << direction)) == 0) continue;
            var delta = float2(Direction(direction));
            var here = MapPoint(float2(DoorCell(direction)), lens) + delta * lens.tile * 0.46;
            var across = float2(-delta.y, delta.x);
            Draw.Line(here - across * lens.tile * 0.26, here + across * lens.tile * 0.26, Math.Max(3, lens.tile * 0.13), Color(0.98, 0.87, 0.55));
            Draw.Line(here - delta * lens.tile * 0.10, here + delta * lens.tile * 0.12, Math.Max(1, lens.tile * 0.025), INK);
        }
    }
}

void DimensionConnections(Workshop workshop, int room, MapLens lens, Picture picture)
{
    for (var shell = 0; shell < workshop.layout.roomCount; shell++)
    {
        if (workshop.puzzle.rooms[shell].room != room) continue;
        for (var direction = 0; direction < 4; direction++)
        {
            if ((workshop.layout.rooms[shell].doors & (1 << direction)) == 0) continue;
            var neighbor = RoomAt(workshop.layout, workshop.puzzle, room, workshop.puzzle.rooms[shell].position + Direction(direction));
            if (neighbor <= shell || (workshop.layout.rooms[neighbor].doors & (1 << ((direction + 2) % 4))) == 0) continue;
            var delta = float2(Direction(direction)) * lens.tile * 0.40;
            var from = MapPoint(picture.rooms[shell], lens) + delta;
            var to = MapPoint(picture.rooms[neighbor], lens) - delta;
            Draw.Line(from, to, Math.Max(2, lens.tile * 0.12), Color(0.98, 0.87, 0.55));
            Draw.Line(from, to, Math.Max(0.8, lens.tile * 0.025), Color(0.66, 0.51, 0.26));
        }
    }
}

void DimensionPieces(Workshop workshop, int room, MapLens lens, Picture picture, Hands hands)
{
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
        if (workshop.puzzle.crates[crate].active && workshop.puzzle.crates[crate].room == room)
            Crate(MapPoint(picture.crates[crate], lens), lens.tile, TileAt(workshop.layout, room, workshop.puzzle.crates[crate].position) == Tile.Target);
    for (var seat = 0; seat < 2; seat++)
        if (workshop.present[seat] && workshop.puzzle.actors[seat].room == room)
        {
            mut var at = MapPoint(picture.actors[seat], lens);
            if (seat == hands.seat && hands.blockTime > 0)
            {
                Draw.WireCircle(at, lens.tile * 0.44, Math.Max(1.5, lens.tile * 0.035), Color(0.82, 0.43, 0.26, hands.blockTime * 4));
                if (!hands.reduceMotion) at.x += Math.Sin(hands.blockTime * 70) * lens.tile * 0.025;
            }
            if (seat == hands.seat && hands.portalTime > 0)
                Draw.WireCircle(at, lens.tile * (hands.reduceMotion ? 0.46 : 0.42 + (0.36 - hands.portalTime) * 0.50), Math.Max(1.5, lens.tile * 0.035), Color(0.33, 0.61, 0.54, hands.portalTime * 1.8));
            Maker(at, lens.tile * 0.90, seat, false, 0);
        }
}

void RoomTrim(Workshop workshop, int room, MapLens lens, bool portal)
{
    if (room < 0) return;
    var center = lens.origin + float2(2 * lens.tile);
    var tone = RoomColor(room);
    var side = (INNER_SIZE + 0.22) * lens.tile;
    Draw.WireRoundRect(center, float2(side), lens.tile * 0.18, Math.Max(0.5, lens.tile * 0.08), portal ? Color(0.90, 0.70, 0.31) : Math.Lerp(tone, INK, 0.23));
    if (lens.tile * INNER_SIZE >= 18)
    {
        var badge = center - float2(lens.tile * 2.20);
        Draw.Circle(badge, lens.tile * 0.40, tone);
        Draw.WireCircle(badge, lens.tile * 0.40, Math.Max(0.5, lens.tile * 0.05), PAPER);
        if (lens.tile >= 3) Label($"{room + 1}", badge, Math.Max(6, lens.tile * 0.52), PAPER, Anchor.MiddleCenter);
        if (portal)
        {
            var mark = center + float2(lens.tile * 2.18);
            Draw.Circle(mark, lens.tile * 0.46, INK);
            InfinityMark(mark, lens.tile * 0.68, PAPER);
        }
        if (workshop.layout.rooms[room].latched && !RoomUnlocked(workshop.layout, workshop.puzzle, room))
        {
            var lock = center + float2(lens.tile * 2.12, -lens.tile * 2.12);
            Draw.Circle(lock, lens.tile * 0.43, INK);
            Draw.Arc(lock - float2(0, lens.tile * 0.10), lens.tile * 0.20, 3.14, 6.28, Math.Max(0.5, lens.tile * 0.06), PAPER);
            Draw.RoundRect(lock + float2(0, lens.tile * 0.075), float2(lens.tile * 0.38, lens.tile * 0.30), lens.tile * 0.05, PAPER);
        }
    }
}

struct SceneLens { int room; MapLens lens; int depth; bool portal; }

// Full rooms and miniatures share every geometric primitive. Drawing is finite
// even when a doorway refers to its own canonical room.
void RoomScene(Workshop workshop, int room, MapLens lens, Picture picture, Hands hands, bool portal = false, int hideShell = -1, int hidePortal = -1)
{
    mut SceneLens[48] pending = default;
    pending[0] = SceneLens { room = room, lens = lens, portal = portal };
    mut var count = 1;
    for (var index = 0; index < count && index < 48; index++)
    {
        var item = pending[index];
        var center = item.lens.origin + float2((RoomSize(item.room) - 1) * item.lens.tile * 0.5);
        if (!InPlayfield(center, (RoomSize(item.room) + 0.5) * item.lens.tile, lens)) continue;
        DimensionFloor(workshop, item.room, item.lens);
        DimensionConnections(workshop, item.room, item.lens, picture);
        DimensionPieces(workshop, item.room, item.lens, picture, hands);
        RoomTrim(workshop, item.room, item.lens, item.portal);
        for (var child = 0; child < workshop.layout.roomCount; child++)
        {
            if (workshop.puzzle.rooms[child].room != item.room || (index == 0 && child == hideShell)) continue;
            var interior = InteriorLens(item.lens, picture.rooms[child]);
            if (item.depth < 3 && count < 48 && interior.tile >= 0.65)
            {
                pending[count] = SceneLens { room = child, lens = interior, depth = item.depth + 1 };
                count++;
            }
            else Draw.RoundRect(MapPoint(picture.rooms[child], item.lens), float2(item.lens.tile * 0.84), item.lens.tile * 0.03, RoomColor(child));
        }
        for (var gate = 0; gate < workshop.layout.portalCount; gate++)
        {
            var door = workshop.layout.portals[gate];
            if (door.room != item.room || (index == 0 && gate == hidePortal)) continue;
            var interior = InteriorLens(item.lens, float2(door.position));
            if (item.depth < 3 && count < 48 && interior.tile >= 0.65)
            {
                pending[count] = SceneLens { room = door.destination, lens = interior, depth = item.depth + 1, portal = true };
                count++;
            }
            else
            {
                var here = MapPoint(float2(door.position), item.lens);
                Draw.RoundRect(here, float2(item.lens.tile * 0.84), item.lens.tile * 0.03, RoomColor(door.destination));
                InfinityMark(here, item.lens.tile * 0.52, PAPER);
            }
        }
    }
}

void DimensionFrame(Workshop workshop, int room, MapLens lens, RoomSurround surround, int depth)
{
    Panel(lens.center, lens.size);
    var topLeft = lens.center - lens.size * 0.5;
    var narrow = Screen.width < 720;
    if (room < 0)
        Label("THE WORKSHOP", topLeft + float2(18, 20), Screen.width < 720 ? 11.0 : 12.0, MUTED);
    else
    {
        var tone = RoomColor(room);
        Label($"INSIDE {RoomName(room)}  /  {room + 1}", topLeft + float2(18, 20), narrow ? 11.0 : 12.0, Math.Lerp(tone, INK, 0.40));
    }
    Label($"{workshop.puzzle.moves} moves", topLeft + float2(lens.size.x - 16, 21), 14, MUTED, Anchor.MiddleRight);
    var footer = lens.center + float2(0, lens.size.y * 0.5 - 13);
    if (room < 0)
        Label(narrow ? "Push a room. When it cannot move, walk inside." : "Rooms move first  /  A blocked room opens its doorway", footer, narrow ? 9.0 : 11.0, MUTED, Anchor.MiddleCenter);
    else
    {
        var source = surround.reference ? "reference door" : "room doorway";
        Label($"Outside: {RoomName(surround.room)}  /  {source}  /  depth {depth}", footer, narrow ? 9.0 : 11.0, MUTED, Anchor.MiddleCenter);
        if (workshop.layout.rooms[room].latched && !narrow)
        {
            var unlocked = RoomUnlocked(workshop.layout, workshop.puzzle, room);
            Label(unlocked ? "LATCH OPEN" : "LATCHED", topLeft + float2(lens.size.x - 135, 21), 10, unlocked ? TEAL : AMBER, Anchor.MiddleRight);
        }
    }
}

[Stage(ArtStage.Board)]
view Workbench(Workshop workshop, Rooms.Lobby lobby, Hands hands, mut Picture picture)
{
    Draw.SetScreen();
    var dt = Math.Min(Frame.dt, 0.08);
    picture.clock += dt;
    if (picture.clock > 1000) picture.clock -= 1000;
    if (workshop.puzzle.solved && !picture.solved) picture.celebration = 0;
    picture.solved = workshop.puzzle.solved;
    if (picture.solved) picture.celebration += dt;
    var first = !picture.ready;
    var levelChanged = picture.level != workshop.level;
    var changed = levelChanged || picture.serial != workshop.serial;
    var snap = first || changed || hands.reduceMotion;
    var blend = snap ? 1.0 : Math.Min(1, dt * 20);
    for (var seat = 0; seat < 2; seat++)
    {
        var actor = workshop.puzzle.actors[seat];
        picture.actors[seat] = SmoothCell(picture.actors[seat], float2(actor.position), snap || actor.room != picture.actorRoom[seat] ? 1.0 : blend);
        picture.actorRoom[seat] = actor.room;
    }
    for (var room = 0; room < workshop.layout.roomCount; room++)
    {
        var shell = workshop.puzzle.rooms[room];
        picture.rooms[room] = SmoothCell(picture.rooms[room], float2(shell.position), snap || shell.room != picture.roomParent[room] ? 1.0 : blend);
        picture.roomParent[room] = shell.room;
    }
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
    {
        var cargo = workshop.puzzle.crates[crate];
        picture.crates[crate] = SmoothCell(picture.crates[crate], float2(cargo.position), snap || cargo.room != picture.cargoRoom[crate] ? 1.0 : blend);
        picture.cargoRoom[crate] = cargo.room;
    }
    picture.ready = true;
    picture.level = workshop.level;
    picture.serial = workshop.serial;
    var screen = float2(Screen.width, Screen.height);
    var narrow = screen.x < 720;
    var compact = screen.x < 1050;
    var width = Math.Min(screen.x - 36, 1180);
    var left = (screen.x - width) * 0.5;
    Label("inside out", float2(left, 37), narrow ? 29.0 : 36.0, INK);
    if (!compact) Label("rooms within rooms. a way together.", float2(left, 66), 14, MUTED);
    if (workshop.initialized)
    {
        var progress = float2(compact ? left : left + 255, compact ? 133 : 37);
        Label($"{workshop.level + 1:D2} / {LEVEL_COUNT}   {LevelName(workshop.level)}", progress, compact ? 13.0 : 18.0, INK);
        if (!compact) Paragraph(LevelLesson(workshop.level), progress + float2(0, 30), width - 440, 13, MUTED);
    }
    if (!workshop.initialized || lobby.page != Rooms.Page.Playing) return;
    var localSeat = hands.seat >= 0 && hands.seat < 2 ? hands.seat : 0;
    var actor = workshop.puzzle.actors[localSeat];
    var surround = ReturnSurround(workshop, actor, picture);
    var outside = actor.room < 0 ? 0 : OutsideMakers(workshop, surround, localSeat);
    var target = FocusLens(screen, workshop, actor, surround, picture, localSeat);
    var firstView = picture.focusRoom == -2;
    var resized = picture.cameraLens.size.x != target.size.x || picture.cameraLens.size.y != target.size.y || picture.cameraLens.center.y != target.center.y;
    var crossing = actor.room != picture.focusRoom || surround.room != picture.focusParent ||
        surround.shell != picture.focusShell || surround.portal != picture.focusPortal || actor.depth != picture.focusDepth || outside != picture.focusOutside;
    var transitioning = picture.cameraBlend < 1;
    if (firstView || levelChanged || resized || hands.reduceMotion)
    {
        picture.cameraFrom = target;
        picture.cameraLens = target;
        picture.cameraBlend = 1;
    }
    else if (crossing)
    {
        mut var source = picture.cameraLens;
        if (actor.depth > picture.focusDepth && surround.room == picture.focusRoom)
            source = InteriorLens(source, surround.anchor);
        else if (actor.depth < picture.focusDepth)
        {
            mut var oldRoom = picture.cameraActor.room;
            for (var layer = 0; layer < MAX_DEPTH && oldRoom >= 0; layer++)
            {
                var previous = layer == 0 ? picture.cameraSurround : AncestorSurround(workshop, picture.cameraActor, oldRoom, layer, picture);
                source = ContainingLens(source, previous);
                oldRoom = previous.room;
                if (oldRoom == actor.room && picture.cameraActor.depth - layer - 1 <= actor.depth) break;
            }
        }
        picture.cameraFrom = source;
        picture.cameraLens = source;
        picture.cameraBlend = 0;
    }
    else picture.cameraBlend = Math.Min(1, picture.cameraBlend + dt / 0.55);
    picture.focusRoom = actor.room;
    picture.focusParent = surround.room;
    picture.focusShell = surround.shell;
    picture.focusPortal = surround.portal;
    picture.focusDepth = actor.depth;
    picture.focusOutside = outside;
    var eased = picture.cameraBlend * picture.cameraBlend * (3 - 2 * picture.cameraBlend);
    if (picture.cameraBlend < 1) picture.cameraLens = BlendLens(picture.cameraFrom, target, eased);
    else
    {
        var close = Math.Abs(picture.cameraLens.tile - target.tile) < 0.01 &&
            Math.Abs(picture.cameraLens.origin.x - target.origin.x) < 0.10 && Math.Abs(picture.cameraLens.origin.y - target.origin.y) < 0.10;
        picture.cameraLens = BlendLens(picture.cameraLens, target,
            hands.reduceMotion || firstView || levelChanged || resized || transitioning || close ? 1.0 : Math.Min(1, dt * 9));
    }
    picture.cameraActor = actor;
    picture.cameraSurround = surround;
    var lens = picture.cameraLens;
    DimensionFrame(workshop, actor.room, lens, surround, actor.depth);
    var topLeft = lens.center - lens.size * 0.5;
    var body = Rect(topLeft.x + 12, topLeft.y + 40, lens.size.x - 24, lens.size.y - 62);
    Draw.Clip(body)
    {
        Draw.RoundRect(lens.center + float2(0, 9), lens.size - float2(24, 62), 7, Color(0.88, 0.84, 0.73));
        mut MapLens[4] contexts = default;
        mut RoomSurround[3] ancestors = default;
        mut int[4] dimensions = default;
        contexts[0] = lens;
        dimensions[0] = actor.room;
        mut var contextCount = 1;
        for (var layer = 0; layer < 3 && dimensions[layer] >= 0; layer++)
        {
            ancestors[layer] = AncestorSurround(workshop, actor, dimensions[layer], layer, picture);
            dimensions[layer + 1] = ancestors[layer].room;
            contexts[layer + 1] = ContainingLens(contexts[layer], ancestors[layer]);
            contextCount++;
        }
        for (var layer = contextCount - 1; layer >= 0; layer--)
        {
            var reference = layer < contextCount - 1 && ancestors[layer].reference;
            var hiddenShell = layer > 0 ? ancestors[layer - 1].shell : -1;
            var hiddenPortal = layer > 0 ? ancestors[layer - 1].portal : -1;
            RoomScene(workshop, dimensions[layer], contexts[layer], picture, hands, reference, hiddenShell, hiddenPortal);
        }
        if (workshop.puzzle.solved && picture.celebration < 2 && !hands.reduceMotion)
        {
            var gridWidth = lens.tile * RoomSize(actor.room);
            var gridLeft = lens.origin.x - lens.tile * 0.5;
            var gridTop = lens.origin.y - lens.tile * 0.5;
            Draw.Clip(Rect(gridLeft, gridTop, gridWidth, gridWidth))
            {
                for (var spark = 0; spark < 22; spark++)
                {
                    var fall = picture.celebration * 85;
                    var at = float2(gridLeft + (spark * 47 + 29) % int(gridWidth), Math.Max(gridTop + 6, topLeft.y + 65) + fall + (spark * 31) % 80);
                    Draw.Rect(at, float2(4, 7), picture.clock + spark, spark % 2 == 0 ? AMBER : TEAL);
                }
            }
        }
    }
}
