local singleton Picture
{
    bool ready;
    int level = -1;
    int serial = -1;
    float2[2] actors;
    int[2] actorRoom;
    float[2] actorScale;
    int[2] actorFacing;
    float[2] actorStride;
    float[2] actorWobble;
    float[2] actorIdle;
    Traveler[2] travelers;
    MakerPassage[2] passages;
    bool[2] doorwayPending;
    int[2] doorwayDirection;
    Traveler[2] doorwaySource;
    float2[8] boxes;
    int[8] boxParent;
    float2[8] crates;
    int[8] cargoRoom;
    float clock;
    float celebration;
    bool solved;
    int focusRoom = -2;
    int focusParent = -2;
    int focusBox = -2;
    int focusDepth = -1;
    float cameraBlend = 1;
    bool cameraOutward;
    bool cameraBridge;
    MapLens cameraLens;
    MapLens cameraFrom;
    RoomSurround cameraSurround;
    Traveler cameraActor;
}

local event(PuzzleCue cue) RememberDoorway(mut Picture picture)
{
    if (cue.kind == 3 || cue.kind == 4)
    {
        picture.doorwayPending[0] = false;
        picture.doorwayPending[1] = false;
    }
    if (cue.kind != 2 || cue.seat < 0 || cue.seat > 1 || cue.direction < 0 || cue.direction > 3) return;
    picture.doorwayPending[cue.seat] = true;
    picture.doorwayDirection[cue.seat] = cue.direction;
    picture.doorwaySource[cue.seat] = cue.source;
}

Color RoomColor(int room)
{
    // Test-rig paints, bold enough to tell apart when a box is tiny.
    if (room == 0) return Color(0.36, 0.55, 0.42);
    if (room == 1) return Color(0.27, 0.48, 0.76);
    if (room == 2) return Color(0.60, 0.40, 0.72);
    return Color(0.82, 0.36, 0.34);
}
string RoomName(int room)
{
    if (room == 0) return "Box 1";
    if (room == 1) return "Box 2";
    if (room == 2) return "Box 3";
    if (room == 3) return "Box 4";
    return "Outer room";
}

void BoxMark(mut Sculpture sculpture, float2 at, float size, Color tone, float floor, float scale)
{
    var stroke = Math.Max(.5, size * .075);
    FloorOutline(sculpture, at, float2(size), stroke, tone, floor, scale);
    FloorLine(sculpture, at - float2(size * .30), at + float2(size * .30), stroke, tone, floor, scale);
    FloorLine(sculpture, at + float2(-size * .30, size * .30), at + float2(size * .30, -size * .30), stroke, tone, floor, scale);
}

void PlayerMark(mut Sculpture sculpture, float2 at, float size, Color tone, float floor, float scale)
{
    Cuboid(sculpture, at - float2(0, size * .25), float2(size * .32), scale * .008, tone, floor, scale);
    Cuboid(sculpture, at + float2(0, size * .20), float2(size * .60, size * .46), scale * .008, tone, floor, scale);
}

void Crate(mut Sculpture sculpture, float2 at, float size, bool onTarget, float floor)
{
    var side = size * .72;
    var height = size * .36;
    var wood = onTarget ? Color(.59, .64, .36) : Color(.68, .62, .39);
    Cuboid(sculpture, at, float2(side), height, Color(.30, .31, .20), floor, size);
    Cuboid(sculpture, at, float2(side * .89), height * .12, wood, floor + height, size);
    var top = floor + height * 1.12 + size * .003;
    BoxMark(sculpture, at, side * .71, Color(.27, .27, .15), top, size);
    FloorLine(sculpture, at + float2(-side * .44, side * .40), at + float2(side * .44, side * .40), size * .033, Color(.76, .72, .45), top, size);
    FloorLine(sculpture, at + float2(-side * .44, -side * .40), at + float2(side * .44, -side * .40), size * .033, Color(.76, .72, .45), top, size);
}

// How a seat's bot stands this frame. At rest it is always the same picture:
// facing the camera, on the floor, antenna still.
struct BotPose { int facing = 2; float lift; float sway; }
BotPose PoseOf(Picture picture, int seat)
{
    return BotPose { facing = picture.actorFacing[seat],
        lift = Math.Abs(Math.Sin(picture.actorStride[seat] * Math.TAU)) * .09,
        sway = Math.Sin(picture.clock * 22) * picture.actorWobble[seat] };
}

// A little test rig on treads in its seat's paint: a visor that looks where
// it is going, a bumper to push with, the yellow and black calibration mark
// on its head, and an antenna that whips about while it moves. It hops as
// it rolls. `across` and `along` are sizes to its right and ahead of it.
void BotPart(mut Sculpture sculpture, float2 at, int facing, float2 offset, float across, float along, float height, Color tone, float floor, float size)
{
    var ahead = float2(Direction(facing));
    var right = float2(-ahead.y, ahead.x);
    Cuboid(sculpture, at + (right * offset.x + ahead * offset.y) * size,
        facing % 2 == 0 ? float2(across * size, along * size) : float2(along * size, across * size), height * size, tone, floor, size);
}
void Maker(mut Sculpture sculpture, float2 at, float size, int seat, float floor, BotPose pose)
{
    var tone = seat == 0 ? AMBER : TEAL;
    var up = floor + pose.lift * size;
    BotPart(sculpture, at, pose.facing, float2(-.21, 0), .11, .42, .11, RUBBER, floor + pose.lift * size * .35, size);
    BotPart(sculpture, at, pose.facing, float2(.21, 0), .11, .42, .11, RUBBER, floor + pose.lift * size * .35, size);
    BotPart(sculpture, at, pose.facing, float2(0, 0), .36, .36, .23, tone, up + size * .07, size);
    BotPart(sculpture, at, pose.facing, float2(0, .215), .30, .05, .07, RUBBER, up + size * .09, size);
    BotPart(sculpture, at, pose.facing, float2(0, -.02), .25, .22, .15, DECAL, up + size * .30, size);
    BotPart(sculpture, at, pose.facing, float2(0, .10), .21, .03, .07, RUBBER, up + size * .345, size);
    BotPart(sculpture, at, pose.facing, float2(.045, .112), .06, .03, .04, HAZARD, up + size * .36, size);
    BotPart(sculpture, at, pose.facing, float2(0, -.02), .16, .16, .008, HAZARD, up + size * .45, size);
    BotPart(sculpture, at, pose.facing, float2(-.04, -.06), .08, .08, .006, RUBBER, up + size * .458, size);
    BotPart(sculpture, at, pose.facing, float2(.04, .02), .08, .08, .006, RUBBER, up + size * .458, size);
    BotPart(sculpture, at, pose.facing, float2(-.10, -.11), .025, .025, .15, RUBBER, up + size * .45, size);
    BotPart(sculpture, at, pose.facing, float2(-.10 + pose.sway * .05, -.11), .06, .06, .05, tone, up + size * .60, size);
}

void GoldTarget(mut Sculpture sculpture, float2 at, float size, bool occupied, float floor)
{
    var tone = occupied ? Color(.40, .68, .38) : HAZARD;
    var top = floor + size * .009;
    FloorOutline(sculpture, at, float2(size * .79), Math.Max(.9, size * .027), tone, top, size);
    BoxMark(sculpture, at, size * .42, tone, top, size);
}

void TilePaint(mut Sculpture sculpture, Tile tile, float2 at, float size, bool occupied, int variation, float floor)
{
    // One pale lab floor: cells meet without a joint, and only a faint
    // change of shade from one to the next keeps them countable.
    var tone = variation % 2 == 0 ? Color(.90, .90, .87) : Color(.875, .875, .845);
    var thickness = Math.Max(.08, size * .010);
    Cuboid(sculpture, at, float2(size), thickness, Color(.55, .57, .60), floor - thickness, size);
    sculpture.detail = 1;
    Cuboid(sculpture, at, float2(size), thickness * .24, tone, floor, size);
    sculpture.detail = 0;
    if (tile == Tile.Target) GoldTarget(sculpture, at, size, occupied, floor + thickness * .25);
    else if (tile == Tile.Exit)
    {
        var top = floor + size * .006;
        Cuboid(sculpture, at, float2(size * .82), size * .003, Color(.22, .40, .30), top, size);
        FloorOutline(sculpture, at, float2(size * .72), Math.Max(.8, size * .025), Color(.48, .74, .48), top + size * .004, size);
        PlayerMark(sculpture, at, size * .56, Color(.80, .85, .74), top + size * .004, size);
    }
}

// Yellow and black blocks in turn along a raised edge.
void HazardEdge(mut Sculpture sculpture, float2 from, float2 to, float width, float floor, float tile, float stripe = .25)
{
    var length = Math.Max(Math.Abs(to.x - from.x), Math.Abs(to.y - from.y));
    var count = tile < 8 ? 1 : Math.Clamp(int(Math.Round(length / (tile * stripe))), 1, 32);
    var step = (to - from) / count;
    var across = Math.Abs(step.x) > Math.Abs(step.y) ? float2(Math.Abs(step.x), width) : float2(width, Math.Abs(step.y));
    for (var index = 0; index < count; index++)
        Cuboid(sculpture, from + step * (index + .5), across, tile * .006, index % 2 == 0 ? HAZARD : RUBBER, floor, tile);
}

// Wall cells that touch are one block in the container's paint: the darker
// rim runs only along its open sides, and the raised face carries across
// from cell to cell. `joined` has a bit for each side with wall beyond it.
void WallTile(mut Sculpture sculpture, float2 at, float size, Color tone, float floor, int joined)
{
    var height = size * .31;
    Cuboid(sculpture, at, float2(size), height, Math.Lerp(tone, RUBBER, .40), floor, size);
    Cuboid(sculpture, at, float2(size), size * .018, Color(tone.r * .84, tone.g * .84, tone.b * .84), floor + height, size);
    if (size <= 9) return;
    var north = (joined & 1) != 0 ? -.5 : -.39;
    var east = (joined & 2) != 0 ? .5 : .39;
    var south = (joined & 4) != 0 ? .5 : .39;
    var west = (joined & 8) != 0 ? -.5 : -.39;
    sculpture.detail = 2;
    Cuboid(sculpture, at + float2((west + east) * .5, (north + south) * .5) * size, float2(east - west, south - north) * size,
        size * .003, tone, floor + height + size * .018, size);
    sculpture.detail = 0;
}

[Stage(ArtStage.Backdrop)]
view WorkshopBackdrop()
{
    Draw.SetScreen();
    Draw.Clear(Color(0.065, 0.07, 0.078));
    var screen = float2(Screen.width, Screen.height);
    for (var i = 0; i < 14; i++)
    {
        var y = i * screen.y / 13;
        Draw.Line(float2(0, y), float2(screen.x, y), 1, Color(0.45, 0.47, 0.50, 0.07));
    }
    Draw.Rect(float2(screen.x * 0.5, 0), float2(screen.x * 0.54, 3), Color(0.80, 0.84, 0.80, 0.30));
}

// A dark plate behind words that lie over the scene.
void Chip(float2 at, float2 size)
{
    Draw.Rect(at, size, PAPER);
    Draw.WireRoundRect(at, size, 0, 1, Color(0.36, 0.38, 0.40));
}

void DimensionFloor(mut Sculpture sculpture, Workshop workshop, int room, MapLens lens)
{
    var tone = room < 0 ? Color(0.66, 0.68, 0.71) : RoomColor(room);
    for (var y = 0; y < RoomHeight(workshop.layout, room); y++)
        for (var x = 0; x < RoomWidth(workshop.layout, room); x++)
        {
            var position = int2(x, y);
            var tile = TileAt(workshop.layout, room, position);
            var at = MapPoint(float2(position), lens);
            if (!InPlayfield(at, lens.tile * 1.10, lens)) continue;
            var occupied = CargoAt(workshop.layout, workshop.puzzle, room, position) >= 0;
            if (tile == Tile.Wall)
            {
                // Beyond the room's edge counts as wall: the block runs up to it.
                mut var joined = 0;
                for (var side = 0; side < 4; side++)
                    if (TileAt(workshop.layout, room, position + Direction(side)) == Tile.Wall) joined |= 1 << side;
                WallTile(sculpture, at, lens.tile, tone, lens.floor, joined);
            }
            else
            {
                // The floor's flecks run on from cell to cell.
                sculpture.detailOrigin = float2(x, y) * 8;
                TilePaint(sculpture, tile, at, lens.tile, occupied, x + y, lens.floor);
            }
        }
    for (var shell = 0; shell < workshop.layout.roomCount; shell++)
    {
        var layout = workshop.layout.rooms[shell];
        if (layout.dockRoom != room || layout.dock.x < 0) continue;
        // A box standing on its outline hides it: none of it shows through a doorway.
        var parked = workshop.puzzle.rooms[shell];
        if (parked.room == room && CellEqual(parked.position, layout.dock)) continue;
        var here = MapPoint(float2(layout.dock), lens);
        FloorOutline(sculpture, here, float2(lens.tile * .91), Math.Max(.8, lens.tile * .028), RoomColor(shell), lens.floor + lens.tile * .014, lens.tile);
        if (lens.tile > 18) FloorNumber(sculpture, shell + 1, false, here + float2(lens.tile * .31, -lens.tile * .30), lens.tile * .17, RUBBER, lens.floor + lens.tile * .014, lens.tile);
    }
}

void DimensionConnections(mut Sculpture sculpture, Workshop workshop, int room, MapLens lens, Picture picture)
{
    for (var box = 0; box < 8; box++)
    {
        if (!ValidBox(workshop.layout, box)) continue;
        var placement = BoxPlacement(workshop.layout, workshop.puzzle, box);
        if (placement.room != room) continue;
        var child = BoxDestination(workshop.layout, box);
        for (var direction = 0; direction < 4; direction++)
        {
            if ((workshop.layout.rooms[child].doors & (1 << direction)) == 0) continue;
            var neighbor = BoxAt(workshop.layout, workshop.puzzle, room, placement.position + Direction(direction));
            if (neighbor <= box) continue;
            var other = BoxDestination(workshop.layout, neighbor);
            // Only doorways that face each other are a passage.
            if (!DoorsMeet(workshop.layout, child, direction, other)) continue;
            var from = MapPoint(picture.boxes[box] + DoorLip(workshop.layout, child, direction), lens);
            var to = MapPoint(picture.boxes[neighbor] + DoorLip(workshop.layout, other, (direction + 2) % 4), lens);
            var middle = (from + to) * 0.5;
            var first = direction % 2 == 0 ? float2(from.x, middle.y) : float2(middle.x, from.y);
            var second = direction % 2 == 0 ? float2(to.x, middle.y) : float2(middle.x, to.y);
            var stroke = Math.Min(RoomScale(workshop.layout, child), RoomScale(workshop.layout, other)) * lens.tile * 0.82;
            var floor = Color(0.90, 0.90, 0.87);
            FloorLine(sculpture, from, first, stroke, floor, lens.floor + lens.tile * .012, lens.tile);
            FloorLine(sculpture, first, second, stroke, floor, lens.floor + lens.tile * .012, lens.tile);
            FloorLine(sculpture, second, to, stroke, floor, lens.floor + lens.tile * .012, lens.tile);
        }
    }
}

void DimensionPieces(mut Sculpture sculpture, Workshop workshop, int room, MapLens lens, Picture picture, Hands hands)
{
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
        if (workshop.puzzle.crates[crate].active && workshop.puzzle.crates[crate].room == room)
            Crate(sculpture, MapPoint(picture.crates[crate], lens), lens.tile, TileAt(workshop.layout, room, workshop.puzzle.crates[crate].position) == Tile.Target, lens.floor + lens.tile * .004);
    for (var seat = 0; seat < 2; seat++)
        if (workshop.present[seat])
        {
            var trip = picture.passages[seat];
            if (trip.active)
            {
                if (room == trip.child && trip.aliasAlpha > 0)
                {
                    sculpture.alpha = trip.aliasAlpha;
                    Maker(sculpture, MapPoint(trip.aliasPosition, lens), lens.tile * .90, seat, lens.floor + lens.tile * .004, PoseOf(picture, seat));
                    sculpture.alpha = 1;
                }
                continue;
            }
            if (workshop.puzzle.actors[seat].room != room) continue;
            mut var at = MapPoint(picture.actors[seat], lens);
            if (seat == hands.seat && hands.blockTime > 0)
            {
                FloorOutline(sculpture, at, float2(lens.tile * .88), Math.Max(.8, lens.tile * .035), Color(.82, .43, .26, hands.blockTime * 4), lens.floor + lens.tile * .020, lens.tile);
                if (!hands.reduceMotion) at.x += Math.Sin(hands.blockTime * 70) * lens.tile * 0.025;
            }
            if (seat == hands.seat && hands.portalTime > 0)
                FloorOutline(sculpture, at, float2(lens.tile * .92), Math.Max(.8, lens.tile * .025), Color(.33, .61, .54, hands.portalTime * 1.8), lens.floor + lens.tile * .015, lens.tile);
            Maker(sculpture, at, lens.tile * .90, seat, lens.floor + lens.tile * .004, PoseOf(picture, seat));
        }
}

// The same aperture mask is used by colour, depth and the shadow pass.
// Its ground-plane test admits the approaching body only through the gap.
void DoorwayMaker(mut Sculpture sculpture, LevelLayout layout, MakerPassage trip, Picture picture, MapLens parent, int seat)
{
    var at = MapPoint(trip.position, parent);
    var size = parent.tile * trip.scale * .90;
    var mouth = MapPoint(PassageAnchor(trip.gate, picture) + trip.lip, parent);
    var scale = RoomScale(layout, trip.child);
    var gap = parent.tile * scale * .82;
    var nested = Math.Clamp((1 - trip.scale) / Math.Max(.001, 1 - scale), 0, 1);
    var floor = parent.floor + parent.tile * .018 * nested;
    sculpture.ground = floor;
    sculpture.aperture = float4(mouth.x, mouth.y, gap * .5, 0);
    sculpture.apertureSide = trip.side;
    Maker(sculpture, at, size, seat, floor + size * .004, PoseOf(picture, seat));
    sculpture.apertureSide = -1;
}

void PassageMaker(mut Sculpture sculpture, Workshop workshop, Picture picture, Hands hands, int seat, MapLens[4] contexts, int[4] dimensions, int contextCount)
{
    var trip = picture.passages[seat];
    if (!trip.active || !workshop.present[seat]) return;
    mut var parent = contexts[0];
    mut var found = false;
    if (seat == hands.seat)
    {
        if (trip.entering) parent = ContainingLens(workshop.layout, trip.child, parent, RoomSurround { anchor = PassageAnchor(trip.gate, picture) });
        found = true;
    }
    else
    {
        for (var layer = 0; layer < contextCount; layer++)
            if (!found && dimensions[layer] == trip.gate.room)
            {
                parent = contexts[layer];
                found = true;
            }
        if (!found && dimensions[0] == trip.child)
        {
            parent = ContainingLens(workshop.layout, trip.child, parent, RoomSurround { anchor = PassageAnchor(trip.gate, picture) });
            found = true;
        }
    }
    if (!found)
    {
        // Locate a visible nested containing room with the same finite bounds
        // used for miniature artwork. This also covers a partner in a sibling.
        mut SceneLens[48] pending = default;
        pending[0] = SceneLens { room = dimensions[0], lens = contexts[0] };
        mut var count = 1;
        for (var index = 0; index < count && !found; index++)
        {
            var item = pending[index];
            if (item.room == trip.gate.room)
            {
                parent = item.lens;
                found = true;
                break;
            }
            if (item.depth >= 3) continue;
            for (var box = 0; box < 8 && count < 48; box++)
                if (ValidBox(workshop.layout, box) && BoxPlacement(workshop.layout, workshop.puzzle, box).room == item.room)
                {
                    var child = BoxDestination(workshop.layout, box);
                    pending[count] = SceneLens { room = child, lens = InteriorLens(workshop.layout, child, item.lens, picture.boxes[box]), depth = item.depth + 1 };
                    count++;
                }
        }
    }
    if (found)
    {
        sculpture.alpha = 1 - trip.aliasAlpha;
        DoorwayMaker(sculpture, workshop.layout, trip, picture, parent, seat);
        sculpture.alpha = 1;
    }
}

void WallStrip(mut Sculpture sculpture, float2 from, float2 to, float thickness, Color tone, float floor, float tile, bool hazard)
{
    mut var size = float2(Math.Abs(to.x - from.x), Math.Abs(to.y - from.y));
    if (size.x < 0.001 && size.y < 0.001) return;
    if (size.x < 0.001) size.x = thickness;
    if (size.y < 0.001) size.y = thickness;
    var height = tile * .30;
    Cuboid(sculpture, (from + to) * .5, size, height, tone, floor, tile);
    if (hazard)
    {
        // The hall's own walls carry warning stripes along their length.
        var middle = (from + to) * .5;
        var half = size.x > size.y ? float2(size.x * .5, 0) : float2(0, size.y * .5);
        HazardEdge(sculpture, middle - half, middle + half, thickness * .55, floor + height, tile);
        return;
    }
    var highlight = size.x > size.y ? float2(size.x, thickness * 0.18) : float2(thickness * 0.18, size.y);
    Cuboid(sculpture, (from + to) * .5, highlight, tile * .004, Math.Lerp(tone, Color(.86, .87, .84), .35), floor + height, tile);
}

// The walls sit inside the exact room footprint. A doorway removes a section
// of that wall rather than painting a door symbol over a closed frame.
void RoomWalls(mut Sculpture sculpture, LevelLayout layout, int room, MapLens lens)
{
    var dims = RoomDimensions(layout, room);
    var low = lens.origin - float2(lens.tile * 0.5);
    var high = low + dims * lens.tile;
    var thickness = lens.tile * 0.11;
    var tone = room < 0 ? STEEL : RoomColor(room);
    for (var side = 0; side < 4; side++)
    {
        var horizontal = side % 2 == 0;
        var normal = float2(Direction(side));
        mut var first = side == 0 ? low : side == 1 ? float2(high.x, low.y) : side == 2 ? float2(low.x, high.y) : low;
        mut var last = horizontal ? first + float2(dims.x * lens.tile, 0) : first + float2(0, dims.y * lens.tile);
        // Inset the stroke by half its thickness; no trim protrudes into a
        // neighbor's grid cell or changes a miniature's physical footprint.
        first -= normal * thickness * 0.5;
        last -= normal * thickness * 0.5;
        var cell = DoorCell(layout, room, side);
        var open = room >= 0 && (layout.rooms[room].doors & (1 << side)) != 0 && OnRoomGrid(layout, room, cell);
        if (open)
        {
            var mouth = MapPoint(float2(cell), lens) + normal * (lens.tile - thickness) * 0.5;
            var tangent = horizontal ? float2(1, 0) : float2(0, 1);
            var start = mouth - tangent * lens.tile * 0.41;
            var end = mouth + tangent * lens.tile * 0.41;
            WallStrip(sculpture, first, start, thickness, tone, lens.floor, lens.tile, room < 0);
            WallStrip(sculpture, end, last, thickness, tone, lens.floor, lens.tile, room < 0);
            // Short yellow posts make the depth of the opening visible. The
            // floor remains continuous all the way through the missing wall.
            var jambSize = horizontal ? float2(thickness * 0.35, thickness) : float2(thickness, thickness * 0.35);
            Cuboid(sculpture, start - normal * thickness * .5, jambSize, lens.tile * .32, HAZARD, lens.floor, lens.tile);
            Cuboid(sculpture, end - normal * thickness * .5, jambSize, lens.tile * .32, HAZARD, lens.floor, lens.tile);
        }
        else WallStrip(sculpture, first, last, thickness, tone, lens.floor, lens.tile, room < 0);
    }
}

void RoomTrim(mut Sculpture sculpture, LevelLayout layout, int room, MapLens lens, int box)
{
    RoomWalls(sculpture, layout, room, lens);
    if (room < 0 || lens.tile < 3) return;
    var badge = lens.origin + float2(lens.tile * 0.12, lens.tile * 0.12);
    FloorNumber(sculpture, room + 1, box >= MAX_ROOMS, badge, Math.Max(3, lens.tile * .30), DECAL, lens.floor + lens.tile * .015, lens.tile);
}

struct SceneLens { int room; MapLens lens; int depth; int box = -1; }

// Full rooms and miniatures share every geometric primitive. Drawing is finite
// even when a doorway refers to its own canonical room.
void RoomScene(mut Sculpture sculpture, Workshop workshop, int room, MapLens lens, Picture picture, Hands hands, int hideBox = -1, int instance = -1)
{
    mut SceneLens[48] pending = default;
    pending[0] = SceneLens { room = room, lens = lens, box = instance };
    mut var count = 1;
    for (var index = 0; index < count && index < 48; index++)
    {
        var item = pending[index];
        var dims = RoomDimensions(workshop.layout, item.room);
        var center = MapPoint(RoomCenter(workshop.layout, item.room), item.lens);
        if (!InPlayfield(center, Math.Max(dims.x, dims.y) * item.lens.tile, lens)) continue;
        sculpture.ground = item.lens.floor;
        DimensionFloor(sculpture, workshop, item.room, item.lens);
        DimensionConnections(sculpture, workshop, item.room, item.lens, picture);
        DimensionPieces(sculpture, workshop, item.room, item.lens, picture, hands);
        RoomTrim(sculpture, workshop.layout, item.room, item.lens, item.box);
        for (var box = 0; box < 8; box++)
        {
            if (!ValidBox(workshop.layout, box) || BoxPlacement(workshop.layout, workshop.puzzle, box).room != item.room || (index == 0 && box == hideBox)) continue;
            var child = BoxDestination(workshop.layout, box);
            var interior = InteriorLens(workshop.layout, child, item.lens, picture.boxes[box]);
            if (item.depth < 3 && count < 48 && interior.tile >= 0.65)
            {
                pending[count] = SceneLens { room = child, lens = interior, depth = item.depth + 1, box = box };
                count++;
            }
            else
            {
                sculpture.ground = interior.floor;
                Cuboid(sculpture, MapPoint(picture.boxes[box], item.lens), float2(item.lens.tile), interior.tile * .20, RoomColor(child), interior.floor, interior.tile);
                sculpture.ground = item.lens.floor;
            }
        }
    }
}

// Where this screen's bot is, the shared move count and what lies outside,
// on plates over the scene. They are drawn after the scene's composite.
[Stage(ArtStage.Board, 2)]
view WorkbenchLabels(Workshop workshop, Rooms.Lobby lobby, Picture picture)
{
    if (!workshop.initialized || lobby.page != Rooms.Page.Playing || picture.focusRoom == -2) return;
    Draw.SetScreen();
    var lens = picture.cameraLens;
    var room = picture.cameraActor.room;
    var topLeft = lens.center - lens.size * 0.5;
    var narrow = Screen.width < 720;
    Chip(topLeft + float2(136, 20), float2(256, 32));
    if (room < 0)
        Label("OUTER ROOM", topLeft + float2(18, 20), Screen.width < 720 ? 11.0 : 12.0, MUTED);
    else
    {
        var tone = RoomColor(room);
        Label($"INSIDE {RoomName(room)}  /  {room + 1}", topLeft + float2(18, 20), narrow ? 11.0 : 12.0, Math.Lerp(tone, INK, 0.40));
    }
    Chip(topLeft + float2(lens.size.x - 62, 20), float2(112, 32));
    Label($"{workshop.puzzle.moves} moves", topLeft + float2(lens.size.x - 16, 21), 14, MUTED, Anchor.MiddleRight);
    // Between the buttons and the direction pad where there is room, under
    // the other two plates where not.
    var footer = Screen.width < 1050 ? float2(Screen.width * 0.5, topLeft.y + 50) : float2(Screen.width * 0.5, Screen.height - 40);
    Chip(footer, float2(Math.Min(lens.size.x, narrow ? 300.0 : 400.0), 22));
    if (room < 0)
        Label(narrow ? "Push a room. When it cannot move, walk inside." : "Rooms move first  /  A blocked room opens its doorway", footer, narrow ? 9.0 : 11.0, MUTED, Anchor.MiddleCenter);
    else
        Label($"Outside: {RoomName(picture.cameraSurround.room)}  /  box doorway  /  depth {picture.cameraActor.depth}", footer, narrow ? 9.0 : 11.0, MUTED, Anchor.MiddleCenter);
}

[Stage(ArtStage.Board)]
view Workbench(Workshop workshop, Rooms.Lobby lobby, Hands hands, mut Picture picture, mut Sculpture sculpture, mut SceneRender render)
{
    render.pending = false;
    Draw.SetScreen();
    var dt = Math.Min(Frame.dt, 0.08);
    picture.clock += dt;
    if (picture.clock > 1000) picture.clock -= 1000;
    if (workshop.puzzle.solved && !picture.solved) picture.celebration = 0;
    picture.solved = workshop.puzzle.solved;
    if (picture.solved) picture.celebration += dt;
    var first = !picture.ready;
    var levelChanged = picture.level != workshop.level;
    var changed = levelChanged || picture.serial != workshop.serial;
    var snap = first || changed || hands.reduceMotion;
    var blend = snap ? 1.0 : Math.Min(1, dt * 20);
    mut var localCycleExit = false;
    for (var box = 0; box < 8; box++)
    {
        if (!ValidBox(workshop.layout, box)) continue;
        var placement = BoxPlacement(workshop.layout, workshop.puzzle, box);
        picture.boxes[box] = SmoothCell(picture.boxes[box], float2(placement.position), snap || placement.room != picture.boxParent[box] ? 1.0 : blend);
        picture.boxParent[box] = placement.room;
    }
    for (var crate = 0; crate < workshop.layout.crateCount; crate++)
    {
        var cargo = workshop.puzzle.crates[crate];
        picture.crates[crate] = SmoothCell(picture.crates[crate], float2(cargo.position), snap || cargo.room != picture.cargoRoom[crate] ? 1.0 : blend);
        picture.cargoRoom[crate] = cargo.room;
    }
    for (var seat = 0; seat < 2; seat++)
    {
        var actor = workshop.puzzle.actors[seat];
        var before = picture.travelers[seat];
        var passageSnap = first || levelChanged || hands.reduceMotion || (changed && workshop.puzzle.moves == 0);
        var was = picture.actors[seat];
        var makerBlend = passageSnap ? 1.0 : Math.Min(1, dt * 20);
        var travel = actor.room != before.room || !SameEntrance(before, actor);
        var cueSource = picture.doorwaySource[seat];
        var cueDirection = picture.doorwayDirection[seat];
        var cueBox = cueSource.depth > 0 && cueSource.depth <= MAX_DEPTH ? cueSource.trail[cueSource.depth - 1].box : -1;
        var cuePlacement = BoxPlacement(workshop.layout, workshop.puzzle, cueBox);
        var cycleExit = picture.doorwayPending[seat] && !travel && !passageSnap &&
            cueSource.room >= 0 && cueSource.room == actor.room && SameEntrance(cueSource, actor) &&
            ValidBox(workshop.layout, cueBox) && cuePlacement.room == actor.room &&
            CellEqual(actor.position, cuePlacement.position + Direction(cueDirection)) &&
            CellEqual(cueSource.position, DoorCell(workshop.layout, cueSource.room, cueDirection)) &&
            !OnRoomGrid(workshop.layout, cueSource.room, cueSource.position + Direction(cueDirection));
        picture.doorwayPending[seat] = false;
        if (passageSnap)
        {
            picture.passages[seat] = MakerPassage { };
            picture.actors[seat] = float2(actor.position);
            picture.actorScale[seat] = 1;
        }
        else
        {
            if (travel || cycleExit) picture.passages[seat] = BeginPassage(workshop, picture, seat, cycleExit ? cueSource : before, actor, cycleExit);
            if (cycleExit && seat == (hands.seat >= 0 && hands.seat < 2 ? hands.seat : 0)) localCycleExit = true;
            mut var trip = picture.passages[seat];
            if (trip.active)
            {
                if (!travel && !cycleExit)
                {
                    trip.age += dt;
                    // Input stays responsive during the passage. Follow later
                    // inner steps continuously instead of arriving at a stale
                    // doorway cell and snapping to the latest match position.
                    trip.target = SmoothCell(trip.target, float2(actor.position), makerBlend);
                }
                PassagePose(workshop.layout, trip, picture);
                var scale = RoomScale(workshop.layout, trip.child);
                picture.actors[seat] = trip.entering ? (trip.position - PassageAnchor(trip.gate, picture)) / scale + RoomCenter(workshop.layout, trip.child) : trip.position;
                picture.actorScale[seat] = trip.entering ? trip.scale / scale : trip.scale;
                if (trip.age >= PASSAGE_SECONDS)
                {
                    picture.actors[seat] = trip.target;
                    picture.actorScale[seat] = 1;
                    trip.active = false;
                }
                picture.passages[seat] = trip;
            }
            else
            {
                picture.actors[seat] = SmoothCell(picture.actors[seat], float2(actor.position), travel ? 1.0 : makerBlend);
                picture.actorScale[seat] = 1;
            }
        }
        // The bot turns to where it goes and hops along; left alone for a
        // moment it turns back to the camera, so a settled scene depends on
        // the puzzle alone.
        var rolling = picture.passages[seat];
        var step = actor.position - before.position;
        var rolled = Math.Length(picture.actors[seat] - was);
        if (passageSnap)
        {
            picture.actorFacing[seat] = 2;
            picture.actorStride[seat] = 0;
            picture.actorWobble[seat] = 0;
            picture.actorIdle[seat] = 0;
        }
        else
        {
            if (rolling.active) picture.actorFacing[seat] = rolling.entering ? (rolling.side + 2) % 4 : rolling.side;
            else if (actor.room == before.room && (step.x != 0 || step.y != 0))
                picture.actorFacing[seat] = Math.Abs(step.x) > Math.Abs(step.y) ? (step.x > 0 ? 1 : 3) : (step.y > 0 ? 2 : 0);
            if (rolling.active || rolled > .0005)
            {
                // A step lets it look ahead for a moment after it stops; a
                // doorway passage is long enough already.
                picture.actorIdle[seat] = rolling.active ? 1.0 : 0.0;
                picture.actorStride[seat] += Math.Min(rolled, .5);
                picture.actorWobble[seat] = 1;
            }
            else
            {
                picture.actorIdle[seat] += dt;
                picture.actorWobble[seat] = 0;
                picture.actorStride[seat] = 0;
                if (picture.actorIdle[seat] > .1) picture.actorFacing[seat] = 2;
            }
        }
        picture.actorRoom[seat] = actor.room;
        picture.travelers[seat] = actor;
    }
    picture.ready = true;
    picture.level = workshop.level;
    picture.serial = workshop.serial;
    var screen = float2(Screen.width, Screen.height);
    var narrow = screen.x < 720;
    var compact = screen.x < 1050;
    var width = Math.Min(screen.x - 36, 1180);
    var left = (screen.x - width) * 0.5;
    Label("inside out", float2(left, 37), narrow ? 29.0 : 36.0, INK);
    if (!compact) Label("find a way outward.", float2(left, 66), 14, MUTED);
    if (workshop.initialized)
    {
        var progress = float2(compact ? left : left + 255, compact ? 133 : 37);
        Label($"{workshop.level + 1:D2} / {LEVEL_COUNT}   {LevelName(workshop.level)}", progress, compact ? 13.0 : 18.0, INK);
        if (!compact) Paragraph(LevelLesson(workshop.level), progress + float2(0, 30), width - 440, 13, MUTED);
    }
    if (!workshop.initialized || lobby.page != Rooms.Page.Playing) return;
    var localSeat = hands.seat >= 0 && hands.seat < 2 ? hands.seat : 0;
    var actor = workshop.puzzle.actors[localSeat];
    var surround = ReturnSurround(workshop, actor, picture);
    var target = WorkshopLens(workshop.layout, screen, actor.room);
    var firstView = picture.focusRoom == -2;
    var resized = picture.cameraLens.size.x != target.size.x || picture.cameraLens.size.y != target.size.y || picture.cameraLens.center.y != target.center.y;
    var crossing = localCycleExit || actor.room != picture.focusRoom || surround.room != picture.focusParent ||
        surround.box != picture.focusBox || actor.depth != picture.focusDepth;
    var transitioning = picture.cameraBlend < 1;
    if (firstView || levelChanged || resized || hands.reduceMotion)
    {
        picture.cameraFrom = target;
        picture.cameraLens = target;
        picture.cameraBlend = 1;
    }
    else if (crossing)
    {
        mut var source = picture.cameraLens;
        if (localCycleExit)
            source = ContainingLens(workshop.layout, actor.room, source, picture.passages[localSeat].gate);
        else if (actor.depth > picture.focusDepth && surround.room == picture.focusRoom)
            source = InteriorLens(workshop.layout, actor.room, source, surround.anchor);
        else if ((actor.room != picture.focusRoom || surround.box != picture.focusBox) &&
            surround.room == picture.cameraSurround.room && actor.room >= 0 && picture.focusRoom >= 0)
            source = InteriorLens(workshop.layout, actor.room, ContainingLens(workshop.layout, picture.focusRoom, source, picture.cameraSurround), surround.anchor);
        else if (actor.room != picture.focusRoom && picture.cameraSurround.room == actor.room && actor.depth >= picture.focusDepth)
            source = ContainingLens(workshop.layout, picture.focusRoom, source, picture.cameraSurround);
        else if (actor.depth < picture.focusDepth)
        {
            mut var oldRoom = picture.cameraActor.room;
            for (var layer = 0; layer < MAX_DEPTH && oldRoom >= 0; layer++)
            {
                var previous = layer == 0 ? picture.cameraSurround : AncestorSurround(workshop, picture.cameraActor, oldRoom, layer, picture);
                source = ContainingLens(workshop.layout, oldRoom, source, previous);
                oldRoom = previous.room;
                if (oldRoom == actor.room && picture.cameraActor.depth - layer - 1 <= actor.depth) break;
            }
        }
        picture.cameraFrom = source;
        picture.cameraLens = source;
        picture.cameraBlend = 0;
        var trip = picture.passages[localSeat];
        picture.cameraOutward = trip.active ? !trip.entering : actor.depth < picture.focusDepth;
        picture.cameraBridge = trip.active && (trip.bridge || trip.sourceInside == trip.entering);
    }
    else picture.cameraBlend = Math.Min(1, picture.cameraBlend + dt / PASSAGE_SECONDS);
    picture.focusRoom = actor.room;
    picture.focusParent = surround.room;
    picture.focusBox = surround.box;
    picture.focusDepth = actor.depth;
    // Camera and maker cross the same opening on one finite clock. The
    // containing world stays still while the maker approaches its threshold.
    var eased = picture.cameraBridge ? PassageEase(picture.cameraBlend) : picture.cameraOutward ?
        1 - PassageEase((1 - picture.cameraBlend - 0.35) / 0.65) : PassageEase((picture.cameraBlend - 0.35) / 0.65);
    if (picture.cameraBlend < 1) picture.cameraLens = BlendLens(picture.cameraFrom, target, eased);
    else
    {
        var close = Math.Abs(picture.cameraLens.tile - target.tile) < 0.01 &&
            Math.Abs(picture.cameraLens.origin.x - target.origin.x) < 0.10 && Math.Abs(picture.cameraLens.origin.y - target.origin.y) < 0.10;
        picture.cameraLens = BlendLens(picture.cameraLens, target,
            hands.reduceMotion || firstView || levelChanged || resized || transitioning || close ? 1.0 : Math.Min(1, dt * 9));
    }
    picture.cameraActor = actor;
    picture.cameraSurround = surround;
    var lens = picture.cameraLens;
    // The scene fills the window below the heading; the room keeps its
    // place and size in it, and the controls lie over what surrounds it.
    var sceneTop = SceneTop(screen);
    var region = Rect(0, sceneTop, screen.x, screen.y - sceneTop);
    Draw.Rect(float2(screen.x * .5, sceneTop + region.height * .5), float2(region.width, region.height), Color(0.27, 0.30, 0.34));
    var blocks = int(screen.x / 14);
    for (var index = 0; index < blocks; index += 2)
        Draw.Rect(float2((index + .5) * screen.x / blocks, sceneTop - 2), float2(screen.x / blocks, 3), Color(HAZARD.r, HAZARD.g, HAZARD.b, 0.75));
    var viewCenter = SceneCenter(screen);
    Draw.Clip(region)
    {
        BeginSculpture(sculpture, lens.tile, region);
        mut MapLens[4] contexts = default;
        mut RoomSurround[3] ancestors = default;
        mut int[4] dimensions = default;
        contexts[0] = lens;
        dimensions[0] = actor.room;
        mut var contextCount = 1;
        for (var layer = 0; layer < 3 && dimensions[layer] >= 0; layer++)
        {
            ancestors[layer] = AncestorSurround(workshop, actor, dimensions[layer], layer, picture);
            dimensions[layer + 1] = ancestors[layer].room;
            contexts[layer + 1] = ContainingLens(workshop.layout, dimensions[layer], contexts[layer], ancestors[layer]);
            contextCount++;
        }
        sculpture.shadowFloor = contexts[contextCount - 1].floor;
        for (var layer = contextCount - 1; layer >= 0; layer--)
        {
            var hiddenBox = layer > 0 ? ancestors[layer - 1].box : -1;
            var instance = layer < 3 && dimensions[layer] >= 0 ? ancestors[layer].box : -1;
            RoomScene(sculpture, workshop, dimensions[layer], contexts[layer], picture, hands, hiddenBox, instance);
        }
        for (var seat = 0; seat < 2; seat++) PassageMaker(sculpture, workshop, picture, hands, seat, contexts, dimensions, contextCount);
        if (hands.seat == localSeat && !picture.passages[localSeat].active && picture.cameraBlend >= 1)
        {
            // What the next step does to a box beside this screen's dummy:
            // a yellow bumper against one it pushes, a green arrow into one
            // it enters. Plain walks and blocked steps are left unmarked.
            sculpture.ground = lens.floor;
            var top = lens.floor + lens.tile * .022;
            for (var d = 0; d < 4; d++)
            {
                var axis = float2(Direction(d));
                var cross = float2(-axis.y, axis.x);
                var edge = MapPoint(picture.actors[localSeat], lens) + axis * lens.tile * .43;
                if (hands.ahead[d] == Step.Push)
                    FloorLine(sculpture, edge - cross * lens.tile * .26, edge + cross * lens.tile * .26, lens.tile * .09, HAZARD, top, lens.tile);
                if (hands.ahead[d] == Step.Enter)
                {
                    var green = Color(.16, .56, .30);
                    FloorLine(sculpture, edge, edge - axis * lens.tile * .16 + cross * lens.tile * .18, lens.tile * .07, green, top, lens.tile);
                    FloorLine(sculpture, edge, edge - axis * lens.tile * .16 - cross * lens.tile * .18, lens.tile * .07, green, top, lens.tile);
                }
            }
        }
        var rotation = quaternion.Euler(float3(SCENE_PITCH, 0, 0));
        // Depth bounds follow the local view's containing scales, never a
        // moving or absent partner. The orthographic ground projection is fixed.
        var distance = Math.Max(Screen.width, Screen.height) * 8 + contexts[contextCount - 1].tile * 2;
        var camera = float4x4.TRS(-Math.Forward(rotation) * distance, rotation, float3(1));
        var projection = float4x4.Ortho(Screen.width, Screen.height, .1, distance * 2);
        RenderScene(sculpture.vertices, sculpture.indices, sculpture.objects, camera, projection,
            region, viewCenter, lens.tile, render);
    }
}
