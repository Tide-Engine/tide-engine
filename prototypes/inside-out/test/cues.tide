// Test-only local listener makes production events observable through the
// ordinary tick event log; it contributes no state to the match world.
local singleton CueProbe { int count; int kind; int seat; int direction; Traveler source; }
local event(PuzzleCue cue) RecordCue(mut CueProbe probe)
{
    probe.count += 1;
    probe.kind = cue.kind;
    probe.seat = cue.seat;
    probe.direction = cue.direction;
    probe.source = cue.source;
}
