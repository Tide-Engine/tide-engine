// Real, depth-tested geometry in one fixed orthographic scene. Floor points
// retain the existing screen axes while vertical faces expose physical depth.
const float SCENE_PITCH = 1.134464;
const float SCENE_SIN = 0.9063078;
const float SCENE_COS = 0.4226183;

local singleton Sculpture
{
    List<SceneVertex> vertices;
    List<int> indices;
    List<SceneObject> objects;
    float alpha = 1;
    // 1 while the next surfaces give their own light.
    float glow;
    float4 aperture;
    int apertureSide = -1;
    float tile;
    float ground;
    float shadowFloor;
    Rect bounds;
}

void CubeFace(mut Sculpture sculpture, float3 normal, float3 a, float3 b, float3 c, float3 d)
{
    var first = sculpture.vertices.count;
    sculpture.vertices.Add(SceneVertex { position = a, normal = normal });
    sculpture.vertices.Add(SceneVertex { position = b, normal = normal });
    sculpture.vertices.Add(SceneVertex { position = c, normal = normal });
    sculpture.vertices.Add(SceneVertex { position = d, normal = normal });
    sculpture.indices.Add(first);
    sculpture.indices.Add(first + 1);
    sculpture.indices.Add(first + 2);
    sculpture.indices.Add(first);
    sculpture.indices.Add(first + 2);
    sculpture.indices.Add(first + 3);
}

void BeginSculpture(mut Sculpture sculpture, float tile, Rect bounds)
{
    if (sculpture.vertices.count == 0)
    {
        CubeFace(sculpture, float3(0, 0, -1), float3(-.5, -.5, -.5), float3(-.5, .5, -.5), float3(.5, .5, -.5), float3(.5, -.5, -.5));
        CubeFace(sculpture, float3(0, 0, 1), float3(.5, -.5, .5), float3(.5, .5, .5), float3(-.5, .5, .5), float3(-.5, -.5, .5));
        CubeFace(sculpture, float3(1, 0, 0), float3(.5, -.5, -.5), float3(.5, .5, -.5), float3(.5, .5, .5), float3(.5, -.5, .5));
        CubeFace(sculpture, float3(-1, 0, 0), float3(-.5, -.5, .5), float3(-.5, .5, .5), float3(-.5, .5, -.5), float3(-.5, -.5, -.5));
        CubeFace(sculpture, float3(0, 1, 0), float3(-.5, .5, -.5), float3(-.5, .5, .5), float3(.5, .5, .5), float3(.5, .5, -.5));
        CubeFace(sculpture, float3(0, -1, 0), float3(-.5, -.5, .5), float3(-.5, -.5, -.5), float3(.5, -.5, -.5), float3(.5, -.5, .5));
    }
    sculpture.objects.Clear();
    sculpture.alpha = 1;
    sculpture.glow = 0;
    sculpture.apertureSide = -1;
    sculpture.tile = tile;
    sculpture.ground = 0;
    sculpture.shadowFloor = 0;
    sculpture.bounds = bounds;
}

float3 SculptureFoot(float2 at, float floor)
{
    return float3(at.x - Screen.width * .5, floor,
        -(at.y - Screen.height * .5 + floor * SCENE_COS) / SCENE_SIN);
}

void Cuboid(mut Sculpture sculpture, float2 at, float2 footprint, float height, Color tone, float floor = 0, float scale = 1)
{
    if (height <= 0 || footprint.x <= 0 || footprint.y <= 0 || tone.a * sculpture.alpha <= .01) return;
    // Huge containing tiles retain the same visible surface, but do not send
    // distant corners through the depth range. The guard also retains casters
    // just outside the view. Elevated faces can reach up from below the panel.
    var guard = Math.Max(24, sculpture.tile * 2) + Math.Max(0, floor + height - sculpture.shadowFloor) * .75;
    var lower = Math.Max(at - footprint * .5, float2(sculpture.bounds.x - guard, sculpture.bounds.y - guard));
    var upper = Math.Min(at + footprint * .5, float2(sculpture.bounds.x + sculpture.bounds.width + guard,
        sculpture.bounds.y + sculpture.bounds.height + guard + height * SCENE_COS));
    var clipped = upper - lower;
    if (clipped.x <= 0 || clipped.y <= 0) return;
    var position = SculptureFoot((lower + upper) * .5, sculpture.ground) + float3(0, floor - sculpture.ground + height * .5, 0);
    var size = float3(clipped.x, height, clipped.y / SCENE_SIN);
    var paint = Color(tone.r, tone.g, tone.b, tone.a * sculpture.alpha);
    sculpture.objects.Add(SceneObject {
        transform = float4x4.TRS(position, quaternion.identity, size), tone = paint,
        aoScale = Math.Max(1, scale), aperture = sculpture.aperture,
        apertureSide = sculpture.apertureSide, groundHeight = sculpture.ground,
        glow = sculpture.glow });
}

void FloorLine(mut Sculpture sculpture, float2 from, float2 to, float width, Color tone, float floor, float scale)
{
    var start = SculptureFoot(from, sculpture.ground) + float3(0, floor - sculpture.ground, 0);
    var end = SculptureFoot(to, sculpture.ground) + float3(0, floor - sculpture.ground, 0);
    var delta = end - start;
    var length = Math.Length(delta);
    if (length <= .001 || width <= 0) return;
    var rotation = quaternion.AxisAngle(float3(0, 1, 0), Math.Atan2(delta.x, delta.z));
    var height = Math.Max(.08, scale * .007);
    var paint = Color(tone.r, tone.g, tone.b, tone.a * sculpture.alpha);
    sculpture.objects.Add(SceneObject {
        transform = float4x4.TRS((start + end) * .5 + float3(0, height * .5, 0), rotation, float3(width, height, length)),
        tone = paint, aoScale = Math.Max(1, scale), aperture = sculpture.aperture,
        apertureSide = sculpture.apertureSide, groundHeight = sculpture.ground,
        glow = sculpture.glow });
}

void FloorOutline(mut Sculpture sculpture, float2 at, float2 size, float width, Color tone, float floor, float scale)
{
    var low = at - size * .5;
    var high = at + size * .5;
    FloorLine(sculpture, low, float2(high.x, low.y), width, tone, floor, scale);
    FloorLine(sculpture, float2(high.x, low.y), high, width, tone, floor, scale);
    FloorLine(sculpture, high, float2(low.x, high.y), width, tone, floor, scale);
    FloorLine(sculpture, float2(low.x, high.y), low, width, tone, floor, scale);
}

void FloorNumber(mut Sculpture sculpture, int number, bool prime, float2 at, float size, Color tone, float floor, float scale)
{
    var stroke = Math.Max(.4, size * .10);
    if (number == 1) FloorLine(sculpture, at + float2(0, -size * .45), at + float2(0, size * .45), stroke, tone, floor, scale);
    if (number == 2 || number == 3)
    {
        FloorLine(sculpture, at + float2(-size * .25, -size * .45), at + float2(size * .25, -size * .45), stroke, tone, floor, scale);
        FloorLine(sculpture, at + float2(-size * .25, 0), at + float2(size * .25, 0), stroke, tone, floor, scale);
        FloorLine(sculpture, at + float2(-size * .25, size * .45), at + float2(size * .25, size * .45), stroke, tone, floor, scale);
        FloorLine(sculpture, at + float2(size * .25, -size * .45), at + float2(size * .25, 0), stroke, tone, floor, scale);
        var x = number == 2 ? -size * .25 : size * .25;
        FloorLine(sculpture, at + float2(x, 0), at + float2(x, size * .45), stroke, tone, floor, scale);
    }
    if (number == 4)
    {
        FloorLine(sculpture, at + float2(-size * .25, -size * .45), at + float2(-size * .25, 0), stroke, tone, floor, scale);
        FloorLine(sculpture, at + float2(-size * .25, 0), at + float2(size * .25, 0), stroke, tone, floor, scale);
        FloorLine(sculpture, at + float2(size * .25, -size * .45), at + float2(size * .25, size * .45), stroke, tone, floor, scale);
    }
    if (prime) FloorLine(sculpture, at + float2(size * .52, -size * .47), at + float2(size * .42, -size * .15), stroke, tone, floor, scale);
}
