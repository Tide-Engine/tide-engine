// A frame gathers the crowd into five model families. No enemy owns a draw
// call, render resource or animation skeleton.
using Rooms;

void Scatter(mut Visuals visuals,float2 at,Color color,int count,float force)
{
    for(var i=0;i<count&&visuals.embers.count<600;i++)
    {
        var way=visuals.random.NextFloat3Direction();
        var power=visuals.random.NextFloat(force*0.45,force);
        var life=visuals.random.NextFloat(0.30,0.65);
        var size=visuals.random.NextFloat(0.055,0.11);
        visuals.embers.Add(Ember {at=Raised(at,0.5),velocity=float3(way.x,Math.Abs(way.y)+0.4,way.z)*power,life=life,size=size,color=color});
    }
}

local event(Ruptured burst) RupturePicture(mut Visuals visuals,mut CameraState camera)
{
    Scatter(visuals,burst.at,Color(0.44,1,1),Math.Min(64,18+burst.count*2),8);
    if(visuals.waves.count<24) visuals.waves.Add(EchoWave {at=burst.at,radius=5.2,color=Color(0.31,0.94,1)});
    camera.shake=Math.Max(camera.shake,0.45);
}

local event(Struck strike) HeavyPicture(mut Visuals visuals)
{
    Scatter(visuals,strike.at,Color(0.56,0.87,1),12,4);
    if(visuals.waves.count<24) visuals.waves.Add(EchoWave {at=strike.at,radius=3.5,life=0.32,color=Color(0.42,0.83,1)});
}

local event(Lured lure) LurePicture(mut Visuals visuals)
{
    if(visuals.waves.count<24) visuals.waves.Add(EchoWave {at=lure.at,radius=12,life=1.2,color=Color(0.86,0.52,0.72)});
    Scatter(visuals,lure.at,Color(0.91,0.59,0.71),14,5);
}

local event(Rescued rescue) RescuePicture(mut Visuals visuals)
{
    Scatter(visuals,rescue.at,Color(1,0.88,0.44),28,6);
    if(visuals.waves.count<24) visuals.waves.Add(EchoWave {at=rescue.at,radius=5,life=0.7,color=Color(1,0.85,0.35)});
}

[Stage(Layers.Camera,-3)]
view ResetScene(mut CameraState camera,mut Lens lens,mut Models models,mut Visuals visuals)
{
    MakeCityModels(models);
    camera.dt=Math.Min(Frame.dt,0.05);
    camera.time+=camera.dt;
    if(camera.time>=3600) camera.time-=3600;
    camera.shake=Math.Max(0,camera.shake-camera.dt*3);
    camera.mine=default;
    camera.seat=-1;
    var each=Math.Max(2.0,Math.Round(Screen.height/LINES));
    var size=float2(Math.Ceil(Screen.width/each),Math.Ceil(Screen.height/each));
    if(!lens.made)
    {
        lens.made=true;
        lens.scene=RenderTarget(int(size.x),int(size.y),1);
    }
    else if(size.x!=lens.size.x||size.y!=lens.size.y) lens.scene.Resize(int(size.x),int(size.y));
    lens.size=size;
    lens.scale=float2(Screen.width/size.x,Screen.height/size.y);
    visuals.heroes.Clear();visuals.husks.Clear();visuals.runners.Clear();visuals.guards.Clear();visuals.cantors.Clear();visuals.wardens.Clear();
    visuals.bells.Clear();visuals.graves.Clear();visuals.ruins.Clear();visuals.lamps.Clear();visuals.rubble.Clear();visuals.foundations.Clear();visuals.skyline.Clear();visuals.sparks.Clear();
    visuals.shadows.Clear();visuals.warnings.Clear();visuals.players.Clear();
    visuals.shown=0;
}

[Stage(Layers.Camera,-2)]
view MyScavenger(Hero hero,mut CameraState camera,with ownership)
{
    camera.mine=this;
    camera.seat=hero.seat;
    camera.mineAt=hero.pos;
    camera.health=hero.health;
    camera.shake=Math.Max(camera.shake,hero.damageFlash*0.35+hero.heavyFlash*0.13);
}

[Stage(Layers.Camera)]
view ConfigureCamera(mut CameraState camera,mut RenderLight light,Lens lens,Expedition expedition)
{
    var target=camera.seat>=0 ? camera.mineAt : expedition.goal;
    if(!camera.started)
    {
        camera.started=true;
        camera.focus=target;
    }
    camera.focus+=(target-camera.focus)*(1-Math.Exp(-camera.dt*6));
    light.focus=camera.focus;
    light.grid=lens.size*0.5;
    light.time=camera.time;
    light.goal=expedition.goal;
    light.district=expedition.act;
    // Fixed azimuth keeps north on the screen; an elevated perspective shows
    // silhouettes and open lanes without turning input when the camera moves.
    var focus=Raised(camera.focus,0.5);
    var back=Math.Max(31.0,31.0*Screen.height/Math.Max(Screen.width,1)*1.55);
    var from=Math.Normalize(float3(0,0.82,-0.68));
    var eye=focus+from*back;
    var jolt=float3(Math.Sin(camera.time*59),Math.Sin(camera.time*47),0)*camera.shake*0.10;
    light.eye=eye+jolt;
    lens.scene.SetCamera(light.eye,quaternion.LookRotation(Math.Normalize(focus-eye),float3(0,1,0)),38);
    Audio.SetListener(Raised(camera.focus,3),quaternion.identity);
}

[Stage(Layers.Gather)]
view GatherDead(Enemy enemy,mut Visuals visuals,RenderLight light)
{
    if(Math.DistanceSq(enemy.pos,light.focus)>34*34||enemy.health<=0) return;
    var angle=Math.Atan2(enemy.heading.x,enemy.heading.y);
    var lift=enemy.kind==EnemyKind.Runner ? Math.Abs(Math.Sin(light.time*11+enemy.serial))*0.045 : 0.0;
    mut var solid=PlacedPiece(enemy.pos,lift,angle,1);
    solid.prime=enemy.prime;
    solid.flash=enemy.flash;
    solid.gait=light.time*(enemy.kind==EnemyKind.Runner ? 11.0 : 5.0)+enemy.serial*1.7;
    solid.phase=1;
    if(enemy.kind==EnemyKind.Husk) visuals.husks.Add(solid);
    else if(enemy.kind==EnemyKind.Runner) visuals.runners.Add(solid);
    else if(enemy.kind==EnemyKind.Bellguard) visuals.guards.Add(solid);
    else if(enemy.kind==EnemyKind.Cantor) visuals.cantors.Add(solid);
    else visuals.wardens.Add(solid);
    visuals.shown++;
    if(enemy.kind!=EnemyKind.Husk)
    {
        var size=enemy.kind==EnemyKind.Warden ? 3.5 : 1.2;
        CircleMark(visuals.shadows,enemy.pos,size,Color(0.025,0.04,0.04,0.34),0,1);
    }
    if(enemy.windup>0)
    {
        var duration=enemy.kind==EnemyKind.Warden ? 1.5 : enemy.kind==EnemyKind.Cantor ? 1.2 : 0.65;
        var fraction=1-Math.Saturate(enemy.windup/duration);
        var size=enemy.kind==EnemyKind.Warden ? 16.0 : enemy.kind==EnemyKind.Cantor ? 7.0 : 4.8;
        CircleMark(visuals.warnings,enemy.attackAt,size,Color(1,0.30,0.12,0.82),0.06,1);
        CircleMark(visuals.warnings,enemy.attackAt,size*0.96,Color(1,0.54,0.17,0.7),0.08,fraction);
    }
}

[Stage(Layers.Gather,1)]
view GatherEmbers(mut Visuals visuals,CameraState camera)
{
    for(var i=visuals.embers.count-1;i>=0;i--)
    {
        mut var ember=visuals.embers[i];
        ember.age+=camera.dt;
        if(ember.age>=ember.life) {visuals.embers.RemoveAt(i);continue;}
        ember.velocity.y-=camera.dt*9;
        ember.at+=ember.velocity*camera.dt;
        if(ember.at.y<0.06) {ember.at.y=0.06;ember.velocity.y=Math.Abs(ember.velocity.y)*0.25;}
        var size=ember.size*(1-ember.age/ember.life);
        visuals.sparks.Add(Solid {transform=float4x4.TRS(ember.at,quaternion.AxisAngle(float3(1,0,1),ember.age*4),float3(size)),tint=ember.color});
        visuals.embers[i]=ember;
    }
    for(var i=visuals.waves.count-1;i>=0;i--)
    {
        mut var wave=visuals.waves[i];
        wave.age+=camera.dt;
        if(wave.age>=wave.life) {visuals.waves.RemoveAt(i);continue;}
        var fraction=wave.age/wave.life;
        var color=Color(wave.color.r,wave.color.g,wave.color.b,(1-fraction)*0.82);
        CircleMark(visuals.warnings,wave.at,0.5+wave.radius*fraction*2,color,0.045,1);
        visuals.waves[i]=wave;
    }
}

[Stage(Layers.Gather)]
view GatherScavengers(Hero hero,mut Visuals visuals,RenderLight light)
{
    var at=hero.pos;
    var turn=Math.Atan2(hero.aim.x,hero.aim.y);
    mut var solid=PlacedPiece(at,0,turn,1);
    solid.tint=hero.down ? Color(0.24,0.26,0.28) : PlayerTone(hero.seat);
    solid.flash=hero.damageFlash;
    solid.gait=light.time*8+hero.seat;
    solid.phase=hero.down ? 0.0 : 1.0;
    if(hero.down) solid.transform=float4x4.TRS(Raised(at,0.22),quaternion.AxisAngle(float3(1,0,0),Math.PI*0.5),float3(1));
    visuals.heroes.Add(solid);
    CircleMark(visuals.shadows,at,1.6,Color(0.02,0.025,0.03,0.5),0,1);
    CircleMark(visuals.players,at,hero.down ? 3.0 : 1.9,hero.down ? Color(1,0.78,0.34,0.9) : PlayerTone(hero.seat),0.075,1);
    if(hero.down&&hero.revive>0) CircleMark(visuals.players,at,2.7,Color(0.84,1,0.58),0.16,Math.Saturate(hero.revive/3));
    if(hero.fireFlash>0)
    {
        var muzzle=at+hero.aim*1.0;
        var flash=float3(0.09,0.10,0.33)*(1+hero.fireFlash*2);
        visuals.sparks.Add(Solid {transform=float4x4.TRS(Raised(muzzle,1),quaternion.AxisAngle(float3(0,1,0),turn),flash),tint=Color(1,0.9,0.53),flash=1});
    }
    if(hero.heavyFlash>0)
    {
        CircleMark(visuals.warnings,at,2.0+(0.3-hero.heavyFlash)*12,Color(0.37,0.92,1,Math.Saturate(hero.heavyFlash*2)),0.055,1);
    }
}

[Stage(Layers.Marks)]
view DrawGroundMarks(Models models,Lens lens,Visuals visuals)
{
    lens.scene.Depth(Depth.Read)
    {
        lens.scene.Instanced(models.plate,models.plateFaces,visuals.shadows,MarkPaint);
    }
}

[Stage(Layers.Lamp)]
view CastMoon(Models models,Visuals visuals,RenderLight light,mut MoonShadow shadow)
{
    if(!shadow.made)
    {
        shadow.made=true;
        shadow.map=RenderTarget(512,512,1,Format.Depth);
        shadow.depth=shadow.map.depth;
    }
    var direction=Math.Normalize(float3(-0.45,0.82,-0.35));
    var turn=quaternion.LookRotation(-direction,float3(0,1,0));
    // The image steps in whole world texels as the camera follows.
    var middle=Raised(Math.Round(light.focus/0.09375)*0.09375,1);
    var lamp=float4x4.TRS(middle+direction*70,turn,float3(1));
    shadow.map.SetCamera(lamp,float4x4.Ortho(48,48,0,140));
    shadow.map.Clear(Color.white);
    shadow.toLamp=shadow.map.WorldToClip();
    shadow.map.Instanced(models.husk,models.huskFaces,visuals.husks);
    shadow.map.Instanced(models.runner,models.runnerFaces,visuals.runners);
    shadow.map.Instanced(models.guard,models.guardFaces,visuals.guards);
    shadow.map.Instanced(models.cantor,models.cantorFaces,visuals.cantors);
    shadow.map.Instanced(models.warden,models.wardenFaces,visuals.wardens);
    shadow.map.Instanced(models.hero,models.heroFaces,visuals.heroes);
    shadow.map.Instanced(models.lamp,models.lampFaces,visuals.lamps);
    shadow.map.Instanced(models.bell,models.bellFaces,visuals.bells);
    shadow.map.Instanced(models.foundation,models.foundationFaces,visuals.foundations);
}

[Stage(Layers.Pieces)]
view DrawCrowd(Models models,Lens lens,Visuals visuals)
{
    lens.scene.Instanced(models.husk,models.huskFaces,visuals.husks,Snap,Painted);
    lens.scene.Instanced(models.runner,models.runnerFaces,visuals.runners,Snap,Painted);
    lens.scene.Instanced(models.guard,models.guardFaces,visuals.guards,Snap,Painted);
    lens.scene.Instanced(models.cantor,models.cantorFaces,visuals.cantors,Snap,Painted);
    lens.scene.Instanced(models.warden,models.wardenFaces,visuals.wardens,Snap,Painted);
    lens.scene.Instanced(models.hero,models.heroFaces,visuals.heroes,Snap,Painted);
}

[Stage(Layers.Effects)]
view DrawFeedback(Models models,Lens lens,Visuals visuals)
{
    lens.scene.Instanced(models.shard,models.shardFaces,visuals.sparks,Snap,Painted);
    // Attack tells and team rings remain visible through the opaque horde.
    lens.scene.Depth(Depth.None)
    {
        lens.scene.Instanced(models.plate,models.plateFaces,visuals.warnings,MarkPaint);
        lens.scene.Instanced(models.plate,models.plateFaces,visuals.players,MarkPaint);
    }
}

[Stage(Layers.Show)]
view ShowScene(Lens lens)
{
    Draw.Blit(lens.scene.color,Draw.window,Present);
}
