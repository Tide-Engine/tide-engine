asset Clip shotClip = "sfx/shot.wav";
asset Clip heavyClip = "sfx/heavy.wav";
asset Clip bellClip = "sfx/bell.wav";
asset Clip ruptureClip = "sfx/rupture.wav";
asset Clip rescueClip = "sfx/rescue.wav";
asset Clip winClip = "sfx/win.wav";
asset Clip processionClip = "sfx/procession.wav";

local singleton Aural
{
    Sound music;
    int phase = -1;
    int zone = -1;
    float ruptureWait;
}

local event(Fired fired) HearShot()
{
    Audio.Play(shotClip, 0.24, fired.weapon == 0 ? 1.2 : fired.weapon == 1 ? 0.8 : 0.65);
}
local event(Struck struck) HearHeavy()
{
    Audio.Play(heavyClip, Raised(struck.at, 1), 0.55);
}
local event(Lured lured) HearLure()
{
    Audio.Play(bellClip, Raised(lured.at, 1), 0.28, 1.7);
}
local event(Rescued rescued) HearRescue()
{
    Audio.Play(rescueClip, Raised(rescued.at, 1), 0.5);
}
local event(Ruptured ruptured) HearRupture(mut Aural aural)
{
    if (aural.ruptureWait > 0) return;
    aural.ruptureWait = 0.15;
    Audio.Play(ruptureClip, Raised(ruptured.at, 1), 0.5);
}

[Stage(Layers.Hud, -3)]
view Soundscape(Expedition run, CameraState camera, mut Aural aural)
{
    Audio.SetListener(Raised(camera.mineAt, 2), quaternion.identity);
    Audio.SetFalloff(8, 70);
    aural.ruptureWait = Math.Max(0, aural.ruptureWait - Frame.dt);
    aural.music.clip = processionClip;
    aural.music.loop = true;
    aural.music.playing = run.phase != RunPhase.Defeat && run.phase != RunPhase.Victory;
    aural.music.volume = run.phase == RunPhase.Waiting || run.phase == RunPhase.Sanctuary ? 0.24 : run.phase == RunPhase.Boss ? 0.65 : 0.42;
    aural.music.pitch = run.act == 0 ? 1.0 : run.act == 1 ? 0.89 : 1.12;
    if (aural.phase != int(run.phase))
    {
        if (run.phase == RunPhase.Victory) Audio.Play(winClip, 0.6);
        else if (run.phase == RunPhase.Hold || run.phase == RunPhase.Boss || run.phase == RunPhase.Sanctuary)
            Audio.Play(bellClip, 0.45, run.phase == RunPhase.Boss ? 0.5 : 1.0);
        else if (run.phase == RunPhase.Defeat) Audio.Play(bellClip, 0.4, 0.45);
        aural.phase = int(run.phase);
    }
}
