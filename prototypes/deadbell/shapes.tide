// Deadbell's meshes are authored here as flat faces: tapered coats and
// bell skirts, faceted skulls, broken stonework and iron lanterns. The small
// mesh builders are shared in shape with the existing examples, while the
// silhouettes and city pieces below are specific to this prototype.

// What a shape is added in: where, turned how, and its paint.
struct Brush
{
    float4x4 place = float4x4.identity;  // Where what's added goes: moved and turned, never scaled
    Color color = Color.white;
    float own = 1;       // Zero lets an instance tint this paint, as on a scavenger's coat.
    float kind;
    float gloss;
    float glow;
}

Brush Ink(Color color, float kind, float gloss)
{
    return Brush { color = color, kind = kind, gloss = gloss };
}

// Paint that takes the tint of whatever draws the mesh, this much darker.
Brush Tinted(float shade, float gloss)
{
    return Brush { color = Color(shade, shade, shade), own = 0, gloss = gloss };
}

Brush Placed(Brush brush, float3 at, quaternion turn)
{
    mut var placed = brush;
    placed.place = float4x4.TRS(at, turn, float3(1));
    return placed;
}

void Emit(mut List<Corner> corners, Brush brush, float3 position, float3 normal, float2 grain)
{
    corners.Add(Corner { position = Math.Transform(brush.place, position), normal = Math.Normalize(Math.Rotate(brush.place, normal)),
                         color = brush.color, own = brush.own, kind = brush.kind, grain = grain, gloss = brush.gloss, glow = brush.glow });
}

// A flat triangle that faces `toward`: its corners go whichever way round
// shows it from that side.
void PutTriangle(mut List<Corner> corners, mut List<int> faces, Brush brush, float3 a, float3 b, float3 c, float3 toward, float2 ga, float2 gb, float2 gc)
{
    mut var normal = Math.Cross(b - a, c - a);
    var front = Math.Dot(normal, toward) > 0;
    if (!front) normal = normal * -1.0;
    if (Math.LengthSq(normal) < 0.0000000001) return;
    normal = Math.Normalize(normal);
    var first = corners.count;
    Emit(corners, brush, a, normal, ga);
    Emit(corners, brush, front ? b : c, normal, front ? gb : gc);
    Emit(corners, brush, front ? c : b, normal, front ? gc : gb);
    faces.Add(first);
    faces.Add(first + 1);
    faces.Add(first + 2);
}

// A flat four-sided face, its corners in order round it.
void PutQuad(mut List<Corner> corners, mut List<int> faces, Brush brush, float3 a, float3 b, float3 c, float3 d, float3 toward, float2 ga, float2 gb, float2 gc, float2 gd)
{
    PutTriangle(corners, faces, brush, a, b, c, toward, ga, gb, gc);
    PutTriangle(corners, faces, brush, a, c, d, toward, ga, gc, gd);
}

// A box. Its grain runs along its longest side.
void PutBox(mut List<Corner> corners, mut List<int> faces, Brush brush, float3 center, float3 size)
{
    var longX = size.x >= size.y && size.x >= size.z;
    var longY = !longX && size.y >= size.z;
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        float way = face % 2 == 0 ? 1 : -1;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        var first = corners.count;
        for (var i = 0; i < 4; i++)
        {
            float a = i == 0 || i == 3 ? -0.5 : 0.5;
            float b = i < 2 ? -0.5 : 0.5;
            var from = (normal * 0.5 + across * a + up * b) * size;
            var along = longX ? from.x : longY ? from.y : from.z;
            Emit(corners, brush, center + from, normal, float2(along, from.x + from.y + from.z - along));
        }
        faces.Add(first);
        faces.Add(first + 1);
        faces.Add(first + 2);
        faces.Add(first);
        faces.Add(first + 2);
        faces.Add(first + 3);
    }
}

// A tube from one place to another, as thick at each end as it's told: a
// staff, a cone when one end has no radius, a pyramid with four sides. Its
// ends are closed.
void PutTube(mut List<Corner> corners, mut List<int> faces, Brush brush, float3 from, float3 to, float thickFrom, float thickTo, int sides)
{
    var length = Math.Distance(from, to);
    if (length < 0.00001) return;
    var axis = (to - from) / length;
    var u = Math.Normalize(Math.Cross(axis, Math.Abs(axis.y) < 0.9 ? float3(0, 1, 0) : float3(1, 0, 0)));
    var v = Math.Cross(u, axis);
    var first = corners.count;
    for (var step = 0; step <= sides; step++)
    {
        float turn = step * Math.TAU / sides;
        var out = u * Math.Cos(turn) + v * Math.Sin(turn);
        var normal = Math.Normalize(out * length + axis * (thickFrom - thickTo));
        float around = step * Math.TAU / sides * Math.Max(thickFrom, thickTo);
        Emit(corners, brush, from + out * thickFrom, normal, float2(0, around));
        Emit(corners, brush, to + out * thickTo, normal, float2(length, around));
        if (step == sides) continue;
        int at = first + step * 2;
        faces.Add(at);
        faces.Add(at + 1);
        faces.Add(at + 2);
        faces.Add(at + 2);
        faces.Add(at + 1);
        faces.Add(at + 3);
    }
    for (var lid = 0; lid < 2; lid++)
    {
        float thick = lid == 0 ? thickTo : thickFrom;
        if (thick <= 0) continue;
        var middle = lid == 0 ? to : from;
        var normal = lid == 0 ? axis : axis * -1.0;
        var start = corners.count;
        Emit(corners, brush, middle, normal, float2(0));
        for (var step = 0; step <= sides; step++)
        {
            float turn = step * Math.TAU / sides;
            var out = u * Math.Cos(turn) + v * Math.Sin(turn);
            Emit(corners, brush, middle + out * thick, normal, float2(out.x, out.z) * thick);
            if (step == sides) continue;
            faces.Add(start);
            faces.Add(start + 1 + step + (lid == 0 ? 1 : 0));
            faces.Add(start + 1 + step + (lid == 0 ? 0 : 1));
        }
    }
}

// A shape turned on a lathe: a profile, each point how far out and how high,
// swept round the brush's upright. The profile goes round the shape with its
// outside on its right: up an outer wall, in across a top, down an inner wall.
void PutLathe(mut List<Corner> corners, mut List<int> faces, Brush brush, float3 at, List<float2> profile, float2 scale, int sides)
{
    var first = corners.count;
    var count = profile.count;
    for (var i = 0; i < count; i++)
    {
        var here = profile[i] * scale;
        var before = profile[Math.Max(i - 1, 0)] * scale;
        var after = profile[Math.Min(i + 1, count - 1)] * scale;
        var along = after - before;
        var lean = Math.LengthSq(along) > 0.0000001 ? Math.Normalize(float2(along.y, -along.x)) : float2(1, 0);
        for (var step = 0; step <= sides; step++)
        {
            float turn = step * Math.TAU / sides;
            var out = float3(Math.Cos(turn), 0, Math.Sin(turn));
            Emit(corners, brush, at + out * here.x + float3(0, here.y, 0), float3(out.x * lean.x, lean.y, out.z * lean.x),
                 float2(here.y, turn * here.x));
            if (i == count - 1 || step == sides) continue;
            int corner = first + i * (sides + 1) + step;
            faces.Add(corner);
            faces.Add(corner + sides + 1);
            faces.Add(corner + 1);
            faces.Add(corner + 1);
            faces.Add(corner + sides + 1);
            faces.Add(corner + sides + 2);
        }
    }
}

// Where a blob's surface is, along a direction from its middle: a ball that
// noise pushes in and out.
float3 BlobPoint(float tilt, float turn, float3 radii, float seed, float lumps)
{
    var out = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
    if (lumps <= 0) return out * radii;
    var bump = Math.Perlin(out * 1.6 + float3(seed, seed * 1.7, seed * 0.3)) + Math.Perlin(out * 3.7 + float3(seed * 2.3)) * 0.5;
    return out * radii * (1 + bump * lumps);
}

// A blob: a ball of these radii, sculpted by noise. Smooth, it's leaves or a
// cloud, and with no lumps a plain ball; cut in facets, it's a rock.
void PutBlob(mut List<Corner> corners, mut List<int> faces, Brush brush, float3 at, float3 radii, float seed, float lumps, bool facets, int rings, int around)
{
    if (facets)
    {
        for (var ring = 0; ring < rings; ring++)
        {
            for (var step = 0; step < around; step++)
            {
                var a = at + BlobPoint(ring * Math.PI / rings, step * Math.TAU / around, radii, seed, lumps);
                var b = at + BlobPoint((ring + 1) * Math.PI / rings, step * Math.TAU / around, radii, seed, lumps);
                var c = at + BlobPoint(ring * Math.PI / rings, (step + 1) * Math.TAU / around, radii, seed, lumps);
                var d = at + BlobPoint((ring + 1) * Math.PI / rings, (step + 1) * Math.TAU / around, radii, seed, lumps);
                PutTriangle(corners, faces, brush, a, b, c, (a + b + c) / 3 - at, float2(0), float2(0), float2(0));
                PutTriangle(corners, faces, brush, c, b, d, (c + b + d) / 3 - at, float2(0), float2(0), float2(0));
            }
        }
        return;
    }
    var first = corners.count;
    for (var ring = 0; ring <= rings; ring++)
    {
        float tilt = ring * Math.PI / rings;
        for (var step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            var here = BlobPoint(tilt, turn, radii, seed, lumps);
            var out = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
            // Which way the surface faces: across two short steps over it, and a plain ball's where that says nothing
            mut var normal = Math.Normalize(out / radii);
            if (lumps > 0 && Math.Sin(tilt) > 0.08)
            {
                var down = BlobPoint(tilt + 0.03, turn, radii, seed, lumps) - BlobPoint(tilt - 0.03, turn, radii, seed, lumps);
                var round = BlobPoint(tilt, turn + 0.03, radii, seed, lumps) - BlobPoint(tilt, turn - 0.03, radii, seed, lumps);
                var across = Math.Cross(down, round);
                if (Math.LengthSq(across) > 0.000000000001)
                {
                    var faced = Math.Normalize(across);
                    normal = Math.Dot(faced, normal) < 0 ? faced * -1.0 : faced;
                }
            }
            Emit(corners, brush, at + here, normal, float2(0));
            if (ring == rings || step == around) continue;
            int corner = first + ring * (around + 1) + step;
            faces.Add(corner);
            faces.Add(corner + around + 1);
            faces.Add(corner + 1);
            faces.Add(corner + 1);
            faces.Add(corner + around + 1);
            faces.Add(corner + around + 2);
        }
    }
}

// A mesh's faces made flat: each gets corners of its own, which look the way
// the face does, where a round shape's look the way the shape goes. It's how
// a shape of few faces is lit when nothing smooths them over, and every mesh
// here is made so.
void Facet(mut List<Corner> corners, mut List<int> faces)
{
    mut List<Corner> flat = [];
    for (var i = 0; i + 2 < faces.count; i += 3)
    {
        mut var a = corners[faces[i]];
        mut var b = corners[faces[i + 1]];
        mut var c = corners[faces[i + 2]];
        mut var normal = Math.Cross(b.position - a.position, c.position - a.position);
        if (Math.LengthSq(normal) < 0.000000000001) continue;
        normal = Math.Normalize(normal);
        if (Math.Dot(normal, a.normal + b.normal + c.normal) < 0) normal = normal * -1.0;
        a.normal = normal;
        b.normal = normal;
        c.normal = normal;
        flat.Add(a);
        flat.Add(b);
        flat.Add(c);
    }
    corners = flat;
    faces.Clear();
    for (var i = 0; i < flat.count; i++) faces.Add(i);
}

void MakeWalker(mut List<Corner> corners, mut List<int> faces, int kind)
{
    var flesh = Ink(Color(0.77, 0.78, 0.59), PLAIN, 0);
    var dark = Ink(Color(0.29, 0.36, 0.33), CLOTH, 0);
    var bone = Ink(Color(0.83, 0.78, 0.53), PLAIN, 0);
    var rust = Ink(Color(0.46, 0.31, 0.19), IRON, 0);
    var height = kind == 1 ? 0.96 : kind == 2 ? 1.85 : kind == 3 ? 2.05 : 1.35;
    var broad = kind == 2 ? 0.46 : kind == 1 ? 0.26 : 0.31;
    List<float2> coat = [float2(broad * 1.05, 0.25), float2(broad, height * 0.56), float2(broad * 0.73, height * 0.78), float2(0.13, height * 0.86)];
    var clothing = kind == 3 ? Ink(Color(0.42, 0.21, 0.42), CLOTH, 0) : kind == 2 ? rust : dark;
    PutLathe(corners, faces, clothing, float3(0), coat, float2(1, 1), 5);
    PutBlob(corners, faces, flesh, float3(0, height * 0.91, 0.075), float3(0.23, 0.25, 0.22), 0, 0, true, 2, 5);
    // The face and eyes stay visible on a dark silhouette at the internal resolution.
    mut var eye = Ink(Color(0.91, 0.56, 0.20), PLAIN, 0);
    eye.glow = 0.8;
    PutBox(corners, faces, eye, float3(-0.075, height * 0.93, 0.252), float3(0.055, 0.035, 0.02));
    PutBox(corners, faces, eye, float3(0.075, height * 0.93, 0.252), float3(0.055, 0.035, 0.02));
    for (var side = -1; side <= 1; side += 2)
    {
        var shoulder = float3(side * broad, height * 0.71, 0);
        var hand = float3(side * (broad + (kind == 1 ? 0.26 : 0.10)), kind == 1 ? 0.13 : height * 0.39, 0.23);
        PutTube(corners, faces, clothing, shoulder, hand, 0.12, 0.075, 4);
        PutBlob(corners, faces, bone, hand, float3(0.09, 0.09, 0.13), 0, 0, true, 2, 4);
        PutTube(corners, faces, dark, float3(side * 0.16, 0.32, 0), float3(side * 0.18, 0.05, 0.11), 0.12, 0.07, 4);
    }
    if (kind == 1)
    {
        // Runners are low, long-armed and carry a pale ridge on the back.
        PutTube(corners, faces, bone, float3(0, 0.50, -0.16), float3(0, 0.98, -0.10), 0.16, 0.04, 3);
    }
    if (kind == 2)
    {
        // Bellguards' square shields and broken helmets read above the walkers.
        PutBox(corners, faces, rust, float3(-0.31, 0.92, 0.35), float3(0.66, 0.98, 0.12));
        PutBox(corners, faces, bone, float3(-0.31, 0.96, 0.426), float3(0.07, 0.74, 0.02));
        PutTube(corners, faces, rust, float3(0, height * 0.93, 0), float3(0, height * 1.15, 0), 0.26, 0.02, 5);
    }
    if (kind == 3)
    {
        PutTube(corners, faces, clothing, float3(0, height * 0.86, 0), float3(0, height * 1.28, -0.06), 0.28, 0, 5);
        PutTube(corners, faces, rust, float3(0.46, 0.15, 0.14), float3(0.46, 2.48, 0.14), 0.045, 0.045, 4);
        mut var flame = Ink(Color(0.93, 0.32, 0.47), PLAIN, 0);
        flame.glow = 1;
        PutBlob(corners, faces, flame, float3(0.46, 2.35, 0.14), float3(0.17, 0.27, 0.17), 0, 0, true, 2, 5);
    }
    Facet(corners, faces);
}

void MakeScavenger(mut List<Corner> corners, mut List<int> faces)
{
    mut var coat = Tinted(0.95, 0);
    coat.kind = CLOTH;
    List<float2> profile = [float2(0.36, 0.35), float2(0.29, 0.81), float2(0.37, 1.10), float2(0.13, 1.31)];
    PutLathe(corners, faces, coat, float3(0), profile, float2(1, 1), 6);
    var hood = Ink(Color(0.43, 0.48, 0.52), CLOTH, 0);
    PutBlob(corners, faces, hood, float3(0, 1.48, 0), float3(0.26, 0.27, 0.23), 0, 0, true, 3, 5);
    PutBox(corners, faces, Ink(Color(0.75, 0.62, 0.39), PLAIN, 0), float3(0, 1.48, 0.21), float3(0.28, 0.12, 0.06));
    var leather = Ink(Color(0.17, 0.12, 0.10), WOOD, 0);
    for (var side = -1; side <= 1; side += 2)
    {
        PutTube(corners, faces, leather, float3(side * 0.17, 0.47, 0), float3(side * 0.17, 0.07, 0.1), 0.12, 0.09, 4);
        PutTube(corners, faces, coat, float3(side * 0.34, 1.09, 0), float3(side * 0.25, 0.94, 0.40), 0.13, 0.09, 4);
    }
    // A brass shoulder lantern and the long barrel distinguish the player from the dead.
    var brass = Ink(Color(0.63, 0.46, 0.21), IRON, 0.4);
    PutBox(corners, faces, brass, float3(-0.30, 1.02, -0.22), float3(0.27, 0.38, 0.22));
    mut var glow = Ink(Color(1, 0.77, 0.32), PLAIN, 0);
    glow.glow = 0.8;
    PutBox(corners, faces, glow, float3(-0.30, 1.06, -0.34), float3(0.17, 0.20, 0.03));
    PutBox(corners, faces, leather, float3(0.20, 0.95, 0.36), float3(0.12, 0.13, 0.51));
    PutTube(corners, faces, Ink(Color(0.36, 0.40, 0.42), IRON, 0.8), float3(0.20, 0.99, 0.51), float3(0.20, 0.99, 0.98), 0.055, 0.04, 5);
    Facet(corners, faces);
}

void MakeWarden(mut List<Corner> corners, mut List<int> faces)
{
    var metal = Ink(Color(0.41, 0.29, 0.16), IRON, 0.3);
    List<float2> skirt = [float2(1.18, 0.12), float2(0.93, 0.41), float2(0.72, 1.25), float2(0.52, 2.20), float2(0.25, 2.70)];
    PutLathe(corners, faces, metal, float3(0), skirt, float2(1, 1), 7);
    var bone = Ink(Color(0.75, 0.71, 0.49), PLAIN, 0);
    PutBlob(corners, faces, bone, float3(0, 2.76, 0.22), float3(0.36, 0.42, 0.35), 0, 0, true, 3, 5);
    for (var side = -1; side <= 1; side += 2)
    {
        PutTube(corners, faces, metal, float3(side * 0.54, 2.1, 0), float3(side * 1.22, 1.27, 0.40), 0.25, 0.15, 5);
        PutTube(corners, faces, bone, float3(side * 0.30, 2.91, 0), float3(side * 0.70, 3.65, -0.10), 0.11, 0.025, 4);
        PutTube(corners, faces, bone, float3(side * 0.57, 3.37, -0.05), float3(side * 0.99, 3.65, -0.08), 0.07, 0, 3);
    }
    mut var flame = Ink(Color(0.99, 0.33, 0.16), PLAIN, 0);
    flame.glow = 1;
    PutBox(corners, faces, flame, float3(0, 2.8, 0.55), float3(0.32, 0.10, 0.04));
    Facet(corners, faces);
}

void MakeBell(mut List<Corner> corners, mut List<int> faces)
{
    var stone = Ink(Color(0.31, 0.33, 0.30), STONE, 0);
    var brass = Ink(Color(0.60, 0.44, 0.21), IRON, 0.5);
    PutBox(corners, faces, stone, float3(0, 0.12, 0), float3(2.65, 0.24, 2.65));
    PutBox(corners, faces, stone, float3(0, 0.34, 0), float3(2.2, 0.20, 2.2));
    for (var side = -1; side <= 1; side += 2)
    {
        PutTube(corners, faces, stone, float3(side * 0.95, 0.4, 0), float3(side * 0.95, 3.75, 0), 0.17, 0.13, 5);
        PutTube(corners, faces, stone, float3(side * 0.95, 3.5, 0), float3(0, 4.15, 0), 0.20, 0.14, 4);
    }
    List<float2> bell = [float2(0.65, 2.07), float2(0.61, 2.20), float2(0.44, 2.42), float2(0.30, 2.85), float2(0.06, 2.95)];
    PutLathe(corners, faces, brass, float3(0), bell, float2(1, 1), 8);
    PutTube(corners, faces, brass, float3(0, 2.08, 0), float3(0, 2.72, 0), 0.09, 0.09, 5);
    mut var flame = Ink(Color(1, 0.85, 0.37), PLAIN, 0);
    flame.glow = 1.1;
    PutBlob(corners, faces, flame, float3(0, 0.68, 0), float3(0.27, 0.35, 0.27), 0, 0, true, 2, 5);
    Facet(corners, faces);
}

void MakeCityModels(mut Models models)
{
    if (models.made) return;
    models.made = true;
    MakeScavenger(models.hero, models.heroFaces);
    MakeWalker(models.husk, models.huskFaces, 0);
    MakeWalker(models.runner, models.runnerFaces, 1);
    MakeWalker(models.guard, models.guardFaces, 2);
    MakeWalker(models.cantor, models.cantorFaces, 3);
    MakeWarden(models.warden, models.wardenFaces);
    MakeBell(models.bell, models.bellFaces);
    var stone = Ink(Color(0.29, 0.31, 0.29), STONE, 0);
    PutBox(models.grave, models.graveFaces, stone, float3(0, 0.055, 0), float3(1.05, 0.11, 1.50));
    // Small broken memorial tablets remain traversable decoration.
    PutTube(models.grave, models.graveFaces, stone, float3(0, 0.1, -0.45), float3(0, 0.29, -0.45), 0.30, 0.17, 4);
    PutBlob(models.rubble, models.rubbleFaces, stone, float3(0, 0.08, 0), float3(0.65, 0.13, 0.47), 2.1, 0.28, true, 2, 5);
    // An arch has fallen into its own foundations. The highest face is
    // thirty centimeters above the road; the whole piece is traversable.
    var marble=Ink(Color(0.38,0.42,0.39),STONE,0);
    PutBox(models.foundation,models.foundationFaces,stone,float3(0,0.055,0),float3(6.3,0.11,4.8));
    PutBox(models.foundation,models.foundationFaces,marble,float3(-2.75,0.18,0),float3(0.45,0.22,4.3));
    PutBox(models.foundation,models.foundationFaces,marble,float3(2.75,0.14,0.4),float3(0.45,0.18,3.5));
    PutBox(models.foundation,models.foundationFaces,marble,float3(0,0.12,-2.1),float3(5.4,0.16,0.40));
    PutTube(models.foundation,models.foundationFaces,marble,float3(-1.7,0.18,0.3),float3(0,0.18,1.7),0.16,0.12,4);
    PutTube(models.foundation,models.foundationFaces,marble,float3(0,0.18,1.7),float3(1.4,0.16,0.5),0.12,0.10,4);
    PutBlob(models.foundation,models.foundationFaces,stone,float3(1.8,0.1,-1.1),float3(0.65,0.19,0.55),3,0.22,true,2,4);
    var wood = Ink(Color(0.20, 0.14, 0.12), WOOD, 0);
    PutBox(models.ruin, models.ruinFaces, stone, float3(-2.45, 3.2, 0), float3(0.8, 6.4, 2.5));
    PutBox(models.ruin, models.ruinFaces, stone, float3(2.45, 2.6, 0), float3(0.8, 5.2, 2.5));
    PutTube(models.ruin, models.ruinFaces, stone, float3(-2.45, 6.4, 0), float3(0, 8.4, 0), 0.5, 0.35, 4);
