// A cold, low resolution city: flat painted faces, whole-pixel vertices,
// brass lamps and ordered color dithering. All of it is local presentation.
enum Layers { Camera, Gather, Lamp, World, Marks, Pieces, Effects, Show, Hud }

const float PLAIN = 0;
const float STONE = 1;
const float IRON = 2;
const float CLOTH = 3;
const float WOOD = 4;
const float ROAD = 5;
const float LINES = 270;
const float SHADES = 31;

struct Corner
{
    float3 position;
    float3 normal;
    Color color = Color.white;
    float own = 1;
    float kind;
    float2 grain;
    float gloss;
    float glow;
}

struct Solid
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
    float prime;
    float flash;
    float gait;
    float phase;
}

struct Decal
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
    float ring;
    float fill = 1;
}

struct Ember
{
    float3 at;
    float3 velocity;
    float age;
    float life = 0.55;
    float size = 0.08;
    Color color = Color.white;
}

struct EchoWave
{
    float2 at;
    float age;
    float life = 0.55;
    float radius = 5;
    Color color = Color.white;
}

local singleton Lens
{
    RenderTarget scene;
    float2 size;
    float2 scale = float2(1);
    bool made;
}

local singleton MoonShadow
{
    RenderTarget map;
    DepthTexture depth;
    float4x4 toLamp;
    bool made;
}

local singleton RenderLight
{
    float3 eye;
    float2 focus;
    float2 grid;
    float2 goal;
    float time;
    int district;
}

local singleton CameraState
{
    Entity mine;
    int seat = -1;
    float2 focus;
    float2 mineAt;
    float health = 100;
    float shake;
    float dt;
    float time;
    bool started;
}

local singleton Models
{
    List<Corner> hero; List<int> heroFaces;
    List<Corner> husk; List<int> huskFaces;
    List<Corner> runner; List<int> runnerFaces;
    List<Corner> guard; List<int> guardFaces;
    List<Corner> cantor; List<int> cantorFaces;
    List<Corner> warden; List<int> wardenFaces;
    List<Corner> bell; List<int> bellFaces;
    List<Corner> grave; List<int> graveFaces;
    List<Corner> ruin; List<int> ruinFaces;
    List<Corner> lamp; List<int> lampFaces;
    List<Corner> rubble; List<int> rubbleFaces;
    List<Corner> foundation; List<int> foundationFaces;
    List<Corner> skyline; List<int> skylineFaces;
    List<Corner> shard; List<int> shardFaces;
    List<Corner> road; List<int> roadFaces;
    List<Corner> plate; List<int> plateFaces;
    bool made;
}

local singleton Visuals
{
    List<Ember> embers;
    List<EchoWave> waves;
    Random random;
    List<Solid> heroes;
    List<Solid> husks;
    List<Solid> runners;
    List<Solid> guards;
    List<Solid> cantors;
    List<Solid> wardens;
    List<Solid> bells;
    List<Solid> graves;
    List<Solid> ruins;
    List<Solid> lamps;
    List<Solid> rubble;
    List<Solid> foundations;
    List<Solid> skyline;
    List<Solid> sparks;
    List<Decal> shadows;
    List<Decal> warnings;
    List<Decal> players;
    int shown;
}

float3 Raised(float2 at, float y) { return float3(at.x, y, at.y); }

Color PlayerTone(int seat)
{
    if (seat == 0) return Color(1, 0.45, 0.30);
    return Color(0.52, 0.78, 1);
}

float2 GroundPointer(float2 bottomLeft, Lens lens)
{
    var pixel = Screen.Flip(bottomLeft) / lens.scale;
    var origin = lens.scene.ScreenRayOrigin(pixel);
    var way = lens.scene.ScreenRayDirection(pixel);
    if (Math.Abs(way.y) < 0.0001) return float2(0);
    var at = origin - way * (origin.y / way.y);
    return float2(at.x, at.z);
}

float Speck(float2 at)
{
    return (Math.Hash(int2(int(Math.Floor(at.x)), int(Math.Floor(at.y)))) & 255) / 255.0;
}

float Dither(float2 pixel)
{
    int x = int(pixel.x) & 3;
    int y = int(pixel.y) & 3;
    int low = ((x ^ y) & 1) * 2 + (y & 1);
    int high = (((x >> 1) ^ (y >> 1)) & 1) * 2 + ((y >> 1) & 1);
    return (low * 4 + high + 0.5) / 16;
}

Color FogTone(int district)
{
    if (district == 1) return Color(0.095, 0.11, 0.135);
    if (district >= 2) return Color(0.16, 0.10, 0.13);
    return Color(0.105, 0.14, 0.15);
}

Color FacePaint(Corner corner, float3 world)
{
    // Material IDs cross a perspective interpolator. Rounding avoids an
    // identical ID landing a fraction either side of its integer value.
    var material=Math.Round(corner.kind);
    var noise = Speck(float2(Math.Floor(world.x * 7), Math.Floor(world.z * 7 + world.y * 9)));
    mut var base = float3(corner.color.r, corner.color.g, corner.color.b);
    mut var shade = 0.95 + noise * 0.10;
    if (material == STONE)
    {
        var crack = Math.Abs(Math.Sin(Math.Floor(world.y * 4) * 0.7 + world.x * 5));
        shade *= crack < 0.08 ? 0.68 : 1.0;
    }
    if (material == CLOTH) shade = 0.91 + noise * 0.14;
    if (material == IRON) shade = 0.75 + noise * 0.45;
    if (material == ROAD)
    {
        // Diagonal, irregular slabs avoid long joints lining up with a
        // whole row of pixels when the camera minifies the paving.
        var stones=float2(world.x*0.84+world.z*0.37,world.z*0.84-world.x*0.37);
        var column=Math.Floor(stones.x);
        var uneven=stones.y+Speck(float2(column,71))*1.7;
        var row = Math.Floor(uneven);
        var tile = float2(stones.x + ((int(row) & 1) == 0 ? 0.0 : 0.5), uneven);
        var uv = tile - Math.Floor(tile);
        var seam = Math.Min(Math.Min(uv.x, 1 - uv.x), Math.Min(uv.y, 1 - uv.y));
        shade = seam < 0.025 ? 0.94 : 0.98 + Speck(Math.Floor(tile)) * 0.05;
        // Broken brass road inlays lead through the three districts.
        var lane = Math.Abs(world.x) < 3 || Math.Abs(world.z) < 3;
        base *= lane ? float3(1.09, 1.08, 1.04) : float3(0.77, 0.86, 0.84);
        if (Math.Abs(world.x) > 3.0 && Math.Abs(world.x) < 3.12) base = float3(0.33, 0.28, 0.16);
        if (Math.Abs(world.z) > 3.0 && Math.Abs(world.z) < 3.12) base = float3(0.33, 0.28, 0.16);
        // Drained canals are part of the paving, with wet marble edges.
        var trenchX = Math.Abs(world.x-12);
        var trenchZ = Math.Abs(world.z+20);
        if(trenchX<1.0||trenchZ<1.0) {base=float3(0.085,0.15,0.17);shade=0.87+noise*0.09;}
        if((trenchX>=1.0&&trenchX<1.20)||(trenchZ>=1.0&&trenchZ<1.20)) {base=float3(0.32,0.38,0.36);shade=1;}
    }
    return Color(base.x * shade, base.y * shade, base.z * shade, 1);
}

vert Snap(mut Corner corner, out float4 clip, RenderLight light, Solid solid)
{
    // A small body sway, while feet remain planted; animation is visual only.
    var sway = Math.Sin(solid.gait + corner.position.y * 1.4) * 0.045 * Math.Saturate(corner.position.y) * solid.phase;
    corner.position.x += sway;
    float4 at = this.clip;
    float depth = Math.Max(at.w, 0.0001);
    var seen = Math.Floor(at.xy / depth * light.grid + float2(0.5)) / light.grid;
    clip = float4(seen * depth, at.z, at.w);
}

float Moonlight(DepthTexture depth,float3 world,float3 normal,float4x4 toLamp)
{
    var at=world+normal*0.13;
    var projected=Math.Mul(toLamp,float4(at,1));
    if(Math.Max(Math.Abs(projected.x),Math.Abs(projected.y))>1) return 1;
    return depth.Compare(float2(projected.x*0.5+0.5,0.5-projected.y*0.5),projected.z*0.5+0.5);
}

frag Painted(Corner corner, out Color color, Solid solid, Instance instance, RenderLight light,MoonShadow shadow)
{
    var normal = instance.Normal(corner.normal);
    var paint = FacePaint(corner, this.world);
    var own = corner.own > 0.5 ? float3(1) : float3(solid.tint.r, solid.tint.g, solid.tint.b);
    mut var base = float3(paint.r, paint.g, paint.b) * own;
    if(Math.Round(corner.kind)==STONE&&light.district==0) base*=float3(0.91,1.0,0.97);
    if(Math.Round(corner.kind)==STONE&&light.district==1) base*=float3(0.88,0.93,1.08);
    if(Math.Round(corner.kind)==STONE&&light.district>=2) base*=float3(1.13,0.87,0.86);
    var sun = Math.Max(Math.Dot(normal, Math.Normalize(float3(-0.45, 0.82, -0.35))), 0);
    var moon=Moonlight(shadow.depth,this.world,normal,shadow.toLamp);
    var rim = Math.Max(Math.Dot(normal, Math.Normalize(float3(0.7, 0.18, 0.6))), 0);
    mut var lit = base * (float3(0.65, 0.77, 0.86) * (0.53 + normal.y * 0.08) + float3(1, 0.82, 0.58) * sun * 0.53 * moon + float3(0.38, 0.52, 0.65) * rim * 0.15);
    lit += base * corner.glow * (0.8 + Math.Sin(light.time * 5) * 0.1);
    if (solid.prime > 0) lit = Math.Lerp(lit, float3(0.24, 0.96, 1), 0.43 + Math.Sin(light.time * 9) * 0.10);
    if (solid.flash > 0) lit = Math.Lerp(lit, float3(1, 0.82, 0.6), Math.Saturate(solid.flash * 7));
    var fog = Math.Saturate((Math.Distance(float2(this.world.x, this.world.z), light.focus) - 16) / 29);
    var haze = FogTone(light.district);
    lit = Math.Lerp(lit, float3(haze.r, haze.g, haze.b), fog * fog);
    color = Color(lit.x, lit.y, lit.z, 1);
}

frag GroundPaint(Corner corner, out Color color, RenderLight light,MoonShadow shadow)
{
    var paint = FacePaint(corner, this.world);
    var fromGoal = Math.Distance(float2(this.world.x, this.world.z), light.goal);
    var warm = Math.Saturate(1 - fromGoal / 7) * 0.11;
    mut var base = float3(paint.r + warm, paint.g + warm * 0.72, paint.b);
    var moon=Moonlight(shadow.depth,this.world,float3(0,1,0),shadow.toLamp);
    base*=0.67+moon*0.33;
    var world=float2(this.world.x,this.world.z);
    var lanternA=float2(4,Math.Round((world.y-4)/20)*20+4);
    var lanternB=float2(-4,Math.Round((world.y+4)/20)*20-4);
    var lamp=Math.Saturate(1-Math.Min(Math.Distance(world,lanternA),Math.Distance(world,lanternB))/5);
    base+=float3(0.13,0.075,0.018)*lamp*lamp;
    if(light.district==1) base*=float3(0.83,0.87,1.10);
    if(light.district>=2) base*=float3(1.07,0.83,0.82);
    var far = Math.Distance(float2(this.world.x, this.world.z), light.focus);
    var fog = Math.Saturate((far - 16) / 29);
    var haze = FogTone(light.district);
    base = Math.Lerp(base, float3(haze.r, haze.g, haze.b), fog * fog);
    color = Color(base.x, base.y, base.z, 1);
}

frag SkyPaint(Corner corner,out Color color,Instance instance,RenderLight light)
{
    var normal=instance.Normal(corner.normal);
    var sky=FogTone(light.district);
    var facet=0.53+Math.Max(Math.Dot(normal,Math.Normalize(float3(-0.5,0.7,-0.3))),0)*0.12;
    color=Color(sky.r*facet,sky.g*facet,sky.b*facet,1);
}

frag MarkPaint(Corner corner, out Color color, Decal decal)
{
    var at = float2(corner.position.x, corner.position.z) * 2;
    var far = Math.Length(at);
    if (far > 1) this.Discard();
    if (decal.ring > 0 && far < 1 - decal.ring) this.Discard();
    if (decal.fill < 1)
    {
        var angle = (Math.Atan2(at.x, at.y) + Math.PI) / Math.TAU;
        if (angle > decal.fill) this.Discard();
    }
    color = decal.tint;
}

frag Present(Vertex vertex, out Color color, Texture source, Lens lens, CameraState camera)
{
    var pixel = Math.Floor(vertex.uv * lens.size);
    var seen = source.Sample((pixel + float2(0.5)) / lens.size, Filter.Point);
    var edge = vertex.uv * 2 - float2(1);
    var vignette = 1 - Math.Saturate(Math.Dot(edge, edge) - 0.38) * 0.13;
    var red = camera.health < 30 ? (1 - camera.health / 30) * 0.10 : 0.0;
    var turn=Dither(pixel);
    color = Color(Math.Floor((seen.r*vignette+red)*SHADES+turn)/SHADES,Math.Floor(seen.g*vignette*SHADES+turn)/SHADES,Math.Floor(seen.b*vignette*SHADES+turn)/SHADES,1);
}
