using Rooms;

const Color PAPER = Color(0.92, 0.91, 0.81);
const Color BRASS = Color(0.94, 0.72, 0.38);
const Color QUIET = Color(0.60, 0.69, 0.69);
const Color VOID = Color(0.035, 0.055, 0.065, 0.93);
const Color RED = Color(1, 0.31, 0.24);

local singleton Guide { bool open; }
local singleton HudState { int zone = -1; int seal = -1; RunPhase phase; float banner; }

string WeaponName(int weapon)
{
    if (weapon == 0) return "CARBINE";
    if (weapon == 1) return "SCATTERGUN";
    return "CHIME LANCE";
}
string WeaponDescription(int weapon)
{
    if (weapon == 0) return "Fast piercing shots. Keep a lane open.";
    if (weapon == 1) return "A close, wide blast. Clear a rescue.";
    return "Long, slower strikes. Break dense fronts.";
}
string RelicName(int relic)
{
    switch (relic)
    {
        case 0: return "Hollow Point"; case 1: return "Wide Mouth";
        case 2: return "Quick Fuse"; case 3: return "Iron Lung";
        case 4: return "Pilgrim Boots"; case 5: return "Deep Breath";
        case 6: return "Last Light"; case 7: return "Kindling";
        case 8: return "Twin Mercy"; case 9: return "Brass Echo";
        case 10: return "Second Wind"; case 11: return "Black Powder";
    }
    return "Relic";
}
string RelicDescription(int relic)
{
    switch (relic)
    {
        case 0: return "+20% shot damage"; case 1: return "+25% firing width; +15% reach";
        case 2: return "12% faster reload"; case 3: return "+15 maximum health; heal 15";
        case 4: return "+8% movement speed"; case 5: return "+20 stamina and faster recovery";
        case 6: return "+15% heavy damage"; case 7: return "Priming lasts 1 second longer";
        case 8: return "+2 health when the team mends"; case 9: return "Noise lures last 1 second longer";
        case 10: return "25% faster rescues"; case 11: return "+25% rupture damage";
    }
    return "";
}
string DistrictName(int act)
{
    if (act == 0) return "THE DROWNED WARD";
    if (act == 1) return "THE IRON PROCESSION";
    return "THE ASH CATHEDRAL";
}
string ObjectiveWords(Expedition run)
{
    if (run.phase == RunPhase.March) return "Reach the brass bell. Hold E together to kindle it.";
    if (run.phase == RunPhase.Hold) return run.seal == 2 ? "One thief at each bell. Silence its keeper." : run.seal == 1 ? "Follow the moving bell. Keep together." : "Hold the bell's circle. Keep your partner standing.";
    if (run.phase == RunPhase.Boss) return "Break the Last Cantor. Strike together through the dead.";
    if (run.phase == RunPhase.Sanctuary) return "A moment of silence. Choose a relic for the next crossing.";
    return "";
}

[Before(Rooms.Begin, Rooms.Pages)]
[Stage(Layers.Camera, -4)]
view StyleMenus()
{
    GUI.SetTheme(GUITheme { text = PAPER, panel = VOID, control = Color(0.15, 0.21, 0.22),
        hot = Color(0.24, 0.30, 0.29), pressed = Color(0.08, 0.13, 0.15),
        field = Color(0.04, 0.07, 0.08), fieldHot = Color(0.10, 0.16, 0.17), accent = BRASS, radius = 2 });
}
override string Rooms.Tagline() { return "Two bell thieves. A city that will not stay dead."; }

void Caption(string words, float2 at, float size, Color color, Anchor anchor = Anchor.MiddleCenter)
{
    Draw.Text(words, at + float2(1, 2), size, VOID, anchor, Font.Bold);
    Draw.Text(words, at, size, color, anchor, Font.Bold);
}
void Meter(float2 at, float2 size, float value, Color tone)
{
    Draw.Rect(at + size * 0.5, size, 0, Color(0.07, 0.10, 0.12, 0.9));
    var wide = size.x * Math.Saturate(value);
    Draw.Rect(at + float2(wide * 0.5, size.y * 0.5), float2(wide, size.y), 0, tone);
}

[Stage(Layers.Hud, -2)]
view RoomSeats(Expedition run, CameraState camera, mut Rooms.Lobby lobby)
{
    lobby.seats = 2;
    lobby.manned = (run.player0 != default ? 1 : 0) | (run.player1 != default ? 2 : 0);
    lobby.mine = camera.seat;
    lobby.offersNewGame = false;
    lobby.offersBots = false;
}

[Stage(Layers.Hud)]
view Status(Expedition run, CameraState camera, Lens lens, Rooms.Lobby lobby, Session session,
            mut HudState hud, query (Hero hero, Owner owner) heroes)
{
    Draw.SetScreen();
    if (lobby.page != Rooms.Page.Playing) return;
    var narrow = Screen.width < 640;
    if (run.zone != hud.zone || run.seal != hud.seal || run.phase != hud.phase)
    {
        hud.zone = run.zone;
        hud.seal = run.seal;
        hud.phase = run.phase;
        hud.banner = 6;
    }
    hud.banner = Math.Max(0, hud.banner - Frame.dt);
    if (run.phase == RunPhase.Waiting) return;
    var top = float2(Screen.width * 0.5, 22);
    Caption(DistrictName(run.act), top, narrow ? 13 : 17, BRASS);
    var seconds = int(run.clock);
    var time = seconds % 60 < 10 ? $"{seconds / 60}:0{seconds % 60}" : $"{seconds / 60}:{seconds % 60}";
    Caption($"SEAL {Math.Min(run.zone * 3 + run.seal + 1, 9)} / 9  |  {time}", top + float2(0, 22), 12, QUIET);
    if (run.phase == RunPhase.Hold || run.phase == RunPhase.Boss)
    {
        var width = Math.Min(270, Screen.width - 32);
        var progress = run.phase == RunPhase.Boss ? run.bossHealth / Math.Max(1, run.bossMax) : run.objective / Math.Max(1, run.objectiveNeed);
        Meter(float2((Screen.width - width) * 0.5, 57), float2(width, 5), progress, run.phase == RunPhase.Boss ? RED : BRASS);
    }
    foreach (var entry in heroes)
    {
        var hero = entry.hero;
        if (!hero.active) continue;
        var mine = entry.owner.player == session.player;
        var x = hero.seat == 0 ? 18.0 : Screen.width - (narrow ? 132 : 190);
        var y = narrow ? 88.0 : 21.0;
        var width = narrow ? 114.0 : 172.0;
        Caption(mine ? "YOU" : "PARTNER", float2(x, y), 12, PlayerTone(hero.seat), Anchor.UpperLeft);
        Meter(float2(x, y + 20), float2(width, 7), hero.health / (100 + hero.relics[3] * 15), hero.down ? RED : PlayerTone(hero.seat));
        Meter(float2(x, y + 31), float2(width, 3), hero.stamina / (100 + hero.relics[5] * 20), QUIET);
        if (hero.down) Caption(narrow ? "DOWN / E RESCUE" : "DOWNED — HOLD E TO RESCUE", float2(x, y + 42), 10, RED, Anchor.UpperLeft);
        else if (!narrow) Caption(WeaponName(hero.weapon), float2(x, y + 42), 11, QUIET, Anchor.UpperLeft);
        if (!mine && lens.made)
        {
            var projected = lens.scene.WorldToScreen(Raised(hero.pos, 2.7));
            var pixel = float2(projected.x, projected.y) * lens.scale;
            var at = float2(Math.Clamp(pixel.x, 30, Screen.width - 30), Math.Clamp(pixel.y, 148, Screen.height - 110));
            if (hero.down || Math.Distance(camera.mineAt, hero.pos) > 25)
                Caption(hero.down ? "RESCUE" : "PARTNER", at, 12, hero.down ? RED : PlayerTone(hero.seat));
        }
    }
    if (hud.banner > 0 && run.phase != RunPhase.Sanctuary && run.phase != RunPhase.Victory && run.phase != RunPhase.Defeat)
        Caption(ObjectiveWords(run), float2(Screen.width * 0.5, narrow ? 143 : 92), narrow ? 11 : 14, PAPER);
    if ((run.phase == RunPhase.March || run.phase == RunPhase.Hold) && lens.made)
    {
        var projected = lens.scene.WorldToScreen(Raised(run.goal, 2.8));
        var pixel = float2(projected.x, projected.y) * lens.scale;
        var at = float2(Math.Clamp(pixel.x, 40, Screen.width - 40), Math.Clamp(pixel.y, 160, Screen.height - 116));
        Caption("BELL", at, 12, BRASS);
        if (run.phase == RunPhase.Hold && run.seal == 2)
        {
            var other = lens.scene.WorldToScreen(Raised(run.goalB, 2.8));
            var there = float2(Math.Clamp(other.x * lens.scale.x, 40, Screen.width - 40), Math.Clamp(other.y * lens.scale.y, 160, Screen.height - 116));
            Caption("SECOND BELL", there, 12, BRASS);
        }
        if (run.phase == RunPhase.March && !run.cacheTaken)
        {
            var cache = lens.scene.WorldToScreen(Raised(run.cache, 2.8));
            if (cache.x >= 0 && cache.y >= 0 && cache.x < lens.size.x && cache.y < lens.size.y)
                Caption("CACHE / DOUBLE RELIC", float2(cache.x, cache.y) * lens.scale, 10, BRASS);
        }
    }
    if (!narrow)
    {
        Caption($"{run.live} WAKING  /  {run.kills} SILENCED", float2(Screen.width * 0.5, Screen.height - 52), 11, QUIET);
        Caption("WASD move   LMB fire   RMB prime   SPACE dash   Q lure   E rescue / bell   H guide",
                float2(Screen.width * 0.5, Screen.height - 28), 11, QUIET);
    }
    if (session.state == SessionState.Connecting)
        Caption("Rejoining the expedition...", float2(Screen.width * 0.5, Screen.height * 0.5), 18, PAPER);
    else if (run.connected < 2 && !run.testBots)
        Caption("Waiting for your partner to rejoin", float2(Screen.width * 0.5, Screen.height * 0.5), narrow ? 13 : 18, PAPER);
}

[Stage(Layers.Hud, 5)]
view Decisions(Expedition run, Session session, CameraState camera, Rooms.Lobby lobby,
               query (Hero hero, Owner owner) heroes)
{
    if (lobby.page != Rooms.Page.Playing) return;
    mut var self = Hero { };
    foreach (var entry in heroes) if (entry.owner.player == session.player) self = entry.hero;
    var width = Math.Min(360, Screen.width - 32);
    GUI.Navigate();
    if (run.phase == RunPhase.Waiting)
    {
        GUILayout.Area(Rect((Screen.width - width) * 0.5, Screen.height * 0.5 - 170, width, 340))
        {
            GUILayout.Label("DEADBELL");
            GUILayout.Label("A private expedition for two");
            GUILayout.Label("Steal nine seals. Silence the Last Cantor.");
            GUILayout.Space(8);
            for (var weapon = 0; weapon < 3; weapon++)
            {
                if (GUILayout.Button((self.weapon == weapon ? "> " : "") + WeaponName(weapon)))
                    camera.mine.Send(EquipWeapon { weapon = weapon });
            }
            GUILayout.Label(WeaponDescription(self.weapon));
            GUILayout.Space(8);
            GUILayout.Label(run.connected >= 2 ? "Both thieves are here." : "Invite your partner through Menu > Host a room.");
            GUI.Disabled(run.connected < 2 || !session.server)
            {
                if (GUILayout.Button(session.server ? "Begin expedition" : "Waiting for the host")) Send(StartRun { });
            }
        }
    }
    else if (run.phase == RunPhase.Sanctuary)
    {
        GUILayout.Area(Rect((Screen.width - width) * 0.5, Screen.height * 0.5 - 180, width, 365))
        {
            GUILayout.Label("A MOMENT OF SILENCE");
            GUILayout.Label("Choose one relic. Its power stacks.");
            GUILayout.Label($"Choose within {Math.Max(0, int(DRAFT_SECONDS - run.phaseTime))} seconds.");
            GUILayout.Label("First relic binds if time runs out.");
            GUILayout.Space(8);
            if (self.ready) GUILayout.Label("Your relic is bound. Waiting for your partner.");
            else for (var slot = 0; slot < 3; slot++)
            {
                var relic = RelicOffer(run.zone * 3 + run.seal, slot, camera.seat, run.seed);
                if (GUILayout.Button(RelicName(relic))) camera.mine.Send(ChooseRelic { choice = slot });
                GUILayout.Label(RelicDescription(relic));
                GUILayout.Space(4);
            }
        }
    }
    else if (run.phase == RunPhase.Victory || run.phase == RunPhase.Defeat)
    {
        GUILayout.Area(Rect((Screen.width - width) * 0.5, Screen.height * 0.5 - 105, width, 235))
        {
            GUILayout.Label(run.phase == RunPhase.Victory ? "THE CITY IS SILENT" : "THE BELL CLAIMED TWO MORE");
            GUILayout.Label(run.phase == RunPhase.Victory ? "You carried the last light home." : "A different loadout. Another crossing.");
            GUILayout.Space(10);
            GUILayout.Label($"{run.kills} dead silenced. {run.ruptures} ruptures.");
            GUILayout.Label($"{run.peak} enemies at once. {run.riskCount} caches stolen.");
            GUILayout.Label($"{int(run.clock) / 60} minutes together.");
            GUI.Disabled(!session.server)
            {
                if (GUILayout.Button(session.server ? "Prepare another expedition" : "Waiting for the host")) Send(RestartRun { });
            }
        }
    }
}

[Stage(Layers.Hud, 8)]
view FieldGuide(Devices devices, Rooms.Lobby lobby, mut Guide guide)
{
    if (lobby.page != Rooms.Page.Playing) { guide.open = false; return; }
    if (devices.keyboard.h.down || devices.gamepad.select.down) guide.open = !guide.open;
    if (GUI.Button(Rect(104, devices.touchscreen.connected ? Screen.height - 128 : Screen.height - 44, 54, 32), "Guide")) guide.open = true;
    if (!guide.open) return;
    GUI.Navigate();
    GUILayout.Modal(Anchor.MiddleCenter, guide.open)
    {
        GUILayout.Label("THE THIEVES' FIELD GUIDE");
        if (Screen.height < 700)
        {
            GUILayout.Label("Move WASD/stick; aim mouse/stick.");
            GUILayout.Label("Fire LMB/RT; prime RMB/LT.");
            GUILayout.Label("Dash Space/bottom; lure Q/left.");
            GUILayout.Label("Hold E/top: bell, cache, rescue.");
            GUILayout.Label("Partner hits rupture cyan targets.");
            GUILayout.Label("Rescue: hold E nearby for 3 sec.");
            GUILayout.Label("Both down ends it. Menus stay live.");
            if (Screen.height >= 500)
            {
                GUILayout.Space(8);
                GUILayout.Label("Both hold E by a bell to kindle it.");
                GUILayout.Label("Split bells need one thief at each.");
                GUILayout.Label("Side caches double your next relic.");
                GUILayout.Label("They heal, but draw a bigger surge.");
            }
        }
        else
        {
            GUILayout.Label("Move: WASD / arrows / left stick.");
            GUILayout.Label("Aim: mouse / right stick.");
            GUILayout.Label("Fire: LMB / right trigger.");
            GUILayout.Label("Prime: RMB / left trigger.");
            GUILayout.Label("Dash: Space / bottom face button.");
            GUILayout.Label("Lure: Q / left face button.");
            GUILayout.Label("Hold E / top: bell, cache, rescue.");
            GUILayout.Space(8);
            GUILayout.Label("Heavy strikes prime survivors cyan.");
            GUILayout.Label("Your partner's attacks rupture them.");
            GUILayout.Label("Ruptures restore a little team health.");
            GUILayout.Label("Downed? Crawl toward your partner.");
            GUILayout.Label("Rescue takes three seconds. Cover it.");
            GUILayout.Label("Both hold E by a bell to kindle it.");
            GUILayout.Label("Side caches double your next relic.");
            GUILayout.Label("They heal, but draw a bigger surge.");
            GUILayout.Label("Both down ends the expedition.");
            GUILayout.Label("Menus keep combat running.");
        }
        if (GUILayout.Button("Back to the crossing")) guide.open = false;
    }
}

[Stage(Layers.Hud, 10)]
view TouchKeys(Hand hand)
{
    if (!hand.touched || !hand.playing) return;
    Draw.SetScreen();
    for (var i = 0; i < 4; i++)
    {
        var at = float2(Screen.width - 224 + i * 64, Screen.height - 65);
        Draw.Circle(at, 27, Color(0.06, 0.10, 0.12, 0.82));
        Draw.WireCircle(at, 27, 1, QUIET);
        Caption(i == 0 ? "E" : i == 1 ? "Q" : i == 2 ? "DASH" : "HEAVY", at, 10, PAPER);
    }
}
