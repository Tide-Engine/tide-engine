// The battlefield stays open. Low memorials and paving are walkable, while
// the broken buildings stand beyond the simulation's enclosing city wall.
struct CityProp
{
    float2 at;
    float turn;
    float size = 1;
    int kind;
}

local singleton City
{
    List<CityProp> props;
    bool made;
}

void MakeCity(mut City city)
{
    if (city.made) return;
    city.made = true;
    for (var z = -12; z <= 12; z++)
    {
        for (var x = -12; x <= 12; x++)
        {
            if (x == 0 || z == 0) continue;
            var hash = Math.Hash(int2(x, z));
            var at = float2(x * 8 + (hash & 7) * 0.22, z * 8 + ((hash >> 3) & 7) * 0.22);
            city.props.Add(CityProp {at=at,turn=(hash & 255) * Math.TAU / 255,size=0.7 + ((hash >> 8) & 7) * 0.09,kind=(hash & 3)==0 ? 0 : 1});
        }
    }
    for (var i = -10; i <= 10; i++)
    {
        city.props.Add(CityProp {at=float2(i*10,108),kind=2,turn=Math.PI});
        city.props.Add(CityProp {at=float2(i*10,-108),kind=2});
        city.props.Add(CityProp {at=float2(108,i*10),kind=2,turn=-Math.PI*0.5});
        city.props.Add(CityProp {at=float2(-108,i*10),kind=2,turn=Math.PI*0.5});
        if (i % 2 == 0)
        {
            city.props.Add(CityProp {at=float2(4,i*10+4),kind=3});
            city.props.Add(CityProp {at=float2(-4,i*10-4),kind=3,turn=Math.PI});
            city.props.Add(CityProp {at=float2(i*10+4,4),kind=3});
            city.props.Add(CityProp {at=float2(i*10-4,-4),kind=3,turn=Math.PI});
        }
    }
    // Fallen chapels and courtyards give the open battlefield landmarks.
    for(var z=-4;z<=4;z++)
        for(var x=-4;x<=4;x++)
        {
            if(x==0&&z==0) continue;
            var hash=Math.Hash(int2(x+91,z-57));
            city.props.Add(CityProp {at=float2(x*21+5,z*21+5),kind=4,turn=((hash&3)*Math.PI*0.5),size=0.9+((hash>>5)&3)*0.1});
        }
    city.props.Add(CityProp {at=float2(-11,-12),kind=4,turn=0.18,size=1.4});
    city.props.Add(CityProp {at=float2(16,-13),kind=4,turn=-0.42,size=1.2});
}

Solid PlacedPiece(float2 at, float y, float turn, float scale)
{
    return Solid {transform=float4x4.TRS(Raised(at,y),quaternion.AxisAngle(float3(0,1,0),turn),float3(scale))};
}

void CircleMark(mut List<Decal> marks, float2 at, float size, Color color, float ring, float fill)
{
    marks.Add(Decal {transform=float4x4.TRS(Raised(at,0.035),quaternion.identity,float3(size,1,size)),tint=color,ring=ring,fill=fill});
}

[Stage(Layers.Gather)]
view GatherCity(mut City city, mut Visuals visuals, RenderLight light, Expedition expedition)
{
    MakeCity(city);
    // A fogged skyline is a camera backdrop, beyond the view's walkable
    // ground. Keeping it distant avoids adding false collision obstacles.
    for(var i=-4;i<=4;i++)
    {
        var at=light.focus+float2(i*10,42+Math.Abs(i)*2);
        var scale=0.70+float((i+5)%3)*0.18;
        visuals.skyline.Add(PlacedPiece(at,-1,i*0.22,scale));
    }
    foreach (var prop in city.props)
    {
        if (Math.DistanceSq(prop.at,light.focus)>42*42) continue;
        mut var solid=PlacedPiece(prop.at,0,prop.turn,prop.size);
        if (prop.kind==0) visuals.graves.Add(solid);
        else if(prop.kind==1) visuals.rubble.Add(solid);
        else if(prop.kind==2) visuals.ruins.Add(solid);
        else if(prop.kind==3) visuals.lamps.Add(solid);
        else visuals.foundations.Add(solid);
    }
    // Every seal has the low circular footings of a demolished chapel.
    for(var i=0;i<6;i++)
    {
        var turn=i*Math.TAU/6;
        var at=expedition.anchor+float2(Math.Cos(turn),Math.Sin(turn))*10;
        if(Math.DistanceSq(at,light.focus)<40*40) visuals.foundations.Add(PlacedPiece(at,0,turn+Math.PI*0.5,0.76));
    }
    if(Math.DistanceSq(expedition.goal,light.focus)<45*45)
    {
        visuals.bells.Add(PlacedPiece(expedition.goal,0,0,1));
        var pulse=0.78+Math.Sin(light.time*2)*0.10;
        CircleMark(visuals.warnings,expedition.goal,6.2,Color(0.84,0.71,0.26,pulse),0.045,1);
        var fraction=Math.Saturate(expedition.objective/Math.Max(expedition.objectiveNeed,1));
        CircleMark(visuals.warnings,expedition.goal,5.5,Color(1,0.89,0.45,0.8),0.08,fraction);
        for(var i=0;i<7;i++)
        {
            var turn=light.time*0.8+i*Math.TAU/7;
            var cycle=(light.time+i*0.4)/3;
            var at=Raised(expedition.goal+float2(Math.Cos(turn),Math.Sin(turn))*1.1,0.65+(cycle-Math.Floor(cycle))*2.1);
            var size=0.055+Math.Sin(light.time*3+i)*0.015;
            visuals.sparks.Add(Solid {transform=float4x4.TRS(at,quaternion.identity,float3(size)),tint=Color(1,0.79,0.24),flash=1});
        }
    }
    if(!expedition.cacheTaken&&Math.DistanceSq(expedition.cache,light.focus)<40*40)
    {
        CircleMark(visuals.warnings,expedition.cache,3.5,Color(0.69,0.31,0.68,0.7),0.08,1);
        mut var solid=PlacedPiece(expedition.cache,0.2,Math.PI*0.25,0.55);
        solid.tint=Color(0.73,0.35,0.70);
        solid.prime=0;
        visuals.bells.Add(solid);
    }
}

[Stage(Layers.World)]
view DrawCity(Models models,Lens lens,RenderLight light,Visuals visuals)
{
    lens.scene.Clear(FogTone(light.district));
    lens.scene.Instanced(models.skyline,models.skylineFaces,visuals.skyline,SkyPaint);
    lens.scene.Mesh(models.road,models.roadFaces,float4x4.identity,GroundPaint);
    lens.scene.Instanced(models.grave,models.graveFaces,visuals.graves,Snap,Painted);
    lens.scene.Instanced(models.rubble,models.rubbleFaces,visuals.rubble,Snap,Painted);
    lens.scene.Instanced(models.foundation,models.foundationFaces,visuals.foundations,Snap,Painted);
    lens.scene.Instanced(models.ruin,models.ruinFaces,visuals.ruins,Snap,Painted);
    lens.scene.Instanced(models.lamp,models.lampFaces,visuals.lamps,Snap,Painted);
    lens.scene.Instanced(models.bell,models.bellFaces,visuals.bells,Snap,Painted);
}
