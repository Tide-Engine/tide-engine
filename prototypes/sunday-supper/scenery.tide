// What stands still, as meshes this machine makes once from the farm's plan:
// every wall, floor, step and roof in one mesh, each corner saying what its
// face is made of; the windows' panes in another, drawn see-through; and
// the kits' models, a list of where each stands.

// A corner of anything drawn: the plan's boxes, the kits' models and the
// people all use it. A model from a file fills `position`, `normal`, `uv` and
// `color` (its material's); the rest is the plan's.
struct Corner
{
    float3 position;
    float3 normal;
    float2 uv;
    Color color = Color.white;
    float stuff;          // A Stuff
    float inside;         // 1 under a roof: the sky lights it less
}

// One model drawn somewhere: where, and whether it's indoors.
struct Placed
{
    float4x4 transform = float4x4.identity;
    float inside;
}

local singleton Scenery
{
    List<Corner> mesh;
    List<int> faces;
    List<Corner> panes;
    List<int> paneFaces;
    List<Prop> props;
    bool made;
}

const float FACE_STEP = 6;    // Big faces are cut into squares no bigger than this, for the picture's wobble

Color FaceTint(Stuff stuff, Color tint)
{
    if (stuff == Stuff.Siding) return Color(0.74, 0.72, 0.66);
    if (stuff == Stuff.Shingle) return Color(0.25, 0.24, 0.24);
    if (stuff == Stuff.Trim) return Color(0.8, 0.78, 0.72);
    return tint;
}

// A flat four-cornered face, cut into a grid of squares: `origin` and two edges from it, facing `normal`.
void PutFace(mut List<Corner> corners, mut List<int> faces, float3 origin, float3 along, float3 up, float3 normal, Stuff stuff, Color tint, float hint)
{
    // Under a roof or not goes by what the face looks out on, not what it belongs to
    var middle = origin + (along + up) * 0.5 + normal * 0.3;
    var inside = hint > 0.5 ? InsideAt(middle) : 0.0;
    var columns = Math.Max(1, int(Math.Ceil(Math.Length(along) / FACE_STEP)));
    var rows = Math.Max(1, int(Math.Ceil(Math.Length(up) / FACE_STEP)));
    var color = FaceTint(stuff, tint);
    // Which way round the corners go: their front is the side the normal is on
    var flip = Math.Dot(Math.Cross(along, up), normal) < 0;
    for (var row = 0; row < rows; row++)
    {
        for (var column = 0; column < columns; column++)
        {
            var first = corners.count;
            for (var corner = 0; corner < 4; corner++)
            {
                var a = column + (corner == 1 || corner == 2 ? 1 : 0);
                var b = row + (corner >= 2 ? 1 : 0);
                var at = origin + along * (float(a) / columns) + up * (float(b) / rows);
                corners.Add(Corner { position = at, normal = normal, color = color, stuff = float(int(stuff)), inside = inside });
            }
            if (!flip)
            {
                faces.Add(first);
                faces.Add(first + 1);
                faces.Add(first + 2);
                faces.Add(first);
                faces.Add(first + 2);
                faces.Add(first + 3);
            }
            else
            {
                faces.Add(first);
                faces.Add(first + 2);
                faces.Add(first + 1);
                faces.Add(first);
                faces.Add(first + 3);
                faces.Add(first + 2);
            }
        }
    }
}

void PutTriangle(mut List<Corner> corners, mut List<int> faces, float3 a, float3 b, float3 c, float3 normal, Stuff stuff, Color tint, float inside)
{
    var first = corners.count;
    var color = FaceTint(stuff, tint);
    var flip = Math.Dot(Math.Cross(b - a, c - a), normal) < 0;
    corners.Add(Corner { position = a, normal = normal, color = color, stuff = float(int(stuff)), inside = inside });
    corners.Add(Corner { position = flip ? c : b, normal = normal, color = color, stuff = float(int(stuff)), inside = inside });
    corners.Add(Corner { position = flip ? b : c, normal = normal, color = color, stuff = float(int(stuff)), inside = inside });
    faces.Add(first);
    faces.Add(first + 1);
    faces.Add(first + 2);
}

// A box: its broad faces (across its thinnest axis) are `front` (facing the axis' way) and `back`; the rest `edge`.
void PutPiece(mut List<Corner> corners, mut List<int> faces, Piece piece)
{
    var lo = piece.center - piece.size * 0.5;
    var size = piece.size;
    var thin = size.x <= size.y && size.x <= size.z ? 0 : size.y <= size.z ? 1 : 2;
    var inside = piece.inside ? 1.0 : 0.0;
    for (var axis = 0; axis < 3; axis++)
    {
        for (var side = 0; side < 2; side++)
        {
            var way = side == 0 ? 1.0 : -1.0;
            var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
            mut Stuff stuff = piece.edge;
            if (axis == thin) stuff = side == 0 ? piece.front : piece.back;
            float3 along = axis == 0 ? float3(0, 0, size.z) : axis == 1 ? float3(size.x, 0, 0) : float3(size.x, 0, 0);
            float3 up = axis == 0 ? float3(0, size.y, 0) : axis == 1 ? float3(0, 0, size.z) : float3(0, size.y, 0);
            var origin = lo + (side == 0 ? normal * float3(size.x, size.y, size.z) : float3(0));
            PutFace(corners, faces, origin, along, up, normal, stuff, piece.tint, inside);
        }
    }
}

void PutRoof(mut List<Corner> corners, mut List<int> faces, Piece piece)
{
    var ridge = float3(piece.center.x, piece.center.y + piece.size.y, piece.center.z);
    var length = piece.size.z;
    var z0 = piece.center.z - length * 0.5;
    var west = float3(piece.center.x - piece.size.x, piece.center.y, z0);
    var east = float3(piece.center.x + piece.size.x, piece.center.y, z0);
    var top = float3(ridge.x, ridge.y, z0);
    var run = float3(0, 0, length);
    var westNormal = Math.Normalize(float3(-piece.size.y, piece.size.x, 0));
    var eastNormal = Math.Normalize(float3(piece.size.y, piece.size.x, 0));
    // Each slope, outside and in
    PutFace(corners, faces, west, run, top - west, westNormal, piece.front, piece.tint, 0);
    PutFace(corners, faces, east, run, top - east, eastNormal, piece.front, piece.tint, 0);
    PutFace(corners, faces, west + float3(0, -0.06, 0), run, top - west, westNormal * -1.0, Stuff.Planks, Color(0.36, 0.3, 0.24), 1);
    PutFace(corners, faces, east + float3(0, -0.06, 0), run, top - east, eastNormal * -1.0, Stuff.Planks, Color(0.36, 0.3, 0.24), 1);
    // The gables, a little in from the eaves' ends
    var inset = 0.4;
    var shrink = (piece.size.x - inset) / piece.size.x;
    for (var end = 0; end < 2; end++)
    {
        var z = end == 0 ? z0 + inset : z0 + length - inset;
        var normal = float3(0, 0, end == 0 ? -1.0 : 1.0);
        var a = float3(piece.center.x - piece.size.x * shrink, piece.center.y, z);
        var b = float3(piece.center.x + piece.size.x * shrink, piece.center.y, z);
        var c = float3(ridge.x, piece.center.y + piece.size.y * shrink, z);
        PutTriangle(corners, faces, a, b, c, normal, piece.back, piece.tint, 0);
        PutTriangle(corners, faces, a, b, c, normal * -1.0, Stuff.Planks, Color(0.36, 0.3, 0.24), 1);
    }
}

void MakeScenery(mut Scenery scenery)
{
    var plan = MakePlan();
    scenery.mesh.Clear();
    scenery.faces.Clear();
    scenery.panes.Clear();
    scenery.paneFaces.Clear();
    foreach (var piece in plan.pieces)
    {
        if (piece.roof) PutRoof(scenery.mesh, scenery.faces, piece);
        else if (piece.front == Stuff.Glass) PutPiece(scenery.panes, scenery.paneFaces, piece);
        else PutPiece(scenery.mesh, scenery.faces, piece);
    }
    // The ground under everything: grass, as far as the fog lets anyone see
    PutFace(scenery.mesh, scenery.faces, float3(-140, 0, -300), float3(320, 0, 0), float3(0, 0, 480), float3(0, 1, 0), Stuff.Grass, Color(0.33, 0.36, 0.2), 0);
    scenery.props = plan.props;
    scenery.made = true;
}
