// The Hale farm and the road to it, as one plan: boxes that are walls,
// floors, stairs and furniture, each with what it's made of; the doors;
// the furniture and trees from the kits; and the spots a traveller can do
// something at. The match makes the plan once and keeps what it walks into
// (Farm); each machine makes it again to draw it (scenery.tide). The same
// function makes both, so they agree.
//
// Metres. +z is north, up the road; +x is east. The road runs north along
// x = 0. The lane leaves it eastward at z 38 for the house, whose front
// faces west onto the porch. The barn is behind the house, the corn south
// of the yard, the woods east past the fence.

// What a surface is made of, which its frag paints it by (render.tide).
enum Stuff
{
    Plain,
    Wallpaper,
    Planks,
    Siding,
    Shingle,
    Gravel,
    Grass,
    Dirt,
    Plaster,
    Trim,
    Barnwood,
    Stone,
    Tile,
    Glass,
    Hay,
    Carpet,
    Brick,
    Glow,
    Asphalt,
    Tarp,
    Bulb,
}

// A box of the plan that's drawn: its middle and size, what its two broad
// faces are made of (the one that faces along its thinnest axis, and the one
// that faces back), what its edges are made of, its tint, and whether it's
// under a roof (lit less by the sky).
struct Piece
{
    float3 center;
    float3 size;
    Stuff front;
    Stuff back;
    Stuff edge;
    Color tint = Color.white;
    bool inside;
    bool roof;         // Two slopes instead: ridge along z over `center.x`, eaves `size.x` either side at
                       // `center.y`, `size.y` up to the ridge, `size.z` long; gable ends of `back`
}

// A box the travellers walk into, or stand on.
struct Solid
{
    float3 center;
    float3 half;
    int door = -1;     // It's this door's while it's shut: it's not there once it's open
}

// A door: it turns about its hinge, from shut to `swing` radians open.
struct Door
{
    float3 hinge;
    float shut;        // While it's shut its width runs from the hinge along Flat(shut); open, along Flat(shut + swing)
    float swing = 1.6;
    float wide = 0.9;
    float high = 2.05;
    float open;        // 0 shut, 1 open
    float goal;
    bool locked;
    Color tint = Color(0.5, 0.42, 0.33);
}

// The kits' models, by what they are.
enum Model
{
    Bed,
    Chair,
    Table,
    TableCloth,
    Stove,
    Sink,
    Fridge,
    Cabinet,
    CabinetUpper,
    Sofa,
    Armchair,
    Television,
    Radio,
    TableLamp,
    FloorLamp,
    SideTable,
    Drawers,
    Bookcase,
    Rug,
    RugRound,
    CoatRack,
    Bathtub,
    Toilet,
    BathSink,
    Mirror,
    Box,
    Nightstand,
    Pillow,
    Books,
    Trashcan,
    Washer,
    WallLamp,
    Corn,
    CornYoung,
    Oak,
    DarkTree,
    Birch,
    Pine,
    PineDark,
    Fence,
    Gate,
    Stump,
    Logs,
    Rock,
    Tuft,
    Bush,
    Bucket,
    Barrel,
    Crate,
    Pickaxe,
    Shovel,
    Workbench,
    Sedan,
    Hatchback,
}

// A model put somewhere: where its foot is, which way it's turned, how big.
struct Prop
{
    Model model;
    float3 at;
    float yaw;
    float scale = 1;
    bool inside;
}

// What a traveller can do something at.
enum Spot
{
    CarHood,
    CarDoor,
    Mailbox,
    FrontDoor,
    Phone,
    SeatSam,
    SeatJo,
    GuestDoor,
    BedSam,
    BedJo,
    Drawer,
    GuestWindow,
    HalesDoor,
    DaleDoor,
    BathDoor,
    BackDoor,
    Sack0,
    Sack1,
    Sack2,
    FeedBin,
    Tarp,
    Clock,
    Photos,
    Count,
}

struct SpotAt
{
    Spot spot;
    float3 at;
    float radius = 0.35;
}

struct Plan
{
    List<Piece> pieces;
    List<Solid> solids;
    List<Prop> props;
    List<SpotAt> spots;
    Door[8] doors;
    int doorCount;
}

// What the match keeps of the plan: what's walked into and stood on, the doors, the spots.
singleton Farm
{
    List<Solid> solids;
    Door[8] doors;
    int doorCount;
    List<SpotAt> spots;
}

enum DoorId { Front, Back, Guest, Hales, Dale, Bath }

const float3 CAR_AT = float3(1.4, 0, -110);
const float GROUND = 0;
const float F1 = 0.6;          // The ground floor
const float F1_CEILING = 3.3;
const float F2 = 3.5;          // Upstairs
const float F2_CEILING = 6.0;
const float HOUSE_X = 28;      // The house's front (west) wall, and its south wall
const float HOUSE_Z = 34;
const float HOUSE_DEEP = 8;    // Front to back
const float HOUSE_WIDE = 10;   // South to north
const float WALL = 0.16;
const float STAIR_FROM = 3.2;  // The stairs climb east along the hall's south half, from here...
const int STAIR_STEPS = 16;
const float STAIR_RUN = 0.25;
const float BARN_X = 46;
const float BARN_Z = 30;
const float BARN_DEEP = 10;
const float BARN_WIDE = 14;
const float BARN_HIGH = 5.2;

// Where the Hales are as the travellers knock.
const float3 HOME_WALT = float3(32.05, F1, 42.3);
const float3 HOME_RUTH = float3(35.0, F1, 43.3);
const float3 HOME_DALE = float3(-7, 0, -58);

// A place in the house: `u` metres back from its front wall, `v` north of its south wall, `y` up.
float3 House(float u, float y, float v)
{
    return float3(HOUSE_X + u, y, HOUSE_Z + v);
}

float StairRise()
{
    return (F2 - F1) / STAIR_STEPS;
}

Piece Slab(float3 lo, float3 hi, Stuff front, Stuff back, Stuff edge, Color tint, bool inside)
{
    return Piece { center = (lo + hi) * 0.5, size = hi - lo, front = front, back = back, edge = edge, tint = tint, inside = inside };
}

void Block(mut Plan plan, float3 lo, float3 hi, Stuff front, Stuff back, Stuff edge, Color tint, bool inside, bool solid)
{
    if (hi.x - lo.x <= 0.001 || hi.y - lo.y <= 0.001 || hi.z - lo.z <= 0.001) return;
    plan.pieces.Add(Slab(lo, hi, front, back, edge, tint, inside));
    if (solid) plan.solids.Add(Solid { center = (lo + hi) * 0.5, half = (hi - lo) * 0.5 });
}

// A wall with openings: it runs `along` x (or z) from `from` to `to`, its middle at `at` the other way, from
// `low` to `high`. Each opening is (from, to, bottom, top) along the same axis. `outward` is the stuff of the
// face that looks toward +z (or +x), `inward` the other.
void Wall(mut Plan plan, bool alongX, float at, float from, float to, float low, float high, List<float4> holes,
          Stuff outward, Stuff inward, Color tint, bool inside)
{
    mut var cursor = from;
    foreach (var hole in holes)
    {
        WallPart(plan, alongX, at, cursor, hole.x, low, high, outward, inward, tint, inside);
        WallPart(plan, alongX, at, hole.x, hole.y, low, hole.z, outward, inward, tint, inside);
        WallPart(plan, alongX, at, hole.x, hole.y, hole.w, high, outward, inward, tint, inside);
        cursor = hole.y;
    }
    WallPart(plan, alongX, at, cursor, to, low, high, outward, inward, tint, inside);
}

void WallPart(mut Plan plan, bool alongX, float at, float from, float to, float low, float high, Stuff outward, Stuff inward, Color tint, bool inside)
{
    if (to - from < 0.001 || high - low < 0.001) return;
    var lo = alongX ? float3(from, low, at - WALL * 0.5) : float3(at - WALL * 0.5, low, from);
    var hi = alongX ? float3(to, high, at + WALL * 0.5) : float3(at + WALL * 0.5, high, to);
    Block(plan, lo, hi, outward, inward, Stuff.Trim, tint, inside, true);
}

float4 Opening(float from, float to, float bottom, float top)
{
    return float4(from, to, bottom, top);
}

int AddDoor(mut Plan plan, float3 hinge, float shut, float swing, float wide, Color tint, bool locked)
{
    var id = plan.doorCount;
    plan.doors[id] = Door { hinge = hinge, shut = shut, swing = swing, wide = wide, tint = tint, locked = locked };
    plan.doorCount += 1;
    // While it's shut it's a slab across its doorway
    var across = Flat(shut);
    var middle = hinge + across * (wide * 0.5) + float3(0, 1.03, 0);
    var half = float3(Math.Abs(across.x) * wide * 0.5 + 0.06, 1.03, Math.Abs(across.z) * wide * 0.5 + 0.06);
    plan.solids.Add(Solid { center = middle, half = half, door = id });
    return id;
}

void AddProp(mut Plan plan, Model model, float3 at, float yaw, float scale, bool inside)
{
    plan.props.Add(Prop { model = model, at = at, yaw = yaw, scale = scale, inside = inside });
}

// A piece of furniture, and the box it takes up for walking.
void Furnish(mut Plan plan, Model model, float3 at, float yaw, float scale, float3 blocks)
{
    AddProp(plan, model, at, yaw, scale, true);
    if (blocks.y > 0) plan.solids.Add(Solid { center = at + float3(0, blocks.y * 0.5, 0), half = float3(blocks.x, blocks.y, blocks.z) * 0.5 });
}

void AddSpot(mut Plan plan, Spot spot, float3 at, float radius)
{
    plan.spots.Add(SpotAt { spot = spot, at = at, radius = radius });
}

Plan MakePlan()
{
    mut var plan = Plan { };
    BuildGround(plan);
    BuildHouse(plan);
    BuildBarn(plan);
    BuildYard(plan);
    return plan;
}

void BuildFarm(mut Farm farm)
{
    var plan = MakePlan();
    farm.solids = plan.solids;
    farm.doors = plan.doors;
    farm.doorCount = plan.doorCount;
    farm.spots = plan.spots;
}

// The road, the lane, the yard and the fields, flat on the ground.
void BuildGround(mut Plan plan)
{
    var dirt = Color(0.42, 0.33, 0.24);
    // The road: gravel down the middle, a strip of verge each side
    Block(plan, float3(-2.6, -0.1, -260), float3(2.6, 0.035, 160), Stuff.Gravel, Stuff.Gravel, Stuff.Gravel, Color(0.55, 0.52, 0.47), false, false);
    // The lane to the house, and the yard before it
    Block(plan, float3(2.6, -0.1, 37.6), float3(24.4, 0.04, 41.4), Stuff.Gravel, Stuff.Gravel, Stuff.Gravel, Color(0.5, 0.47, 0.42), false, false);
    Block(plan, float3(36, -0.1, 33), float3(46, 0.03, 46), Stuff.Dirt, Stuff.Dirt, Stuff.Dirt, dirt, false, false);
    // Ploughed rows south of the yard, where the corn stands
    Block(plan, float3(8, -0.1, -40), float3(62, 0.025, 24), Stuff.Dirt, Stuff.Dirt, Stuff.Dirt, Color(0.34, 0.27, 0.2), false, false);
    Block(plan, float3(-42, -0.1, -200), float3(-4, 0.025, 30), Stuff.Dirt, Stuff.Dirt, Stuff.Dirt, Color(0.34, 0.27, 0.2), false, false);
    // Telephone poles along the road's east side, every forty metres
    for (var i = 0; i < 9; i++)
    {
        var z = -230.0 + i * 40;
        Block(plan, float3(3.4, 0, z - 0.13), float3(3.66, 8.2, z + 0.13), Stuff.Plain, Stuff.Plain, Stuff.Plain, Color(0.27, 0.21, 0.15), false, true);
        Block(plan, float3(2.7, 7.6, z - 0.08), float3(4.4, 7.75, z + 0.08), Stuff.Plain, Stuff.Plain, Stuff.Plain, Color(0.27, 0.21, 0.15), false, false);
    }
    // The mailbox where the lane meets the road
    Block(plan, float3(3.55, 0, 36.2), float3(3.65, 1.05, 36.3), Stuff.Plain, Stuff.Plain, Stuff.Plain, Color(0.3, 0.24, 0.17), false, true);
    Block(plan, float3(3.4, 1.05, 36.02), float3(3.8, 1.3, 36.5), Stuff.Plain, Stuff.Plain, Stuff.Plain, Color(0.36, 0.38, 0.4), false, false);
    AddSpot(plan, Spot.Mailbox, float3(3.6, 1.2, 36.26), 0.35);
    // The car: where it died, nose up the road
    AddProp(plan, Model.Sedan, CAR_AT, 0, 1.8, false);
    plan.solids.Add(Solid { center = CAR_AT + float3(0, 0.7, 0), half = float3(1.0, 0.7, 2.25) });
    AddSpot(plan, Spot.CarHood, CAR_AT + float3(0, 1.0, 2.1), 0.6);
    AddSpot(plan, Spot.CarDoor, CAR_AT + float3(-0.95, 1.0, 0.2), 0.5);
}

void BuildHouse(mut Plan plan)
{
    var paper = Color(0.62, 0.55, 0.42);
    var paperGreen = Color(0.42, 0.5, 0.4);
    var paperRose = Color(0.6, 0.44, 0.42);
    var trim = Color(0.84, 0.82, 0.76);
    var wood = Color(0.5, 0.36, 0.24);
    var stone = Color(0.45, 0.43, 0.4);
    var plaster = Color(0.8, 0.77, 0.7);
    var x0 = HOUSE_X;
    var z0 = HOUSE_Z;
    var x1 = HOUSE_X + HOUSE_DEEP;
    var z1 = HOUSE_Z + HOUSE_WIDE;

    // The foundation, with the ground floor on it: the living room, the hall and the kitchen
    Block(plan, float3(x0, 0, z0), float3(x1, F1 - 0.02, z1), Stuff.Stone, Stuff.Stone, Stuff.Stone, stone, false, true);
    Block(plan, float3(x0, F1 - 0.02, z0), float3(x1, F1, z0 + 4.5), Stuff.Planks, Stuff.Stone, Stuff.Planks, wood, true, true);
    Block(plan, float3(x0, F1 - 0.02, z0 + 4.5), float3(x1, F1, z0 + 6.6), Stuff.Planks, Stuff.Stone, Stuff.Planks, wood, true, true);
    Block(plan, float3(x0, F1 - 0.02, z0 + 6.6), float3(x1, F1, z1), Stuff.Tile, Stuff.Stone, Stuff.Planks, Color(0.66, 0.64, 0.58), true, true);

    // The outside walls: the front with its door and windows, the back with the kitchen's door
    List<float4> front = [Opening(z0 + 1.2, z0 + 2.6, F1 + 0.85, F1 + 2.2), Opening(z0 + 5.1, z0 + 6.1, F1, F1 + 2.1),
                          Opening(z0 + 7.6, z0 + 9.0, F1 + 0.85, F1 + 2.2)];
    Wall(plan, false, x0, z0, z1, F1, F1_CEILING, front, Stuff.Wallpaper, Stuff.Siding, paper, true);
    List<float4> frontUp = [Opening(z0 + 1.4, z0 + 2.6, F2 + 0.8, F2 + 2.0), Opening(z0 + 7.6, z0 + 8.8, F2 + 0.8, F2 + 2.0)];
    Wall(plan, false, x0, z0, z1, F1_CEILING, F2_CEILING, frontUp, Stuff.Wallpaper, Stuff.Siding, paperRose, true);
    List<float4> back = [Opening(z0 + 1.6, z0 + 3.0, F1 + 0.85, F1 + 2.2), Opening(z0 + 8.6, z0 + 9.6, F1, F1 + 2.1)];
    Wall(plan, false, x1, z0, z1, F1, F1_CEILING, back, Stuff.Siding, Stuff.Wallpaper, paperGreen, true);
    List<float4> backUp = [Opening(z0 + 1.6, z0 + 2.8, F2 + 0.8, F2 + 2.0), Opening(z0 + 7.8, z0 + 8.6, F2 + 1.0, F2 + 1.9)];
    Wall(plan, false, x1, z0, z1, F1_CEILING, F2_CEILING, backUp, Stuff.Siding, Stuff.Wallpaper, paper, true);
    List<float4> south = [Opening(x0 + 1.5, x0 + 2.9, F1 + 0.85, F1 + 2.2), Opening(x0 + 5.0, x0 + 6.4, F1 + 0.85, F1 + 2.2)];
    Wall(plan, true, z0, x0 - WALL * 0.5, x1 + WALL * 0.5, F1, F1_CEILING, south, Stuff.Wallpaper, Stuff.Siding, paper, true);
    List<float4> southUp = [Opening(x0 + 1.5, x0 + 2.7, F2 + 0.8, F2 + 2.0), Opening(x0 + 5.2, x0 + 6.4, F2 + 0.8, F2 + 2.0)];
    Wall(plan, true, z0, x0 - WALL * 0.5, x1 + WALL * 0.5, F1_CEILING, F2_CEILING, southUp, Stuff.Wallpaper, Stuff.Siding, paperRose, true);
    List<float4> north = [Opening(x0 + 2.0, x0 + 3.4, F1 + 0.85, F1 + 2.2), Opening(x0 + 5.6, x0 + 6.6, F1 + 1.1, F1 + 2.1)];
    Wall(plan, true, z1, x0 - WALL * 0.5, x1 + WALL * 0.5, F1, F1_CEILING, north, Stuff.Siding, Stuff.Wallpaper, paperGreen, true);
    List<float4> northUp = [Opening(x0 + 1.4, x0 + 2.6, F2 + 0.8, F2 + 2.0), Opening(x0 + 5.6, x0 + 6.4, F2 + 1.0, F2 + 1.9)];
    Wall(plan, true, z1, x0 - WALL * 0.5, x1 + WALL * 0.5, F1_CEILING, F2_CEILING, northUp, Stuff.Siding, Stuff.Wallpaper, paper, true);
    // The band between the floors, outside
    Block(plan, float3(x0 - 0.1, F1_CEILING - 0.05, z0 - 0.1), float3(x1 + 0.1, F1_CEILING + 0.25, z1 + 0.1), Stuff.Trim, Stuff.Trim, Stuff.Trim, trim, false, false);

    // Panes in every window
    AddPanes(plan, false, x0, front, true);
    AddPanes(plan, false, x0, frontUp, true);
    AddPanes(plan, false, x1, back, true);
    AddPanes(plan, false, x1, backUp, true);
    AddPanes(plan, true, z0, south, true);
    AddPanes(plan, true, z0, southUp, true);
    AddPanes(plan, true, z1, north, true);
    AddPanes(plan, true, z1, northUp, true);

    // Inside, downstairs: the hall between the living room (south) and the kitchen (north)
    List<float4> livingDoor = [Opening(x0 + 1.0, x0 + 2.3, F1, F1 + 2.15)];
    Wall(plan, true, z0 + 4.5, x0, x1, F1, F1_CEILING, livingDoor, Stuff.Wallpaper, Stuff.Wallpaper, paper, true);
    List<float4> kitchenDoor = [Opening(x0 + 1.0, x0 + 2.3, F1, F1 + 2.15)];
    Wall(plan, true, z0 + 6.6, x0, x1, F1, F1_CEILING, kitchenDoor, Stuff.Wallpaper, Stuff.Wallpaper, paperGreen, true);
    // The stairs, east along the hall's south side, and the cupboard under them
    var rise = StairRise();
    for (var step = 0; step < STAIR_STEPS; step++)
    {
        var u = STAIR_FROM + step * STAIR_RUN;
        Block(plan, House(u, F1, 4.5 + WALL * 0.5), House(u + STAIR_RUN, F1 + rise * (step + 1), 5.5), Stuff.Carpet, Stuff.Planks, Stuff.Planks,
              Color(0.36, 0.14, 0.12), true, true);
    }
    var stairTop = STAIR_FROM + STAIR_STEPS * STAIR_RUN;
    // The banister's side of the stairs: a wall under them, open over them
    for (var step = 0; step < STAIR_STEPS; step += 2)
    {
        var u = STAIR_FROM + step * STAIR_RUN;
        Block(plan, House(u, F1 + rise * (step + 1), 5.47), House(u + 0.05, F1 + rise * (step + 1) + 0.9, 5.53), Stuff.Plain, Stuff.Plain,
              Stuff.Plain, Color(0.32, 0.22, 0.15), true, false);
    }
    Block(plan, House(STAIR_FROM, F1 + 0.95, 5.46), House(stairTop, F2 + 0.95, 5.54), Stuff.Plain, Stuff.Plain, Stuff.Plain,
          Color(0.32, 0.22, 0.15), true, false);
    plan.solids.Add(Solid { center = House((STAIR_FROM + stairTop) * 0.5, F1 + 1.4, 5.5), half = float3((stairTop - STAIR_FROM) * 0.5, 1.4, 0.04) });

    // Between the floors, with a hole over the stairs
    var wide = HOUSE_WIDE;
    var deep = HOUSE_DEEP;
    Block(plan, House(0, F1_CEILING, 0), House(deep, F2, 4.5), Stuff.Planks, Stuff.Plaster, Stuff.Plaster, wood, true, true);
    Block(plan, House(0, F1_CEILING, 4.5), House(STAIR_FROM, F2, 5.5), Stuff.Planks, Stuff.Plaster, Stuff.Plaster, wood, true, true);
    Block(plan, House(stairTop, F1_CEILING, 4.5), House(deep, F2, 5.5), Stuff.Planks, Stuff.Plaster, Stuff.Plaster, wood, true, true);
    Block(plan, House(0, F1_CEILING, 5.5), House(deep, F2, wide), Stuff.Planks, Stuff.Plaster, Stuff.Plaster, wood, true, true);
    // The rail round the stairwell upstairs
    Block(plan, House(0.6, F2, 5.47), House(stairTop - 0.6, F2 + 0.95, 5.53), Stuff.Plain, Stuff.Plain, Stuff.Plain, Color(0.32, 0.22, 0.15), true, false);
    plan.solids.Add(Solid { center = House(STAIR_FROM * 0.5 + 1.0, F2 + 0.6, 5.5), half = float3(STAIR_FROM * 0.5 - 0.4, 0.6, 0.04) });
    Block(plan, House(STAIR_FROM - 0.03, F2, 4.5), House(STAIR_FROM + 0.03, F2 + 0.95, 5.5), Stuff.Plain, Stuff.Plain, Stuff.Plain, Color(0.32, 0.22, 0.15), true, true);

    // Upstairs: the guest room and the Hales' room south of the hall, Dale's room and the bath north of it
    List<float4> southRooms = [Opening(x0 + 1.4, x0 + 2.3, F2, F2 + 2.1), Opening(x0 + 7.25, x0 + 7.95, F2, F2 + 2.1)];
    Wall(plan, true, z0 + 4.5, x0, x1, F2, F2_CEILING, southRooms, Stuff.Wallpaper, Stuff.Wallpaper, paperRose, true);
    List<float4> northRooms = [Opening(x0 + 1.4, x0 + 2.3, F2, F2 + 2.1), Opening(x0 + 4.6, x0 + 5.5, F2, F2 + 2.1)];
    Wall(plan, true, z0 + 6.6, x0, x1, F2, F2_CEILING, northRooms, Stuff.Wallpaper, Stuff.Wallpaper, paper, true);
    List<float4> none = [];
    Wall(plan, false, x0 + 4.0, z0, z0 + 4.5, F2, F2_CEILING, none, Stuff.Wallpaper, Stuff.Wallpaper, paperRose, true);
    Wall(plan, false, x0 + 4.0, z0 + 6.6, z1, F2, F2_CEILING, none, Stuff.Wallpaper, Stuff.Wallpaper, Color(0.7, 0.72, 0.7), true);
    // The ceiling upstairs, and the attic floor over it
    Block(plan, House(0, F2_CEILING, 0), House(deep, F2_CEILING + 0.12, wide), Stuff.Plaster, Stuff.Plaster, Stuff.Plaster, plaster, true, true);
    BuildRoof(plan, x0, z0, x1, z1);
    // The chimney, up the south wall from the living room's hearth
    Block(plan, House(3.4, 0, -0.55), House(4.6, F2_CEILING + 2.6, 0.02), Stuff.Brick, Stuff.Brick, Stuff.Brick, Color(0.48, 0.25, 0.19), false, true);
    Block(plan, House(3.5, F1, 0.0), House(4.5, F1 + 1.05, 0.45), Stuff.Brick, Stuff.Brick, Stuff.Brick, Color(0.42, 0.22, 0.17), true, true);
    Block(plan, House(3.7, F1 + 0.02, 0.05), House(4.3, F1 + 0.7, 0.46), Stuff.Glow, Stuff.Glow, Stuff.Glow, Color(0.08, 0.05, 0.04), true, false);

    // The doors
    var doorWood = Color(0.46, 0.34, 0.24);
    AddDoor(plan, House(0, F1, 5.1), 0, 1.5, 1.0, Color(0.32, 0.2, 0.15), true);                    // Front
    AddDoor(plan, House(HOUSE_DEEP, F1, 8.6), 0, -1.5, 1.0, doorWood, false);                      // Back
    AddDoor(plan, House(1.4, F2, 4.5), Math.PI * 0.5, 1.5, 0.9, doorWood, false);                  // Guest room
    AddDoor(plan, House(7.25, F2, 4.5), Math.PI * 0.5, 1.4, 0.7, doorWood, true);                  // The Hales'
    AddDoor(plan, House(1.4, F2, 6.6), Math.PI * 0.5, -1.5, 0.9, doorWood, true);                  // Dale's
    AddDoor(plan, House(4.6, F2, 6.6), Math.PI * 0.5, -1.5, 0.9, doorWood, false);                 // The bath
    AddSpot(plan, Spot.FrontDoor, House(-0.1, F1 + 1.0, 5.85), 0.4);
    AddSpot(plan, Spot.BackDoor, House(HOUSE_DEEP - 0.1, F1 + 1.0, 9.35), 0.4);
    AddSpot(plan, Spot.GuestDoor, House(2.15, F2 + 1.0, 4.5), 0.4);
    AddSpot(plan, Spot.HalesDoor, House(7.85, F2 + 1.0, 4.5), 0.35);
    AddSpot(plan, Spot.DaleDoor, House(2.15, F2 + 1.0, 6.6), 0.4);
    AddSpot(plan, Spot.BathDoor, House(5.35, F2 + 1.0, 6.6), 0.4);

    BuildPorch(plan, trim);
    FurnishHouse(plan);
}

void AddPanes(mut Plan plan, bool alongX, float at, List<float4> holes, bool inside)
{
    foreach (var hole in holes)
    {
        if (hole.z < F1 + 0.2 || (hole.z > F1_CEILING && hole.z < F2 + 0.2)) continue;
        var lo = alongX ? float3(hole.x, hole.z, at - 0.02) : float3(at - 0.02, hole.z, hole.x);
        var hi = alongX ? float3(hole.y, hole.w, at + 0.02) : float3(at + 0.02, hole.w, hole.y);
        plan.pieces.Add(Slab(lo, hi, Stuff.Glass, Stuff.Glass, Stuff.Glass, Color(0.4, 0.45, 0.5), inside));
        plan.solids.Add(Solid { center = (lo + hi) * 0.5, half = (hi - lo) * 0.5 + float3(0.04) });
        // The frame round it, and a bar across its middle
        var frame = Color(0.84, 0.82, 0.76);
        var t = 0.07;
        var bar = alongX ? float3(hole.x, (hole.z + hole.w) * 0.5 - t * 0.5, at - 0.05) : float3(at - 0.05, (hole.z + hole.w) * 0.5 - t * 0.5, hole.x);
        var barHi = alongX ? float3(hole.y, (hole.z + hole.w) * 0.5 + t * 0.5, at + 0.05) : float3(at + 0.05, (hole.z + hole.w) * 0.5 + t * 0.5, hole.y);
        plan.pieces.Add(Slab(bar, barHi, Stuff.Trim, Stuff.Trim, Stuff.Trim, frame, inside));
        var sill = alongX ? float3(hole.x - 0.08, hole.z - 0.06, at - 0.14) : float3(at - 0.14, hole.z - 0.06, hole.x - 0.08);
        var sillHi = alongX ? float3(hole.y + 0.08, hole.z, at + 0.14) : float3(at + 0.14, hole.z, hole.y + 0.08);
        plan.pieces.Add(Slab(sill, sillHi, Stuff.Trim, Stuff.Trim, Stuff.Trim, frame, inside));
    }
}

// A roof of two slopes, its ridge running north and south, with the gable ends closed.
void BuildRoof(mut Plan plan, float x0, float z0, float x1, float z1)
{
    var middle = (x0 + x1) * 0.5;
    plan.pieces.Add(Piece { center = float3(middle, F2_CEILING + 0.12, (z0 + z1) * 0.5), size = float3(middle - x0 + 0.5, 2.2, z1 - z0 + 0.8),
                            front = Stuff.Shingle, back = Stuff.Siding, edge = Stuff.Trim, tint = Color(0.27, 0.25, 0.25), inside = false, roof = true });
}

void BuildPorch(mut Plan plan, Color trim)
{
    var deck = Color(0.5, 0.42, 0.33);
    var x0 = HOUSE_X - 2.6;
    var x1 = HOUSE_X;
    var z0 = HOUSE_Z + 1.0;
    var z1 = HOUSE_Z + 9.0;
    Block(plan, float3(x0, 0, z0), float3(x1, F1, z1), Stuff.Planks, Stuff.Stone, Stuff.Trim, deck, false, true);
    // Two steps up to it, before the door
    Block(plan, float3(x0 - 0.42, 0, HOUSE_Z + 4.6), float3(x0, 0.4, HOUSE_Z + 6.6), Stuff.Planks, Stuff.Planks, Stuff.Trim, deck, false, true);
    Block(plan, float3(x0 - 0.84, 0, HOUSE_Z + 4.6), float3(x0 - 0.42, 0.2, HOUSE_Z + 6.6), Stuff.Planks, Stuff.Planks, Stuff.Trim, deck, false, true);
    // Its posts and roof
    for (var i = 0; i < 4; i++)
    {
        var z = z0 + 0.1 + i * (z1 - z0 - 0.2) / 3;
        Block(plan, float3(x0 + 0.05, F1, z - 0.07), float3(x0 + 0.19, 3.2, z + 0.07), Stuff.Trim, Stuff.Trim, Stuff.Trim, trim, false, true);
    }
    Block(plan, float3(x0 - 0.2, 3.2, z0 - 0.2), float3(x1, 3.36, z1 + 0.2), Stuff.Shingle, Stuff.Plaster, Stuff.Trim, Color(0.27, 0.25, 0.25), false, true);
    // A rail along its edge, open at the steps
    Block(plan, float3(x0 + 0.05, F1 + 0.85, z0 + 0.1), float3(x0 + 0.15, F1 + 0.93, HOUSE_Z + 4.6), Stuff.Trim, Stuff.Trim, Stuff.Trim, trim, false, true);
    Block(plan, float3(x0 + 0.05, F1 + 0.85, HOUSE_Z + 6.6), float3(x0 + 0.15, F1 + 0.93, z1 - 0.1), Stuff.Trim, Stuff.Trim, Stuff.Trim, trim, false, true);
    for (var i = 0; i < 18; i++)
    {
        var z = z0 + 0.2 + i * 0.45;
        if (z > HOUSE_Z + 4.5 && z < HOUSE_Z + 6.7) continue;
        Block(plan, float3(x0 + 0.08, F1, z - 0.025), float3(x0 + 0.12, F1 + 0.85, z + 0.025), Stuff.Trim, Stuff.Trim, Stuff.Trim, trim, false, false);
    }
    plan.solids.Add(Solid { center = float3(x0 + 0.1, F1 + 0.5, (z0 + HOUSE_Z + 4.6) * 0.5), half = float3(0.08, 0.5, (HOUSE_Z + 4.6 - z0) * 0.5) });
    plan.solids.Add(Solid { center = float3(x0 + 0.1, F1 + 0.5, (z1 + HOUSE_Z + 6.6) * 0.5), half = float3(0.08, 0.5, (z1 - HOUSE_Z - 6.6) * 0.5) });
    AddProp(plan, Model.WallLamp, House(-0.08, F1 + 2.15, 6.45), -Math.PI * 0.5, 2.0, false);
    AddProp(plan, Model.Bucket, float3(x0 + 0.5, F1, z1 - 0.5), 0.4, 1.8, false);
}

void FurnishHouse(mut Plan plan)
{
    var s = 2.0;
    // The kitchen: the table and five chairs, the stove, sink and icebox along the back wall
    Furnish(plan, Model.TableCloth, House(2.45, F1, 8.3), Math.PI * 0.5, 2.4, float3(2.0, 0.78, 1.1));
    Furnish(plan, Model.Chair, House(1.85, F1, 7.35), 0, s, float3(0, 0, 0));
    Furnish(plan, Model.Chair, House(3.05, F1, 7.35), 0, s, float3(0, 0, 0));
    Furnish(plan, Model.Chair, House(2.45, F1, 9.3), Math.PI, s, float3(0, 0, 0));
    Furnish(plan, Model.Chair, House(4.05, F1, 8.3), -Math.PI * 0.5, s, float3(0, 0, 0));
    Furnish(plan, Model.Chair, House(0.85, F1, 8.3), Math.PI * 0.5, s, float3(0, 0, 0));
    AddSpot(plan, Spot.SeatSam, House(1.85, F1 + 0.6, 7.35), 0.4);
    AddSpot(plan, Spot.SeatJo, House(3.05, F1 + 0.6, 7.35), 0.4);
    Furnish(plan, Model.Stove, House(7.55, F1, 7.4), -Math.PI * 0.5, s, float3(0.9, 0.9, 0.9));
    Furnish(plan, Model.Sink, House(7.55, F1, 6.95 + 1.35), -Math.PI * 0.5, s, float3(0.9, 0.9, 0.9));
    Furnish(plan, Model.Cabinet, House(6.5, F1, 9.55), Math.PI, s, float3(0.9, 0.9, 0.9));
    Furnish(plan, Model.Cabinet, House(5.6, F1, 9.55), Math.PI, s, float3(0.9, 0.9, 0.9));
    Furnish(plan, Model.Fridge, House(4.6, F1, 9.6), Math.PI, s, float3(0.9, 1.8, 0.7));
    AddProp(plan, Model.CabinetUpper, House(7.75, F1 + 1.5, 7.4), -Math.PI * 0.5, s, true);
    AddProp(plan, Model.CabinetUpper, House(6.5, F1 + 1.5, 9.8), Math.PI, s, true);
    AddProp(plan, Model.Trashcan, House(7.6, F1, 6.95), 0, s, true);
    AddSpot(plan, Spot.Phone, House(5.5, F1 + 1.45, 6.72), 0.3);
    AddSpot(plan, Spot.Clock, House(0.12, F1 + 2.2, 8.3), 0.3);
    // The living room: the sofa before the hearth, an armchair, the set, the radio and the lamp
    Furnish(plan, Model.Rug, House(3.9, F1 + 0.01, 2.2), 0, 2.0, float3(0, 0, 0));
    Furnish(plan, Model.Sofa, House(4.0, F1, 3.5), Math.PI, s, float3(2.0, 0.8, 0.85));
    Furnish(plan, Model.Armchair, House(1.4, F1, 1.8), Math.PI * 0.5, s, float3(0.9, 0.8, 0.9));
    Furnish(plan, Model.Television, House(6.7, F1, 1.0), -Math.PI * 0.75, s, float3(0.8, 0.6, 0.6));
    Furnish(plan, Model.SideTable, House(6.9, F1, 3.8), -Math.PI * 0.5, s, float3(0.4, 0.8, 1.0));
    AddProp(plan, Model.Radio, House(6.9, F1 + 0.76, 3.8), -Math.PI * 0.5, s, true);
    Furnish(plan, Model.FloorLamp, House(0.5, F1, 0.5), 0, s, float3(0.3, 1.7, 0.3));
    Furnish(plan, Model.Bookcase, House(0.25, F1, 3.6), Math.PI * 0.5, s, float3(0.5, 1.7, 0.8));
    AddSpot(plan, Spot.Photos, House(7.85, F1 + 1.6, 2.2), 0.45);
    // The hall: a coat rack by the door
    Furnish(plan, Model.CoatRack, House(0.5, F1, 6.25), 0, s, float3(0.4, 1.6, 0.4));
    // The guest room: two beds, the nightstand between them, a box of someone's things
    Furnish(plan, Model.Bed, House(0.75, F2, 2.75), Math.PI * 0.5, 1.8, float3(2.0, 0.6, 1.0));
    Furnish(plan, Model.Bed, House(2.95, F2, 0.75), 0, 1.8, float3(1.0, 0.6, 2.0));
    Furnish(plan, Model.Nightstand, House(0.4, F2, 1.05), Math.PI * 0.5, s, float3(0.45, 0.55, 0.5));
    AddProp(plan, Model.TableLamp, House(0.4, F2 + 0.52, 1.05), 0, s, true);
    Furnish(plan, Model.Drawers, House(3.7, F2, 3.4), -Math.PI * 0.5, s, float3(0.45, 0.8, 1.0));
    AddSpot(plan, Spot.BedSam, House(1.7, F2 + 0.55, 2.75), 0.8);
    AddSpot(plan, Spot.BedJo, House(2.95, F2 + 0.55, 1.7), 0.8);
    AddSpot(plan, Spot.Drawer, House(3.55, F2 + 0.7, 3.4), 0.4);
    AddSpot(plan, Spot.GuestWindow, House(2.1, F2 + 1.4, 0.05), 0.6);
    // The Hales' room
    Furnish(plan, Model.Bed, House(6.2, F2, 1.0), 0, 2.2, float3(1.4, 0.6, 2.2));
    Furnish(plan, Model.Drawers, House(7.7, F2, 3.3), -Math.PI * 0.5, s, float3(0.45, 0.8, 1.0));
    // Dale's room: a bed, boxes he never unpacked
    Furnish(plan, Model.Bed, House(0.75, F2, 8.6), Math.PI * 0.5, 1.8, float3(2.0, 0.6, 1.0));
    Furnish(plan, Model.Box, House(3.3, F2, 9.2), 0.3, s, float3(0.5, 0.6, 0.5));
    Furnish(plan, Model.Box, House(3.4, F2, 8.5), -0.2, s, float3(0.5, 0.6, 0.5));
    // The bath
    Furnish(plan, Model.Bathtub, House(6.7, F2, 9.3), Math.PI, s, float3(2.4, 0.85, 1.1));
    Furnish(plan, Model.Toilet, House(4.4, F2, 9.6), Math.PI, s, float3(0.6, 0.8, 0.8));
    Furnish(plan, Model.BathSink, House(7.75, F2 + 0.8, 7.4), -Math.PI * 0.5, s, float3(0.6, 0.9, 0.7));
}

void BuildBarn(mut Plan plan)
{
    var boards = Color(0.42, 0.13, 0.1);
    var x0 = BARN_X;
    var z0 = BARN_Z;
    var x1 = BARN_X + BARN_DEEP;
    var z1 = BARN_Z + BARN_WIDE;
    Block(plan, float3(x0, -0.1, z0), float3(x1, 0.03, z1), Stuff.Dirt, Stuff.Dirt, Stuff.Dirt, Color(0.33, 0.27, 0.2), true, false);
    List<float4> front = [Opening(z0 + 5.0, z0 + 9.0, 0, 3.8)];
    Wall(plan, false, x0, z0, z1, 0, BARN_HIGH, front, Stuff.Barnwood, Stuff.Barnwood, boards, true);
    List<float4> none = [];
    Wall(plan, false, x1, z0, z1, 0, BARN_HIGH, none, Stuff.Barnwood, Stuff.Barnwood, boards, true);
    List<float4> side = [Opening(x0 + 3.5, x0 + 4.5, 2.6, 3.4)];
    Wall(plan, true, z0, x0 - WALL * 0.5, x1 + WALL * 0.5, 0, BARN_HIGH, side, Stuff.Barnwood, Stuff.Barnwood, boards, true);
    Wall(plan, true, z1, x0 - WALL * 0.5, x1 + WALL * 0.5, 0, BARN_HIGH, side, Stuff.Barnwood, Stuff.Barnwood, boards, true);
    plan.pieces.Add(Piece { center = float3((x0 + x1) * 0.5, BARN_HIGH, (z0 + z1) * 0.5), size = float3(BARN_DEEP * 0.5 + 0.4, 2.6, z1 - z0 + 0.8),
                            front = Stuff.Shingle, back = Stuff.Barnwood, edge = Stuff.Trim, tint = Color(0.24, 0.24, 0.26), inside = false, roof = true });
    // The open doors, swung back against the wall
    Block(plan, float3(x0 - 2.0, 0, z0 + 2.9), float3(x0 - 0.1, 3.8, z0 + 3.0), Stuff.Barnwood, Stuff.Barnwood, Stuff.Barnwood, boards, false, true);
    Block(plan, float3(x0 - 2.0, 0, z0 + 11.0), float3(x0 - 0.1, 3.8, z0 + 11.1), Stuff.Barnwood, Stuff.Barnwood, Stuff.Barnwood, boards, false, true);
    // Hay: bales stacked along the north wall, loose hay on the floor
    var hay = Color(0.66, 0.55, 0.3);
    for (var i = 0; i < 6; i++)
    {
        var z = z1 - 0.7;
        var x = x0 + 1.0 + i * 1.3;
        Block(plan, float3(x - 0.6, 0, z - 0.45), float3(x + 0.6, 0.55, z + 0.45), Stuff.Hay, Stuff.Hay, Stuff.Hay, hay, true, true);
        if (i % 2 == 0) Block(plan, float3(x - 0.6, 0.55, z - 0.45), float3(x + 0.6, 1.1, z + 0.45), Stuff.Hay, Stuff.Hay, Stuff.Hay, hay, true, true);
    }
    // Stalls along the south wall
    for (var i = 0; i < 3; i++)
    {
        var x = x0 + 2.5 + i * 2.6;
        Block(plan, float3(x - 0.05, 0, z0), float3(x + 0.05, 1.4, z0 + 2.6), Stuff.Barnwood, Stuff.Barnwood, Stuff.Barnwood, Color(0.36, 0.28, 0.2), true, true);
    }
    // The feed bin by the back wall, and the sacks by the door that go in it
    Block(plan, float3(x1 - 1.6, 0, z0 + 6.0), float3(x1 - 0.3, 1.0, z0 + 8.4), Stuff.Planks, Stuff.Planks, Stuff.Planks, Color(0.38, 0.3, 0.22), true, true);
    AddSpot(plan, Spot.FeedBin, float3(x1 - 0.95, 1.1, z0 + 7.2), 1.0);
    AddSpot(plan, Spot.Tarp, float3(x0 + 5.0, 1.5, z1 - 3.6), 1.3);
    plan.solids.Add(Solid { center = float3(x0 + 5.0, 0.95, z1 - 3.6), half = float3(2.5, 0.95, 1.25) });
    AddProp(plan, Model.Hatchback, float3(x0 + 5.0, 0, z1 - 3.6), Math.PI * 0.5, 1.6, true);
    AddProp(plan, Model.Workbench, float3(x0 + 0.9, 0, z0 + 3.4), Math.PI * 0.5, 3.0, true);
    AddProp(plan, Model.Pickaxe, float3(x0 + 0.3, 0, z0 + 4.2), Math.PI * 0.5, 3.5, true);
    AddProp(plan, Model.Shovel, float3(x0 + 0.3, 0, z0 + 4.6), Math.PI * 0.5, 3.5, true);
    AddProp(plan, Model.Barrel, float3(x1 - 0.6, 0, z0 + 1.0), 0, 2.6, true);
    AddProp(plan, Model.Barrel, float3(x1 - 1.3, 0, z0 + 0.8), 1, 2.6, true);
    AddProp(plan, Model.Bucket, float3(x0 + 2.0, 0, z0 + 1.0), 0, 1.8, true);
    plan.solids.Add(Solid { center = float3(x1 - 0.95, 0.5, z0 + 0.9), half = float3(0.75, 0.5, 0.5) });
}

void BuildYard(mut Plan plan)
{
    // The fence round the yard, with a gap for the lane and one toward the barn and the woods
    FenceLine(plan, float3(24, 0, 24), float3(40, 0, 24));
    FenceLine(plan, float3(43, 0, 24), float3(64, 0, 24));
    FenceLine(plan, float3(24, 0, 54), float3(64, 0, 54));
    FenceLine(plan, float3(24, 0, 24), float3(24, 0, 37.2));
    FenceLine(plan, float3(24, 0, 41.8), float3(24, 0, 54));
    FenceLine(plan, float3(64, 0, 24), float3(64, 0, 34));
    FenceLine(plan, float3(64, 0, 38), float3(64, 0, 54));
    // Logs by the barn, a stump with the axe's marks
    AddProp(plan, Model.Logs, float3(44.5, 0, 46.5), 0.3, 3.0, false);
    AddProp(plan, Model.Stump, float3(42.5, 0, 47.2), 0.0, 3.0, false);
    plan.solids.Add(Solid { center = float3(44.5, 0.5, 46.5), half = float3(1.2, 0.5, 1.0) });
    // Trees: a few in the yard, and the woods east of the fence
    AddProp(plan, Model.Oak, float3(21, 0, 46), 0.4, 9, false);
    AddProp(plan, Model.Oak, float3(40, 0, 50), 1.9, 8, false);
    AddProp(plan, Model.Birch, float3(26, 0, 30), 2.4, 8, false);
    plan.solids.Add(Solid { center = float3(21, 1.5, 46), half = float3(0.35, 1.5, 0.35) });
    plan.solids.Add(Solid { center = float3(40, 1.5, 50), half = float3(0.35, 1.5, 0.35) });
    plan.solids.Add(Solid { center = float3(26, 1.5, 30), half = float3(0.3, 1.5, 0.3) });
    for (var i = 0; i < 160; i++)
    {
        var h = Math.Hash(int2(i, 77));
        var x = 68 + (h & 1023) / 1023.0 * 60;
        var z = -60 + ((h >> 10) & 1023) / 1023.0 * 140;
        var kind = (h >> 20) % 4;
        Model model = kind == 0 ? Model.Pine : kind == 1 ? Model.DarkTree : kind == 2 ? Model.PineDark : Model.Oak;
        AddProp(plan, model, float3(x, 0, z), ((h >> 6) & 255) / 40.0, 7.5 + ((h >> 14) & 7) * 0.6, false);
    }
    // Along the road: a few trees between the fields, and rocks on the verge
    for (var i = 0; i < 26; i++)
    {
        var h = Math.Hash(int2(i, 191));
        var side = (h & 1) == 0 ? -1.0 : 1.0;
        var x = side * (6 + ((h >> 3) & 31) * 0.6);
        var z = -220 + i * 12.0 + ((h >> 9) & 7);
        if (x > 0 && z > 20 && z < 60) continue;
        AddProp(plan, (h >> 13) % 3 == 0 ? Model.Birch : Model.DarkTree, float3(x + side * 30, 0, z), ((h >> 6) & 255) / 40.0, 8, false);
        AddProp(plan, Model.Rock, float3(side * (3.2 + ((h >> 17) & 3) * 0.3), 0, z + 4), ((h >> 4) & 255) / 40.0, 2.5, false);
    }
}

// Fence posts and rails from one place to another, a segment every 3.6 metres, and what stops a walker at it.
void FenceLine(mut Plan plan, float3 from, float3 to)
{
    var length = Math.Distance(from, to);
    var count = Math.Max(1, int(Math.Ceil(length / 3.6)));
    var way = (to - from) / length;
    var yaw = Math.Atan2(way.x, way.z) + Math.PI * 0.5;
    for (var i = 0; i < count; i++)
    {
        var at = from + way * ((i + 0.5) * length / count);
        AddProp(plan, Model.Fence, at, yaw, length / count, false);
    }
    var middle = (from + to) * 0.5;
    plan.solids.Add(Solid { center = middle + float3(0, 0.6, 0), half = float3(Math.Abs(to.x - from.x) * 0.5 + 0.08, 0.6, Math.Abs(to.z - from.z) * 0.5 + 0.08) });
}
