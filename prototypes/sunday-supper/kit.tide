// The kits' models (Kenney's furniture, nature, survival and car kits, CC0):
// one asset each, and the switches that draw a Model with it. Each Model
// (farm.tide) has its asset here; placing.tide says where they stand.

asset Mesh<Corner> bedMesh = "art/props/bedSingle.glb";
asset Mesh<Corner> chairMesh = "art/props/chair.glb";
asset Mesh<Corner> tableMesh = "art/props/table.glb";
asset Mesh<Corner> tableClothMesh = "art/props/tableCloth.glb";
asset Mesh<Corner> stoveMesh = "art/props/kitchenStove.glb";
asset Mesh<Corner> sinkMesh = "art/props/kitchenSink.glb";
asset Mesh<Corner> fridgeMesh = "art/props/kitchenFridge.glb";
asset Mesh<Corner> cabinetMesh = "art/props/kitchenCabinet.glb";
asset Mesh<Corner> cabinetUpperMesh = "art/props/kitchenCabinetUpper.glb";
asset Mesh<Corner> sofaMesh = "art/props/loungeSofa.glb";
asset Mesh<Corner> armchairMesh = "art/props/loungeChair.glb";
asset Mesh<Corner> televisionMesh = "art/props/televisionVintage.glb";
asset Mesh<Corner> radioMesh = "art/props/radio.glb";
asset Mesh<Corner> tableLampMesh = "art/props/lampRoundTable.glb";
asset Mesh<Corner> floorLampMesh = "art/props/lampSquareFloor.glb";
asset Mesh<Corner> sideTableMesh = "art/props/sideTable.glb";
asset Mesh<Corner> drawersMesh = "art/props/sideTableDrawers.glb";
asset Mesh<Corner> bookcaseMesh = "art/props/bookcaseClosed.glb";
asset Mesh<Corner> rugMesh = "art/props/rugRectangle.glb";
asset Mesh<Corner> rugRoundMesh = "art/props/rugRound.glb";
asset Mesh<Corner> coatRackMesh = "art/props/coatRackStanding.glb";
asset Mesh<Corner> bathtubMesh = "art/props/bathtub.glb";
asset Mesh<Corner> toiletMesh = "art/props/toilet.glb";
asset Mesh<Corner> bathSinkMesh = "art/props/bathroomSink.glb";
asset Mesh<Corner> mirrorMesh = "art/props/bathroomMirror.glb";
asset Mesh<Corner> boxMesh = "art/props/cardboardBoxClosed.glb";
asset Mesh<Corner> nightstandMesh = "art/props/cabinetBedDrawer.glb";
asset Mesh<Corner> pillowMesh = "art/props/pillow.glb";
asset Mesh<Corner> booksMesh = "art/props/books.glb";
asset Mesh<Corner> trashcanMesh = "art/props/trashcan.glb";
asset Mesh<Corner> washerMesh = "art/props/washer.glb";
asset Mesh<Corner> wallLampMesh = "art/props/lampWall.glb";
[LOD] asset Mesh<Corner> cornMesh = "art/props/crops_cornStageD.glb";
[LOD] asset Mesh<Corner> cornYoungMesh = "art/props/crops_cornStageC.glb";
[LOD] asset Mesh<Corner> oakMesh = "art/props/tree_oak_fall.glb";
[LOD] asset Mesh<Corner> darkTreeMesh = "art/props/tree_detailed_dark.glb";
[LOD] asset Mesh<Corner> birchMesh = "art/props/tree_fat_fall.glb";
[LOD] asset Mesh<Corner> pineMesh = "art/props/tree_pineTallA.glb";
[LOD] asset Mesh<Corner> pineDarkMesh = "art/props/tree_default_dark.glb";
asset Mesh<Corner> fenceMesh = "art/props/fence_simple.glb";
asset Mesh<Corner> gateMesh = "art/props/fence_gate.glb";
asset Mesh<Corner> stumpMesh = "art/props/stump_old.glb";
asset Mesh<Corner> logsMesh = "art/props/log_stack.glb";
asset Mesh<Corner> rockMesh = "art/props/rock_smallA.glb";
[LOD] asset Mesh<Corner> tuftMesh = "art/props/grass_large.glb";
[LOD] asset Mesh<Corner> bushMesh = "art/props/plant_bush.glb";
asset Mesh<Corner> bucketMesh = "art/props/bucket.glb";
asset Mesh<Corner> barrelMesh = "art/props/barrel.glb";
asset Mesh<Corner> crateMesh = "art/props/box-large.glb";
asset Mesh<Corner> pickaxeMesh = "art/props/tool-pickaxe.glb";
asset Mesh<Corner> shovelMesh = "art/props/tool-shovel.glb";
asset Mesh<Corner> workbenchMesh = "art/props/workbench.glb";
asset Mesh<Corner> sedanMesh = "art/props/sedan.glb";
asset Mesh<Corner> hatchbackMesh = "art/props/hatchback.glb";

// Each model's corners, to find its foot.
List<Corner> VerticesOf(Model model)
{
    switch (model)
    {
        case Model.Bed: return bedMesh.vertices;
        case Model.Chair: return chairMesh.vertices;
        case Model.Table: return tableMesh.vertices;
        case Model.TableCloth: return tableClothMesh.vertices;
        case Model.Stove: return stoveMesh.vertices;
        case Model.Sink: return sinkMesh.vertices;
        case Model.Fridge: return fridgeMesh.vertices;
        case Model.Cabinet: return cabinetMesh.vertices;
        case Model.CabinetUpper: return cabinetUpperMesh.vertices;
        case Model.Sofa: return sofaMesh.vertices;
        case Model.Armchair: return armchairMesh.vertices;
        case Model.Television: return televisionMesh.vertices;
        case Model.Radio: return radioMesh.vertices;
        case Model.TableLamp: return tableLampMesh.vertices;
        case Model.FloorLamp: return floorLampMesh.vertices;
        case Model.SideTable: return sideTableMesh.vertices;
        case Model.Drawers: return drawersMesh.vertices;
        case Model.Bookcase: return bookcaseMesh.vertices;
        case Model.Rug: return rugMesh.vertices;
        case Model.RugRound: return rugRoundMesh.vertices;
        case Model.CoatRack: return coatRackMesh.vertices;
        case Model.Bathtub: return bathtubMesh.vertices;
        case Model.Toilet: return toiletMesh.vertices;
        case Model.BathSink: return bathSinkMesh.vertices;
        case Model.Mirror: return mirrorMesh.vertices;
        case Model.Box: return boxMesh.vertices;
        case Model.Nightstand: return nightstandMesh.vertices;
        case Model.Pillow: return pillowMesh.vertices;
        case Model.Books: return booksMesh.vertices;
        case Model.Trashcan: return trashcanMesh.vertices;
        case Model.Washer: return washerMesh.vertices;
        case Model.WallLamp: return wallLampMesh.vertices;
        case Model.Corn: return cornMesh.vertices;
        case Model.CornYoung: return cornYoungMesh.vertices;
        case Model.Oak: return oakMesh.vertices;
        case Model.DarkTree: return darkTreeMesh.vertices;
        case Model.Birch: return birchMesh.vertices;
        case Model.Pine: return pineMesh.vertices;
        case Model.PineDark: return pineDarkMesh.vertices;
        case Model.Fence: return fenceMesh.vertices;
        case Model.Gate: return gateMesh.vertices;
        case Model.Stump: return stumpMesh.vertices;
        case Model.Logs: return logsMesh.vertices;
        case Model.Rock: return rockMesh.vertices;
        case Model.Tuft: return tuftMesh.vertices;
        case Model.Bush: return bushMesh.vertices;
        case Model.Bucket: return bucketMesh.vertices;
        case Model.Barrel: return barrelMesh.vertices;
        case Model.Crate: return crateMesh.vertices;
        case Model.Pickaxe: return pickaxeMesh.vertices;
        case Model.Shovel: return shovelMesh.vertices;
        case Model.Workbench: return workbenchMesh.vertices;
        case Model.Sedan: return sedanMesh.vertices;
        case Model.Hatchback: return hatchbackMesh.vertices;
    }
    return chairMesh.vertices;
}

// Every kit model near enough, into the picture.
[Stage(Layers.Scene, 1)]
view DrawKits(Lens lens, Kit kit, Story story)
{
    for (var model = 0; model < kit.near.count; model++)
    {
        if (kit.near[model].count == 0) continue;
        switch (Model(model))
        {
            case Model.Bed: lens.scene.Instanced(bedMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Chair: lens.scene.Instanced(chairMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Table: lens.scene.Instanced(tableMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.TableCloth: lens.scene.Instanced(tableClothMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Stove: lens.scene.Instanced(stoveMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Sink: lens.scene.Instanced(sinkMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Fridge: lens.scene.Instanced(fridgeMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Cabinet: lens.scene.Instanced(cabinetMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.CabinetUpper: lens.scene.Instanced(cabinetUpperMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Sofa: lens.scene.Instanced(sofaMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Armchair: lens.scene.Instanced(armchairMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Television: lens.scene.Instanced(televisionMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Radio: lens.scene.Instanced(radioMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.TableLamp: lens.scene.Instanced(tableLampMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, glow = (story.lights & LAMP_GUEST) != 0 ? 1.0 : 0.0 }); break;
            case Model.FloorLamp: lens.scene.Instanced(floorLampMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, glow = (story.lights & LAMP_LIVING) != 0 ? 1.0 : 0.0 }); break;
            case Model.SideTable: lens.scene.Instanced(sideTableMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Drawers: lens.scene.Instanced(drawersMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Bookcase: lens.scene.Instanced(bookcaseMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Rug: lens.scene.Instanced(rugMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.RugRound: lens.scene.Instanced(rugRoundMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.CoatRack: lens.scene.Instanced(coatRackMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Bathtub: lens.scene.Instanced(bathtubMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Toilet: lens.scene.Instanced(toiletMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.BathSink: lens.scene.Instanced(bathSinkMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Mirror: lens.scene.Instanced(mirrorMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Box: lens.scene.Instanced(boxMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Nightstand: lens.scene.Instanced(nightstandMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Pillow: lens.scene.Instanced(pillowMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Books: lens.scene.Instanced(booksMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Trashcan: lens.scene.Instanced(trashcanMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.Washer: lens.scene.Instanced(washerMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, season = 0 }); break;
            case Model.WallLamp: lens.scene.Instanced(wallLampMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.55, glow = (story.lights & LAMP_PORCH) != 0 ? 1.0 : 0.0 }); break;
            case Model.Corn: lens.scene.Instanced(cornMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.7 }); break;
            case Model.CornYoung: lens.scene.Instanced(cornYoungMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.55 }); break;
            case Model.Oak: lens.scene.Instanced(oakMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.15 }); break;
            case Model.DarkTree: lens.scene.Instanced(darkTreeMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.25 }); break;
            case Model.Birch: lens.scene.Instanced(birchMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.15 }); break;
            case Model.Pine: lens.scene.Instanced(pineMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.1 }); break;
            case Model.PineDark: lens.scene.Instanced(pineDarkMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.1 }); break;
            case Model.Fence: lens.scene.Instanced(fenceMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.45, season = 0 }); break;
            case Model.Gate: lens.scene.Instanced(gateMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.45, season = 0 }); break;
            case Model.Stump: lens.scene.Instanced(stumpMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.45, season = 0 }); break;
            case Model.Logs: lens.scene.Instanced(logsMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.45, season = 0 }); break;
            case Model.Rock: lens.scene.Instanced(rockMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.45, season = 0 }); break;
            case Model.Tuft: lens.scene.Instanced(tuftMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.6 }); break;
            case Model.Bush: lens.scene.Instanced(bushMesh, kit.near[model], Snap, KitLit, KitLook { skin = 0, dull = 0.2, season = 0.45 }); break;
            case Model.Bucket: lens.scene.Instanced(bucketMesh, kit.near[model], Snap, KitLit, KitLook { skin = 2, dull = 0.55, season = 0 }); break;
            case Model.Barrel: lens.scene.Instanced(barrelMesh, kit.near[model], Snap, KitLit, KitLook { skin = 2, dull = 0.55, season = 0 }); break;
            case Model.Crate: lens.scene.Instanced(crateMesh, kit.near[model], Snap, KitLit, KitLook { skin = 2, dull = 0.55, season = 0 }); break;
            case Model.Pickaxe: lens.scene.Instanced(pickaxeMesh, kit.near[model], Snap, KitLit, KitLook { skin = 2, dull = 0.55, season = 0 }); break;
            case Model.Shovel: lens.scene.Instanced(shovelMesh, kit.near[model], Snap, KitLit, KitLook { skin = 2, dull = 0.55, season = 0 }); break;
            case Model.Workbench: lens.scene.Instanced(workbenchMesh, kit.near[model], Snap, KitLit, KitLook { skin = 2, dull = 0.55, season = 0 }); break;
            case Model.Sedan: lens.scene.Instanced(sedanMesh, kit.near[model], Snap, KitLit, KitLook { skin = 1, dull = 0.25, season = 0 }); break;
            case Model.Hatchback: lens.scene.Instanced(hatchbackMesh, kit.near[model], Snap, KitLit, KitLook { skin = 1, dull = 0.25, season = 0 }); break;
        }
    }
}

// Into a target of depth alone, for shadows.
void CastKit(RenderTarget target, Model model, List<Placed> list)
{
    switch (model)
    {
        case Model.Bed: target.Instanced(bedMesh, list); return;
        case Model.Chair: target.Instanced(chairMesh, list); return;
        case Model.Table: target.Instanced(tableMesh, list); return;
        case Model.TableCloth: target.Instanced(tableClothMesh, list); return;
        case Model.Stove: target.Instanced(stoveMesh, list); return;
        case Model.Sink: target.Instanced(sinkMesh, list); return;
        case Model.Fridge: target.Instanced(fridgeMesh, list); return;
        case Model.Cabinet: target.Instanced(cabinetMesh, list); return;
        case Model.CabinetUpper: target.Instanced(cabinetUpperMesh, list); return;
        case Model.Sofa: target.Instanced(sofaMesh, list); return;
        case Model.Armchair: target.Instanced(armchairMesh, list); return;
        case Model.Television: target.Instanced(televisionMesh, list); return;
        case Model.Radio: target.Instanced(radioMesh, list); return;
        case Model.TableLamp: target.Instanced(tableLampMesh, list); return;
        case Model.FloorLamp: target.Instanced(floorLampMesh, list); return;
        case Model.SideTable: target.Instanced(sideTableMesh, list); return;
        case Model.Drawers: target.Instanced(drawersMesh, list); return;
        case Model.Bookcase: target.Instanced(bookcaseMesh, list); return;
        case Model.Rug: target.Instanced(rugMesh, list); return;
        case Model.RugRound: target.Instanced(rugRoundMesh, list); return;
        case Model.CoatRack: target.Instanced(coatRackMesh, list); return;
        case Model.Bathtub: target.Instanced(bathtubMesh, list); return;
        case Model.Toilet: target.Instanced(toiletMesh, list); return;
        case Model.BathSink: target.Instanced(bathSinkMesh, list); return;
        case Model.Mirror: target.Instanced(mirrorMesh, list); return;
        case Model.Box: target.Instanced(boxMesh, list); return;
        case Model.Nightstand: target.Instanced(nightstandMesh, list); return;
        case Model.Pillow: target.Instanced(pillowMesh, list); return;
        case Model.Books: target.Instanced(booksMesh, list); return;
        case Model.Trashcan: target.Instanced(trashcanMesh, list); return;
        case Model.Washer: target.Instanced(washerMesh, list); return;
        case Model.WallLamp: target.Instanced(wallLampMesh, list); return;
        case Model.Corn: target.Instanced(cornMesh, list); return;
        case Model.CornYoung: target.Instanced(cornYoungMesh, list); return;
        case Model.Oak: target.Instanced(oakMesh, list); return;
        case Model.DarkTree: target.Instanced(darkTreeMesh, list); return;
        case Model.Birch: target.Instanced(birchMesh, list); return;
        case Model.Pine: target.Instanced(pineMesh, list); return;
        case Model.PineDark: target.Instanced(pineDarkMesh, list); return;
        case Model.Fence: target.Instanced(fenceMesh, list); return;
        case Model.Gate: target.Instanced(gateMesh, list); return;
        case Model.Stump: target.Instanced(stumpMesh, list); return;
        case Model.Logs: target.Instanced(logsMesh, list); return;
        case Model.Rock: target.Instanced(rockMesh, list); return;
        case Model.Tuft: target.Instanced(tuftMesh, list); return;
        case Model.Bush: target.Instanced(bushMesh, list); return;
        case Model.Bucket: target.Instanced(bucketMesh, list); return;
        case Model.Barrel: target.Instanced(barrelMesh, list); return;
        case Model.Crate: target.Instanced(crateMesh, list); return;
        case Model.Pickaxe: target.Instanced(pickaxeMesh, list); return;
        case Model.Shovel: target.Instanced(shovelMesh, list); return;
        case Model.Workbench: target.Instanced(workbenchMesh, list); return;
        case Model.Sedan: target.Instanced(sedanMesh, list); return;
        case Model.Hatchback: target.Instanced(hatchbackMesh, list); return;
    }
}
