// What this machine draws each frame, in order: the camera and the light,
// where the people stand and how, the phone light's shadows, the farm, the
// windows, and the picture to the window.
using Rooms;

// Which traveller this machine plays, and how its eye moves.
local singleton Me
{
    int seat = -1;
    float3 eye;
    quaternion turn = quaternion.identity;
    float bob;
    float dt;
    float clock;
    float settle;        // The eye's height, catching up with a step taken
}

// The clips and the bones the people's models have: every one of them is Quaternius' same rig.
struct Moves
{
    Animation idle;
    [Name("Idle_Neutral")] Animation idleNeutral;
    Animation walk;
    Animation run;
    Animation interact;
    Animation wave;
    Bone head;
    Bone neck;
    Bone chest;
    Bone hips;
    [Name("UpperLeg.L")] Bone upperLegL;
    [Name("UpperLeg.R")] Bone upperLegR;
    [Name("LowerLeg.L")] Bone lowerLegL;
    [Name("LowerLeg.R")] Bone lowerLegR;
    [Name("UpperArm.R")] Bone upperArmR;
    [Name("Wrist.R")] Bone wristR;
}

asset SkinnedMesh<Corner, Moves> waltBody = "art/people/walt.glb";
asset SkinnedMesh<Corner, Moves> ruthBody = "art/people/ruth.glb";
asset SkinnedMesh<Corner, Moves> daleBody = "art/people/dale.glb";
asset SkinnedMesh<Corner, Moves> samBody = "art/people/sam.glb";
asset SkinnedMesh<Corner, Moves> joBody = "art/people/jo.glb";

// A person as they'll be drawn this frame.
struct Figure
{
    int who;
    float4x4 transform;
    Pose pose;
    float inside;
}

local singleton Crowd
{
    List<Figure> figures;
    float3 lantern;
    bool lanternLit;
}

[Stage(Layers.Prepare, -1)]
view Mine(Walker walker, mut Me me, with ownership)
{
    me.seat = walker.seat;
}

[Stage(Layers.Prepare, -2)]
view Forget(mut Me me)
{
    me.seat = -1;
}

// The eye: the traveller's, standing, sitting or lying down.
[Stage(Layers.Prepare)]
view Prepare(mut Me me, mut Lens lens, mut Look look, mut Lamps lamps, mut Kit kit, mut Scenery scenery, Story story, query (Walker walker) walkers, Lobby lobby)
{
    if (!scenery.made) MakeScenery(scenery);
    if (!kit.made) MakeKit(kit, scenery);
    me.dt = Math.Min(Frame.dt, 0.05);
    me.clock += me.dt;
    if (me.clock > 3600) me.clock -= 3600;
    var each = Math.Max(2.0, Math.Round(Screen.height / LINES));
    var size = float2(Math.Ceil(Screen.width / each), Math.Ceil(Screen.height / each));
    if (!lens.made)
    {
        lens.made = true;
        lens.scene = RenderTarget(int(size.x), int(size.y), 1, Format.Rgba16f);
        lens.torchMap = RenderTarget(TORCH_PIXELS, TORCH_PIXELS, 1, Format.Depth);
        lens.torchDepth = lens.torchMap.depth;
    }
    else if (size.x != lens.size.x || size.y != lens.size.y)
    {
        lens.scene.Resize(int(size.x), int(size.y));
    }
    lens.size = size;
    look.grid = size * 0.5;
    look.time = me.clock;

    // Whose eyes: this machine's traveller, or Sam's before anyone plays
    var seat = Math.Max(me.seat, 0);
    mut var found = false;
    mut var mine = Walker { };
    foreach (var row in walkers)
    {
        if (row.walker.seat != seat) continue;
        mine = row.walker;
        found = true;
    }
    if (!found) return;
    var moving = Math.Length(mine.velocity.xz);
    if (mine.grounded && moving > 0.3) me.bob += me.dt * moving * 3.2;
    var bob = Math.Sin(me.bob) * 0.03 * Math.Saturate(moving);
    mut var eye = mine.feet + float3(0, EYE_HIGH + bob, 0);
    if (mine.sitting >= 0) eye = mine.feet + float3(0, 1.18, 0);
    if (mine.lying >= 0) eye = mine.feet + float3(0, 0.32, 0) - Flat(mine.yaw) * 0.6;
    // A step up the stairs is taken over a moment, not at once
    me.settle += (eye.y - me.settle) * Math.Min(1, me.dt * 14);
    if (Math.Abs(eye.y - me.settle) > 0.6) me.settle = eye.y;
    eye.y = me.settle;
    me.eye = eye;
    me.turn = quaternion.Euler(-mine.pitch, mine.yaw, 0);
    // Behind the title, before anyone plays: the car on the road, the corn, the light up ahead
    if (!lobby.playing && story.step < 5)
    {
        var drift = Math.Sin(me.clock * 0.05) * 0.08;
        eye = CAR_AT + float3(-3.4, 1.35, -6.5);
        me.eye = eye;
        me.turn = quaternion.Euler(0.04, 0.38 + drift, 0);
    }
    var aspect = size.x / size.y;
    lens.scene.SetCamera(float4x4.TRS(eye, me.turn, float3(1)), float4x4.PerspectiveFov(Math.Radians(FOV), aspect, NEAR, FAR));
    look.eye = eye;
    Audio.SetListener(eye, me.turn);
    Audio.SetFalloff(1.5, 45);

    // The hour: the sky, the sun or moon, the air
    var day = story.daylight;
    look.daylight = day;
    look.lights = story.lights;
    look.fade = story.fade;
    var night = float3(0.004, 0.006, 0.014);
    var nightLow = float3(0.016, 0.02, 0.034);
    var duskHigh = float3(0.022, 0.026, 0.065);
    var duskLow = float3(0.15, 0.07, 0.045);
    var dayHigh = float3(0.32, 0.45, 0.7);
    var dayLow = float3(0.66, 0.68, 0.68);
    if (day < 0.25)
    {
        var t = day / 0.25;
        look.zenith = Math.Lerp(night, duskHigh, t);
        look.horizon = Math.Lerp(nightLow, duskLow, t);
        look.sunWay = Math.Normalize(Math.Lerp(float3(0.45, 0.42, -0.62), float3(-0.95, 0.12, 0.25), t));
        look.sunColor = Math.Lerp(float3(0.05, 0.065, 0.11), float3(0.2, 0.09, 0.045), t);
    }
    else
    {
        var t = Math.Saturate((day - 0.25) / 0.6);
        look.zenith = Math.Lerp(duskHigh, dayHigh, t);
        look.horizon = Math.Lerp(duskLow, dayLow, t);
        look.sunWay = Math.Normalize(Math.Lerp(float3(-0.95, 0.12, 0.25), float3(0.75, 0.45, 0.25), t));
        look.sunColor = Math.Lerp(float3(0.2, 0.09, 0.045), float3(1.15, 1.02, 0.85), t);
    }
    look.ambient = Math.Lerp(look.horizon, look.zenith, 0.5) * 0.85 + float3(0.012, 0.014, 0.022);
    look.fogColor = look.horizon * 0.55 + look.zenith * 0.2;
    look.fog = Math.Lerp(0.03, 0.009, Math.Saturate(day * 1.3));

    // This machine's phone light
    look.torchOn = mine.torch ? 1.0 : 0.0;
    var gaze = LookDirection(mine.yaw, mine.pitch);
    look.torchAt = eye + Flat(mine.yaw + Math.PI * 0.5) * 0.18 - float3(0, 0.22, 0);
    look.torchWay = Math.Normalize(gaze + float3(0, -0.03, 0));

    // The lamps of the house, the car's hazards, the fire, the other traveller's phone
    lamps.list.Clear();
    var lit = story.lights;
    var warm = float3(1.0, 0.72, 0.42);
    if ((lit & LAMP_KITCHEN) != 0) lamps.list.Add(RoomLamp(House(2.45, F1 + 2.15, 8.3), warm * 3.0, 8, House(0, F1 - 0.1, 6.5), House(HOUSE_DEEP, F1_CEILING, HOUSE_WIDE)));
    if ((lit & LAMP_LIVING) != 0) lamps.list.Add(RoomLamp(House(0.5, F1 + 1.55, 0.5), warm * 2.4, 7, House(0, F1 - 0.1, 0), House(HOUSE_DEEP, F1_CEILING, 4.6)));
    if ((lit & LAMP_FIRE) != 0)
    {
        var flicker = 0.75 + Math.Perlin(float2(me.clock * 3.1, 0.5)) * 0.35;
        lamps.list.Add(RoomLamp(House(4.0, F1 + 0.5, 0.8), float3(1.0, 0.45, 0.14) * 2.2 * flicker, 5.5, House(0, F1 - 0.1, 0), House(HOUSE_DEEP, F1_CEILING, 4.6)));
    }
    if ((lit & LAMP_HALL) != 0) lamps.list.Add(RoomLamp(House(1.8, F1 + 2.45, 5.6), warm * 1.6, 6, House(-0.1, F1 - 0.1, 4.4), House(HOUSE_DEEP, F2 + 0.2, 6.7)));
    if ((lit & LAMP_UPSTAIRS) != 0) lamps.list.Add(RoomLamp(House(4.0, F2 + 2.15, 6.0), warm * 1.2, 6, House(0, F2 - 0.1, 4.4), House(HOUSE_DEEP, F2_CEILING, 6.7)));
    if ((lit & LAMP_GUEST) != 0) lamps.list.Add(RoomLamp(House(0.45, F2 + 0.95, 1.05), warm * 1.3, 5, House(0, F2 - 0.1, 0), House(4.0, F2_CEILING, 4.6)));
    if ((lit & LAMP_PORCH) != 0) lamps.list.Add(RoomLamp(House(-0.35, F1 + 2.1, 6.45), float3(1.0, 0.85, 0.5) * 2.6, 10, float3(-500, -10, -500), float3(HOUSE_X + 0.05, 50, 500)));
    if ((lit & LAMP_BARN) != 0) lamps.list.Add(RoomLamp(float3(BARN_X + 5, 3.8, BARN_Z + 7), warm * 2.0, 9, float3(BARN_X, -1, BARN_Z), float3(BARN_X + BARN_DEEP, 9, BARN_Z + BARN_WIDE)));
    // The hazards blink as long as the battery holds: all of Friday night
    if (day < 0.5 && Math.Frac(me.clock * 0.9) < 0.5)
    {
        var amber = float3(1.0, 0.45, 0.08) * 1.6;
        lamps.list.Add(RoomLamp(CAR_AT + float3(0, 0.8, 2.4), amber, 6, float3(-500, -10, -500), float3(500, 50, 500)));
        lamps.list.Add(RoomLamp(CAR_AT + float3(0, 0.8, -2.4), amber, 6, float3(-500, -10, -500), float3(500, 50, 500)));
    }
    foreach (var row in walkers)
    {
        var w = row.walker;
        if (w.seat == seat || !w.torch) continue;
        var from = w.feet + float3(0, 1.38, 0) + Flat(w.yaw + Math.PI * 0.5) * 0.18;
        lamps.list.Add(Lamp { at = from, color = float3(1.0, 0.95, 0.85) * 2.4, reach = 18, way = LookDirection(w.yaw, w.pitch), cone = 0.86,
                              lo = float3(-500, -10, -500), hi = float3(500, 50, 500) });
    }
}

Lamp RoomLamp(float3 at, float3 color, float reach, float3 lo, float3 hi)
{
    return Lamp { at = at, color = color, reach = reach, lo = lo, hi = hi };
}

// Who stands where, and how, this frame; Walt's lantern lights what's round him.
[Stage(Layers.Gather)]
view Gather(mut Crowd crowd, mut Lamps lamps, Me me, query (Npc npc) npcs, query (Walker walker) walkers, Party party)
{
    crowd.figures.Clear();
    crowd.lanternLit = false;
    foreach (var row in npcs)
    {
        var npc = row.npc;
        if (!npc.shown) continue;
        mut var target = float3(0);
        mut var looking = npc.look >= 0;
        if (npc.look == 3) target = npc.lookAt;
        else if (npc.look >= 0)
        {
            mut var nearest = 1000.0;
            foreach (var other in walkers)
            {
                var w = other.walker;
                if (!Present(w, party) && w.seat != 0) continue;
                if (npc.look < 2 && w.seat != npc.look) continue;
                var far = Math.Distance(w.feet, npc.at);
                if (far > nearest) continue;
                nearest = far;
                target = w.feet + float3(0, w.sitting >= 0 ? 1.15 : w.lying >= 0 ? 0.4 : EYE_HIGH, 0);
            }
            looking = nearest < 1000;
        }
        var figure = NpcFigure(npc, looking, target);
        crowd.figures.Add(figure);
        if (npc.pose == Stance.Lantern)
        {
            var hand = Math.Mul(figure.transform, figure.pose.Model(BodyOf(npc.who).skeleton.bones.wristR));
            crowd.lantern = hand.c3.xyz - float3(0, 0.22, 0);
            crowd.lanternLit = true;
        }
    }
    foreach (var row in walkers)
    {
        var w = row.walker;
        if (w.seat == Math.Max(me.seat, 0) || !Present(w, party)) continue;
        crowd.figures.Add(WalkerFigure(w));
    }
    if (crowd.lanternLit)
    {
        var flicker = 0.85 + Math.Perlin(float2(me.clock * 4.3, 2.0)) * 0.2;
        lamps.list.Add(RoomLamp(crowd.lantern, float3(1.0, 0.62, 0.25) * 3.0 * flicker, 11, float3(-500, -10, -500), float3(500, 50, 500)));
    }
}

SkinnedMesh<Corner, Moves> BodyOf(int who)
{
    if (who == WALT) return waltBody;
    if (who == RUTH) return ruthBody;
    if (who == DALE) return daleBody;
    if (who == SAM) return samBody;
    return joBody;
}

// Turn a bone in the model's own space, about its parent's frame.
void TurnBone(mut Pose pose, Bone bone, Bone parent, quaternion turn)
{
    var p = pose.Model(parent);
    var q = Math.Normalize(quaternion(float3x3(p.c0.xyz, p.c1.xyz, p.c2.xyz)));
    var local = pose[bone].rotation;
    pose[bone].rotation = Math.Mul(Math.Inverse(q), Math.Mul(turn, Math.Mul(q, local)));
}

Pose Posed(SkinnedMesh<Corner, Moves> body, Stance kind, bool walking, float clock, float speed)
{
    var moves = body.animations;
    if (walking) return speed > 2.6 ? moves.run.Sample(clock * speed / 3.8, Playback.Loop) : moves.walk.Sample(clock * speed / 1.9, Playback.Loop);
    switch (kind)
    {
        case Stance.Interact: return moves.interact.Sample(clock, Playback.Loop);
        case Stance.Wave: return moves.wave.Sample(clock, Playback.Loop);
        case Stance.Phone: return moves.interact.Sample(0.55);
        case Stance.Lantern: return moves.walk.Sample(clock, Playback.Loop);
        case Stance.Stare: return moves.idleNeutral.Sample(0);
    }
    return moves.idleNeutral.Sample(clock, Playback.Loop);
}

void Sit(mut Pose pose, SkinnedMesh<Corner, Moves> body)
{
    var bones = body.skeleton.bones;
    var bend = quaternion.AxisAngle(float3(1, 0, 0), -Math.PI * 0.5);
    var back = quaternion.AxisAngle(float3(1, 0, 0), Math.PI * 0.5);
    TurnBone(pose, bones.upperLegL, bones.hips, bend);
    TurnBone(pose, bones.upperLegR, bones.hips, bend);
    TurnBone(pose, bones.lowerLegL, bones.upperLegL, back);
    TurnBone(pose, bones.lowerLegR, bones.upperLegR, back);
}

void LookToward(mut Pose pose, SkinnedMesh<Corner, Moves> body, float yaw, float pitch)
{
    var bones = body.skeleton.bones;
    var turn = Math.Mul(quaternion.AxisAngle(float3(0, 1, 0), Math.Clamp(yaw, -1.2, 1.2)), quaternion.AxisAngle(float3(1, 0, 0), Math.Clamp(pitch, -0.5, 0.6)));
    TurnBone(pose, bones.head, bones.neck, turn);
}

Figure NpcFigure(Npc npc, bool looking, float3 target)
{
    var body = BodyOf(npc.who);
    mut var pose = Posed(body, npc.pose, npc.walking, npc.clock, npc.speed);
    mut var place = npc.at;
    if (npc.pose == Stance.Sit && !npc.walking)
    {
        Sit(pose, body);
        place.y += -0.42;
    }
    if (npc.pose == Stance.Bow && !npc.walking) LookToward(pose, body, 0, 0.55);
    var turn = quaternion.AxisAngle(float3(0, 1, 0), npc.yaw);
    var scale = npc.who == RUTH ? 0.93 : npc.who == DALE ? 1.02 : 1.0;
    var transform = float4x4.TRS(place, turn, float3(scale));
    if (looking && npc.pose != Stance.Bow)
    {
        var head = place + float3(0, 1.6 * scale, 0);
        var to = target - head;
        var yaw = TurnBetween(npc.yaw, Math.Atan2(to.x, to.z));
        var pitch = -Math.Atan2(to.y, Math.Length(to.xz));
        LookToward(pose, body, yaw, pitch);
    }
    return Figure { who = npc.who, transform = transform, pose = pose, inside = InsideAt(place + float3(0, 1, 0)) };
}

Figure WalkerFigure(Walker w)
{
    var who = w.seat == 0 ? SAM : JO;
    var body = BodyOf(who);
    var speed = Math.Length(w.velocity.xz);
    mut var pose = Posed(body, Stance.Stand, speed > 0.25, w.walked / Math.Max(speed, 0.5), Math.Max(speed, 0.8));
    if (speed > 0.25) pose = speed > 2.6 ? body.animations.run.Sample(w.walked / 3.4, Playback.Loop) : body.animations.walk.Sample(w.walked / 1.9, Playback.Loop);
    mut var place = w.feet;
    mut var turn = quaternion.AxisAngle(float3(0, 1, 0), w.yaw);
    if (w.sitting >= 0)
    {
        Sit(pose, body);
        place.y -= 0.42;
    }
    if (w.lying >= 0)
    {
        turn = Math.Mul(quaternion.AxisAngle(float3(0, 1, 0), w.yaw), quaternion.AxisAngle(float3(1, 0, 0), Math.PI * 0.5));
        place = w.feet - Flat(w.yaw) * 0.85 + float3(0, 0.05, 0);
    }
    LookToward(pose, body, 0, -w.pitch * 0.6);
    var scale = w.seat == 1 ? 0.95 : 1.0;
    return Figure { who = who, transform = float4x4.TRS(place, turn, float3(scale)), pose = pose, inside = InsideAt(w.feet + float3(0, 1, 0)) };
}

// What the phone light sees, for its shadows: everything near enough to be in its way.
[Stage(Layers.Shadows)]
view TorchShadows(mut Look look, Lens lens, Kit kit, Scenery scenery, Crowd crowd, Farm farm)
{
    if (look.torchOn < 0.5) return;
    var turn = quaternion.LookRotation(look.torchWay, Math.Abs(look.torchWay.y) > 0.95 ? float3(0, 0, 1) : float3(0, 1, 0));
    lens.torchMap.Clear(Color.white);
    lens.torchMap.SetCamera(float4x4.TRS(look.torchAt, turn, float3(1)), float4x4.PerspectiveFov(Math.Radians(TORCH_FOV), 1, 0.1, TORCH_FAR));
    look.toTorch = lens.torchMap.WorldToClip();
    lens.torchMap.Mesh(scenery.mesh, scenery.faces, float4x4.identity);
    for (var model = 0; model < kit.near.count; model++)
    {
        if (kit.near[model].count == 0 || Model(model) == Model.Corn || Model(model) == Model.CornYoung) continue;
        CastKit(lens.torchMap, Model(model), kit.near[model]);
    }
    foreach (var figure in crowd.figures) lens.torchMap.SkinnedMesh(BodyOf(figure.who), figure.transform, figure.pose);
    for (var i = 0; i < farm.doorCount; i++) lens.torchMap.Mesh(kit.box, kit.boxFaces, DoorPlace(farm.doors[i]));
}

[Stage(Layers.Scene)]
view DrawScene(Lens lens, Kit kit, Scenery scenery, Crowd crowd, Farm farm, Story story, Look look)
{
    lens.scene.Clear(Color(look.fogColor, 1));
    lens.scene.Depth(Depth.None),
    lens.scene.Cull(Cull.Front)
    {
        lens.scene.Mesh(kit.dome, kit.domeFaces, float4x4.Translate(look.eye), SkyDome);
    }
    lens.scene.Mesh(scenery.mesh, scenery.faces, float4x4.identity, Snap, Built);
    for (var i = 0; i < farm.doorCount; i++)
    {
        var door = farm.doors[i];
        lens.scene.Mesh(kit.box, kit.boxFaces, DoorPlace(door), Snap, Moving, PieceLook { tint = door.tint, stuff = float(int(Stuff.Planks)), inside = 1 });
    }
    for (var i = 0; i < 3; i++)
    {
        if (story.binned[i]) continue;
        lens.scene.Mesh(kit.box, kit.boxFaces, SackPlace(story, i), Snap, Moving, PieceLook { tint = Color(0.55, 0.47, 0.33), stuff = float(int(Stuff.Hay)), inside = 0.8 });
    }
    var lit = story.lights;
    var cord = PieceLook { tint = Color(0.12, 0.1, 0.08), stuff = float(int(Stuff.Plain)), inside = 1 };
    lens.scene.Mesh(kit.box, kit.boxFaces, float4x4.TRS(House(2.45, F1 + 2.3, 8.3 - 0.01), quaternion.identity, float3(0.02, 0.4, 0.02)), Snap, Moving, cord);
    lens.scene.Mesh(kit.box, kit.boxFaces, float4x4.TRS(House(2.45, F1 + 2.12, 8.3 - 0.25), quaternion.identity, float3(0.5, 0.18, 0.5)), Snap, Moving,
                    PieceLook { tint = Color(0.32, 0.36, 0.22), stuff = float(int(Stuff.Trim)), inside = 1 });
    lens.scene.Mesh(kit.box, kit.boxFaces, float4x4.TRS(House(2.45, F1 + 2.06, 8.3 - 0.08), quaternion.identity, float3(0.16, 0.08, 0.16)), Snap, Moving,
                    PieceLook { tint = (lit & LAMP_KITCHEN) != 0 ? Color(1, 0.8, 0.5) : Color(0.15, 0.15, 0.14), stuff = float(int((lit & LAMP_KITCHEN) != 0 ? Stuff.Bulb : Stuff.Plain)), inside = 1 });
    lens.scene.Mesh(kit.box, kit.boxFaces, float4x4.TRS(House(1.8, F1 + 2.55, 5.6 - 0.08), quaternion.identity, float3(0.16, 0.16, 0.16)), Snap, Moving,
                    PieceLook { tint = (lit & LAMP_HALL) != 0 ? Color(1, 0.85, 0.6) : Color(0.15, 0.15, 0.14), stuff = float(int((lit & LAMP_HALL) != 0 ? Stuff.Bulb : Stuff.Plain)), inside = 1 });
    lens.scene.Mesh(kit.box, kit.boxFaces, float4x4.TRS(House(4.0, F2 + 2.3, 6.0 - 0.08), quaternion.identity, float3(0.16, 0.16, 0.16)), Snap, Moving,
                    PieceLook { tint = (lit & LAMP_UPSTAIRS) != 0 ? Color(1, 0.85, 0.6) : Color(0.15, 0.15, 0.14), stuff = float(int((lit & LAMP_UPSTAIRS) != 0 ? Stuff.Bulb : Stuff.Plain)), inside = 1 });
    lens.scene.Mesh(kit.box, kit.boxFaces, TarpPlace(story), Snap, Moving, PieceLook { tint = Color(0.18, 0.26, 0.3), stuff = float(int(Stuff.Tarp)), inside = 0.8 });
    foreach (var figure in crowd.figures)
        lens.scene.SkinnedMesh(BodyOf(figure.who), figure.transform, figure.pose, Snap, Person, PersonLook { inside = figure.inside });
    if (crowd.lanternLit)
        lens.scene.Mesh(kit.box, kit.boxFaces, float4x4.TRS(crowd.lantern - float3(0, 0.12, 0), quaternion.identity, float3(0.14, 0.24, 0.14)), Snap, Moving,
                        PieceLook { tint = Color(1.0, 0.7, 0.35), stuff = float(int(Stuff.Glow)), inside = 0 });
}

[Stage(Layers.Glass)]
view Glass(Lens lens, Scenery scenery, Story story)
{
    if (!lens.made || !scenery.made || story.fade >= 1) return;
    lens.scene.Depth(Depth.Read),
    lens.scene.Cull(Cull.None)
    {
        lens.scene.Mesh(scenery.panes, scenery.paneFaces, float4x4.identity, Snap, Pane);
    }
}

[Stage(Layers.Show)]
view Show(Lens lens)
{
    if (!lens.made) return;
    Draw.Blit(lens.scene.color, Draw.window, Develop);
}

float4x4 DoorPlace(Door door)
{
    var angle = door.shut + door.swing * door.open;
    return float4x4.TRS(door.hinge, quaternion.AxisAngle(float3(0, 1, 0), angle), float3(0.05, door.high, door.wide));
}

float4x4 SackPlace(Story story, int i)
{
    var lift = story.holders[i] != 0 ? 0.55 : 0.0;
    var at = story.sacks[i] + float3(0, lift, 0);
    return float4x4.TRS(at - float3(0, 0, 0.2), quaternion.AxisAngle(float3(0, 1, 0), i * 0.7), float3(0.62, 0.34, 0.42));
}

// The tarp over the car in the barn, or thrown off beside it.
float4x4 TarpPlace(Story story)
{
    var car = float3(BARN_X + 5.0, 0, BARN_Z + BARN_WIDE - 3.6);
    if (story.pulled) return float4x4.TRS(car + float3(0, 0, 1.6), quaternion.identity, float3(3.2, 0.12, 1.2));
    return float4x4.TRS(car - float3(0, 0, 1.25), quaternion.identity, float3(5.0, 1.95, 2.5));
}
