// How the farm looks: drawn small, as a console of the nineties drew, and
// lit by what's actually there. The sky and the sun or the moon outside,
// the house's lamps (each in its own room), Walt's lantern, the car's
// hazard lights, and each traveller's phone light: this machine's casts
// shadows. Light is kept as light until the last pass, which squeezes it
// into a few shades a channel, in a pattern, with grain over it.

enum Layers { Prepare, Gather, Shadows, Scene, Glass, Show, Hud }

const float LINES = 270;          // About how many lines the picture has, whatever the window's
const float SHADES = 30;          // Shades of each channel in the last pass
const float NEAR = 0.07;
const float FAR = 320;
const float FOV = 68;             // Degrees, top to bottom
const int TORCH_PIXELS = 512;
const float TORCH_FAR = 26;
const float TORCH_FOV = 64;       // Degrees: the cone's light reaches this wide, and its image a little wider

struct Lamp
{
    float3 at;
    float3 color;
    float reach;
    float3 way;        // A spotlight's direction, and the cosine of its half angle: under -1 for a bulb that lights all round
    float cone = -2;
    float3 lo;         // The room it lights: nothing outside it (no light goes through a wall)
    float3 hi;
}

// What every frag reads of the frame: the camera, the hour, the air, the phone light that casts shadows.
local singleton Look
{
    float3 eye;
    float2 grid = float2(240, 135);
    float time;
    float daylight;
    float3 zenith;
    float3 horizon;
    float3 sunWay = float3(0, 1, 0);
    float3 sunColor;
    float3 ambient;
    float fog = 0.02;
    float3 fogColor;
    float4x4 toTorch;
    float3 torchAt;
    float3 torchWay = float3(0, 0, 1);
    float torchOn;
    int lights;
    float fade;
    float hurt;        // A jolt of the picture, as something is seen
}

local singleton Lamps
{
    List<Lamp> list;
}

local singleton Lens
{
    RenderTarget scene;
    RenderTarget torchMap;
    DepthTexture torchDepth;
    float2 size;
    bool made;
}

// Each kit model's list of where it's drawn, by Model, and the ones that are culled by distance.
local singleton Kit
{
    List<List<Placed>> placed;
    List<List<Placed>> near;
    List<float3> offsets;      // What centres each model on its foot: the middle of its base
    List<Corner> box;          // A unit box, for doors and sacks: x -0.5 to 0.5, y 0 to 1, z 0 to 1
    List<int> boxFaces;
    List<Corner> dome;
    List<int> domeFaces;
    bool made;
}

// The values a kit model's draw gives its frag.
struct KitLook
{
    float skin;        // 0 its own colours, 1 the car kit's sheet, 2 the survival kit's
    float dull = 0.6;  // How much of the kit's bright colour is taken out
    float season;      // How far into autumn: green goes to straw
    float glow;        // Its pale parts are a lamp's shade, lit from inside
}

struct PieceLook
{
    Color tint = Color.white;
    float stuff;
    float inside = 1;
}

struct PersonLook
{
    float inside;
    float shade = 1;   // Darker for someone barely seen
}

[Filter(Filter.Point)] asset Texture carSkin = "art/props/car-colormap.png";
[Filter(Filter.Point)] asset Texture kitSkin = "art/props/survival-colormap.png";

float3 Rgb(Color c)
{
    return float3(c.r, c.g, c.b);
}

float Speck(float x, float y)
{
    return (Math.Hash(int2(int(Math.Floor(x)), int(Math.Floor(y)))) & 1023) / 1023.0;
}

// Whether a place is under the house's roof, or the barn's.
float InsideAt(float3 at)
{
    if (at.x > HOUSE_X - 0.1 && at.x < HOUSE_X + HOUSE_DEEP + 0.1 && at.z > HOUSE_Z - 0.1 && at.z < HOUSE_Z + HOUSE_WIDE + 0.1 && at.y < F2_CEILING) return 1;
    if (at.x > BARN_X && at.x < BARN_X + BARN_DEEP && at.z > BARN_Z && at.z < BARN_Z + BARN_WIDE && at.y < BARN_HIGH) return 0.8;
    return 0;
}

// ---- Light ----

// How much of this machine's phone light reaches a place: its cone, how far, and whether anything is in the way.
float TorchReach(DepthTexture depth, Look look, float3 world, float3 normal)
{
    if (look.torchOn < 0.5) return 0;
    var to = world - look.torchAt;
    var far = Math.Length(to);
    if (far > TORCH_FAR) return 0;
    var way = to / Math.Max(far, 0.0001);
    var along = Math.Dot(way, look.torchWay);
    var cone = Math.SmoothStep(0.88, 0.975, along);
    if (cone <= 0) return 0;
    float4 clip = Math.Mul(look.toTorch, float4(world + normal * (0.05 + far * 0.012), 1));
    if (clip.w <= 0.001) return 0;
    var ndc = clip.xyz / clip.w;
    var uv = float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    var seen = depth.Compare(uv, ndc.z * 0.5 + 0.5 - 0.0012);
    var facing = Math.Saturate(-Math.Dot(normal, way) * 0.85 + 0.15);
    // A hot middle, a soft rim, and the light thins with distance
    var hot = 1 + Math.SmoothStep(0.97, 0.997, along) * 0.8;
    return cone * hot * seen * facing * 2.4 / (1 + far * far * 0.35);
}

float3 LampLight(List<Lamp> lamps, float3 world, float3 normal)
{
    mut var sum = float3(0);
    foreach (var lamp in lamps)
    {
        if (world.x < lamp.lo.x || world.y < lamp.lo.y || world.z < lamp.lo.z || world.x > lamp.hi.x || world.y > lamp.hi.y || world.z > lamp.hi.z) continue;
        var to = lamp.at - world;
        var far = Math.Length(to);
        if (far > lamp.reach) continue;
        var way = to / Math.Max(far, 0.0001);
        mut var amount = Math.Saturate(Math.Dot(normal, way) * 0.8 + 0.2);
        var fall = 1 - far / lamp.reach;
        amount *= fall * fall / (1 + far * far * 0.3);
        if (lamp.cone > -1.5) amount *= Math.SmoothStep(lamp.cone, lamp.cone + 0.08, -Math.Dot(way, lamp.way));
        sum += lamp.color * amount;
    }
    return sum;
}

// A surface of `paint` at a place, lit by everything: the sky, the sun or moon, the lamps, the phone lights.
float3 Shade(float3 paint, float3 world, float3 normal, float inside, Look look, List<Lamp> lamps, DepthTexture torch)
{
    var sky = Math.Lerp(look.ambient * 0.6, look.ambient, normal.y * 0.5 + 0.5);
    var shut = Math.Lerp(float3(1.0), float3(1.0, 0.9, 0.78) * (0.16 + look.daylight * 0.55), inside);
    var sun = look.sunColor * Math.Saturate(Math.Dot(normal, look.sunWay)) * (1 - inside);
    var light = sky * shut + sun + LampLight(lamps, world, normal) + float3(1.0, 0.95, 0.85) * TorchReach(torch, look, world, normal);
    return paint * light;
}

// The air between the eye and a place: thicker with distance, the sky's colour.
float3 Hazed(float3 lit, float3 world, Look look)
{
    var far = Math.Distance(world, look.eye);
    var clear = Math.Exp(-far * look.fog);
    return Math.Lerp(look.fogColor, lit, clear);
}

// ---- Paint ----

// Where a place is on a surface, in texels of a sixteenth of a metre: across a floor, or along and up a wall.
float2 Texel(float3 world, float3 normal)
{
    if (Math.Abs(normal.y) > 0.5) return float2(Math.Floor(world.x * 16), Math.Floor(world.z * 16));
    if (Math.Abs(normal.x) > Math.Abs(normal.z)) return float2(Math.Floor(world.z * 16), Math.Floor(world.y * 16));
    return float2(Math.Floor(world.x * 16), Math.Floor(world.y * 16));
}

bool Is(float stuff, Stuff which)
{
    return Math.Abs(stuff - float(int(which))) < 0.5;
}

// A surface's paint, from its tint and what it's made of, and in `glow` how much is its own light.
float3 Paint(float3 base, float stuff, float3 world, float3 normal, float time, out float glow)
{
    glow = 0;
    var t = Texel(world, normal);
    var speck = Speck(t.x, t.y);
    mut var paint = base;
    if (Is(stuff, Stuff.Wallpaper))
    {
        // Stripes, a small pattern between them, grime low down and stains where the damp gets in
        var stripe = t.x - Math.Floor(t.x / 6) * 6;
        paint *= stripe < 1 ? 0.78 : 1.0;
        if (stripe > 2 && stripe < 4 && (Math.Floor(t.y) - Math.Floor(t.y / 5) * 5) < 1) paint *= 0.82;
        paint *= 0.92 + speck * 0.1;
        var low = world.y - Math.Floor(world.y / 3.3) * 3.3;
        if (low < 0.7) paint *= 0.75 + low * 0.35;
        var stain = Math.Perlin(float2(world.x + world.z, world.y) * 0.9);
        if (stain > 0.35) paint *= 0.8;
    }
    else if (Is(stuff, Stuff.Planks))
    {
        var along = Math.Abs(normal.y) > 0.5 ? t.y : t.x;
        var across = Math.Abs(normal.y) > 0.5 ? t.x : t.y;
        var board = Math.Floor(along / 3);
        var shade = Speck(board, Math.Floor((across + Speck(board, 9) * 40) / 40));
        paint *= 0.75 + shade * 0.35;
        if (along - board * 3 < 1) paint *= 0.62;
        paint *= 0.9 + speck * 0.12;
    }
    else if (Is(stuff, Stuff.Siding))
    {
        var row = Math.Floor(t.y / 3);
        paint *= t.y - row * 3 < 1 ? 0.78 : 0.95 + Speck(row, Math.Floor(t.x / 24)) * 0.08;
        var peel = Math.Perlin(float2(t.x, t.y) * 0.07);
        if (peel > 0.42) paint = float3(0.34, 0.3, 0.26) * (0.8 + speck * 0.3);
    }
    else if (Is(stuff, Stuff.Shingle))
    {
        var row = Math.Floor(t.y / 4);
        var shift = (row - Math.Floor(row / 2) * 2) * 3;
        var tab = Math.Floor((t.x + shift) / 6);
        paint *= 0.7 + Speck(tab, row) * 0.45;
        if (t.y - row * 4 < 1) paint *= 0.5;
    }
    else if (Is(stuff, Stuff.Gravel))
    {
        paint *= 0.6 + speck * 0.55;
        if (Speck(t.x + 31, t.y) > 0.9) paint = float3(0.5, 0.48, 0.44);
        var rut = Math.Abs(world.x) - 1.1;
        if (Math.Abs(rut) < 0.35) paint *= 0.8;
    }
    else if (Is(stuff, Stuff.Grass))
    {
        var patch = Math.Perlin(world.xz * 0.11);
        var tuft = Speck(Math.Floor(t.x / 2), Math.Floor(t.y / 2));
        paint = Math.Lerp(float3(0.22, 0.24, 0.12), float3(0.36, 0.33, 0.17), Math.Saturate(patch + 0.5));
        paint *= 0.75 + tuft * 0.4;
    }
    else if (Is(stuff, Stuff.Dirt))
    {
        var furrow = Math.Sin(world.x * 4.2);
        paint *= 0.8 + furrow * 0.12 + speck * 0.18;
    }
    else if (Is(stuff, Stuff.Plaster))
    {
        paint *= 0.9 + speck * 0.08;
        var crack = Math.Abs(Math.Perlin(float2(t.x, t.y) * 0.05));
        if (crack < 0.012) paint *= 0.7;
    }
    else if (Is(stuff, Stuff.Barnwood))
    {
        var board = Math.Floor(t.x / 4);
        paint *= 0.72 + Speck(board, 3) * 0.3;
        if (t.x - board * 4 < 1) paint *= 0.5;
        var weather = Math.Perlin(float2(board * 1.7, t.y * 0.03));
        if (weather > 0.35) paint = Math.Lerp(paint, float3(0.24, 0.2, 0.18), 0.35);
    }
    else if (Is(stuff, Stuff.Stone))
    {
        var row = Math.Floor(t.y / 4);
        var shift = (row - Math.Floor(row / 2) * 2) * 4;
        var block = Math.Floor((t.x + shift) / 8);
        paint *= 0.75 + Speck(block, row) * 0.35;
        if (t.y - row * 4 < 1 || t.x + shift - block * 8 < 1) paint *= 0.6;
    }
    else if (Is(stuff, Stuff.Tile))
    {
        var square = Math.Floor(t.x / 5) + Math.Floor(t.y / 5);
        paint = square - Math.Floor(square / 2) * 2 < 1 ? float3(0.62, 0.6, 0.52) : float3(0.25, 0.33, 0.27);
        paint *= 0.88 + speck * 0.14;
    }
    else if (Is(stuff, Stuff.Hay))
    {
        paint *= 0.7 + Speck(Math.Floor(t.x / 2), t.y) * 0.45;
    }
    else if (Is(stuff, Stuff.Carpet))
    {
        var edge = Math.Abs(normal.y) > 0.5 ? world.z - HOUSE_Z : world.y;
        paint *= 0.85 + speck * 0.2;
        var border = edge - Math.Floor(edge) ;
        if (border < 0.08 || border > 0.92) paint = float3(0.5, 0.42, 0.2);
    }
    else if (Is(stuff, Stuff.Brick))
    {
        var row = Math.Floor(t.y / 2);
        var shift = (row - Math.Floor(row / 2) * 2) * 2;
        var brick = Math.Floor((t.x + shift) / 4);
        paint *= 0.75 + Speck(brick, row) * 0.3;
        if (t.y - row * 2 < 0.5 || t.x + shift - brick * 4 < 0.5) paint = float3(0.35, 0.33, 0.3);
    }
    else if (Is(stuff, Stuff.Glow))
    {
        // Embers: lumps, each glowing in its own time
        var lump = Speck(Math.Floor(t.x / 2), Math.Floor(t.y / 2));
        var beat = Speck(Math.Floor(t.x / 2) + Math.Floor(time * 6 + lump * 9), 4);
        paint = lump > 0.5 ? Math.Lerp(float3(0.9, 0.25, 0.05), float3(1.0, 0.6, 0.15), beat) * 2.2 : float3(0.06, 0.04, 0.03);
        glow = lump > 0.5 ? 1.0 : 0.0;
    }
    else if (Is(stuff, Stuff.Bulb))
    {
        paint = base * 2.5;
        glow = 1;
    }
    else if (Is(stuff, Stuff.Trim))
    {
        paint *= 0.9 + speck * 0.12;
    }
    else if (Is(stuff, Stuff.Tarp))
    {
        var fold = Math.Sin(world.x * 7 + world.z * 3 + Math.Perlin(world.xz * 2) * 3);
        paint *= 0.78 + fold * 0.14 + speck * 0.08;
    }
    else
    {
        paint *= 0.92 + speck * 0.1;
    }
    return paint;
}

// Corners moved onto the picture's pixels, as a console that kept no fractions would put them. What's behind the
// eye is left where it is.
vert Snap(mut Corner corner, out float4 clip, Look look)
{
    float4 at = this.clip;
    if (at.w < 0.2)
    {
        clip = at;
        return;
    }
    float2 seen = Math.Floor(at.xy / at.w * look.grid + float2(0.5)) / look.grid;
    clip = float4(seen * at.w, at.z, at.w);
}

// What stands still: walls, floors, the ground, the roof.
frag Built(Corner corner, out Color color, Look look, Lamps lamps, Lens lens)
{
    var normal = Math.Normalize(corner.normal);
    var paint = Paint(Rgb(corner.color), corner.stuff, this.world, normal, look.time, out var glow);
    var lit = Math.Lerp(Shade(paint, this.world, normal, corner.inside, look, lamps.list, lens.torchDepth), paint, glow);
    color = Color(Hazed(lit, this.world, look), 1);
}

// The kits' furniture, trees, corn and the cars.
frag KitLit(Corner corner, out Color color, Instance instance, Placed placed, KitLook kit, Look look, Lamps lamps, Lens lens)
{
    var normal = instance.Normal(corner.normal);
    mut var paint = Rgb(corner.color);
    if (kit.skin > 0.5 && kit.skin < 1.5)
    {
        var sampled = carSkin.Sample(corner.uv);
        paint = Rgb(sampled) * Rgb(sampled) * paint;
    }
    if (kit.skin > 1.5)
    {
        var sampled = kitSkin.Sample(corner.uv);
        paint = Rgb(sampled) * Rgb(sampled) * paint;
    }
    var grey = (paint.x + paint.y + paint.z) / 3;
    paint = Math.Lerp(paint, float3(grey * 1.15, grey * 0.95, grey * 0.55), kit.season);
    paint = Math.Lerp(paint, float3(grey), kit.dull) * (1 - kit.dull * 0.45);
    var at = Math.Transform(instance.transform, corner.position);
    var t = float2(Math.Floor((corner.position.x + corner.position.z) * 48), Math.Floor(corner.position.y * 48));
    paint *= 0.88 + Speck(t.x, t.y) * 0.16;
    mut var lit = Shade(paint, this.world, normal, placed.inside, look, lamps.list, lens.torchDepth);
    if (kit.glow > 0 && grey > 0.45) lit = Math.Lerp(lit, float3(1.0, 0.75, 0.42) * 1.6, kit.glow);
    color = Color(Hazed(lit, at, look), 1);
}

// Doors, sacks, the tarp: boxes of the plan's stuff that move.
frag Moving(Corner corner, out Color color, Instance instance, PieceLook piece, Look look, Lamps lamps, Lens lens)
{
    var normal = instance.Normal(corner.normal);
    var paint = Paint(Rgb(piece.tint), piece.stuff, this.world, normal, look.time, out var glow);
    var lit = Math.Lerp(Shade(paint, this.world, normal, piece.inside, look, lamps.list, lens.torchDepth), paint, glow);
    color = Color(Hazed(lit, this.world, look), 1);
}

frag Person(Corner corner, out Color color, Instance instance, PersonLook person, Look look, Lamps lamps, Lens lens)
{
    var normal = instance.Normal(corner.normal);
    var paint = Rgb(corner.color) * person.shade;
    var lit = Shade(paint, this.world, normal, person.inside, look, lamps.list, lens.torchDepth);
    color = Color(Hazed(lit, this.world, look), 1);
}

// The windows: dark glass that shows what's past it, and a lit room's warmth from outside.
frag Pane(Corner corner, out Color color, Look look, Lamps lamps)
{
    var normal = Math.Normalize(corner.normal);
    var toEye = Math.Normalize(look.eye - this.world);
    var edge = 1 - Math.Abs(Math.Dot(toEye, normal));
    var sky = Math.Lerp(look.horizon, look.zenith, 0.4);
    mut var lit = sky * (0.25 + edge * 0.6) + LampLight(lamps.list, this.world, normal) * 0.15;
    // A room with its lamp lit glows, seen from the yard
    var room = RoomGlow(look.lights, this.world);
    lit += float3(1.0, 0.58, 0.25) * room * (InsideAt(look.eye) > 0.5 ? 0.0 : 0.7);
    var alpha = Math.Saturate(0.16 + edge * 0.3 + room * (InsideAt(look.eye) > 0.5 ? 0.0 : 0.25));
    var far = Math.Distance(this.world, look.eye);
    color = Color(Math.Lerp(look.fogColor, lit, Math.Exp(-far * look.fog * 0.35)), alpha);
}

// How lit the room behind a window is, by which of the house's lamps are on.
float RoomGlow(int lights, float3 at)
{
    var u = at.x - HOUSE_X;
    var v = at.z - HOUSE_Z;
    var up = at.y > F1_CEILING;
    if (!up)
    {
        if (v > 6.6) return (lights & LAMP_KITCHEN) != 0 ? 1.0 : 0.0;
        if (v < 4.5) return (lights & LAMP_LIVING) != 0 ? 0.9 : (lights & LAMP_FIRE) != 0 ? 0.35 : 0.0;
        return (lights & LAMP_HALL) != 0 ? 0.7 : 0.0;
    }
    if (v < 4.5 && u < 4) return (lights & LAMP_GUEST) != 0 ? 0.55 : 0.0;
    return (lights & LAMP_UPSTAIRS) != 0 ? 0.4 : 0.0;
}

// The sky: a dome round the eye, from the horizon's colour to the zenith's, with the stars and the moon at night.
frag SkyDome(Corner corner, out Color color, Look look)
{
    var way = Math.Normalize(corner.position);
    var up = Math.Saturate(way.y);
    mut var sky = Math.Lerp(look.horizon, look.zenith, Math.Pow(up, 0.55));
    // The last of the sunset low in the west
    var west = Math.Saturate(-way.x * 0.8 + 0.2) * Math.Saturate(1 - up * 3.5);
    var dusk = Math.Saturate(1 - Math.Abs(look.daylight - 0.25) * 6);
    sky += float3(0.6, 0.2, 0.06) * west * west * dusk;
    var night = Math.Saturate(1 - look.daylight * 4);
    if (night > 0 && way.y > 0)
    {
        var cell = int3(int(Math.Floor(way.x * 160)), int(Math.Floor(way.y * 160)), int(Math.Floor(way.z * 160)));
        var star = Math.Hash(cell) & 1023;
        if (star < 6) sky += float3(0.5, 0.52, 0.6) * night * (0.3 + (star & 3) * 0.25);
    }
    var moonWay = Math.Normalize(float3(0.45, 0.42, -0.62));
    var moon = Math.Dot(way, moonWay);
    if (moon > 0.9992) sky = Math.Lerp(sky, float3(0.85, 0.85, 0.75), Math.Max(night, 0.15));
    else if (moon > 0.995) sky += float3(0.06, 0.07, 0.09) * Math.Max(night, 0.1);
    // Below the horizon is the ground's haze
    if (way.y < 0) sky = look.fogColor;
    color = Color(sky, 1);
}

// Which of sixteen steps a pixel's turn is, in a pattern of four by four.
float Turn(float2 pixel)
{
    int x = int(pixel.x) & 3;
    int y = int(pixel.y) & 3;
    int low = ((x ^ y) & 1) * 2 + (y & 1);
    int high = (((x >> 1) ^ (y >> 1)) & 1) * 2 + ((y >> 1) & 1);
    return (low * 4 + high + 0.5) / 16;
}

// The picture, to the window: light brought under one, a few shades a channel, grain, the corners darker.
frag Develop(Vertex vertex, out Color color, Texture source, Lens lens, Look look)
{
    var pixel = Math.Floor(vertex.uv * lens.size);
    var seen = Rgb(source.Sample((pixel + float2(0.5)) / lens.size, Filter.Point));
    var exposed = seen * 1.35;
    mut var shown = exposed / (float3(1) + exposed);
    shown = float3(Math.Pow(shown.x, 0.4545), Math.Pow(shown.y, 0.4545), Math.Pow(shown.z, 0.4545));
    var middle = vertex.uv - float2(0.5);
    shown *= 1 - Math.Saturate(Math.Dot(middle, middle) * 1.1 - 0.05);
    var grain = (Speck(pixel.x + Math.Floor(look.time * 24) * 13, pixel.y) - 0.5) * 0.045;
    shown += float3(grain);
    shown *= 1 - look.fade;
    var turn = Turn(pixel);
    color = Color(Math.Floor(shown.x * SHADES + turn) / SHADES, Math.Floor(shown.y * SHADES + turn) / SHADES, Math.Floor(shown.z * SHADES + turn) / SHADES, 1);
}
