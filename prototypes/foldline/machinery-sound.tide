// The nearest moving mechanism supplies the room's motor bed. Every mechanism
// has its own arrival clunk, so doors and platforms still read individually.
local singleton MachineryEars
{
    Sound motor;
    Entity[32] entities;
    bool[32] moving;
    int chamber = -1;
    float door;
}

[After(Sounds)]
view HearMachinery(Operator viewer, query (Mover mover) movers, Arena arena, Place place, Control control, Interface ui, mut MachineryEars ears)
{
    if (viewer.id != control.active) return;
    bool changed = ears.chamber != arena.chamber;
    mut int count = 0;
    mut float nearest = 1000000;
    mut float3 at = float3(0);
    foreach (var row in movers)
    {
        var mover = row.mover;
        if (mover.chamber != arena.chamber || count >= 32) continue;
        bool same = !changed && ears.entities[count] == row.entity;
        bool moving = Math.LengthSq(mover.velocity) > .001;
        float distance = Math.DistanceSq(mover.at, viewer.position);
        if (moving && distance < nearest)
        {
            nearest = distance;
            at = mover.at;
        }
        if (same && ears.moving[count] && !moving) Audio.Play(cubeThud, mover.at, .6, .55);
        ears.entities[count] = row.entity;
        ears.moving[count] = moving;
        count += 1;
    }
    for (int slot = count; slot < 32; slot++)
    {
        ears.entities[slot] = default;
        ears.moving[slot] = false;
    }
    LoopingAt(ears.motor, gateRun, at, ui.open ? .15 : .3, nearest < 1000000);
    ears.motor.pitch = .72;
    if (!changed && ears.door > .001 && ears.door < .999 && (arena.door <= .001 || arena.door >= .999))
        Audio.Play(cubeThud, LiftPoint(place.arrival, place.arrivalYaw, float3(0, 2, 2.1)), .65, .55);
    ears.door = arena.door;
    ears.chamber = arena.chamber;
}
