// FOLDLINE's places: which there are, the order they're come to in on the way
// down, and what a place is built with. Each place is built by one function in
// a file of its own (place_<name>.tide), which says everything the match needs
// of it in `Place` and spawns the rest: walls, lifts, plates and the wires from
// them, what they work, frames, pads, pits, loose things and lamps. All of it
// is swept away when the next place is built.
using Box3D;

const int BENCH = 0;     // Every mechanic in one plain room, for tests and for looking at
const int LANDING = 1;   // A lift that stops on its way down for a moment, and goes on
const int RECEPTION = 2;
const int MAILROOM = 3;
const int LAMPS_OUT = 4;
const int SHOWROOM = 5;
const int WEIGHBRIDGE = 6;
const int THE_SLOT = 7;
const int CRAWLSPACE = 8;
const int LONG_THROW = 9;
const int THE_WARD = 10;
const int ARCHIVE = 11;
const int EXCHANGE = 12;
const int RED_STAIR = 13;
const int ATRIUM = 14;
const int RECEPTION_AGAIN = 15;
const int PLACES = 16;
const int DESCENT = 14;

// The final stop holds. The test bench is never a campaign destination.
int PlaceAt(int depth)
{
    switch (Math.Clamp(depth, 0, DESCENT - 1))
    {
        case 0: return RECEPTION;
        case 1: return MAILROOM;
        case 2: return LAMPS_OUT;
        case 3: return SHOWROOM;
        case 4: return WEIGHBRIDGE;
        case 5: return THE_SLOT;
        case 6: return CRAWLSPACE;
        case 7: return LONG_THROW;
        case 8: return THE_WARD;
        case 9: return ARCHIVE;
        case 10: return EXCHANGE;
        case 11: return RED_STAIR;
        case 12: return ATRIUM;
        default: return RECEPTION_AGAIN;
    }
}

// The first depth a place is at on the way down, or -1 for one that isn't.
int DepthOf(int id)
{
    for (var depth = 0; depth < DESCENT; depth++)
        if (PlaceAt(depth) == id) return depth;
    return -1;
}

// What the menu calls a place.
string PlaceLabel(int id)
{
    return id switch { BENCH => "BENCH", LANDING => "LANDING", RECEPTION => "RECEPTION", MAILROOM => "MAILROOM",
                       LAMPS_OUT => "LAMPS OUT", SHOWROOM => "SHOWROOM", WEIGHBRIDGE => "WEIGHBRIDGE", THE_SLOT => "THE SLOT",
                       CRAWLSPACE => "CRAWLSPACE", LONG_THROW => "LONG THROW", THE_WARD => "THE WARD", ARCHIVE => "ARCHIVE",
                       EXCHANGE => "EXCHANGE", RED_STAIR => "RED STAIR", ATRIUM => "ATRIUM", RECEPTION_AGAIN => "RECEPTION?", _ => "" };
}

void BuildPlace(mut Arena arena, mut Place place, mut Fold fold, int id)
{
    switch (id)
    {
        case RECEPTION:
            BuildReception(arena, place, fold);
            return;
        case ARCHIVE:
            BuildArchive(arena, place, fold);
            return;
        case MAILROOM:
            BuildMailroom(arena, place, fold);
            return;
        case EXCHANGE:
            BuildExchange(arena, place, fold);
            return;
        case ATRIUM:
            BuildCargoAtrium(arena, place, fold);
            return;
        case WEIGHBRIDGE:
            BuildWeighbridge(arena, place, fold);
            return;
        case LONG_THROW:
            BuildLongThrow(arena, place, fold);
            return;
        case CRAWLSPACE:
            BuildCrawlspace(arena, place, fold);
            return;
        case LAMPS_OUT:
            BuildLampsOut(arena, place);
            return;
        case SHOWROOM:
            BuildShowroom(arena, place);
            return;
        case THE_SLOT:
            BuildTheSlot(arena, place);
            return;
        case THE_WARD:
            BuildTheWard(arena, place);
            return;
        case RED_STAIR:
            BuildRedStair(arena, place);
            return;
        case RECEPTION_AGAIN:
            BuildReceptionAgain(arena, place, fold);
            return;
        case LANDING:
            BuildLanding(arena, place);
            return;
        default:
            BuildBench(arena, place, fold);
            return;
    }
}

// The squares of the renderer's sheet a box is painted with. Wallpaper is how a wall that takes a fold looks.
const float DOORS = 0;
const float BRICK = 1;
const float PANELS = 2;
const float CONCRETE = 3;
const float MARBLE = 4;
const float PLANKS = 5;
const float HAZARD = 6;
const float RUST = 9;
const float SHUTTER = 10;
const float WALLPAPER = 12;
const float CARPET = 13;
const float CEILING_TILE = 14;
const float PLASTER = 15;

// A box of the room, with its one piece. Wallpaper that doesn't take a fold is bare concrete.
Entity Raise(Arena arena, float3 center, float3 size, float paint, bool takes = false, int kind = 0, float tiles = 0.5)
{
    var wall = Spawn(Wall { center = center, size = size, paint = paint == WALLPAPER && !takes ? CONCRETE : paint, tiles = tiles, takes = takes, kind = kind,
                            chamber = arena.chamber });
    Spawn(Piece { wall = wall }, Body { type = BodyType.Static, position = center }, Box { size = size });
    return wall;
}

// A box of a room by its corners. A wall a fold goes on is at least 0.6 m thick and papered (`takes`); a ceiling
// is kind 2, and so is a floor with a room under it, which is a roof to the light.
Entity Fill(Arena arena, float x0, float x1, float y0, float y1, float z0, float z1, float paint, bool takes = false, int kind = 0)
{
    return Raise(arena, float3((x0 + x1) * 0.5, (y0 + y1) * 0.5, (z0 + z1) * 0.5), float3(x1 - x0, y1 - y0, z1 - z0), paint, takes, kind,
                 kind == 2 ? 0.833 : 0.5);
}

// A lift's box about the middle of its floor, turned a quarter at a time so its doorway faces `yaw`: floor, sides,
// far wall, the beam over its doorway, its roof, and jambs at both ends. Its doorway is 6 m wide and 4 high, in
// the plane `Doorway` gives: the place's wall there leaves that gap.
void LiftShell(Arena arena, float3 at, float yaw)
{
    // The floor ends at the room's floor boundary, rather than continuing
    // underneath it. Posts, side panels and the back also meet at their edges.
    Raise(arena, LiftPoint(at, yaw, float3(0, -0.5, -.06)), TurnSize(float3(8, 1, 4.32), yaw), CONCRETE, false, 5);
    Raise(arena, LiftPoint(at, yaw, float3(-3.5, 2.2, 0)), TurnSize(float3(1, 4.4, 3.12), yaw), PANELS, false, 5);
    Raise(arena, LiftPoint(at, yaw, float3(3.5, 2.2, 0)), TurnSize(float3(1, 4.4, 3.12), yaw), PANELS, false, 5);
    Raise(arena, LiftPoint(at, yaw, float3(0, 2.2, -2.72)), TurnSize(float3(8, 4.4, 1), yaw), PANELS, false, 5);
    Raise(arena, LiftPoint(at, yaw, float3(0, 4.2, 2.1)), TurnSize(float3(6, 0.4, 1), yaw), PANELS, false, 5);
    // A real cabin lining sits below the room ceiling, not in its same plane.
    Raise(arena, LiftPoint(at, yaw, float3(0, 4.8, -.31)), TurnSize(float3(8, 1, 3.82), yaw), CEILING_TILE, false, 5, 0.833);
    // The room's opening is eight metres wide; the shutter clears six.
    for (var side = -1; side <= 1; side += 2)
    {
        Raise(arena, LiftPoint(at, yaw, float3(side * 3.5, 2.2, 2.1)), TurnSize(float3(1, 4.4, 1.08), yaw), PANELS, false, 5);
        Raise(arena, LiftPoint(at, yaw, float3(side * 3.5, 2.2, -1.89)), TurnSize(float3(1, 4.4, .66), yaw), PANELS, false, 5);
    }
}

// The middle of a lift's doorway at its floor, in the plane of the place's wall.
float3 Doorway(float3 at, float yaw)
{
    return LiftPoint(at, yaw, float3(0, 0, 2.1));
}

// The lift a place is come to by, with its door, which opens a moment after it comes.
void ArrivalLift(Arena arena, mut Place place, float3 at, float yaw)
{
    LiftShell(arena, at, yaw);
    Spawn(Door { chamber = arena.chamber }, Body { type = BodyType.Kinematic, position = LiftPoint(at, yaw, float3(0, 2, 2.1)) },
          Box { size = TurnSize(float3(6, 4, 0.24), yaw) });
    place.arrival = at;
    place.arrivalYaw = yaw;
}

// The lift a place is left by, with its gate, which is up while the signals it needs are on: all of them, or
// any with `any`. Needing none, it's up once the place is come to. Its signals' lamps are on its lintel `socket`
// along from the sign, in the lift's own frame, on the side its cable comes up: never over the sign.
void ExitLift(Arena arena, mut Place place, float3 at, float yaw, int need = 0, bool any = false, float socket = -1)
{
    LiftShell(arena, at, yaw);
    SetProp(arena, PropKind.ExitSign, LiftPoint(at, yaw, float3(0, 4.2, 2.65)), yaw);
    Spawn(Gate { chamber = arena.chamber }, Body { type = BodyType.Kinematic, position = LiftPoint(at, yaw, float3(0, 2, 2.1)) },
          Box { size = TurnSize(float3(6, 4, 0.24), yaw) });
    place.exit = at;
    place.exitYaw = yaw;
    place.exitNeed = need;
    place.exitAny = any;
    place.exitSocket = socket;
}

// A lift that stops on the way: its door opens on what the place has before it, and `stay` seconds after it
// came, with both back in it, shuts, and it goes on down. It's the only lift such a place has.
void StoppingLift(Arena arena, mut Place place, float3 at, float yaw, float stay)
{
    ArrivalLift(arena, place, at, yaw);
    place.kind = PlaceKind.Vignette;
    place.exit = at;
    place.exitYaw = yaw + Math.PI;
    place.stay = stay;
}

// A plate in the floor, its top's middle at `at`, whose signal is on while it bears what it needs: a standard
// one an operator or a cube or a crate, a heavy one something grown. It can linger, its signal staying on for
// that many seconds after it's let up, or be inverted, on while nothing's on it.
Entity LayPlate(Arena arena, float3 at, int signal, bool heavy = false, float linger = 0, bool invert = false, float need = 0)
{
    return Spawn(Plate { chamber = arena.chamber, at = at, signal = signal, heavy = heavy, linger = linger, invert = invert,
                         need = need > 0 ? need : heavy ? HEAVY_NEED : STANDARD_NEED, half = heavy ? float2(0.8, 0.8) : float2(0.6, 0.6) });
}

// The line a signal is seen to run along, by up to twelve points: along the floor and up the walls from a plate's
// rim to the lamps of what it works.
Entity RunWire(Arena arena, int signal, List<float3> points)
{
    mut float3[12] along = default;
    var count = Math.Min(points.count, 12);
    for (var index = 0; index < count; index++) along[index] = points[index];
    return Spawn(Wire { chamber = arena.chamber, signal = signal, count = count, points = along });
}

// A thing the place moves, from `from` to `to`: there while the signals it needs are on and back while they're
// not, or with none needed, back and forth by itself, waiting a moment at each end. Its lamps, one for each
// signal it needs, are a row about `lamp` along `along`.
Entity Machine(Arena arena, float3 from, float3 to, float3 size, int need, bool any, float speed, float3 lamp, float3 along, float lampDepth = 0)
{
    return Spawn(Mover { chamber = arena.chamber, at = from, from = from, to = to, size = size, need = need, any = any, speed = speed, lamp = lamp, lampAlong = along, lampDepth = lampDepth },
                 Body { type = BodyType.Kinematic, position = from }, Box { size = size, friction = 0.9 });
}

// A door, shut in its doorway with its middle at `at`, that goes up its own height while it's open, quickly.
// Its lamps are over its middle, along its width.
Entity HangDoor(Arena arena, float3 at, float3 size, int need, bool any = false, float speed = DOOR_SPEED)
{
    return Machine(arena, at, at + float3(0, size.y + 0.2, 0), size, need, any, speed, at + float3(0, size.y * 0.5 + 0.3, 0),
                   size.x >= size.z ? float3(1, 0, 0) : float3(0, 0, 1));
}

// A platform that's ridden: it's at `from`, and goes to `to` while its signals are on, or by itself without any.
// Its lamps are under its middle.
Entity HangDeck(Arena arena, float3 from, float3 to, float3 size, int need = 0, bool any = false, float speed = MOVER_SPEED)
{
    return Machine(arena, from, to, size, need, any, speed, from - float3(0, size.y * 0.5 + 0.08, 0), float3(1, 0, 0));
}

// A frame on a wall facing `face`, standing at `foot`: the middle of its bottom edge on the wall's face. An end
// shot into it, or by it, is `size` times the usual.
Entity PaintFrame(Arena arena, float3 foot, float3 face, float size)
{
    return Spawn(FoldFrame { chamber = arena.chamber, at = foot + float3(0, FOLD_HALF_HIGH * size, 0), face = face, size = size });
}

// An end of a fold open as the place is built, as if its operator had just shot it there, standing at `foot` on
// the face of `wall` that faces `face`: ends 0 and 1 are operator A's, 2 and 3 operator B's. It's theirs: their
// next shot of it moves it. The place gives where it goes exactly; nothing nudges it to fit. Its wall's hole is
// cut the next tick.
void PlaceEnd(mut Fold fold, int end, Entity wall, float3 foot, float3 face, float size = 1)
{
    fold.ends[end] = Portal { open = true, at = foot + float3(0, FOLD_HALF_HIGH * size, 0), face = face, wall = wall, size = size };
}

// A loose thing of the place: the first is the cube, and a crate is lighter. Eight at most.
Entity PutLoose(mut Arena arena, mut Fold fold, float3 at, int kind = 0, float scale = 1)
{
    if (fold.count >= 8) return default;
    var index = fold.count;
    var made = Spawn(Cube { chamber = arena.chamber, last = at, at = at, home = at, homeScale = scale, index = index, kind = kind, scale = scale },
                     Body { position = at, angularDamping = GrownDamping(scale) },
                     Box { size = float3(CUBE_SIDE * scale), density = kind == 0 ? 120.0 : 60.0, friction = 0.7 });
    fold.spots[index] = at;
    fold.sizes[index] = scale;
    fold.count += 1;
    if (index == 0)
    {
        arena.cube = made;
        fold.cube = at;
        fold.cubeScale = scale;
    }
    return made;
}

// A pad in the floor that throws whoever and whatever steps on it with `launch`.
Entity SetPad(Arena arena, float3 at, float3 launch)
{
    return Spawn(Pad { chamber = arena.chamber, at = at, launch = launch });
}

// Blood with no bottom, and the hands in it, from x0 to x1 and z0 to z1 of a floor at `top`. The floor there is
// the place's to leave out.
Entity DigBloodPit(Arena arena, float x0, float x1, float z0, float z1, float top = 0)
{
    return Spawn(Pit { chamber = arena.chamber, kind = PitKind.Blood, low = float2(x0, z0), high = float2(x1, z1), top = top });
}

// A pool's or a trench's floor and its slopes: down from each of its z sides.
void PitFloor(Arena arena, float x0, float x1, float z0, float z1, float top, float deep, float run)
{
    var middle = (z0 + z1) * 0.5;
    var half = (z1 - z0) * 0.5;
    var across = (x0 + x1) * 0.5;
    var wide = x1 - x0 + 2;
    var slope = Math.Atan2(deep, run);
    Raise(arena, float3(across, top - deep - 0.5, middle), float3(wide, 1, half * 2), CONCRETE);
    for (var side = -1; side <= 1; side += 2)
    {
        var high = float3(across, top, middle + side * half);
        var foot = float3(across, top - deep, middle + side * (half - run));
        var normal = float3(0, Math.Cos(slope), -side * Math.Sin(slope));
        Spawn(Ramp { chamber = arena.chamber },
              Body { type = BodyType.Static, position = (high + foot) * 0.5 - normal * 0.2, rotation = quaternion.Euler(-side * slope, 0, 0) },
              Box { size = float3(wide, 0.4, Math.Sqrt(deep * deep + run * run)) });
    }
}

// A pool to wade, and what lurks in it, from x0 to x1 and z0 to z1 of a floor at `top`: its floor `deep` down,
// with a slope `run` long from each z side. The floor there is the place's to leave out.
Entity DigPool(Arena arena, float x0, float x1, float z0, float z1, float top = 0, float deep = 1.5, float run = 1.9)
{
    PitFloor(arena, x0, x1, z0, z1, top, deep, run);
    return Spawn(Pit { chamber = arena.chamber, kind = PitKind.Water, low = float2(x0, z0), high = float2(x1, z1), top = top, deep = deep, run = run });
}

// A trench to run across, with up to four drums that go its length along x and back: each in its lane along z,
// at its speed. They stand still while `brake`'s signals are on.
Entity DigTrench(Arena arena, float x0, float x1, float z0, float z1, int drums, float4 lanes, float4 speeds, int brake = 0, float top = 0, float deep = 1.0,
                 float run = 1.4)
{
    PitFloor(arena, x0, x1, z0, z1, top, deep, run);
    return Spawn(Pit { chamber = arena.chamber, kind = PitKind.Trench, low = float2(x0, z0), high = float2(x1, z1), top = top, deep = deep, run = run,
                       drums = Math.Clamp(drums, 0, 4), lanes = [lanes.x, lanes.y, lanes.z, lanes.w], speeds = [speeds.x, speeds.y, speeds.z, speeds.w],
                       brake = brake });
}

// A pillar, bare and strapped, that the watcher may keep behind.
Entity RaisePillar(Arena arena, float x, float z, float high = 4.4, float floor = 0)
{
    Spawn(Pillar { chamber = arena.chamber, at = float3(x, floor, z) });
    return Raise(arena, float3(x, floor + high * 0.5, z), float3(0.9, high, 0.9), CONCRETE);
}

// A maze of walls `high` and painted `paint`, and what's in it: see `Maze`.
Entity LayMaze(Arena arena, float2 origin, float2 cell, int wide, int long, int[16] east, int[16] north, int start, float high = 4.4, float paint = CONCRETE)
{
    var maze = Maze { chamber = arena.chamber, origin = origin, cell = cell, wide = Math.Clamp(wide, 1, 16), long = Math.Clamp(long, 1, 16), east = east,
                      north = north, start = start };
    for (var row = 0; row < maze.long; row++)
    {
        for (var column = 0; column < maze.wide; column++)
        {
            var middle = CellMiddle(maze, row * maze.wide + column);
            if (!MazeOpen(maze, row * maze.wide + column, 0) && column < maze.wide - 1)
                Raise(arena, middle + float3(cell.x * 0.5, high * 0.5, 0), float3(0.3, high, cell.y + 0.3), paint);
            if (!MazeOpen(maze, row * maze.wide + column, 2) && row < maze.long - 1)
                Raise(arena, middle + float3(0, high * 0.5, cell.y * 0.5), float3(cell.x + 0.3, high, 0.3), paint);
        }
    }
    return Spawn(Maze { chamber = maze.chamber, origin = origin, cell = cell, wide = maze.wide, long = maze.long, east = east, north = north, start = start });
}

// What moves in the dark, from `start`, kept within `bounds` (from x to x, from z to z), and standing still while
// `light`'s signals are on.
Entity Prowling(Arena arena, float3 start, float4 bounds, int light = 0)
{
    return Spawn(Prowl { chamber = arena.chamber, start = start, bounds = bounds, light = light });
}

// The place's lamp grid: cells `step` big from the corner `from`, `wide` of them along x and `long` along z.
// Every cell starts with no lamp.
void LampGrid(mut Place place, float2 from, float2 step, int wide, int long)
{
    place.lampFrom = from;
    place.lampStep = step;
    place.lampsWide = Math.Clamp(wide, 0, LAMPS_WIDE);
    place.lampsLong = Math.Clamp(long, 0, LAMPS_LONG);
}

// A lamp in a cell of the grid, hanging at `high` under its ceiling.
void HangLamp(mut Place place, int column, int row, float high, LampState state = LampState.On, int group = 0, int signal = 0)
{
    if (column < 0 || row < 0 || column >= place.lampsWide || row >= place.lampsLong) return;
    place.lamps[row * LAMPS_WIDE + column] = Lamp { state = state, high = high, group = group, signal = signal };
}

// The same lamp in every cell from column0 to column1 and row0 to row1.
void HangLamps(mut Place place, int column0, int column1, int row0, int row1, float high, LampState state = LampState.On, int group = 0)
{
    for (var row = row0; row <= row1; row++)
        for (var column = column0; column <= column1; column++)
            HangLamp(place, column, row, high, state, group);
}

// An office's lamps over those cells: most burn, about two in nine are dead and one in nine stutters, which
// ones by the seed, so that no two places have the same.
// `dead` of every nine are out and one of the nine stutters.
void OfficeLamps(mut Place place, int column0, int column1, int row0, int row1, float high, int seed, int group = 0, int dead = 2)
{
    for (var row = row0; row <= row1; row++)
    {
        for (var column = column0; column <= column1; column++)
        {
            var roll = Math.Abs(Math.Hash(int3(column, row, seed))) % 9;
            HangLamp(place, column, row, high, roll < dead ? LampState.Dead : roll == dead ? LampState.Stutter : LampState.On, group);
        }
    }
}

// Where the menu's camera drifts about, behind the menu: looking `down` and turned to `yaw`.
void MenuView(mut Place place, float3 at, float down, float yaw)
{
    place.view = at;
    place.viewTurn = float2(down, yaw);
}
