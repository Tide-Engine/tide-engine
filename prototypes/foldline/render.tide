// FOLDLINE's renderer. Everything here is this machine's: rooms built of
// boxes and painted from a small sheet of texels, lamps with shadows, light
// kept as light until the last blit, the fold cameras, and a last pass that
// shows it all as an old console would. None of it reaches the match.

// The operators' model, its clips and their two skins, and the sheet every
// surface is painted from: sixteen 64-texel squares. The model, the clips,
// the skins and twelve of the squares are Kenney's (kenney.nl, CC0).
asset SkinnedMesh<StoneVertex> figure = "art/character.fbx";
asset AnimationCatalog moves = ["art/idle.fbx", "art/run.fbx", "art/jump.fbx"];
[Filter(Filter.Point)] asset Texture skinA = "art/operator-a.png";
[Filter(Filter.Point)] asset Texture skinB = "art/operator-b.png";
[Filter(Filter.Point)] asset Texture skinWatcher = "art/watcher.png";
[Filter(Filter.Point)] asset Texture kit = "art/kit.png";
struct StoneVertex
{
    float3 position;
    float3 normal;
    float2 uv;
}

// One drawn piece. `size` is its extent in meters, which rounds its edges
// and keeps its normals right however it's stretched.
struct Fixture
{
    float4x4 transform;
    Color tint;
    float3 size;
    float tiles;      // Panel seams a meter, 0 for none
    float luminous;   // Its own light: 1 glows, more glows harder
    float gloss;      // 0 chalk, 1 polished
    float crop;       // For a square painted by its faces: 0 all of it, 1 its left half, 2 its right half
    float kind;       // 0 solid, 1 leaf, 2 a ceiling lamp
    float cell = -1;  // Which square of the sheet it's painted with: its tint alone, under 0
}

struct Sight
{
    float3 eye;
    float3 clipPoint;
    float3 clipNormal;
    bool clipped;
    bool packed;
    float3 cube;
    float3 partner;
    float3 self;
    float3 amberAt;
    float3 cyanAt;
    float3 plateA;
    float3 plateB;
    float2 plates;
    float linked;
    float phase;
    bool held;        // The piece is in the viewer's hand: lit as the eye is
    float3 amberFace; // Which way each fold's wall faces
    float3 cyanFace;
    float2 grid;      // Half the picture's pixels each way: corners land on them
    float3 torchAt;   // Each operator's torch: where it is and which way it points
    float3 torchWay;
    float3 otherAt;
    float3 otherWay;
    float lamps;      // How much of the ceiling's light there is: none for the moment a watcher comes or goes
    bool cut;         // The piece is the room's: a fold opens a hole in it
    bool moving;      // The piece can cross a fold: what's past the wall's face is at the other end
}

struct Aperture
{
    Color rim;
    float2 pixels;
    float3 eye;
    float3 clipPoint;
    float3 clipNormal;
    bool clipped;
    bool packed;
    float phase;
    float lamps;
    float3 wall;      // The middle of the fold's panel, which way it faces and its right
    float3 face;
    float3 right;
    // What the fold's own camera needs to light the air it looks through:
    // where it is, its clip space undone, and which fold's depth it reads
    float4x4 fromClip;
    float3 farEye;
    bool cyan;
}

struct Ray
{
    float4x4 fromClip;
    float3 eye;
    float lamps;
}

struct BlurStep
{
    float2 along;
}

local singleton Optics
{
    RenderTarget scene;
    RenderTarget amber;
    RenderTarget cyan;
    RenderTarget amberDeep;
    RenderTarget cyanDeep;
    List<StoneVertex> box;
    List<int> triangles;
    List<StoneVertex> ball;
    List<int> ballTriangles;
    List<StoneVertex> tube;
    List<int> tubeTriangles;
    List<StoneVertex> blade;
    List<int> bladeTriangles;
    List<Vertex3> card;
    List<int> cardTriangles;
    List<Fixture> architecture;
    List<Fixture> glass;
    List<Fixture> leaves;
    List<Fixture> furnishings;
    List<Fixture> dynamic;
    List<Fixture> balls;
    List<Fixture> tubes;
    List<Fixture> self;
    List<Fixture> selfBalls;
    List<Fixture> selfTubes;
    // What's part of the way through a fold, again at the fold's other end: anyone's, then the viewer's own
    // through the amber fold and through the cyan one
    List<Fixture> echo;
    List<Fixture> echoBalls;
    List<Fixture> echoTubes;
    List<Fixture> ownAmber;
    List<Fixture> ownAmberBalls;
    List<Fixture> ownAmberTubes;
    List<Fixture> ownCyan;
    List<Fixture> ownCyanBalls;
    List<Fixture> ownCyanTubes;
    List<Fixture> device;
    List<Fixture> deviceBalls;
    List<Fixture> deviceTubes;
    List<Fixture> motes;
    float3 amberEye;
    float3 cyanEye;
    float4x4 amberView;
    float4x4 cyanView;
    float4x4 amberFarView;
    float4x4 cyanFarView;
    int dressed = -1;
    bool made;
    float phase;
    float clock;
    float stride;
    float fired;
    int lastAmber = -1;
    int lastCyan = -1;
}

// What the sun sees, and what each fold's light sees: how far, along each
// pixel of its image.
local singleton Daylight
{
    RenderTarget map;
    DepthTexture depth;
    float4x4 toSun;
    RenderTarget amberMap;
    RenderTarget cyanMap;
    DepthTexture amberDepth;
    DepthTexture cyanDepth;
    float4x4 toAmber;
    float4x4 toCyan;
    bool made;
}

// The frame's light on its way to the window.
local singleton Lens
{
    RenderTarget air;
    RenderTarget half;
    RenderTarget quarter;
    RenderTarget quarterTurn;
    RenderTarget eighth;
    RenderTarget eighthTurn;
    RenderTarget sixteenth;
    RenderTarget sixteenthTurn;
    DepthTexture sceneDepth;
    DepthTexture amberDepth;
    DepthTexture cyanDepth;
    DepthTexture amberFarDepth;
    DepthTexture cyanFarDepth;
    Texture shafts;
    Texture near;
    Texture mid;
    Texture wide;
    float2 pixel;
    float phase;
    float scare;      // A watcher has this machine's operator: 1 as it lands, fading
    bool made;
}

const int SUN_PIXELS = 2048;
const float SUN_WIDE = 28;
const float SUN_LONG = 38;
const float CEILING = 4.4;   // Where the lamps are
const float LINES = 300;     // The picture's rows, whatever the window's are
const float SUN_SOFT = 1.1 / SUN_PIXELS;
const int FOLD_PIXELS = 768;
// A fold's opening: half as wide and half as high as this, its middle this far under its panel's, its corners
// rounded by this much. `PortalAperture` in play.tide lets through what fits it.
const float FOLD_WIDE = 0.68;
const float FOLD_HIGH = 1.3;
const float FOLD_DROP = 0.2;
const float FOLD_ROUND = 0.6;
const float FOLD_DEEP = 0.3;
const float FOLD_SOFT = 1.2 / FOLD_PIXELS;
const float FIGURE_SCALE = 0.45;

// Shadows fall straight down from the ceiling's lamps.
float3 SunWay()
{
    return float3(0, 1, 0);
}

float3 LampTint()
{
    return float3(1.0, 0.95, 0.70);
}

float3 Rgb(Color c)
{
    return float3(c.r, c.g, c.b);
}

// A portal camera's image holds light folded into bytes; these fold and unfold it.
float3 Fold3(float3 light)
{
    float3 c = light / (float3(1) + light);
    return float3(Math.Sqrt(c.x), Math.Sqrt(c.y), Math.Sqrt(c.z));
}

float3 Unfold3(Color stored)
{
    float3 c = Math.Min(Rgb(stored) * Rgb(stored), float3(0.985));
    return c / (float3(1) - c);
}

Color Shown(float3 light, bool packed)
{
    float3 c = packed ? Fold3(light) : light;
    return Color(c.x, c.y, c.z, 1);
}

// Where a place is in the lamps' image, stepped off its surface so that a
// slanted wall isn't in its own shadow.
float3 FromSun(float3 world, float3 normal, float4x4 toSun)
{
    float facing = Math.Dot(normal, SunWay());
    float slant = Math.Sqrt(Math.Saturate(1 - facing * facing));
    float step = SUN_LONG / SUN_PIXELS;
    float4 clip = Math.Mul(toSun, float4(world + normal * (step * (0.9 + 2.2 * slant)), 1));
    if (Math.Max(Math.Abs(clip.x), Math.Abs(clip.y)) > 1) return float3(0.5, 0.5, 0);
    return float3(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5, clip.z * 0.5 + 0.5);
}

float Sunlight(DepthTexture depth, float3 world, float3 normal, float4x4 toSun)
{
    float3 seen = FromSun(world, normal, toSun);
    return (depth.Compare(seen.xy + float2(-SUN_SOFT, -SUN_SOFT), seen.z) + depth.Compare(seen.xy + float2(SUN_SOFT, -SUN_SOFT), seen.z)
          + depth.Compare(seen.xy + float2(-SUN_SOFT, SUN_SOFT), seen.z) + depth.Compare(seen.xy + float2(SUN_SOFT, SUN_SOFT), seen.z)) * 0.25;
}

float SunThrough(DepthTexture depth, float3 world, float4x4 toSun)
{
    float4 clip = Math.Mul(toSun, float4(world, 1));
    return depth.Compare(float2(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5), clip.z * 0.5 + 0.5);
}

// The ceiling has a lamp every 5 meters across the room and every 3.25 along
// it. Which is which: its column and its row.
int2 LampCell(float2 over)
{
    return int2(int(Math.Floor(over.x / 5 + 2)), int(Math.Floor((over.y + 13) / 3.25)));
}

float2 LampMiddle(int2 cell)
{
    return float2((cell.x - 1.5) * 5, -13 + (cell.y + 0.5) * 3.25);
}

// How brightly a lamp burns: some are dead, one in nine stutters, the rest hum.
float LampOn(int2 cell, float phase)
{
    if (cell.x < 0 || cell.x > 3 || cell.y < 0 || cell.y > 7) return 0;
    int roll = Math.Hash(cell) % 9;
    if (roll < 2) return 0;
    if (roll == 2) return Math.Step(0.2, Math.Sin(phase * 31 + cell.x) * Math.Sin(phase * 7 + cell.y) + 0.5) * 0.9;
    return 1;
}

// The light of the lamps about a place on a surface that faces `normal`: each
// is a small bright sheet that shines mostly down, so the floor has a pool
// under each, and a wall its arc, dark towards the ceiling.
float Lamps(float3 at, float3 normal, float phase)
{
    int2 home = LampCell(at.xz);
    mut float sum = 0;
    for (int row = -1; row <= 1; row++)
    {
        for (int column = -1; column <= 1; column++)
        {
            int2 cell = int2(home.x + column, home.y + row);
            float on = LampOn(cell, phase);
            if (on <= 0) continue;
            float2 middle = LampMiddle(cell);
            float3 to = float3(middle.x, CEILING, middle.y) - at;
            float far = Math.Dot(to, to);
            float3 along = to / Math.Sqrt(far + 0.0001);
            float down = Math.Max(along.y, 0);
            // A tight beam under it, and a quarter as much all around
            mut float tight = down * down * down * down;
            tight *= tight;
            tight *= tight;
            sum += on * Math.Saturate(Math.Dot(normal, along)) * (0.75 * tight + 0.25 * down * down * down) / (far + 0.6);
        }
    }
    return sum * 36;
}

// A lamp's pool: how much of its light leaves the ceiling at a place, the
// lamp's own shape close under it and softer the further down it's seen from.
float LampPool(float2 over, float soft, float phase)
{
    int2 cell = LampCell(over);
    float2 from = Math.Abs(over - LampMiddle(cell)) - float2(0.6, 0.3);
    float edge = Math.Max(from.x, from.y);
    return (1 - Math.SmoothStep(-soft * 0.3, soft, edge)) * LampOn(cell, phase);
}

// What a lamp gives the whole of its bay, bounced about: most under it, none where the next bay starts.
float LampWide(float2 over, float phase)
{
    int2 cell = LampCell(over);
    float2 from = (over - LampMiddle(cell)) / float2(5, 3.25);
    return (0.5 + 0.5 * Math.Cos(from.x * Math.TAU)) * (0.5 + 0.5 * Math.Cos(from.y * Math.TAU)) * LampOn(cell, phase);
}

// The lamps' light at a place in the air, with what stands over it in the way.
float LampAir(DepthTexture depth, float4x4 toSun, float3 at, float phase)
{
    float up = Math.Max(CEILING - at.y, 0);
    float3 way = SunWay();
    return LampPool(at.xz + way.xz * (up / way.y), 0.05 + up * 0.26, phase) * SunThrough(depth, at, toSun) / (1 + up * 0.35);
}

// A torch's light on a surface: a cone that fades with its reach.
float3 Torch(float3 at, float3 normal, float3 from, float3 way)
{
    float3 to = at - from;
    float far = Math.Dot(to, to);
    float3 along = to / Math.Sqrt(far + 0.0001);
    float cone = Math.SmoothStep(0.84, 0.97, Math.Dot(along, way));
    return float3(1.0, 0.93, 0.78) * (cone * Math.Saturate(-Math.Dot(normal, along) * 0.8 + 0.2) * 3.2 / (1 + far * 0.1));
}

// How much of a fold's light gets to a place: its lamp looks out of the wall
// through a wide camera, and what's beside or behind that view is lit.
float FoldLight(DepthTexture depth, float4x4 toFold, float3 world, float3 normal)
{
    float4 clip = Math.Mul(toFold, float4(world + normal * 0.07, 1));
    if (clip.w < 0.05) return 1;
    float3 at = clip.xyz / clip.w;
    if (Math.Max(Math.Abs(at.x), Math.Abs(at.y)) > 0.98) return 1;
    float2 uv = float2(at.x * 0.5 + 0.5, 0.5 - at.y * 0.5);
    float far = at.z * 0.5 + 0.5 - 0.0015;
    return (depth.Compare(uv + float2(-FOLD_SOFT, -FOLD_SOFT), far) + depth.Compare(uv + float2(FOLD_SOFT, -FOLD_SOFT), far)
          + depth.Compare(uv + float2(-FOLD_SOFT, FOLD_SOFT), far) + depth.Compare(uv + float2(FOLD_SOFT, FOLD_SOFT), far)) * 0.25;
}

// The lamps' light the air throws towards the eye along a stretch of a ray.
float3 Scatter(DepthTexture depth, float4x4 toSun, float3 from, float3 way, float reach, float2 pixel, float phase)
{
    float jitter = Math.Frac(52.9829189 * Math.Frac(Math.Dot(pixel, float2(0.06711056, 0.00583715))));
    mut float lit = 0;
    for (int i = 0; i < 20; i++)
        lit += LampAir(depth, toSun, from + way * (reach * (i + jitter) / 20), phase);
    return LampTint() * (lit / 20 * reach * 0.02);
}

// Where a pixel of a camera's image is in the world, from its depth there.
float3 Unprojected(float4x4 fromClip, float2 uv, float depth)
{
    float4 at = Math.Mul(fromClip, float4(uv.x * 2 - 1, 1 - uv.y * 2, depth * 2 - 1, 1));
    return at.xyz / at.w;
}

float3 Glow(float3 at, float3 normal, float3 from, float3 tint, float reach)
{
    float3 to = from - at;
    float far = Math.Dot(to, to);
    float fall = Math.Saturate(1 - far / (reach * reach));
    float facing = Math.Saturate(Math.Dot(normal, to) / Math.Sqrt(far + 0.0001) * 0.7 + 0.3);
    return tint * (fall * fall * facing / (1 + far * 0.45));
}

// How much of a lamp's light gets past a ball on its way to a place: none
// through its middle, all of it past its edge. A ball the lamp is under or
// inside stops nothing: a plate's light comes from around what weighs it.
float Past(float3 from, float3 to, float3 middle, float radius)
{
    if (Math.DistanceSq(middle.xz, from.xz) < 0.6 && Math.Abs(middle.y - from.y) < 1.3) return 1;
    float3 along = to - from;
    float nearest = Math.Saturate(Math.Dot(middle - from, along) / Math.Max(Math.Dot(along, along), 0.0001));
    return Math.SmoothStep(radius * 0.7, radius * 1.3, Math.Distance(from + along * nearest, middle));
}

// ...past an operator, who is three of them: legs, shell and head.
float PastOperator(float3 from, float3 to, float3 feet)
{
    return Past(from, to, feet + float3(0, 0.33, 0), 0.2) * Past(from, to, feet + float3(0, 0.86, 0), 0.3) * Past(from, to, feet + float3(0, 1.42, 0), 0.22);
}

// ...and past everything that moves: both operators, and the cube for a lamp that isn't the cube's own.
float Unblocked(float3 from, float3 to, Sight sight, bool cube)
{
    float past = PastOperator(from, to, sight.partner) * PastOperator(from, to, sight.self);
    return cube ? past * Past(from, to, sight.cube, 0.46) : past;
}

// A square of the sheet, at a place on it that repeats: its texel, as light.
float3 Texel(Texture sheet, float cell, float2 uv)
{
    float2 within = Math.Clamp(Math.Frac(uv), float2(0.01), float2(0.99));
    float row = Math.Floor(cell / 4);
    Color seen = sheet.Sample((float2(cell - row * 4, row) + within) * 0.25, Filter.Point, Wrap.Clamp);
    return Rgb(seen) * Rgb(seen);
}

// A surface's paint in every light there is: the dark, the ceiling's lamps
// with their shadows, what they throw about their bay and up the walls, the
// folds', the plates', the cube's and the exit's, and both operators' torches.
float3 Lit(float3 paint, float3 p, float3 n, float shade, float gloss, bool leaf, Sight sight, DepthTexture sun, float4x4 toSun,
           DepthTexture amber, float4x4 toAmber, DepthTexture cyan, float4x4 toCyan)
{
    float3 sunWay = SunWay();
    // What's in the viewer's hand is lit where the viewer stands, so a wall it reaches into doesn't darken it.
    float3 at = sight.held ? sight.eye : p;
    float up = Math.Max(CEILING - at.y, 0);
    float2 over = at.xz + sunWay.xz * (up / sunWay.y);
    mut float facing = Math.Dot(n, sunWay);
    mut float shadow = 0;
    if (leaf)
    {
        shadow = SunThrough(sun, p + sunWay * 0.06, toSun);
        facing = Math.Abs(facing) * 0.6 + 0.4;
    }
    else if (sight.held) shadow = SunThrough(sun, at, toSun);
    else if (facing > 0.02) shadow = Sunlight(sun, p, n, toSun);
    facing = Math.Max(facing, 0);

    float3 lamp = LampTint() * sight.lamps;
    mut float3 light = float3(0.030, 0.032, 0.028) * shade;
    // What's under something is in its shadow; a wall is lit whatever stands before it
    float under = Math.Lerp(1, shadow, Math.Saturate(n.y * 2));
    light += lamp * (Lamps(at, leaf ? float3(0, 1, 0) : n, sight.phase) * (leaf ? 0.7 * shadow : under));
    light += lamp * (LampWide(at.xz, sight.phase) * 0.13 * shade);

    // Each fold's light is stopped by what stands in its way.
    if (sight.linked > 0 && Math.DistanceSq(p, sight.amberAt) < 42)
        light += Glow(p, n, sight.amberAt, float3(1.0, 0.50, 0.13) * 2.0, 6.5) * (sight.held ? 1.0 : FoldLight(amber, toAmber, p, n));
    if (sight.linked > 0 && Math.DistanceSq(p, sight.cyanAt) < 42)
        light += Glow(p, n, sight.cyanAt, float3(0.10, 0.82, 0.90) * 2.0, 6.5) * (sight.held ? 1.0 : FoldLight(cyan, toCyan, p, n));
    // The smaller lamps are stopped by what moves: the cube and both operators. A little off the surface,
    // so that a thing isn't in its own way.
    float3 lifted = p + n * 0.2;
    float3 cubeLamp = sight.cube + float3(0, 0.25, 0);
    if (sight.plates.x > 0 && Math.DistanceSq(p, sight.plateA) < 16)
        light += Glow(p, n, sight.plateA, float3(1.0, 0.50, 0.13) * 2.4, 4) * (sight.held ? 1.0 : Unblocked(sight.plateA, lifted, sight, true));
    if (sight.plates.y > 0 && Math.DistanceSq(p, sight.plateB) < 16)
        light += Glow(p, n, sight.plateB, float3(0.10, 0.82, 0.90) * 2.4, 4) * (sight.held ? 1.0 : Unblocked(sight.plateB, lifted, sight, true));
    if (Math.DistanceSq(p, cubeLamp) < 5.8)
        light += Glow(p, n, cubeLamp, float3(0.2, 0.78, 0.72) * 0.7, 2.4) * (sight.held ? 1.0 : Unblocked(cubeLamp, lifted, sight, false));
    if (p.z > 3.2)
        light += Glow(p, n, float3(0, 3.2, 16.6), float3(0.25, 1.0, 0.45) * 2.6, 10) * (sight.held ? 1.0 : Unblocked(float3(0, 3.2, 16.6), lifted, sight, true));
    if (!sight.held)
        light += Torch(p, n, sight.torchAt, sight.torchWay) + Torch(p, n, sight.otherAt, sight.otherWay);

    float3 view = Math.Normalize(sight.eye - p);
    float shine = Math.Pow(Math.Max(Math.Dot(n, Math.Normalize(sunWay + view)), 0), 28) * gloss * LampPool(over, 0.06 + up * 0.2, sight.phase) * shadow;
    return paint * light + lamp * shine;
}

// Every solid thing: walls, floor and ceiling, machinery, leaves and the ceiling's lamps.
frag Surface(StoneVertex vertex, Texture sheet, Instance instance, Fixture fixture, Sight sight, Daylight day, out Color color)
{
    if (sight.clipped && Math.Dot(this.world - sight.clipPoint, sight.clipNormal) < 0.025)
        this.Discard();

    float3 p = this.world;
    if (sight.linked > 0 && (sight.cut || sight.moving))
    {
        float3 amberWall = sight.amberAt - sight.amberFace * 0.55;
        float3 cyanWall = sight.cyanAt - sight.cyanFace * 0.55;
        if (sight.cut && (InFold(p, amberWall, sight.amberFace) || InFold(p, cyanWall, sight.cyanFace))) this.Discard();
        if (sight.moving && (PastFold(p, amberWall, sight.amberFace) || PastFold(p, cyanWall, sight.cyanFace))) this.Discard();
    }
    float far = Math.Distance(sight.eye, p);

    if (fixture.kind > 1.5)
    {
        // A lamp: its tube's light where it burns, a grey sheet where it's dead.
        float on = LampOn(LampCell(p.xz), sight.phase) * sight.lamps;
        float3 tube = Math.Lerp(float3(0.05, 0.05, 0.045), LampTint() * 3.4, on);
        color = Shown(tube, sight.packed);
        return;
    }

    float3 flat = instance.Normal(vertex.normal);
    mut float3 n = flat;
    if (fixture.kind > 0.5 && Math.Dot(n, sight.eye - p) < 0) n = -n;

    mut float3 paint = Rgb(fixture.tint) * Rgb(fixture.tint);
    if (fixture.cell > -0.5)
    {
        mut float2 uv = vertex.uv;
        if (fixture.tiles > 0)
        {
            // Painted by where it is in the room, so squares meet across pieces: upright on a wall
            uv = float2(p.x, p.z) * fixture.tiles;
            if (Math.Abs(flat.x) > 0.5) uv = float2(p.z, -p.y) * fixture.tiles;
            else if (Math.Abs(flat.z) > 0.5) uv = float2(p.x, -p.y) * fixture.tiles;
        }
        else if (fixture.crop > 0.5) uv = float2((Math.Frac(uv.x) + (fixture.crop > 1.5 ? 1 : 0)) * 0.5 * 0.98 + 0.005, uv.y);
        paint *= Texel(sheet, fixture.cell, uv) * 1.6;
    }
    if (fixture.kind > 0.5) paint *= 0.55 + vertex.uv.y * 0.75;

    // The room's creases hold less light.
    mut float shade = 1;
    float upright = 1 - Math.Abs(n.y);
    shade *= 1 - 0.4 * Math.Exp(-Math.Max(p.y, 0) * 4.5) * upright * Math.Step(-0.3, p.y);
    shade *= 1 - 0.3 * Math.Exp(-Math.Max(CEILING - p.y, 0) * 3) * upright;
    if (n.y > 0.7 && p.y < 0.3)
    {
        mut float wall = Math.Min(9.8 - Math.Abs(p.x), 13 - Math.Abs(p.z));
        if (Math.Abs(p.x) > 2.1) wall = Math.Min(wall, Math.Abs(Math.Abs(p.z - 3) - 0.2));
        shade *= 1 - 0.36 * Math.Exp(-Math.Max(wall, 0) * 3.2);
        float underCube = Math.Exp(-Math.DistanceSq(p.xz, sight.cube.xz) * 3.4) * Math.Saturate(1.6 - (sight.cube.y - p.y)) * 0.42;
        float underPartner = Math.Exp(-Math.DistanceSq(p.xz, sight.partner.xz) * 5.5) * Math.Saturate(1.5 - (sight.partner.y - p.y)) * 0.4;
        float underSelf = Math.Exp(-Math.DistanceSq(p.xz, sight.self.xz) * 5.5) * Math.Saturate(1.5 - (sight.self.y - p.y)) * 0.4;
        shade *= 1 - underCube - underPartner - underSelf;
    }
    if (Math.Abs(n.x) > 0.7) shade *= 1 - 0.24 * Math.Exp(-Math.Max(13 - Math.Abs(p.z), 0) * 2.4);
    if (Math.Abs(n.z) > 0.7) shade *= 1 - 0.24 * Math.Exp(-Math.Max(9.8 - Math.Abs(p.x), 0) * 2.4);

    mut float3 lit = Lit(paint, p, n, shade, fixture.gloss, fixture.kind > 0.5, sight, day.depth, day.toSun, day.amberDepth, day.toAmber,
                         day.cyanDepth, day.toCyan);
    lit = Math.Lerp(lit, paint * (0.5 + fixture.luminous * 2.3), Math.Saturate(fixture.luminous));
    lit = Math.Lerp(lit, float3(0.030, 0.034, 0.024), 1 - Math.Exp(-far * 0.028));
    color = Shown(lit, sight.packed);
}

// An operator: the model's skin in the room's light.
frag Figure(StoneVertex vertex, Texture skin, Instance instance, Sight sight, Daylight day, out Color color)
{
    if (sight.clipped && Math.Dot(this.world - sight.clipPoint, sight.clipNormal) < 0.025)
        this.Discard();
    float3 p = this.world;
    if (sight.linked > 0 && sight.moving
        && (PastFold(p, sight.amberAt - sight.amberFace * 0.55, sight.amberFace) || PastFold(p, sight.cyanAt - sight.cyanFace * 0.55, sight.cyanFace)))
        this.Discard();
    Color seen = skin.Sample(vertex.uv, Filter.Point, Wrap.Clamp);
    float3 n = instance.Normal(vertex.normal);
    mut float3 lit = Lit(Rgb(seen) * Rgb(seen), p, n, 1, 0.1, false, sight, day.depth, day.toSun, day.amberDepth, day.toAmber, day.cyanDepth, day.toCyan);
    lit = Math.Lerp(lit, float3(0.030, 0.034, 0.024), 1 - Math.Exp(-Math.Distance(sight.eye, p) * 0.028));
    color = Shown(lit, sight.packed);
}

// Dust that only shows where a lamp finds it.
frag Mote(StoneVertex vertex, Fixture fixture, Sight sight, Daylight day, out Color color)
{
    if (sight.clipped && Math.Dot(this.world - sight.clipPoint, sight.clipNormal) < 0.025)
        this.Discard();
    float lit = LampAir(day.depth, day.toSun, this.world, sight.phase) * sight.lamps;
    float near = Math.Saturate(Math.Distance(this.world, sight.eye) * 0.6 - 0.3);
    mut float3 c = Rgb(fixture.tint) * (lit * near * 1.2);
    if (sight.packed) c *= 0.25;
    color = Color(c.x, c.y, c.z, 1);
}

// A corner as the old console put it: on the nearest of the picture's pixels.
float4 Snapped(float4 clip, float2 grid)
{
    if (clip.w < 0.02) return clip;
    float2 at = Math.Round(clip.xy / clip.w * grid) / grid;
    return float4(at.x * clip.w, at.y * clip.w, clip.z, clip.w);
}

vert Snap(mut StoneVertex vertex, Sight sight, out float4 clip)
{
    clip = Snapped(this.clip, sight.grid);
}

// Leaves stir: each blade leans a little, more towards its tip, in its own time.
vert Sway(mut StoneVertex vertex, Fixture fixture, Sight sight, out float4 clip)
{
    float tip = vertex.uv.y * vertex.uv.y;
    float own = fixture.tint.r * 91 + fixture.tint.g * 57;
    vertex.position = vertex.position + float3(Math.Sin(sight.phase * 2 + own * 1.7) * 0.22, 0, Math.Sin(sight.phase + own) * 0.045) * tip;
    clip = sight.grid.x > 0 ? Snapped(this.clip, sight.grid) : this.clip;
}

// How far a place on a fold's wall is from the opening's edge, under 0 inside it. `at` is right and up of the
// panel's middle, in meters.
float Opening(float2 at)
{
    float2 q = Math.Abs(at + float2(0, FOLD_DROP)) - float2(FOLD_WIDE - FOLD_ROUND, FOLD_HIGH - FOLD_ROUND);
    return Math.Length(Math.Max(q, 0)) + Math.Min(Math.Max(q.x, q.y), 0) - FOLD_ROUND;
}

// Where the eye's ray to a place crosses a fold's wall, right and up of the panel's middle.
float2 OnWall(float3 eye, float3 world, float3 wall, float3 face, float3 right)
{
    float3 way = world - eye;
    float3 on = eye + way * (Math.Dot(wall - eye, face) / Math.Min(Math.Dot(way, face), -0.00001)) - wall;
    return float2(Math.Dot(on, right), on.y);
}

// Whether a place of the room is in a fold's opening: the wall's face is cut away there.
bool InFold(float3 world, float3 wall, float3 face)
{
    float3 from = world - wall;
    float depth = Math.Dot(from, face);
    if (depth > 0.12 || depth < -0.05) return false;
    return Opening(float2(Math.Dot(from, Math.Cross(float3(0, 1, 0), face)), from.y)) < -0.002;
}

// Whether a place is past a fold's wall: what moves is at the fold's other end from there on.
bool PastFold(float3 world, float3 wall, float3 face)
{
    float3 from = world - wall;
    float depth = Math.Dot(from, face);
    if (depth >= 0 || depth < -1.7) return false;
    return Math.Abs(Math.Dot(from, Math.Cross(float3(0, 1, 0), face))) < 1.4 && Math.Abs(from.y) < 1.9;
}

float RimFlow(float2 at, float phase)
{
    float around = Math.Atan2(at.y + FOLD_DROP, at.x);
    return Math.Simplex(float2(Math.Cos(around + phase) * 1.9, Math.Sin(around + phase) * 1.9) + at * 1.3)
         + Math.Simplex(float2(Math.Cos(around * 3 - phase * 2), Math.Sin(around * 3 - phase * 2)) * 1.3) * 0.5;
}

// A fold's edge over what's seen through it: a glow inside, a band that flows, a bright core.
float3 Rimmed(float3 seen, Color tint, float2 at, float phase, float distance)
{
    float3 rim = Rgb(tint) * Rgb(tint);
    float flow = RimFlow(at, phase);
    // The opening stands on the floor: its edge has no light along its foot
    float foot = Math.SmoothStep(-FOLD_HIGH + 0.03, -FOLD_HIGH + 0.35, at.y + FOLD_DROP);
    float band = Math.SmoothStep(-0.075 - flow * 0.022, -0.028, distance) * foot;
    float core = Math.SmoothStep(-0.03, -0.004, distance) * foot;
    mut float3 view = seen + rim * Math.Exp(distance * 11) * 0.55 * foot;
    view = Math.Lerp(view, rim * (1.9 + flow * 0.8), band);
    return Math.Lerp(view, rim * 3.4 + float3(0.25), core * 0.6);
}

// The sunlit air beyond a fold: from where this pixel's ray leaves the far
// opening to what the fold's camera sees there, `depth` away.
float3 Beyond(DepthTexture sun, float4x4 toSun, Aperture aperture, float depth, float3 world, float2 uv, float2 pixel)
{
    float3 to = Unprojected(aperture.fromClip, uv, depth) - aperture.farEye;
    float far = Math.Length(to);
    // To the wall's face, not to the sheet this is drawn on, which is set back behind it
    float3 way0 = world - aperture.eye;
    float near = Math.Length(way0) * (Math.Dot(aperture.wall - aperture.eye, aperture.face) / Math.Min(Math.Dot(way0, aperture.face), -0.00001));
    float3 way = to / Math.Max(far, 0.0001);
    return Scatter(sun, toSun, aperture.farEye + way * near, way, Math.Clamp(far - near, 0, 36), pixel, aperture.phase) * aperture.lamps;
}

// A fold as the viewer sees it, with the sunlit air beyond it.
frag ThroughAir(Vertex3 vertex, Texture image, Aperture aperture, Daylight day, Lens lens, out Color color)
{
    float2 at = OnWall(aperture.eye, this.world, aperture.wall, aperture.face, aperture.right);
    float distance = Opening(at);
    if (distance > 0) this.Discard();
    float2 uv = this.position / aperture.pixels;
    mut float3 view = Unfold3(image.Sample(uv, Filter.Bilinear, Wrap.Clamp));
    float depth = aperture.cyan ? lens.cyanDepth.Sample(uv) : lens.amberDepth.Sample(uv);
    view += Beyond(day.depth, day.toSun, aperture, depth, this.world, uv, this.position);
    color = Shown(Rimmed(view, aperture.rim, at, aperture.phase, distance), aperture.packed);
}

// A fold seen by a fold's own camera, with the air beyond that one too. It
// reads the second crossings' depths, as ThroughAir reads the first's: a
// camera's image can't be read while it's drawn into.
frag ThroughFar(Vertex3 vertex, Texture image, Aperture aperture, Daylight day, Lens lens, out Color color)
{
    if (aperture.clipped && Math.Dot(this.world - aperture.clipPoint, aperture.clipNormal) < 0.025)
        this.Discard();
    float2 at = OnWall(aperture.eye, this.world, aperture.wall, aperture.face, aperture.right);
    float distance = Opening(at);
    if (distance > 0) this.Discard();
    float2 uv = this.position / aperture.pixels;
    mut float3 view = Unfold3(image.Sample(uv, Filter.Bilinear, Wrap.Clamp));
    float depth = aperture.cyan ? lens.cyanFarDepth.Sample(uv) : lens.amberFarDepth.Sample(uv);
    view += Beyond(day.depth, day.toSun, aperture, depth, this.world, uv, this.position);
    color = Shown(Rimmed(view, aperture.rim, at, aperture.phase, distance), aperture.packed);
}

// The last fold a camera follows: light on a dark sheet.
frag LastFold(Vertex3 vertex, Aperture aperture, out Color color)
{
    if (aperture.clipped && Math.Dot(this.world - aperture.clipPoint, aperture.clipNormal) < 0.025)
        this.Discard();
    float2 at = OnWall(aperture.eye, this.world, aperture.wall, aperture.face, aperture.right);
    float distance = Opening(at);
    if (distance > 0) this.Discard();
    float3 rim = Rgb(aperture.rim) * Rgb(aperture.rim);
    float flow = RimFlow(at, aperture.phase);
    float band = Math.SmoothStep(-0.09, -0.03, distance);
    mut float3 view = float3(0.012, 0.03, 0.04) + rim * (0.06 + 0.05 * flow) * Math.Exp(distance * 3);
    view = Math.Lerp(view, rim * 3.4, band);
    color = Shown(view, aperture.packed);
}

// A fold's light spilling onto the wall around it.
frag Halo(Vertex3 vertex, Aperture aperture, out Color color)
{
    if (aperture.clipped && Math.Dot(this.world - aperture.clipPoint, aperture.clipNormal) < 0.025)
        this.Discard();
    float2 at = float2(Math.Dot(this.world - aperture.wall, aperture.right), this.world.y - aperture.wall.y);
    float distance = Opening(at);
    if (distance < 0) this.Discard();
    float3 rim = Rgb(aperture.rim) * Rgb(aperture.rim);
    float flow = RimFlow(at, aperture.phase);
    mut float3 c = rim * (Math.Exp(-distance * 10) * (1.0 + flow * 0.4) + Math.Exp(-distance * 2.6) * 0.2);
    c *= Math.Saturate(1.1 - distance * 1.6);
    if (aperture.packed) c *= 0.3;
    color = Color(c.x, c.y, c.z, 1);
}

// The sun's light caught by the air between the eye and what it sees.
frag Shafts(Vertex vertex, Texture source, Ray ray, Daylight day, Lens lens, out Color color)
{
    float3 to = Unprojected(ray.fromClip, vertex.uv, lens.sceneDepth.Sample(vertex.uv)) - ray.eye;
    float far = Math.Length(to);
    float3 lit = Scatter(day.depth, day.toSun, ray.eye, to / Math.Max(far, 0.0001), Math.Min(far, 36), this.position, lens.phase) * ray.lamps;
    color = Color(lit.x, lit.y, lit.z, 1);
}

// What's bright enough to spill, at half the window's size.
frag Bright(Vertex vertex, Texture source, Lens lens, out Color color)
{
    float2 step = lens.pixel;
    float3 sum = Rgb(source.Sample(vertex.uv + float2(-step.x, -step.y), Filter.Bilinear, Wrap.Clamp))
               + Rgb(source.Sample(vertex.uv + float2(step.x, -step.y), Filter.Bilinear, Wrap.Clamp))
               + Rgb(source.Sample(vertex.uv + float2(-step.x, step.y), Filter.Bilinear, Wrap.Clamp))
               + Rgb(source.Sample(vertex.uv + float2(step.x, step.y), Filter.Bilinear, Wrap.Clamp));
    mut float3 seen = Math.Min(sum * 0.25, float3(9));
    float light = Math.Max(seen.x, Math.Max(seen.y, seen.z));
    float kept = Math.Saturate((light - 1.05) / 1.6);
    seen *= kept * kept;
    color = Color(seen.x, seen.y, seen.z, 1);
}

frag Halve(Vertex vertex, Texture source, out Color color)
{
    Color seen = source.Sample(vertex.uv, Filter.Bilinear, Wrap.Clamp);
    color = Color(seen.r, seen.g, seen.b, 1);
}

frag Blur(Vertex vertex, Texture source, BlurStep step, out Color color)
{
    float2 near = step.along * 1.3846;
    float2 far = step.along * 3.2308;
    float3 sum = Rgb(source.Sample(vertex.uv, Filter.Bilinear, Wrap.Clamp)) * 0.227
               + (Rgb(source.Sample(vertex.uv + near, Filter.Bilinear, Wrap.Clamp)) + Rgb(source.Sample(vertex.uv - near, Filter.Bilinear, Wrap.Clamp))) * 0.3162
               + (Rgb(source.Sample(vertex.uv + far, Filter.Bilinear, Wrap.Clamp)) + Rgb(source.Sample(vertex.uv - far, Filter.Bilinear, Wrap.Clamp))) * 0.0703;
    color = Color(sum.x, sum.y, sum.z, 1);
}

// Light becomes a picture, as an old console showed one: LINES rows of
// pixels, a film curve, a sickly grade, and 32 steps a channel with the gaps
// between them dithered.
frag Develop(Vertex vertex, Texture source, Lens lens, out Color color)
{
    float2 cells = float2(Math.Round(LINES * lens.pixel.y / lens.pixel.x), LINES);
    // Caught: the picture jolts, and goes red from its edges
    float2 jolt = float2(Math.Sin(lens.phase * 97), Math.Cos(lens.phase * 131)) * lens.scare * 0.02;
    float2 cell = Math.Floor(Math.Saturate(vertex.uv + jolt) * cells);
    float2 uv = (cell + 0.5) / cells;
    float2 off = uv - 0.5;
    mut float3 light = Rgb(source.Sample(uv, Filter.Point, Wrap.Clamp));
    light += Rgb(lens.shafts.Sample(uv, Filter.Bilinear, Wrap.Clamp));
    light += Rgb(lens.near.Sample(uv, Filter.Bilinear, Wrap.Clamp)) * 0.5 + Rgb(lens.mid.Sample(uv, Filter.Bilinear, Wrap.Clamp)) * 0.4
           + Rgb(lens.wide.Sample(uv, Filter.Bilinear, Wrap.Clamp)) * 0.34;
    light *= 1.15;

    mut float3 film = Math.Saturate(light * (light * 2.51 + float3(0.03)) / (light * (light * 2.43 + float3(0.59)) + float3(0.14)));
    float luma = Math.Dot(film, float3(0.2126, 0.7152, 0.0722));
    film = Math.Lerp(float3(luma), film, 0.92);
    film *= Math.Lerp(float3(0.92, 1.03, 0.96), float3(1.05, 1.0, 0.9), Math.SmoothStep(0.0, 0.6, luma));
    film = Math.Saturate(film);
    mut float3 shown = float3(Math.Sqrt(film.x), Math.Sqrt(film.y), Math.Sqrt(film.z));
    shown *= 1 - Math.SmoothStep(0.2, 1.1, Math.Dot(off, off) * 2) * 0.45;
    shown = Math.Lerp(shown, shown * float3(1.5, 0.25, 0.2), Math.Saturate(lens.scare * (0.35 + Math.Dot(off, off) * 3)));
    float grain = Math.Frac(Math.Sin(Math.Dot(cell + float2(lens.phase * 37, lens.phase * 91), float2(12.9898, 78.233))) * 43758.5453) - 0.5;
    shown += grain * 0.02;
    // The ordered pattern of four by four that hides the steps
    int x = int(cell.x) & 3;
    int y = int(cell.y) & 3;
    float pattern = ((((x ^ y) & 1) * 2 + (y & 1)) * 4 + (((x >> 1) ^ (y >> 1)) & 1) * 2 + ((y >> 1) & 1) + 0.5) / 16;
    shown = Math.Floor(Math.Saturate(shown) * 31 + pattern) / 31;
    color = Color(shown.x, shown.y, shown.z, 1);
}

void BoxFace(mut Optics optics, float3 normal, float3 a, float3 b, float3 c, float3 d)
{
    int start = optics.box.count;
    optics.box.Add(StoneVertex { position = a, normal = normal, uv = float2(0, 1) });
    optics.box.Add(StoneVertex { position = b, normal = normal, uv = float2(1, 1) });
    optics.box.Add(StoneVertex { position = c, normal = normal, uv = float2(1, 0) });
    optics.box.Add(StoneVertex { position = d, normal = normal, uv = float2(0, 0) });
    optics.triangles.Add(start);
    optics.triangles.Add(start + 1);
    optics.triangles.Add(start + 2);
    optics.triangles.Add(start);
    optics.triangles.Add(start + 2);
    optics.triangles.Add(start + 3);
}

void MakeBall(mut Optics optics, int rings, int around)
{
    for (int ring = 0; ring <= rings; ring++)
    {
        float tilt = ring * Math.PI / rings;
        for (int step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            float3 out = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
            optics.ball.Add(StoneVertex { position = out * 0.5, normal = out, uv = float2(step * 1.0 / around, ring * 1.0 / rings) });
            if (ring == rings || step == around) continue;
            int at = ring * (around + 1) + step;
            optics.ballTriangles.Add(at);
            optics.ballTriangles.Add(at + around + 1);
            optics.ballTriangles.Add(at + 1);
            optics.ballTriangles.Add(at + 1);
            optics.ballTriangles.Add(at + around + 1);
            optics.ballTriangles.Add(at + around + 2);
        }
    }
}

void MakeTube(mut Optics optics, int around)
{
    for (int step = 0; step <= around; step++)
    {
        float turn = step * Math.TAU / around;
        float3 out = float3(Math.Cos(turn), 0, Math.Sin(turn));
        optics.tube.Add(StoneVertex { position = out * 0.5 - float3(0, 0.5, 0), normal = out, uv = float2(step * 1.0 / around, 0) });
        optics.tube.Add(StoneVertex { position = out * 0.5 + float3(0, 0.5, 0), normal = out, uv = float2(step * 1.0 / around, 1) });
        if (step == around) continue;
        int at = step * 2;
        optics.tubeTriangles.Add(at);
        optics.tubeTriangles.Add(at + 1);
        optics.tubeTriangles.Add(at + 2);
        optics.tubeTriangles.Add(at + 2);
        optics.tubeTriangles.Add(at + 1);
        optics.tubeTriangles.Add(at + 3);
    }
    for (int cap = 0; cap < 2; cap++)
    {
        float y = cap == 0 ? 0.5 : -0.5;
        float3 normal = float3(0, cap == 0 ? 1 : -1, 0);
        int middle = optics.tube.count;
        optics.tube.Add(StoneVertex { position = float3(0, y, 0), normal = normal, uv = float2(0.5, 0.5) });
        for (int step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            optics.tube.Add(StoneVertex { position = float3(Math.Cos(turn) * 0.5, y, Math.Sin(turn) * 0.5), normal = normal, uv = float2(0.5, 0.5) });
            if (step == around) continue;
            optics.tubeTriangles.Add(middle);
            optics.tubeTriangles.Add(middle + 1 + step + (cap == 0 ? 1 : 0));
            optics.tubeTriangles.Add(middle + 1 + step + (cap == 0 ? 0 : 1));
        }
    }
}

// A leaf: a blade that grows along y and arches over towards z.
void MakeBlade(mut Optics optics, int along)
{
    for (int row = 0; row <= along; row++)
    {
        float t = row * 1.0 / along;
        float width = Math.Pow(1 - t, 0.7) * (0.3 + 0.7 * Math.Min(1, t * 4));
        float3 normal = Math.Normalize(float3(0, -1.1 * t, 1));
        for (int side = -1; side <= 1; side++)
        {
            float3 at = float3(side * width * 0.5, t, 0.55 * t * t + (side == 0 ? -0.04 * width : 0));
            optics.blade.Add(StoneVertex { position = at, normal = Math.Normalize(normal + float3(side * 0.35, 0, 0)), uv = float2(side * 0.5 + 0.5, t) });
        }
        if (row == along) continue;
        for (int side = 0; side < 2; side++)
        {
            int at = row * 3 + side;
            optics.bladeTriangles.Add(at);
            optics.bladeTriangles.Add(at + 3);
            optics.bladeTriangles.Add(at + 1);
            optics.bladeTriangles.Add(at + 1);
            optics.bladeTriangles.Add(at + 3);
            optics.bladeTriangles.Add(at + 4);
        }
    }
}

void MakeOptics(mut Optics optics, mut Daylight day, mut Lens lens)
{
    optics.scene = RenderTarget.Window(Format.Rgba16f, samples: 4);
    optics.amber = RenderTarget.Window(samples: 4);
    optics.cyan = RenderTarget.Window(samples: 4);
    optics.amberDeep = RenderTarget.Window(0.5);
    optics.cyanDeep = RenderTarget.Window(0.5);
    day.map = RenderTarget(SUN_PIXELS, SUN_PIXELS, 1, Format.Depth);
    day.depth = day.map.depth;
    day.amberMap = RenderTarget(FOLD_PIXELS, FOLD_PIXELS, 1, Format.Depth);
    day.cyanMap = RenderTarget(FOLD_PIXELS, FOLD_PIXELS, 1, Format.Depth);
    day.amberDepth = day.amberMap.depth;
    day.cyanDepth = day.cyanMap.depth;
    day.made = true;
    lens.sceneDepth = optics.scene.depth;
    lens.amberDepth = optics.amber.depth;
    lens.cyanDepth = optics.cyan.depth;
    lens.amberFarDepth = optics.amberDeep.depth;
    lens.cyanFarDepth = optics.cyanDeep.depth;
    lens.air = RenderTarget.Window(0.5, Format.Rgba16f);
    lens.half = RenderTarget.Window(0.5, Format.Rgba16f);
    lens.quarter = RenderTarget.Window(0.25, Format.Rgba16f);
    lens.quarterTurn = RenderTarget.Window(0.25, Format.Rgba16f);
    lens.eighth = RenderTarget.Window(0.125, Format.Rgba16f);
    lens.eighthTurn = RenderTarget.Window(0.125, Format.Rgba16f);
    lens.sixteenth = RenderTarget.Window(0.0625, Format.Rgba16f);
    lens.sixteenthTurn = RenderTarget.Window(0.0625, Format.Rgba16f);
    lens.made = true;
    BoxFace(optics, float3(0, 0, 1), float3(-.5, -.5, .5), float3(.5, -.5, .5), float3(.5, .5, .5), float3(-.5, .5, .5));
    BoxFace(optics, float3(0, 0, -1), float3(.5, -.5, -.5), float3(-.5, -.5, -.5), float3(-.5, .5, -.5), float3(.5, .5, -.5));
    BoxFace(optics, float3(-1, 0, 0), float3(-.5, -.5, -.5), float3(-.5, -.5, .5), float3(-.5, .5, .5), float3(-.5, .5, -.5));
    BoxFace(optics, float3(1, 0, 0), float3(.5, -.5, .5), float3(.5, -.5, -.5), float3(.5, .5, -.5), float3(.5, .5, .5));
    BoxFace(optics, float3(0, 1, 0), float3(-.5, .5, .5), float3(.5, .5, .5), float3(.5, .5, -.5), float3(-.5, .5, -.5));
    BoxFace(optics, float3(0, -1, 0), float3(-.5, -.5, -.5), float3(.5, -.5, -.5), float3(.5, -.5, .5), float3(-.5, -.5, .5));
    MakeBall(optics, 14, 22);
    MakeTube(optics, 20);
    MakeBlade(optics, 6);
    optics.card = [Vertex3 { position = float3(-.5, -.5, 0), uv = float2(0, 1) },
                   Vertex3 { position = float3(.5, -.5, 0), uv = float2(1, 1) },
                   Vertex3 { position = float3(.5, .5, 0), uv = float2(1, 0) },
                   Vertex3 { position = float3(-.5, .5, 0), uv = float2(0, 0) }];
    optics.cardTriangles = [0, 1, 2, 0, 2, 3];
    optics.made = true;
}

Fixture Block(float3 position, float3 size, Color tint, float tiles = 0, float luminous = 0, float gloss = 0.1, float crop = 0)
{
    return Fixture { transform = float4x4.TRS(position, quaternion.identity, size), tint = tint, size = size, luminous = luminous, gloss = gloss };
}

Fixture Turned(float3 position, quaternion rotation, float3 size, Color tint, float luminous = 0, float gloss = 0.1, float crop = 0)
{
    return Fixture { transform = float4x4.TRS(position, rotation, size), tint = tint, size = size, luminous = luminous, gloss = gloss };
}

Fixture Round(float3 position, quaternion rotation, float3 size, Color tint, float luminous = 0, float gloss = 0.3)
{
    return Fixture { transform = float4x4.TRS(position, rotation, size), tint = tint, size = size, luminous = luminous, gloss = gloss };
}

// A box painted with a square of the sheet, `tiles` of it a meter, by where it is in the room.
Fixture Clad(float3 position, float3 size, float cell, float tiles, Color tint = Color.white)
{
    return Fixture { transform = float4x4.TRS(position, quaternion.identity, size), tint = tint, size = size, tiles = tiles, cell = cell };
}

// A box with a square of the sheet on each face: all of it, or its left or right half.
Fixture Faced(float3 position, quaternion rotation, float3 size, float cell, float crop, Color tint = Color.white)
{
    return Fixture { transform = float4x4.TRS(position, rotation, size), tint = tint, size = size, cell = cell, crop = crop };
}

// The sheet's squares.
const float DOORS = 0;
const float BRICK = 1;
const float PANELS = 2;
const float CONCRETE = 3;
const float MARBLE = 4;
const float PLANKS = 5;
const float HAZARD = 6;
const float RUST = 9;
const float SHUTTER = 10;
const float WALLPAPER = 12;
const float CARPET = 13;
const float CEILING_TILE = 14;
const float PLASTER = 15;

// The rooms: an office floor nobody works on. Yellowed paper on the walls,
// damp carpet, a ceiling of tiles with a lamp in every bay, doors to nowhere.
void Dress(mut Optics optics, int level)
{
    optics.architecture.Clear();
    optics.glass.Clear();
    optics.leaves.Clear();
    optics.furnishings.Clear();
    Color wood = Color(.30, .22, .15);
    Color steel = Color(.16, .17, .17);
    Color mint = Color(0.29, 0.89, 0.82);
    Color dull = Color(.8, .8, .76);

    if (level < 2) optics.architecture.Add(Clad(float3(0, -.2, 0), float3(19.6, .4, 26), CARPET, .5));
    else
    {
        optics.architecture.Add(Clad(float3(0, -.2, -4), float3(19.6, .4, 18), CARPET, .5));
        optics.architecture.Add(Clad(float3(0, -.2, 11), float3(19.6, .4, 4), CARPET, .5));
        optics.architecture.Add(Clad(float3(0, -3.2, 7), float3(19.6, .4, 4), CONCRETE, .5, dull));
        optics.architecture.Add(Clad(float3(-9.95, -1.7, 7), float3(.3, 3.4, 4.4), PANELS, .5, dull));
        optics.architecture.Add(Clad(float3(9.95, -1.7, 7), float3(.3, 3.4, 4.4), PANELS, .5, dull));
        optics.architecture.Add(Clad(float3(0, -1.9, 4.9), float3(19.6, 3, .2), PANELS, .5, dull));
        optics.architecture.Add(Clad(float3(0, -1.9, 9.1), float3(19.6, 3, .2), PANELS, .5, dull));
        for (int i = 0; i < 9; i++)
        {
            optics.architecture.Add(Clad(float3(-8 + i * 2, -1.6, 7), float3(.16, 2.8, 3.8), RUST, .5));
            optics.architecture.Add(Block(float3(-8 + i * 2, -2.65, 7), float3(.08, .07, 3.8), mint, 0, 1));
        }
    }
    optics.architecture.Add(Clad(float3(-10.1, 3.5, 0), float3(.6, 7, 26.6), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(10.1, 3.5, 0), float3(.6, 7, 26.6), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(0, 3.5, -13.3), float3(20.8, 7, .6), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(-6.5, 3.5, 13.3), float3(7, 7, .6), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(6.5, 3.5, 13.3), float3(7, 7, .6), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(0, 5.5, 13.3), float3(6.2, 3, .6), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(-6.05, 3.5, 3), float3(7.9, 7, .4), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(6.05, 3.5, 3), float3(7.9, 7, .4), WALLPAPER, .5));
    optics.architecture.Add(Clad(float3(0, 5.5, 3), float3(4.4, 3, .4), WALLPAPER, .5));
    // Skirting along every wall, and the doorways' wooden linings.
    for (int side = -1; side <= 1; side += 2)
    {
        optics.architecture.Add(Block(float3(side * 9.77, .09, 0), float3(.06, .18, 26), wood));
        optics.architecture.Add(Block(float3(side * 6.05, .09, 3 - .23), float3(7.9, .18, .06), wood));
        optics.architecture.Add(Block(float3(side * 6.05, .09, 3 + .23), float3(7.9, .18, .06), wood));
        optics.architecture.Add(Block(float3(side * 6.5, .09, 12.97), float3(7, .18, .06), wood));
        optics.architecture.Add(Block(float3(side * 2.14, 2, 3), float3(.1, 4, .52), wood));
        optics.architecture.Add(Block(float3(side * 3.03, 2, 13.3), float3(.1, 4, .72), wood));
    }
    optics.architecture.Add(Block(float3(0, .09, -12.97), float3(19.6, .18, .06), wood));
    optics.architecture.Add(Block(float3(0, 4.05, 3), float3(4.38, .1, .52), wood));
    optics.architecture.Add(Block(float3(0, 4.04, 13.3), float3(6.16, .1, .72), wood));

    // The ceiling and its lamps, which stop no light: the lamps' is what there is.
    optics.glass.Add(Clad(float3(0, CEILING + .15, 0), float3(20.8, .3, 26.6), CEILING_TILE, .833));
    for (int row = 0; row < 8; row++)
    {
        for (int column = 0; column < 4; column++)
        {
            float3 at = float3((column - 1.5) * 5, CEILING - .015, -13 + (row + .5) * 3.25);
            optics.glass.Add(Fixture { transform = float4x4.TRS(at, quaternion.identity, float3(1.2, .03, .6)), size = float3(1.2, .03, .6), kind = 2 });
            optics.glass.Add(Block(at + float3(0, .01, 0), float3(1.32, .03, .72), steel));
        }
    }

    // The way out: a concrete lobby, fire doors and the one sign that's lit.
    optics.architecture.Add(Clad(float3(0, -.25, 15.2), float3(6, .5, 4.4), CONCRETE, .5, dull));
    optics.architecture.Add(Clad(float3(-3.2, 2.1, 15.5), float3(.3, 4.8, 3.8), PANELS, .5, dull));
    optics.architecture.Add(Clad(float3(3.2, 2.1, 15.5), float3(.3, 4.8, 3.8), PANELS, .5, dull));
    optics.architecture.Add(Clad(float3(0, 4.2, 15.5), float3(6.7, .3, 3.8), CONCRETE, .5, dull));
    optics.architecture.Add(Clad(float3(0, 2.1, 17.35), float3(6.7, 4.8, .3), PANELS, .5, dull));
    optics.furnishings.Add(Faced(float3(-.72, 1.3, 17.17), quaternion.identity, float3(1.4, 2.6, .08), DOORS, 1));
    optics.furnishings.Add(Faced(float3(.72, 1.3, 17.17), quaternion.identity, float3(1.4, 2.6, .08), DOORS, 1));
    optics.furnishings.Add(Block(float3(0, 1.35, 17.19), float3(3.04, 2.74, .06), steel));
    optics.furnishings.Add(Block(float3(0, 3.2, 17.14), float3(1.1, .34, .08), Color(.2, 1, .45), 0, 1.3));
    optics.furnishings.Add(Block(float3(0, 3.2, 17.17), float3(1.24, .48, .06), steel));

    // Receptive panels: bolted sheets in a steel frame, the one clean thing on each wall.
    for (int i = 0; i < PanelCount(level); i++)
    {
        float3 p = PanelPosition(level, i);
        float3 normal = PanelNormal(level, i);
        quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
        optics.furnishings.Add(Fixture { transform = float4x4.TRS(p + normal * .012, r, float3(2.9, 3.5, .04)), tint = Color(1.15, 1.15, 1.1), size = float3(2.9, 3.5, .04),
                                         tiles = 1, cell = PANELS, gloss = .5 });
        optics.furnishings.Add(Turned(p + Math.Rotate(r, float3(-1.5, .15, .03)), r, float3(.1, 3.3, .1), steel, 0, .4));
        optics.furnishings.Add(Turned(p + Math.Rotate(r, float3(1.5, .15, .03)), r, float3(.1, 3.3, .1), steel, 0, .4));
        optics.furnishings.Add(Turned(p + Math.Rotate(r, float3(0, 1.85, .03)), r, float3(3.1, .1, .1), steel, 0, .4));
        optics.furnishings.Add(Turned(p + Math.Rotate(r, float3(0, 2.08, .07)), r, float3(2.9, .035, .05), mint, 1));
        for (int mark = 0; mark <= i; mark++)
            optics.furnishings.Add(Turned(p + Math.Rotate(r, float3(-.9 + mark * .22, 2.2, .05)), r, float3(.1, .11, .02), steel));
    }

    // Doors that lead nowhere, each in its frame.
    for (int door = 0; door < 9; door++)
    {
        mut float3 at = float3(-9.77, 1.05, -11.2);
        mut float3 normal = float3(1, 0, 0);
        if (door == 1) at.z = -1.6;
        else if (door == 2) at.z = 6.3;
        else if (door >= 3 && door < 6)
        {
            normal = float3(-1, 0, 0);
            at = float3(9.77, 1.05, door == 3 ? -10.4 : door == 4 ? -2.2 : 5.8);
        }
        else if (door >= 6)
        {
            normal = float3(0, 0, 1);
            at = float3(door == 6 ? -6.2 : door == 7 ? 1.4 : 7.1, 1.05, -12.97);
        }
        if (level == 2 && at.z > 4.5 && at.z < 9.5) continue;
        quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
        optics.furnishings.Add(Faced(at + normal * .03, r, float3(.95, 2.1, .06), DOORS, 2));
        optics.furnishings.Add(Turned(at + float3(0, .03, 0) + normal * .012, r, float3(1.11, 2.2, .06), wood));
    }

    // What was left behind: crates, a stack of boards, and plants nobody waters.
    optics.furnishings.Add(Faced(float3(7.9, .45, -11.6), quaternion.Euler(0, .2, 0), float3(.9), PLANKS, 0));
    optics.furnishings.Add(Faced(float3(8.6, .45, -10.5), quaternion.Euler(0, -.4, 0), float3(.9), PLANKS, 0));
    optics.furnishings.Add(Faced(float3(8.1, 1.3, -11.2), quaternion.Euler(0, .7, 0), float3(.8), PLANKS, 0));
    optics.furnishings.Add(Faced(float3(-7.6, .06, 11.6), quaternion.Euler(0, .3, 0), float3(2.2, .12, 1.1), PLANKS, 0));
    optics.furnishings.Add(Faced(float3(-7.4, .18, 11.5), quaternion.Euler(0, -.15, 0), float3(2.2, .12, 1.1), PLANKS, 0));
    optics.furnishings.Add(Faced(float3(7.6, .5, 11.9), quaternion.Euler(0, .1, 0), float3(1.0, 1.0, .9), RUST, 0));
    for (int planter = 0; planter < 8; planter++)
    {
        float x = planter % 2 == 0 ? -9.0 : 9.0;
        float z = -11 + (planter / 2) * 6.4;
        if (level == 2 && z > 4 && z < 10) continue;
        if (planter == 1 || planter == 6) continue;
        optics.furnishings.Add(Clad(float3(x, .36, z), float3(.85, .72, 2.0), CONCRETE, 1, Color(.7, .7, .68)));
        optics.furnishings.Add(Block(float3(x, .7, z), float3(.72, .06, 1.87), Color(.07, .06, .045)));
        for (int leaf = 0; leaf < 22; leaf++)
        {
            int roll = Math.Hash(int2(planter, leaf));
            float a = leaf * 2.39996 + planter * 1.7;
            float long = .45 + ((roll >> 3) & 63) / 63.0 * .7;
            float lean = .25 + ((roll >> 9) & 63) / 63.0 * .75;
            float3 p = float3(x + Math.Cos(a) * .2, .72, z + ((leaf % 6) - 2.5) * .29 + Math.Sin(a) * .08);
            quaternion r = Math.Mul(quaternion.Euler(0, a, 0), quaternion.Euler(lean, 0, 0));
            float shadeOf = ((roll >> 15) & 63) / 63.0;
            optics.leaves.Add(Fixture { transform = float4x4.TRS(p, r, float3(.1 + long * .09, long, long)),
                                        tint = Color(.34 + shadeOf * .22, .44 + shadeOf * .12, .18 + shadeOf * .06), size = float3(1), kind = 1 });
        }
    }

    // The chamber's number, by the gate.
    optics.furnishings.Add(Block(float3(4.4, 3.1, 2.76), float3(2.65, 1.5, .07), Color(.08, .1, .1), 0, 0, .4));
    WallDigit(optics, 0, float3(3.86, 3.1, 2.715));
    WallDigit(optics, level + 1, float3(4.94, 3.1, 2.715));
    optics.dressed = level;
}

void WallDigit(mut Optics optics, int digit, float3 position)
{
    int mask = digit == 0 ? 63 : digit == 1 ? 6 : digit == 2 ? 91 : 79;
    for (int segment = 0; segment < 7; segment++)
    {
        if ((mask & (1 << segment)) == 0) continue;
        mut float3 at = float3(0, .46, 0);
        mut float3 size = float3(.47, .08, .025);
        if (segment == 1 || segment == 2 || segment == 4 || segment == 5)
        {
            at = float3(segment < 3 ? .265 : -.265, segment == 1 || segment == 5 ? .23 : -.23, 0);
            size = float3(.08, .4, .025);
        }
        else if (segment == 3) at.y = -.46;
        else if (segment == 6) at.y = 0;
        optics.furnishings.Add(Block(position + at, size, Color(.84, .96, .88), 0, .9));
    }
}

// An operator's pose: standing, or running as fast as they go, and where they stand as a matrix.
Pose FigurePose(Operator body, float clock)
{
    mut var pose = figure.defaultPose;
    // Each of Kenney's files holds a one-frame targeting pose before its clip: the clips are the odd ones.
    if (moves.TryGetAt(1, out var idle)) pose.Sample(idle, Math.Frac(clock / Math.Max(idle.duration, 0.01)) * idle.duration, Playback.Loop);
    float pace = Math.Saturate(Math.Length(body.velocity.xz) / 4);
    if (body.position.y > 0.05)
    {
        if (moves.TryGetAt(5, out var jump))
        {
            mut var leaping = figure.defaultPose;
            leaping.Sample(jump, jump.duration * 0.5);
            pose.Blend(leaping, 0.8);
        }
    }
    else if (pace > 0.01 && moves.TryGetAt(3, out var run))
    {
        mut var running = figure.defaultPose;
        running.Sample(run, Math.Frac(clock / Math.Max(run.duration, 0.01)) * run.duration, Playback.Loop);
        pose.Blend(running, pace);
    }
    return pose;
}

float4x4 FigurePlace(Operator body)
{
    return float4x4.TRS(body.position, quaternion.Euler(0, body.yaw, 0), float3(FIGURE_SCALE));
}

// The fold projector in the operator's hand. It's drawn after the room, over
// depth set back, so it's in front of a wall the operator stands against.
void Held(mut Optics optics, float3 eye, quaternion rotation, int mesh, float3 at, quaternion turn, float3 size, Color tint, float luminous = 0, float gloss = .6)
{
    quaternion r = Math.Mul(rotation, turn);
    mut Fixture part = mesh == 0 ? Turned(eye + Math.Rotate(rotation, at), r, size, tint, luminous, gloss, .012)
                                 : Round(eye + Math.Rotate(rotation, at), r, size, tint, luminous, gloss);
    if (mesh == 0) optics.device.Add(part);
    else if (mesh == 1) optics.deviceBalls.Add(part);
    else optics.deviceTubes.Add(part);
}

void Handheld(mut Optics optics, float3 eye, quaternion rotation, float pace, float carrying)
{
    Color shell = Color(.80, .79, .75);
    Color dark = Color(.08, .11, .13);
    float bob = Math.Sin(optics.stride * 2) * .008 * pace;
    float kick = optics.fired * optics.fired * .07;
    float3 hand = float3(.4 + Math.Sin(optics.stride) * .008 * pace, -.345 + bob - carrying * .14, .74 - kick);
    quaternion aim = quaternion.Euler(-.17 - kick * 1.5, -.3, 0);
    quaternion along = Math.Mul(aim, quaternion.Euler(90deg, 0, 0));
    Held(optics, eye, rotation, 2, hand, along, float3(.1, .42, .1), shell, 0, .8);
    Held(optics, eye, rotation, 1, hand + Math.Rotate(aim, float3(0, 0, -.21)), aim, float3(.1, .1, .12), shell, 0, .8);
    Held(optics, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, .15)), along, float3(.128, .07, .128), dark, 0, .7);
    Held(optics, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, .02)), along, float3(.108, .025, .108), dark, 0, .7);
    Held(optics, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, -.1)), along, float3(.108, .025, .108), dark, 0, .7);
    Held(optics, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, .2)), along, float3(.085, .05, .085), Color(.3, .9, .86), .7 + optics.fired * 2);
    Held(optics, eye, rotation, 1, hand + Math.Rotate(aim, float3(0, 0, .25)), aim, float3(.06), Color(.8, 1, .97), 1.1 + optics.fired * 3);
    for (int prong = 0; prong < 3; prong++)
    {
        quaternion around = Math.Mul(aim, quaternion.Euler(0, 0, prong * Math.TAU / 3 + Math.PI / 6));
        Held(optics, eye, rotation, 0, hand + Math.Rotate(around, float3(0, .064, .26)), Math.Mul(around, quaternion.Euler(.2, 0, 0)), float3(.022, .016, .17), dark, 0, .7);
    }
    Held(optics, eye, rotation, 0, hand + Math.Rotate(aim, float3(-.022, .0515, -.04)), aim, float3(.011, .006, .09), Color(1, .64, .24), .8);
    Held(optics, eye, rotation, 0, hand + Math.Rotate(aim, float3(.022, .0515, -.04)), aim, float3(.011, .006, .09), Color(.2, .96, .88), .8);
}

void Furnish(mut Optics optics, Arena arena, Fold fold, Operator viewer, Operator partner, int aimed)
{
    optics.dynamic.Clear();
    optics.balls.Clear();
    optics.tubes.Clear();
    optics.self.Clear();
    optics.selfBalls.Clear();
    optics.selfTubes.Clear();
    optics.device.Clear();
    optics.deviceBalls.Clear();
    optics.deviceTubes.Clear();
    optics.motes.Clear();
    Color amberTint = Color(1, .64, .24);
    Color cyanTint = Color(.2, .96, .88);
    Color steel = Color(.10, .14, .16);
    for (int plate = 0; plate < 2; plate++)
    {
        float3 at = PlatePosition(arena.level, plate);
        bool pressed = plate == 0 ? arena.plateA : arena.plateB;
        Color tint = plate == 0 ? amberTint : cyanTint;
        float sunk = pressed ? .025 : 0;
        optics.dynamic.Add(Block(at + float3(0, .03, 0), float3(1.62, .08, 1.62), steel, 0, 0, .6, .03));
        optics.dynamic.Add(Block(at + float3(0, .085 - sunk, 0), float3(1.2, .06, 1.2), pressed ? tint : Color(.34, .40, .41), 0, pressed ? .8 : 0, .5, .02));
        for (int edge = -1; edge <= 1; edge += 2)
        {
            optics.dynamic.Add(Block(at + float3(edge * .72, .074, 0), float3(.05, .012, 1.3), tint, 0, pressed ? 1.3 : .55));
            optics.dynamic.Add(Block(at + float3(0, .074, edge * .72), float3(1.3, .012, .05), tint, 0, pressed ? 1.3 : .55));
        }
    }
    if (arena.level == 2 && arena.bridge)
    {
        optics.dynamic.Add(Block(float3(0, -.075, 7), float3(3.4, .15, 4.0), Color(.2, .29, .31), 2, 0, .7));
        optics.dynamic.Add(Block(float3(-1.68, .02, 7), float3(.04, .03, 4), cyanTint, 0, 1.2));
        optics.dynamic.Add(Block(float3(1.68, .02, 7), float3(.04, .03, 4), cyanTint, 0, 1.2));
    }

    // The split gate physically retreats upwards as its two circuits latch.
    float gateY = 2.0 + arena.gate * 4.3;
    optics.dynamic.Add(Faced(float3(0, gateY, 3), quaternion.identity, float3(4.14, 4.0, .24), SHUTTER, 0, Color(.8, .8, .8)));
    for (int rib = 0; rib < 4; rib++)
        optics.dynamic.Add(Block(float3(0, gateY - 1.5 + rib, 2.87), float3(3.5, .07, .04), steel, 0, 0, .7));
    optics.dynamic.Add(Block(float3(-1.9, gateY, 2.86), float3(.05, 3.9, .04), amberTint, 0, arena.plateA || arena.solved ? 1.4 : .5));
    optics.dynamic.Add(Block(float3(1.9, gateY, 2.86), float3(.05, 3.9, .04), cyanTint, 0, arena.plateB || arena.solved ? 1.4 : .5));
    optics.dynamic.Add(Block(float3(0, gateY, 2.865), float3(.04, 3.9, .05), Color(.36, .46, .47), 0, 0, .8));

    // A carried resonator remains part of the world in every portal pass.
    float3 cube = fold.cube;
    optics.dynamic.Add(Block(cube, float3(.74), Color(.86, .86, .80), 0, 0, .6, .05));
    for (int corner = 0; corner < 8; corner++)
    {
        float3 way = float3((corner & 1) == 0 ? -1 : 1, (corner & 2) == 0 ? -1 : 1, (corner & 4) == 0 ? -1 : 1);
        optics.dynamic.Add(Block(cube + way * .3, float3(.2), steel, 0, 0, .7, .04));
    }
    for (int face = 0; face < 6; face++)
    {
        int axis = face / 2;
        float sign = face % 2 == 0 ? 1 : -1;
        float3 way = float3(axis == 0 ? sign : 0, axis == 1 ? sign : 0, axis == 2 ? sign : 0);
        float3 size = float3(axis == 0 ? .03 : .3, axis == 1 ? .03 : .3, axis == 2 ? .03 : .3);
        optics.dynamic.Add(Block(cube + way * .366, size, face == 2 ? amberTint : Color(.16, .86, .80), 0, fold.carried >= 0 ? 1.5 : 1));
    }

    // Each receptive panel's ribbon answers the operator's aim.
    if (aimed >= 0)
    {
        float3 normal = PanelNormal(arena.level, aimed);
        quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
        optics.dynamic.Add(Turned(PanelPosition(arena.level, aimed) + Math.Rotate(r, float3(0, 2.08, .085)), r, float3(2.9, .06, .05), Color(.85, 1, .97), 1.8));
    }

    // A partner's ping: a beacon that turns and fades.
    if (fold.pingTime > 0)
    {
        float fade = Math.Saturate(fold.pingTime / 0.6);
        Color tint = fold.pingOperator == 0 ? amberTint : cyanTint;
        float pulse = .12 + Math.Abs(Math.Sin(optics.phase * 4)) * .04;
        optics.dynamic.Add(Turned(fold.ping, quaternion.Euler(45deg, optics.phase * 2, 45deg), float3(pulse * fade), tint, 1.1));
        optics.dynamic.Add(Block(fold.ping - float3(0, .9, 0), float3(.014 * fade, 1.3, .014 * fade), tint, 0, .8));
    }


    // Dust adrift where the roof lets the sun in.
    for (int i = 0; i < 260; i++)
    {
        int roll = Math.Hash(i);
        float a = (roll & 1023) / 1023.0;
        float b = ((roll >> 10) & 1023) / 1023.0;
        float c = ((roll >> 20) & 1023) / 1023.0;
        mut float3 at = float3(-5 + a * 14.5, .3 + b * 6.4, -12.6 + c * 25.2);
        at += float3(Math.Sin(optics.phase + a * 40), Math.Sin(optics.phase * 2 + b * 40) * .5, Math.Cos(optics.phase + c * 40)) * .28;
        float size = .007 + (roll & 7) * .0016;
        optics.motes.Add(Fixture { transform = float4x4.TRS(at, quaternion.Euler(a * 6, b * 6, c * 6), float3(size)), tint = Color(1, .9, .72), size = float3(size) });
    }
}

// A piece near a fold, again where the fold puts it: `into` 0 for anyone's, 1 and 2 for the viewer's own
// through the amber fold and the cyan one.
void Echo(mut Optics optics, Fixture piece, float4x4 across, int level, int source, int mesh, int into)
{
    float3 from = Math.Mul(piece.transform, float4(0, 0, 0, 1)).xyz - PanelPosition(level, source);
    float depth = Math.Dot(from, PanelNormal(level, source));
    if (Math.Abs(depth) > 1.4 || Math.Abs(Math.Dot(from, PanelRight(level, source))) > 1.7 || Math.Abs(from.y) > 2.3) return;
    mut Fixture echo = piece;
    echo.transform = Math.Mul(across, piece.transform);
    if (into == 0)
    {
        if (mesh == 0) optics.echo.Add(echo);
        else if (mesh == 1) optics.echoBalls.Add(echo);
        else optics.echoTubes.Add(echo);
    }
    else if (into == 1)
    {
        if (mesh == 0) optics.ownAmber.Add(echo);
        else if (mesh == 1) optics.ownAmberBalls.Add(echo);
        else optics.ownAmberTubes.Add(echo);
    }
    else if (mesh == 0) optics.ownCyan.Add(echo);
    else if (mesh == 1) optics.ownCyanBalls.Add(echo);
    else optics.ownCyanTubes.Add(echo);
}

// Everything that's part of the way through either fold, at that fold's other end too.
void Echoes(mut Optics optics, int level, Fold fold)
{
    optics.echo.Clear();
    optics.echoBalls.Clear();
    optics.echoTubes.Clear();
    optics.ownAmber.Clear();
    optics.ownAmberBalls.Clear();
    optics.ownAmberTubes.Clear();
    optics.ownCyan.Clear();
    optics.ownCyanBalls.Clear();
    optics.ownCyanTubes.Clear();
    if (fold.a == fold.b) return;
    for (int way = 0; way < 2; way++)
    {
        int source = way == 0 ? fold.a : fold.b;
        int destination = way == 0 ? fold.b : fold.a;
        // The fold turns the world about the vertical, so that what faces into one wall faces out of the other
        float3 into = PanelNormal(level, source);
        float3 out = -PanelNormal(level, destination);
        quaternion turn = quaternion.Euler(0, Math.Atan2(out.x, out.z) - Math.Atan2(into.x, into.z), 0);
        float4x4 across = float4x4.TRS(PanelPosition(level, destination) - Math.Rotate(turn, PanelPosition(level, source)), turn, float3(1));
        for (int i = 0; i < optics.dynamic.count; i++) Echo(optics, optics.dynamic[i], across, level, source, 0, 0);
        for (int i = 0; i < optics.balls.count; i++) Echo(optics, optics.balls[i], across, level, source, 1, 0);
        for (int i = 0; i < optics.tubes.count; i++) Echo(optics, optics.tubes[i], across, level, source, 2, 0);
        for (int i = 0; i < optics.self.count; i++) Echo(optics, optics.self[i], across, level, source, 0, 1 + way);
        for (int i = 0; i < optics.selfBalls.count; i++) Echo(optics, optics.selfBalls[i], across, level, source, 1, 1 + way);
        for (int i = 0; i < optics.selfTubes.count; i++) Echo(optics, optics.selfTubes[i], across, level, source, 2, 1 + way);
    }
}

// What a fold does to the world, as a matrix: it turns it about the vertical, so that what faces into one
// wall faces out of the other.
float4x4 Across(int level, int source, int destination)
{
    float3 into = PanelNormal(level, source);
    float3 out = -PanelNormal(level, destination);
    quaternion turn = quaternion.Euler(0, Math.Atan2(out.x, out.z) - Math.Atan2(into.x, into.z), 0);
    return float4x4.TRS(PanelPosition(level, destination) - Math.Rotate(turn, PanelPosition(level, source)), turn, float3(1));
}

// Whether an operator is near enough a fold to be part of the way through it.
bool AtFold(int level, int panel, float3 feet)
{
    float3 from = feet + float3(0, 0.9, 0) - PanelPosition(level, panel);
    return Math.Abs(Math.Dot(from, PanelNormal(level, panel))) < 1.4 && Math.Abs(Math.Dot(from, PanelRight(level, panel))) < 1.7;
}

quaternion FoldedRotation(int level, int source, int destination, quaternion rotation)
{
    float3 forward = PortalMapDirection(level, source, destination, Math.Forward(rotation));
    float3 up = PortalMapDirection(level, source, destination, Math.Up(rotation));
    return quaternion.LookRotation(forward, up);
}

// The part of the window an opening covers, as a corner and a size in
// pixels: nothing where the eye can't see it, so its camera has no work.
float4 OpeningOnScreen(int level, int panel, float3 eye, quaternion rotation, float2 window)
{
    float3 middle = PanelPosition(level, panel);
    if (Math.Dot(eye - middle, PanelNormal(level, panel)) < -0.06) return float4(0);
    float3 forward = Math.Forward(rotation);
    float3 up = Math.Up(rotation);
    float3 right = Math.Cross(up, forward);
    float focal = window.y * 0.5 / Math.Tan(37.5deg);
    mut float2 low = window;
    mut float2 high = float2(0);
    mut int behind = 0;
    for (int corner = 0; corner < 4; corner++)
    {
        float3 at = middle + PanelRight(level, panel) * ((corner & 1) == 0 ? -FOLD_WIDE - .04 : FOLD_WIDE + .04)
                  + float3(0, ((corner & 2) == 0 ? -FOLD_HIGH - .04 : FOLD_HIGH + .04) - FOLD_DROP, 0);
        float3 from = at - eye;
        float depth = Math.Dot(from, forward);
        if (depth < 0.05)
        {
            behind += 1;
            continue;
        }
        float2 on = float2(window.x * 0.5 + Math.Dot(from, right) / depth * focal, window.y * 0.5 - Math.Dot(from, up) / depth * focal);
        low = Math.Min(low, on);
        high = Math.Max(high, on);
    }
    if (behind == 4) return float4(0);
    if (behind > 0) return float4(0, 0, window.x, window.y);
    low = Math.Max(low - float2(3), float2(0));
    high = Math.Min(high + float2(3), window);
    if (high.x <= low.x || high.y <= low.y) return float4(0);
    return float4(low.x, low.y, high.x - low.x, high.y - low.y);
}

// Second crossings, their parents, then the room. Targets are disjoint and
// portal cameras and all visible simulation objects update in this frame.
view Render(Operator viewer, query (Operator body) operators, Arena arena, Fold fold, Watcher watcher, Control control, Interface ui, mut Optics optics, mut Daylight day,
            mut Lens lens)
{
    if (viewer.id != control.active) return;
    if (!optics.made) MakeOptics(optics, day, lens);
    if (optics.dressed != arena.level) Dress(optics, arena.level);
    float dt = Math.Min(Frame.dt, .05);
    optics.phase += dt;
    if (optics.phase >= Math.TAU) optics.phase -= Math.TAU;
    optics.clock += dt;
    if (optics.clock >= 3600) optics.clock -= 3600;
    float pace = Math.Saturate(Math.Length(viewer.velocity.xz) / 4) * (viewer.position.y < 0.05 ? 1.0 : 0.0);
    optics.stride += dt * 9.5;
    if (optics.stride >= Math.TAU) optics.stride -= Math.TAU;
    if (optics.lastAmber >= 0 && (optics.lastAmber != fold.a || optics.lastCyan != fold.b)) optics.fired = 1;
    optics.lastAmber = fold.a;
    optics.lastCyan = fold.b;
    optics.fired = Math.Max(0, optics.fired - dt * 4);

    mut var partner = viewer;
    foreach (var row in operators)
        if (row.body.id != viewer.id) partner = row.body;
    mut float3 eye = viewer.position + float3(0, 1.55, 0);
    mut quaternion rotation = quaternion.Euler(-viewer.pitch, viewer.yaw, 0);
    if (ui.open)
    {
        // Behind the menu the atrium is seen from a camera of its own, adrift.
        eye = float3(-7.4 + Math.Sin(optics.phase) * .45, 2.5 + Math.Sin(optics.phase * 2) * .06, -11.4);
        rotation = quaternion.Euler(-.05, .04 + Math.Cos(optics.phase) * .015, 0);
    }
    float3 amberEye = PortalMapPoint(arena.level, fold.a, fold.b, eye);
    float3 cyanEye = PortalMapPoint(arena.level, fold.b, fold.a, eye);
    quaternion amberTurn = FoldedRotation(arena.level, fold.a, fold.b, rotation);
    quaternion cyanTurn = FoldedRotation(arena.level, fold.b, fold.a, rotation);
    optics.amberEye = amberEye;
    optics.cyanEye = cyanEye;
    int aimed = control.started ? AimedPanel(arena.level, eye, LookDirection(viewer.yaw, viewer.pitch), arena.gate) : -1;
    Furnish(optics, arena, fold, viewer, partner, aimed);
    if (!ui.open) Handheld(optics, eye, rotation, pace, fold.carried == viewer.id ? 1.0 : 0.0);
    Echoes(optics, arena.level, fold);
    // Both operators as they stand or run, and each again at a fold's other end while part of the way through it.
    Pose partnerPose = FigurePose(partner, optics.clock);
    Pose selfPose = FigurePose(viewer, optics.clock + 1.7);
    float4x4 partnerPlace = FigurePlace(partner);
    float4x4 selfPlace = FigurePlace(viewer);
    float4x4 throughAmber = Across(arena.level, fold.a, fold.b);
    float4x4 throughCyan = Across(arena.level, fold.b, fold.a);
    bool partnerAmber = fold.a != fold.b && AtFold(arena.level, fold.a, partner.position);
    bool partnerCyan = fold.a != fold.b && AtFold(arena.level, fold.b, partner.position);
    bool selfAmber = fold.a != fold.b && AtFold(arena.level, fold.a, viewer.position);
    bool selfCyan = fold.a != fold.b && AtFold(arena.level, fold.b, viewer.position);
    // The watcher, turned to whoever is nearest, or in the face of whoever it has. It comes and goes in the
    // middle of the moment the lamps are out.
    bool watched = watcher.state != Watching.Away ? watcher.blink < 0.11 : watcher.blink > 0.11;
    float lamps = watcher.blink > 0 ? 0.0 : 1.0;
    mut Operator prey = Math.DistanceSq(viewer.position, WatchSpot(watcher.spot)) < Math.DistanceSq(partner.position, WatchSpot(watcher.spot)) ? viewer : partner;
    mut float3 watcherAt = WatchSpot(watcher.spot);
    if (watcher.state == Watching.Lunging)
    {
        prey = watcher.victim == viewer.id ? viewer : partner;
        float reach = Math.Saturate(watcher.timer / 0.12);
        watcherAt = Math.Lerp(watcherAt, prey.position + LookDirection(prey.yaw, 0) * 0.85, reach);
    }
    float3 watcherTo = prey.position - watcherAt;
    float4x4 watcherPlace = float4x4.TRS(watcherAt, quaternion.Euler(0, Math.Atan2(watcherTo.x, watcherTo.z), 0), float3(FIGURE_SCALE * 1.12));
    Pose watcherPose = FigurePose(Operator { position = watcherAt }, optics.clock + 3.1);
    float caught = watcher.state == Watching.Lunging && watcher.victim == viewer.id && !ui.open ? 1 - Math.Saturate(watcher.timer / 0.75) * 0.6 : 0.0;
    lens.scare = Math.Max(caught, lens.scare - dt * 2.5);

    float2 window = float2(Screen.width, Screen.height);
    Color amberRim = Color(1, .64, .24);
    Color cyanRim = Color(.2, .96, .88);
    // A fold's camera only draws the part of the window its opening covers,
    // and a second crossing only where the first can see an opening again.
    float3 amberAt = PanelPosition(arena.level, fold.a);
    float3 cyanAt = PanelPosition(arena.level, fold.b);
    float4 amberSeen = OpeningOnScreen(arena.level, fold.a, eye, rotation, window);
    float4 cyanSeen = OpeningOnScreen(arena.level, fold.b, eye, rotation, window);
    bool amberAgain = amberSeen.z > 0 && Math.Dot(amberAt - cyanAt, PanelNormal(arena.level, fold.b)) > -1.2
                   && Math.Dot(amberEye - amberAt, PanelNormal(arena.level, fold.a)) > 0;
    bool cyanAgain = cyanSeen.z > 0 && Math.Dot(cyanAt - amberAt, PanelNormal(arena.level, fold.a)) > -1.2
                  && Math.Dot(cyanEye - cyanAt, PanelNormal(arena.level, fold.b)) > 0;
    // Everything that stops a light, drawn from where the light is: the sun's image of the whole atrium, and
    // each fold's lamp's of what's before its wall.
    mut Sight held = Sight { phase = optics.phase };
    for (int lamp = 0; lamp < 3; lamp++)
    {
        var map = lamp == 0 ? day.map : lamp == 1 ? day.amberMap : day.cyanMap;
        map.Clear(Color.white);
        if (lamp == 0)
        {
            map.SetCamera(float4x4.TRS(float3(0, 3.6, 1.9) + SunWay() * 45, quaternion.LookRotation(-SunWay(), float3(0, 0, 1)), float3(1)),
                          float4x4.Ortho(SUN_WIDE, SUN_LONG, 0, 90));
            day.toSun = map.WorldToClip();
        }
        else
        {
            int panel = lamp == 1 ? fold.a : fold.b;
            float3 normal = PanelNormal(arena.level, panel);
            map.SetCamera(float4x4.TRS(PanelPosition(arena.level, panel) + normal * .55, quaternion.LookRotation(normal, float3(0, 1, 0)), float3(1)),
                          float4x4.PerspectiveFov(140deg, 1, .12, 9));
            if (lamp == 1) day.toAmber = map.WorldToClip();
            else day.toCyan = map.WorldToClip();
        }
        map.Instanced(optics.box, optics.triangles, optics.architecture);
        map.Instanced(optics.box, optics.triangles, optics.furnishings);
        map.Instanced(optics.box, optics.triangles, optics.dynamic);
        map.Instanced(optics.box, optics.triangles, optics.self);
        map.Instanced(optics.ball, optics.ballTriangles, optics.balls);
        map.Instanced(optics.ball, optics.ballTriangles, optics.selfBalls);
        map.Instanced(optics.tube, optics.tubeTriangles, optics.tubes);
        map.Instanced(optics.tube, optics.tubeTriangles, optics.selfTubes);
        map.Instanced(optics.box, optics.triangles, optics.echo);
        map.Instanced(optics.ball, optics.ballTriangles, optics.echoBalls);
        map.Instanced(optics.tube, optics.tubeTriangles, optics.echoTubes);
        map.SkinnedMesh(figure, partnerPlace, partnerPose);
        map.SkinnedMesh(figure, selfPlace, selfPose);
        if (watched) map.SkinnedMesh(figure, watcherPlace, watcherPose);
        if (partnerAmber) map.SkinnedMesh(figure, Math.Mul(throughAmber, partnerPlace), partnerPose);
        if (partnerCyan) map.SkinnedMesh(figure, Math.Mul(throughCyan, partnerPlace), partnerPose);
        map.Cull(Cull.None)
        {
            map.Instanced(optics.blade, optics.bladeTriangles, optics.leaves, Sway, held);
        }
    }
    for (int pass = 0; pass < 5; pass++)
    {
        if ((pass == 0 && !amberAgain) || (pass == 1 && !cyanAgain) || (pass == 2 && amberSeen.z <= 0) || (pass == 3 && cyanSeen.z <= 0)) continue;
        mut var target = optics.amberDeep;
        mut float3 camera = PortalMapPoint(arena.level, fold.a, fold.b, amberEye);
        mut quaternion turned = FoldedRotation(arena.level, fold.a, fold.b, amberTurn);
        mut Sight sight = Sight { eye = camera, clipPoint = PanelPosition(arena.level, fold.b), clipNormal = PanelNormal(arena.level, fold.b), clipped = true, packed = true,
                                  cube = fold.cube, partner = partner.position, self = viewer.position, phase = optics.phase, linked = fold.a != fold.b ? 1.0 : 0.0,
                                  amberAt = PanelPosition(arena.level, fold.a) + PanelNormal(arena.level, fold.a) * .55,
                                  cyanAt = PanelPosition(arena.level, fold.b) + PanelNormal(arena.level, fold.b) * .55,
                                  plateA = PlatePosition(arena.level, 0) + float3(0, .35, 0), plateB = PlatePosition(arena.level, 1) + float3(0, .35, 0),
                                  plates = float2(arena.plateA ? 1 : 0, arena.plateB ? 1 : 0),
                                  amberFace = PanelNormal(arena.level, fold.a), cyanFace = PanelNormal(arena.level, fold.b),
                                  grid = float2(LINES * Screen.width / Screen.height, LINES) * .5, lamps = lamps,
                                  torchAt = viewer.position + float3(0, 1.35, 0), torchWay = LookDirection(viewer.yaw, viewer.pitch),
                                  otherAt = partner.position + float3(0, 1.35, 0), otherWay = LookDirection(partner.yaw, partner.pitch) };
        mut float2 pixels = window * .5;
        if (pass == 1)
        {
            target = optics.cyanDeep;
            camera = PortalMapPoint(arena.level, fold.b, fold.a, cyanEye);
            turned = FoldedRotation(arena.level, fold.b, fold.a, cyanTurn);
            sight.clipPoint = PanelPosition(arena.level, fold.a);
            sight.clipNormal = PanelNormal(arena.level, fold.a);
        }
        else if (pass == 2)
        {
            target = optics.amber;
            camera = amberEye;
            turned = amberTurn;
            pixels = window;
        }
        else if (pass == 3)
        {
            target = optics.cyan;
            camera = cyanEye;
            turned = cyanTurn;
            sight.clipPoint = PanelPosition(arena.level, fold.a);
            sight.clipNormal = PanelNormal(arena.level, fold.a);
            pixels = window;
        }
        else if (pass == 4)
        {
            target = optics.scene;
            camera = eye;
            turned = rotation;
            sight.clipped = false;
            sight.packed = false;
            pixels = window;
        }
        sight.eye = camera;
        if (pass < 4)
        {
            float4 seen = pass == 0 || pass == 2 ? amberSeen : cyanSeen;
            float part = pass < 2 ? .5 : 1.0;
            target.SetScreen();
            target.SetClip(Rect(seen.x * part, seen.y * part, seen.z * part, seen.w * part));
        }
        target.Clear(Color(.02, .03, .04));
        target.SetCamera(float4x4.TRS(camera, turned, float3(1)), float4x4.PerspectiveFov(75deg, Screen.width / Screen.height, .035, 120));
        if (pass == 0) optics.amberFarView = target.WorldToClip();
        if (pass == 1) optics.cyanFarView = target.WorldToClip();
        if (pass == 2) optics.amberView = target.WorldToClip();
        if (pass == 3) optics.cyanView = target.WorldToClip();
        // The room has a hole where each fold is. What moves stops at a fold's wall, and is drawn again where
        // the fold puts it, so a thing part of the way through is whole from either side.
        mut Sight room = sight;
        room.cut = true;
        mut Sight mover = sight;
        mover.moving = true;
        target.Instanced(optics.box, optics.triangles, optics.architecture, kit, Snap, Surface, room);
        target.Instanced(optics.box, optics.triangles, optics.glass, kit, Snap, Surface, sight);
        target.Instanced(optics.box, optics.triangles, optics.furnishings, kit, Snap, Surface, room);
        target.Instanced(optics.box, optics.triangles, optics.dynamic, kit, Snap, Surface, mover);
        target.Instanced(optics.ball, optics.ballTriangles, optics.balls, kit, Snap, Surface, mover);
        target.Instanced(optics.tube, optics.tubeTriangles, optics.tubes, kit, Snap, Surface, mover);
        target.Instanced(optics.box, optics.triangles, optics.echo, kit, Snap, Surface, mover);
        target.Instanced(optics.ball, optics.ballTriangles, optics.echoBalls, kit, Snap, Surface, mover);
        target.Instanced(optics.tube, optics.tubeTriangles, optics.echoTubes, kit, Snap, Surface, mover);
        target.Cull(Cull.None)
        {
            target.Instanced(optics.blade, optics.bladeTriangles, optics.leaves, kit, Sway, Surface, sight);
        }
        // The partner, and the viewer's own body where a fold's camera or the menu's can see it. Neither is
        // drawn again around the camera that looks out of the fold it's passing.
        bool own = pass < 4 || ui.open;
        if (partner.id == 0)
        {
            target.SkinnedMesh(figure, partnerPlace, partnerPose, skinA, Snap, Figure, mover);
            if (partnerAmber) target.SkinnedMesh(figure, Math.Mul(throughAmber, partnerPlace), partnerPose, skinA, Snap, Figure, mover);
            if (partnerCyan) target.SkinnedMesh(figure, Math.Mul(throughCyan, partnerPlace), partnerPose, skinA, Snap, Figure, mover);
            if (own) target.SkinnedMesh(figure, selfPlace, selfPose, skinB, Snap, Figure, mover);
            if (selfAmber && pass != 2) target.SkinnedMesh(figure, Math.Mul(throughAmber, selfPlace), selfPose, skinB, Snap, Figure, mover);
            if (selfCyan && pass != 3) target.SkinnedMesh(figure, Math.Mul(throughCyan, selfPlace), selfPose, skinB, Snap, Figure, mover);
        }
        else
        {
            target.SkinnedMesh(figure, partnerPlace, partnerPose, skinB, Snap, Figure, mover);
            if (partnerAmber) target.SkinnedMesh(figure, Math.Mul(throughAmber, partnerPlace), partnerPose, skinB, Snap, Figure, mover);
            if (partnerCyan) target.SkinnedMesh(figure, Math.Mul(throughCyan, partnerPlace), partnerPose, skinB, Snap, Figure, mover);
            if (own) target.SkinnedMesh(figure, selfPlace, selfPose, skinA, Snap, Figure, mover);
            if (selfAmber && pass != 2) target.SkinnedMesh(figure, Math.Mul(throughAmber, selfPlace), selfPose, skinA, Snap, Figure, mover);
            if (selfCyan && pass != 3) target.SkinnedMesh(figure, Math.Mul(throughCyan, selfPlace), selfPose, skinA, Snap, Figure, mover);
        }
        if (watched) target.SkinnedMesh(figure, watcherPlace, watcherPose, skinWatcher, Snap, Figure, sight);
        if (pass == 4) held = sight;

        for (int opening = 0; opening < 2; opening++)
        {
            int panel = opening == 0 ? fold.a : fold.b;
            float3 normal = PanelNormal(arena.level, panel);
            // The sheet a fold is seen on is set back into its wall, behind the hole, and is much bigger than
            // the opening: the eye comes right up to the wall's face, and through it, without reaching the sheet.
            float3 p = PanelPosition(arena.level, panel) - normal * FOLD_DEEP - float3(0, FOLD_DROP, 0);
            quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
            mut Aperture aperture = Aperture { rim = opening == 0 ? amberRim : cyanRim, pixels = pixels, eye = camera, clipPoint = sight.clipPoint, clipNormal = sight.clipNormal,
                                               clipped = sight.clipped, packed = sight.packed, phase = sight.phase, cyan = opening == 1, lamps = lamps,
                                               wall = PanelPosition(arena.level, panel), face = normal, right = PanelRight(arena.level, panel) };
            if (pass == 4)
            {
                aperture.farEye = opening == 0 ? amberEye : cyanEye;
                aperture.fromClip = Math.Inverse(opening == 0 ? optics.amberView : optics.cyanView);
            }
            else if (pass >= 2)
            {
                aperture.farEye = opening == 0 ? PortalMapPoint(arena.level, fold.a, fold.b, amberEye) : PortalMapPoint(arena.level, fold.b, fold.a, cyanEye);
                aperture.fromClip = Math.Inverse(opening == 0 ? optics.amberFarView : optics.cyanFarView);
            }
            float4x4 transform = float4x4.TRS(p, r, float3(5, 4.4, 1));
            if (pass < 2) target.Mesh(optics.card, optics.cardTriangles, transform, LastFold, aperture);
            else if (pass < 4)
            {
                if (opening == 0) target.Mesh(optics.card, optics.cardTriangles, transform, optics.amberDeep.color, ThroughFar, aperture);
                else target.Mesh(optics.card, optics.cardTriangles, transform, optics.cyanDeep.color, ThroughFar, aperture);
            }
            else
            {
                if (opening == 0) target.Mesh(optics.card, optics.cardTriangles, transform, optics.amber.color, ThroughAir, aperture);
                else target.Mesh(optics.card, optics.cardTriangles, transform, optics.cyan.color, ThroughAir, aperture);
            }
        }
        target.Depth(Depth.Read), target.Blend(Blend.Add)
        {
            for (int opening = 0; opening < 2; opening++)
            {
                int panel = opening == 0 ? fold.a : fold.b;
                float3 normal = PanelNormal(arena.level, panel);
                quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
                Aperture aperture = Aperture { rim = opening == 0 ? amberRim : cyanRim, pixels = pixels, eye = camera, clipPoint = sight.clipPoint, clipNormal = sight.clipNormal,
                                               clipped = sight.clipped, packed = sight.packed, phase = sight.phase,
                                               wall = PanelPosition(arena.level, panel), face = normal, right = PanelRight(arena.level, panel) };
                target.Mesh(optics.card, optics.cardTriangles, float4x4.TRS(PanelPosition(arena.level, panel) + normal * .052 - float3(0, FOLD_DROP, 0), r,
                                                                            float3(FOLD_WIDE * 4.4, FOLD_HIGH * 3.2, 1)), Halo, aperture);
            }
            if (pass >= 2) target.Instanced(optics.box, optics.triangles, optics.motes, Mote, sight);
        }
    }

    // The air's glow, what spills from the brightest things, then the picture.
    // The air is lit by the room's depth, before depth is set back for what's in the hand.
    lens.pixel = float2(1 / Screen.width, 1 / Screen.height);
    lens.phase = optics.phase;
    Draw.Blit(optics.scene.color, lens.air, Shafts, Ray { fromClip = Math.Inverse(optics.scene.WorldToClip()), eye = eye, lamps = lamps });
    if (!ui.open)
    {
        held.held = true;
        optics.scene.ClearDepth();
        optics.scene.Instanced(optics.box, optics.triangles, optics.device, kit, Snap, Surface, held);
        optics.scene.Instanced(optics.ball, optics.ballTriangles, optics.deviceBalls, kit, Snap, Surface, held);
        optics.scene.Instanced(optics.tube, optics.tubeTriangles, optics.deviceTubes, kit, Snap, Surface, held);
    }
    Draw.Blit(optics.scene.color, lens.half, Bright);
    Draw.Blit(lens.half.color, lens.quarter, Halve);
    Draw.Blit(lens.quarter.color, lens.quarterTurn, Blur, BlurStep { along = float2(lens.pixel.x * 4, 0) });
    Draw.Blit(lens.quarterTurn.color, lens.quarter, Blur, BlurStep { along = float2(0, lens.pixel.y * 4) });
    Draw.Blit(lens.quarter.color, lens.eighth, Halve);
    Draw.Blit(lens.eighth.color, lens.eighthTurn, Blur, BlurStep { along = float2(lens.pixel.x * 8, 0) });
    Draw.Blit(lens.eighthTurn.color, lens.eighth, Blur, BlurStep { along = float2(0, lens.pixel.y * 8) });
    Draw.Blit(lens.eighth.color, lens.sixteenth, Halve);
    Draw.Blit(lens.sixteenth.color, lens.sixteenthTurn, Blur, BlurStep { along = float2(lens.pixel.x * 16, 0) });
    Draw.Blit(lens.sixteenthTurn.color, lens.sixteenth, Blur, BlurStep { along = float2(0, lens.pixel.y * 16) });
    lens.shafts = lens.air.color;
    lens.near = lens.quarter.color;
    lens.mid = lens.eighth.color;
    lens.wide = lens.sixteenth.color;
    Draw.Blit(optics.scene.color, Draw.window, Develop);
}
