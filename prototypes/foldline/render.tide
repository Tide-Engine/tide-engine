// FOLDLINE's renderer. Everything here is this machine's: rooms built of
// boxes and painted from a small sheet of texels, lamps with shadows, light
// kept as light until the last blit, the fold cameras, and a last pass that
// shows it all as an old console would. None of it reaches the match.

// The operators' model, its clips and their two skins, and the sheet every
// surface is painted from: sixteen 64-texel squares. The model, the clips,
// the skins and twelve of the squares are Kenney's (kenney.nl, CC0).
asset SkinnedMesh<StoneVertex> figure = "art/character.fbx";
asset AnimationCatalog moves = ["art/idle.fbx", "art/run.fbx", "art/jump.fbx"];
[Filter(Filter.Point)] asset Texture skinA = "art/operator-a.png";
[Filter(Filter.Point)] asset Texture skinB = "art/operator-b.png";
[Filter(Filter.Point)] asset Texture skinWatcher = "art/watcher.png";
[Filter(Filter.Point)] asset Texture kit = "art/kit.png";
struct StoneVertex
{
    float3 position;
    float3 normal;
    float2 uv;
}

// One drawn piece. `size` is its extent in meters, which rounds its edges
// and keeps its normals right however it's stretched.
struct Fixture
{
    float4x4 transform;
    Color tint;
    float3 size;
    float tiles;      // Panel seams a meter, 0 for none
    float luminous;   // Its own light: 1 glows, more glows harder
    float gloss;      // 0 chalk, 1 polished
    float crop;       // For a square painted by its faces: 0 all of it, 1 its left half, 2 its right half
    float kind;       // 0 solid, 1 leaf, 2 a ceiling lamp, -1 the red of a pit
    float cell = -1;  // Which square of the sheet it's painted with: its tint alone, under 0
}

struct Sight
{
    float3 eye;
    float3 clipPoint;
    float3 clipNormal;
    bool clipped;
    bool packed;
    float3 cube;
    float3 partner;
    float3 self;
    float3[4] foldAt;   // Each end's lamp, a little before its wall
    float3[4] foldFace; // Which way each end's wall faces
    float[4] foldSize;  // How big each end's opening is
    float[4] foldOn;    // 1 for an end whose fold is whole
    float3 plateA;
    float3 plateB;
    float2 plates;
    float phase;
    bool held;        // The piece is in the viewer's hand: lit as the eye is
    float2 grid;      // Half the picture's pixels each way: corners land on them
    float4 dim;       // A part of the place whose lamps are another's to switch: from x to x, from z to z
    float dimmed = 1; // ...and how much of their light there is
    float3 torchAt;   // Each operator's torch: where it is and which way it points
    float3 torchWay;
    float3 otherAt;
    float3 otherWay;
    float lamps;      // How much of the ceiling's light there is: none for the moment a watcher comes or goes
    bool cut;         // The piece is the room's: a fold opens a hole in it
    float fold;       // The piece is part of the way through an end: one more than which, and it stops at that wall's face
    bool echoed;      // ...and this is the part of it at the fold's other end, lit as the part it left behind is:
    float4x4 back;    // through this, the fold undone, so that no seam of light crosses the thing
}

struct Aperture
{
    Color rim;
    float2 pixels;
    float3 eye;
    float3 clipPoint;
    float3 clipNormal;
    bool clipped;
    bool packed;
    float phase;
    float lamps;
    float size = 1;   // How big the opening is, and how many times bigger what's past it is
    float ratio = 1;
    float3 wall;      // The middle of the fold's panel, which way it faces and its right
    float3 face;
    float3 right;
    // What the fold's own camera needs to light the air it looks through:
    // where it is, its clip space undone, and which fold's depth it reads
    float4x4 fromClip;
    float3 farEye;
    int end;
}

struct Ray
{
    float4x4 fromClip;
    float3 eye;
    float lamps;
}

struct BlurStep
{
    float2 along;
}

local singleton Optics
{
    RenderTarget scene;
    // What's seen through each end, and through it again
    RenderTarget first0;
    RenderTarget first1;
    RenderTarget first2;
    RenderTarget first3;
    RenderTarget deep0;
    RenderTarget deep1;
    RenderTarget deep2;
    RenderTarget deep3;
    // What an end's camera sees through each end of the other fold: 2 an end, the camera's end first
    RenderTarget cross0;
    RenderTarget cross1;
    RenderTarget cross2;
    RenderTarget cross3;
    RenderTarget cross4;
    RenderTarget cross5;
    RenderTarget cross6;
    RenderTarget cross7;
    List<StoneVertex> box;
    List<int> triangles;
    List<StoneVertex> ball;
    List<int> ballTriangles;
    List<StoneVertex> tube;
    List<int> tubeTriangles;
    List<StoneVertex> blade;
    List<int> bladeTriangles;
    List<Vertex3> card;
    List<int> cardTriangles;
    List<Fixture> architecture;
    List<Fixture> glass;
    List<Fixture> leaves;
    List<Fixture> furnishings;
    List<Fixture> dynamic;
    // The cube's pieces, and the same again at a fold's other end while it's part of the way through one
    // The loose things: the one that's part of the way through a fold, that one again at the fold's other end,
    // and all the rest
    List<Fixture> cubeParts;
    List<Fixture> cubeEcho;
    List<Fixture> cubeRest;
    List<Fixture> device;
    List<Fixture> deviceBalls;
    List<Fixture> deviceTubes;
    List<Fixture> motes;
    float4x4[4] views;
    float4x4[4] farViews;
    int dressed = -1;
    int warmed;       // How many frames have been drawn with made-up folds, to have everything ready
    bool made;
    float phase;
    float clock;
    float stride;
    float fired;
    float3[4] lastAt;
    // Splashes: where, how long each has left, and how big; the newest's number, for the ear
    float3[6] splashAt;
    float[6] splashLeft;
    float[6] splashBig;
    float[8] wasHigh;
    int splashed;
    int walls = -1;
}

// What the sun sees, and what each fold's light sees: how far, along each
// pixel of its image.
local singleton Daylight
{
    RenderTarget map;
    DepthTexture depth;
    float4x4 toSun;
    RenderTarget fold0;
    RenderTarget fold1;
    RenderTarget fold2;
    RenderTarget fold3;
    DepthTexture foldDepth0;
    DepthTexture foldDepth1;
    DepthTexture foldDepth2;
    DepthTexture foldDepth3;
    float4x4[4] toFold;
    bool made;
}

// The frame's light on its way to the window.
local singleton Lens
{
    RenderTarget air;
    RenderTarget half;
    RenderTarget quarter;
    RenderTarget quarterTurn;
    RenderTarget eighth;
    RenderTarget eighthTurn;
    RenderTarget sixteenth;
    RenderTarget sixteenthTurn;
    DepthTexture sceneDepth;
    DepthTexture depth0;
    DepthTexture depth1;
    DepthTexture depth2;
    DepthTexture depth3;
    DepthTexture far0;
    DepthTexture far1;
    DepthTexture far2;
    DepthTexture far3;
    Texture shafts;
    Texture near;
    Texture mid;
    Texture wide;
    float2 pixel;
    float phase;
    float scare;      // A watcher has this machine's operator: 1 as it lands, fading
    float under;      // The hands in a pit have it: 0 to 1 as the picture goes out
    float sunk;       // The eye is under a pit's red: 1, or 0
    float3 murk = float3(0.16, 0.006, 0.005); // ...and what it's seen through
    float3 grade = float3(1, 1, 1);           // The place's cast over the whole picture
    RenderTarget reach; // How far off each pixel of the room is, in meters, for the red's fog
    Texture far;
    float lines = 300; // The picture's rows: LINES
    bool made;
}

const int SUN_PIXELS = 2048;
const float SUN_WIDE = 28;
const float SUN_LONG = 56;
const float STOREY = 5;      // A storey's height: each has its lamps CEILING over its floor
const float CEILING = 4.4;   // Where the lamps are
const float LINES = 300;     // The picture's rows, whatever the window's are
const float RENDER = 0.5;    // How much of the window's pixels the room is drawn at: the picture has fewer still
const float SUN_SOFT = 1.1 / SUN_PIXELS;
const int FOLD_PIXELS = 768;
// A fold's opening: half as wide and half as high as this, its middle this far under its panel's, its corners
// rounded by this much. `PortalAperture` in play.tide lets through what fits it.
const float FOLD_WIDE = 0.68;
const float FOLD_HIGH = 1.3;
const float FOLD_DROP = 0;
const float FOLD_ROUND = 0.6;
const float FOLD_DEEP = 0.3;
const float FOLD_SOFT = 1.2 / FOLD_PIXELS;
const float FIGURE_SCALE = 0.45;

// Shadows fall straight down from the ceiling's lamps.
float3 SunWay()
{
    return float3(0, 1, 0);
}

float3 LampTint()
{
    return float3(1.0, 0.95, 0.70);
}

float3 Rgb(Color c)
{
    return float3(c.r, c.g, c.b);
}

// A portal camera's image holds light folded into bytes; these fold and unfold it.
float3 Fold3(float3 light)
{
    float3 c = light / (float3(1) + light);
    return float3(Math.Sqrt(c.x), Math.Sqrt(c.y), Math.Sqrt(c.z));
}

float3 Unfold3(Color stored)
{
    float3 c = Math.Min(Rgb(stored) * Rgb(stored), float3(0.985));
    return c / (float3(1) - c);
}

Color Shown(float3 light, bool packed)
{
    float3 c = packed ? Fold3(light) : light;
    return Color(c.x, c.y, c.z, 1);
}

// Where a place is in the lamps' image, stepped off its surface so that a
// slanted wall isn't in its own shadow.
float3 FromSun(float3 world, float3 normal, float4x4 toSun)
{
    float facing = Math.Dot(normal, SunWay());
    float slant = Math.Sqrt(Math.Saturate(1 - facing * facing));
    float step = SUN_LONG / SUN_PIXELS;
    float4 clip = Math.Mul(toSun, float4(world + normal * (step * (0.9 + 2.2 * slant)), 1));
    if (Math.Max(Math.Abs(clip.x), Math.Abs(clip.y)) > 1) return float3(0.5, 0.5, 0);
    return float3(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5, clip.z * 0.5 + 0.5);
}

float Sunlight(DepthTexture depth, float3 world, float3 normal, float4x4 toSun)
{
    float3 seen = FromSun(world, normal, toSun);
    return (depth.Compare(seen.xy + float2(-SUN_SOFT, -SUN_SOFT), seen.z) + depth.Compare(seen.xy + float2(SUN_SOFT, -SUN_SOFT), seen.z)
          + depth.Compare(seen.xy + float2(-SUN_SOFT, SUN_SOFT), seen.z) + depth.Compare(seen.xy + float2(SUN_SOFT, SUN_SOFT), seen.z)) * 0.25;
}

float SunThrough(DepthTexture depth, float3 world, float4x4 toSun)
{
    float4 clip = Math.Mul(toSun, float4(world, 1));
    return depth.Compare(float2(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5), clip.z * 0.5 + 0.5);
}

// The ceiling has a lamp every 5 meters across the room and every 3.25 along
// it. Which is which: its column and its row.
// Where the lamps over a place are: under the roof of the storey it's in.
float LampPlane(float y)
{
    return Math.Floor(Math.Max(y + 0.3, 0) / STOREY) * STOREY + CEILING;
}

int2 LampCell(float2 over)
{
    return int2(int(Math.Floor(over.x / 5 + 2)), int(Math.Floor((over.y + 13) / 3.25)));
}

float2 LampMiddle(int2 cell)
{
    return float2((cell.x - 1.5) * 5, -13 + (cell.y + 0.5) * 3.25);
}

// How brightly a lamp burns: some are dead, one in nine stutters, the rest hum.
float LampOn(int2 cell, float phase)
{
    int roll = Math.Abs(Math.Hash(cell)) % 9;
    if (roll < 2) return 0;
    if (roll == 2) return Math.Step(0.2, Math.Sin(phase * 31 + cell.x) * Math.Sin(phase * 7 + cell.y) + 0.5) * 0.9;
    return 1;
}

// The light of the lamps about a place on a surface that faces `normal`: each
// is a small bright sheet that shines mostly down, so the floor has a pool
// under each, and a wall its arc, dark towards the ceiling.
float Lamps(float3 at, float3 normal, float phase)
{
    int2 home = LampCell(at.xz);
    mut float sum = 0;
    for (int row = -1; row <= 1; row++)
    {
        for (int column = -1; column <= 1; column++)
        {
            int2 cell = int2(home.x + column, home.y + row);
            float on = LampOn(cell, phase);
            if (on <= 0) continue;
            float2 middle = LampMiddle(cell);
            float3 to = float3(middle.x, LampPlane(at.y), middle.y) - at;
            float far = Math.Dot(to, to);
            float3 along = to / Math.Sqrt(far + 0.0001);
            float down = Math.Max(along.y, 0);
            // A tight beam under it, and a quarter as much all around
            mut float tight = down * down * down * down;
            tight *= tight;
            tight *= tight;
            sum += on * Math.Saturate(Math.Dot(normal, along)) * (0.75 * tight + 0.25 * down * down * down) / (far + 0.6);
        }
    }
    return sum * 36;
}

// A lamp's pool: how much of its light leaves the ceiling at a place, the
// lamp's own shape close under it and softer the further down it's seen from.
float LampPool(float2 over, float soft, float phase)
{
    int2 cell = LampCell(over);
    float2 from = Math.Abs(over - LampMiddle(cell)) - float2(0.6, 0.3);
    float edge = Math.Max(from.x, from.y);
    return (1 - Math.SmoothStep(-soft * 0.3, soft, edge)) * LampOn(cell, phase);
}

// What a lamp gives the whole of its bay, bounced about: most under it, none where the next bay starts.
float LampWide(float2 over, float phase)
{
    int2 cell = LampCell(over);
    float2 from = (over - LampMiddle(cell)) / float2(5, 3.25);
    return (0.5 + 0.5 * Math.Cos(from.x * Math.TAU)) * (0.5 + 0.5 * Math.Cos(from.y * Math.TAU)) * LampOn(cell, phase);
}

// The lamps' light at a place in the air, with what stands over it in the way.
float LampAir(DepthTexture depth, float4x4 toSun, float3 at, float phase)
{
    float up = Math.Max(LampPlane(at.y) - at.y, 0);
    float3 way = SunWay();
    return LampPool(at.xz + way.xz * (up / way.y), 0.05 + up * 0.26, phase) * SunThrough(depth, at, toSun) / (1 + up * 0.35);
}

// A torch's light on a surface: a cone that fades with its reach.
float3 Torch(float3 at, float3 normal, float3 from, float3 way)
{
    float3 to = at - from;
    float far = Math.Dot(to, to);
    float3 along = to / Math.Sqrt(far + 0.0001);
    float cone = Math.SmoothStep(0.84, 0.97, Math.Dot(along, way));
    // Dim on what's held up before it, so a carried cube isn't a white glare
    float reach = Math.SmoothStep(0.6, 3.5, Math.Sqrt(far));
    return float3(1.0, 0.93, 0.78) * (cone * Math.Saturate(-Math.Dot(normal, along) * 0.8 + 0.2) * (0.5 + 2.7 * reach) / (1 + far * 0.1));
}

// How much of a fold's light gets to a place: its lamp looks out of the wall
// through a wide camera, and what's beside or behind that view is lit.
float FoldLight(DepthTexture depth, float4x4 toFold, float3 world, float3 normal)
{
    float4 clip = Math.Mul(toFold, float4(world + normal * 0.07, 1));
    if (clip.w < 0.05) return 1;
    float3 at = clip.xyz / clip.w;
    if (Math.Max(Math.Abs(at.x), Math.Abs(at.y)) > 0.98) return 1;
    float2 uv = float2(at.x * 0.5 + 0.5, 0.5 - at.y * 0.5);
    float far = at.z * 0.5 + 0.5 - 0.0015;
    return (depth.Compare(uv + float2(-FOLD_SOFT, -FOLD_SOFT), far) + depth.Compare(uv + float2(FOLD_SOFT, -FOLD_SOFT), far)
          + depth.Compare(uv + float2(-FOLD_SOFT, FOLD_SOFT), far) + depth.Compare(uv + float2(FOLD_SOFT, FOLD_SOFT), far)) * 0.25;
}

// The lamps' light the air throws towards the eye along a stretch of a ray.
float3 Scatter(DepthTexture depth, float4x4 toSun, float3 from, float3 way, float reach, float2 pixel, float phase)
{
    float jitter = Math.Frac(52.9829189 * Math.Frac(Math.Dot(pixel, float2(0.06711056, 0.00583715))));
    mut float lit = 0;
    for (int i = 0; i < 20; i++)
        lit += LampAir(depth, toSun, from + way * (reach * (i + jitter) / 20), phase);
    return LampTint() * (lit / 20 * reach * 0.02);
}

// Where a pixel of a camera's image is in the world, from its depth there.
float3 Unprojected(float4x4 fromClip, float2 uv, float depth)
{
    float4 at = Math.Mul(fromClip, float4(uv.x * 2 - 1, 1 - uv.y * 2, depth * 2 - 1, 1));
    return at.xyz / at.w;
}

float3 Glow(float3 at, float3 normal, float3 from, float3 tint, float reach)
{
    float3 to = from - at;
    float far = Math.Dot(to, to);
    float fall = Math.Saturate(1 - far / (reach * reach));
    float facing = Math.Saturate(Math.Dot(normal, to) / Math.Sqrt(far + 0.0001) * 0.7 + 0.3);
    return tint * (fall * fall * facing / (1 + far * 0.45));
}

// How much of a lamp's light gets past a ball on its way to a place: none
// through its middle, all of it past its edge. A ball the lamp is under or
// inside stops nothing: a plate's light comes from around what weighs it.
float Past(float3 from, float3 to, float3 middle, float radius)
{
    if (Math.DistanceSq(middle.xz, from.xz) < 0.6 && Math.Abs(middle.y - from.y) < 1.3) return 1;
    float3 along = to - from;
    float nearest = Math.Saturate(Math.Dot(middle - from, along) / Math.Max(Math.Dot(along, along), 0.0001));
    return Math.SmoothStep(radius * 0.7, radius * 1.3, Math.Distance(from + along * nearest, middle));
}

// ...past an operator, who is three of them: legs, shell and head.
float PastOperator(float3 from, float3 to, float3 feet)
{
    return Past(from, to, feet + float3(0, 0.33, 0), 0.2) * Past(from, to, feet + float3(0, 0.86, 0), 0.3) * Past(from, to, feet + float3(0, 1.42, 0), 0.22);
}

// ...and past everything that moves: both operators, and the cube for a lamp that isn't the cube's own.
float Unblocked(float3 from, float3 to, Sight sight, bool cube)
{
    float past = PastOperator(from, to, sight.partner) * PastOperator(from, to, sight.self);
    return cube ? past * Past(from, to, sight.cube, 0.46) : past;
}

// A square of the sheet, at a place on it that repeats: its texel, as light.
float3 Texel(Texture sheet, float cell, float2 uv)
{
    float2 within = Math.Clamp(Math.Frac(uv), float2(0.01), float2(0.99));
    float row = Math.Floor(cell / 4);
    Color seen = sheet.Sample((float2(cell - row * 4, row) + within) * 0.25, Filter.Point, Wrap.Clamp);
    return Rgb(seen) * Rgb(seen);
}

// Each end's light: amber and cyan are operator A's, rose and violet operator B's.
float3 FoldLamp(int end)
{
    if (end == 0) return float3(1.0, 0.50, 0.13);
    if (end == 1) return float3(0.10, 0.82, 0.90);
    if (end == 2) return float3(1.0, 0.16, 0.42);
    return float3(0.46, 0.22, 1.0);
}

Color FoldTint(int end)
{
    return end == 0 ? Color(1, .64, .24) : end == 1 ? Color(.2, .96, .88) : end == 2 ? Color(1, .3, .55) : Color(.62, .4, 1);
}

// Whether a place of the room is in any whole fold's opening.
bool InAnyFold(float3 p, Sight sight)
{
    for (int end = 0; end < 4; end++)
        if (sight.foldOn[end] > 0.5 && InFold(p, sight.foldAt[end] - sight.foldFace[end] * 0.55, sight.foldFace[end], sight.foldSize[end])) return true;
    return false;
}

// Whether a place is past the face of the end a thing is part of the way through.
bool PastItsFold(float3 p, Sight sight)
{
    if (sight.fold < 0.5) return false;
    int end = int(sight.fold) - 1;
    return PastFold(p, sight.foldAt[end] - sight.foldFace[end] * 0.55, sight.foldFace[end]);
}

// A surface's paint in every light there is: the dark, the ceiling's lamps
// with their shadows, what they throw about their bay and up the walls, the
// folds', the plates', the cube's and the exit's, and both operators' torches.
float3 Lit(float3 paint, float3 place, float3 normal, float shade, float gloss, bool leaf, Sight sight, DepthTexture sun, float4x4 toSun,
           DepthTexture fold0, DepthTexture fold1, DepthTexture fold2, DepthTexture fold3, float4x4[4] toFold)
{
    float3 p = sight.echoed ? Math.Mul(sight.back, float4(place, 1)).xyz : place;
    float3 n = sight.echoed ? Math.Mul(sight.back, float4(normal, 0)).xyz : normal;
    // A fold's own glow is faint on what's passing through it, which is lit from one side and then the other
    float mouth = sight.fold > 0.5 ? 0.3 : 1.0;
    float3 sunWay = SunWay();
    // What's in the viewer's hand is lit where the viewer stands, so a wall it reaches into doesn't darken it.
    float3 at = sight.held ? sight.eye : p;
    float up = Math.Max(LampPlane(at.y) - at.y, 0);
    float2 over = at.xz + sunWay.xz * (up / sunWay.y);
    mut float facing = Math.Dot(n, sunWay);
    mut float shadow = 0;
    if (leaf)
    {
        shadow = SunThrough(sun, p + sunWay * 0.06, toSun);
        facing = Math.Abs(facing) * 0.6 + 0.4;
    }
    else if (sight.held) shadow = SunThrough(sun, at, toSun);
    else if (facing > 0.02) shadow = Sunlight(sun, p, n, toSun);
    facing = Math.Max(facing, 0);

    mut float3 lamp = LampTint() * sight.lamps;
    if (at.x > sight.dim.x && at.x < sight.dim.y && at.z > sight.dim.z && at.z < sight.dim.w) lamp *= sight.dimmed;
    mut float3 light = float3(0.030, 0.032, 0.028) * shade;
    // What's under something is in its shadow; a wall is lit whatever stands before it
    float under = Math.Lerp(1, shadow, Math.Saturate(n.y * 2));
    light += lamp * (Lamps(at, leaf ? float3(0, 1, 0) : n, sight.phase) * (leaf ? 0.7 * shadow : under));
    light += lamp * (LampWide(at.xz, sight.phase) * 0.13 * shade);

    // Each fold's light is stopped by what stands in its way.
    for (int end = 0; end < 4; end++)
    {
        if (sight.foldOn[end] < 0.5 || Math.DistanceSq(p, sight.foldAt[end]) > 42) continue;
        mut float reaches = 1;
        if (!sight.held)
        {
            if (end == 0) reaches = FoldLight(fold0, toFold[0], p, n);
            else if (end == 1) reaches = FoldLight(fold1, toFold[1], p, n);
            else if (end == 2) reaches = FoldLight(fold2, toFold[2], p, n);
            else reaches = FoldLight(fold3, toFold[3], p, n);
        }
        light += Glow(p, n, sight.foldAt[end], FoldLamp(end) * 2.0 * mouth, 6.5) * reaches;
    }
    // The smaller lamps are stopped by what moves: the cube and both operators. A little off the surface,
    // so that a thing isn't in its own way.
    float3 lifted = p + n * 0.2;
    float3 cubeLamp = sight.cube + float3(0, 0.25, 0);
    if (sight.plates.x > 0 && Math.DistanceSq(p, sight.plateA) < 16)
        light += Glow(p, n, sight.plateA, float3(1.0, 0.50, 0.13) * 2.4, 4) * (sight.held ? 1.0 : Unblocked(sight.plateA, lifted, sight, true));
    if (sight.plates.y > 0 && Math.DistanceSq(p, sight.plateB) < 16)
        light += Glow(p, n, sight.plateB, float3(0.10, 0.82, 0.90) * 2.4, 4) * (sight.held ? 1.0 : Unblocked(sight.plateB, lifted, sight, true));
    if (Math.DistanceSq(p, cubeLamp) < 5.8)
        light += Glow(p, n, cubeLamp, float3(0.2, 0.78, 0.72) * 0.7, 2.4) * (sight.held ? 1.0 : Unblocked(cubeLamp, lifted, sight, false));
    if (p.z > 9)
        light += Glow(p, n, float3(0, 3.2, 16.6), float3(0.25, 1.0, 0.45) * 2.6, 10) * (sight.held ? 1.0 : Unblocked(float3(0, 3.2, 16.6), lifted, sight, true));
    if (!sight.held)
        light += Torch(p, n, sight.torchAt, sight.torchWay) + Torch(p, n, sight.otherAt, sight.otherWay);

    float3 view = Math.Normalize(sight.eye - p);
    float shine = Math.Pow(Math.Max(Math.Dot(n, Math.Normalize(sunWay + view)), 0), 28) * gloss * LampPool(over, 0.06 + up * 0.2, sight.phase) * shadow;
    return paint * light + lamp * shine;
}

// Every solid thing: walls, floor and ceiling, machinery, leaves and the ceiling's lamps.
frag Surface(StoneVertex vertex, Texture sheet, Instance instance, Fixture fixture, Sight sight, Daylight day, out Color color)
{
    // A fold's camera sees nothing behind the wall it looks out of, and nothing within 2.5 cm before it, but for
    // what's part of the way through that fold, which it sees right up to the wall's face: no slice of it is lost
    if (sight.clipped && Math.Dot(this.world - sight.clipPoint, sight.clipNormal) < (sight.fold > 0.5 ? 0.0 : 0.025))
        this.Discard();

    float3 p = this.world;
    if (sight.cut && InAnyFold(p, sight)) this.Discard();
    if (PastItsFold(p, sight)) this.Discard();
    float far = Math.Distance(sight.eye, p);

    if (fixture.kind > 1.5)
    {
        // A lamp: its tube's light where it burns, a grey sheet where it's dead.
        mut float on = LampOn(LampCell(p.xz), sight.phase) * sight.lamps;
        if (p.x > sight.dim.x && p.x < sight.dim.y && p.z > sight.dim.z && p.z < sight.dim.w) on *= sight.dimmed;
        float3 tube = Math.Lerp(float3(0.05, 0.05, 0.045), LampTint() * 3.4, on);
        color = Shown(tube, sight.packed);
        return;
    }

    float3 flat = instance.Normal(vertex.normal);
    if (fixture.kind < -0.5)
    {
        // The red of a pit: thick, slow, clotted, with a skin the lamps show in. From under, a dim red roof.
        float2 drift = float2(Math.Cos(sight.phase), Math.Sin(sight.phase)) * 0.3;
        float2 q = p.xz * 0.5;
        float a = Math.Simplex(q + drift);
        float b = Math.Simplex(q * 2.3 - drift * 1.6 + float2(a * 0.7, 3.1));
        float c = Math.Simplex(q * 5.3 + float2(b, a) * 0.9 + drift);
        float thick = a * 0.5 + b * 0.32 + c * 0.18;
        // Its tint is what it is: blood, or a pool's water
        float3 body = Rgb(fixture.tint) * Rgb(fixture.tint);
        mut float3 red = Math.Lerp(body * 0.24, body * 2.0, Math.SmoothStep(-0.55, 0.65, thick));
        red = Math.Lerp(red, body * 0.07, Math.SmoothStep(0.2, 0.55, c * 0.55 + b * 0.5));
        if (flat.y < 0)
        {
            mut float3 roof = red * (0.5 + Math.Saturate(thick + 0.4) * 1.3);
            roof = Math.Lerp(roof, body * 0.24, 1 - Math.Exp(-far * 0.5));
            color = Shown(roof, sight.packed);
            return;
        }
        float3 wave = Math.Normalize(float3((b + c * 0.6) * 0.16, 1, (a - c * 0.6) * 0.16));
        float3 look = Math.Normalize(p - sight.eye);
        float3 back = look - wave * (2 * Math.Dot(look, wave));
        mut float glint = 0;
        if (back.y > 0.02) glint = LampPool(p.xz + back.xz * ((LampPlane(p.y) - p.y) / back.y), 0.5, sight.phase) * sight.lamps;
        mut float graze = 1 - Math.Saturate(-Math.Dot(look, wave));
        graze = 0.05 + graze * graze * graze * 0.85;
        mut float3 wet = red * (0.25 + Lamps(p, float3(0, 1, 0), sight.phase) * sight.lamps * 1.4) + LampTint() * (glint * graze * 2.2);
        wet = Math.Lerp(wet, float3(0.030, 0.034, 0.024), 1 - Math.Exp(-far * 0.028));
        color = Shown(wet, sight.packed);
        return;
    }
    mut float3 n = flat;
    if (fixture.kind > 0.5 && Math.Dot(n, sight.eye - p) < 0) n = -n;

    mut float3 paint = Rgb(fixture.tint) * Rgb(fixture.tint);
    if (fixture.cell > -0.5)
    {
        mut float2 uv = vertex.uv;
        if (fixture.tiles > 0)
        {
            // Painted by where it is in the room, so squares meet across pieces: upright on a wall
            uv = float2(p.x, p.z) * fixture.tiles;
            if (Math.Abs(flat.x) > 0.5) uv = float2(p.z, -p.y) * fixture.tiles;
            else if (Math.Abs(flat.z) > 0.5) uv = float2(p.x, -p.y) * fixture.tiles;
        }
        else if (fixture.crop > 0.5) uv = float2((Math.Frac(uv.x) + (fixture.crop > 1.5 ? 1 : 0)) * 0.5 * 0.98 + 0.005, uv.y);
        paint *= Texel(sheet, fixture.cell, uv) * 1.6;
    }
    if (fixture.kind > 0.5) paint *= 0.55 + vertex.uv.y * 0.75;

    // The room's creases hold less light.
    mut float shade = 1;
    float upright = 1 - Math.Abs(n.y);
    shade *= 1 - 0.4 * Math.Exp(-Math.Max(p.y, 0) * 4.5) * upright * Math.Step(-0.3, p.y);
    if (n.y > 0.7)
    {
        float underCube = Math.Exp(-Math.DistanceSq(p.xz, sight.cube.xz) * 3.4) * Math.Saturate(1.6 - (sight.cube.y - p.y)) * 0.42;
        float underPartner = Math.Exp(-Math.DistanceSq(p.xz, sight.partner.xz) * 5.5) * Math.Saturate(1.5 - (sight.partner.y - p.y)) * 0.4;
        float underSelf = Math.Exp(-Math.DistanceSq(p.xz, sight.self.xz) * 5.5) * Math.Saturate(1.5 - (sight.self.y - p.y)) * 0.4;
        shade *= 1 - underCube - underPartner - underSelf;
    }

    mut float3 lit = Lit(paint, p, n, shade, fixture.gloss, fixture.kind > 0.5, sight, day.depth, day.toSun, day.foldDepth0, day.foldDepth1,
                         day.foldDepth2, day.foldDepth3, day.toFold);
    lit = Math.Lerp(lit, paint * (0.5 + fixture.luminous * 2.3), Math.Saturate(fixture.luminous));
    lit = Math.Lerp(lit, float3(0.030, 0.034, 0.024), 1 - Math.Exp(-far * 0.028));
    color = Shown(lit, sight.packed);
}

// An operator: the model's skin in the room's light.
frag Figure(StoneVertex vertex, Texture skin, Instance instance, Sight sight, Daylight day, out Color color)
{
    if (sight.clipped && Math.Dot(this.world - sight.clipPoint, sight.clipNormal) < (sight.fold > 0.5 ? 0.0 : 0.025))
        this.Discard();
    float3 p = this.world;
    if (PastItsFold(p, sight)) this.Discard();
    Color seen = skin.Sample(vertex.uv, Filter.Point, Wrap.Clamp);
    float3 n = instance.Normal(vertex.normal);
    mut float3 lit = Lit(Rgb(seen) * Rgb(seen), p, n, 1, 0.1, false, sight, day.depth, day.toSun, day.foldDepth0, day.foldDepth1, day.foldDepth2, day.foldDepth3, day.toFold);
    lit = Math.Lerp(lit, float3(0.030, 0.034, 0.024), 1 - Math.Exp(-Math.Distance(sight.eye, p) * 0.028));
    color = Shown(lit, sight.packed);
}

// Dust that only shows where a lamp finds it.
frag Mote(StoneVertex vertex, Fixture fixture, Sight sight, Daylight day, out Color color)
{
    if (sight.clipped && Math.Dot(this.world - sight.clipPoint, sight.clipNormal) < 0.025)
        this.Discard();
    float lit = LampAir(day.depth, day.toSun, this.world, sight.phase) * sight.lamps;
    float near = Math.Saturate(Math.Distance(this.world, sight.eye) * 0.6 - 0.3);
    mut float3 c = Rgb(fixture.tint) * (lit * near * 1.2);
    if (sight.packed) c *= 0.25;
    color = Color(c.x, c.y, c.z, 1);
}

// A corner as the old console put it: on the nearest of the picture's pixels.
float4 Snapped(float4 clip, float2 grid)
{
    if (clip.w < 0.02) return clip;
    float2 at = Math.Round(clip.xy / clip.w * grid) / grid;
    return float4(at.x * clip.w, at.y * clip.w, clip.z, clip.w);
}

vert Snap(mut StoneVertex vertex, Sight sight, out float4 clip)
{
    clip = Snapped(this.clip, sight.grid);
}

// Leaves stir: each blade leans a little, more towards its tip, in its own time.
vert Sway(mut StoneVertex vertex, Fixture fixture, Sight sight, out float4 clip)
{
    float tip = vertex.uv.y * vertex.uv.y;
    float own = fixture.tint.r * 91 + fixture.tint.g * 57;
    vertex.position = vertex.position + float3(Math.Sin(sight.phase * 2 + own * 1.7) * 0.22, 0, Math.Sin(sight.phase + own) * 0.045) * tip;
    clip = sight.grid.x > 0 ? Snapped(this.clip, sight.grid) : this.clip;
}

// How far a place on a fold's wall is from the opening's edge, under 0 inside it. `at` is right and up of the
// panel's middle, in meters.
float Opening(float2 at, float size)
{
    float2 q = Math.Abs(at) - float2(FOLD_WIDE - FOLD_ROUND, FOLD_HIGH - FOLD_ROUND) * size;
    return Math.Length(Math.Max(q, 0)) + Math.Min(Math.Max(q.x, q.y), 0) - FOLD_ROUND * size;
}

// Where the eye's ray to a place crosses a fold's wall, right and up of the panel's middle.
float2 OnWall(float3 eye, float3 world, float3 wall, float3 face, float3 right)
{
    float3 way = world - eye;
    float3 on = eye + way * (Math.Dot(wall - eye, face) / Math.Min(Math.Dot(way, face), -0.00001)) - wall;
    return float2(Math.Dot(on, right), on.y);
}

// Whether a place of the room is in a fold's opening: the wall's face is cut away there.
bool InFold(float3 world, float3 wall, float3 face, float size)
{
    float3 from = world - wall;
    float depth = Math.Dot(from, face);
    if (depth > 0.12 || depth < -0.9) return false;
    float2 at = float2(Math.Dot(from, Math.Cross(float3(0, 1, 0), face)), from.y);
    // Past the face, inside the wall, nothing of the room shows anywhere behind the opening, its rounded
    // corners too: the floor that runs on under the wall would lie over the sill of what's seen through
    if (depth < -0.001) return Math.Abs(at.x) < FOLD_WIDE * size + 0.06 && Math.Abs(at.y) < FOLD_HIGH * size + 0.06;
    return Opening(at, size) < -0.002;
}

// Whether a place is past a fold's wall's face: a thing part of the way through stops there, and the rest of
// it is at the fold's other end.
bool PastFold(float3 world, float3 wall, float3 face)
{
    return Math.Dot(world - wall, face) < 0;
}

float RimFlow(float2 at, float phase)
{
    float around = Math.Atan2(at.y + FOLD_DROP, at.x);
    return Math.Simplex(float2(Math.Cos(around + phase) * 1.9, Math.Sin(around + phase) * 1.9) + at * 1.3)
         + Math.Simplex(float2(Math.Cos(around * 3 - phase * 2), Math.Sin(around * 3 - phase * 2)) * 1.3) * 0.5;
}

// A fold's edge over what's seen through it: a glow inside, a band that flows, a bright core.
float3 Rimmed(float3 seen, Color tint, float2 at, float phase, float distance, float size)
{
    float3 rim = Rgb(tint) * Rgb(tint);
    float flow = RimFlow(at, phase);
    // The opening stands on the floor: its edge has no light along its foot
    float foot = Math.SmoothStep(-FOLD_HIGH * size + 0.03, -FOLD_HIGH * size + 0.35, at.y);
    float band = Math.SmoothStep(-0.075 - flow * 0.022, -0.028, distance) * foot;
    float core = Math.SmoothStep(-0.03, -0.004, distance) * foot;
    mut float3 view = seen + rim * Math.Exp(distance * 11) * 0.55 * foot;
    view = Math.Lerp(view, rim * (1.9 + flow * 0.8), band);
    return Math.Lerp(view, rim * 3.4 + float3(0.25), core * 0.6);
}

// The sunlit air beyond a fold: from where this pixel's ray leaves the far
// opening to what the fold's camera sees there, `depth` away.
float3 Beyond(DepthTexture sun, float4x4 toSun, Aperture aperture, float depth, float3 world, float2 uv, float2 pixel)
{
    float3 to = Unprojected(aperture.fromClip, uv, depth) - aperture.farEye;
    float far = Math.Length(to);
    // To the wall's face, not to the sheet this is drawn on, which is set back behind it
    float3 way0 = world - aperture.eye;
    float near = Math.Length(way0) * (Math.Dot(aperture.wall - aperture.eye, aperture.face) / Math.Min(Math.Dot(way0, aperture.face), -0.00001)) * aperture.ratio;
    float3 way = to / Math.Max(far, 0.0001);
    return Scatter(sun, toSun, aperture.farEye + way * near, way, Math.Clamp(far - near, 0, 36), pixel, aperture.phase) * aperture.lamps;
}

// A fold as the viewer sees it, with the sunlit air beyond it.
frag ThroughAir(Vertex3 vertex, Texture image, Aperture aperture, Daylight day, Lens lens, out Color color)
{
    float2 at = OnWall(aperture.eye, this.world, aperture.wall, aperture.face, aperture.right);
    float distance = Opening(at, aperture.size);
    if (distance > 0) this.Discard();
    float2 uv = this.position / aperture.pixels;
    mut float3 view = Unfold3(image.Sample(uv, Filter.Bilinear, Wrap.Clamp));
    mut float depth = lens.depth0.Sample(uv);
    if (aperture.end == 1) depth = lens.depth1.Sample(uv);
    else if (aperture.end == 2) depth = lens.depth2.Sample(uv);
    else if (aperture.end == 3) depth = lens.depth3.Sample(uv);
    view += Beyond(day.depth, day.toSun, aperture, depth, this.world, uv, this.position);
    color = Shown(Rimmed(view, aperture.rim, at, aperture.phase, distance, aperture.size), aperture.packed);
}

// A fold seen by a fold's own camera, with the air beyond that one too. It
// reads the second crossings' depths, as ThroughAir reads the first's: a
// camera's image can't be read while it's drawn into.
frag ThroughFar(Vertex3 vertex, Texture image, Aperture aperture, Daylight day, Lens lens, out Color color)
{
    if (aperture.clipped && Math.Dot(this.world - aperture.clipPoint, aperture.clipNormal) < 0.025)
        this.Discard();
    float2 at = OnWall(aperture.eye, this.world, aperture.wall, aperture.face, aperture.right);
    float distance = Opening(at, aperture.size);
    if (distance > 0) this.Discard();
    float2 uv = this.position / aperture.pixels;
    mut float3 view = Unfold3(image.Sample(uv, Filter.Bilinear, Wrap.Clamp));
    // A look into the other fold has no air of its own
    if (aperture.end >= 0)
    {
        mut float depth = lens.far0.Sample(uv);
        if (aperture.end == 1) depth = lens.far1.Sample(uv);
        else if (aperture.end == 2) depth = lens.far2.Sample(uv);
        else if (aperture.end == 3) depth = lens.far3.Sample(uv);
        view += Beyond(day.depth, day.toSun, aperture, depth, this.world, uv, this.position);
    }
    color = Shown(Rimmed(view, aperture.rim, at, aperture.phase, distance, aperture.size), aperture.packed);
}

// The last fold a camera follows: light on a dark sheet.
frag LastFold(Vertex3 vertex, Aperture aperture, out Color color)
{
    if (aperture.clipped && Math.Dot(this.world - aperture.clipPoint, aperture.clipNormal) < 0.025)
        this.Discard();
    float2 at = OnWall(aperture.eye, this.world, aperture.wall, aperture.face, aperture.right);
    float distance = Opening(at, aperture.size);
    if (distance > 0) this.Discard();
    float3 rim = Rgb(aperture.rim) * Rgb(aperture.rim);
    float flow = RimFlow(at, aperture.phase);
    float band = Math.SmoothStep(-0.09, -0.03, distance);
    mut float3 view = float3(0.012, 0.03, 0.04) + rim * (0.06 + 0.05 * flow) * Math.Exp(distance * 3);
    view = Math.Lerp(view, rim * 3.4, band);
    color = Shown(view, aperture.packed);
}

// A fold's light spilling onto the wall around it.
frag Halo(Vertex3 vertex, Aperture aperture, out Color color)
{
    if (aperture.clipped && Math.Dot(this.world - aperture.clipPoint, aperture.clipNormal) < 0.025)
        this.Discard();
    float2 at = float2(Math.Dot(this.world - aperture.wall, aperture.right), this.world.y - aperture.wall.y);
    float distance = Opening(at, aperture.size);
    if (distance < 0) this.Discard();
    float3 rim = Rgb(aperture.rim) * Rgb(aperture.rim);
    float flow = RimFlow(at, aperture.phase);
    mut float3 c = rim * (Math.Exp(-distance * 10) * (1.0 + flow * 0.4) + Math.Exp(-distance * 2.6) * 0.2);
    c *= Math.Saturate(1.1 - distance * 1.6);
    if (aperture.packed) c *= 0.3;
    color = Color(c.x, c.y, c.z, 1);
}

// The sun's light caught by the air between the eye and what it sees.
frag Shafts(Vertex vertex, Texture source, Ray ray, Daylight day, Lens lens, out Color color)
{
    float3 to = Unprojected(ray.fromClip, vertex.uv, lens.sceneDepth.Sample(vertex.uv)) - ray.eye;
    float far = Math.Length(to);
    float3 lit = Scatter(day.depth, day.toSun, ray.eye, to / Math.Max(far, 0.0001), Math.Min(far, 36), this.position, lens.phase) * ray.lamps;
    color = Color(lit.x, lit.y, lit.z, 1);
}

// How far off the room is at each pixel, in meters.
frag HowFar(Vertex vertex, Texture source, Ray ray, Lens lens, out Color color)
{
    float far = Math.Length(Unprojected(ray.fromClip, vertex.uv, lens.sceneDepth.Sample(vertex.uv)) - ray.eye);
    color = Color(far, far, far, 1);
}

// What's bright enough to spill, at half the window's size.
frag Bright(Vertex vertex, Texture source, Lens lens, out Color color)
{
    float2 step = lens.pixel;
    float3 sum = Rgb(source.Sample(vertex.uv + float2(-step.x, -step.y), Filter.Bilinear, Wrap.Clamp))
               + Rgb(source.Sample(vertex.uv + float2(step.x, -step.y), Filter.Bilinear, Wrap.Clamp))
               + Rgb(source.Sample(vertex.uv + float2(-step.x, step.y), Filter.Bilinear, Wrap.Clamp))
               + Rgb(source.Sample(vertex.uv + float2(step.x, step.y), Filter.Bilinear, Wrap.Clamp));
    mut float3 seen = Math.Min(sum * 0.25, float3(9));
    float light = Math.Max(seen.x, Math.Max(seen.y, seen.z));
    float kept = Math.Saturate((light - 1.05) / 1.6);
    seen *= kept * kept;
    color = Color(seen.x, seen.y, seen.z, 1);
}

frag Halve(Vertex vertex, Texture source, out Color color)
{
    Color seen = source.Sample(vertex.uv, Filter.Bilinear, Wrap.Clamp);
    color = Color(seen.r, seen.g, seen.b, 1);
}

frag Blur(Vertex vertex, Texture source, BlurStep step, out Color color)
{
    float2 near = step.along * 1.3846;
    float2 far = step.along * 3.2308;
    float3 sum = Rgb(source.Sample(vertex.uv, Filter.Bilinear, Wrap.Clamp)) * 0.227
               + (Rgb(source.Sample(vertex.uv + near, Filter.Bilinear, Wrap.Clamp)) + Rgb(source.Sample(vertex.uv - near, Filter.Bilinear, Wrap.Clamp))) * 0.3162
               + (Rgb(source.Sample(vertex.uv + far, Filter.Bilinear, Wrap.Clamp)) + Rgb(source.Sample(vertex.uv - far, Filter.Bilinear, Wrap.Clamp))) * 0.0703;
    color = Color(sum.x, sum.y, sum.z, 1);
}

// Light becomes a picture, as an old console showed one: LINES rows of
// pixels, a film curve, a sickly grade, and 32 steps a channel with the gaps
// between them dithered.
frag Develop(Vertex vertex, Texture source, Lens lens, out Color color)
{
    float2 cells = float2(Math.Round(lens.lines * lens.pixel.y / lens.pixel.x), lens.lines);
    // Caught: the picture jolts, and goes red from its edges
    float2 jolt = float2(Math.Sin(lens.phase * 97), Math.Cos(lens.phase * 131)) * lens.scare * 0.02;
    // Under the red the picture swims
    float2 swim = float2(Math.Sin(vertex.uv.y * 23 + lens.phase * 3), Math.Cos(vertex.uv.x * 19 + lens.phase * 2)) * (0.014 * lens.sunk);
    float2 cell = Math.Floor(Math.Saturate(vertex.uv + jolt + swim) * cells);
    float2 uv = (cell + 0.5) / cells;
    float2 off = uv - 0.5;
    mut float3 light = Rgb(source.Sample(uv, Filter.Point, Wrap.Clamp));
    light += Rgb(lens.shafts.Sample(uv, Filter.Bilinear, Wrap.Clamp));
    light += Rgb(lens.near.Sample(uv, Filter.Bilinear, Wrap.Clamp)) * 0.5 + Rgb(lens.mid.Sample(uv, Filter.Bilinear, Wrap.Clamp)) * 0.4
           + Rgb(lens.wide.Sample(uv, Filter.Bilinear, Wrap.Clamp)) * 0.34;
    light *= 1.15;
    if (lens.sunk > 0)
    {
        // ...and is seen through it: red, thick a little way off, with clouds of it adrift
        float2 adrift = float2(Math.Cos(lens.phase), Math.Sin(lens.phase));
        float cloud = Math.Simplex(uv * float2(5, 3) + adrift * 0.8) * 0.5 + Math.Simplex(uv * float2(11, 7) - adrift * 1.3) * 0.5;
        float lightness = Math.Dot(light, float3(0.3, 0.5, 0.2));
        float3 murk = lens.murk * (0.35 + Math.Saturate(cloud * 0.5 + 0.5) * 0.9);
        // Thick: an arm's length off is dim, and nothing shows past a few meters
        float away = lens.far.Sample(uv, Filter.Bilinear, Wrap.Clamp).r;
        float thick = 1 - Math.Exp(-away * 1.1);
        light = Math.Lerp(lens.murk * (5.6 * lightness), murk, Math.Saturate(0.25 + thick * 0.75) * lens.sunk);
    }

    mut float3 film = Math.Saturate(light * (light * 2.51 + float3(0.03)) / (light * (light * 2.43 + float3(0.59)) + float3(0.14)));
    float luma = Math.Dot(film, float3(0.2126, 0.7152, 0.0722));
    film = Math.Lerp(float3(luma), film, 0.92);
    film *= Math.Lerp(float3(0.92, 1.03, 0.96), float3(1.05, 1.0, 0.9), Math.SmoothStep(0.0, 0.6, luma));
    film = Math.Saturate(film * lens.grade);
    mut float3 shown = float3(Math.Sqrt(film.x), Math.Sqrt(film.y), Math.Sqrt(film.z));
    shown *= 1 - Math.SmoothStep(0.2, 1.1, Math.Dot(off, off) * 2) * 0.45;
    shown = Math.Lerp(shown, shown * float3(1.5, 0.25, 0.2), Math.Saturate(lens.scare * (0.35 + Math.Dot(off, off) * 3)));
    // Dragged under: the dark closes from the edges, then takes the middle
    shown *= 1 - Math.Saturate(lens.under * (lens.under + Math.Dot(off, off) * 5));
    float grain = Math.Frac(Math.Sin(Math.Dot(cell + float2(lens.phase * 37, lens.phase * 91), float2(12.9898, 78.233))) * 43758.5453) - 0.5;
    shown += grain * 0.02;
    // The ordered pattern of four by four that hides the steps
    int x = int(cell.x) & 3;
    int y = int(cell.y) & 3;
    float pattern = ((((x ^ y) & 1) * 2 + (y & 1)) * 4 + (((x >> 1) ^ (y >> 1)) & 1) * 2 + ((y >> 1) & 1) + 0.5) / 16;
    shown = Math.Floor(Math.Saturate(shown) * 31 + pattern) / 31;
    color = Color(shown.x, shown.y, shown.z, 1);
}

void BoxFace(mut Optics optics, float3 normal, float3 a, float3 b, float3 c, float3 d)
{
    int start = optics.box.count;
    optics.box.Add(StoneVertex { position = a, normal = normal, uv = float2(0, 1) });
    optics.box.Add(StoneVertex { position = b, normal = normal, uv = float2(1, 1) });
    optics.box.Add(StoneVertex { position = c, normal = normal, uv = float2(1, 0) });
    optics.box.Add(StoneVertex { position = d, normal = normal, uv = float2(0, 0) });
    optics.triangles.Add(start);
    optics.triangles.Add(start + 1);
    optics.triangles.Add(start + 2);
    optics.triangles.Add(start);
    optics.triangles.Add(start + 2);
    optics.triangles.Add(start + 3);
}

void MakeBall(mut Optics optics, int rings, int around)
{
    for (int ring = 0; ring <= rings; ring++)
    {
        float tilt = ring * Math.PI / rings;
        for (int step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            float3 out = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
            optics.ball.Add(StoneVertex { position = out * 0.5, normal = out, uv = float2(step * 1.0 / around, ring * 1.0 / rings) });
            if (ring == rings || step == around) continue;
            int at = ring * (around + 1) + step;
            optics.ballTriangles.Add(at);
            optics.ballTriangles.Add(at + around + 1);
            optics.ballTriangles.Add(at + 1);
            optics.ballTriangles.Add(at + 1);
            optics.ballTriangles.Add(at + around + 1);
            optics.ballTriangles.Add(at + around + 2);
        }
    }
}

void MakeTube(mut Optics optics, int around)
{
    for (int step = 0; step <= around; step++)
    {
        float turn = step * Math.TAU / around;
        float3 out = float3(Math.Cos(turn), 0, Math.Sin(turn));
        optics.tube.Add(StoneVertex { position = out * 0.5 - float3(0, 0.5, 0), normal = out, uv = float2(step * 1.0 / around, 0) });
        optics.tube.Add(StoneVertex { position = out * 0.5 + float3(0, 0.5, 0), normal = out, uv = float2(step * 1.0 / around, 1) });
        if (step == around) continue;
        int at = step * 2;
        optics.tubeTriangles.Add(at);
        optics.tubeTriangles.Add(at + 1);
        optics.tubeTriangles.Add(at + 2);
        optics.tubeTriangles.Add(at + 2);
        optics.tubeTriangles.Add(at + 1);
        optics.tubeTriangles.Add(at + 3);
    }
    for (int cap = 0; cap < 2; cap++)
    {
        float y = cap == 0 ? 0.5 : -0.5;
        float3 normal = float3(0, cap == 0 ? 1 : -1, 0);
        int middle = optics.tube.count;
        optics.tube.Add(StoneVertex { position = float3(0, y, 0), normal = normal, uv = float2(0.5, 0.5) });
        for (int step = 0; step <= around; step++)
        {
            float turn = step * Math.TAU / around;
            optics.tube.Add(StoneVertex { position = float3(Math.Cos(turn) * 0.5, y, Math.Sin(turn) * 0.5), normal = normal, uv = float2(0.5, 0.5) });
            if (step == around) continue;
            optics.tubeTriangles.Add(middle);
            optics.tubeTriangles.Add(middle + 1 + step + (cap == 0 ? 1 : 0));
            optics.tubeTriangles.Add(middle + 1 + step + (cap == 0 ? 0 : 1));
        }
    }
}

// A leaf: a blade that grows along y and arches over towards z.
void MakeBlade(mut Optics optics, int along)
{
    for (int row = 0; row <= along; row++)
    {
        float t = row * 1.0 / along;
        float width = Math.Pow(1 - t, 0.7) * (0.3 + 0.7 * Math.Min(1, t * 4));
        float3 normal = Math.Normalize(float3(0, -1.1 * t, 1));
        for (int side = -1; side <= 1; side++)
        {
            float3 at = float3(side * width * 0.5, t, 0.55 * t * t + (side == 0 ? -0.04 * width : 0));
            optics.blade.Add(StoneVertex { position = at, normal = Math.Normalize(normal + float3(side * 0.35, 0, 0)), uv = float2(side * 0.5 + 0.5, t) });
        }
        if (row == along) continue;
        for (int side = 0; side < 2; side++)
        {
            int at = row * 3 + side;
            optics.bladeTriangles.Add(at);
            optics.bladeTriangles.Add(at + 3);
            optics.bladeTriangles.Add(at + 1);
            optics.bladeTriangles.Add(at + 1);
            optics.bladeTriangles.Add(at + 3);
            optics.bladeTriangles.Add(at + 4);
        }
    }
}

void MakeOptics(mut Optics optics, mut Daylight day, mut Lens lens)
{
    // The picture is 300 rows whatever the window's, so the room is drawn at half the window's pixels, and what's
    // seen through a fold at half and a quarter
    optics.scene = RenderTarget.Window(RENDER, Format.Rgba16f, samples: 4);
    // Four ends' pictures, where two were: each a sample a pixel now, which the picture's big pixels hide
    optics.first0 = RenderTarget.Window(RENDER);
    optics.first1 = RenderTarget.Window(RENDER);
    optics.first2 = RenderTarget.Window(RENDER);
    optics.first3 = RenderTarget.Window(RENDER);
    optics.deep0 = RenderTarget.Window(RENDER * 0.5);
    optics.deep1 = RenderTarget.Window(RENDER * 0.5);
    optics.deep2 = RenderTarget.Window(RENDER * 0.5);
    optics.deep3 = RenderTarget.Window(RENDER * 0.5);
    optics.cross0 = RenderTarget.Window(RENDER * 0.5);
    optics.cross1 = RenderTarget.Window(RENDER * 0.5);
    optics.cross2 = RenderTarget.Window(RENDER * 0.5);
    optics.cross3 = RenderTarget.Window(RENDER * 0.5);
    optics.cross4 = RenderTarget.Window(RENDER * 0.5);
    optics.cross5 = RenderTarget.Window(RENDER * 0.5);
    optics.cross6 = RenderTarget.Window(RENDER * 0.5);
    optics.cross7 = RenderTarget.Window(RENDER * 0.5);
    day.map = RenderTarget(SUN_PIXELS, SUN_PIXELS, 1, Format.Depth);
    day.depth = day.map.depth;
    day.fold0 = RenderTarget(FOLD_PIXELS, FOLD_PIXELS, 1, Format.Depth);
    day.fold1 = RenderTarget(FOLD_PIXELS, FOLD_PIXELS, 1, Format.Depth);
    day.fold2 = RenderTarget(FOLD_PIXELS, FOLD_PIXELS, 1, Format.Depth);
    day.fold3 = RenderTarget(FOLD_PIXELS, FOLD_PIXELS, 1, Format.Depth);
    day.foldDepth0 = day.fold0.depth;
    day.foldDepth1 = day.fold1.depth;
    day.foldDepth2 = day.fold2.depth;
    day.foldDepth3 = day.fold3.depth;
    day.made = true;
    lens.sceneDepth = optics.scene.depth;
    lens.depth0 = optics.first0.depth;
    lens.depth1 = optics.first1.depth;
    lens.depth2 = optics.first2.depth;
    lens.depth3 = optics.first3.depth;
    lens.far0 = optics.deep0.depth;
    lens.far1 = optics.deep1.depth;
    lens.far2 = optics.deep2.depth;
    lens.far3 = optics.deep3.depth;
    lens.air = RenderTarget.Window(0.5, Format.Rgba16f);
    lens.reach = RenderTarget.Window(0.5, Format.Rgba16f);
    lens.half = RenderTarget.Window(0.5, Format.Rgba16f);
    lens.quarter = RenderTarget.Window(0.25, Format.Rgba16f);
    lens.quarterTurn = RenderTarget.Window(0.25, Format.Rgba16f);
    lens.eighth = RenderTarget.Window(0.125, Format.Rgba16f);
    lens.eighthTurn = RenderTarget.Window(0.125, Format.Rgba16f);
    lens.sixteenth = RenderTarget.Window(0.0625, Format.Rgba16f);
    lens.sixteenthTurn = RenderTarget.Window(0.0625, Format.Rgba16f);
    lens.made = true;
    BoxFace(optics, float3(0, 0, 1), float3(-.5, -.5, .5), float3(.5, -.5, .5), float3(.5, .5, .5), float3(-.5, .5, .5));
    BoxFace(optics, float3(0, 0, -1), float3(.5, -.5, -.5), float3(-.5, -.5, -.5), float3(-.5, .5, -.5), float3(.5, .5, -.5));
    BoxFace(optics, float3(-1, 0, 0), float3(-.5, -.5, -.5), float3(-.5, -.5, .5), float3(-.5, .5, .5), float3(-.5, .5, -.5));
    BoxFace(optics, float3(1, 0, 0), float3(.5, -.5, .5), float3(.5, -.5, -.5), float3(.5, .5, -.5), float3(.5, .5, .5));
    BoxFace(optics, float3(0, 1, 0), float3(-.5, .5, .5), float3(.5, .5, .5), float3(.5, .5, -.5), float3(-.5, .5, -.5));
    BoxFace(optics, float3(0, -1, 0), float3(-.5, -.5, -.5), float3(.5, -.5, -.5), float3(.5, -.5, .5), float3(-.5, -.5, .5));
    MakeBall(optics, 14, 22);
    MakeTube(optics, 20);
    MakeBlade(optics, 6);
    optics.card = [Vertex3 { position = float3(-.5, -.5, 0), uv = float2(0, 1) },
                   Vertex3 { position = float3(.5, -.5, 0), uv = float2(1, 1) },
                   Vertex3 { position = float3(.5, .5, 0), uv = float2(1, 0) },
                   Vertex3 { position = float3(-.5, .5, 0), uv = float2(0, 0) }];
    optics.cardTriangles = [0, 1, 2, 0, 2, 3];
    optics.made = true;
}

Fixture Block(float3 position, float3 size, Color tint, float tiles = 0, float luminous = 0, float gloss = 0.1, float crop = 0)
{
    return Fixture { transform = float4x4.TRS(position, quaternion.identity, size), tint = tint, size = size, luminous = luminous, gloss = gloss };
}

Fixture Turned(float3 position, quaternion rotation, float3 size, Color tint, float luminous = 0, float gloss = 0.1, float crop = 0)
{
    return Fixture { transform = float4x4.TRS(position, rotation, size), tint = tint, size = size, luminous = luminous, gloss = gloss };
}

Fixture Round(float3 position, quaternion rotation, float3 size, Color tint, float luminous = 0, float gloss = 0.3)
{
    return Fixture { transform = float4x4.TRS(position, rotation, size), tint = tint, size = size, luminous = luminous, gloss = gloss };
}

// A box painted with a square of the sheet, `tiles` of it a meter, by where it is in the room.
Fixture Clad(float3 position, float3 size, float cell, float tiles, Color tint = Color.white)
{
    return Fixture { transform = float4x4.TRS(position, quaternion.identity, size), tint = tint, size = size, tiles = tiles, cell = cell };
}

// A box with a square of the sheet on each face: all of it, or its left or right half.
Fixture Faced(float3 position, quaternion rotation, float3 size, float cell, float crop, Color tint = Color.white)
{
    return Fixture { transform = float4x4.TRS(position, rotation, size), tint = tint, size = size, cell = cell, crop = crop };
}

// The sheet's squares.
const float DOORS = 0;
const float BRICK = 1;
const float PANELS = 2;
const float CONCRETE = 3;
const float MARBLE = 4;
const float PLANKS = 5;
const float HAZARD = 6;
const float RUST = 9;
const float SHUTTER = 10;
const float WALLPAPER = 12;
const float CARPET = 13;
const float CEILING_TILE = 14;
const float PLASTER = 15;

// What's hung in the rooms, beside the walls themselves, which are the
// match's: lamps in the ceiling, doors to nowhere, the way out and its sign,
// boards, and the chamber's number.
// Whether a lamp's fitting hangs at a place: 0 for none, 1 under a roof, 2 on rods under a higher one.
int Fitted(int level, float3 at)
{
    if (level == DARK)
    {
        if (at.y > STOREY) return 0;
        if (at.z < -12) return Math.Abs(at.x) < 7 && at.z > -22 ? 1 : 0;
        if (Math.Abs(at.x) < 4 && at.z < 6) return 1;
        return at.x > 5 && at.x < 16 && at.z > 0 && at.z < 10 ? 1 : 0;
    }
    if (level == SIGHT)
    {
        if (at.y > STOREY) return Math.Abs(at.x) < 6 && at.z > -2 && at.z < 10 ? 1 : 0;
        if (at.z > -2) return Math.Abs(at.x) < 6 && at.z < 7 ? 2 : 0;
        return Math.Abs(at.x) < 6 && at.z > -22 ? 1 : 0;
    }
    if (level != SHAFT) return at.y < STOREY && Math.Abs(at.x) < 9.8 && Math.Abs(at.z) < 13 ? 1 : 0;
    if (at.y < STOREY) return Math.Abs(at.x) < 8 && at.z > -10 && at.z < 1 ? 2 : 0;
    if (Math.Abs(at.x) < 8 && at.z > -10 && at.z < 4) return 1;
    return Math.Abs(at.x) < 9 && at.z > 10 && at.z < 24 ? 1 : 0;
}

void Dress(mut Optics optics, int level, int theme)
{
    Color wood = Color(.30, .22, .15);
    Color steel = Color(.16, .17, .17);
    // The lamps' fittings: one over each bay there's a roof at that height for, and on rods from the roof where
    // a room is taller than a storey
    for (int row = -4; row < 13; row++)
    {
        for (int column = -1; column < 6; column++)
        {
            for (int storey = 0; storey < 2; storey++)
            {
                // Each well clear of the ceiling and of its frame: surfaces a few millimeters apart flicker
                float3 at = float3((column - 1.5) * 5, storey * STOREY + CEILING - .04, -13 + (row + .5) * 3.25);
                int hung = Fitted(level, at);
                if (hung == 0) continue;
                optics.glass.Add(Fixture { transform = float4x4.TRS(at, quaternion.identity, float3(1.2, .08, .6)), size = float3(1.2, .08, .6), kind = 2 });
                optics.glass.Add(Block(at + float3(0, .015, 0), float3(1.34, .05, .74), steel));
                if (hung == 2)
                {
                    optics.glass.Add(Block(at + float3(-.5, 2.5, 0), float3(.03, 5, .03), steel));
                    optics.glass.Add(Block(at + float3(.5, 2.5, 0), float3(.03, 5, .03), steel));
                }
            }
        }
    }
    // The lift's far door, which is shut here and opens on the next place; and in the lift they came by, the
    // door they came in at, shut behind them. Each with a lamp over it.
    for (int lift = 0; lift < 2; lift++)
    {
        float3 at = lift == 0 ? LiftAt(level) + float3(0, 2, 1.57) : ArrivalAt(level) + float3(0, 2, -1.57);
        float out = lift == 0 ? -1 : 1;
        optics.furnishings.Add(Faced(at, quaternion.identity, float3(5.6, 4.0, .08), SHUTTER, 0, Color(.8, .8, .8)));
        for (int rib = 0; rib < 4; rib++)
            optics.furnishings.Add(Block(at + float3(0, -1.5 + rib, out * .06), float3(5.2, .07, .04), steel, 0, 0, .7));
        optics.furnishings.Add(Block(at + float3(0, 2.12, out * .06), float3(.5, .12, .06), lift == 0 ? Color(.2, 1, .45) : Color(1, .2, .12), 0, 1.3));
    }

    // Doors that lead nowhere, each in its frame.
    for (int door = 0; door < 9; door++)
    {
        mut float3 at = float3(-9.77, 1.05, -11.2);
        mut float3 normal = float3(1, 0, 0);
        if (door == 1) at.z = -1.6;
        else if (door == 2) at.z = 6.3;
        else if (door >= 3 && door < 6)
        {
            normal = float3(-1, 0, 0);
            at = float3(9.77, 1.05, door == 3 ? -10.4 : door == 4 ? -2.2 : 5.8);
        }
        else if (door >= 6)
        {
            normal = float3(0, 0, 1);
            at = float3(door == 6 ? -6.2 : door == 7 ? 1.4 : 7.1, 1.05, -12.97);
        }
        if (level != 0 || door == 8) continue;
        if (door < 6 && Math.Abs(at.z) < 4.5) continue;
        quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
        optics.furnishings.Add(Faced(at + normal * .03, r, float3(.95, 2.1, .06), DOORS, 2));
        optics.furnishings.Add(Turned(at + float3(0, .03, 0) + normal * .012, r, float3(1.11, 2.2, .06), wood));
    }
    if (theme == 0 && level < SHAFT)
    {
        optics.furnishings.Add(Faced(float3(-3.4, .06, -12.1), quaternion.Euler(0, .3, 0), float3(2.2, .12, 1.1), PLANKS, 0));
        optics.furnishings.Add(Faced(float3(-3.6, .18, -12.2), quaternion.Euler(0, -.15, 0), float3(2.2, .12, 1.1), PLANKS, 0));
    }
    int hazard = Hazard(level, theme);
    float middle = PitMiddle(level);
    if (theme == 1)
    {
        // A pool's things: rings on the walls, a rail down each slope, and the depth painted by the water
        for (int ring = 0; ring < 4; ring++)
        {
            float3 at = float3(ring < 2 ? -9.74 : 9.74, 1.6, ring % 2 == 0 ? -7.5 : 8.5);
            for (int part = 0; part < 12; part++)
            {
                float a = part * (Math.TAU / 12);
                optics.furnishings.Add(Turned(at + float3(0, Math.Sin(a) * .32, Math.Cos(a) * .32), quaternion.Euler(-a, 0, 0), float3(.1, .12, .19),
                                              part % 3 == 0 ? Color(.9, .9, .86) : Color(.86, .16, .1)));
            }
        }
        for (int rail = 0; rail < 4 && hazard == 2; rail++)
        {
            float side = rail < 2 ? -1 : 1;
            float x = rail % 2 == 0 ? -4.0 : 4.0;
            Color chrome = Color(.7, .74, .76);
            float edge = PitHalf(level);
            optics.furnishings.Add(Block(float3(x, .45, middle + side * (edge + .1)), float3(.05, .9, .05), chrome, 0, 0, .9));
            optics.furnishings.Add(Block(float3(x, -.5, middle + side * (edge - 1.5)), float3(.05, .9, .05), chrome, 0, 0, .9));
            optics.furnishings.Add(Turned(float3(x, .42, middle + side * (edge - .7)), quaternion.Euler(-side * .57, 0, 0), float3(.05, .05, 1.95), chrome, 0, .9));
        }
        for (int mark = 0; mark < 6 && hazard == 2; mark++)
            optics.furnishings.Add(Block(float3(-7.5 + mark * 3, .012, middle - PitHalf(level) - .4), float3(.5, .02, .22), Color(.1, .2, .5)));
    }
    if (theme == 2)
    {
        // The concrete's: ducts under the roof on their hangers, boxes on the walls, and the trench's edges marked
        Color rusted = Color(.36, .24, .17);
        for (int duct = 0; duct < 3; duct++)
        {
            float x = duct == 0 ? -7.6 : duct == 1 ? -6.9 : 8.2;
            optics.furnishings.Add(Block(float3(x, 4.02 - duct * .05, 0), float3(duct == 1 ? .2 : .34, duct == 1 ? .2 : .3, 25.6), duct == 1 ? Color(.6, .1, .08) : rusted, 0, 0, .4));
            for (int hanger = 0; hanger < 7; hanger++)
                optics.furnishings.Add(Block(float3(x, 4.2, -11 + hanger * 3.7), float3(.42, .32, .06), steel));
        }
        for (int box = 0; box < 4; box++)
        {
            float3 at = float3(box < 2 ? -9.7 : 9.7, 1.5, box % 2 == 0 ? -9.2 : 6.4);
            optics.furnishings.Add(Block(at, float3(.2, .8, .6), Color(.3, .32, .3), 0, 0, .5));
            optics.furnishings.Add(Block(at + float3(box < 2 ? .11 : -.11, .22, .16), float3(.03, .06, .06), Color(.2, 1, .3), 0, 1.4));
            optics.furnishings.Add(Block(at + float3(0, 1.6, 0), float3(.06, 2.4, .06), steel));
        }
        for (int mark = 0; mark < 40 && hazard == 3; mark++)
        {
            for (int side = -1; side <= 1; side += 2)
                optics.furnishings.Add(Block(float3(-9.5 + mark * .487, .011, middle + side * (PitHalf(level) + .25)), float3(.26, .02, .3), (mark & 1) == 0 ? Color(.95, .72, .08) : Color(.06, .06, .06)));
        }
    }

    // The frames a fold's end takes its size from: painted round where the opening goes, lit a little.
    for (int index = 0; index < MountCount(level); index++)
    {
        Mount mount = ChamberMount(level, index);
        Color paint = mount.size < 1 ? Color(.95, .9, .5) : Color(.95, .5, .35);
        float wide = FOLD_HALF_WIDE * mount.size + .07;
        float high = FOLD_HALF_HIGH * mount.size + .07;
        bool along = Math.Abs(mount.face.x) > .5;
        float3 off = mount.at + mount.face * .015;
        for (int side = -1; side <= 1; side += 2)
        {
            float3 post = off + (along ? float3(0, 0, side * wide) : float3(side * wide, 0, 0));
            optics.furnishings.Add(Block(post, along ? float3(.03, high * 2 + .07, .07) : float3(.07, high * 2 + .07, .03), paint, 0, .6));
        }
        optics.furnishings.Add(Block(off + float3(0, high, 0), along ? float3(.03, .07, wide * 2) : float3(wide * 2, .07, .03), paint, 0, .6));
        // A plate over it: a small square for the small one, a wide bar for the large
        float3 sign = mount.size < 1 ? float3(.16, .16, .16) : float3(.9, .14, .9);
        optics.furnishings.Add(Block(off + float3(0, high + .22, 0), along ? float3(.03, sign.y, sign.z) : float3(sign.x, sign.y, .03), paint, 0, 1.1));
    }

    // The chamber's number, by the gate. The stretch between has none.
    if (!Between(level))
    {
        float3 sign = LiftAt(level) + float3(5.4, 3.1, -2.64);
        int number = level < BETWEEN ? level + 1 : level == SIGHT ? 7 : level == SHAFT ? 8 : 9;
        optics.furnishings.Add(Block(sign, float3(2.65, 1.5, .07), Color(.08, .1, .1), 0, 0, .4));
        WallDigit(optics, number / 10, sign + float3(-.54, 0, -.045));
        WallDigit(optics, number % 10, sign + float3(.54, 0, -.045));
    }
}

// A box of the room, as the match has it: a wall, a ceiling, a planter with what grows in it, or a crate.
// What a wall is painted with, in a place's theme: paper and carpet above, a pool's tiles further down, and
// bare concrete under that. The first number is the square of the sheet.
float ThemeCell(float paint, int theme)
{
    if (theme == 1) return paint == 12 ? 15.0 : paint == 13 ? 3.0 : paint;
    if (theme == 2) return paint == 12 ? 8.0 : paint == 13 ? 2.0 : paint;
    return paint;
}

Color ThemeTint(float paint, int theme)
{
    if (theme == 1) return paint == 12 ? Color(.95, 1, 1) : paint == 13 ? Color(.62, .95, 1) : Color(.9, 1, 1);
    if (theme == 2) return paint == 12 ? Color(.8, .76, .7) : paint == 13 ? Color(.6, .58, .55) : Color(.9, .86, .8);
    return Color.white;
}

void DressWall(mut Optics optics, Wall wall, int number, int theme)
{
    if (wall.kind == 2) optics.glass.Add(Clad(wall.center, wall.size, wall.paint, wall.tiles, ThemeTint(wall.paint, theme)));
    else if (wall.kind == 3) optics.furnishings.Add(Faced(wall.center, quaternion.identity, wall.size, wall.paint, 0));
    else if (wall.kind == 4)
    {
        // A grille: the match's box is solid, and what's seen of it is bars
        Color iron = Color(.13, .11, .10);
        bool along = wall.size.z > wall.size.x;
        float run = along ? wall.size.z : wall.size.x;
        int bars = Math.Max(1, int(run / .34));
        for (int bar = 0; bar <= bars; bar++)
        {
            float offset = -run * .5 + bar * (run / bars);
            optics.furnishings.Add(Block(wall.center + (along ? float3(0, 0, offset) : float3(offset, 0, 0)), float3(.07, wall.size.y, .07), iron, 0, 0, .5));
        }
        for (int rail = 0; rail < 3; rail++)
            optics.furnishings.Add(Block(float3(wall.center.x, wall.center.y - wall.size.y * .5 + .06 + rail * (wall.size.y - .12) * .5, wall.center.z),
                                         along ? float3(.11, .1, run) : float3(run, .1, .11), iron, 0, 0, .5));
    }
    else if (wall.kind == 1 && theme == 1)
    {
        // By a pool: a lounger, with a towel left on it
        float x = wall.center.x;
        float z = wall.center.z;
        Color slat = Color(.9, .92, .88);
        for (int board = 0; board < 6; board++)
            optics.furnishings.Add(Block(float3(x, .4, z - .55 + board * .2), float3(.74, .05, .16), slat, 0, 0, .4));
        for (int board = 0; board < 4; board++)
            optics.furnishings.Add(Turned(float3(x, .52 + board * .15, z + .72 + board * .1), quaternion.Euler(-.95, 0, 0), float3(.74, .05, .16), slat, 0, .4));
        for (int leg = 0; leg < 4; leg++)
            optics.furnishings.Add(Block(float3(x + ((leg & 1) == 0 ? -.34 : .34), .19, z + ((leg & 2) == 0 ? -.6 : .7)), float3(.05, .38, .05), Color(.6, .62, .64), 0, 0, .8));
        optics.furnishings.Add(Block(float3(x + .05, .445, z - .2), float3(.6, .04, .7), (number & 1) == 0 ? Color(.85, .25, .2) : Color(.2, .4, .8)));
        optics.furnishings.Add(Block(float3(x - .2, .08, z - 1.15), float3(.3, .04, .12), Color(.2, .5, .9)));
        optics.furnishings.Add(Block(float3(x + .14, .08, z - 1.1), float3(.3, .04, .12), Color(.2, .5, .9)));
    }
    else if (wall.kind == 1 && theme == 2)
    {
        // In the concrete: a barrier, with its warning along the top
        optics.furnishings.Add(Clad(wall.center - float3(0, .1, 0), float3(wall.size.x, wall.size.y - .2, wall.size.z), 2, 1, Color(.7, .68, .64)));
        optics.furnishings.Add(Block(float3(wall.center.x, wall.size.y - .16, wall.center.z), float3(wall.size.x * .7, .12, wall.size.z), Color(.5, .48, .45)));
        for (int stripe = 0; stripe < 8; stripe++)
            optics.furnishings.Add(Turned(float3(wall.center.x, wall.size.y - .16, wall.center.z - .88 + stripe * .25), quaternion.Euler(.6, 0, 0),
                                          float3(wall.size.x * .72, .13, .1), (stripe & 1) == 0 ? Color(.95, .72, .08) : Color(.06, .06, .06)));
    }
    else if (wall.kind == 1)
    {
        float x = wall.center.x;
        float z = wall.center.z;
        optics.furnishings.Add(Clad(wall.center, wall.size, wall.paint, wall.tiles, Color(.7, .7, .68)));
        optics.furnishings.Add(Block(float3(x, .7, z), float3(.72, .06, 1.87), Color(.07, .06, .045)));
        for (int leaf = 0; leaf < 22; leaf++)
        {
            int roll = Math.Hash(int2(number, leaf));
            float a = leaf * 2.39996 + number * 1.7;
            float long = .45 + ((roll >> 3) & 63) / 63.0 * .7;
            float lean = .25 + ((roll >> 9) & 63) / 63.0 * .75;
            float3 p = float3(x + Math.Cos(a) * .2, .72, z + ((leaf % 6) - 2.5) * .29 + Math.Sin(a) * .08);
            quaternion r = Math.Mul(quaternion.Euler(0, a, 0), quaternion.Euler(lean, 0, 0));
            float shadeOf = ((roll >> 15) & 63) / 63.0;
            optics.leaves.Add(Fixture { transform = float4x4.TRS(p, r, float3(.1 + long * .09, long, long)),
                                        tint = Color(.34 + shadeOf * .22, .44 + shadeOf * .12, .18 + shadeOf * .06), size = float3(1), kind = 1 });
        }
    }
    else optics.architecture.Add(Clad(wall.center, wall.size, ThemeCell(wall.paint, theme), wall.tiles, ThemeTint(wall.paint, theme)));
}

void WallDigit(mut Optics optics, int digit, float3 position)
{
    int mask = digit == 0 ? 63 : digit == 1 ? 6 : digit == 2 ? 91 : digit == 3 ? 79 : digit == 4 ? 102 : digit == 5 ? 109 : digit == 6 ? 125 : digit == 7 ? 7
             : digit == 8 ? 127 : 111;
    for (int segment = 0; segment < 7; segment++)
    {
        if ((mask & (1 << segment)) == 0) continue;
        mut float3 at = float3(0, .46, 0);
        mut float3 size = float3(.5, .12, .06);
        if (segment == 1 || segment == 2 || segment == 4 || segment == 5)
        {
            at = float3(segment < 3 ? .265 : -.265, segment == 1 || segment == 5 ? .23 : -.23, 0);
            size = float3(.12, .46, .06);
        }
        else if (segment == 3) at.y = -.46;
        else if (segment == 6) at.y = 0;
        optics.furnishings.Add(Block(position + at, size, Color(.84, .96, .88), 0, .9));
    }
}

// An operator's pose: standing, or running as fast as they go, and where they stand as a matrix.
Pose FigurePose(Operator body, float clock)
{
    mut var pose = figure.defaultPose;
    // Each of Kenney's files holds a one-frame targeting pose before its clip: the clips are the odd ones.
    if (moves.TryGetAt(1, out var idle)) pose.Sample(idle, Math.Frac(clock / Math.Max(idle.duration, 0.01)) * idle.duration, Playback.Loop);
    float pace = Math.Saturate(Math.Length(body.velocity.xz) / 4);
    if (!body.grounded)
    {
        if (moves.TryGetAt(5, out var jump))
        {
            mut var leaping = figure.defaultPose;
            leaping.Sample(jump, jump.duration * 0.5);
            pose.Blend(leaping, 0.8);
        }
    }
    else if (pace > 0.01 && moves.TryGetAt(3, out var run))
    {
        mut var running = figure.defaultPose;
        running.Sample(run, Math.Frac(clock / Math.Max(run.duration, 0.01)) * run.duration, Playback.Loop);
        pose.Blend(running, pace);
    }
    return pose;
}

float4x4 FigurePlace(Operator body)
{
    // Nothing's left standing of whoever a drum had
    if (body.shredded) return float4x4.TRS(body.position - float3(0, 30, 0), quaternion.identity, float3(.001));
    return float4x4.TRS(body.position, quaternion.Euler(0, body.yaw, 0), float3(FIGURE_SCALE * body.scale));
}

// The fold projector in the operator's hand. It's drawn after the room, over
// depth set back, so it's in front of a wall the operator stands against.
void Held(mut Optics optics, float scale, float3 eye, quaternion rotation, int mesh, float3 place, quaternion turn, float3 extent, Color tint, float luminous = 0, float gloss = .6)
{
    quaternion r = Math.Mul(rotation, turn);
    mut Fixture part = mesh == 0 ? Turned(eye + Math.Rotate(rotation, place * scale), r, extent * scale, tint, luminous, gloss, .012)
                                 : Round(eye + Math.Rotate(rotation, place * scale), r, extent * scale, tint, luminous, gloss);
    if (mesh == 0) optics.device.Add(part);
    else if (mesh == 1) optics.deviceBalls.Add(part);
    else optics.deviceTubes.Add(part);
}

void Handheld(mut Optics optics, float3 eye, quaternion rotation, float pace, float carrying, float scale)
{
    Color shell = Color(.80, .79, .75);
    Color dark = Color(.08, .11, .13);
    float bob = Math.Sin(optics.stride * 2) * .008 * pace;
    float kick = optics.fired * optics.fired * .07;
    float3 hand = float3(.4 + Math.Sin(optics.stride) * .008 * pace, -.345 + bob - carrying * .14, .74 - kick);
    quaternion aim = quaternion.Euler(-.17 - kick * 1.5, -.3, 0);
    quaternion along = Math.Mul(aim, quaternion.Euler(90deg, 0, 0));
    Held(optics, scale, eye, rotation, 2, hand, along, float3(.1, .42, .1), shell, 0, .8);
    Held(optics, scale, eye, rotation, 1, hand + Math.Rotate(aim, float3(0, 0, -.21)), aim, float3(.1, .1, .12), shell, 0, .8);
    Held(optics, scale, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, .15)), along, float3(.128, .07, .128), dark, 0, .7);
    Held(optics, scale, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, .02)), along, float3(.108, .025, .108), dark, 0, .7);
    Held(optics, scale, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, -.1)), along, float3(.108, .025, .108), dark, 0, .7);
    Held(optics, scale, eye, rotation, 2, hand + Math.Rotate(aim, float3(0, 0, .2)), along, float3(.085, .05, .085), Color(.3, .9, .86), .7 + optics.fired * 2);
    Held(optics, scale, eye, rotation, 1, hand + Math.Rotate(aim, float3(0, 0, .25)), aim, float3(.06), Color(.8, 1, .97), 1.1 + optics.fired * 3);
    for (int prong = 0; prong < 3; prong++)
    {
        quaternion around = Math.Mul(aim, quaternion.Euler(0, 0, prong * Math.TAU / 3 + Math.PI / 6));
        Held(optics, scale, eye, rotation, 0, hand + Math.Rotate(around, float3(0, .064, .26)), Math.Mul(around, quaternion.Euler(.2, 0, 0)), float3(.022, .016, .17), dark, 0, .7);
    }
    Held(optics, scale, eye, rotation, 0, hand + Math.Rotate(aim, float3(-.022, .0515, -.04)), aim, float3(.011, .006, .09), Color(1, .64, .24), .8);
    Held(optics, scale, eye, rotation, 0, hand + Math.Rotate(aim, float3(.022, .0515, -.04)), aim, float3(.011, .006, .09), Color(.2, .96, .88), .8);
}

// An arm out of the pit: from its root to a hand that closes towards a point beside it.
void Arm(mut Optics optics, float3 root, float3 hand, float3 inward, float big, float grip)
{
    Color flesh = Color(.66, .60, .52);
    float3 along = Math.Normalize(hand - root);
    quaternion turn = quaternion.LookRotation(along, inward);
    float reach = Math.Distance(root, hand);
    // Thin where it comes out of the dark, a wrist, and a palm
    optics.dynamic.Add(Turned(root + along * (reach * .5), turn, float3(.1 * big, .12 * big, reach), flesh, .05));
    optics.dynamic.Add(Turned(hand + along * (.08 * big), turn, float3(.17 * big, .07 * big, .2 * big), flesh, .05));
    for (int finger = 0; finger < 4; finger++)
    {
        // Each finger in two bones, bent over what it holds
        float3 side = Math.Rotate(turn, float3((finger - 1.5) * .05 * big, 0, 0));
        float3 knuckle = hand + along * (.18 * big) + side;
        quaternion first = Math.Mul(turn, quaternion.Euler(-grip * 1.1, (finger - 1.5) * .12, 0));
        float3 tip = knuckle + Math.Rotate(first, float3(0, 0, .11 * big));
        quaternion second = Math.Mul(turn, quaternion.Euler(-grip * 2.3, (finger - 1.5) * .12, 0));
        optics.dynamic.Add(Turned((knuckle + tip) * .5, first, float3(.036 * big, .036 * big, .12 * big), flesh, .05));
        optics.dynamic.Add(Turned(tip + Math.Rotate(second, float3(0, 0, .05 * big)), second, float3(.032 * big, .032 * big, .11 * big), flesh, .05));
    }
    quaternion thumb = Math.Mul(turn, quaternion.Euler(-grip, 1.1, 0));
    optics.dynamic.Add(Turned(hand + along * (.06 * big) + Math.Rotate(turn, float3(.11 * big, 0, 0)) + Math.Rotate(thumb, float3(0, 0, .05 * big)), thumb, float3(.04 * big, .04 * big, .12 * big), flesh, .05));
}

// Something went down through the red: it's thrown up in drops, and a ring runs out from it.
void Splash(mut Optics optics, float3 at, float big)
{
    int next = optics.splashed % 6;
    optics.splashAt[next] = at;
    optics.splashLeft[next] = 1.1;
    optics.splashBig[next] = big;
    optics.splashed += 1;
}

void Enter(mut Optics optics, int slot, float3 at, float big, float middle, float surface, float half)
{
    float was = optics.wasHigh[slot];
    optics.wasHigh[slot] = at.y;
    if (was <= surface || at.y > surface || was - at.y > 3 || Math.Abs(at.z - middle) > half + .1) return;
    Splash(optics, float3(at.x, surface, at.z), big);
}

// What a drum leaves of someone: pieces, thrown about.
void Pieces(mut Optics optics, Operator body)
{
    if (!body.shredded || body.taken <= 0) return;
    float age = body.taken;
    for (int piece = 0; piece < 26; piece++)
    {
        int roll = Math.Hash(piece + body.id * 97 + 3);
        float a = (roll & 255) / 255.0 * Math.TAU;
        float away = 1.2 + ((roll >> 8) & 63) / 63.0 * 4.2;
        float up = 2.2 + ((roll >> 14) & 63) / 63.0 * 5.5;
        mut float3 place = body.position + float3(0, .8, 0) + float3(Math.Cos(a) * away * age, up * age - 9 * age * age, Math.Sin(a) * away * age);
        if (place.y < body.position.y + .03) place.y = body.position.y + .03;
        float size = .07 + ((roll >> 20) & 7) * .022;
        Color what = piece % 4 == 0 ? Color(.72, .7, .66) : piece % 4 == 1 ? Color(.3, .32, .42) : Color(.5, .02, .02);
        optics.dynamic.Add(Turned(place, quaternion.Euler(a + age * 9, a * 3, age * 7), float3(size, size * 1.4, size), what, piece % 4 > 1 ? .3 : 0.0, .7));
    }
    // ...and what it leaves on the floor
    for (int pool = 0; pool < 5; pool++)
    {
        float a = pool * 1.3 + body.id;
        float wide = Math.Saturate(age * 2) * (.5 + pool * .12);
        optics.dynamic.Add(Block(body.position + float3(Math.Cos(a) * .5, .012, Math.Sin(a) * .5), float3(wide, .015, wide * .8), Color(.42, .01, .01), 0, .2, .9));
    }
}

// What a place's pits are full of.
Color Liquid(int theme)
{
    return theme == 1 ? Color(.08, .42, .46) : Color(.46, .015, .02);
}

void Splashes(mut Optics optics, Color liquid, float surface)
{
    Color red = Color(liquid.r * 1.3, liquid.g * 1.3, liquid.b * 1.3);
    for (int i = 0; i < 6; i++)
    {
        if (optics.splashLeft[i] <= 0) continue;
        optics.splashLeft[i] -= Math.Min(Frame.dt, .05);
        float age = 1.1 - optics.splashLeft[i];
        float big = optics.splashBig[i];
        float3 at = optics.splashAt[i];
        for (int drop = 0; drop < 16; drop++)
        {
            int roll = Math.Hash(drop + i * 31 + 7);
            float a = drop * 0.3927 + (roll & 63) / 63.0;
            float away = (0.5 + ((roll >> 6) & 63) / 63.0 * 1.6) * big;
            float up = 2.6 + ((roll >> 12) & 63) / 63.0 * 3.2;
            float3 place = at + float3(Math.Cos(a) * away * age, up * age - 6.5 * age * age, Math.Sin(a) * away * age);
            if (place.y < surface) continue;
            float size = (.05 + ((roll >> 18) & 7) * .012) * big;
            optics.dynamic.Add(Turned(place, quaternion.Euler(a + age * 6, a * 2, age * 9), float3(size, size * 1.8, size), red, .45, .9));
        }
        // The ring: a low wall of it, running out and sinking
        float around = (.35 + age * 2.4) * big;
        float tall = Math.Max(0, .16 * (1 - age / 0.8)) * big;
        for (int piece = 0; piece < 14 && tall > 0; piece++)
        {
            float a = piece * (Math.TAU / 14);
            optics.dynamic.Add(Turned(at + float3(Math.Cos(a) * around, tall * .5, Math.Sin(a) * around), quaternion.Euler(0, -a, 0),
                                      float3(.06 * big, tall, around * .46), red, .4, .9));
        }
    }
}

// The hands that have someone who fell: up from under them, round them, and closed.
void Taken(mut Optics optics, Operator body)
{
    if (body.taken <= 0) return;
    float3 feet = body.position;
    float big = body.scale;
    for (int i = 0; i < 11; i++)
    {
        int roll = Math.Hash(i + 40 + body.id * 100);
        float a = i * (Math.TAU / 11) + ((roll & 255) / 255.0 - .5) * .4;
        float b = ((roll >> 8) & 255) / 255.0;
        // Each comes a little after the last, fast, to a place on the body: ankles to the face
        mut float up = Math.Saturate((body.taken - b * .25) / .22);
        up = 1 - (1 - up) * (1 - up);
        float3 away = float3(Math.Cos(a), 0, Math.Sin(a));
        float high = (.05 + (i * 7 % 11) / 10.0 * 1.45) * big;
        float clutch = Math.Sin(optics.clock * (9 + b * 6) + i) * .025;
        float3 root = feet + away * ((1.5 + b * 1.2) * big) - float3(0, 2.6 * big, 0);
        float3 hand = feet + away * ((.36 + high * .2 / big + clutch) * big) + float3(0, Math.Lerp(-2.8 * big, high, up), 0);
        Arm(optics, root, hand, -away, big * 1.25, .35 + up * .5);
    }
}

// A loose thing, turned as Box3D has it: the cube with its corners and lit faces, or a crate of planks.
void Loose(mut Optics optics, Cube cube, bool crossing)
{
    Color steel = Color(.10, .14, .16);
    float big = cube.scale;
    if (cube.kind == 1)
    {
        Fixture crate = Faced(cube.at, cube.turn, float3(.74 * big), PLANKS, 0, cube.holder >= 0 ? Color(1.15, 1.1, 1) : Color.white);
        if (crossing) optics.cubeParts.Add(crate);
        else optics.cubeRest.Add(crate);
        return;
    }
    for (int part = 0; part < 15; part++)
    {
        mut Fixture piece = Turned(cube.at, cube.turn, float3(.74 * big), Color(.86, .86, .80), 0, .6);
        if (part >= 1 && part < 9)
        {
            int corner = part - 1;
            float3 way = float3((corner & 1) == 0 ? -1 : 1, (corner & 2) == 0 ? -1 : 1, (corner & 4) == 0 ? -1 : 1);
            piece = Turned(cube.at + Math.Rotate(cube.turn, way * (.3 * big)), cube.turn, float3(.2 * big), steel, 0, .7);
        }
        else if (part >= 9)
        {
            int face = part - 9;
            int axis = face / 2;
            float sign = face % 2 == 0 ? 1 : -1;
            float3 way = float3(axis == 0 ? sign : 0, axis == 1 ? sign : 0, axis == 2 ? sign : 0);
            float3 size = float3(axis == 0 ? .03 : .3, axis == 1 ? .03 : .3, axis == 2 ? .03 : .3);
            piece = Turned(cube.at + Math.Rotate(cube.turn, way * (.366 * big)), cube.turn, size * big, face == 2 ? Color(1, .64, .24) : Color(.16, .86, .80),
                           cube.holder >= 0 ? 1.5 : 1.0);
        }
        if (crossing) optics.cubeParts.Add(piece);
        else optics.cubeRest.Add(piece);
    }
}

void Furnish(mut Optics optics, Arena arena, Fold fold, Lurker lurker, Operator viewer, Operator partner)
{
    optics.dynamic.Clear();
    optics.cubeParts.Clear();
    optics.cubeEcho.Clear();
    optics.cubeRest.Clear();
    optics.device.Clear();
    optics.deviceBalls.Clear();
    optics.deviceTubes.Clear();
    optics.motes.Clear();
    Color amberTint = Color(1, .64, .24);
    Color cyanTint = Color(.2, .96, .88);
    Color steel = Color(.10, .14, .16);
    for (int plate = 0; plate <= PlateCount(arena.level); plate++)
    {
        // The chamber's own, and after them the lobby's
        float3 at = plate < PlateCount(arena.level) ? PlatePosition(arena.level, plate) : HoldPlate(arena.level);
        bool pressed = plate == PlateCount(arena.level) ? arena.hold : plate == 0 ? arena.plateA : plate == 1 ? arena.plateB : plate == 2 ? arena.plateC : arena.plateD;
        // The gate's two, a room's machinery's in green, and the lift's
        Color tint = plate == PlateCount(arena.level) ? Color(.75, 1, .8) : plate == 0 ? amberTint : plate == 1 ? cyanTint : Color(.45, 1, .3);
        float sunk = pressed ? .025 : 0;
        optics.dynamic.Add(Block(at + float3(0, .03, 0), float3(1.62, .08, 1.62), steel, 0, 0, .6, .03));
        optics.dynamic.Add(Block(at + float3(0, .085 - sunk, 0), float3(1.2, .06, 1.2), pressed ? tint : Color(.34, .40, .41), 0, pressed ? .8 : 0, .5, .02));
        for (int edge = -1; edge <= 1; edge += 2)
        {
            optics.dynamic.Add(Block(at + float3(edge * .72, .074, 0), float3(.05, .012, 1.3), tint, 0, pressed ? 1.3 : .55));
            optics.dynamic.Add(Block(at + float3(0, .074, edge * .72), float3(1.3, .012, .05), tint, 0, pressed ? 1.3 : .55));
        }
    }
    // The door of the lift they came by.
    float3 came = ArrivalAt(arena.level) + float3(0, 2.0 + Math.Saturate((arena.arrive - 0.7) * 1.6) * 4.3, 2.1);
    optics.dynamic.Add(Faced(came, quaternion.identity, float3(6.0, 4.0, .24), SHUTTER, 0, Color(.8, .8, .8)));
    for (int rib = 0; rib < 4; rib++)
        optics.dynamic.Add(Block(came + float3(0, -1.5 + rib, .13), float3(5.4, .07, .04), steel, 0, 0, .7));
    // The split gate physically retreats upwards as its two circuits latch.
    float3 gate = LiftAt(arena.level) + float3(0, 2.0 + arena.gate * 4.3, -2.1);
    optics.dynamic.Add(Faced(gate, quaternion.identity, float3(6.0, 4.0, .24), SHUTTER, 0, Color(.8, .8, .8)));
    for (int rib = 0; rib < 4; rib++)
        optics.dynamic.Add(Block(gate + float3(0, -1.5 + rib, -.13), float3(5.4, .07, .04), steel, 0, 0, .7));
    optics.dynamic.Add(Block(gate + float3(-2.85, 0, -.14), float3(.05, 3.9, .04), amberTint, 0, arena.solved ? 1.4 : .5));
    optics.dynamic.Add(Block(gate + float3(2.85, 0, -.14), float3(.05, 3.9, .04), amberTint, 0, arena.solved ? 1.4 : .5));
    optics.dynamic.Add(Block(gate + float3(0, 0, -.135), float3(.04, 3.9, .05), Color(.36, .46, .47), 0, 0, .8));

    // The pads: a plate tipped the way it throws, with the way marked on it
    for (int pad = 0; pad < PadCount(arena.level); pad++)
    {
        float3 at = PadAt(arena.level, pad);
        float way = PadThrow(arena.level, pad).z > 0 ? 1 : -1;
        optics.dynamic.Add(Block(at + float3(0, .04, 0), float3(1.5, .08, 1.5), steel, 0, 0, .7));
        optics.dynamic.Add(Turned(at + float3(0, .16, 0), quaternion.Euler(-way * .22, 0, 0), float3(1.2, .06, 1.2), Color(.3, .32, .34), 0, .7));
        for (int mark = 0; mark < 3; mark++)
        {
            float lit = Math.Frac(optics.clock * 1.5 - mark * .33) < .4 ? 1.8 : .5;
            optics.dynamic.Add(Turned(at + float3(0, .2 + mark * .05 * way * (mark - 1), way * (mark - 1) * .34), quaternion.Euler(-way * .22, 0, 0), float3(.7 - mark * .16 * way * (way > 0 ? 1 : -1), .02, .1),
                                      Color(1, .7, .15), lit));
        }
    }

    // A shot that found no place: shards of its color, flung off the spot and gone.
    if (fold.fizzleTime > 0)
    {
        float gone = 1 - fold.fizzleTime / 0.6;
        Color tint = FoldTint(fold.fizzleEnd);
        for (int shard = 0; shard < 7; shard++)
        {
            float a = shard * 0.9 + 0.4;
            float3 side = Math.Normalize(Math.Cross(fold.fizzleFace, float3(Math.Cos(a), Math.Sin(a * 1.7), Math.Sin(a))) + float3(0, .001, 0));
            float3 at = fold.fizzleAt + fold.fizzleFace * (.06 + gone * .35) + side * (gone * (.35 + shard * .05)) - float3(0, gone * gone * .5, 0);
            optics.dynamic.Add(Turned(at, quaternion.Euler(a + gone * 5, a * 2, gone * 7), float3(.07 * (1 - gone) + .01), tint, 1.6));
        }
    }

    // A partner's ping: a beacon that turns and fades.
    if (fold.pingTime > 0)
    {
        float fade = Math.Saturate(fold.pingTime / 0.6);
        Color tint = fold.pingOperator == 0 ? amberTint : cyanTint;
        float pulse = .12 + Math.Abs(Math.Sin(optics.phase * 4)) * .04;
        optics.dynamic.Add(Turned(fold.ping, quaternion.Euler(45deg, optics.phase * 2, 45deg), float3(pulse * fade), tint, 1.1));
        optics.dynamic.Add(Block(fold.ping - float3(0, .9, 0), float3(.014 * fade, 1.3, .014 * fade), tint, 0, .8));
    }

    // The pit's hands: far down in the dark until someone falls, then up and round them.
    int hazard = Hazard(arena.level, arena.theme);
    float middle = PitMiddle(arena.level);
    float half = PitHalf(arena.level);
    Color steel2 = Color(.2, .2, .21);
    if (hazard == 1)
    {
        // Blood with no bottom, and the hands in it: far down in the dark until someone falls, then round them
        for (int i = 0; i < 22; i++)
        {
            int roll = Math.Hash(i + 900);
            float a = (roll & 1023) / 1023.0;
            float b = ((roll >> 10) & 1023) / 1023.0;
            float c = ((roll >> 20) & 1023) / 1023.0;
            // Out of the red to the wrist or the elbow, groping
            float3 root = float3(PitFrom(arena.level) + .6 + a * (PitTo(arena.level) - PitFrom(arena.level) - 1.2), PIT_SURFACE - 1.4, middle - 2.1 + b * 4.2);
            float3 sway = float3(Math.Sin(optics.phase + a * 30), 0, Math.Cos(optics.phase * 2 + b * 30)) * .28;
            float high = 1.55 + c * .75 + Math.Sin(optics.phase * 2 + c * 20) * .12;
            Arm(optics, root, root + float3(0, high, 0) + sway, float3(Math.Cos(c * 9), 0, Math.Sin(c * 9)), 1.15, .35 + Math.Sin(optics.phase * 3 + a * 20) * .3);
        }
        Taken(optics, viewer);
        if (partner.id != viewer.id) Taken(optics, partner);
    }
    if (hazard >= 2)
    {
        // A pool or a trench: the slopes down into it, which the match has as two tilted boxes
        float deep = PitDeep(arena.level, hazard);
        float run = PitRun(arena.level, hazard);
        float slope = Math.Atan2(deep, run);
        for (int side = -1; side <= 1; side += 2)
        {
            float3 top = float3(0, 0, middle + side * half);
            float3 foot = float3(0, -deep, middle + side * (half - run));
            float3 normal = float3(0, Math.Cos(slope), -side * Math.Sin(slope));
            mut Fixture ramp = Turned((top + foot) * .5 - normal * .2, quaternion.Euler(-side * slope, 0, 0), float3(19.6, .4, Math.Sqrt(deep * deep + run * run)),
                                      hazard == 2 ? Color(.62, .95, 1) : Color(.62, .6, .56));
            ramp.cell = hazard == 2 ? 3 : 2;
            optics.dynamic.Add(ramp);
        }
    }
    if (hazard == 1 || hazard == 2)
    {
        // The liquid itself, which hides what's in it
        float surface = hazard == 1 ? PIT_SURFACE : POOL_SURFACE;
        float swell = Math.Sin(optics.phase) * .02;
        mut Fixture liquid = Block(float3((PitFrom(arena.level) + PitTo(arena.level)) * .5, surface - .02 + swell, middle),
                                   float3(PitTo(arena.level) - PitFrom(arena.level), .04, half * 2), Liquid(arena.theme), 0, .32, .95);
        liquid.kind = -1;
        optics.dynamic.Add(liquid);
        Enter(optics, 0, fold.cube, fold.cubeScale * 1.2, middle, surface, half);
        Enter(optics, 1, viewer.position + float3(0, .5 * viewer.scale, 0), viewer.scale * 1.5, middle, surface, half);
        if (partner.id != viewer.id) Enter(optics, 2, partner.position + float3(0, .5 * partner.scale, 0), partner.scale * 1.5, middle, surface, half);
        for (int index = 1; index < fold.count && index < 5; index++) Enter(optics, 2 + index, fold.spots[index], 1.1, middle, surface, half);
        Splashes(optics, Liquid(arena.theme), surface);
    }
    if (hazard == 2)
    {
        // What's in the pool: a back that breaks the water, longer than anything should be, and quick when it's
        // after something, with its head up
        float3 way = lurker.way;
        float3 across = float3(way.z, 0, -way.x);
        Color hide = Color(.05, .07, .08);
        for (int part = 0; part < 10; part++)
        {
            float wave = Math.Sin(optics.clock * (2.5 + lurker.rush * 6) - part * .8) * (.1 + part * .035);
            float3 at = lurker.at - way * (part * .62) + across * wave;
            float high = (part == 0 ? .3 : .24 - part * .018) + lurker.rush * (part < 2 ? .32 : .05) + Math.Sin(optics.clock * 3 - part) * .03;
            optics.dynamic.Add(Turned(float3(at.x, POOL_SURFACE - .12 + high * .5, at.z), quaternion.LookRotation(way, float3(0, 1, 0)),
                                      float3(.52 - part * .04, high, .68), hide, 0, .85));
            if (part > 0 && part % 2 == 0)
                optics.dynamic.Add(Turned(float3(at.x, POOL_SURFACE - .1 + high + .08, at.z), quaternion.LookRotation(way, float3(0, 1, 0)), float3(.05, .2, .3), hide, 0, .85));
        }
        if (lurker.rush > 0)
        {
            for (int eye = -1; eye <= 1; eye += 2)
                optics.dynamic.Add(Block(lurker.at + way * .3 + across * (eye * .15) + float3(0, .36, 0), float3(.07, .07, .07), Color(.9, 1, .7), 0, 1.6));
        }
        // The lanes' floats, which ride the water
        for (int float2 = 0; float2 < 40; float2++)
        {
            float x = -9.3 + float2 * .477;
            // A room's two lanes; in the long pool a line each side of every shallow, which is how they're found
            for (int lane = 0; lane < (arena.level == POOLWAY ? 6 : 2); lane++)
            {
                float z = arena.level == POOLWAY ? ShallowAt(lane / 2) + (lane % 2 == 0 ? -.8 : .8) : middle + (lane == 0 ? -.52 : .52);
                optics.dynamic.Add(Block(float3(x, POOL_SURFACE + .03 + Math.Sin(optics.phase * 2 + float2 * .7 + lane) * .015, z), float3(.2, .1, .1),
                                         float2 % 4 < 2 ? Color(.85, .1, .08) : Color(.92, .92, .88)));
            }
        }
        // Someone it has: the water thrown about over them
        if (viewer.taken > 0 && int(viewer.taken / .24) != int((viewer.taken - Math.Min(Frame.dt, .05)) / .24)) Splash(optics, float3(viewer.position.x, POOL_SURFACE, viewer.position.z), 1.3);
        if (partner.id != viewer.id && partner.taken > 0 && int(partner.taken / .24) != int((partner.taken - Math.Min(Frame.dt, .05)) / .24))
            Splash(optics, float3(partner.position.x, POOL_SURFACE, partner.position.z), 1.3);
    }
    if (hazard == 3)
    {
        // The trench's two drums: each two square beams on one axle, turning as it rolls, between its end plates
        // and on its rails, with what it grinds off the floor thrown out behind it
        float deep = PitDeep(arena.level, hazard);
        for (int which = 0; which < DrumCount(arena.level); which++)
        {
            float x = DrumAt(arena.level, arena.ticks, which);
            float lane = DrumLane(arena.level, which);
            for (int rail = -1; rail <= 1; rail += 2)
                optics.dynamic.Add(Block(float3(0, -deep + .02, lane + rail * 1.14), float3(19.4, .04, .09), steel2, 0, 0, .8));
            float rolled = x / .7;
            float3 axle = float3(x, -deep + .74, lane);
            optics.dynamic.Add(Turned(axle, quaternion.Euler(0, 0, rolled), float3(1.0, 1.0, 2.1), Color(.3, .19, .13), 0, .5));
            optics.dynamic.Add(Turned(axle, quaternion.Euler(0, 0, rolled + 45deg), float3(1.0, 1.0, 2.1), Color(.38, .06, .05), 0, .6));
            for (int end = -1; end <= 1; end += 2)
            {
                optics.dynamic.Add(Turned(axle + float3(0, 0, end * 1.1), quaternion.Euler(0, 0, rolled * .5), float3(1.5, 1.5, .08), steel2, 0, .7));
                optics.dynamic.Add(Block(axle + float3(0, 1.0, end * 1.14), float3(.12, 1.3, .12), steel2, 0, 0, .7));
            }
            optics.dynamic.Add(Block(axle + float3(0, 1.62, 0), float3(.16, .16, 2.4), steel2, 0, 0, .7));
            optics.dynamic.Add(Block(axle + float3(0, 1.8, 0), float3(.3, .2, .3), Color(1, .25, .1), 0, Math.Sin(optics.clock * 12) > 0 ? 1.6 : .2));
            for (int spark = 0; spark < 7; spark++)
            {
                int roll = Math.Hash(int2(spark + which * 9, int(optics.clock * 30)));
                float back = -DrumWay(arena.level, arena.ticks, which) * (.5 + (roll & 63) / 63.0 * .9);
                optics.dynamic.Add(Block(float3(x + back, -deep + .05 + ((roll >> 6) & 63) / 63.0 * .5, lane - 1 + ((roll >> 12) & 63) / 63.0 * 2), float3(.03, .03, .03), Color(1, .8, .3), 0, 2.2));
            }
        }
        Pieces(optics, viewer);
        if (partner.id != viewer.id) Pieces(optics, partner);
    }

    // Dust adrift where the roof lets the sun in.
    for (int i = 0; i < 260; i++)
    {
        int roll = Math.Hash(i);
        float a = (roll & 1023) / 1023.0;
        float b = ((roll >> 10) & 1023) / 1023.0;
        float c = ((roll >> 20) & 1023) / 1023.0;
        mut float3 at = float3(-5 + a * 14.5, .3 + b * 6.4, -12.6 + c * 25.2);
        at += float3(Math.Sin(optics.phase + a * 40), Math.Sin(optics.phase * 2 + b * 40) * .5, Math.Cos(optics.phase + c * 40)) * .28;
        float size = .007 + (roll & 7) * .0016;
        optics.motes.Add(Fixture { transform = float4x4.TRS(at, quaternion.Euler(a * 6, b * 6, c * 6), float3(size)), tint = Color(1, .9, .72), size = float3(size) });
    }
}

// What a fold does to the world, as a matrix: it turns it about the vertical, so that what faces into one
// wall faces out of the other.
float4x4 Across(Portal from, Portal to)
{
    float3 into = from.face;
    float3 out = -to.face;
    float ratio = to.size / from.size;
    quaternion turn = quaternion.Euler(0, Math.Atan2(out.x, out.z) - Math.Atan2(into.x, into.z), 0);
    return float4x4.TRS(to.at - Math.Rotate(turn, from.at) * ratio, turn, float3(ratio));
}

// Which end a body is part of the way through: 0 for none, or one more than the end. Its middle is before
// that wall's face and within `reach` of it, where the opening is.
int Crossing(Fold fold, float3 middle, float reach)
{
    for (int way = 0; way < 4; way++)
    {
        if (!Linked(fold, way / 2)) continue;
        Portal portal = fold.ends[way];
        float3 from = middle - portal.at;
        float depth = Math.Dot(from, portal.face);
        if (depth > -0.02 && depth < reach && Math.Abs(Math.Dot(from, FoldRight(portal.face))) < FOLD_WIDE * portal.size + 0.12
            && Math.Abs(from.y) < FOLD_HIGH * portal.size + 0.7)
            return way + 1;
    }
    return 0;
}

quaternion FoldedRotation(Portal from, Portal to, quaternion rotation)
{
    float3 forward = FoldDirection(from, to, Math.Forward(rotation));
    float3 up = FoldDirection(from, to, Math.Up(rotation));
    return quaternion.LookRotation(forward, up);
}

// The part of the window an opening covers, as a corner and a size in
// pixels: nothing where the eye can't see it, so its camera has no work.
float4 OpeningOnScreen(Portal portal, float3 eye, quaternion rotation, float2 window)
{
    float3 middle = portal.at;
    if (!portal.open || Math.Dot(eye - middle, portal.face) < -0.06) return float4(0);
    float3 forward = Math.Forward(rotation);
    float3 up = Math.Up(rotation);
    float3 right = Math.Cross(up, forward);
    float focal = window.y * 0.5 / Math.Tan(37.5deg);
    mut float2 low = window;
    mut float2 high = float2(0);
    mut int behind = 0;
    for (int corner = 0; corner < 4; corner++)
    {
        float3 at = middle + FoldRight(portal.face) * ((corner & 1) == 0 ? -FOLD_WIDE * portal.size - .04 : FOLD_WIDE * portal.size + .04)
                  + float3(0, (corner & 2) == 0 ? -FOLD_HIGH * portal.size - .04 : FOLD_HIGH * portal.size + .04, 0);
        float3 from = at - eye;
        float depth = Math.Dot(from, forward);
        if (depth < 0.05)
        {
            behind += 1;
            continue;
        }
        float2 on = float2(window.x * 0.5 + Math.Dot(from, right) / depth * focal, window.y * 0.5 - Math.Dot(from, up) / depth * focal);
        low = Math.Min(low, on);
        high = Math.Max(high, on);
    }
    if (behind == 4) return float4(0);
    if (behind > 0) return float4(0, 0, window.x, window.y);
    low = Math.Max(low - float2(3), float2(0));
    high = Math.Min(high + float2(3), window);
    if (high.x <= low.x || high.y <= low.y) return float4(0);
    return float4(low.x, low.y, high.x - low.x, high.y - low.y);
}

// Second crossings, their parents, then the room. Targets are disjoint and
// portal cameras and all visible simulation objects update in this frame.
view Render(Operator viewer, query (Operator body) operators, query (Wall wall) walls, query (Cube cube) cubes, query (Mover mover) movers, query (Ramp ramp) ramps,
            Arena arena, Fold match, Watcher watcher, Stalker stalker, Lurker lurker, Control control, Interface ui, mut Optics optics, mut Daylight day,
            mut Lens lens)
{
    if (viewer.id != control.active) return;
    if (!optics.made) MakeOptics(optics, day, lens);
    // The first frames, behind the menu, are drawn with two ends that aren't there and then with one: every
    // way a fold is drawn has been drawn once before the first real pair links, and nothing is made ready then.
    mut Fold fold = match;
    bool warming = optics.warmed < 3;
    if (warming)
    {
        for (int end = 0; end < 4; end++)
            fold.ends[end] = Portal { open = (end & 1) == 0 || optics.warmed < 2, at = float3((end & 1) == 0 ? -9.8 : 9.8, 1.3, end < 2 ? 3 : 9),
                                      face = float3((end & 1) == 0 ? 1 : -1, 0, 0), size = 1 };
        optics.warmed += 1;
    }
    // The room's boxes are the match's walls: dressed again when the chamber or their number changes
    mut int standing = 0;
    foreach (var row in walls)
        if (row.wall.chamber == arena.chamber) standing += 1;
    if (optics.dressed != arena.chamber || optics.walls != standing)
    {
        optics.architecture.Clear();
        optics.glass.Clear();
        optics.leaves.Clear();
        optics.furnishings.Clear();
        mut int number = 0;
        foreach (var row in walls)
        {
            if (row.wall.chamber != arena.chamber) continue;
            DressWall(optics, row.wall, number, arena.theme);
            number += 1;
        }
        Dress(optics, arena.level, arena.theme);
        optics.dressed = arena.chamber;
        optics.walls = standing;
    }
    float dt = Math.Min(Frame.dt, .05);
    lens.lines = LINES;
    optics.phase += dt;
    if (optics.phase >= Math.TAU) optics.phase -= Math.TAU;
    optics.clock += dt;
    if (optics.clock >= 3600) optics.clock -= 3600;
    float pace = Math.Saturate(Math.Length(viewer.velocity.xz) / 4) * (viewer.grounded ? 1.0 : 0.0);
    optics.stride += dt * 9.5;
    if (optics.stride >= Math.TAU) optics.stride -= Math.TAU;
    // The device kicks for its holder's own shots, and anyone's fizzle
    for (int end = 0; end < 4; end++)
    {
        if (end / 2 == viewer.id && Math.DistanceSq(optics.lastAt[end], fold.ends[end].at) > 0.0001) optics.fired = 1;
        optics.lastAt[end] = fold.ends[end].at;
    }
    if (fold.fizzleTime > 0.55 && fold.fizzleEnd / 2 == viewer.id) optics.fired = 1;
    optics.fired = Math.Max(0, optics.fired - dt * 4);

    mut var partner = viewer;
    foreach (var row in operators)
        if (row.body.id != viewer.id) partner = row.body;
    mut float3 eye = viewer.position + float3(0, 1.55 * viewer.scale, 0);
    // In the hands' grip the eye is shaken, and in a lift going down
    if (viewer.taken > 0) eye += float3(Math.Sin(optics.clock * 61), Math.Sin(optics.clock * 83), Math.Cos(optics.clock * 71)) * (.03 * Math.Saturate(viewer.taken * 4));
    // ...and pulled under in a pool
    int hazard = Hazard(arena.level, arena.theme);
    if (hazard == 2 && viewer.taken > 0) eye.y -= Math.Saturate(viewer.taken * 1.3) * 1.25;
    float riding = Math.Max(Math.Saturate(arena.ride * 3), arena.arrive < 0.6 && arena.rode == arena.chamber ? 1.0 : 0.0);
    eye += float3(Math.Sin(optics.clock * 47), Math.Sin(optics.clock * 39), 0) * (.012 * riding);
    mut quaternion rotation = quaternion.Euler(-viewer.pitch, viewer.yaw, 0);
    if (warming)
    {
        eye = float3(0, 2, -8);
        rotation = quaternion.identity;
    }
    else if (ui.open)
    {
        // Behind the menu the atrium is seen from a camera of its own, adrift.
        eye = float3(-3.6 + Math.Sin(optics.phase) * .45, 2.5 + Math.Sin(optics.phase * 2) * .06, -12.2);
        rotation = quaternion.Euler(-.05, .04 + Math.Cos(optics.phase) * .015, 0);
        if (arena.level == DARK)
        {
            eye = float3(-2.8 + Math.Sin(optics.phase) * .3, 3.2, -15);
            rotation = quaternion.Euler(.12, .2 + Math.Cos(optics.phase) * .015, 0);
        }
        if (arena.level == SIGHT)
        {
            eye = float3(-4.5 + Math.Sin(optics.phase) * .3, 7.6, -1);
            rotation = quaternion.Euler(.3, .45 + Math.Cos(optics.phase) * .015, 0);
        }
        if (arena.level == SHAFT)
        {
            // ...which in the shaft looks down its far room from over the near ledge
            eye = float3(5.5 + Math.Sin(optics.phase) * .45, 8.2, 10.8);
            rotation = quaternion.Euler(.42, -.32 + Math.Cos(optics.phase) * .015, 0);
        }
    }
    // Each end's camera: the eye, as far past the end's other as it is before this one
    Portal e0 = fold.ends[0];
    Portal e1 = fold.ends[1];
    Portal e2 = fold.ends[2];
    Portal e3 = fold.ends[3];
    float3[4] eyes = [FoldPoint(e0, e1, eye), FoldPoint(e1, e0, eye), FoldPoint(e2, e3, eye), FoldPoint(e3, e2, eye)];
    quaternion[4] turns = [FoldedRotation(e0, e1, rotation), FoldedRotation(e1, e0, rotation), FoldedRotation(e2, e3, rotation), FoldedRotation(e3, e2, rotation)];
    float4x4[4] across = [Across(e0, e1), Across(e1, e0), Across(e2, e3), Across(e3, e2)];
    Furnish(optics, arena, fold, lurker, viewer, partner);
    if (!ui.open) Handheld(optics, eye, rotation, pace, fold.holding[viewer.id] > 0 ? 1.0 : 0.0, viewer.scale);
    // Both operators as they stand or run, and each again at a fold's other end while part of the way through it.
    Pose partnerPose = FigurePose(partner, optics.clock);
    Pose selfPose = FigurePose(viewer, optics.clock + 1.7);
    float4x4 partnerPlace = FigurePlace(partner);
    float4x4 selfPlace = FigurePlace(viewer);
    int partnerFold = Crossing(fold, partner.position + float3(0, .9 * partner.scale, 0), .55 * partner.scale);
    int selfFold = Crossing(fold, viewer.position + float3(0, .9 * viewer.scale, 0), .55 * viewer.scale);
    // What the room moves: a deck with a warning along its edges and a lamp under each corner. And its slopes
    foreach (var row in movers)
    {
        if (row.mover.chamber != arena.chamber) continue;
        float3 at = row.mover.at;
        float3 size = row.mover.size;
        if (size.y > 1)
        {
            // A door: a shutter, with the color of its plate down its edges
            optics.dynamic.Add(Faced(at, quaternion.identity, size, SHUTTER, 0, Color(.8, .8, .8)));
            for (int edge = -1; edge <= 1; edge += 2)
                optics.dynamic.Add(Block(at + float3(edge * (size.x * .5 - .08), 0, 0), float3(.06, size.y - .1, size.z + .04), Color(.45, 1, .3), 0, .8));
            continue;
        }
        mut Fixture deck = Block(at, size, Color(.5, .52, .5), 0, 0, .5);
        deck.cell = 4;
        deck.tiles = .5;
        optics.dynamic.Add(deck);
        for (int edge = 0; edge < 4; edge++)
        {
            float3 side = edge == 0 ? float3(size.x * .5, 0, 0) : edge == 1 ? float3(-size.x * .5, 0, 0) : edge == 2 ? float3(0, 0, size.z * .5) : float3(0, 0, -size.z * .5);
            optics.dynamic.Add(Block(at + side * .98 + float3(0, size.y * .5 + .01, 0), edge < 2 ? float3(.12, .03, size.z) : float3(size.x, .03, .12), Color(.95, .72, .08), 0, .3));
            optics.dynamic.Add(Block(at + side * .8 - float3(0, size.y * .5 + .04, 0), float3(.14, .08, .14), Color(.3, 1, .4), 0,
                                     Math.Length(row.mover.velocity) > .05 ? 1.6 : .4));
        }
    }
    foreach (var row in ramps)
    {
        if (row.ramp.chamber != arena.chamber || row.ramp.paint < 0) continue;
        mut Fixture slope = Turned(row.ramp.at, quaternion.Euler(row.ramp.tilt, 0, 0), row.ramp.size, Color(.7, .68, .64));
        slope.cell = row.ramp.paint;
        optics.dynamic.Add(slope);
    }
    // Every loose thing; the first that's part of the way through a fold is drawn again at its other end
    mut int cubeFold = 0;
    foreach (var row in cubes)
    {
        if (row.cube.chamber != arena.chamber) continue;
        int through = cubeFold == 0 ? Crossing(fold, row.cube.at, .7 * row.cube.scale) : 0;
        if (through > 0) cubeFold = through;
        Loose(optics, row.cube, through > 0);
    }
    float4x4 partnerEcho = Math.Mul(across[Math.Max(partnerFold - 1, 0)], partnerPlace);
    float4x4 selfEcho = Math.Mul(across[Math.Max(selfFold - 1, 0)], selfPlace);
    for (int i = 0; i < optics.cubeParts.count && cubeFold > 0; i++)
    {
        mut Fixture again = optics.cubeParts[i];
        again.transform = Math.Mul(across[cubeFold - 1], again.transform);
        optics.cubeEcho.Add(again);
    }
    // The watcher, where the match has it.
    bool watched = watcher.state != Watching.Away;
    // The lamps: out as a watcher comes, failing as the lift goes down, and few between the rooms
    mut float lamps = watcher.blink > 0 ? 0.0 : 1.0;
    if (riding > 0) lamps *= Math.Sin(optics.clock * 31) + Math.Sin(optics.clock * 53) > 0.6 ? 0.7 : 0.04;
    if (arena.level == BETWEEN) lamps *= stalker.dark ? 0.0 : 0.22;
    else if (Between(arena.level)) lamps *= 0.45;
    lens.grade = arena.theme == 1 ? float3(0.86, 1.0, 1.08) : arena.theme == 2 ? float3(0.95, 0.86, 0.8) : float3(1, 1, 1);
    lens.murk = arena.theme == 1 ? float3(0.008, 0.11, 0.14) : float3(0.16, 0.006, 0.005);
    float4x4 watcherPlace = float4x4.TRS(watcher.at, quaternion.Euler(0, watcher.yaw, 0), float3(FIGURE_SCALE * (arena.level == BETWEEN ? 1.5 : 1.12)));
    // What's between the rooms doesn't so much as breathe
    // ...and is caught mid-stride wherever it's seen, never as it was
    Pose watcherPose = arena.level == BETWEEN ? FigurePose(Operator { position = watcher.at, grounded = true, velocity = float3(0, 0, 4.5) }, stalker.walked * 0.37)
                                              : FigurePose(Operator { position = watcher.at, grounded = true }, optics.clock + 3.1);
    mut float caught = watcher.state == Watching.Lunging && watcher.victim == viewer.id && !ui.open ? 1 - Math.Saturate(watcher.timer / 0.75) * 0.6 : 0.0;
    if (arena.caught > 0 && !ui.open) caught = 1;
    float gripped = ui.open || viewer.taken <= 0 ? 0.0 : viewer.shredded ? 1.0 : Math.Saturate(viewer.taken / 0.3) * 0.75;
    lens.sunk = !ui.open && viewer.taken > 0 && !viewer.shredded && eye.y < (hazard == 2 ? POOL_SURFACE : PIT_SURFACE) - .04 ? 1.0 : 0.0;
    lens.scare = Math.Max(Math.Max(caught, gripped), lens.scare - dt * 2.5);
    lens.under = ui.open ? 0.0 : Math.Max(Math.Saturate((viewer.taken - (viewer.shredded ? 0.25 : 1.1)) / ((viewer.shredded ? SHRED_FOR : TAKEN_FOR) - (viewer.shredded ? 0.4 : 1.15))),
                                          Math.Saturate((arena.caught - 0.35) / (CAUGHT - 0.45)));

    float2 window = float2(Screen.width, Screen.height);
    // An end's camera only draws the part of the window its opening covers,
    // and a second crossing only where the first can see its own end again.
    mut float4[4] seen = [float4(0), float4(0), float4(0), float4(0)];
    mut bool[4] again = [false, false, false, false];
    for (int end = 0; end < 4; end++)
    {
        if (!Linked(fold, end / 2)) continue;
        Portal here = fold.ends[end];
        Portal there = fold.ends[end ^ 1];
        seen[end] = OpeningOnScreen(here, eye, rotation, window);
        again[end] = seen[end].z > 0 && Math.Dot(here.at - there.at, there.face) > -1.2 && Math.Dot(eyes[end] - here.at, here.face) > 0;
    }
    // What each end's camera sees of the other fold's two ends, to follow those too
    mut float4[8] crossSeen = [float4(0), float4(0), float4(0), float4(0), float4(0), float4(0), float4(0), float4(0)];
    for (int end = 0; end < 4; end++)
    {
        if (seen[end].z <= 0) continue;
        for (int k = 0; k < 2; k++)
        {
            int other = ((end / 2) ^ 1) * 2 + k;
            Portal out = fold.ends[end ^ 1];
            if (!Linked(fold, other / 2) || Math.Dot(fold.ends[other].at - out.at, out.face) < -1.2) continue;
            crossSeen[end * 2 + k] = OpeningOnScreen(fold.ends[other], eyes[end], turns[end], window);
        }
    }
    // What every draw of the room is given: where things are, the lights, and all four ends
    mut Sight base = Sight { eye = eye, cube = fold.cube, partner = partner.position, self = viewer.position, phase = optics.phase,
                             plateA = PlatePosition(arena.level, 0) + float3(0, .35, 0), plateB = PlatePosition(arena.level, 1) + float3(0, .35, 0),
                             plates = float2(arena.plateA ? 1 : 0, arena.plateB ? 1 : 0),
                             grid = float2(lens.lines * Screen.width / Screen.height, lens.lines) * .5, lamps = lamps,
                             torchAt = viewer.position + float3(0, 1.35 * viewer.scale, 0), torchWay = LookDirection(viewer.yaw, viewer.pitch),
                             otherAt = partner.position + float3(0, 1.35 * partner.scale, 0), otherWay = LookDirection(partner.yaw, partner.pitch) };
    // With every light out the torches are out too
    if (arena.level == BETWEEN && stalker.dark)
    {
        base.torchWay = float3(0, 0, 0);
        base.otherWay = float3(0, 0, 0);
    }
    // The dark passage's lamps are its plate's
    if (arena.level == DARK)
    {
        base.dim = float4(-5, 5, -12, 7);
        base.dimmed = arena.plateC ? 1.0 : 0.03;
    }
    for (int end = 0; end < 4; end++)
    {
        base.foldAt[end] = fold.ends[end].at + fold.ends[end].face * .55;
        base.foldFace[end] = fold.ends[end].face;
        base.foldSize[end] = fold.ends[end].size;
        base.foldOn[end] = Linked(fold, end / 2) ? 1.0 : 0.0;
    }
    // Everything that stops a light, drawn from where the light is: the sun's image of the whole atrium, and
    // each end's lamp's of what's before its wall.
    mut Sight held = Sight { phase = optics.phase };
    for (int lamp = 0; lamp < 5; lamp++)
    {
        var map = lamp == 0 ? day.map : lamp == 1 ? day.fold0 : lamp == 2 ? day.fold1 : lamp == 3 ? day.fold2 : day.fold3;
        if (lamp == 0)
        {
            map.Clear(Color.white);
            map.SetCamera(float4x4.TRS(float3(0, 3.6, 3.2) + SunWay() * 45, quaternion.LookRotation(-SunWay(), float3(0, 0, 1)), float3(1)),
                          float4x4.Ortho(SUN_WIDE, SUN_LONG, 0, 90));
            day.toSun = map.WorldToClip();
        }
        else
        {
            Portal portal = fold.ends[lamp - 1];
            if (!Linked(fold, (lamp - 1) / 2)) continue;
            map.Clear(Color.white);
            map.SetCamera(float4x4.TRS(portal.at + portal.face * .55, quaternion.LookRotation(portal.face, float3(0, 1, 0)), float3(1)),
                          float4x4.PerspectiveFov(140deg, 1, .12, 9));
            day.toFold[lamp - 1] = map.WorldToClip();
        }
        map.Instanced(optics.box, optics.triangles, optics.architecture);
        map.Instanced(optics.box, optics.triangles, optics.furnishings);
        map.Instanced(optics.box, optics.triangles, optics.dynamic);
        map.Instanced(optics.box, optics.triangles, optics.cubeParts);
        map.Instanced(optics.box, optics.triangles, optics.cubeRest);
        map.Instanced(optics.box, optics.triangles, optics.cubeEcho);
        map.SkinnedMesh(figure, partnerPlace, partnerPose);
        map.SkinnedMesh(figure, selfPlace, selfPose);
        if (watched) map.SkinnedMesh(figure, watcherPlace, watcherPose);
        if (partnerFold > 0) map.SkinnedMesh(figure, partnerEcho, partnerPose);
        map.Cull(Cull.None)
        {
            map.Instanced(optics.blade, optics.bladeTriangles, optics.leaves, Sway, held);
        }
    }
    // First each end's camera's looks into the other fold (pass -1). Then passes 0 to 3 are each end's second
    // crossing, 4 to 7 each end's own camera, and 8 the room.
    for (int step = 0; step < 17; step++)
    {
        int pass = step < 8 ? -1 : step - 8;
        mut int through = pass & 3;
        if (pass < 0)
        {
            if (crossSeen[step].z <= 0) continue;
            through = ((step / 4) ^ 1) * 2 + (step & 1);
        }
        if ((pass >= 0 && pass < 4 && !again[through]) || (pass >= 4 && pass < 8 && seen[through].z <= 0)) continue;
        Portal near = fold.ends[through];
        Portal far = fold.ends[through ^ 1];
        float4 rect = pass < 0 ? crossSeen[step] : seen[through];
        mut var target = optics.scene;
        mut float3 camera = eye;
        mut quaternion turned = rotation;
        mut float2 pixels = window * RENDER;
        mut Sight sight = base;
        if (pass < 0)
        {
            target = step == 0 ? optics.cross0 : step == 1 ? optics.cross1 : step == 2 ? optics.cross2 : step == 3 ? optics.cross3
                   : step == 4 ? optics.cross4 : step == 5 ? optics.cross5 : step == 6 ? optics.cross6 : optics.cross7;
            camera = FoldPoint(near, far, eyes[step / 2]);
            turned = FoldedRotation(near, far, turns[step / 2]);
            pixels = window * (RENDER * .5);
        }
        else if (pass < 4)
        {
            target = through == 0 ? optics.deep0 : through == 1 ? optics.deep1 : through == 2 ? optics.deep2 : optics.deep3;
            camera = FoldPoint(near, far, eyes[through]);
            turned = FoldedRotation(near, far, turns[through]);
            pixels = window * (RENDER * .5);
        }
        else if (pass < 8)
        {
            target = through == 0 ? optics.first0 : through == 1 ? optics.first1 : through == 2 ? optics.first2 : optics.first3;
            camera = eyes[through];
            turned = turns[through];
        }
        if (pass < 8)
        {
            // A fold's camera looks out of the end's other, and sees nothing behind that wall's face
            sight.clipPoint = far.at;
            sight.clipNormal = far.face;
            sight.clipped = true;
            sight.packed = true;
            float part = pass < 4 ? RENDER * .5 : RENDER;
            target.SetScreen();
            target.SetClip(Rect(rect.x * part, rect.y * part, rect.z * part, rect.w * part));
        }
        sight.eye = camera;
        target.Clear(Color(.02, .03, .04));
        target.SetCamera(float4x4.TRS(camera, turned, float3(1)), float4x4.PerspectiveFov(75deg, Screen.width / Screen.height, pass == 8 ? .07 * viewer.scale : .07, 90));
        if (pass >= 0 && pass < 4) optics.farViews[through] = target.WorldToClip();
        else if (pass < 8) optics.views[through] = target.WorldToClip();
        // The room has a hole where each fold is. What's part of the way through a fold stops at that wall's
        // face, and is drawn again where the fold puts it, stopped at that face: whole from either side.
        mut Sight room = sight;
        room.cut = true;
        target.Instanced(optics.box, optics.triangles, optics.architecture, kit, Snap, Surface, room);
        target.Instanced(optics.box, optics.triangles, optics.glass, kit, Snap, Surface, sight);
        target.Instanced(optics.box, optics.triangles, optics.furnishings, kit, Snap, Surface, room);
        target.Instanced(optics.box, optics.triangles, optics.dynamic, kit, Snap, Surface, sight);
        mut Sight here = sight;
        mut Sight there = sight;
        here.fold = cubeFold;
        there.fold = cubeFold > 0 ? ((cubeFold - 1) ^ 1) + 1 : 0;
        there.echoed = true;
        there.back = across[(Math.Max(cubeFold, 1) - 1) ^ 1];
        target.Instanced(optics.box, optics.triangles, optics.cubeRest, kit, Snap, Surface, sight);
        target.Instanced(optics.box, optics.triangles, optics.cubeParts, kit, Snap, Surface, here);
        if (cubeFold > 0) target.Instanced(optics.box, optics.triangles, optics.cubeEcho, kit, Snap, Surface, there);
        target.Cull(Cull.None)
        {
            target.Instanced(optics.blade, optics.bladeTriangles, optics.leaves, kit, Sway, Surface, sight);
        }
        // The partner, and the viewer's own body where a fold's camera or the menu's can see it. The viewer's
        // own, at a fold's other end, isn't drawn around the camera that looks out of that end.
        here.fold = partnerFold;
        there.fold = partnerFold > 0 ? ((partnerFold - 1) ^ 1) + 1 : 0;
        there.back = across[(Math.Max(partnerFold, 1) - 1) ^ 1];
        if (partner.id == 0)
        {
            target.SkinnedMesh(figure, partnerPlace, partnerPose, skinA, Snap, Figure, here);
            if (partnerFold > 0) target.SkinnedMesh(figure, partnerEcho, partnerPose, skinA, Snap, Figure, there);
        }
        else
        {
            target.SkinnedMesh(figure, partnerPlace, partnerPose, skinB, Snap, Figure, here);
            if (partnerFold > 0) target.SkinnedMesh(figure, partnerEcho, partnerPose, skinB, Snap, Figure, there);
        }
        here.fold = selfFold;
        there.fold = selfFold > 0 ? ((selfFold - 1) ^ 1) + 1 : 0;
        there.back = across[(Math.Max(selfFold, 1) - 1) ^ 1];
        bool own = pass < 8 || ui.open;
        bool ownAgain = selfFold > 0 && pass != selfFold + 3;
        if (viewer.id == 0)
        {
            if (own) target.SkinnedMesh(figure, selfPlace, selfPose, skinA, Snap, Figure, here);
            if (ownAgain) target.SkinnedMesh(figure, selfEcho, selfPose, skinA, Snap, Figure, there);
        }
        else
        {
            if (own) target.SkinnedMesh(figure, selfPlace, selfPose, skinB, Snap, Figure, here);
            if (ownAgain) target.SkinnedMesh(figure, selfEcho, selfPose, skinB, Snap, Figure, there);
        }
        if (watched) target.SkinnedMesh(figure, watcherPlace, watcherPose, skinWatcher, Snap, Figure, sight);
        if (pass == 8) held = sight;

        for (int opening = 0; opening < 4; opening++)
        {
            Portal portal = fold.ends[opening];
            if (!portal.open) continue;
            float3 normal = portal.face;
            // What's seen through a fold is drawn on the inside of a box set into its wall behind the hole: a
            // back and four sides, so that a look through the opening from any angle, straight down at its sill
            // too, lands on it, and the eye comes right up to the wall's face without reaching any of it.
            float3 p = portal.at - normal * FOLD_DEEP;
            quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
            mut Aperture aperture = Aperture { rim = FoldTint(opening), pixels = pixels, eye = camera, clipPoint = sight.clipPoint, clipNormal = sight.clipNormal,
                                               clipped = sight.clipped, packed = sight.packed, phase = sight.phase, end = opening, lamps = lamps, size = portal.size,
                                               ratio = fold.ends[opening ^ 1].size / portal.size,
                                               wall = portal.at, face = normal, right = FoldRight(portal.face) };
            // A camera sees through its own fold's ends again; another fold's ends it sees as light on a sheet
            bool deeper = pass == 8 || (pass >= 4 && opening / 2 == through / 2);
            int look = through * 2 + (opening & 1);
            bool into = pass >= 4 && pass < 8 && opening / 2 != through / 2 && crossSeen[look].z > 0;
            if (into) aperture.end = -1;
            if (pass == 8)
            {
                aperture.farEye = eyes[opening];
                aperture.fromClip = Math.Inverse(optics.views[opening]);
            }
            else if (deeper)
            {
                aperture.farEye = FoldPoint(portal, fold.ends[opening ^ 1], eyes[opening]);
                aperture.fromClip = Math.Inverse(optics.farViews[opening]);
            }
            float wide = FOLD_WIDE * 2 * portal.size + .12;
            float high = FOLD_HIGH * 2 * portal.size + .12;
            if (!Linked(fold, opening / 2))
            {
                // An end with no other end yet: its color on the wall, and nothing through it
                target.Mesh(optics.card, optics.cardTriangles, float4x4.TRS(portal.at + normal * .02, r, float3(wide, high, 1)), LastFold, aperture);
                continue;
            }
            float3 within = p + normal * (FOLD_DEEP * .5);
            target.Cull(Cull.None)
            {
                for (int face = 0; face < 5; face++)
                {
                    mut float4x4 transform = float4x4.TRS(p, r, float3(wide, high, 1));
                    if (face == 1 || face == 2)
                        transform = float4x4.TRS(within + FoldRight(portal.face) * (face == 1 ? -wide * .5 : wide * .5), Math.Mul(r, quaternion.Euler(0, 90deg, 0)),
                                                 float3(FOLD_DEEP, high, 1));
                    else if (face > 2)
                        transform = float4x4.TRS(within + float3(0, face == 3 ? -high * .5 : high * .5, 0), Math.Mul(r, quaternion.Euler(90deg, 0, 0)), float3(wide, FOLD_DEEP, 1));
                    if (into)
                    {
                        if (look == 0) target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross0.color, ThroughFar, aperture);
                        else if (look == 1) target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross1.color, ThroughFar, aperture);
                        else if (look == 2) target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross2.color, ThroughFar, aperture);
                        else if (look == 3) target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross3.color, ThroughFar, aperture);
                        else if (look == 4) target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross4.color, ThroughFar, aperture);
                        else if (look == 5) target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross5.color, ThroughFar, aperture);
                        else if (look == 6) target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross6.color, ThroughFar, aperture);
                        else target.Mesh(optics.card, optics.cardTriangles, transform, optics.cross7.color, ThroughFar, aperture);
                    }
                    else if (!deeper) target.Mesh(optics.card, optics.cardTriangles, transform, LastFold, aperture);
                    else if (pass < 8)
                    {
                        if (opening == 0) target.Mesh(optics.card, optics.cardTriangles, transform, optics.deep0.color, ThroughFar, aperture);
                        else if (opening == 1) target.Mesh(optics.card, optics.cardTriangles, transform, optics.deep1.color, ThroughFar, aperture);
                        else if (opening == 2) target.Mesh(optics.card, optics.cardTriangles, transform, optics.deep2.color, ThroughFar, aperture);
                        else target.Mesh(optics.card, optics.cardTriangles, transform, optics.deep3.color, ThroughFar, aperture);
                    }
                    else
                    {
                        if (opening == 0) target.Mesh(optics.card, optics.cardTriangles, transform, optics.first0.color, ThroughAir, aperture);
                        else if (opening == 1) target.Mesh(optics.card, optics.cardTriangles, transform, optics.first1.color, ThroughAir, aperture);
                        else if (opening == 2) target.Mesh(optics.card, optics.cardTriangles, transform, optics.first2.color, ThroughAir, aperture);
                        else target.Mesh(optics.card, optics.cardTriangles, transform, optics.first3.color, ThroughAir, aperture);
                    }
                }
            }
        }
        target.Depth(Depth.Read), target.Blend(Blend.Add)
        {
            for (int opening = 0; opening < 4; opening++)
            {
                Portal portal = fold.ends[opening];
                if (!portal.open) continue;
                float3 normal = portal.face;
                quaternion r = quaternion.LookRotation(normal, float3(0, 1, 0));
                Aperture aperture = Aperture { rim = FoldTint(opening), pixels = pixels, eye = camera, clipPoint = sight.clipPoint, clipNormal = sight.clipNormal,
                                               clipped = sight.clipped, packed = sight.packed, phase = sight.phase, size = portal.size,
                                               wall = portal.at, face = normal, right = FoldRight(portal.face) };
                target.Mesh(optics.card, optics.cardTriangles, float4x4.TRS(portal.at + normal * .052, r,
                                                                            float3(FOLD_WIDE * 2 * portal.size + 1.7, FOLD_HIGH * 2 * portal.size + 1.6, 1)), Halo, aperture);
            }
            if (pass >= 4) target.Instanced(optics.box, optics.triangles, optics.motes, Mote, sight);
        }
    }

    // The air's glow, what spills from the brightest things, then the picture.
    // The air is lit by the room's depth, before depth is set back for what's in the hand.
    lens.pixel = float2(1 / Screen.width, 1 / Screen.height);
    lens.phase = optics.phase;
    Draw.Blit(optics.scene.color, lens.air, Shafts, Ray { fromClip = Math.Inverse(optics.scene.WorldToClip()), eye = eye, lamps = lamps });
    Draw.Blit(optics.scene.color, lens.reach, HowFar, Ray { fromClip = Math.Inverse(optics.scene.WorldToClip()), eye = eye, lamps = lamps });
    lens.far = lens.reach.color;
    if (!ui.open)
    {
        held.held = true;
        optics.scene.ClearDepth();
        optics.scene.Instanced(optics.box, optics.triangles, optics.device, kit, Snap, Surface, held);
        optics.scene.Instanced(optics.ball, optics.ballTriangles, optics.deviceBalls, kit, Snap, Surface, held);
        optics.scene.Instanced(optics.tube, optics.tubeTriangles, optics.deviceTubes, kit, Snap, Surface, held);
    }
    Draw.Blit(optics.scene.color, lens.half, Bright);
    Draw.Blit(lens.half.color, lens.quarter, Halve);
    Draw.Blit(lens.quarter.color, lens.quarterTurn, Blur, BlurStep { along = float2(lens.pixel.x * 4, 0) });
    Draw.Blit(lens.quarterTurn.color, lens.quarter, Blur, BlurStep { along = float2(0, lens.pixel.y * 4) });
    Draw.Blit(lens.quarter.color, lens.eighth, Halve);
    Draw.Blit(lens.eighth.color, lens.eighthTurn, Blur, BlurStep { along = float2(lens.pixel.x * 8, 0) });
    Draw.Blit(lens.eighthTurn.color, lens.eighth, Blur, BlurStep { along = float2(0, lens.pixel.y * 8) });
    Draw.Blit(lens.eighth.color, lens.sixteenth, Halve);
    Draw.Blit(lens.sixteenth.color, lens.sixteenthTurn, Blur, BlurStep { along = float2(lens.pixel.x * 16, 0) });
    Draw.Blit(lens.sixteenthTurn.color, lens.sixteenth, Blur, BlurStep { along = float2(0, lens.pixel.y * 16) });
    lens.shafts = lens.air.color;
    lens.near = lens.quarter.color;
    lens.mid = lens.eighth.color;
    lens.wide = lens.sixteenth.color;
    Draw.Blit(optics.scene.color, Draw.window, Develop);
}
