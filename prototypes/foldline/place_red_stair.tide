// A long descent around a blood well. The decks are visible for their whole
// cycle; every stop has room for the body left behind while playing alone.
component WellFall { }

void BuildRedStair(Arena arena, mut Place place)
{
    place.kind = PlaceKind.Passage;
    place.dead = true;
    place.light = .28;
    place.fog = .04;
    place.fogColor = float3(.055, .014, .012);
    place.grade = float3(1.12, .86, .8);
    ArrivalLift(arena, place, float3(-10.5, 8, -12.1), NORTH);
    ExitLift(arena, place, float3(10.5, 0, 17.1), SOUTH);
    DigBloodPit(arena, -8, 8, -8, 8);
    Fill(arena, -13, -8, 7.4, 8, -10, -6, RUST);
    for (int step = 0; step < 5; step++)
    {
        float top = 8 - (step + 1) * .4;
        Fill(arena, -13, -8, top - .6, top, -6 + step * .65, -6 + (step + 1) * .65, CONCRETE);
    }
    Fill(arena, -13, -8, 5.4, 6, -2.75, -1.5, RUST);
    Fill(arena, -13, -8, 5.4, 6, 4.5, 12, RUST);
    HangDeck(arena, float3(-10.5, 5.85, -1.5), float3(-10.5, 5.85, 4.5), float3(3, .3, 3), speed: 1.6);
    for (int step = 0; step < 8; step++)
    {
        float top = 6 - (step + 1) * .375;
        Fill(arena, -8 + step * .8, -8 + (step + 1) * .8, top - .6, top, 8, 12, CONCRETE);
    }
    Fill(arena, -1.6, 13, 2.4, 3, 8, 12, RUST);
    Fill(arena, 9, 13, 2.4, 3, 3, 8, RUST);
    Fill(arena, 9, 13, 2.4, 3, -8, -3, RUST);
    HangDeck(arena, float3(10.5, 2.85, 3), float3(10.5, 2.85, -3), float3(3, .3, 3), speed: 1.6);
    for (int step = 0; step < 8; step++)
    {
        float top = 3 - (step + 1) * .375;
        Fill(arena, 9 - (step + 1) * .75, 9 - step * .75, top - .6, top, -12, -8, CONCRETE);
    }
    Fill(arena, 2, 3.5, -1, 0, -14, -8, RUST);
    Fill(arena, 3, 13, -1, 0, -14, -12, RUST);
    Fill(arena, 9, 13, -1, 0, -12, 15, RUST);
    Fill(arena, 7.5, 9, -1, 0, 12, 15, RUST);
    // The south return corridor lies beyond the last stair, inside this
    // outer wall. Neither its floor nor the bottom landing overlaps the wall.
    // Outer walls, with actual openings for the two lift shells.
    Fill(arena, -14, -13, -4, 14, -15, 16, CONCRETE);
    Fill(arena, 13, 14, -4, 14, -15, 16, CONCRETE);
    Fill(arena, -14, -13.5, -4, 14, -15, -14, CONCRETE);
    Fill(arena, -7.5, 14, -4, 14, -15, -14, CONCRETE);
    Fill(arena, -14, 7.5, -4, 14, 15, 16, CONCRETE);
    Fill(arena, 13.5, 14, -4, 14, 15, 16, CONCRETE);
    Fill(arena, -14, 14, 14, 15, -15, 16, CONCRETE, false, 2);
    // Railings border the void, never a boarding edge.
    Raise(arena, float3(-8.15, 6.6, 6.5), float3(.12, 1.2, 2.8), RUST, false, 4);
    Raise(arena, float3(3, 3.6, 8.15), float3(11.4, 1.2, .12), RUST, false, 4);
    Raise(arena, float3(8.85, 3.6, 6), float3(.12, 1.2, 4), RUST, false, 4);
    var falling = SpawnBeast(arena, BeastKind.Drowned, float3(0, 10, 0), clip: "Crawl");
    falling.Add(WellFall);
    SpawnBeast(arena, BeastKind.Crawler, float3(12.5, 10, 4), WEST, .5, clip: "Idle");
    for (int chain = 0; chain < 6; chain++)
        SetProp(arena, PropKind.Pipe, float3(-7.5 + chain * 3, 10, 0), scale: float3(.15, .15, 4));
    LampGrid(place, float2(-14, -12), float2(4, 4), 7, 7);
    for (int row = 0; row < 7; row++)
        for (int col = 0; col < 7; col++)
            if (col == 0 || col == 6 || row == 0 || row == 6) HangLamp(place, col, row, 13.8, LampState.Red);
    MenuView(place, float3(-10.5, 9.55, -8), .18, .65);
}

system IntoTheWell(mut Beast beast, with WellFall, Arena arena, Place place)
{
    if (place.id != RED_STAIR || beast.chamber != arena.chamber) return;
    float falling = Math.Max(0, arena.arrive - 2);
    beast.at.y = 10 - 9 * falling * falling;
    beast.visible = beast.at.y > -1.6;
    beast.time = falling;
}
