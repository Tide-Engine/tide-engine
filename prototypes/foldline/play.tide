// FOLDLINE — a shared pair of folds, two operators, one resonant cube.
settings
{
    title = "FOLDLINE";
    tickRate = 60;
    maxPlayers = 2;
    hostMigration = true;
}

singleton Arena
{
    int level;
    float gate;
    bool solved;
    bool complete;
    bool plateA;
    bool plateB;
    bool bridge;
    int ticks;
    int joined;
    PlayerID first;
    PlayerID second;
    Entity op0;
    Entity op1;
}

singleton Fold
{
    int a = 4;
    int b = 2;
    [Position] float3 cube = float3(-3, 0.5, -8);
    float3 cubeVelocity;
    int carried = -1;
    float cubeCooldown;
    float3 ping;
    float pingTime;
    bool cubeThrough;    // The carried cube is held through a fold, at the fold's other end
    int pingOperator;
    int traversals;
}

// Something that watches from behind a pillar, in every player's match alike,
// and rarely: minutes apart. It leans out as far as half of itself, keeps the
// pillar between it and whoever is nearest, and goes back behind it when an
// operator comes near or looks at it for long: nothing is there by the time
// anyone gets round. A bold one waits, and goes for whoever comes too close.
enum Watching { Away, Peeking, Hiding, Lunging }

singleton Watcher
{
    Watching state;
    int spot;
    float wait = 100;    // Seconds until the next one, while it's away
    float timer;         // Seconds it has peeked, or lunged
    float stared;        // Seconds operators have looked at it
    float blink;         // Seconds the lamps stay out as it comes
    float lean;          // How far out from behind its pillar it is, 0 to 1
    float side = 1;      // Which side of the pillar it leans out of
    bool bold;
    int victim;
    int seen;            // How many have come, in this chamber
    float3 at;           // Where it stands, and which way it faces
    float yaw;
}

component Operator
{
    int id;
    [Position] float3 position;
    [Rotation] float yaw;
    float pitch;
    float3 velocity;
    float portalCooldown;
}

local singleton Control
{
    int active;
    bool started;
    float sensitivity = 0.003;
}

input PilotInput
{
    [Absolute, Clamp(0, 1)] int active;
    [Clamp(-1, 1)] float2 move;
    [Clamp(-0.4, 0.4)] float2 look;
    bool jump;
    bool amber;
    bool cyan;
    bool carry;
    bool ping;
    bool reset;

    Sample(Devices devices, Control control)
    {
        active = control.active;
        if (!control.started) return;
        var keys = devices.keyboard;
        move.x = (keys.d.pressed ? 1 : 0) - (keys.a.pressed ? 1 : 0);
        move.y = (keys.w.pressed ? 1 : 0) - (keys.s.pressed ? 1 : 0);
        move += devices.gamepad.leftStick;
        if (Cursor.locked) look = devices.mouse.delta * control.sensitivity;
        look += devices.gamepad.rightStick * 0.045;
        jump = keys.space.pressed || devices.gamepad.buttonSouth.pressed;
        amber = devices.mouse.left.pressed || devices.gamepad.rightTrigger > 0.3;
        cyan = devices.mouse.right.pressed || devices.gamepad.leftTrigger > 0.3;
        carry = keys.e.pressed || devices.gamepad.buttonWest.pressed;
        ping = keys.q.pressed || devices.gamepad.buttonNorth.pressed;
        reset = keys.r.pressed;
    }
}

scene Main { }
event Restart { }
command SelectChamber { int level; }

float3 OperatorStart(int id)
{
    return float3(id == 0 ? -1.4 : 1.4, 0, -9);
}

float3 CubeStart(int level)
{
    return level == 2 ? float3(-3, 0.5, -8) : float3(-3, 0.5, -6.5);
}

float3 PlatePosition(int level, int index)
{
    if (level == 0) return float3(index == 0 ? 5 : -5, 0.04, -2);
    if (level == 1) return index == 0 ? float3(5, 0.04, -4) : float3(-5, 0.04, 10);
    return index == 0 ? float3(-5, 0.04, -2) : float3(5, 0.04, 10.5);
}

int PanelCount(int level)
{
    return level >= 0 ? 6 : 0;
}

float3 PanelPosition(int level, int index)
{
    if (level < 0) return float3(0);
    switch (index)
    {
        case 0: return float3(-9.8, 1.5, -6);
        case 1: return float3(9.8, 1.5, -6);
        case 2: return float3(-9.8, 1.5, 10);
        case 3: return float3(9.8, 1.5, 10);
        case 4: return float3(-5, 1.5, 2.8);
        default: return float3(5, 1.5, 3.2);
    }
}

float3 PanelNormal(int level, int index)
{
    if (level < 0) return float3(0, 0, 1);
    switch (index)
    {
        case 0: case 2: return float3(1, 0, 0);
        case 1: case 3: return float3(-1, 0, 0);
        case 4: return float3(0, 0, -1);
        default: return float3(0, 0, 1);
    }
}

float3 PanelRight(int level, int index)
{
    return Math.Cross(float3(0, 1, 0), PanelNormal(level, index));
}

float3 PortalMapDirection(int level, int source, int destination, float3 direction)
{
    var x = Math.Dot(direction, PanelRight(level, source));
    var z = Math.Dot(direction, PanelNormal(level, source));
    return -PanelRight(level, destination) * x + float3(0, direction.y, 0)
         - PanelNormal(level, destination) * z;
}

float3 PortalMapPoint(int level, int source, int destination, float3 point)
{
    return PanelPosition(level, destination)
         + PortalMapDirection(level, source, destination, point - PanelPosition(level, source));
}

float3 LookDirection(float yaw, float pitch)
{
    var flat = Math.Cos(pitch);
    return float3(Math.Sin(yaw) * flat, Math.Sin(pitch), Math.Cos(yaw) * flat);
}

bool PortalAperture(int level, int panel, float3 center, float radius)
{
    var offset = center - PanelPosition(level, panel);
    // An opening 1.36 wide and 2.6 high that stands on the floor: its middle is 0.2 under its panel's.
    return Math.Abs(Math.Dot(offset, PanelRight(level, panel))) < 0.68 - radius
        && Math.Abs(offset.y + 0.2) < 1.3 - radius;
}

int AimedPanel(int level, float3 origin, float3 direction, float gate = 1)
{
    mut var nearest = 80.0;
    mut var chosen = -1;
    for (var i = 0; i < PanelCount(level); i++)
    {
        var normal = PanelNormal(level, i);
        var denominator = Math.Dot(direction, normal);
        if (denominator >= -0.01) continue;
        var distance = Math.Dot(PanelPosition(level, i) - origin, normal) / denominator;
        if (distance <= 0 || distance >= nearest) continue;
        var hit = origin + direction * distance;
        var relative = hit - PanelPosition(level, i);
        if (Math.Abs(Math.Dot(relative, PanelRight(level, i))) > 1.65 || Math.Abs(relative.y) > 1.6) continue;
        // The divider's opaque wings stop shots; its central passage permits them.
        if ((origin.z < 2.8 && hit.z > 3.2) || (origin.z > 3.2 && hit.z < 2.8))
        {
            var crossing = origin + direction * ((3 - origin.z) / direction.z);
            if (Math.Abs(crossing.x) > 2.1 || gate < 0.9) continue;
        }
        nearest = distance;
        chosen = i;
    }
    return chosen;
}

// Crossing the plane rotates position, horizontal look and momentum together.
bool Traverse(int level, Fold fold, float3 previousCenter, mut float3 center,
              mut float3 velocity, mut float yaw, mut float cooldown, float radius)
{
    if (fold.a == fold.b) return false;
    for (var side = 0; side < 2; side++)
    {
        var source = side == 0 ? fold.a : fold.b;
        var destination = side == 0 ? fold.b : fold.a;
        var normal = PanelNormal(level, source);
        var plane = PanelPosition(level, source);
        var before = Math.Dot(previousCenter - plane, normal);
        var after = Math.Dot(center - plane, normal);
        // From before the wall's face to past it: what comes out is as far past the other face, so the
        // crossing has no step in it, and a body is never left behind a face
        if (before < 0 || after >= 0 || !PortalAperture(level, source, center, radius)) continue;
        center = PortalMapPoint(level, source, destination, center);
        velocity = PortalMapDirection(level, source, destination, velocity);
        var facing = PortalMapDirection(level, source, destination, LookDirection(yaw, 0));
        yaw = Math.Atan2(facing.x, facing.z);
        return true;
    }
    return false;
}

bool NearOpening(int level, Fold fold, float3 center, float radius, int panel)
{
    return (fold.a == panel || fold.b == panel) && fold.a != fold.b
        && PortalAperture(level, panel, center, radius);
}

float3 Confine(int level, Arena arena, Fold fold, float3 previous, float3 proposed, float radius, bool openings = true)
{
    mut var result = proposed;
    // An active fold cuts an actual opening into its wall.
    if (!openings || !NearOpening(level, fold, result, radius, result.z < 3 ? 0 : 2))
        result.x = Math.Max(-9.8 + radius, result.x);
    if (!openings || !NearOpening(level, fold, result, radius, result.z < 3 ? 1 : 3))
        result.x = Math.Min(9.8 - radius, result.x);
    result.z = Math.Clamp(result.z, -12.7 + radius, 12.7 - radius);
    result = Around(level, result, radius);
    var doorway = Math.Abs(result.x) < 2.1 - radius && arena.gate > 0.9;
    if (!doorway)
    {
        if (previous.z <= 3 && result.z > 2.8 - radius && (!openings || !NearOpening(level, fold, result, radius, 4)))
            result.z = 2.8 - radius;
        if (previous.z > 3 && result.z < 3.2 + radius && (!openings || !NearOpening(level, fold, result, radius, 5)))
            result.z = 3.2 + radius;
    }
    return result;
}

const int OBSTACLES = 12;
const int PILLARS = 4;

// What stands on the floor and is walked around: the planters, the crates,
// the locker and the pillars, each its middle's x and z and half its size along each. A
// planter that a chamber hasn't got is nothing. render.tide draws them where
// these say they are.
float4 Obstacle(int level, int index)
{
    switch (index)
    {
        case 0: return float4(-9, -11, 0.425, 1);
        case 1: return float4(-9, -4.6, 0.425, 1);
        case 2: return float4(9, -4.6, 0.425, 1);
        case 3: return float4(-9, 1.8, 0.425, 1);
        case 4: return float4(9, 1.8, 0.425, 1);
        case 5: return level == 2 ? float4(0) : float4(9, 8.2, 0.425, 1);
        case 6: return float4(8.25, -11.05, 0.85, 1.05);
        case 7: return float4(7.6, 11.9, 0.55, 0.5);
        case 8: return float4(-6.6, -10.6, 0.45, 0.45);
        case 9: return float4(6.8, 0.6, 0.45, 0.45);
        case 10: return float4(-6.6, 12.1, 0.45, 0.45);
        default: return level == 2 ? float4(0) : float4(6.6, 6.4, 0.45, 0.45);
    }
}

// A body kept out of what stands on the floor: pushed out the short way.
float3 Around(int level, float3 at, float radius)
{
    mut var result = at;
    for (var i = 0; i < OBSTACLES; i++)
    {
        var box = Obstacle(level, i);
        if (box.z <= 0) continue;
        var from = float2(result.x - box.x, result.z - box.y);
        var inside = float2(box.z + radius - Math.Abs(from.x), box.w + radius - Math.Abs(from.y));
        if (inside.x <= 0 || inside.y <= 0) continue;
        if (inside.x < inside.y) result.x += from.x < 0 ? -inside.x : inside.x;
        else result.z += from.y < 0 ? -inside.y : inside.y;
    }
    return result;
}

bool IsPit(int level, Arena arena, float3 position)
{
    return level == 2 && position.z > 5 && position.z < 9
        && (!arena.bridge || Math.Abs(position.x) > 1.65);
}

bool Weighs(float3 position, float3 plate)
{
    return position.y < 0.8 && Math.DistanceSq(position.xz, plate.xz) < 1.2;
}

void ResetChamber(mut Arena arena, mut Fold fold, mut World world, int level)
{
    arena.level = level;
    arena.gate = 0;
    arena.solved = false;
    arena.complete = false;
    arena.plateA = false;
    arena.plateB = false;
    arena.bridge = false;
    arena.ticks = 0;
    fold.a = 4;
    fold.b = 2;
    fold.cube = CubeStart(level);
    fold.cubeVelocity = float3(0);
    fold.carried = -1;
    fold.cubeCooldown = 0;
    fold.pingTime = 0;
    fold.traversals = 0;
    world.Set<Operator>(arena.op0, Operator { id = 0, position = OperatorStart(0) });
    world.Set<Operator>(arena.op1, Operator { id = 1, position = OperatorStart(1) });
}

event(Spawned) BuildAtrium(with Main, mut Arena arena, mut Fold fold)
{
    arena.op0 = Spawn(Operator { id = 0, position = OperatorStart(0) }, Owner);
    arena.op1 = Spawn(Operator { id = 1, position = OperatorStart(1) }, Owner);
    fold.cube = CubeStart(0);
}

event(PlayerJoined joined) AssignOperator(mut Arena arena, mut World world)
{
    if (joined.player == arena.first || joined.player == arena.second) return;
    if (arena.joined == 0)
    {
        arena.first = joined.player;
        arena.joined = 1;
        world.Set<Owner>(arena.op0, Owner { player = joined.player });
        world.Set<Owner>(arena.op1, Owner { player = joined.player });
    }
    else if (arena.joined == 1)
    {
        arena.second = joined.player;
        arena.joined = 2;
        world.Set<Owner>(arena.op1, Owner { player = joined.player });
    }
}

event(PlayerLeft left) ReassignOperator(mut Arena arena, mut World world)
{
    if (left.player != arena.first && left.player != arena.second) return;
    if (left.player == arena.first) arena.first = arena.second;
    arena.second = default;
    arena.joined = Math.Max(0, arena.joined - 1);
    world.Set<Owner>(arena.op0, Owner { player = arena.first });
    world.Set<Owner>(arena.op1, Owner { player = arena.first });
}

event(Restart) RestartChamber(mut Arena arena, mut Fold fold, mut World world)
{
    ResetChamber(arena, fold, world, arena.level);
}

command(SelectChamber selection, PlayerID sender) ChooseChamber(mut Arena arena, mut Fold fold, mut World world)
{
    if (sender != arena.first && sender != arena.second) return;
    if (selection.level < 0 || selection.level > 2) return;
    ResetChamber(arena, fold, world, selection.level);
}

system MoveOperators(mut Operator body, PilotInput input, Arena arena, mut Fold fold, Time time)
{
    var controlling = arena.joined >= 2 || input.active == body.id;
    body.portalCooldown = Math.Max(0, body.portalCooldown - time.dt);
    if (controlling)
    {
        body.yaw += input.look.x;
        body.yaw = Math.Atan2(Math.Sin(body.yaw), Math.Cos(body.yaw));
        body.pitch = Math.Clamp(body.pitch + input.look.y, -1.4, 1.4);
        if (input.reset.down) Send(Restart);
        var facing = LookDirection(body.yaw, body.pitch);
        var aimed = AimedPanel(arena.level, body.position + float3(0, 1.55, 0), facing, arena.gate);
        if (input.amber.down && aimed >= 0 && aimed != fold.b) fold.a = aimed;
        if (input.cyan.down && aimed >= 0 && aimed != fold.a) fold.b = aimed;
        if (input.ping.down)
        {
            fold.ping = aimed >= 0 ? PanelPosition(arena.level, aimed) : body.position + facing * 4 + float3(0, 1.1, 0);
            fold.pingTime = 3;
            fold.pingOperator = body.id;
        }
        if (input.carry.down)
        {
            if (fold.carried == body.id)
            {
                fold.carried = -1;
                fold.cubeVelocity = facing * 2;
            }
            // Alone, the cube is taken from the hands of the body that was left holding it
            else if ((fold.carried < 0 || arena.joined < 2) && Math.DistanceSq(body.position + float3(0, 1, 0), fold.cube) < 6.25)
                fold.carried = body.id;
        }
        var movement = Math.Normalize(input.move);
        var forward = LookDirection(body.yaw, 0);
        var right = float3(forward.z, 0, -forward.x);
        var desired = (right * movement.x + forward * movement.y) * 5.2;
        body.velocity.x = Math.Lerp(body.velocity.x, desired.x, Math.Min(1, time.dt * 12));
        body.velocity.z = Math.Lerp(body.velocity.z, desired.z, Math.Min(1, time.dt * 12));
        if (input.jump.down && body.position.y <= 0.001 && !IsPit(arena.level, arena, body.position))
            body.velocity.y = 6.2;
    }
    else
    {
        body.velocity.x *= Math.Max(0, 1 - time.dt * 12);
        body.velocity.z *= Math.Max(0, 1 - time.dt * 12);
    }
    body.velocity.y -= 18 * time.dt;
    mut var previous = body.position + float3(0, 0.95, 0);
    mut var proposed = previous + body.velocity * time.dt;
    if (Traverse(arena.level, fold, previous, proposed, body.velocity, body.yaw, body.portalCooldown, 0.26))
    {
        fold.traversals += 1;
        previous = proposed;
        if (fold.carried == body.id) fold.Snap();
        this.Snap();
    }
    proposed = Confine(arena.level, arena, fold, previous, proposed, 0.26);
    body.position = proposed - float3(0, 0.95, 0);
    if (!IsPit(arena.level, arena, body.position) && body.position.y < 0)
    {
        body.position.y = 0;
        body.velocity.y = 0;
    }
    if (body.position.y < -6)
    {
        body.position = OperatorStart(body.id);
        body.velocity = float3(0);
        if (fold.carried == body.id) fold.carried = -1;
        this.Snap();
    }
    if (fold.carried == body.id)
    {
        // Held out before the body, and through a fold where the arm reaches into one: the cube is then
        // at the fold's other end, where it can be let go of.
        var hand = body.position + float3(0, 1.15, 0);
        mut var held = hand + LookDirection(body.yaw, body.pitch) * 1.25;
        mut var through = false;
        for (var side = 0; side < 2 && fold.a != fold.b && !through; side++)
        {
            var source = side == 0 ? fold.a : fold.b;
            var normal = PanelNormal(arena.level, source);
            var before = Math.Dot(hand - PanelPosition(arena.level, source), normal);
            var after = Math.Dot(held - PanelPosition(arena.level, source), normal);
            if (before < 0 || after >= 0) continue;
            var crossing = hand + (held - hand) * (before / (before - after));
            if (!PortalAperture(arena.level, source, crossing, 0.43)) continue;
            held = PortalMapPoint(arena.level, source, side == 0 ? fold.b : fold.a, held);
            through = true;
        }
        if (through != fold.cubeThrough) fold.Snap();
        fold.cubeThrough = through;
        fold.cube = Confine(arena.level, arena, fold, through ? held : hand, held, 0.43);
        fold.cubeVelocity = float3(0);
    }
}

system MoveCube(mut Fold fold, Arena arena, Time time)
{
    fold.pingTime = Math.Max(0, fold.pingTime - time.dt);
    fold.cubeCooldown = Math.Max(0, fold.cubeCooldown - time.dt);
    if (fold.carried >= 0) return;
    fold.cubeVelocity.y -= time.dt * 18;
    mut var previous = fold.cube;
    mut var proposed = fold.cube + fold.cubeVelocity * time.dt;
    mut var ignoredYaw = 0.0;
    if (Traverse(arena.level, fold, previous, proposed, fold.cubeVelocity, ignoredYaw, fold.cubeCooldown, 0.43))
    {
        fold.traversals += 1;
        previous = proposed;
    }
    fold.cube = Confine(arena.level, arena, fold, previous, proposed, 0.43);
    if (!IsPit(arena.level, arena, fold.cube) && fold.cube.y < 0.5)
    {
        fold.cube.y = 0.5;
        fold.cubeVelocity = float3(0);
    }
    if (fold.cube.y < -6)
    {
        fold.cube = CubeStart(arena.level);
        fold.cubeVelocity = float3(0);
    }
}

system EvaluateChamber(mut Arena arena, Fold fold, query (Operator body) operators, Time time)
{
    arena.ticks += 1;
    var cubeA = fold.carried < 0 && Weighs(fold.cube, PlatePosition(arena.level, 0));
    var cubeB = fold.carried < 0 && Weighs(fold.cube, PlatePosition(arena.level, 1));
    mut var operatorA = false;
    mut var operatorB = false;
    mut var exiting = 0;
    foreach (var entry in operators)
    {
        if (Weighs(entry.body.position, PlatePosition(arena.level, 0))) operatorA = true;
        if (Weighs(entry.body.position, PlatePosition(arena.level, 1))) operatorB = true;
        if (entry.body.position.z > 11 && Math.Abs(entry.body.position.x) < 3 && entry.body.position.y > -0.1) exiting += 1;
    }
    arena.plateA = cubeA || operatorA;
    arena.plateB = cubeB || operatorB;
    if (arena.level == 0 && arena.plateA) arena.solved = true;
    if (arena.level == 1 && arena.plateA && arena.plateB) arena.solved = true;
    if (arena.level == 2 && cubeA && operatorB) arena.solved = true;
    arena.bridge = arena.level == 2 && (cubeA || arena.solved);
    if (arena.solved) arena.gate = Math.Min(1, arena.gate + time.dt * 1.6);
    if (arena.solved && exiting == 2) arena.complete = true;
}

system Haunt(mut Watcher watcher, Arena arena, query (Operator body) operators, Time time)
{
    if (arena.ticks < 2)
    {
        watcher.state = Watching.Away;
        watcher.wait = 100;
        watcher.blink = 0;
        watcher.lean = 0;
        watcher.seen = 0;
    }
    watcher.blink = Math.Max(0, watcher.blink - time.dt);
    if (arena.complete) return;
    var pillar = Obstacle(arena.level, OBSTACLES - PILLARS + watcher.spot);
    var middle = float3(pillar.x, 0, pillar.y);
    mut var nearest = 1000.0;
    mut var nearestAt = middle + float3(0, 0, 1);
    mut var victimAt = middle;
    mut var victimYaw = 0.0;
    mut var looked = false;
    mut var anyoneFar = false;
    mut var nearestId = 0;
    foreach (var entry in operators)
    {
        var far = Math.Distance(entry.body.position.xz, middle.xz);
        if (far < nearest)
        {
            nearest = far;
            nearestAt = entry.body.position;
            nearestId = entry.body.id;
        }
        if (entry.body.id == watcher.victim)
        {
            victimAt = entry.body.position;
            victimYaw = entry.body.yaw;
        }
        var to = watcher.at + float3(0, 1.2, 0) - (entry.body.position + float3(0, 1.55, 0));
        var away = Math.Length(to);
        if (away < 18 && Math.Dot(to / Math.Max(away, 0.001), LookDirection(entry.body.yaw, entry.body.pitch)) > 0.93) looked = true;
        if (entry.body.position.z > 3.2) anyoneFar = true;
    }
    if (watcher.state == Watching.Away)
    {
        watcher.wait -= time.dt;
        if (watcher.wait > 0) return;
        // Behind a pillar nobody is near, or not this time
        var spot = Random.NextInt(PILLARS);
        var bold = Random.NextInt(5) == 0;
        var left = Random.NextBool();
        watcher.wait = 15;
        var chosen = Obstacle(arena.level, OBSTACLES - PILLARS + spot);
        if (chosen.z <= 0) return;
        if (spot >= 2 && !anyoneFar && arena.gate < 0.9) return;
        mut var clear = true;
        foreach (var entry in operators)
            if (Math.Distance(entry.body.position.xz, chosen.xy) < 5.5) clear = false;
        if (!clear) return;
        watcher.state = Watching.Peeking;
        watcher.spot = spot;
        watcher.bold = bold;
        watcher.side = left ? -1 : 1;
        watcher.timer = 0;
        watcher.stared = 0;
        watcher.lean = 0;
        watcher.blink = 0.16;
        watcher.seen += 1;
        return;
    }
    watcher.timer += time.dt;
    if (watcher.state == Watching.Lunging)
    {
        watcher.at = Math.Lerp(watcher.at, victimAt + LookDirection(victimYaw, 0) * 0.85, Math.Saturate(watcher.timer / 0.12));
        var back = victimAt - watcher.at;
        watcher.yaw = Math.Atan2(back.x, back.z);
        if (watcher.timer < 0.75) return;
        watcher.state = Watching.Away;
        watcher.blink = 0.2;
        watcher.lean = 0;
        watcher.wait = 150 + Random.NextInt(240);
        return;
    }
    // It keeps its pillar between itself and whoever is nearest, and leans out of one side of it
    mut var toward = nearestAt.xz - middle.xz;
    toward = nearest > 0.01 ? toward / nearest : float2(0, 1);
    var hidden = middle.xz - toward * 0.8;
    var out = float2(toward.y, -toward.x) * (watcher.side * 0.6 * watcher.lean);
    watcher.at = float3(hidden.x + out.x, 0, hidden.y + out.y);
    watcher.yaw = Math.Atan2(toward.x, toward.y);
    if (watcher.state == Watching.Hiding)
    {
        watcher.lean -= time.dt * 3.2;
        if (watcher.lean > 0) return;
        watcher.lean = 0;
        watcher.state = Watching.Away;
        watcher.wait = 150 + Random.NextInt(240);
        return;
    }
    watcher.lean = Math.Min(1, watcher.lean + time.dt * 1.6);
    if (looked) watcher.stared += time.dt;
    if (watcher.bold && nearest < 2.7)
    {
        watcher.state = Watching.Lunging;
        watcher.victim = nearestId;
        watcher.timer = 0;
        return;
    }
    if (watcher.timer > 25 || watcher.stared > 2.2 || (!watcher.bold && nearest < 5)) watcher.state = Watching.Hiding;
}
