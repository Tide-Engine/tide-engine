// FOLDLINE: two operators, a pair of folds shot onto any wall that takes one,
// and a cube that keeps its speed through them. The rooms, the operators and
// the cube are Box3D's. What each place is made of is built by its own file
// (places.tide has the list); this is what every place works by.
using Box3D;

settings
{
    title = "FOLDLINE";
    tickRate = 60;
    maxPlayers = 2;
    hostMigration = true;
}

singleton Arena
{
    int chamber;         // Counts the places built: what's of an older one is swept away
    float gate;          // How far up the exit lift's gate is, 0 to 1
    float door;          // ...and the door of the lift the place was come to by
    int signals;         // The place's signals as they are this tick: bit n is signal n
    int darkGroups;      // The groups of lamps a place's own script has put out: bit n is group n
    float3 left;         // The lift that was left by, by the middle of its floor...
    float leftWay;       // ...and the way its riders faced to go on: they stand in the one they come by as they stood
    int depth;           // How many lifts down: which place of the way down this is
    float ride;          // Seconds both have been shut in the lift: it goes down, and at RIDE they're somewhere else
    float arrive;        // Seconds since this place was come to: the lift they came by opens after a moment
    int rode = -1;       // The chamber that was come to by lift: operators keep their places in it
    float caught;        // Seconds since what's in a passage got someone: it all starts over at CAUGHT
    int ticks;
    int joined;
    PlayerID first;
    PlayerID second;
    Entity op0;
    Entity op1;
    Entity cube;
}

// What a place is: a room to solve, a passage between rooms, a lift that stops on the way, or the test bench.
enum PlaceKind { Puzzle, Passage, Vignette, Bench, Ending }

// What a lamp of a place's grid does: there's none, it burns, it's dead, it stutters, it burns red, or it burns
// only while its signal is on.
enum LampState { None, On, Dead, Stutter, Red, Signal }

// One cell of a place's lamp grid.
struct Lamp
{
    LampState state;
    float high;          // Where it hangs: under that cell's ceiling, this high
    int group;           // Which of 32 groups it's in, for a script to put out together
    int signal;          // For a lamp on a signal: which
}

const int LAMPS_WIDE = 24;
const int LAMPS_LONG = 24;

// Everything the match and the renderer need to know of the place they're in, written by its builder when it's
// built and left as it is until the next.
singleton Place
{
    int id;
    PlaceKind kind;
    float3 arrival;      // The middle of the floor of the lift it's come to by...
    float arrivalYaw;    // ...and the way that lift's doorway faces, out into the place: a quarter turn at a time
    float3 exit;         // The lift it's left by, and the way its doorway faces into the place
    float exitYaw;
    bool dead;           // The device does nothing here
    int exitNeed;        // The signals the exit's gate needs: all of them, or any with `exitAny`. None: open once come to
    bool exitAny;
    float stay = 6;      // A lift that stops on the way: seconds before its door shuts and it goes on
    // Its lamps: a grid of cells from a corner, each as big as `lampStep`; a cell a lamp hangs in, how high and
    // what it does. How much of their light there is at all
    float2 lampFrom;
    float2 lampStep = float2(5, 3.25);
    int lampsWide;
    int lampsLong;
    Lamp[576] lamps;
    float light = 1;
    float fog = 0.028;   // The air: how thick, and its color, and the cast over the whole picture
    float3 fogColor = float3(0.030, 0.034, 0.024);
    float3 grade = float3(1, 1, 1);
    int ambience;        // Which sounds the place hums with
    float3 view = float3(0, 2.5, 0);   // Where the menu's camera drifts, and how it's turned: down and about
    float2 viewTurn;
}

// One end of the fold: an opening on a wall's face. `at` is its middle, and
// `size` how many times the usual 1.36 by 2.6 meters it is.
struct Portal
{
    bool open;
    float3 at;
    float3 face = float3(0, 0, 1);
    Entity wall;
    float size = 1;
}

// Each operator has a fold of their own: two ends, shot by that operator and
// by nobody else, and walked through by anyone. Ends 0 and 1 are operator A's
// (amber and cyan), 2 and 3 operator B's (rose and violet); an end's other is
// the one beside it.
singleton Fold
{
    Portal[4] ends;
    [Position] float3 cube = float3(-3, 0.5, -8);
    [Rotation] quaternion cubeTurn = quaternion.identity;
    float cubeScale = 1;
    int carried = -1;    // Who has something in their hands, if anyone: the first of them
    // Every loose thing of the room, a cube or a crate, by its number: where it is, its size, and how many there
    // are. `cube`, above, is the first's. Each operator holds one at most (its number and one, or 0), and lets
    // go of or throws one in a tick (`tossing`, at `toss`)
    float3[8] spots;
    float[8] sizes;
    int count;
    int[2] holding;
    int[2] tossing;
    float3[2] toss;
    float[2] strained;   // Seconds since each operator tried to lift something too big for them
    float3 ping;
    float pingTime;
    int pingOperator;
    int traversals;
    int bumped;          // Counts bodies an end was too small to let through, and where the last was
    float3 bumpAt;
    int[2] busy;         // Ticks since something was in each fold's mouth: neither of its ends moves while it is
    // A shot that found no place for a fold: where, on what, and for how long it shows
    float3 fizzleAt;
    float3 fizzleFace;
    float fizzleTime;
    int fizzleEnd;
}

// Something that watches from behind a pillar, in every player's match alike,
// and rarely: minutes apart. It leans out as far as half of itself, keeps the
// pillar between it and whoever is nearest, and goes back behind it when an
// operator comes near or looks at it for long: nothing is there by the time
// anyone gets round. A bold one waits, and goes for whoever comes too close.
enum Watching { Away, Peeking, Hiding, Lunging }

singleton Watcher
{
    Watching state;
    int spot;
    float wait = 100;    // Seconds until the next one, while it's away
    float timer;         // Seconds it has peeked, or lunged
    float stared;        // Seconds operators have looked at it
    float blink;         // Seconds the lamps stay out as it comes
    float lean;          // How far out from behind its pillar it is, 0 to 1
    float side = 1;      // Which side of the pillar it leans out of
    bool bold;
    int victim;
    int seen;            // How many have come, in this chamber
    float3 at;           // Where it stands, and which way it faces
    float yaw;
}

// An operator: a capsule of Box3D's, with where its feet are for what draws it.
component Operator
{
    int id;
    [Position] float3 position;
    [Rotation] float yaw;
    float pitch;
    float3 velocity;
    float scale = 1;
    float3 last;         // Its body's middle a tick ago: a fold is crossed between the two
    bool grounded;
    float resize;        // The size it's to be made again at, 0 for as it is: a body's shape is made once
    float taken;         // How long the hands in a pit have had it, 0 while they don't
    bool shredded;       // ...or a drum has: it's in pieces, and back sooner
    float flung;         // Seconds since it was thrown, by a pad or out of a fold at speed: its speed is its own
                         // until it lands, and nothing it's told to do in the air changes it
    int chamber = -1;
}

// A loose thing: the cube, or a crate, which is lighter. All are picked up, carried through folds, thrown,
// stood on and stacked, and weigh a plate.
component Cube
{
    int index;
    int kind;            // 0 the cube, 1 a crate
    int holder = -1;
    [Position] float3 at;
    [Rotation] quaternion turn = quaternion.identity;
    float3 last;
    float3 home;         // Where it's put back, whole, when it's lost
    float scale = 1;
    int chamber;
}

// A wall, a floor, a ceiling or a thing standing on one: a box of the room.
// Its colliders are its pieces, which leave a hole where a fold is on it.
component Wall
{
    float3 center;
    float3 size;
    float paint;         // Which square of the renderer's sheet it's painted with
    float tiles = 0.5;   // ...and how many of them a meter
    bool takes;          // A fold can be put on its upright faces
    int kind;            // 0 a wall, 1 a planter, 2 a ceiling, 3 a crate, 4 a grille, 5 the lift shell, 6 a lounger,
                         // 7 a barrier
    int version;         // Counts the folds put on it and taken off
    int made;            // ...and which of those its pieces are for
    int holes;           // ...and how many whole folds' ends they were cut for
    int chamber;
}

component Piece
{
    Entity wall;
    int version;
}

component Gate { int chamber; }
component Door { int chamber; }   // The door of the lift a place is come to by
// A slope: into a pool or a trench (which the renderer draws with the pit, so `paint` is under 0), or one a
// room is built with.
component Ramp
{
    int chamber;
    float3 at;
    float3 size;
    float tilt;
    float paint = -1;
}

// A thing a room moves: a door or a platform. One with signals to need goes to its second place while they're
// on and back when they're not; one with none goes between the two by itself. Whoever stands on it goes with it.
component Mover
{
    int chamber;
    [Position] float3 at;
    float3 size;
    float3 velocity;
    float3 from;
    float3 to;
    float speed = 2.2;
    int need;            // The signals it needs: all of them, or any with `any`
    bool any;
    float3 lamp;         // The middle of its row of lamps, one for each signal it needs, and which way the row runs
    float3 lampAlong = float3(1, 0, 0);
    float lampDepth;     // Explicit surface-mounted housing depth; zero uses the door/deck default.
}

// A plate in the floor. What stands on it, and what rests on it, weighs on it, whole bodies more than small ones,
// and while that's as much as it needs it's down and its signal is on. Let up, it's up: nothing holds it down
// but weight, unless it lingers, when its signal stays on for that many seconds after.
component Plate
{
    int chamber;
    float3 at;           // The middle of its top, on the floor
    float2 half = float2(0.6, 0.6);   // Half its top, across and along
    float need = 20;     // Kilograms
    bool heavy;
    int signal;
    float linger;
    bool invert;         // Its signal is on while it's up, and off while it's down
    float load;          // What weighs on it this tick, and whether that's enough
    bool down;
    float left;          // Seconds its signal has still to linger
}

// What shows a signal's way through the place: a line along floors and walls, from a plate to what it works.
// Only drawn: the match has nothing of it but where it runs.
component Wire
{
    int chamber;
    int signal;
    int count;
    float3[12] points;
}

// A frame painted on a wall: a fold's end shot into it, or by it, is its size, and anywhere else an end is
// whole. The size is the wall's, not the shot's.
component FoldFrame
{
    int chamber;
    float3 at;           // The middle of the opening it marks, on the wall's face
    float3 face;
    float size;
}

// What throws whoever and whatever steps on it.
component Pad
{
    int chamber;
    float3 at;
    float3 launch;
}

// A pit, and what's in it: blood with no bottom and hands in it; a pool to wade, with whatever lurks there; or a
// trench to run across, with its drums. It runs from `low` to `high` along x and z, cut into a floor at `top`.
enum PitKind { Blood, Water, Trench }

component Pit
{
    int chamber;
    PitKind kind;
    float2 low;
    float2 high;
    float top;
    float deep;          // A pool's or a trench's floor is this far down, with a slope from each side this long
    float run;
    // A trench's drums, which go along x: how many, the lane each keeps to along z and its speed; and the signals
    // that stop them while they're on
    int drums;
    float[4] lanes;
    float[4] speeds;
    int brake;
    int ticks;           // How long they've turned: they stand where they are while they're stopped
}

// A pillar the watcher keeps behind.
component Pillar
{
    int chamber;
    float3 at;
}

// A maze, for what comes only while nobody sees it: cells from a corner, each as big as `cell`, and a bit a
// cell in each row where there's a wall on its east side, and on its north. It starts in the cell `start`.
component Maze
{
    int chamber;
    float2 origin;
    float2 cell;
    int wide;
    int long;
    int[16] east;
    int[16] north;
    int start;
}

// Where what moves in the dark goes: from where it starts, within `bounds` (from x to x, from z to z), standing
// wherever it is while `light`'s signals are on.
component Prowl
{
    int chamber;
    float3 start;
    float4 bounds;
    int light;
}

// What moves in the dark. It keeps to where its place lets it, stands wherever it is for as long as the lamps
// are on, and with them off goes for the nearest operator. Whoever it touches is caught.
singleton Shade
{
    int chamber = -1;
    float3 at;
    bool lit;
}

// What's in a pool. It goes about under the water, for whoever is in it, and before them for the last thing
// that splashed: a cube thrown in is a few seconds to wade across in.
singleton Lurker
{
    int chamber = -1;
    float3 at;
    float3 way = float3(1, 0, 0);
    float3 lure;
    float lureLeft;
    int wasIn;           // A bit a loose thing, set while it's in the water
    float rush;          // 1 while it's after something
}

local singleton Control
{
    int active;
    bool started;
    float sensitivity = 0.003;
}

input PilotInput
{
    [Absolute, Clamp(0, 1)] int active;
    [Clamp(-1, 1)] float2 move;
    [Clamp(-0.4, 0.4)] float2 look;
    bool jump;
    bool amber;
    bool cyan;
    bool carry;
    bool hurl;
    bool ping;
    bool reset;

    Sample(Devices devices, Control control)
    {
        active = control.active;
        if (!control.started) return;
        var keys = devices.keyboard;
        move.x = (keys.d.pressed ? 1 : 0) - (keys.a.pressed ? 1 : 0);
        move.y = (keys.w.pressed ? 1 : 0) - (keys.s.pressed ? 1 : 0);
        move += devices.gamepad.leftStick;
        if (Cursor.locked) look = devices.mouse.delta * control.sensitivity;
        look += devices.gamepad.rightStick * 0.045;
        jump = keys.space.pressed || devices.gamepad.buttonSouth.pressed;
        amber = devices.mouse.left.pressed || devices.gamepad.rightTrigger > 0.3;
        cyan = devices.mouse.right.pressed || devices.gamepad.leftTrigger > 0.3;
        carry = keys.e.pressed || devices.gamepad.buttonWest.pressed;
        hurl = keys.f.pressed || devices.gamepad.buttonEast.pressed;
        ping = keys.q.pressed || devices.gamepad.buttonNorth.pressed;
        reset = keys.r.pressed;
    }
}

scene Main { }
event Restart { }
command SelectPlace { int id; }

const float FOLD_HALF_WIDE = 0.68;
const float FOLD_HALF_HIGH = 1.3;
const float BODY_RADIUS = 0.26;
const float BODY_HIGH = 1.8;
const float EYE_HIGH = 1.55;
const float CUBE_SIDE = 0.74;
const float RIDE = 1.3;
const float CAUGHT = 1.2;
const float BLACKOUT_EVERY = 6.5;
const float BLACKOUT_FOR = 0.4;
// Which way a lift faces, or anything else that turns a quarter at a time: the yaw of what's ahead
const float NORTH = 0;
const float EAST = Math.PI * 0.5;
const float SOUTH = Math.PI;
const float WEST = -Math.PI * 0.5;
// How much things weigh, whole: a body twice the size weighs eight times as much. What presses a plate
const float OPERATOR_MASS = 86;
const float CUBE_MASS = 48;
const float CRATE_MASS = 24;
const float STANDARD_NEED = 20;
const float HEAVY_NEED = 200;
// The smallest a fold makes anything: an end that would make a body smaller is a wall to it
const float SMALLEST = 1.0 / 16;
const float BLOOD_DEPTH = 0.8;  // Where the red of a pit lies, under its floor
const float TAKEN_UNDER = 0.25; // A body's middle this far under it, a meter of the body's size, is chin deep, in the hands' reach
const float TAKEN_FOR = 1.9;    // How long they drag it down before it's gone
const float POOL_DEPTH = 0.3;   // Where a pool's water lies, under its floor
const float DRUM_SPEED = 6.0;
const float SHRED_FOR = 1.1;
const float MOVER_SPEED = 2.2;
const float MOVER_WAIT = 1.3;
const float DOOR_SPEED = 6.0;   // A door is quick: it's open while it's held, and shut as soon as it isn't

// A turn about the vertical by a yaw, a quarter turn at a time and exactly: what's ahead at no turn is +z.
float3 TurnBy(float3 v, float yaw)
{
    var quarters = (int(Math.Round(yaw / (Math.PI * 0.5))) % 4 + 4) % 4;
    if (quarters == 1) return float3(v.z, v.y, -v.x);
    if (quarters == 2) return float3(-v.x, v.y, -v.z);
    if (quarters == 3) return float3(-v.z, v.y, v.x);
    return v;
}

// A box's size, turned so: a quarter turn changes its width for its depth.
float3 TurnSize(float3 size, float yaw)
{
    var turned = TurnBy(size, yaw);
    return float3(Math.Abs(turned.x), turned.y, Math.Abs(turned.z));
}

// A place in a lift, by the middle of its floor and the way its doorway faces: `local` is across, up, and towards
// the doorway.
float3 LiftPoint(float3 middle, float yaw, float3 local)
{
    return middle + TurnBy(local, yaw);
}

// Whether feet are in a lift, clear of its doorway.
bool InLift(float3 middle, float yaw, float3 feet)
{
    var local = TurnBy(feet - middle, -yaw);
    return Math.Abs(local.x) < 3 && local.z > -1.7 && local.z < 1.4 && Math.Abs(local.y) < 0.6;
}

// Where something in the lift that was left by is in the one come by: as far from its middle, turned as the
// two lifts are.
float3 Arriving(Place place, float3 left, float leftWay, float3 point)
{
    return LiftPoint(place.arrival, place.arrivalYaw, TurnBy(point - left, -leftWay));
}

// Everyone starts in the lift they came by, facing out of it.
float3 OperatorStart(Place place, int id)
{
    return LiftPoint(place.arrival, place.arrivalYaw, float3(id == 0 ? -1.2 : 1.2, 0, 0));
}

// Whether a circuit is closed: every signal it needs is on, or with `any` one of them. One that needs none is.
bool Satisfied(int signals, int need, bool any)
{
    if (need == 0) return true;
    return any ? (signals & need) != 0 : (signals & need) == need;
}

// Where the liquid of a pit lies: a pool's water and the blood under the floor, a trench's nothing at it.
float PitSurface(Pit pit)
{
    return pit.kind == PitKind.Blood ? pit.top - BLOOD_DEPTH : pit.kind == PitKind.Water ? pit.top - POOL_DEPTH : pit.top;
}

bool InPit(Pit pit, float3 at, float margin)
{
    return at.x > pit.low.x - margin && at.x < pit.high.x + margin && at.z > pit.low.y - margin && at.z < pit.high.y + margin;
}

// How far a drum goes along its trench, and back: the trench's length less the drum's own.
float DrumReach(Pit pit)
{
    return pit.high.x - pit.low.x - 2.4;
}

// Where each drum is along the trench: one end to the other and back, each its own part of a pass behind the
// one before.
float DrumTurn(Pit pit, int which)
{
    return Math.Frac(pit.ticks / 60.0 * pit.speeds[which] / (DrumReach(pit) * 2) + which / Math.Max(float(pit.drums), 1.0));
}

float DrumAt(Pit pit, int which)
{
    var reach = DrumReach(pit);
    var along = DrumTurn(pit, which) * reach * 2;
    return (pit.low.x + pit.high.x) * 0.5 - reach * 0.5 + (along < reach ? along : reach * 2 - along);
}

float DrumWay(Pit pit, int which)
{
    return DrumTurn(pit, which) < 0.5 ? 1.0 : -1.0;
}

float3 CellMiddle(Maze maze, int cell)
{
    return float3(maze.origin.x + (cell % maze.wide + 0.5) * maze.cell.x, 0, maze.origin.y + (cell / maze.wide + 0.5) * maze.cell.y);
}

int CellAt(Maze maze, float3 place)
{
    var column = Math.Clamp(int(Math.Floor((place.x - maze.origin.x) / maze.cell.x)), 0, maze.wide - 1);
    var row = Math.Clamp(int(Math.Floor((place.z - maze.origin.y) / maze.cell.y)), 0, maze.long - 1);
    return row * maze.wide + column;
}

bool InMaze(Maze maze, float3 place)
{
    return place.x > maze.origin.x && place.x < maze.origin.x + maze.wide * maze.cell.x
        && place.z > maze.origin.y && place.z < maze.origin.y + maze.long * maze.cell.y;
}

// Whether there's a way from a cell to the one beside it: 0 east, 1 west, 2 north, 3 south.
bool MazeOpen(Maze maze, int cell, int way)
{
    var column = cell % maze.wide;
    var row = cell / maze.wide;
    if (way == 0) return column < maze.wide - 1 && (maze.east[row] & (1 << column)) == 0;
    if (way == 1) return column > 0 && (maze.east[row] & (1 << (column - 1))) == 0;
    if (way == 2) return row < maze.long - 1 && (maze.north[row] & (1 << column)) == 0;
    return row > 0 && (maze.north[row - 1] & (1 << column)) == 0;
}

int CellBeside(Maze maze, int cell, int way)
{
    return way == 0 ? cell + 1 : way == 1 ? cell - 1 : way == 2 ? cell + maze.wide : cell - maze.wide;
}

// Where a thing that goes by itself is at a tick: at one place a moment, across, at the other a moment, back.
float3 MoverAt(Mover mover, int ticks)
{
    var travel = Math.Max(Math.Distance(mover.from, mover.to) / mover.speed, 0.01);
    var cycle = (travel + MOVER_WAIT) * 2;
    var now = Math.Frac(ticks / 60.0 / cycle) * cycle;
    var along = now < MOVER_WAIT ? 0.0 : now < MOVER_WAIT + travel ? (now - MOVER_WAIT) / travel
              : now < MOVER_WAIT * 2 + travel ? 1.0 : 1 - (now - MOVER_WAIT * 2 - travel) / travel;
    return Math.Lerp(mover.from, mover.to, along);
}

// Whether feet, or the bottom of a thing, are over a plate's top: on it, or on what's on it.
bool OnPlate(Plate plate, float3 at)
{
    var off = at - plate.at;
    return Math.Abs(off.x) < plate.half.x + 0.1 && Math.Abs(off.z) < plate.half.y + 0.1 && off.y > -0.3 && off.y < 4;
}

float3 LookDirection(float yaw, float pitch)
{
    var flat = Math.Cos(pitch);
    return float3(Math.Sin(yaw) * flat, Math.Sin(pitch), Math.Cos(yaw) * flat);
}

// A fold's right, as it's looked at from before its wall.
float3 FoldRight(float3 face)
{
    return Math.Cross(float3(0, 1, 0), face);
}

bool Linked(Fold fold, int pair)
{
    return fold.ends[pair * 2].open && fold.ends[pair * 2 + 1].open;
}

// What a fold does to a direction: into one wall is out of the other, turned
// about the vertical.
float3 FoldDirection(Portal from, Portal to, float3 direction)
{
    var x = Math.Dot(direction, FoldRight(from.face));
    var z = Math.Dot(direction, from.face);
    return -FoldRight(to.face) * x + float3(0, direction.y, 0) - to.face * z;
}

// ...and to a place: as far from the other end's middle, by that end's size.
float3 FoldPoint(Portal from, Portal to, float3 point)
{
    return to.at + FoldDirection(from, to, point - from.at) * (to.size / from.size);
}

// Whether a place is within a fold's opening, seen along its wall.
bool InMouth(Portal portal, float3 point, float margin)
{
    var offset = point - portal.at;
    return Math.Abs(Math.Dot(offset, FoldRight(portal.face))) < FOLD_HALF_WIDE * portal.size + margin
        && Math.Abs(offset.y) < FOLD_HALF_HIGH * portal.size + margin;
}

// Crossing a fold: a body of a size whose middle went from before a wall's face to past it is as far past the
// other face, with its speed turned and scaled. Says by how much the body's size changes, 0 for no crossing.
// One the far end would make smaller than SMALLEST isn't let through: it's put back before the face, its speed
// into the wall gone, and that's -1.
float Traverse(mut Fold fold, float3 before, mut float3 center, mut float3 velocity, mut float yaw, float scale, out int through)
{
    through = -1;
    for (var end = 0; end < 4; end++)
    {
        if (!Linked(fold, end / 2)) continue;
        var from = fold.ends[end];
        var to = fold.ends[end ^ 1];
        var was = Math.Dot(before - from.at, from.face);
        var now = Math.Dot(center - from.at, from.face);
        if (was < 0 || now >= 0 || !InMouth(from, center, 0.3 * scale)) continue;
        var ratio = to.size / from.size;
        if (scale * ratio < SMALLEST * 0.999)
        {
            center += from.face * (0.02 * scale - now);
            velocity -= from.face * Math.Min(Math.Dot(velocity, from.face), 0);
            fold.bumped += 1;
            fold.bumpAt = center;
            return -1;
        }
        center = FoldPoint(from, to, center);
        velocity = FoldDirection(from, to, velocity) * ratio;
        var facing = FoldDirection(from, to, LookDirection(yaw, 0));
        yaw = Math.Atan2(facing.x, facing.z);
        fold.traversals += 1;
        through = end;
        return ratio;
    }
    return 0;
}

// How far a thing is from a hand, squared: straight there, or through a fold
// where that's nearer, so what lies just past a fold can be picked up.
float Reach(Fold fold, float3 hand, float3 thing)
{
    mut var nearest = Math.DistanceSq(hand, thing);
    for (var end = 0; end < 4; end++)
        if (Linked(fold, end / 2)) nearest = Math.Min(nearest, Math.DistanceSq(FoldPoint(fold.ends[end], fold.ends[end ^ 1], hand), thing));
    return nearest;
}

// Whether a body of a size is in the mouth of either end of a fold: neither is moved while one is.
bool AtMouth(Fold fold, int pair, float3 center, float reach, float scale)
{
    for (var side = 0; side < 2; side++)
    {
        var portal = fold.ends[pair * 2 + side];
        if (!portal.open) continue;
        var depth = Math.Dot(center - portal.at, portal.face);
        if (depth > -0.3 * scale && depth < reach && InMouth(portal, center, 0.1 * scale)) return true;
    }
    return false;
}

// A place is built again: the lifts' doors shut, nothing held or shot, and whatever was of the place before
// swept away. Its builder says what it is.
void ResetPlace(mut Arena arena, mut Place place, mut Fold fold, int id)
{
    arena.gate = 0;
    arena.door = 0;
    arena.signals = 0;
    arena.darkGroups = 0;
    arena.ride = 0;
    arena.arrive = 0;
    arena.caught = 0;
    arena.ticks = 0;
    arena.cube = default;
    arena.chamber += 1;
    for (var end = 0; end < 4; end++) fold.ends[end] = Portal { };
    fold.cubeTurn = quaternion.identity;
    fold.cubeScale = 1;
    fold.carried = -1;
    fold.count = 0;
    for (var index = 0; index < 8; index++)
    {
        fold.spots[index] = float3(0);
        fold.sizes[index] = 1;
    }
    for (var hand = 0; hand < 2; hand++)
    {
        fold.holding[hand] = 0;
        fold.tossing[hand] = 0;
        fold.strained[hand] = 0;
    }
    fold.pingTime = 0;
    fold.fizzleTime = 0;
    fold.traversals = 0;
    fold.busy[0] = 0;
    fold.busy[1] = 0;
    place.id = id;
    place.kind = PlaceKind.Puzzle;
    place.arrival = float3(0);
    place.arrivalYaw = 0;
    place.exit = float3(0);
    place.exitYaw = 0;
    place.dead = false;
    place.exitNeed = 0;
    place.exitAny = false;
    place.stay = 6;
    place.lampFrom = float2(0);
    place.lampStep = float2(5, 3.25);
    place.lampsWide = 0;
    place.lampsLong = 0;
    for (var cell = 0; cell < LAMPS_WIDE * LAMPS_LONG; cell++) place.lamps[cell] = Lamp { };
    place.light = 1;
    place.fog = 0.028;
    place.fogColor = float3(0.030, 0.034, 0.024);
    place.grade = float3(1, 1, 1);
    place.ambience = 0;
    place.view = float3(0, 2.5, 0);
    place.viewTurn = float2(0);
    BuildPlace(arena, place, fold, id);
}

event(Spawned) BuildAtrium(with Main, mut Arena arena, mut Place place, mut Fold fold, mut Physics physics)
{
    physics.gravity = float3(0, -18, 0);
    ResetPlace(arena, place, fold, PlaceAt(0));
    fold.Snap();
    arena.op0 = Spawn(Operator { id = 0, position = OperatorStart(place, 0) }, Owner,
                      Body { position = OperatorStart(place, 0) + float3(0, BODY_HIGH * 0.5, 0) },
                      Capsule { radius = BODY_RADIUS, height = BODY_HIGH, density = 250, friction = 0 });
    arena.op1 = Spawn(Operator { id = 1, position = OperatorStart(place, 1) }, Owner,
                      Body { position = OperatorStart(place, 1) + float3(0, BODY_HIGH * 0.5, 0) },
                      Capsule { radius = BODY_RADIUS, height = BODY_HIGH, density = 250, friction = 0 });
}

event(PlayerJoined joined) AssignOperator(mut Arena arena, mut World world)
{
    if (joined.player == arena.first || joined.player == arena.second) return;
    if (arena.joined == 0)
    {
        arena.first = joined.player;
        arena.joined = 1;
        world.Set<Owner>(arena.op0, Owner { player = joined.player });
        world.Set<Owner>(arena.op1, Owner { player = joined.player });
    }
    else if (arena.joined == 1)
    {
        arena.second = joined.player;
        arena.joined = 2;
        world.Set<Owner>(arena.op1, Owner { player = joined.player });
    }
}

event(PlayerLeft left) ReassignOperator(mut Arena arena, mut World world)
{
    if (left.player != arena.first && left.player != arena.second) return;
    if (left.player == arena.first) arena.first = arena.second;
    arena.second = default;
    arena.joined = Math.Max(0, arena.joined - 1);
    world.Set<Owner>(arena.op0, Owner { player = arena.first });
    world.Set<Owner>(arena.op1, Owner { player = arena.first });
}

event(Restart) RestartPlace(mut Arena arena, mut Place place, mut Fold fold)
{
    ResetPlace(arena, place, fold, place.id);
    fold.Snap();
}

command(SelectPlace selection, PlayerID sender) ChoosePlace(mut Arena arena, mut Place place, mut Fold fold)
{
    if (sender != arena.first && sender != arena.second) return;
    if (selection.id < 0 || selection.id >= PLACES) return;
    arena.depth = DepthOf(selection.id);
    ResetPlace(arena, place, fold, selection.id);
    fold.Snap();
}

// A wall's folds changed: its pieces are made again.
void Rework(mut World world, Entity wall)
{
    if (!world.TryGet<Wall>(wall, out var found)) return;
    mut var changed = found;
    changed.version += 1;
    world.Set<Wall>(wall, changed);
}

void Fizzle(mut Fold fold, int end, float3 at, float3 face)
{
    fold.fizzleAt = at;
    fold.fizzleFace = face;
    fold.fizzleTime = 0.6;
    fold.fizzleEnd = end;
}

// A frame as a shot sees it.
struct Mount
{
    float3 at;
    float3 face;
    float size;
}

// Leave an ignored collider at its far face. An arbitrary step beyond a grille
// can also jump over a closed shutter immediately behind it.
float PastShape(float3 point, float3 way, Body body, float3 half)
{
    var inverse = Math.Conjugate(body.rotation);
    var local = Math.Rotate(inverse, point - body.position);
    var direction = Math.Rotate(inverse, way);
    mut float far = 1000;
    if (Math.Abs(direction.x) > .00001) far = Math.Min(far, (Math.Sign(direction.x) * half.x - local.x) / direction.x);
    if (Math.Abs(direction.y) > .00001) far = Math.Min(far, (Math.Sign(direction.y) * half.y - local.y) / direction.y);
    if (Math.Abs(direction.z) > .00001) far = Math.Min(far, (Math.Sign(direction.z) * half.z - local.z) / direction.z);
    return Math.Max(far, 0) + .002;
}

// The same decision for the trigger and the aiming reticle. `hit` keeps a
// complete miss silent; a refused hit carries the exact fizzle point/normal.
struct FoldShot
{
    bool hit;
    bool valid;
    Portal portal;
    float3 point;
    float3 face;
}

// Find an end's landing without changing the fold or its wall. The candidate
// is nudged to fit the same floor, ceiling, frames and nearby geometry as a shot.
FoldShot PreviewFold(Fold fold, int end, float3 origin, float3 way, Mount[16] mounts, int count, Physics physics, World world)
{
    if (!physics.Raycast(origin, origin + way * 60, out var first)) return FoldShot { };
    // Through whoever and whatever stands in the way that's no part of the room
    // ...and through a grille, which stops everything else
    mut var hit = first;
    for (var past = 0; past < 4; past++)
    {
        // Machinery is part of the room too. Shooting through a shut door would skip its plate relay.
        if (world.Has<Mover>(hit.entity) || world.Has<Gate>(hit.entity) || world.Has<Door>(hit.entity) || world.Has<Prop>(hit.entity)) break;
        if (world.TryGet<Piece>(hit.entity, out var struck) && world.TryGet<Wall>(struck.wall, out var met) && met.kind != 4) break;
        mut float advance = .002;
        if (world.TryGet<Body>(hit.entity, out var ignored))
        {
            if (world.TryGet<Box>(hit.entity, out var box)) advance = PastShape(hit.point, way, ignored, box.size * .5);
            else if (world.TryGet<Capsule>(hit.entity, out var capsule))
                advance = PastShape(hit.point, way, ignored, float3(capsule.radius, capsule.height * .5, capsule.radius));
        }
        if (!physics.Raycast(hit.point + way * advance, origin + way * 60, out hit)) return FoldShot { };
    }
    mut var shot = FoldShot { hit = true, point = hit.point, face = hit.normal };
    mut var face = float3(0, 1, 0);
    if (Math.Abs(hit.normal.y) < 0.3)
        face = Math.Abs(hit.normal.x) > Math.Abs(hit.normal.z) ? float3(Math.Sign(hit.normal.x), 0, 0) : float3(0, 0, Math.Sign(hit.normal.z));
    if (fold.busy[end / 2] > 0 || face.y > 0.5 || !world.TryGet<Piece>(hit.entity, out var piece) || !world.TryGet<Wall>(piece.wall, out var wall) || !wall.takes)
        return shot;
    shot.face = face;
    var right = FoldRight(face);
    // A shot in a frame, or by it, goes into it at the frame's size
    mut var size = 1.0;
    mut var aim = hit.point;
    for (var index = 0; index < count; index++)
    {
        var mount = mounts[index];
        var off = hit.point - mount.at;
        if (Math.Dot(mount.face, face) < 0.9 || Math.Abs(Math.Dot(off, face)) > 0.3) continue;
        if (Math.Abs(Math.Dot(off, right)) > FOLD_HALF_WIDE * mount.size + 0.35 || Math.Abs(off.y) > FOLD_HALF_HIGH * mount.size + 0.35) continue;
        size = mount.size;
        aim = mount.at;
    }
    var halfWide = FOLD_HALF_WIDE * size;
    var halfHigh = FOLD_HALF_HIGH * size;
    var along = Math.Abs(face.x) > 0.5;
    var thick = along ? wall.size.x : wall.size.z;
    var wide = along ? wall.size.z : wall.size.x;
    // Another end on this wall's other pair of faces would need holes two ways through it
    mut var crossed = false;
    for (var k = 0; k < 4; k++)
        if (k != end && fold.ends[k].open && fold.ends[k].wall == piece.wall && Math.Abs(Math.Dot(fold.ends[k].face, face)) < 0.5) crossed = true;
    if (thick < 0.6 || wide < halfWide * 2 || crossed)
        return shot;
    var plane = wall.center + face * (thick * 0.5);
    mut var u = Math.Dot(aim - wall.center, right);
    mut var v = aim.y;
    mut var lowU = -wide * 0.5 + halfWide;
    mut var highU = wide * 0.5 - halfWide;
    mut var lowV = wall.center.y - wall.size.y * 0.5 + halfHigh;
    mut var highV = wall.center.y + wall.size.y * 0.5 - halfHigh;
    // What's around the place, a hand's width off the wall: the floor, the ceiling and what stands either side
    var probe = float3(plane.x + right.x * u, v, plane.z + right.z * u) + face * 0.2;
    mut var floor = lowV - halfHigh;
    if (physics.Raycast(probe, probe - float3(0, 8, 0), out var under)) floor = under.point.y;
    lowV = Math.Max(lowV, floor + halfHigh);
    if (physics.Raycast(probe, probe + float3(0, 8, 0), out var over)) highV = Math.Min(highV, over.point.y - halfHigh);
    if (physics.Raycast(probe, probe - right * 3, out var before)) lowU = Math.Max(lowU, Math.Dot(before.point - wall.center, right) + halfWide);
    if (physics.Raycast(probe, probe + right * 3, out var after)) highU = Math.Min(highU, Math.Dot(after.point - wall.center, right) - halfWide);
    if (lowU > highU || lowV > highV)
        return shot;
    u = Math.Clamp(u, lowU, highU);
    v = Math.Clamp(v, lowV, highV);
    // Near the floor it stands on it, to be walked into
    if (v - halfHigh - floor < 1.0) v = lowV;
    var at = float3(plane.x + right.x * u, v, plane.z + right.z * u);
    shot.point = at;
    // ...clear of every other end, whoever's it is
    mut var overlaps = false;
    for (var k = 0; k < 4; k++)
    {
        var there = fold.ends[k];
        if (k == end || !there.open) continue;
        if (Math.Dot(there.face, face) > 0.9 && Math.Abs(Math.Dot(there.at - at, face)) < 0.2
            && Math.Abs(Math.Dot(there.at - at, right)) < halfWide + FOLD_HALF_WIDE * there.size + 0.1
            && Math.Abs(there.at.y - at.y) < halfHigh + FOLD_HALF_HIGH * there.size + 0.1) overlaps = true;
    }
    // ...and nothing of the room stands in the opening's way
    mut var blocked = false;
    if (physics.Overlap(Box { size = float3(halfWide * 2 - 0.12, halfHigh * 2 - 0.12, 0.3) }, at + face * 0.3,
                        quaternion.LookRotation(face, float3(0, 1, 0)), out var found))
    {
        foreach (var entity in found)
            if (world.Has<Piece>(entity) || world.Has<Prop>(entity) || world.Has<Mover>(entity)
                || world.Has<Gate>(entity) || world.Has<Door>(entity)) blocked = true;
    }
    if (overlaps || blocked)
        return shot;
    shot.valid = true;
    shot.portal = Portal { open = true, at = at, face = face, wall = piece.wall, size = size };
    return shot;
}

// The trigger alone mutates the fold and rebuilds the affected walls.
bool Shoot(mut Fold fold, int end, float3 origin, float3 way, Mount[16] mounts, int count, Physics physics, mut World world)
{
    var shot = PreviewFold(fold, end, origin, way, mounts, count, physics, world);
    if (!shot.valid)
    {
        if (shot.hit) Fizzle(fold, end, shot.point, shot.face);
        return false;
    }
    var mine = fold.ends[end];
    var other = fold.ends[end ^ 1];
    var placed = shot.portal;
    // Every wall an end was or is on: a hole is only there while both ends are
    if (mine.open && mine.wall != placed.wall) Rework(world, mine.wall);
    if (other.open && other.wall != placed.wall && !(mine.open && other.wall == mine.wall)) Rework(world, other.wall);
    Rework(world, placed.wall);
    fold.ends[end] = placed;
    return true;
}

[Before(PhysicsStages.Step)]
system SweepRamps(Ramp ramp, Arena arena)
{
    if (ramp.chamber != arena.chamber) this.Destroy();
}

// A room's machinery, moved by its speed and not put from place to place, so what's on it is carried.
[Before(PhysicsStages.Step)]
system MoveMovers(mut Mover mover, mut Body body, Arena arena, Time time)
{
    if (mover.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    mut var target = MoverAt(mover, arena.ticks + 1);
    if (mover.need != 0) target = Satisfied(arena.signals, mover.need, mover.any) ? mover.to : mover.from;
    mut var speed = (target - body.position) / time.dt;
    var fast = Math.Length(speed);
    if (mover.need != 0 && fast > mover.speed) speed = speed * (mover.speed / fast);
    body.velocity = speed;
    mover.velocity = speed;
    mover.at = body.position;
}

// A trench's drums turn, but while what stops them is on.
system TurnDrums(mut Pit pit, Arena arena)
{
    if (pit.kind != PitKind.Trench || (pit.brake != 0 && Satisfied(arena.signals, pit.brake, false))) return;
    pit.ticks += 1;
}

system Lurk(mut Lurker lurker, Arena arena, Fold fold, query (Operator pilot) operators, query (Cube cube) objects, query (Pit pit) pits, Time time)
{
    // What lurks is in the place's pool, if it has one
    mut var pool = Pit { };
    mut var found = false;
    foreach (var entry in pits)
    {
        if (entry.pit.chamber != arena.chamber || entry.pit.kind != PitKind.Water || found) continue;
        pool = entry.pit;
        found = true;
    }
    if (!found) return;
    var middle = (pool.low.y + pool.high.y) * 0.5;
    var reach = (pool.high.y - pool.low.y) * 0.5;
    var surface = PitSurface(pool);
    if (lurker.chamber != arena.chamber)
    {
        lurker.chamber = arena.chamber;
        lurker.at = float3(pool.low.x + 2.8, surface, middle);
        lurker.lureLeft = 0;
        lurker.wasIn = 0;
    }
    // A loose thing going in is the last thing that splashed
    mut var nowIn = 0;
    foreach (var entry in objects)
    {
        var index = entry.cube.index;
        if (entry.cube.chamber != arena.chamber) continue;
        var spot = fold.spots[index];
        var bottom = spot.y - CUBE_SIDE * entry.cube.scale * .5;
        if (fold.holding[0] == index + 1 || fold.holding[1] == index + 1 || bottom > surface || !InPit(pool, spot, 0)) continue;
        nowIn |= 1 << index;
        if ((lurker.wasIn & (1 << index)) != 0) continue;
        lurker.lure = spot;
        lurker.lureLeft = 7;
    }
    lurker.wasIn = nowIn;
    lurker.lureLeft = Math.Max(0, lurker.lureLeft - time.dt);
    // Up and down the pool with nothing to go for; for the nearest of whoever is in it; for a splash before them
    var across = (pool.low.x + pool.high.x) * 0.5;
    var wide = pool.high.x - pool.low.x;
    mut var target = float3(across + Math.Sin(arena.ticks / 60.0 * 0.35) * (wide * 0.5 - 1.8), surface, middle + Math.Sin(arena.ticks / 60.0 * 0.23) * (reach - 1.5));
    mut var speed = 2.2;
    mut var nearest = 1000.0;
    foreach (var entry in operators)
    {
        var feet = entry.pilot.position;
        if (!InPit(pool, feet, 0) || feet.y > surface - 0.5 * entry.pilot.scale || entry.pilot.taken > 0) continue;
        var away = Math.Distance(feet.xz, lurker.at.xz);
        if (away >= nearest) continue;
        nearest = away;
        target = feet;
        speed = 5.5;
    }
    if (lurker.lureLeft > 0)
    {
        target = lurker.lure;
        speed = 5.5;
    }
    target = float3(Math.Clamp(target.x, pool.low.x + 0.8, pool.high.x - 0.8), surface, Math.Clamp(target.z, pool.low.y + 0.6, pool.high.y - 0.6));
    var gap = Math.Distance(target.xz, lurker.at.xz);
    lurker.rush = speed > 3 ? 1.0 : 0.0;
    if (gap < 0.05) return;
    var step = Math.Min(gap, speed * time.dt);
    lurker.way = (target - lurker.at) / gap;
    lurker.at += lurker.way * step;
}

system MoveOperators(mut Operator pilot, mut Body body, PilotInput input, Arena arena, Place place, Lurker lurker, mut Fold fold, Physics physics,
                     mut World world, Time time, query (Pit pit) pits, query (Pad pad) pads, query (FoldFrame frame) frames)
{
    if (pilot.chamber != arena.chamber)
    {
        // A new place. Come to by lift, it stands in the lift as it stood, facing as it faced, turned as the two
        // lifts are: the door before it is the one that opens. Otherwise it's at the start, facing out of the lift.
        var rode = arena.rode == arena.chamber && pilot.chamber >= 0;
        pilot.chamber = arena.chamber;
        if (pilot.scale != 1) pilot.resize = 1;
        mut var feet = OperatorStart(place, pilot.id);
        if (rode)
        {
            var local = TurnBy(pilot.position - arena.left, -arena.leftWay);
            feet = LiftPoint(place.arrival, place.arrivalYaw, float3(Math.Clamp(local.x, -2.6, 2.6), 0, Math.Clamp(local.z, -1.8, 1.8)));
            pilot.yaw += place.arrivalYaw - arena.leftWay;
            pilot.yaw = Math.Atan2(Math.Sin(pilot.yaw), Math.Cos(pilot.yaw));
        }
        else
        {
            pilot.yaw = place.arrivalYaw;
            pilot.pitch = 0;
        }
        pilot.taken = 0;
        pilot.shredded = false;
        pilot.flung = 0;
        body.position = feet + float3(0, BODY_HIGH * 0.5 * pilot.scale + 0.02, 0);
        body.velocity = float3(0);
        pilot.last = body.position;
        pilot.position = feet;
        this.Snap();
    }
    // It stands upright whatever it's pushed by
    body.rotation = quaternion.identity;
    body.angularVelocity = float3(0);
    // What a pit does to whoever is in it, as deep as they are for their size
    var low = body.position.y - BODY_HIGH * 0.5 * pilot.scale;
    mut var wading = 1.0;
    foreach (var entry in pits)
    {
        var pit = entry.pit;
        if (pit.chamber != arena.chamber || !InPit(pit, body.position, 0.3)) continue;
        var surface = PitSurface(pit);
        // Water to the waist is slow going
        if (pit.kind == PitKind.Water && low < surface - 0.4 * pilot.scale) wading = 0.45;
        if (pilot.taken > 0) continue;
        if (pit.kind == PitKind.Blood && body.position.y < surface - TAKEN_UNDER * pilot.scale) pilot.taken = 0.0001;
        if (pit.kind == PitKind.Water && low < surface - 0.5 * pilot.scale && Math.DistanceSq(lurker.at.xz, body.position.xz) < 1.6) pilot.taken = 0.0001;
        if (pit.kind == PitKind.Trench && low < pit.top - 0.6)
        {
            for (var which = 0; which < pit.drums; which++)
            {
                if (Math.Abs(body.position.z - pit.lanes[which]) > 1.2 || Math.Abs(body.position.x - DrumAt(pit, which)) > 0.95) continue;
                pilot.taken = 0.0001;
                pilot.shredded = true;
            }
        }
    }
    if (pilot.taken > 0)
    {
        // The hands in the pit have it, or what's in the pool: it's stopped where it was caught and dragged
        // under, whatever it does. A drum leaves nothing to drag.
        pilot.taken += time.dt;
        pilot.grounded = false;
        body.velocity = float3(0, pilot.taken < 0.35 || pilot.shredded ? 0.0 : -1.3, 0);
        fold.holding[pilot.id] = 0;
        if (arena.joined >= 2 || input.active == pilot.id)
        {
            pilot.yaw += input.look.x;
            pilot.yaw = Math.Atan2(Math.Sin(pilot.yaw), Math.Cos(pilot.yaw));
            pilot.pitch = Math.Clamp(pilot.pitch + input.look.y, -1.4, 1.4);
        }
        return;
    }
    var half = BODY_HIGH * 0.5 * pilot.scale;
    pilot.grounded = physics.Raycast(body.position, body.position - float3(0, half + 0.1 * pilot.scale + 0.005, 0), out var under);
    // A pad throws whoever steps on it, and what's thrown, or comes out of a fold at speed, keeps its speed
    // until it lands
    pilot.flung = Math.Max(0, pilot.flung - time.dt);
    if (pilot.grounded && pilot.flung < 1.0) pilot.flung = 0;
    foreach (var entry in pads)
    {
        var pad = entry.pad;
        if (pad.chamber != arena.chamber || !pilot.grounded || Math.DistanceSq(body.position.xz, pad.at.xz) > 0.6 || Math.Abs(low - pad.at.y) > 0.4) continue;
        body.velocity = pad.launch;
        pilot.flung = 1.2;
    }
    // On a thing that moves, it's carried
    mut var carried = float3(0);
    if (pilot.grounded && world.TryGet<Mover>(under.entity, out var ridden)) carried = ridden.velocity;
    var controlling = arena.joined >= 2 || input.active == pilot.id;
    if (!controlling)
    {
        if (pilot.flung <= 0)
        {
            body.velocity.x = Math.Lerp(body.velocity.x, carried.x, Math.Min(1, time.dt * 12));
            body.velocity.z = Math.Lerp(body.velocity.z, carried.z, Math.Min(1, time.dt * 12));
        }
        return;
    }
    pilot.yaw += input.look.x;
    pilot.yaw = Math.Atan2(Math.Sin(pilot.yaw), Math.Cos(pilot.yaw));
    pilot.pitch = Math.Clamp(pilot.pitch + input.look.y, -1.4, 1.4);
    if (input.reset.down) Send(Restart);
    var facing = LookDirection(pilot.yaw, pilot.pitch);
    var eye = body.position + float3(0, (EYE_HIGH - BODY_HIGH * 0.5) * pilot.scale, 0);
    // With the cube in hand a click throws it; with empty hands it shoots a fold's end, where the device works
    var holding = fold.holding[pilot.id] > 0;
    var thrown = holding && (input.amber.down || input.cyan.down || input.hurl.down);
    if (!holding && (input.amber.down || input.cyan.down) && !place.dead)
    {
        // The place's frames, which a shot by one goes into
        mut Mount[16] mounts = default;
        mut var count = 0;
        foreach (var entry in frames)
        {
            if (entry.frame.chamber != arena.chamber || count >= 16) continue;
            mounts[count] = Mount { at = entry.frame.at, face = entry.frame.face, size = entry.frame.size };
            count += 1;
        }
        // An end that's shot is there at once, and so are the shards of one that wasn't: nothing slides over
        // from where the last was
        // Its own fold's two ends: nobody else's
        if (input.amber.down) Shoot(fold, pilot.id * 2, eye, facing, mounts, count, physics, world);
        if (input.cyan.down) Shoot(fold, pilot.id * 2 + 1, eye, facing, mounts, count, physics, world);
        fold.Snap();
    }
    if (input.ping.down)
    {
        fold.ping = physics.Raycast(eye, eye + facing * 40, out var seen) ? seen.point : eye + facing * 4;
        fold.pingTime = 3;
        fold.pingOperator = pilot.id;
    }
    if (holding && (input.carry.down || thrown))
    {
        // Let go of, or thrown
        fold.tossing[pilot.id] = fold.holding[pilot.id];
        fold.toss[pilot.id] = facing * (thrown ? 11.0 : 1.5);
        fold.holding[pilot.id] = 0;
    }
    else if (input.carry.down)
    {
        // The nearest loose thing within reach, straight or through a fold. Alone, it's taken from the hands
        // of the body that was left holding it
        mut var best = 0;
        mut var nearest = 6.25 * pilot.scale * pilot.scale;
        for (var index = 0; index < fold.count; index++)
        {
            if (fold.holding[1 - pilot.id] == index + 1 && arena.joined >= 2) continue;
            var far = Reach(fold, eye, fold.spots[index]);
            if (far >= nearest) continue;
            nearest = far;
            best = index + 1;
        }
        // Much bigger than whoever reaches for it, it doesn't come up: they strain at it
        if (best > 0 && fold.sizes[best - 1] > pilot.scale * 1.6) fold.strained[pilot.id] = 0.6;
        else if (best > 0)
        {
            if (fold.holding[1 - pilot.id] == best) fold.holding[1 - pilot.id] = 0;
            fold.holding[pilot.id] = best;
        }
    }
    var movement = Math.Normalize(input.move);
    var forward = LookDirection(pilot.yaw, 0);
    var right = float3(forward.z, 0, -forward.x);
    var desired = (right * movement.x + forward * movement.y) * (5.2 * pilot.scale * wading);
    if (pilot.flung <= 0)
    {
        body.velocity.x = Math.Lerp(body.velocity.x, desired.x + carried.x, Math.Min(1, time.dt * 12));
        body.velocity.z = Math.Lerp(body.velocity.z, desired.z + carried.z, Math.Min(1, time.dt * 12));
    }
    if (input.jump.down && pilot.grounded) body.velocity.y = 6.2 * Math.Sqrt(pilot.scale);
}

// Where a carried cube is held: before its holder's eyes, or through a fold
// where the arm reaches into one, whichever the cube is nearer.
[Before(PhysicsStages.Step)]
system HoldCube(mut Body body, mut Cube cube, mut Fold fold, Arena arena, query (Operator pilot) operators, query (Pad pad) pads, query (Pit pit) pits,
                Time time)
{
    if (cube.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    for (var hand = 0; hand < 2; hand++)
    {
        if (fold.tossing[hand] != cube.index + 1) continue;
        fold.tossing[hand] = 0;
        mut var toss = fold.toss[hand];
        // Thrown through a fold the arm was in, it leaves the other end
        foreach (var entry in operators)
        {
            if (entry.pilot.id != hand) continue;
            var reach = entry.pilot.position + float3(0, EYE_HIGH * entry.pilot.scale, 0);
            if (Math.DistanceSq(reach, body.position) < 9) continue;
            for (var end = 0; end < 4; end++)
            {
                if (!Linked(fold, end / 2)) continue;
                var from = fold.ends[end];
                var to = fold.ends[end ^ 1];
                if (Math.DistanceSq(FoldPoint(from, to, reach), body.position) < 9) toss = FoldDirection(from, to, fold.toss[hand]) * (to.size / from.size);
            }
        }
        body.velocity = body.velocity * 0.3 + toss;
        body.gravityScale = 1;
    }
    cube.holder = fold.holding[0] == cube.index + 1 ? 0 : fold.holding[1] == cube.index + 1 ? 1 : -1;
    foreach (var entry in pads)
    {
        var pad = entry.pad;
        if (cube.holder >= 0 || pad.chamber != arena.chamber) continue;
        if (Math.DistanceSq(body.position.xz, pad.at.xz) < 0.6 && body.position.y - pad.at.y < 0.7 && body.position.y > pad.at.y && body.velocity.y < 1)
            body.velocity = pad.launch;
    }
    if (cube.holder < 0)
    {
        var half = CUBE_SIDE * cube.scale * .5;
        mut var afloat = false;
        mut var surface = 0.0;
        foreach (var entry in pits)
        {
            var pit = entry.pit;
            if (pit.chamber != arena.chamber || pit.kind != PitKind.Water || !InPit(pit, body.position, 0) || body.position.y - half >= PitSurface(pit)) continue;
            afloat = true;
            surface = PitSurface(pit);
        }
        body.gravityScale = afloat ? 0.0 : 1.0;
        if (afloat)
        {
            // Damped buoyancy leaves the upper half visible, with throws settling within reach.
            var level = surface + half * .4;
            body.velocity.y += ((level - body.position.y) * 24 - body.velocity.y * 7) * time.dt;
            var drag = Math.Max(0, 1 - time.dt * 2);
            body.velocity.x *= drag;
            body.velocity.z *= drag;
            body.angularVelocity *= drag;
        }
        return;
    }
    foreach (var entry in operators)
    {
        if (entry.pilot.id != cube.holder) continue;
        var hand = entry.pilot.position + float3(0, 1.15 * entry.pilot.scale, 0);
        var held = hand + LookDirection(entry.pilot.yaw, entry.pilot.pitch) * (1.25 * entry.pilot.scale);
        mut var target = held;
        mut var nearest = Math.DistanceSq(held, body.position);
        for (var end = 0; end < 4; end++)
        {
            if (!Linked(fold, end / 2)) continue;
            var from = fold.ends[end];
            var to = fold.ends[end ^ 1];
            var through = FoldPoint(from, to, held);
            var far = Math.DistanceSq(through, body.position);
            if (far < nearest)
            {
                nearest = far;
                target = through;
            }
        }
        if (nearest > 16 * entry.pilot.scale * entry.pilot.scale)
        {
            // Out of reach: it's dropped
            fold.holding[cube.holder] = 0;
            cube.holder = -1;
            body.gravityScale = 1;
            return;
        }
        var pull = (target - body.position) * 16;
        var speed = Math.Length(pull);
        body.velocity = speed > 14 ? pull * (14 / speed) : pull;
        body.angularVelocity = body.angularVelocity * 0.8;
        body.gravityScale = 0;
    }
}

// After the step: an operator that crossed a fold's face is at the other end,
// and the size that end makes of it. A body's shape is made once, so one that
// changes size is another entity, with what this one was.
system CrossOperators(mut Operator pilot, mut Body body, Owner owner, mut Fold fold, mut Arena arena, Place place)
{
    mut var center = body.position;
    mut var velocity = body.velocity;
    var ratio = Traverse(fold, pilot.last, center, velocity, pilot.yaw, pilot.scale, out _);
    if (ratio != 0)
    {
        body.position = center;
        body.velocity = velocity;
    }
    if (ratio > 0)
    {
        // Out of a fold faster than a run, it's thrown
        if (Math.Length(velocity) > 6.5) pilot.flung = Math.Max(pilot.flung, 0.9);
        if (Math.Abs(ratio - 1) > 0.001) pilot.resize = pilot.scale * ratio;
        this.Snap();
    }
    if (pilot.taken > (pilot.shredded ? SHRED_FOR : TAKEN_FOR) || center.y < -8)
    {
        // Gone under, or to pieces: back where it started, and whole
        pilot.taken = 0;
        pilot.shredded = false;
        center = OperatorStart(place, pilot.id) + float3(0, BODY_HIGH * 0.5 * pilot.scale, 0);
        velocity = float3(0);
        body.position = center;
        body.velocity = velocity;
        fold.holding[pilot.id] = 0;
        if (pilot.scale != 1) pilot.resize = 1;
        this.Snap();
    }
    for (var pair = 0; pair < 2; pair++)
        if (AtMouth(fold, pair, center, 0.7 * pilot.scale, pilot.scale)) fold.busy[pair] = 3;
    if (pilot.resize > 0)
    {
        // Standing where it stood, at its new size
        var scale = pilot.resize;
        var half = float3(0, BODY_HIGH * 0.5 * scale, 0);
        // Through a fold its middle is where the fold put it; made again where it stands, its feet are
        var feet = ratio > 0 ? center - half : center - float3(0, BODY_HIGH * 0.5 * pilot.scale, 0);
        var born = Spawn(Operator { id = pilot.id, position = feet, yaw = pilot.yaw, pitch = pilot.pitch, velocity = velocity, scale = scale,
                                    last = feet + half, grounded = pilot.grounded, taken = pilot.taken, shredded = pilot.shredded, flung = pilot.flung,
                                    chamber = pilot.chamber },
                         Owner { player = owner.player }, Body { position = feet + half, velocity = velocity },
                         Capsule { radius = BODY_RADIUS * scale, height = BODY_HIGH * scale, density = 250, friction = 0 });
        if (pilot.id == 0) arena.op0 = born;
        else arena.op1 = born;
        this.Destroy();
        return;
    }
    pilot.last = center;
    pilot.position = center - float3(0, BODY_HIGH * 0.5 * pilot.scale, 0);
    pilot.velocity = body.velocity;
}

system CrossCube(mut Cube cube, mut Body body, mut Fold fold, mut Arena arena, query (Pit pit) pits)
{
    mut var center = body.position;
    mut var velocity = body.velocity;
    mut var unused = 0.0;
    var ratio = Traverse(fold, cube.last, center, velocity, unused, cube.scale, out var through);
    mut var scale = cube.scale;
    if (ratio < 0)
    {
        body.position = center;
        body.velocity = velocity;
    }
    if (ratio > 0)
    {
        // It comes out turned as the fold turns the world
        var from = fold.ends[through];
        var to = fold.ends[through ^ 1];
        var ahead = FoldDirection(from, to, Math.Forward(body.rotation));
        var up = FoldDirection(from, to, Math.Up(body.rotation));
        body.rotation = quaternion.LookRotation(ahead, up);
        body.angularVelocity = FoldDirection(from, to, body.angularVelocity);
        body.position = center;
        body.velocity = velocity;
        scale = cube.scale * ratio;
        this.Snap();
        fold.Snap();
    }
    if (center.y < -8)
    {
        // Lost: put back where it was found, and whole
        center = cube.home;
        body.position = center;
        body.velocity = float3(0);
        body.angularVelocity = float3(0);
        scale = 1;
        for (var hand = 0; hand < 2; hand++)
            if (fold.holding[hand] == cube.index + 1) fold.holding[hand] = 0;
        this.Snap();
    }
    for (var pair = 0; pair < 2; pair++)
        if (AtMouth(fold, pair, center, 0.6 * cube.scale, cube.scale)) fold.busy[pair] = 3;
    // A drum throws the cube out of its way
    foreach (var entry in pits)
    {
        var pit = entry.pit;
        if (pit.chamber != arena.chamber || pit.kind != PitKind.Trench || !InPit(pit, center, 0) || center.y > pit.top - 0.2) continue;
        for (var which = 0; which < pit.drums; which++)
        {
            if (Math.Abs(center.z - pit.lanes[which]) < 1.4 && Math.Abs(center.x - DrumAt(pit, which)) < 1.0)
                body.velocity = float3(DrumWay(pit, which) * 7, 6.5, 0);
        }
    }
    cube.at = center;
    cube.turn = body.rotation;
    fold.spots[cube.index] = center;
    fold.sizes[cube.index] = scale;
    if (cube.index == 0)
    {
        fold.cube = center;
        fold.cubeTurn = body.rotation;
        fold.cubeScale = scale;
    }
    if (Math.Abs(scale / cube.scale - 1) > 0.001)
    {
        // At its new size: another body, with this one's speed and spin
        var again = Spawn(Cube { chamber = cube.chamber, last = center, home = cube.home, scale = scale, index = cube.index, kind = cube.kind, holder = cube.holder,
                                 at = center, turn = body.rotation },
                          Body { position = center, rotation = body.rotation, velocity = body.velocity, angularVelocity = body.angularVelocity,
                                 gravityScale = body.gravityScale },
                          Box { size = float3(CUBE_SIDE * scale), density = cube.kind == 0 ? 120.0 : 60.0, friction = 0.7 });
        if (cube.index == 0) arena.cube = again;
        this.Destroy();
        return;
    }
    cube.last = center;
}

// A wall's pieces: the wall with a hole in it where each fold on it is, as
// deep as the wall less a back to it. The face is cut into a grid by the
// holes' edges, and each cell is a box: all of the wall's depth, or what a
// hole leaves of it. They're made again when its folds change, and when an end
// was put on it as the place was built.
[Before(PhysicsStages.Step)]
system Carve(mut Wall wall, Fold fold, Arena arena)
{
    if (wall.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    // The ends on this wall whose folds are whole
    mut var holes = 0;
    mut var face = float3(0, 0, 1);
    for (var end = 0; end < 4; end++)
    {
        if (!Linked(fold, end / 2) || fold.ends[end].wall != this) continue;
        holes += 1;
        face = fold.ends[end].face;
    }
    if (wall.made == wall.version && wall.holes == holes) return;
    wall.version = Math.Max(wall.version, wall.made + 1);
    wall.made = wall.version;
    wall.holes = holes;
    if (holes == 0)
    {
        Spawn(Piece { wall = this, version = wall.version }, Body { type = BodyType.Static, position = wall.center }, Box { size = wall.size });
        return;
    }
    var along = Math.Abs(face.x) > 0.5;
    var axis = along ? float3(1, 0, 0) : float3(0, 0, 1);
    var across = along ? float3(0, 0, 1) : float3(1, 0, 0);
    var thick = along ? wall.size.x : wall.size.z;
    var wide = along ? wall.size.z : wall.size.x;
    mut List<float> us = [-wide * 0.5, wide * 0.5];
    mut List<float> vs = [-wall.size.y * 0.5, wall.size.y * 0.5];
    for (var end = 0; end < 4; end++)
    {
        var portal = fold.ends[end];
        if (!Linked(fold, end / 2) || portal.wall != this) continue;
        var u = Math.Dot(portal.at - wall.center, across);
        var v = portal.at.y - wall.center.y;
        us.Add(Math.Clamp(u - FOLD_HALF_WIDE * portal.size, -wide * 0.5, wide * 0.5));
        us.Add(Math.Clamp(u + FOLD_HALF_WIDE * portal.size, -wide * 0.5, wide * 0.5));
        vs.Add(Math.Clamp(v - FOLD_HALF_HIGH * portal.size, -wall.size.y * 0.5, wall.size.y * 0.5));
        vs.Add(Math.Clamp(v + FOLD_HALF_HIGH * portal.size, -wall.size.y * 0.5, wall.size.y * 0.5));
    }
    us.Sort(a, b) { return a < b; }
    vs.Sort(a, b) { return a < b; }
    for (var column = 0; column + 1 < us.count; column++)
    {
        var wideHere = us[column + 1] - us[column];
        if (wideHere < 0.01) continue;
        for (var row = 0; row + 1 < vs.count; row++)
        {
            var highHere = vs[row + 1] - vs[row];
            if (highHere < 0.01) continue;
            var u = (us[column] + us[column + 1]) * 0.5;
            var v = (vs[row] + vs[row + 1]) * 0.5;
            mut var low = -thick * 0.5;
            mut var high = thick * 0.5;
            for (var end = 0; end < 4; end++)
            {
                var portal = fold.ends[end];
                if (!Linked(fold, end / 2) || portal.wall != this) continue;
                if (Math.Abs(u - Math.Dot(portal.at - wall.center, across)) > FOLD_HALF_WIDE * portal.size) continue;
                if (Math.Abs(v - (portal.at.y - wall.center.y)) > FOLD_HALF_HIGH * portal.size) continue;
                var deep = Math.Min(thick - 0.1, 0.95 * portal.size);
                if (Math.Dot(portal.face, axis) > 0) high = Math.Min(high, thick * 0.5 - deep);
                else low = Math.Max(low, -thick * 0.5 + deep);
            }
            if (high - low < 0.02) continue;
            var middle = wall.center + across * u + float3(0, v, 0) + axis * ((low + high) * 0.5);
            var size = across * wideHere + float3(0, highHere, 0) + axis * (high - low);
            Spawn(Piece { wall = this, version = wall.version }, Body { type = BodyType.Static, position = middle }, Box { size = size });
        }
    }
}

// A piece of a wall that's gone, or that was made for other folds, goes.
[Before(PhysicsStages.Step)]
system Uncarve(Piece piece, World world)
{
    if (!world.TryGet<Wall>(piece.wall, out var wall) || wall.version != piece.version) this.Destroy();
}

system MoveGate(mut Body body, Gate gate, Arena arena, Place place)
{
    if (gate.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    var at = LiftPoint(place.exit, place.exitYaw, float3(0, 2.0 + arena.gate * 4.3, 2.1));
    if (Math.DistanceSq(body.position, at) > 0.000001) body.position = at;
}

// The lift's door: shut for a moment after it comes, then open; in a lift that stops on the way, shut again
// when it goes on.
system MoveDoor(mut Body body, Door door, Arena arena, Place place)
{
    if (door.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    var at = LiftPoint(place.arrival, place.arrivalYaw, float3(0, 2.0 + arena.door * 4.3, 2.1));
    if (Math.DistanceSq(body.position, at) > 0.000001) body.position = at;
}

// What weighs on a plate: whoever stands on it, whatever rests on it and nobody holds, and what stands or rests
// on them. Things weigh as they are big: a body twice the size weighs eight times as much.
system WeighPlates(mut Plate plate, Arena arena, Fold fold, query (Operator pilot) operators, query (Cube cube) objects, Physics physics, Time time)
{
    if (plate.chamber != arena.chamber) return;
    mut var load = 0.0;
    foreach (var entry in operators)
    {
        var body = entry.pilot;
        if (body.taken > 0 || !body.grounded || !OnPlate(plate, body.position)) continue;
        load += OPERATOR_MASS * body.scale * body.scale * body.scale;
    }
    foreach (var entry in objects)
    {
        var thing = entry.cube;
        if (thing.chamber != arena.chamber || fold.holding[0] == thing.index + 1 || fold.holding[1] == thing.index + 1) continue;
        var half = CUBE_SIDE * 0.5 * thing.scale;
        if (!OnPlate(plate, thing.at - float3(0, half, 0))) continue;
        // Resting on something, not flying over
        if (!physics.Raycast(thing.at, thing.at - float3(0, half * 1.8 + 0.05, 0), out _)) continue;
        load += (thing.kind == 0 ? CUBE_MASS : CRATE_MASS) * thing.scale * thing.scale * thing.scale;
    }
    plate.load = load;
    plate.down = load >= plate.need;
    plate.left = plate.down ? plate.linger : Math.Max(0, plate.left - time.dt);
}

system EvaluatePlace(mut Arena arena, mut Place place, mut Fold fold, query (Operator pilot) operators, query (Plate plate) plates, Time time)
{
    arena.ticks += 1;
    arena.arrive += time.dt;
    fold.pingTime = Math.Max(0, fold.pingTime - time.dt);
    fold.fizzleTime = Math.Max(0, fold.fizzleTime - time.dt);
    fold.busy[0] = Math.Max(0, fold.busy[0] - 1);
    fold.busy[1] = Math.Max(0, fold.busy[1] - 1);
    fold.strained[0] = Math.Max(0, fold.strained[0] - time.dt);
    fold.strained[1] = Math.Max(0, fold.strained[1] - time.dt);
    // Every signal as the place's inputs have it now: a plate's is on while it's down, or lingering
    mut var signals = 0;
    foreach (var entry in plates)
    {
        var plate = entry.plate;
        if (plate.chamber != arena.chamber) continue;
        if ((plate.down || plate.left > 0) != plate.invert) signals |= 1 << plate.signal;
    }
    arena.signals = signals;
    fold.carried = fold.holding[0] > 0 ? 0 : fold.holding[1] > 0 ? 1 : -1;
    if (place.kind == PlaceKind.Ending)
    {
        arena.door = Math.Clamp(arena.door + (arena.arrive > .7 ? time.dt * 1.6 : -time.dt * 2.4), 0, 1);
        arena.gate = 0;
        arena.ride = 0;
        return;
    }
    mut var exiting = 0;
    foreach (var entry in operators)
        if (InLift(place.exit, place.exitYaw, entry.pilot.position)) exiting += 1;
    // With both in the lift its door shuts whatever holds it, and the lift goes down: to the next place, where
    // they stand as they stood. A lift that stopped on the way goes on when its moment is over.
    var stopped = place.kind == PlaceKind.Vignette;
    var leaving = exiting == 2 && (!stopped || arena.arrive > place.stay);
    arena.door = Math.Clamp(arena.door + (arena.arrive > 0.7 && !(stopped && leaving) ? time.dt * 1.6 : -time.dt * 2.4), 0, 1);
    // The gate is up while its circuit is closed, and down again when it isn't: something has to stay on each plate
    var open = !stopped && !leaving && Satisfied(arena.signals, place.exitNeed, place.exitAny);
    arena.gate = Math.Clamp(arena.gate + (open ? time.dt * 1.6 : -time.dt * 2.4), 0, 1);
    var shut = stopped ? arena.door <= 0 : arena.gate <= 0;
    arena.ride = leaving && shut ? arena.ride + time.dt : 0.0;
    if (arena.ride >= RIDE)
    {
        arena.left = place.exit;
        arena.leftWay = place.exitYaw + Math.PI;
        arena.depth += 1;
        ResetPlace(arena, place, fold, PlaceAt(arena.depth));
        arena.rode = arena.chamber;
        fold.Snap();
    }
    // Caught in a passage: it starts over, for both
    if (arena.caught > 0)
    {
        arena.caught += time.dt;
        if (arena.caught >= CAUGHT)
        {
            ResetPlace(arena, place, fold, place.id);
            fold.Snap();
        }
    }
}

[After(EvaluatePlace)]
system RetireRoom(Arena arena, World world, with Body, without Operator)
{
    // Retire the old physical room in the same tick that builds its replacement. Waiting for its own
    // systems next tick leaves old colliders in the arriving lift for one physics step.
    if (world.TryGet<Piece>(this, out var piece))
    {
        if (!world.TryGet<Wall>(piece.wall, out var wall) || wall.chamber != arena.chamber) this.Destroy();
    }
    else if (world.TryGet<Cube>(this, out var cube))
    {
        if (cube.chamber != arena.chamber) this.Destroy();
    }
    else if (world.TryGet<Mover>(this, out var mover))
    {
        if (mover.chamber != arena.chamber) this.Destroy();
    }
    else if (world.TryGet<Ramp>(this, out var ramp))
    {
        if (ramp.chamber != arena.chamber) this.Destroy();
    }
    else if (world.TryGet<Gate>(this, out var gate))
    {
        if (gate.chamber != arena.chamber) this.Destroy();
    }
    else if (world.TryGet<Door>(this, out var door))
    {
        if (door.chamber != arena.chamber) this.Destroy();
    }
}

// What a place has that's no body goes with it, in the same tick.
[After(EvaluatePlace)]
system RetirePlates(Plate plate, Arena arena)
{
    if (plate.chamber != arena.chamber) this.Destroy();
}

[After(EvaluatePlace)]
system RetireWires(Wire wire, Arena arena)
{
    if (wire.chamber != arena.chamber) this.Destroy();
}

[After(EvaluatePlace)]
system RetireFrames(FoldFrame frame, Arena arena)
{
    if (frame.chamber != arena.chamber) this.Destroy();
}

[After(EvaluatePlace)]
system RetirePads(Pad pad, Arena arena)
{
    if (pad.chamber != arena.chamber) this.Destroy();
}

[After(EvaluatePlace)]
system RetirePits(Pit pit, Arena arena)
{
    if (pit.chamber != arena.chamber) this.Destroy();
}

[After(EvaluatePlace)]
system RetirePillars(Pillar pillar, Arena arena)
{
    if (pillar.chamber != arena.chamber) this.Destroy();
}

[After(EvaluatePlace)]
system RetireMazes(Maze maze, Arena arena)
{
    if (maze.chamber != arena.chamber) this.Destroy();
}

[After(EvaluatePlace)]
system RetireProwls(Prowl prowl, Arena arena)
{
    if (prowl.chamber != arena.chamber) this.Destroy();
}

// What's in a maze. It stands wherever it is for as long as anyone can see it, and comes for the nearest of
// them, by the maze's ways, while nobody can. Whoever it reaches is caught, and both start over.
singleton Stalker
{
    int chamber = -1;
    int cell;            // The cell it's in, or was last in the middle of
    int next;            // ...and the one it's going to
    float3 at;
    bool seen;
    float moved;         // 1 while it moves, falling off when it stops: what's heard of it
    float walked;        // How far it has come: it's never standing as it stood
    float clock;         // Counts toward the lamps and torches failing, which they do for a moment every so often
    bool dark;           // ...as they are now: nobody sees anything, and it's quick
    int[256] far;        // How many cells each cell is from whoever it's after
    int[256] line;
}

system Stalk(mut Watcher watcher, mut Stalker stalker, mut Arena arena, query (Operator pilot) operators, query (Maze maze) mazes, Physics physics, World world,
             Time time)
{
    mut var maze = Maze { };
    mut var found = false;
    foreach (var entry in mazes)
    {
        if (entry.maze.chamber != arena.chamber || found) continue;
        maze = entry.maze;
        found = true;
    }
    if (!found) return;
    var cells = Math.Min(maze.wide * maze.long, 256);
    if (stalker.chamber != arena.chamber)
    {
        // It starts where its maze says: well away from the lift they come by
        stalker.chamber = arena.chamber;
        stalker.cell = maze.start;
        stalker.next = stalker.cell;
        stalker.at = CellMiddle(maze, stalker.cell);
        stalker.moved = 0;
        stalker.walked = 0;
        stalker.clock = 0;
    }
    mut var nearest = 1000.0;
    mut var prey = stalker.at;
    mut var seen = false;
    foreach (var entry in operators)
    {
        var feet = entry.pilot.position;
        // Nobody out of its maze is its prey: not in a lift
        if (!InMaze(maze, feet)) continue;
        var away = Math.Distance(feet.xz, stalker.at.xz);
        if (away < nearest)
        {
            nearest = away;
            prey = feet;
        }
    }
    foreach (var entry in operators)
    {
        var eye = entry.pilot.position + float3(0, EYE_HIGH * entry.pilot.scale, 0);
        var chest = stalker.at + float3(0, 1.3, 0);
        var to = chest - eye;
        var away = Math.Length(to);
        if (away > 40 || Math.Dot(to / Math.Max(away, 0.001), LookDirection(entry.pilot.yaw, entry.pilot.pitch)) < 0.5) continue;
        // A display grille stops bodies, not their sight. Leave precisely its
        // far face so a solid wall immediately behind it still blocks the view.
        mut var clear = false;
        mut var from = eye;
        var way = to / Math.Max(away, .001);
        for (int past = 0; past < 32; past++)
        {
            if (!physics.Raycast(from, chest, out var hit) || Math.Distance(hit.point, eye) >= away - .4)
            {
                clear = true;
                break;
            }
            bool grille = world.TryGet<Piece>(hit.entity, out var piece) && world.TryGet<Wall>(piece.wall, out var wall) && wall.kind == 4;
            if (!grille && !world.Has<Operator>(hit.entity)) break;
            mut float advance = .002;
            if (world.TryGet<Body>(hit.entity, out var body))
            {
                if (world.TryGet<Box>(hit.entity, out var box)) advance = PastShape(hit.point, way, body, box.size * .5);
                else if (world.TryGet<Capsule>(hit.entity, out var capsule))
                    advance = PastShape(hit.point, way, body, float3(capsule.radius, capsule.height * .5, capsule.radius));
            }
            from = hit.point + way * advance;
            if (Math.Dot(chest - from, way) <= 0) { clear = true; break; }
        }
        if (clear) seen = true;
    }
    // Every few seconds every light there is fails for a moment, and nobody sees anything
    stalker.clock += time.dt;
    if (stalker.clock >= BLACKOUT_EVERY) stalker.clock -= BLACKOUT_EVERY;
    stalker.dark = arena.arrive > 6 && stalker.clock < BLACKOUT_FOR;
    if (stalker.dark) seen = false;
    stalker.seen = seen;
    stalker.moved = Math.Max(0, stalker.moved - time.dt * 3);
    watcher.state = Watching.Peeking;
    watcher.at = stalker.at;
    watcher.lean = 1;
    if (nearest < 900) watcher.yaw = Math.Atan2(prey.x - stalker.at.x, prey.z - stalker.at.z);
    if (arena.caught > 0 || arena.arrive < 4 || nearest > 900) return;
    // Near enough to touch, it has them, looked at or not
    if (nearest < 1.35)
    {
        arena.caught = time.dt;
        return;
    }
    if (seen) return;
    // How far every cell is from its prey's, by the ways there are
    for (var cell = 0; cell < cells; cell++) stalker.far[cell] = 999;
    var goal = CellAt(maze, prey);
    stalker.far[goal] = 0;
    stalker.line[0] = goal;
    mut var head = 0;
    mut var tail = 1;
    while (head < tail)
    {
        var cell = stalker.line[head];
        head += 1;
        for (var way = 0; way < 4; way++)
        {
            if (!MazeOpen(maze, cell, way)) continue;
            var beside = CellBeside(maze, cell, way);
            if (stalker.far[beside] <= stalker.far[cell] + 1) continue;
            stalker.far[beside] = stalker.far[cell] + 1;
            stalker.line[tail] = beside;
            tail += 1;
        }
    }
    // To the middle of the next cell nearer; in its prey's cell, straight at it
    mut var target = CellMiddle(maze, stalker.next);
    if (stalker.cell == goal && stalker.next == goal) target = float3(prey.x, 0, prey.z);
    var step = (stalker.dark ? 9.0 : 4.5) * time.dt;
    var gap = Math.Distance(target.xz, stalker.at.xz);
    if (gap <= step)
    {
        stalker.at = target;
        stalker.cell = stalker.next;
        for (var way = 0; way < 4; way++)
            if (MazeOpen(maze, stalker.cell, way) && stalker.far[CellBeside(maze, stalker.cell, way)] < stalker.far[stalker.next]) stalker.next = CellBeside(maze, stalker.cell, way);
    }
    else stalker.at += (target - stalker.at) * (step / gap);
    stalker.moved = 1;
    stalker.walked += step;
}

system Shadow(mut Shade shade, mut Watcher watcher, mut Arena arena, query (Operator pilot) operators, query (Prowl prowl) prowls, Time time)
{
    mut var zone = Prowl { };
    mut var found = false;
    foreach (var entry in prowls)
    {
        if (entry.prowl.chamber != arena.chamber || found) continue;
        zone = entry.prowl;
        found = true;
    }
    if (!found) return;
    if (shade.chamber != arena.chamber)
    {
        shade.chamber = arena.chamber;
        shade.at = zone.start;
    }
    shade.lit = zone.light != 0 && Satisfied(arena.signals, zone.light, false);
    mut var nearest = 1000.0;
    mut var prey = shade.at;
    mut var touched = false;
    foreach (var entry in operators)
    {
        var feet = entry.pilot.position;
        var away = Math.Distance(feet.xz, shade.at.xz);
        if (away < 1.35 && Math.Abs(feet.y - shade.at.y) < 1.6) touched = true;
        if (away >= nearest) continue;
        nearest = away;
        prey = feet;
    }
    watcher.state = Watching.Peeking;
    watcher.at = shade.at;
    watcher.lean = 1;
    watcher.yaw = Math.Atan2(prey.x - shade.at.x, prey.z - shade.at.z);
    if (arena.caught > 0) return;
    if (touched)
    {
        arena.caught = time.dt;
        return;
    }
    if (shade.lit || arena.arrive < 3) return;
    // In the dark: for the nearest of them, as near as its bounds let it get
    var target = float3(Math.Clamp(prey.x, zone.bounds.x, zone.bounds.y), zone.start.y, Math.Clamp(prey.z, zone.bounds.z, zone.bounds.w));
    var gap = Math.Distance(target.xz, shade.at.xz);
    if (gap < 0.02) return;
    shade.at += (target - shade.at) * (Math.Min(gap, 3.6 * time.dt) / gap);
}

system Haunt(mut Watcher watcher, Arena arena, Place place, query (Operator pilot) operators, query (Pillar pillar) pillars, Time time)
{
    if (arena.ticks < 2)
    {
        watcher.state = Watching.Away;
        watcher.wait = 100;
        watcher.blink = 0;
        watcher.lean = 0;
        watcher.seen = 0;
    }
    watcher.blink = Math.Max(0, watcher.blink - time.dt);
    // Only in a room to solve with pillars to keep behind: elsewhere it's another thing's place, or nobody's
    mut var pillarCount = 0;
    mut var middle = float3(0);
    foreach (var entry in pillars)
    {
        if (entry.pillar.chamber != arena.chamber) continue;
        if (pillarCount == watcher.spot) middle = float3(entry.pillar.at.x, 0, entry.pillar.at.z);
        pillarCount += 1;
    }
    if (place.kind != PlaceKind.Puzzle || pillarCount == 0) return;
    mut var nearest = 1000.0;
    mut var nearestAt = middle + float3(0, 0, 1);
    mut var victimAt = middle;
    mut var victimYaw = 0.0;
    mut var looked = false;
    mut var nearestId = 0;
    foreach (var entry in operators)
    {
        var far = Math.Distance(entry.pilot.position.xz, middle.xz);
        if (far < nearest)
        {
            nearest = far;
            nearestAt = entry.pilot.position;
            nearestId = entry.pilot.id;
        }
        if (entry.pilot.id == watcher.victim)
        {
            victimAt = entry.pilot.position;
            victimYaw = entry.pilot.yaw;
        }
        var to = watcher.at + float3(0, 1.2, 0) - (entry.pilot.position + float3(0, EYE_HIGH * entry.pilot.scale, 0));
        var away = Math.Length(to);
        if (away < 18 && Math.Dot(to / Math.Max(away, 0.001), LookDirection(entry.pilot.yaw, entry.pilot.pitch)) > 0.93) looked = true;
    }
    if (watcher.state == Watching.Away)
    {
        watcher.wait -= time.dt;
        if (watcher.wait > 0) return;
        // Behind a pillar nobody is near, or not this time
        var spot = Random.NextInt(pillarCount);
        var bold = Random.NextInt(5) == 0;
        var left = Random.NextBool();
        watcher.wait = 15;
        mut var chosen = float3(0);
        mut var index = 0;
        foreach (var entry in pillars)
        {
            if (entry.pillar.chamber != arena.chamber) continue;
            if (index == spot) chosen = entry.pillar.at;
            index += 1;
        }
        mut var clear = true;
        foreach (var entry in operators)
            if (Math.Distance(entry.pilot.position.xz, chosen.xz) < 5.5) clear = false;
        if (!clear) return;
        watcher.state = Watching.Peeking;
        watcher.spot = spot;
        watcher.bold = bold;
        watcher.side = left ? -1 : 1;
        watcher.timer = 0;
        watcher.stared = 0;
        watcher.lean = 0;
        watcher.blink = 0.16;
        watcher.seen += 1;
        return;
    }
    watcher.timer += time.dt;
    if (watcher.state == Watching.Lunging)
    {
        watcher.at = Math.Lerp(watcher.at, victimAt + LookDirection(victimYaw, 0) * 0.85, Math.Saturate(watcher.timer / 0.12));
        var back = victimAt - watcher.at;
        watcher.yaw = Math.Atan2(back.x, back.z);
        if (watcher.timer < 0.75) return;
        watcher.state = Watching.Away;
        watcher.blink = 0.2;
        watcher.lean = 0;
        watcher.wait = 150 + Random.NextInt(240);
        return;
    }
    // It keeps its pillar between itself and whoever is nearest, and leans out of one side of it
    mut var toward = nearestAt.xz - middle.xz;
    toward = nearest > 0.01 ? toward / nearest : float2(0, 1);
    var hidden = middle.xz - toward * 0.8;
    var out = float2(toward.y, -toward.x) * (watcher.side * 0.6 * watcher.lean);
    watcher.at = float3(hidden.x + out.x, 0, hidden.y + out.y);
    watcher.yaw = Math.Atan2(toward.x, toward.y);
    if (watcher.state == Watching.Hiding)
    {
        watcher.lean -= time.dt * 3.2;
        if (watcher.lean > 0) return;
        watcher.lean = 0;
        watcher.state = Watching.Away;
        watcher.wait = 150 + Random.NextInt(240);
        return;
    }
    watcher.lean = Math.Min(1, watcher.lean + time.dt * 1.6);
    if (looked) watcher.stared += time.dt;
    if (watcher.bold && nearest < 2.7)
    {
        watcher.state = Watching.Lunging;
        watcher.victim = nearestId;
        watcher.timer = 0;
        return;
    }
    if (watcher.timer > 25 || watcher.stared > 2.2 || (!watcher.bold && nearest < 5)) watcher.state = Watching.Hiding;
}
