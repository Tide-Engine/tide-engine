// FOLDLINE: two operators, a pair of folds shot onto any wall that takes one,
// and a cube that keeps its speed through them. The rooms, the operators and
// the cube are Box3D's.
using Box3D;

settings
{
    title = "FOLDLINE";
    tickRate = 60;
    maxPlayers = 2;
    hostMigration = true;
}

singleton Arena
{
    int level;
    int chamber;         // Counts the chambers built: what's of an older one is swept away
    float gate;
    bool solved;
    bool complete;
    bool plateA;
    bool plateB;
    bool hold;           // The lobby's plate is stood on: the gate stays up for whoever is still to come
    int ticks;
    int joined;
    PlayerID first;
    PlayerID second;
    Entity op0;
    Entity op1;
    Entity cube;
}

// One end of the fold: an opening on a wall's face. `at` is its middle, and
// `size` how many times the usual 1.36 by 2.6 meters it is.
struct Portal
{
    bool open;
    float3 at;
    float3 face = float3(0, 0, 1);
    Entity wall;
    float size = 1;
}

singleton Fold
{
    Portal amber;
    Portal cyan;
    [Position] float3 cube = float3(-3, 0.5, -8);
    [Rotation] quaternion cubeTurn = quaternion.identity;
    float cubeScale = 1;
    int carried = -1;
    bool tossed;         // The cube was let go of this tick, at `toss`
    float3 toss;
    float3 ping;
    float pingTime;
    int pingOperator;
    int traversals;
    int busy;            // Ticks since something was in a fold's mouth: neither end moves while it is
    // A shot that found no place for a fold: where, on what, and for how long it shows
    float3 fizzleAt;
    float3 fizzleFace;
    float fizzleTime;
    bool fizzleAmber;
}

// Something that watches from behind a pillar, in every player's match alike,
// and rarely: minutes apart. It leans out as far as half of itself, keeps the
// pillar between it and whoever is nearest, and goes back behind it when an
// operator comes near or looks at it for long: nothing is there by the time
// anyone gets round. A bold one waits, and goes for whoever comes too close.
enum Watching { Away, Peeking, Hiding, Lunging }

singleton Watcher
{
    Watching state;
    int spot;
    float wait = 100;    // Seconds until the next one, while it's away
    float timer;         // Seconds it has peeked, or lunged
    float stared;        // Seconds operators have looked at it
    float blink;         // Seconds the lamps stay out as it comes
    float lean;          // How far out from behind its pillar it is, 0 to 1
    float side = 1;      // Which side of the pillar it leans out of
    bool bold;
    int victim;
    int seen;            // How many have come, in this chamber
    float3 at;           // Where it stands, and which way it faces
    float yaw;
}

// An operator: a capsule of Box3D's, with where its feet are for what draws it.
component Operator
{
    int id;
    [Position] float3 position;
    [Rotation] float yaw;
    float pitch;
    float3 velocity;
    float scale = 1;
    float3 last;         // Its body's middle a tick ago: a fold is crossed between the two
    bool grounded;
    float resize;        // The size it's to be made again at, 0 for as it is: a body's shape is made once
    float taken;         // How long the hands in a pit have had it, 0 while they don't
    int chamber = -1;
}

component Cube
{
    float3 last;
    float scale = 1;
    int chamber;
}

// A wall, a floor, a ceiling or a thing standing on one: a box of the room.
// Its colliders are its pieces, which leave a hole where a fold is on it.
component Wall
{
    float3 center;
    float3 size;
    float paint;         // Which square of the renderer's sheet it's painted with
    float tiles = 0.5;   // ...and how many of them a meter
    bool takes;          // A fold can be put on its upright faces
    int kind;            // 0 a wall, 1 a planter, 2 a ceiling, 3 a crate
    int version;         // Counts the folds put on it and taken off
    int made;            // ...and which of those its pieces are for
    int chamber;
}

component Piece
{
    Entity wall;
    int version;
}

component Gate { int chamber; }

local singleton Control
{
    int active;
    bool started;
    int crisp;           // P: the picture's rows, 0 LINES, 1 SOFT_LINES, 2 the window's own
    float sensitivity = 0.003;
}

input PilotInput
{
    [Absolute, Clamp(0, 1)] int active;
    [Clamp(-1, 1)] float2 move;
    [Clamp(-0.4, 0.4)] float2 look;
    bool jump;
    bool amber;
    bool cyan;
    bool carry;
    bool hurl;
    bool ping;
    bool reset;

    Sample(Devices devices, Control control)
    {
        active = control.active;
        if (!control.started) return;
        var keys = devices.keyboard;
        move.x = (keys.d.pressed ? 1 : 0) - (keys.a.pressed ? 1 : 0);
        move.y = (keys.w.pressed ? 1 : 0) - (keys.s.pressed ? 1 : 0);
        move += devices.gamepad.leftStick;
        if (Cursor.locked) look = devices.mouse.delta * control.sensitivity;
        look += devices.gamepad.rightStick * 0.045;
        jump = keys.space.pressed || devices.gamepad.buttonSouth.pressed;
        amber = devices.mouse.left.pressed || devices.gamepad.rightTrigger > 0.3;
        cyan = devices.mouse.right.pressed || devices.gamepad.leftTrigger > 0.3;
        carry = keys.e.pressed || devices.gamepad.buttonWest.pressed;
        hurl = keys.f.pressed || devices.gamepad.buttonEast.pressed;
        ping = keys.q.pressed || devices.gamepad.buttonNorth.pressed;
        reset = keys.r.pressed;
    }
}

scene Main { }
event Restart { }
command SelectChamber { int level; }

const float FOLD_HALF_WIDE = 0.68;
const float FOLD_HALF_HIGH = 1.3;
const float BODY_RADIUS = 0.26;
const float BODY_HIGH = 1.8;
const float EYE_HIGH = 1.55;
const float CUBE_SIDE = 0.74;
const float CEILING_HIGH = 4.4;
const int PILLARS = 2;
const int CHAMBERS = 5;
const float PIT_SURFACE = -0.8; // Where the red of a pit lies, under the floor
const float TAKEN_UNDER = -1.05; // A body's middle this far under the floor is chin deep in it, and in the hands' reach
const float TAKEN_FOR = 1.9;    // How long they drag it down before it's gone
const float SMALLEST = 0.5;  // The sizes a fold's end is shot at, and so the sizes anything comes out of one
const float LARGEST = 1.5;

// A frame painted on a wall: a fold's end shot into it is its size, and
// anywhere else an end is whole. The size is the wall's, not the shot's.
struct Mount
{
    float3 at;
    float3 face;
    float size;
}

int MountCount(int level)
{
    return level == 4 ? 2 : level >= 2 ? 1 : 0;
}

Mount ChamberMount(int level, int index)
{
    var small = Mount { at = float3(9.8, FOLD_HALF_HIGH * SMALLEST, 1.5), face = float3(-1, 0, 0), size = SMALLEST };
    if (level == 2) return small;
    if (level == 3) return Mount { at = float3(-2.5, FOLD_HALF_HIGH * LARGEST, -13), face = float3(0, 0, 1), size = LARGEST };
    if (index == 0) return Mount { at = float3(-9.8, FOLD_HALF_HIGH * SMALLEST, -3.5), face = float3(1, 0, 0), size = SMALLEST };
    return Mount { at = float3(5.5, FOLD_HALF_HIGH * LARGEST, -13), face = float3(0, 0, 1), size = LARGEST };
}

// Each chamber is the same hall, 19.6 m by 26, with the way out through a
// gate in its north wall, and its own floor, walls and rooms inside:
// 0 a pit to fold across; 1 the two apart, behind a grille; 2 a room whose
// only way in is a vent; 3 a pit only someone made larger jumps; 4 both.
// Every gate takes two plates weighted at once, and the cube is one weight:
// someone stands on the other, and is let through by whoever went first and
// stands on the lobby's plate.
const float3 HOLD_PLATE = float3(0, 0.04, 16);

float3 OperatorStart(int level, int id)
{
    if (level == 4) return float3(id == 0 ? 1.0 : 4.0, 0, -10.5);
    if (level == 1) return float3(id == 0 ? -5.0 : 4.0, 0, -10.5);
    return float3(id == 0 ? -1.4 : 1.4, 0, -10.5);
}

float3 CubeStart(int level)
{
    switch (level)
    {
        case 1: return float3(-5, 0.5, -6);
        case 2: return float3(0, 0.5, -6);
        case 4: return float3(-7, 0.5, -11);
        default: return float3(-3, 0.5, -8);
    }
}

int PlateCount(int level)
{
    return 2;
}

float3 PlatePosition(int level, int index)
{
    if (index >= PlateCount(level)) return float3(0, -50, 0);
    switch (level)
    {
        case 0: return index == 0 ? float3(5, 0.04, 8) : float3(-5, 0.04, 8);
        case 1: return index == 0 ? float3(5, 0.04, 8) : float3(-5, 0.04, 9.5);
        case 2: return index == 0 ? float3(-4, 0.04, 9) : float3(7.5, 0.04, 10);
        default: return index == 0 ? float3(5, 0.04, 8) : float3(-6, 0.04, 12);
    }
}

// The pillars the watcher keeps behind: each its middle's x and z and half its size.
float4 Pillar(int level, int index)
{
    switch (level)
    {
        case 0: return index == 0 ? float4(-6.6, -10.6, 0.45, 0.45) : float4(6.8, 6, 0.45, 0.45);
        case 1: return index == 0 ? float4(6.5, -6, 0.45, 0.45) : float4(7.5, 4, 0.45, 0.45);
        case 2: return index == 0 ? float4(-6.6, -10.6, 0.45, 0.45) : float4(-6.5, 2, 0.45, 0.45);
        default: return index == 0 ? float4(7, -9, 0.45, 0.45) : float4(7, 10.5, 0.45, 0.45);
    }
}

float3 LookDirection(float yaw, float pitch)
{
    var flat = Math.Cos(pitch);
    return float3(Math.Sin(yaw) * flat, Math.Sin(pitch), Math.Cos(yaw) * flat);
}

// A fold's right, as it's looked at from before its wall.
float3 FoldRight(float3 face)
{
    return Math.Cross(float3(0, 1, 0), face);
}

bool Linked(Fold fold)
{
    return fold.amber.open && fold.cyan.open;
}

// What a fold does to a direction: into one wall is out of the other, turned
// about the vertical.
float3 FoldDirection(Portal from, Portal to, float3 direction)
{
    var x = Math.Dot(direction, FoldRight(from.face));
    var z = Math.Dot(direction, from.face);
    return -FoldRight(to.face) * x + float3(0, direction.y, 0) - to.face * z;
}

// ...and to a place: as far from the other end's middle, by that end's size.
float3 FoldPoint(Portal from, Portal to, float3 point)
{
    return to.at + FoldDirection(from, to, point - from.at) * (to.size / from.size);
}

// Whether a place is within a fold's opening, seen along its wall.
bool InMouth(Portal portal, float3 point, float margin)
{
    var offset = point - portal.at;
    return Math.Abs(Math.Dot(offset, FoldRight(portal.face))) < FOLD_HALF_WIDE * portal.size + margin
        && Math.Abs(offset.y) < FOLD_HALF_HIGH * portal.size + margin;
}

// Crossing a fold: a body whose middle went from before a wall's face to past
// it is as far past the other face, with its speed turned and scaled. Says by
// how much the body's size changes, 0 for no crossing.
float Traverse(mut Fold fold, float3 before, mut float3 center, mut float3 velocity, mut float yaw)
{
    if (!Linked(fold)) return 0;
    for (var side = 0; side < 2; side++)
    {
        var from = side == 0 ? fold.amber : fold.cyan;
        var to = side == 0 ? fold.cyan : fold.amber;
        var was = Math.Dot(before - from.at, from.face);
        var now = Math.Dot(center - from.at, from.face);
        if (was < 0 || now >= 0 || !InMouth(from, center, 0.3)) continue;
        var ratio = to.size / from.size;
        center = FoldPoint(from, to, center);
        velocity = FoldDirection(from, to, velocity) * ratio;
        var facing = FoldDirection(from, to, LookDirection(yaw, 0));
        yaw = Math.Atan2(facing.x, facing.z);
        fold.traversals += 1;
        return ratio;
    }
    return 0;
}

// How far a thing is from a hand, squared: straight there, or through a fold
// where that's nearer, so what lies just past a fold can be picked up.
float Reach(Fold fold, float3 hand, float3 thing)
{
    mut var nearest = Math.DistanceSq(hand, thing);
    if (!Linked(fold)) return nearest;
    nearest = Math.Min(nearest, Math.DistanceSq(FoldPoint(fold.amber, fold.cyan, hand), thing));
    return Math.Min(nearest, Math.DistanceSq(FoldPoint(fold.cyan, fold.amber, hand), thing));
}

// Whether a body is in either fold's mouth: neither end is moved while one is.
bool AtMouth(Fold fold, float3 center, float reach)
{
    for (var side = 0; side < 2; side++)
    {
        var portal = side == 0 ? fold.amber : fold.cyan;
        if (!portal.open) continue;
        var depth = Math.Dot(center - portal.at, portal.face);
        if (depth > -0.3 && depth < reach && InMouth(portal, center, 0.1)) return true;
    }
    return false;
}

bool Weighs(float3 position, float3 plate)
{
    return position.y < 0.8 && Math.DistanceSq(position.xz, plate.xz) < 1.2;
}

// A box of the room, with its one piece.
Entity Raise(Arena arena, float3 center, float3 size, float paint, bool takes = false, int kind = 0, float tiles = 0.5)
{
    var wall = Spawn(Wall { center = center, size = size, paint = paint, tiles = tiles, takes = takes, kind = kind, chamber = arena.chamber });
    Spawn(Piece { wall = wall }, Body { type = BodyType.Static, position = center }, Box { size = size });
    return wall;
}

// A chamber's boxes. Wallpaper takes a fold and concrete refuses one; a wall
// under 0.6 m thick takes none whatever it's papered with.
void BuildChamber(mut Arena arena, int level)
{
    arena.level = level;
    arena.chamber += 1;
    // The squares of the renderer's sheet: render.tide's names for them
    var concrete = 3.0;
    var panels = 2.0;
    var planks = 5.0;
    var rust = 9.0;
    var wallpaper = 12.0;
    var carpet = 13.0;
    var ceilingTile = 14.0;

    // The hall: its ceiling, its walls, the lobby past the gate, and the gate.
    var sides = level < 3;
    Raise(arena, float3(0, CEILING_HIGH + 0.5, 2.1), float3(21.6, 1, 32.2), ceilingTile, false, 2, 0.833);
    if (level == 4)
    {
        // Only the stretch of the west wall this side of the pit takes a fold
        Raise(arena, float3(-10.3, 1.2, -7.75), float3(1, 8.4, 12.5), wallpaper, true);
        Raise(arena, float3(-10.3, 1.2, 6.25), float3(1, 8.4, 15.5), panels);
    }
    else Raise(arena, float3(-10.3, 1.2, 0), float3(1, 8.4, 28), sides ? wallpaper : panels, sides);
    Raise(arena, float3(10.3, 1.2, 0), float3(1, 8.4, 28), sides ? wallpaper : panels, sides);
    Raise(arena, float3(0, 1.2, -13.5), float3(19.6, 8.4, 1), wallpaper, true);
    Raise(arena, float3(-6.4, 1.2, 13.5), float3(6.8, 8.4, 1), sides ? wallpaper : panels, sides);
    Raise(arena, float3(6.4, 1.2, 13.5), float3(6.8, 8.4, 1), sides ? wallpaper : panels, sides);
    Raise(arena, float3(0, 4.2, 13.5), float3(6, 0.4, 1), panels);
    Raise(arena, float3(0, -0.5, 15.6), float3(6, 1, 3.2), concrete);
    Raise(arena, float3(-3.5, 2.2, 15.6), float3(1, 4.4, 3.2), panels);
    Raise(arena, float3(3.5, 2.2, 15.6), float3(1, 4.4, 3.2), panels);
    Raise(arena, float3(0, 2.2, 17.7), float3(8, 4.4, 1), panels);
    Spawn(Gate { chamber = arena.chamber }, Body { type = BodyType.Kinematic, position = float3(0, 2, 13.5) }, Box { size = float3(6, 4, 0.24) });

    // The floor: whole, or with a pit across it that has no bottom.
    if (level == 0)
    {
        Raise(arena, float3(0, -0.5, -8.75), float3(21.6, 1, 10.5), carpet);
        Raise(arena, float3(0, -0.5, 7.75), float3(21.6, 1, 12.5), carpet);
    }
    else if (level >= 3)
    {
        Raise(arena, float3(0, -0.5, -7.75), float3(21.6, 1, 12.5), carpet);
        Raise(arena, float3(0, -0.5, 8.75), float3(21.6, 1, 10.5), carpet);
        // A slab past the pit: concrete towards it, and paper on the side that can't be seen from there
        Raise(arena, float3(-5.5, 2.2, 9.25), float3(5, 4.4, 0.5), panels);
        Raise(arena, float3(-5.5, 2.2, 10), float3(5, 4.4, 1), wallpaper, true);
    }
    else Raise(arena, float3(0, -0.5, 0), float3(21.6, 1, 28), carpet);

    if (level == 1)
    {
        // A grille shuts the south-west of the hall off: seen through, and nothing else goes through, a shot neither
        Raise(arena, float3(-1, 2.2, -3.6), float3(0.3, 4.4, 18.8), rust, false, 4);
        Raise(arena, float3(-5.5, 2.2, 5.95), float3(8.7, 4.4, 0.3), rust, false, 4);
    }
    if (level == 2)
    {
        // A room in the corner whose only way in is a vent a meter high, with a baffle behind it
        Raise(arena, float3(3.8, 2.2, 8.8), float3(0.4, 4.4, 8.4), panels);
        Raise(arena, float3(4.3, 2.2, 4.8), float3(1.4, 4.4, 0.4), panels);
        Raise(arena, float3(7.9, 2.2, 4.8), float3(3.8, 4.4, 0.4), panels);
        Raise(arena, float3(5.5, 2.7, 4.8), float3(1, 3.4, 0.4), panels);
        Raise(arena, float3(6, 0.8, 6.4), float3(4, 1.6, 0.4), rust);
    }
    if (level == 4)
    {
        // The same room in the near corner, with the cube shut in it
        Raise(arena, float3(-3.8, 2.2, -9.3), float3(0.4, 4.4, 7.4), panels);
        Raise(arena, float3(-8.9, 2.2, -5.8), float3(1.8, 4.4, 0.4), panels);
        Raise(arena, float3(-5.3, 2.2, -5.8), float3(3.4, 4.4, 0.4), panels);
        Raise(arena, float3(-7.5, 2.7, -5.8), float3(1, 3.4, 0.4), panels);
        Raise(arena, float3(-7.9, 0.8, -7.4), float3(3.8, 1.6, 0.4), rust);
    }

    // What stands about: a planter and crates by the south wall, and the pillars.
    if (level != 4) Raise(arena, float3(-9, 0.36, -11.5), float3(0.85, 0.72, 2.0), concrete, false, 1, 1);
    Raise(arena, float3(9, 0.36, -7), float3(0.85, 0.72, 2.0), concrete, false, 1, 1);
    Raise(arena, float3(8.6, 0.45, -12.3), float3(0.9, 0.9, 0.9), planks, false, 3);
    Raise(arena, float3(7.6, 0.45, -12.4), float3(0.9, 0.9, 0.9), planks, false, 3);
    for (var pillar = 0; pillar < PILLARS; pillar++)
    {
        var box = Pillar(level, pillar);
        Raise(arena, float3(box.x, CEILING_HIGH * 0.5, box.y), float3(0.9, CEILING_HIGH, 0.9), wallpaper);
    }

    arena.cube = Spawn(Cube { chamber = arena.chamber, last = CubeStart(level) }, Body { position = CubeStart(level) },
          Box { size = float3(CUBE_SIDE), density = 120, friction = 0.7 });
}

void ResetChamber(mut Arena arena, mut Fold fold, int level)
{
    arena.gate = 0;
    arena.solved = false;
    arena.complete = false;
    arena.plateA = false;
    arena.plateB = false;
    arena.hold = false;
    arena.ticks = 0;
    fold.amber = Portal { };
    fold.cyan = Portal { };
    fold.cube = CubeStart(level);
    fold.cubeTurn = quaternion.identity;
    fold.cubeScale = 1;
    fold.carried = -1;
    fold.tossed = false;
    fold.pingTime = 0;
    fold.fizzleTime = 0;
    fold.traversals = 0;
    fold.busy = 0;
    BuildChamber(arena, level);
}

event(Spawned) BuildAtrium(with Main, mut Arena arena, mut Fold fold, mut Physics physics)
{
    physics.gravity = float3(0, -18, 0);
    arena.op0 = Spawn(Operator { id = 0, position = OperatorStart(0, 0) }, Owner,
                      Body { position = OperatorStart(0, 0) + float3(0, BODY_HIGH * 0.5, 0) },
                      Capsule { radius = BODY_RADIUS, height = BODY_HIGH, density = 250, friction = 0 });
    arena.op1 = Spawn(Operator { id = 1, position = OperatorStart(0, 1) }, Owner,
                      Body { position = OperatorStart(0, 1) + float3(0, BODY_HIGH * 0.5, 0) },
                      Capsule { radius = BODY_RADIUS, height = BODY_HIGH, density = 250, friction = 0 });
    ResetChamber(arena, fold, 0);
}

event(PlayerJoined joined) AssignOperator(mut Arena arena, mut World world)
{
    if (joined.player == arena.first || joined.player == arena.second) return;
    if (arena.joined == 0)
    {
        arena.first = joined.player;
        arena.joined = 1;
        world.Set<Owner>(arena.op0, Owner { player = joined.player });
        world.Set<Owner>(arena.op1, Owner { player = joined.player });
    }
    else if (arena.joined == 1)
    {
        arena.second = joined.player;
        arena.joined = 2;
        world.Set<Owner>(arena.op1, Owner { player = joined.player });
    }
}

event(PlayerLeft left) ReassignOperator(mut Arena arena, mut World world)
{
    if (left.player != arena.first && left.player != arena.second) return;
    if (left.player == arena.first) arena.first = arena.second;
    arena.second = default;
    arena.joined = Math.Max(0, arena.joined - 1);
    world.Set<Owner>(arena.op0, Owner { player = arena.first });
    world.Set<Owner>(arena.op1, Owner { player = arena.first });
}

event(Restart) RestartChamber(mut Arena arena, mut Fold fold)
{
    ResetChamber(arena, fold, arena.level);
}

command(SelectChamber selection, PlayerID sender) ChooseChamber(mut Arena arena, mut Fold fold)
{
    if (sender != arena.first && sender != arena.second) return;
    if (selection.level < 0 || selection.level >= CHAMBERS) return;
    ResetChamber(arena, fold, selection.level);
}

// A wall's folds changed: its pieces are made again.
void Rework(mut World world, Entity wall)
{
    if (!world.TryGet<Wall>(wall, out var found)) return;
    mut var changed = found;
    changed.version += 1;
    world.Set<Wall>(wall, changed);
}

void Fizzle(mut Fold fold, bool amber, float3 at, float3 face)
{
    fold.fizzleAt = at;
    fold.fizzleFace = face;
    fold.fizzleTime = 0.6;
    fold.fizzleAmber = amber;
}

// A shot: a fold's end goes where it lands, nudged to fit on that face, or
// fizzles there. It fits on an upright face of a wall that takes folds, clear
// of the floor, the ceiling, what stands against the wall and the other end.
bool Shoot(mut Fold fold, bool amber, int level, float3 origin, float3 way, Physics physics, mut World world)
{
    if (!physics.Raycast(origin, origin + way * 60, out var first)) return false;
    // Through whoever and whatever stands in the way that's no part of the room
    mut var hit = first;
    for (var past = 0; past < 3 && !world.Has<Piece>(hit.entity); past++)
        if (!physics.Raycast(hit.point + way * 0.9, origin + way * 60, out hit)) return false;
    mut var face = float3(0, 1, 0);
    if (Math.Abs(hit.normal.y) < 0.3)
        face = Math.Abs(hit.normal.x) > Math.Abs(hit.normal.z) ? float3(Math.Sign(hit.normal.x), 0, 0) : float3(0, 0, Math.Sign(hit.normal.z));
    var mine = amber ? fold.amber : fold.cyan;
    var other = amber ? fold.cyan : fold.amber;
    if (fold.busy > 0 || face.y > 0.5 || !world.TryGet<Piece>(hit.entity, out var piece) || !world.TryGet<Wall>(piece.wall, out var wall) || !wall.takes)
    {
        Fizzle(fold, amber, hit.point, hit.normal);
        return false;
    }
    var right = FoldRight(face);
    // A shot in a frame, or by it, goes into it at the frame's size
    mut var size = 1.0;
    mut var aim = hit.point;
    for (var index = 0; index < MountCount(level); index++)
    {
        var mount = ChamberMount(level, index);
        var off = hit.point - mount.at;
        if (Math.Dot(mount.face, face) < 0.9 || Math.Abs(Math.Dot(off, face)) > 0.3) continue;
        if (Math.Abs(Math.Dot(off, right)) > FOLD_HALF_WIDE * mount.size + 0.35 || Math.Abs(off.y) > FOLD_HALF_HIGH * mount.size + 0.35) continue;
        size = mount.size;
        aim = mount.at;
    }
    var halfWide = FOLD_HALF_WIDE * size;
    var halfHigh = FOLD_HALF_HIGH * size;
    var along = Math.Abs(face.x) > 0.5;
    var thick = along ? wall.size.x : wall.size.z;
    var wide = along ? wall.size.z : wall.size.x;
    // The other end on this wall's other pair of faces would need holes two ways through it
    var crossed = other.open && other.wall == piece.wall && Math.Abs(Math.Dot(other.face, face)) < 0.5;
    if (thick < 0.6 || wide < halfWide * 2 || crossed)
    {
        Fizzle(fold, amber, hit.point, face);
        return false;
    }
    var plane = wall.center + face * (thick * 0.5);
    mut var u = Math.Dot(aim - wall.center, right);
    mut var v = aim.y;
    mut var lowU = -wide * 0.5 + halfWide;
    mut var highU = wide * 0.5 - halfWide;
    mut var lowV = wall.center.y - wall.size.y * 0.5 + halfHigh;
    mut var highV = wall.center.y + wall.size.y * 0.5 - halfHigh;
    // What's around the place, a hand's width off the wall: the floor, the ceiling and what stands either side
    var probe = float3(plane.x + right.x * u, v, plane.z + right.z * u) + face * 0.2;
    mut var floor = lowV - halfHigh;
    if (physics.Raycast(probe, probe - float3(0, 8, 0), out var under)) floor = under.point.y;
    lowV = Math.Max(lowV, floor + halfHigh);
    if (physics.Raycast(probe, probe + float3(0, 8, 0), out var over)) highV = Math.Min(highV, over.point.y - halfHigh);
    if (physics.Raycast(probe, probe - right * 3, out var before)) lowU = Math.Max(lowU, Math.Dot(before.point - wall.center, right) + halfWide);
    if (physics.Raycast(probe, probe + right * 3, out var after)) highU = Math.Min(highU, Math.Dot(after.point - wall.center, right) - halfWide);
    if (lowU > highU || lowV > highV)
    {
        Fizzle(fold, amber, hit.point, face);
        return false;
    }
    u = Math.Clamp(u, lowU, highU);
    v = Math.Clamp(v, lowV, highV);
    // Near the floor it stands on it, to be walked into
    if (v - halfHigh - floor < 1.0) v = lowV;
    var at = float3(plane.x + right.x * u, v, plane.z + right.z * u);
    var overlaps = other.open && Math.Dot(other.face, face) > 0.9 && Math.Abs(Math.Dot(other.at - at, face)) < 0.2
                && Math.Abs(Math.Dot(other.at - at, right)) < halfWide + FOLD_HALF_WIDE * other.size + 0.1
                && Math.Abs(other.at.y - at.y) < halfHigh + FOLD_HALF_HIGH * other.size + 0.1;
    // ...and nothing of the room stands in the opening's way
    mut var blocked = false;
    if (physics.Overlap(Box { size = float3(halfWide * 2 - 0.12, halfHigh * 2 - 0.12, 0.3) }, at + face * 0.3,
                        quaternion.LookRotation(face, float3(0, 1, 0)), out var found))
    {
        foreach (var entity in found)
            if (world.Has<Piece>(entity)) blocked = true;
    }
    if (overlaps || blocked)
    {
        Fizzle(fold, amber, at, face);
        return false;
    }
    // Every wall an end was or is on: a hole is only there while both ends are
    if (mine.open && mine.wall != piece.wall) Rework(world, mine.wall);
    if (other.open && other.wall != piece.wall && !(mine.open && other.wall == mine.wall)) Rework(world, other.wall);
    Rework(world, piece.wall);
    var placed = Portal { open = true, at = at, face = face, wall = piece.wall, size = size };
    if (amber) fold.amber = placed;
    else fold.cyan = placed;
    return true;
}

[Before(PhysicsStages.Step)]
system MoveOperators(mut Operator pilot, mut Body body, PilotInput input, Arena arena, mut Fold fold, Physics physics, mut World world, Time time)
{
    if (pilot.chamber != arena.chamber)
    {
        // A new chamber: back to the start, standing still
        pilot.chamber = arena.chamber;
        if (pilot.scale != 1) pilot.resize = 1;
        pilot.yaw = 0;
        pilot.pitch = 0;
        body.position = OperatorStart(arena.level, pilot.id) + float3(0, BODY_HIGH * 0.5 * pilot.scale + 0.02, 0);
        body.velocity = float3(0);
        pilot.last = body.position;
        pilot.position = OperatorStart(arena.level, pilot.id);
        this.Snap();
    }
    // It stands upright whatever it's pushed by
    body.rotation = quaternion.identity;
    body.angularVelocity = float3(0);
    if (pilot.taken > 0 || body.position.y < TAKEN_UNDER)
    {
        // The hands in the pit have it: it's stopped where they caught it and dragged under, whatever it does
        pilot.taken += time.dt;
        pilot.grounded = false;
        body.velocity = float3(0, pilot.taken < 0.35 ? 0.0 : -1.3, 0);
        if (fold.carried == pilot.id) fold.carried = -1;
        if (arena.joined >= 2 || input.active == pilot.id)
        {
            pilot.yaw += input.look.x;
            pilot.yaw = Math.Atan2(Math.Sin(pilot.yaw), Math.Cos(pilot.yaw));
            pilot.pitch = Math.Clamp(pilot.pitch + input.look.y, -1.4, 1.4);
        }
        return;
    }
    var half = BODY_HIGH * 0.5 * pilot.scale;
    pilot.grounded = physics.Raycast(body.position, body.position - float3(0, half + 0.1, 0), out _);
    var controlling = arena.joined >= 2 || input.active == pilot.id;
    if (!controlling)
    {
        body.velocity.x *= Math.Max(0, 1 - time.dt * 12);
        body.velocity.z *= Math.Max(0, 1 - time.dt * 12);
        return;
    }
    pilot.yaw += input.look.x;
    pilot.yaw = Math.Atan2(Math.Sin(pilot.yaw), Math.Cos(pilot.yaw));
    pilot.pitch = Math.Clamp(pilot.pitch + input.look.y, -1.4, 1.4);
    if (input.reset.down) Send(Restart);
    var facing = LookDirection(pilot.yaw, pilot.pitch);
    var eye = body.position + float3(0, (EYE_HIGH - BODY_HIGH * 0.5) * pilot.scale, 0);
    // With the cube in hand a click throws it; with empty hands it shoots a fold's end
    var holding = fold.carried == pilot.id;
    var thrown = holding && (input.amber.down || input.cyan.down || input.hurl.down);
    if (!holding && (input.amber.down || input.cyan.down))
    {
        // An end that's shot is there at once, and so are the shards of one that wasn't: nothing slides over
        // from where the last was
        if (input.amber.down) Shoot(fold, true, arena.level, eye, facing, physics, world);
        if (input.cyan.down) Shoot(fold, false, arena.level, eye, facing, physics, world);
        fold.Snap();
    }
    if (input.ping.down)
    {
        fold.ping = physics.Raycast(eye, eye + facing * 40, out var seen) ? seen.point : eye + facing * 4;
        fold.pingTime = 3;
        fold.pingOperator = pilot.id;
    }
    if (holding && (input.carry.down || thrown))
    {
        // Let go of, or thrown
        fold.carried = -1;
        fold.tossed = true;
        fold.toss = facing * (thrown ? 11.0 : 1.5);
    }
    // Alone, the cube is taken from the hands of the body that was left holding it
    else if (input.carry.down && (fold.carried < 0 || arena.joined < 2) && Reach(fold, eye, fold.cube) < 6.25 * pilot.scale * pilot.scale)
        fold.carried = pilot.id;
    var movement = Math.Normalize(input.move);
    var forward = LookDirection(pilot.yaw, 0);
    var right = float3(forward.z, 0, -forward.x);
    var desired = (right * movement.x + forward * movement.y) * (5.2 * pilot.scale);
    body.velocity.x = Math.Lerp(body.velocity.x, desired.x, Math.Min(1, time.dt * 12));
    body.velocity.z = Math.Lerp(body.velocity.z, desired.z, Math.Min(1, time.dt * 12));
    if (input.jump.down && pilot.grounded) body.velocity.y = 6.2 * Math.Sqrt(pilot.scale);
}

// Where a carried cube is held: before its holder's eyes, or through a fold
// where the arm reaches into one, whichever the cube is nearer.
[Before(PhysicsStages.Step)]
system HoldCube(mut Body body, Cube cube, mut Fold fold, Arena arena, query (Operator pilot) operators)
{
    if (cube.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    if (fold.tossed)
    {
        fold.tossed = false;
        mut var toss = fold.toss;
        // Thrown through a fold the arm was in, it leaves the other end
        foreach (var entry in operators)
        {
            var hand = entry.pilot.position + float3(0, EYE_HIGH * entry.pilot.scale, 0);
            if (Math.DistanceSq(hand, body.position) < 9) continue;
            for (var side = 0; side < 2 && Linked(fold); side++)
            {
                var from = side == 0 ? fold.amber : fold.cyan;
                var to = side == 0 ? fold.cyan : fold.amber;
                if (Math.DistanceSq(FoldPoint(from, to, hand), body.position) < 9) toss = FoldDirection(from, to, fold.toss) * (to.size / from.size);
            }
        }
        body.velocity = body.velocity * 0.3 + toss;
        body.gravityScale = 1;
    }
    if (fold.carried < 0)
    {
        if (body.gravityScale != 1) body.gravityScale = 1;
        return;
    }
    foreach (var entry in operators)
    {
        if (entry.pilot.id != fold.carried) continue;
        var hand = entry.pilot.position + float3(0, 1.15 * entry.pilot.scale, 0);
        var held = hand + LookDirection(entry.pilot.yaw, entry.pilot.pitch) * (1.25 * entry.pilot.scale);
        mut var target = held;
        mut var nearest = Math.DistanceSq(held, body.position);
        for (var side = 0; side < 2 && Linked(fold); side++)
        {
            var from = side == 0 ? fold.amber : fold.cyan;
            var to = side == 0 ? fold.cyan : fold.amber;
            var through = FoldPoint(from, to, held);
            var far = Math.DistanceSq(through, body.position);
            if (far < nearest)
            {
                nearest = far;
                target = through;
            }
        }
        if (nearest > 16 * entry.pilot.scale * entry.pilot.scale)
        {
            // Out of reach: it's dropped
            fold.carried = -1;
            body.gravityScale = 1;
            return;
        }
        var pull = (target - body.position) * 16;
        var speed = Math.Length(pull);
        body.velocity = speed > 14 ? pull * (14 / speed) : pull;
        body.angularVelocity = body.angularVelocity * 0.8;
        body.gravityScale = 0;
    }
}

// After the step: an operator that crossed a fold's face is at the other end,
// and the size that end makes of it. A body's shape is made once, so one that
// changes size is another entity, with what this one was.
system CrossOperators(mut Operator pilot, mut Body body, Owner owner, mut Fold fold, mut Arena arena)
{
    mut var center = body.position;
    mut var velocity = body.velocity;
    var ratio = Traverse(fold, pilot.last, center, velocity, pilot.yaw);
    if (ratio > 0)
    {
        body.position = center;
        body.velocity = velocity;
        var scale = Math.Clamp(pilot.scale * ratio, SMALLEST, LARGEST);
        if (Math.Abs(scale - pilot.scale) > 0.01) pilot.resize = scale;
        this.Snap();
    }
    if (pilot.taken > TAKEN_FOR || center.y < -8)
    {
        // Gone under: back where it started
        pilot.taken = 0;
        center = OperatorStart(arena.level, pilot.id) + float3(0, BODY_HIGH * 0.5 * pilot.scale, 0);
        velocity = float3(0);
        body.position = center;
        body.velocity = velocity;
        if (fold.carried == pilot.id) fold.carried = -1;
        this.Snap();
    }
    if (AtMouth(fold, center, 0.7 * pilot.scale)) fold.busy = 3;
    if (pilot.resize > 0)
    {
        // Standing where it stood, at its new size
        var scale = pilot.resize;
        var half = float3(0, BODY_HIGH * 0.5 * scale, 0);
        // Through a fold its middle is where the fold put it; made again where it stands, its feet are
        var feet = ratio > 0 ? center - half : center - float3(0, BODY_HIGH * 0.5 * pilot.scale, 0);
        var born = Spawn(Operator { id = pilot.id, position = feet, yaw = pilot.yaw, pitch = pilot.pitch, velocity = velocity, scale = scale,
                                    last = feet + half, grounded = pilot.grounded, taken = pilot.taken, chamber = pilot.chamber },
                         Owner { player = owner.player }, Body { position = feet + half, velocity = velocity },
                         Capsule { radius = BODY_RADIUS * scale, height = BODY_HIGH * scale, density = 250, friction = 0 });
        if (pilot.id == 0) arena.op0 = born;
        else arena.op1 = born;
        this.Destroy();
        return;
    }
    pilot.last = center;
    pilot.position = center - float3(0, BODY_HIGH * 0.5 * pilot.scale, 0);
    pilot.velocity = body.velocity;
}

system CrossCube(mut Cube cube, mut Body body, mut Fold fold, mut Arena arena)
{
    mut var center = body.position;
    mut var velocity = body.velocity;
    mut var unused = 0.0;
    var amberSide = Math.Abs(Math.Dot(cube.last - fold.amber.at, fold.amber.face)) < Math.Abs(Math.Dot(cube.last - fold.cyan.at, fold.cyan.face));
    var ratio = Traverse(fold, cube.last, center, velocity, unused);
    mut var scale = cube.scale;
    if (ratio > 0)
    {
        // It comes out turned as the fold turns the world
        var from = amberSide ? fold.amber : fold.cyan;
        var to = amberSide ? fold.cyan : fold.amber;
        var ahead = FoldDirection(from, to, Math.Forward(body.rotation));
        var up = FoldDirection(from, to, Math.Up(body.rotation));
        body.rotation = quaternion.LookRotation(ahead, up);
        body.angularVelocity = FoldDirection(from, to, body.angularVelocity);
        body.position = center;
        body.velocity = velocity;
        scale = Math.Clamp(cube.scale * ratio, SMALLEST, LARGEST);
        fold.Snap();
    }
    if (center.y < -8)
    {
        center = CubeStart(arena.level);
        body.position = center;
        body.velocity = float3(0);
        body.angularVelocity = float3(0);
        fold.carried = -1;
        fold.Snap();
    }
    if (AtMouth(fold, center, 0.6 * cube.scale)) fold.busy = 3;
    fold.cube = center;
    fold.cubeTurn = body.rotation;
    fold.cubeScale = scale;
    if (Math.Abs(scale - cube.scale) > 0.01)
    {
        // At its new size: another body, with this one's speed and spin
        arena.cube = Spawn(Cube { chamber = cube.chamber, last = center, scale = scale },
                           Body { position = center, rotation = body.rotation, velocity = body.velocity, angularVelocity = body.angularVelocity,
                                  gravityScale = body.gravityScale },
                           Box { size = float3(CUBE_SIDE * scale), density = 120, friction = 0.7 });
        this.Destroy();
        return;
    }
    cube.last = center;
}

// A wall's pieces: the wall with a hole in it where each fold on it is, as
// deep as the wall less a back to it. The face is cut into a grid by the
// holes' edges, and each cell is a box: all of the wall's depth, or what a
// hole leaves of it.
[Before(PhysicsStages.Step)]
system Carve(mut Wall wall, Fold fold, Arena arena)
{
    if (wall.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    if (wall.made == wall.version) return;
    wall.made = wall.version;
    var first = Linked(fold) && fold.amber.wall == this;
    var second = Linked(fold) && fold.cyan.wall == this;
    if (!first && !second)
    {
        Spawn(Piece { wall = this, version = wall.version }, Body { type = BodyType.Static, position = wall.center }, Box { size = wall.size });
        return;
    }
    var face = first ? fold.amber.face : fold.cyan.face;
    var along = Math.Abs(face.x) > 0.5;
    var axis = along ? float3(1, 0, 0) : float3(0, 0, 1);
    var across = along ? float3(0, 0, 1) : float3(1, 0, 0);
    var thick = along ? wall.size.x : wall.size.z;
    var wide = along ? wall.size.z : wall.size.x;
    mut List<float> us = [-wide * 0.5, wide * 0.5];
    mut List<float> vs = [-wall.size.y * 0.5, wall.size.y * 0.5];
    for (var end = 0; end < 2; end++)
    {
        var portal = end == 0 ? fold.amber : fold.cyan;
        if (!(end == 0 ? first : second)) continue;
        var u = Math.Dot(portal.at - wall.center, across);
        var v = portal.at.y - wall.center.y;
        us.Add(Math.Clamp(u - FOLD_HALF_WIDE * portal.size, -wide * 0.5, wide * 0.5));
        us.Add(Math.Clamp(u + FOLD_HALF_WIDE * portal.size, -wide * 0.5, wide * 0.5));
        vs.Add(Math.Clamp(v - FOLD_HALF_HIGH * portal.size, -wall.size.y * 0.5, wall.size.y * 0.5));
        vs.Add(Math.Clamp(v + FOLD_HALF_HIGH * portal.size, -wall.size.y * 0.5, wall.size.y * 0.5));
    }
    us.Sort(a, b) { return a < b; }
    vs.Sort(a, b) { return a < b; }
    for (var column = 0; column + 1 < us.count; column++)
    {
        var wideHere = us[column + 1] - us[column];
        if (wideHere < 0.01) continue;
        for (var row = 0; row + 1 < vs.count; row++)
        {
            var highHere = vs[row + 1] - vs[row];
            if (highHere < 0.01) continue;
            var u = (us[column] + us[column + 1]) * 0.5;
            var v = (vs[row] + vs[row + 1]) * 0.5;
            mut var low = -thick * 0.5;
            mut var high = thick * 0.5;
            for (var end = 0; end < 2; end++)
            {
                var portal = end == 0 ? fold.amber : fold.cyan;
                if (!(end == 0 ? first : second)) continue;
                if (Math.Abs(u - Math.Dot(portal.at - wall.center, across)) > FOLD_HALF_WIDE * portal.size) continue;
                if (Math.Abs(v - (portal.at.y - wall.center.y)) > FOLD_HALF_HIGH * portal.size) continue;
                var deep = Math.Min(thick - 0.1, 0.95 * portal.size);
                if (Math.Dot(portal.face, axis) > 0) high = Math.Min(high, thick * 0.5 - deep);
                else low = Math.Max(low, -thick * 0.5 + deep);
            }
            if (high - low < 0.02) continue;
            var middle = wall.center + across * u + float3(0, v, 0) + axis * ((low + high) * 0.5);
            var size = across * wideHere + float3(0, highHere, 0) + axis * (high - low);
            Spawn(Piece { wall = this, version = wall.version }, Body { type = BodyType.Static, position = middle }, Box { size = size });
        }
    }
}

// A piece of a wall that's gone, or that was made for other folds, goes.
[Before(PhysicsStages.Step)]
system Uncarve(Piece piece, World world)
{
    if (!world.TryGet<Wall>(piece.wall, out var wall) || wall.version != piece.version) this.Destroy();
}

system MoveGate(mut Body body, Gate gate, Arena arena)
{
    if (gate.chamber != arena.chamber)
    {
        this.Destroy();
        return;
    }
    var height = 2.0 + arena.gate * 4.3;
    if (Math.Abs(body.position.y - height) > 0.001) body.position = float3(0, height, 13.5);
}

system EvaluateChamber(mut Arena arena, mut Fold fold, query (Operator pilot) operators, Time time)
{
    arena.ticks += 1;
    fold.pingTime = Math.Max(0, fold.pingTime - time.dt);
    fold.fizzleTime = Math.Max(0, fold.fizzleTime - time.dt);
    fold.busy = Math.Max(0, fold.busy - 1);
    var cubeA = fold.carried < 0 && Weighs(fold.cube, PlatePosition(arena.level, 0));
    var cubeB = fold.carried < 0 && Weighs(fold.cube, PlatePosition(arena.level, 1));
    mut var operatorA = false;
    mut var operatorB = false;
    mut var exiting = 0;
    mut var holding = false;
    foreach (var entry in operators)
    {
        if (Weighs(entry.pilot.position, HOLD_PLATE)) holding = true;
        if (Weighs(entry.pilot.position, PlatePosition(arena.level, 0))) operatorA = true;
        if (Weighs(entry.pilot.position, PlatePosition(arena.level, 1))) operatorB = true;
        if (entry.pilot.position.z > 14.2 && Math.Abs(entry.pilot.position.x) < 3 && entry.pilot.position.y > -0.1) exiting += 1;
    }
    arena.plateA = cubeA || operatorA;
    arena.plateB = cubeB || operatorB;
    // A circuit is closed only while its plates are weighted: the gate shuts again when one is let up, so
    // something has to stay behind on each. The cube, or a partner.
    arena.solved = arena.plateA && (PlateCount(arena.level) < 2 || arena.plateB);
    // ...or the one who went through first stands on the lobby's plate, for the one who stayed
    arena.hold = holding;
    arena.gate = Math.Clamp(arena.gate + (arena.solved || arena.hold ? time.dt * 1.6 : -time.dt * 2.4), 0, 1);
    if (exiting == 2) arena.complete = true;
}

system Haunt(mut Watcher watcher, Arena arena, query (Operator pilot) operators, Time time)
{
    if (arena.ticks < 2)
    {
        watcher.state = Watching.Away;
        watcher.wait = 100;
        watcher.blink = 0;
        watcher.lean = 0;
        watcher.seen = 0;
    }
    watcher.blink = Math.Max(0, watcher.blink - time.dt);
    if (arena.complete) return;
    var pillar = Pillar(arena.level, watcher.spot);
    var middle = float3(pillar.x, 0, pillar.y);
    mut var nearest = 1000.0;
    mut var nearestAt = middle + float3(0, 0, 1);
    mut var victimAt = middle;
    mut var victimYaw = 0.0;
    mut var looked = false;
    mut var nearestId = 0;
    foreach (var entry in operators)
    {
        var far = Math.Distance(entry.pilot.position.xz, middle.xz);
        if (far < nearest)
        {
            nearest = far;
            nearestAt = entry.pilot.position;
            nearestId = entry.pilot.id;
        }
        if (entry.pilot.id == watcher.victim)
        {
            victimAt = entry.pilot.position;
            victimYaw = entry.pilot.yaw;
        }
        var to = watcher.at + float3(0, 1.2, 0) - (entry.pilot.position + float3(0, 1.55, 0));
        var away = Math.Length(to);
        if (away < 18 && Math.Dot(to / Math.Max(away, 0.001), LookDirection(entry.pilot.yaw, entry.pilot.pitch)) > 0.93) looked = true;
    }
    if (watcher.state == Watching.Away)
    {
        watcher.wait -= time.dt;
        if (watcher.wait > 0) return;
        // Behind a pillar nobody is near, or not this time
        var spot = Random.NextInt(PILLARS);
        var bold = Random.NextInt(5) == 0;
        var left = Random.NextBool();
        watcher.wait = 15;
        var chosen = Pillar(arena.level, spot);
        mut var clear = true;
        foreach (var entry in operators)
            if (Math.Distance(entry.pilot.position.xz, chosen.xy) < 5.5) clear = false;
        if (!clear) return;
        watcher.state = Watching.Peeking;
        watcher.spot = spot;
        watcher.bold = bold;
        watcher.side = left ? -1 : 1;
        watcher.timer = 0;
        watcher.stared = 0;
        watcher.lean = 0;
        watcher.blink = 0.16;
        watcher.seen += 1;
        return;
    }
    watcher.timer += time.dt;
    if (watcher.state == Watching.Lunging)
    {
        watcher.at = Math.Lerp(watcher.at, victimAt + LookDirection(victimYaw, 0) * 0.85, Math.Saturate(watcher.timer / 0.12));
        var back = victimAt - watcher.at;
        watcher.yaw = Math.Atan2(back.x, back.z);
        if (watcher.timer < 0.75) return;
        watcher.state = Watching.Away;
        watcher.blink = 0.2;
        watcher.lean = 0;
        watcher.wait = 150 + Random.NextInt(240);
        return;
    }
    // It keeps its pillar between itself and whoever is nearest, and leans out of one side of it
    mut var toward = nearestAt.xz - middle.xz;
    toward = nearest > 0.01 ? toward / nearest : float2(0, 1);
    var hidden = middle.xz - toward * 0.8;
    var out = float2(toward.y, -toward.x) * (watcher.side * 0.6 * watcher.lean);
    watcher.at = float3(hidden.x + out.x, 0, hidden.y + out.y);
    watcher.yaw = Math.Atan2(toward.x, toward.y);
    if (watcher.state == Watching.Hiding)
    {
        watcher.lean -= time.dt * 3.2;
        if (watcher.lean > 0) return;
        watcher.lean = 0;
        watcher.state = Watching.Away;
        watcher.wait = 150 + Random.NextInt(240);
        return;
    }
    watcher.lean = Math.Min(1, watcher.lean + time.dt * 1.6);
    if (looked) watcher.stared += time.dt;
    if (watcher.bold && nearest < 2.7)
    {
        watcher.state = Watching.Lunging;
        watcher.victim = nearestId;
        watcher.timer = 0;
        return;
    }
    if (watcher.timer > 25 || watcher.stared > 2.2 || (!watcher.bold && nearest < 5)) watcher.state = Watching.Hiding;
}
