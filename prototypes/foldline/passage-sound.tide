asset Clip metalFoot = "art/sfx/metal_step.wav";
asset Clip silkPluck = "art/sfx/silk.wav";

local singleton PassageEars
{
    int chamber = -1;
    float3[2] at;
    float[2] distance;
    int web = -1;
}

[After(Sounds)]
view HearPassages(query (Operator body) operators, query (Beast beast, CrawlHunt hunt) spiders,
                  Arena arena, Place place, Interface ui, mut PassageEars ears)
{
    bool fresh = ears.chamber != arena.chamber;
    if (fresh) ears.web = -1;
    foreach (var row in operators)
    {
        var body = row.body;
        float distance = fresh ? 0.0 : Math.Distance(body.position, ears.at[body.id]);
        ears.at[body.id] = body.position;
        if (fresh) ears.distance[body.id] = 0;
        if (distance < 2) ears.distance[body.id] += distance;
        if (ears.distance[body.id] < .8 || !body.grounded) continue;
        ears.distance[body.id] = 0;
        if (place.id == ARCHIVE && ArchiveMetal(body.position)) Audio.Play(metalFoot, body.position, ui.open ? .1 : .5);
    }
    if (place.id == CRAWLSPACE)
    {
        foreach (var row in spiders)
        {
            if (row.beast.chamber != arena.chamber) continue;
            if (!fresh && ears.web != row.hunt.goal && row.hunt.goal >= 3)
                Audio.Play(silkPluck, WebNode(row.hunt.goal), ui.open ? .15 : .65);
            ears.web = row.hunt.goal;
        }
    }
    ears.chamber = arena.chamber;
}
