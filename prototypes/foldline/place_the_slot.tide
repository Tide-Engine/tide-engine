using Box3D;

// A dropped bolt plucks a web. The next place lets players do it themselves.
void BuildTheSlot(Arena arena, mut Place place)
{
    BuildMapTheSlot(arena, place);
    place.dead = true;
    place.light = .2;
    place.grade = float3(.8, .91, 1);
    Fill(arena, -4, 4, -1, 0, 2.1, 10, CONCRETE);
    Fill(arena, -5, -4, -2, 2.5, 1.6, 11, PLASTER);
    Fill(arena, 4, 5, -2, 2.5, 1.6, 11, PLASTER);
    // Up to the lift's ceiling between its shell and the grille, and a slab that fills to it beyond: no gap over
    // the low room or beside the bars.
    Fill(arena, -5, -4, 2.5, 4.4, 1.6, 4.1, PLASTER);
    Fill(arena, 4, 5, 2.5, 4.4, 1.6, 4.1, PLASTER);
    Fill(arena, -5, 5, -2, 2.5, 10, 11, CONCRETE);
    Fill(arena, -5, 5, 2.5, 4.4, 4.1, 11, PLASTER, false, 2);
    Fill(arena, -5, 5, 4.4, 5.4, 1.6, 4.1, CEILING_TILE, false, 2);
    Fill(arena, -4, 4, 0, 4.4, 3.9, 4.1, PANELS, false, 4);
    // Silk strung wall to wall across the low room, where the bolt will fall
    SetProp(arena, PropKind.Web, float3(0, 0, 7), EAST, float3(1, 1, 4.04));
    // In the dark far corner, nothing of it but its eyes until the bolt drops
    SpawnBeast(arena, BeastKind.Spider, float3(3, 0, 9.4), WEST, .8, clip: "Idle", eyes: true);
    // The pipe the bolt hangs under, wall to wall below the slab, and another along the west wall
    SetProp(arena, PropKind.Pipe, float3(0, 2.38, 7), EAST, float3(1, 1, 4));
    SetProp(arena, PropKind.Pipe, float3(-3.895, 1.4, 7.05), NORTH, float3(1, 1, 2.95));
    LampGrid(place, float2(-4, 4.1), float2(8, 2.95), 1, 2);
    HangLamp(place, 0, 0, 2.5, LampState.Stutter);
    HangLamp(place, 0, 1, 2.5, LampState.Dead);
    MenuView(place, float3(0, 1.7, -.8), .04, NORTH);
}

[After(MoveMovers)]
[Before(PhysicsStages.Step)]
system SlotBolt(mut Mover mover, mut Body body, Arena arena, Place place, Time time)
{
    if (place.id != THE_SLOT || mover.chamber != arena.chamber) return;
    float fallen = Math.Max(arena.arrive - 2.5, 0);
    // Hung under the pipe, then down on the floor through the silk
    float high = Math.Max(.075, 2.23 - 9.8 * fallen * fallen * .5);
    float3 at = float3(0, high, 7);
    mover.velocity = (at - mover.at) / time.dt;
    mover.at = at;
    body.position = at;
    body.velocity = float3(0);
}

// It wraps what fell on its silk, and then something else plucks a strand: it's at the bars, at their feet.
system SlotSpider(mut Beast beast, Arena arena, Place place, Time time)
{
    if (place.id != THE_SLOT || beast.chamber != arena.chamber) return;
    if (arena.arrive < 3.16)
    {
        beast.time += time.dt;
        return;
    }
    bool charging = arena.arrive > 7;
    float3 target = charging ? float3(.4, 0, 4.75) : float3(0, 0, 7.4);
    float gap = Math.Distance(beast.at, target);
    string clip = gap > .03 ? "Walk" : "Attack";
    if (beast.clip != clip)
    {
        beast.clip = clip;
        beast.time = 0;
    }
    if (gap > .03)
    {
        float3 way = (target - beast.at) / gap;
        beast.yaw = Math.Atan2(way.x, way.z);
        beast.at += way * Math.Min(gap, (charging ? 7.0 : 3.0) * time.dt);
    }
    else beast.yaw = charging ? SOUTH : beast.yaw;
    beast.time += time.dt;
}
