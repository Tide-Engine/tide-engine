// Reuse the game's generated clips at creature-specific rates. Place-authored
// beasts get presence, moving feet and an attack cue without changing Sounds.
local singleton BeastEars
{
    Sound voice0;
    Sound voice1;
    Sound voice2;
    Sound voice3;
    Sound voice4;
    Sound voice5;
    Sound voice6;
    Sound voice7;
    Entity[8] entities;
    float3[8] at;
    float[8] walked;
    List<string> clips;
    float[8] times;
    int chamber = -1;
    int step;
}

Sound BeastVoice(BeastEars ears, int slot)
{
    if (slot == 0) return ears.voice0;
    if (slot == 1) return ears.voice1;
    if (slot == 2) return ears.voice2;
    if (slot == 3) return ears.voice3;
    if (slot == 4) return ears.voice4;
    if (slot == 5) return ears.voice5;
    if (slot == 6) return ears.voice6;
    return ears.voice7;
}

void SetBeastVoice(mut BeastEars ears, int slot, Sound sound)
{
    if (slot == 0) ears.voice0 = sound;
    else if (slot == 1) ears.voice1 = sound;
    else if (slot == 2) ears.voice2 = sound;
    else if (slot == 3) ears.voice3 = sound;
    else if (slot == 4) ears.voice4 = sound;
    else if (slot == 5) ears.voice5 = sound;
    else if (slot == 6) ears.voice6 = sound;
    else ears.voice7 = sound;
}

Clip BeastPresence(BeastKind kind)
{
    if (kind == BeastKind.Crawler) return stalking;
    if (kind == BeastKind.Spider) return drumRun;
    if (kind == BeastKind.Figure) return gateRun;
    if (kind == BeastKind.Drowned) return pitTurning;
    return redUnder;
}

[After(Sounds)]
view HearBeasts(Operator viewer, query (Beast beast) beasts, Arena arena, Control control, Interface ui, mut BeastEars ears)
{
    if (viewer.id != control.active) return;
    while (ears.clips.count < 8) ears.clips.Add("");
    bool fresh = ears.chamber != arena.chamber;
    mut int count = 0;
    foreach (var row in beasts)
    {
        var beast = row.beast;
        if (beast.chamber != arena.chamber || count >= 8 || !beast.visible) continue;
        bool same = !fresh && ears.entities[count] == row.entity;
        float moved = same ? Math.Distance(beast.at, ears.at[count]) : 0;
        bool moving = moved > 0.001;
        // A static pale mannequin stays silent; the shadow's timber creaks.
        bool audible = beast.kind != BeastKind.Figure || beast.skin == BeastSkin.Shadow || beast.skin == BeastSkin.Dark || moving;
        float quiet = ui.open ? 0.35 : 1.0;
        mut var voice = BeastVoice(ears, count);
        LoopingAt(voice, BeastPresence(beast.kind), beast.at + float3(0, 0.5 * beast.scale, 0),
                  quiet * (beast.kind == BeastKind.Flayed ? 0.12 : moving ? 0.22 : 0.07), audible);
        voice.pitch = beast.kind == BeastKind.Crawler ? 1.8 : beast.kind == BeastKind.Spider ? 1.65 : beast.kind == BeastKind.Figure ? 0.45 : beast.kind == BeastKind.Drowned ? 0.65 : 0.8;
        SetBeastVoice(ears, count, voice);
        if (same)
        {
            ears.walked[count] += moved;
            if (moving && beast.kind == BeastKind.Flayed && ears.walked[count] > 0.9 * beast.scale)
            {
                ears.walked[count] = 0;
                if (steps.count > 0) Audio.Play(steps[ears.step % steps.count], beast.at, 0.25 * quiet, 0.68);
                ears.step += 1;
            }
            bool attack = beast.clip == "Lunge" || beast.clip == "Attack" || beast.clip == "Bite" || beast.clip == "Punch";
            if (attack && (ears.clips[count] != beast.clip || beast.time + 0.05 < ears.times[count]))
                Audio.Play(handsGrab, beast.at, 0.5 * quiet, beast.kind == BeastKind.Spider ? 1.7 : 0.7);
        }
        else ears.walked[count] = 0;
        ears.entities[count] = row.entity;
        ears.at[count] = beast.at;
        ears.clips[count] = beast.clip;
        ears.times[count] = beast.time;
        count += 1;
    }
    for (int slot = count; slot < 8; slot++)
    {
        mut var voice = BeastVoice(ears, slot);
        voice.playing = false;
        SetBeastVoice(ears, slot, voice);
        ears.entities[slot] = default;
    }
    ears.chamber = arena.chamber;
}
