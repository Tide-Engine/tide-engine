// FOLDLINE's local interface. Menus never pause the shared match.
// It's drawn as an old console's was: square, in a few flat colors, each
// letter with a hard shadow, and a list to choose from in place of buttons.
local singleton Interface
{
    bool open = true;
    bool looking;
    bool introduced;
    bool stops;
    string code;
    string message;
    FoldShot shot0;      // Read-only placement previews for the current operator's two buttons.
    FoldShot shot1;
}

const Color UI_INK = Color(0.87, 0.83, 0.70);
const Color UI_MUTED = Color(0.52, 0.48, 0.39);
const Color UI_DARK = Color(0.02, 0.018, 0.014, 0.93);
const Color UI_SHADOW = Color(0, 0, 0, 0.85);
const Color UI_RED = Color(0.74, 0.07, 0.05);
const Color UI_CYAN = Color(0.21, 0.87, 0.89);
const Color UI_AMBER = Color(1, 0.65, 0.28);
const Color UI_ROSE = Color(1, 0.3, 0.55);
const Color UI_VIOLET = Color(0.62, 0.4, 1);

// One of the picture's big pixels, in the window's: what every edge and shadow here is a multiple of.
float Dot()
{
    return Math.Max(2, Math.Round(Screen.height / 360));
}

// Letters, with their shadow a pixel down and across.
void Ink(string text, float2 at, float size, Color tint, Anchor anchor)
{
    Draw.Text(text, at + float2(Dot(), Dot()), size, UI_SHADOW, anchor, Font.Bold);
    Draw.Text(text, at, size, tint, anchor, Font.Bold);
}

// A flat dark slab with a hard edge along its top and left.
void Slab(Rect rect)
{
    var middle = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
    Draw.Rect(middle, float2(rect.width, rect.height), Color(0.02, 0.018, 0.014, 0.78));
    Draw.Rect(float2(middle.x, rect.y + Dot() * 0.5), float2(rect.width, Dot()), Color(0.87, 0.83, 0.70, 0.28));
    Draw.Rect(float2(rect.x + Dot() * 0.5, middle.y), float2(Dot(), rect.height), Color(0.87, 0.83, 0.70, 0.28));
}

// A line of a list: plain letters, and a red mark before the one that's pointed at.
bool InterfaceChoice(Rect rect, string label, float size)
{
    var button = GUI.Control(rect);
    var hot = button.hovered || button.focused;
    var middle = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5);
    if (hot)
    {
        Draw.Rect(middle, float2(rect.width, rect.height), Color(0.74, 0.07, 0.05, 0.22));
        Draw.Rect(float2(rect.x + Dot() * 2, middle.y), float2(Dot() * 4, rect.height), UI_RED);
    }
    Ink(label, float2(rect.x + (hot ? 26 : 16), middle.y), size, hot ? Color(1, 0.96, 0.84) : UI_INK, Anchor.MiddleLeft);
    if (button.clicked) Audio.Play(menuAccept, 0.6);
    return button.clicked;
}

[Before(Render)]
view InterfaceInput(Devices devices, Session session, Arena arena, mut Control control, mut Interface ui)
{
    if (arena.joined > 1) control.active = session.player == arena.second ? 1 : 0;
    else if (!ui.open && devices.keyboard.tab.down) control.active = 1 - control.active;
    if (devices.keyboard.escape.down || (ui.looking && !Cursor.locked)) ui.open = true;
    ui.looking = Cursor.locked;
    control.started = !ui.open;
    if (control.started) Cursor.Lock();
}

[After(Render)]
view InterfaceMenu(Session session, mut Interface ui, mut Control control)
{
    if (!ui.open && session.state == SessionState.Connected) return;
    Draw.SetScreen();
    GUI.Navigate();
    var compact = Screen.height < 700;
    var pad = Math.Clamp(Screen.width * 0.045, 22, 58);
    var width = Math.Min(450, Screen.width - pad * 2);
    var headingY = compact ? 26.0 : 94.0;
    // The dark it's read against: all of the left, thinning to nothing across the picture
    Draw.Rect(float2((width + pad * 2) * 0.5, Screen.height * 0.5), float2(width + pad * 2, Screen.height), UI_DARK);
    for (var band = 0; band < 6; band++)
        Draw.Rect(float2(width + pad * 2 + band * 28 + 14, Screen.height * 0.5), float2(28, Screen.height), Color(0.02, 0.018, 0.014, 0.8 - band * 0.14));
    Ink("SUBLEVEL 4   /   TWO OPERATORS", float2(pad, headingY - 22), 11, UI_MUTED, Anchor.UpperLeft);
    var title = Math.Min(compact ? 56 : 74, width / 5.1);
    Draw.Text("FOLDLINE", float2(pad - 3 + Dot() * 2, headingY + Dot() * 2), title, UI_RED, Anchor.UpperLeft, Font.Bold);
    Draw.Text("FOLDLINE", float2(pad - 3, headingY), title, UI_INK, Anchor.UpperLeft, Font.Bold);
    var ruleY = headingY + (compact ? 72 : 100);
    Draw.Rect(float2(pad + 74, ruleY), float2(148, Dot() * 2), UI_RED);
    Ink("Nobody has left by the way they came in.", float2(pad, headingY + (compact ? 87 : 122)), Math.Min(19, width / 20), UI_INK, Anchor.UpperLeft);
    if (!compact) Draw.Text("A first-person puzzle for two.\nFold the rooms together. Mind the floor.", float2(pad, headingY + 157), 16, UI_MUTED);
    var top = headingY + (compact ? 126 : 239);
    if (ui.stops && session.state == SessionState.Connected)
    {
        if (InterfaceChoice(Rect(pad, top, width, 36), "BACK", 17)) ui.stops = false;
        var slotWidth = (width - 12) * .5;
        for (int stop = 0; stop < DESCENT; stop++)
        {
            int id = PlaceAt(stop);
            if (InterfaceChoice(Rect(pad + (stop % 2) * (slotWidth + 12), top + 46 + (stop / 2) * 36, slotWidth, 32), PlaceLabel(id), 12))
            {
                Send(SelectPlace { id = id });
                ui.stops = false;
                ui.open = false;
                ui.introduced = true;
                control.started = true;
                Cursor.Lock();
            }
        }
        return;
    }
    if (InterfaceChoice(Rect(pad, top, width, 46), ui.introduced ? "GO BACK DOWN" : "GO DOWN", 22))
    {
        if (session.state == SessionState.Offline) Session.Start();
        ui.open = false;
        ui.introduced = true;
        control.started = true;
        Cursor.Lock();
    }
    if (InterfaceChoice(Rect(pad, top + 52, width, 40), session.open ? "COPY THE ROOM'S CODE" : "BRING SOMEONE", 18))
    {
        if (session.open) Clipboard.Copy(session.room);
        else
        {
            if (session.state == SessionState.Offline) Session.Start();
            Session.Open();
            ui.message = "The room is open. Give its code to whoever is coming.";
        }
    }
    GUI.SetTheme(GUITheme { text = UI_INK, field = Color(0.07, 0.06, 0.05), fieldHot = Color(0.14, 0.11, 0.09), accent = UI_RED, radius = 0 });
    GUI.TextField(Rect(pad + 16, top + 104, width - 132, 38), "Room", ui.code, out var entered);
    var join = InterfaceChoice(Rect(pad + width - 108, top + 104, 108, 38), "JOIN", 18);
    if ((join || entered) && ui.code != "")
    {
        Session.Join(ui.code);
        ui.message = "Going to them...";
        ui.introduced = true;
    }
    if (session.room != "") Ink($"ROOM  {session.room}", float2(pad + 16, top + 158), 17, UI_AMBER, Anchor.UpperLeft);
    else if (session.state == SessionState.Connecting) Ink("CONNECTING...", float2(pad + 16, top + 158), 15, UI_INK, Anchor.UpperLeft);
    else Draw.Text(ui.message, float2(pad + 16, top + 158), 14, UI_MUTED);
    mut var keysY = top + 196;
    if (session.state == SessionState.Connected)
    {
        if (InterfaceChoice(Rect(pad, top + 192, width, 32), "CHOOSE A STOP", 14)) ui.stops = true;
        keysY = top + 232;
    }
    // The controls, in three columns
    Ink("CONTROLS", float2(pad + 16, keysY), 11, UI_MUTED, Anchor.UpperLeft);
    var column = (width - 32) / 3;
    MenuKey(float2(pad + 16, keysY + 16), "WASD", "MOVE");
    MenuKey(float2(pad + 16 + column, keysY + 16), "SPACE", "JUMP");
    MenuKey(float2(pad + 16 + column * 2, keysY + 16), "LMB RMB", "FOLD");
    MenuKey(float2(pad + 16, keysY + 30), "E", "CARRY");
    MenuKey(float2(pad + 16 + column, keysY + 30), "F", "THROW");
    MenuKey(float2(pad + 16 + column * 2, keysY + 30), "Q", "PING");
    MenuKey(float2(pad + 16, keysY + 44), "TAB", "SWITCH");
    MenuKey(float2(pad + 16 + column, keysY + 44), "R", "RESTART");
    MenuKey(float2(pad + 16 + column * 2, keysY + 44), "ESC", "MENU");
    Draw.Text("AIM: BRACKETS = CLEAR SHOT / SOLID SQUARES = PLACED", float2(pad + 16, keysY + 62), 10, UI_MUTED);
    var foot = Math.Max(keysY + 84, Screen.height - 82);
    Ink("ALONE", float2(pad, foot), 11, UI_RED, Anchor.UpperLeft);
    Draw.Text("Tab is your other body.\nIt stays where you leave it.", float2(pad, foot + 20), 14, UI_MUTED);
    // ...and what this is, where there's room for it under all that
    if (foot + 58 < Screen.height - 22) Draw.Text("PROTOTYPE 01   /   TIDE", float2(pad, Screen.height - 22), 10, Color(0.36, 0.33, 0.27));
}

// A key and what it does, for the menu's list of controls.
void MenuKey(float2 at, string key, string label)
{
    Ink(key, at, 10, UI_INK, Anchor.UpperLeft);
    Draw.Text(label, at + float2(58, 0), 11, UI_MUTED);
}

local event(Connected connected) EnterConnectedRoom(mut Interface ui)
{
    if (ui.introduced)
    {
        ui.open = false;
        ui.message = "";
    }
}

local event(Disconnected gone) ConnectionEnded(mut Interface ui)
{
    ui.open = true;
    ui.looking = false;
    ui.message = $"Connection ended: {gone.reason}.";
}

// Each button has two independent marks: brackets for a clear shot now, and
// a square below for an end already placed. Neither state hides the other.
void ReticleEnd(float2 middle, float dot, float side, Color tint, bool ready, bool placed)
{
    var at = middle + float2(side * dot * 5, 0);
    var ink = ready ? tint : Color(tint.r * .4, tint.g * .4, tint.b * .4);
    var height = ready ? dot * 5 : dot * 2;
    Draw.Rect(at + float2(dot, dot), float2(dot, height), UI_SHADOW);
    Draw.Rect(at, float2(dot, height), ink);
    if (ready)
    {
        for (int cap = -1; cap <= 1; cap += 2)
        {
            var tip = at + float2(-side * dot, cap * dot * 2);
            Draw.Rect(tip + float2(dot, dot), float2(dot * 3, dot), UI_SHADOW);
            Draw.Rect(tip, float2(dot * 3, dot), tint);
        }
    }
    var pip = middle + float2(side * dot * 5, dot * 6);
    Draw.Rect(pip, float2(dot * 4, dot * 4), UI_SHADOW);
    Draw.Rect(pip, float2(dot * 3, dot * 3), tint);
    if (!placed) Draw.Rect(pip, float2(dot, dot), UI_DARK);
}

[After(Render)]
view InterfaceHud(Operator seenViewer, query (FoldFrame frame) frames, Control control, mut Interface ui, Session session,
                  Arena arena, Place place, Fold fold, Box3D.Physics physics, World world)
{
    if (seenViewer.id != control.active) return;
    ui.shot0 = default;
    ui.shot1 = default;
    if (ui.open) return;
    // Use the same eye, frame snapping, clearance and per-end overlap checks
    // as a real shot. Carrying turns both buttons into a throw instead.
    if (!place.dead && seenViewer.taken <= 0 && seenViewer.chamber == arena.chamber && fold.holding[control.active] == 0)
    {
        mut Mount[16] mounts = default;
        mut int count = 0;
        foreach (var row in frames)
        {
            if (row.frame.chamber != arena.chamber || count >= 16) continue;
            mounts[count] = Mount { at = row.frame.at, face = row.frame.face, size = row.frame.size };
            count += 1;
        }
        var eye = seenViewer.position + float3(0, EYE_HIGH * seenViewer.scale, 0);
        var way = LookDirection(seenViewer.yaw, seenViewer.pitch);
        ui.shot0 = PreviewFold(fold, control.active * 2, eye, way, mounts, count, physics, world);
        ui.shot1 = PreviewFold(fold, control.active * 2 + 1, eye, way, mounts, count, physics, world);
    }
    Draw.SetScreen();
    var pad = Math.Clamp(Screen.width * 0.025, 18, 34);
    var middle = float2(Screen.width * 0.5, Screen.height * 0.5);
    var dot = Dot();

    // Whose eyes these are, and the room others join.
    var mark = control.active == 0 ? UI_AMBER : UI_ROSE;
    Draw.Rect(float2(Screen.width - pad - dot * 2 + dot, 30 + dot), float2(dot * 4, dot * 4), UI_SHADOW);
    Draw.Rect(float2(Screen.width - pad - dot * 2, 30), float2(dot * 4, dot * 4), mark);
    Ink(control.active == 0 ? "OPERATOR A" : "OPERATOR B", float2(Screen.width - pad - dot * 4 - 8, 30), 11, UI_INK, Anchor.MiddleRight);
    if (session.room != "") Ink($"WITH  {session.room}", float2(Screen.width - pad, 52), 10, UI_MUTED, Anchor.MiddleRight);

    // The reticle's left/right sides match the two placement buttons. Where the device is dead there's nothing to
    // place, and nothing over what's out there in the dark but a point to look by.
    Draw.Rect(middle, float2(dot, dot), UI_INK);
    if (place.dead) return;
    ReticleEnd(middle, dot, -1, control.active == 0 ? UI_AMBER : UI_ROSE, ui.shot0.valid, fold.ends[control.active * 2].open);
    ReticleEnd(middle, dot, 1, control.active == 0 ? UI_CYAN : UI_VIOLET, ui.shot1.valid, fold.ends[control.active * 2 + 1].open);
    Draw.Rect(middle - float2(0, dot * 4), float2(dot, dot * 2), Color(0.87, 0.83, 0.70, 0.6));
    Draw.Rect(middle + float2(0, dot * 4), float2(dot, dot * 2), Color(0.87, 0.83, 0.70, 0.6));
}
