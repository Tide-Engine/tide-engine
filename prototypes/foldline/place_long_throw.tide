// An upper operator lays the launch route; the flyer brings its cargo across
// the void. The plate that raises the deck also opens the shutter over the
// launch wall, so whoever holds it open for the flyer can't follow: the flyer
// makes a way back round the landing's corner to a wall by the near floor.
void BuildLongThrow(mut Arena arena, mut Place place, mut Fold fold)
{
    BuildMapLongThrow(arena, place);
    Fill(arena, -12, -6, -1, 0, -12, 2, PANELS);
    Fill(arena, -6, 2, -1, 0, -12, -6, PANELS);
    Fill(arena, -13, 17, 18, 19, -13, 17, CONCRETE, false, 2);
    // The room boundary steps around each entire cab, including its metre
    // thick sides. Keeping the old inner-wall strip drew the same face twice.
    Fill(arena, -13, -12, -3, 0, -13, 17, PANELS);
    Fill(arena, -13, -12, 0, 4.4, -11.46, -6.4, PANELS);
    // The near floor's paper, seen from the landing and from nowhere far: the stranded one's way over.
    Fill(arena, -13, -12, 0, 4.4, -6.4, -2.6, WALLPAPER, true);
    Fill(arena, -13, -12, 0, 4.4, -2.6, 17, PANELS);
    Fill(arena, -13, -12, 4.4, 18, -13, 17, PANELS);
    Fill(arena, 16, 17, -3, 5.4, -13, 17, PANELS);
    Fill(arena, 16, 17, 5.4, 9.8, -13, 15.46, PANELS);
    Fill(arena, 16, 17, 9.8, 18, -13, 17, PANELS);
    Fill(arena, -5, 3, -3, 8, -13, -12, PANELS);
    Fill(arena, -12, -5, 4.4, 18, -13, -12, PANELS);
    Fill(arena, 3, 16, -3, 18, -13, -12, PANELS);
    Fill(arena, -5, -2.2, 8, 18, -13, -12, PANELS);
    Fill(arena, 2.2, 3, 8, 18, -13, -12, PANELS);
    Fill(arena, -2.2, 2.2, 12.6, 18, -13.2, -12, PANELS);
    Fill(arena, -13, 9, -3, 18, 16, 17, PANELS);
    Fill(arena, 9, 16, -3, 4.4, 16, 17, PANELS);
    Fill(arena, 9, 16, 9.8, 18, 16, 17, PANELS);
    // The blood is the existing death drop, below the flight rather than a
    // puzzle-specific kill plane. Separate rectangles leave all real floors.
    DigBloodPit(arena, -6, 6, -6, 16);
    DigBloodPit(arena, -12, -6, 2, 16);
    DigBloodPit(arena, 6, 16, -6, 2);
    DigBloodPit(arena, 6, 12, 10, 16);
    DigBloodPit(arena, 2, 16, -12, -6);
    DigBloodPit(arena, 6, 16, 2, 10);
    DigBloodPit(arena, 12, 16, 10, 16);
    Fill(arena, 0, 16, 4.4, 5.4, 2, 10, PANELS);
    Fill(arena, 12, 16, 4.4, 5.4, 10, 16, PANELS);
    // A full-width apron joins the six-metre lift rather than leaving its
    // western two metres over the blood beneath the narrower return corridor.
    Fill(arena, 10, 12, 4.4, 5.4, 13.9, 16, PANELS);
    Fill(arena, 6, 12, 5.4, 12, 9, 9.6, CONCRETE);
    Fill(arena, 14, 16, -3, 12, 1.5, 2, CONCRETE);
    // Return panel faces into the L corridor, its back invisible from the
    // launch and upper cage. Keeping it off z16 leaves the exit gate clear.
    Fill(arena, 11.2, 12, 5.4, 9.8, 12, 13.75, WALLPAPER, true);
    Fill(arena, 10.8, 11.2, 5.4, 10.2, 11.8, 13.9, CONCRETE);
    Fill(arena, 11.2, 12.02, 5.4, 10.2, 11.6, 12, CONCRETE);
    Fill(arena, 11.2, 12.02, 5.4, 10.2, 13.75, 13.9, CONCRETE);
    // ...and stands on a pier down into the pit, not on the air.
    Fill(arena, 10.8, 12, -3, 5.4, 11.6, 13.9, CONCRETE);
    // The real pad's angle and its short run to the source are tested with a
    // carried cube. There is no demonstration-only extra fold or teleport.
    Fill(arena, -11.5, -8.5, 0, 4.4, 0, .8, WALLPAPER, true);
    Fill(arena, -11.8, -11.5, 0, 4.4, 0, .8, CONCRETE);
    Fill(arena, -8.5, -8.2, 0, 4.4, 0, .8, CONCRETE);
    Fill(arena, -11.8, -8.2, 0, 4.4, .8, 1.2, CONCRETE);
    SetPad(arena, float3(-10, 0, -.7), float3(0, 7, 14));
    // The receiving wall is one fold tall: wherever on it the cage shoots, the flight is the same.
    Fill(arena, -6.8, -6, 8, 10.65, 4, 8, WALLPAPER, true);
    Fill(arena, -6.8, -6, 10.65, 12.4, 4, 8, CONCRETE);
    Fill(arena, -8, -6.8, -2, 18, 3.8, 8.2, CONCRETE);
    Fill(arena, -6.8, -6, -2, 8, 4, 8, CONCRETE);
    Fill(arena, -6.8, -6, 12.4, 18, 4, 8, CONCRETE);
    Fill(arena, -6.85, -5.98, 7.8, 12.6, 3.6, 4, CONCRETE);
    Fill(arena, -6.85, -5.98, 7.8, 12.6, 8, 8.4, CONCRETE);
    // Optical wall: lower eyes cannot see the high receiving face. The upper
    // cage looks over it and round the west edge toward the source panel.
    Fill(arena, -6, 3, -2, 8.5, -.3, 0, CONCRETE);
    // Fixed upper cage floor around the freight-deck hole, not over it.
    Fill(arena, -2, 2, 7.2, 8, -12, -10.5, PANELS);
    Fill(arena, -2, 2, 7.2, 8, -7.5, 0, PANELS);
    Fill(arena, -2, -1.5, 7.2, 8, -10.5, -7.5, PANELS);
    Fill(arena, 1.5, 2, 7.2, 8, -10.5, -7.5, PANELS);
    Fill(arena, -2.2, -2, 8, 12.4, -12, 0, RUST, false, 4);
    Fill(arena, 2, 2.2, 8, 12.4, -12, 0, RUST, false, 4);
    Fill(arena, -2, 2, 8.5, 12.4, 0, .2, RUST, false, 4);
    Fill(arena, -2, 2, 8, 12.4, -12.8, -12, CONCRETE);
    Fill(arena, -2.2, 2.2, 7.8, 12.6, -13.2, -12.8, CONCRETE);
    Fill(arena, -2.2, 2.2, 12.4, 12.6, -12, .2, CONCRETE, false, 2);
    PutLoose(arena, fold, float3(-9.5, .4, -7));
    // Lamps 1 m in from the walls on a 4 m grid: under the shaft's roof, over the near floor, in the cage's roof.
    LampGrid(place, float2(-13, -12), float2(4, 4), 7, 7);
    OfficeLamps(place, 0, 6, 0, 6, 18, 71);
    OfficeLamps(place, 0, 1, 0, 3, 4.4, 72, dead: 5);
    OfficeLamps(place, 3, 3, 0, 2, 12.4, 73, dead: 5);
    OfficeLamps(place, 5, 6, 4, 6, 12, 74, dead: 5);
    place.light = .76;
    place.fog = .018;
    place.grade = float3(.88, .95, 1.03);
    MenuView(place, float3(10, 12, -4), .18, -.95);
}
