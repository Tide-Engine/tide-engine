// The landing: where a lift stops on its way down. Its door opens on a short
// hall with a shut door at its end and two lamps, the far one of which dies
// while they look; then the door shuts and the lift goes on. It's here to show
// that a lift can stop, until the way down has stops of its own.
void BuildLanding(Arena arena, mut Place place)
{
    StoppingLift(arena, place, float3(0, 0, 0), EAST, 4);
    place.dead = true;
    // The hall, beyond the doorway at x 2.1
    Fill(arena, 2.6, 9, -1, 0, -4, 4, CONCRETE);
    Fill(arena, 1.6, 2.6, -3, 4.4, -5, -3, PANELS);
    Fill(arena, 1.6, 2.6, -3, 4.4, 3, 5, PANELS);
    Fill(arena, 2.6, 9, -3, 4.4, -5, -4, PANELS);
    Fill(arena, 2.6, 9, -3, 4.4, 4, 5, PANELS);
    Fill(arena, 9, 10, -3, 4.4, -5, 5, PANELS);
    Fill(arena, 1.6, 10, 4.4, 5.4, -5, 5, CEILING_TILE, false, 2);
    Raise(arena, float3(8.97, 1.05, 0), float3(0.06, 2.1, 0.95), DOORS, false, 3);
    LampGrid(place, float2(2.6, -4), float2(3.2, 8), 2, 1);
    HangLamp(place, 0, 0, 4.4);
    HangLamp(place, 1, 0, 4.4, LampState.Stutter, 1);
    MenuView(place, float3(-1.5, 1.7, 0), 0.02, EAST);
}

// Halfway through the stop, the far lamp dies.
system DarkenLanding(mut Arena arena, Place place)
{
    if (place.id == LANDING && arena.arrive > place.stay * 0.5) arena.darkGroups |= 1 << 1;
}
