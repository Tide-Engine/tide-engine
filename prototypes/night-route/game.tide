settings { title = "NIGHT ROUTE"; appId = "dev.tideengine.nightroute"; tickRate = 60; maxPlayers = 1; }

const int STREETS = 20;
const float SHIFT_SECONDS = 180;
const float ROAD_RADIUS = 0.82;

// Match coordinates count north as +y. All art and light footprints derive
// from this same graph; collision and Echo never depend on painted pixels.
float2 Junction(int node)
{
    return float2(-15 + (node % 4) * 10, 9 - (node / 4) * 9);
}
int StreetA(int edge)
{
    if (edge < 9) return edge / 3 * 4 + edge % 3;
    if (edge < 17) return edge - 9;
    return edge == 17 ? 1 : edge == 18 ? 5 : 6;
}
int StreetB(int edge)
{
    if (edge < 9) return StreetA(edge) + 1;
    if (edge < 17) return StreetA(edge) + 4;
    return edge == 17 ? 6 : edge == 18 ? 10 : 11;
}
bool Alley(int edge) { return edge >= 17 || edge == 4; }
float2 OnStreet(int edge, float fraction)
{
    return Math.Lerp(Junction(StreetA(edge)), Junction(StreetB(edge)), fraction);
}
float StreetDistance(float2 point, int edge)
{
    var a = Junction(StreetA(edge));
    var line = Junction(StreetB(edge)) - a;
    var along = Math.Clamp(Math.Dot(point - a, line) / Math.Dot(line, line), 0, 1);
    return Math.Length(point - (a + line * along));
}
bool Walkable(float2 point)
{
    for (var edge = 0; edge < STREETS; edge++)
        if (StreetDistance(point, edge) <= ROAD_RADIUS) return true;
    return false;
}
// Lamps overlap along High Street and the west/east approaches. The river
// road has isolated lamps: its shortcuts require spending Mothbox's strain.
int LampCount(int edge) { return Alley(edge) ? 0 : edge >= 6 && edge <= 8 ? 1 : 3; }
float2 Lamp(int edge, int index)
{
    return OnStreet(edge, LampCount(edge) == 1 ? 0.5 : (index + 0.5) / 3);
}
bool InLight(float2 point)
{
    if (Math.Length(point - Junction(8)) < 2.4) return true;
    for (var edge = 0; edge < STREETS; edge++)
        for (var index = 0; index < LampCount(edge); index++)
            if (Math.Length(point - Lamp(edge, index)) <= 2.65) return true;
    return false;
}
int AddressNode(int address) { return address == 0 ? 0 : address == 1 ? 3 : address == 2 ? 7 : 10; }
string AddressName(int address) { return address == 0 ? "01  CHAPEL" : address == 1 ? "02  BATH HOUSE" : address == 2 ? "03  JUNIPER" : "04  LATE DINER"; }
string ParcelName(int kind) { return kind == 0 ? "MOTHBOX" : kind == 1 ? "RESTLESS" : kind == 2 ? "NORTHBOUND" : "ECHO"; }
string ParcelRule(int kind) { return kind == 0 ? "Stay in lamplight" : kind == 1 ? "Keep moving" : kind == 2 ? "Face north" : "Don't revisit streets"; }
int BitCount(int mask)
{
    mut var count = 0;
    for (var kind = 0; kind < 4; kind++) if ((mask & (1 << kind)) != 0) count++;
    return count;
}

struct Parcel
{
    int destination;
    int value;
    float strain;
    bool carried;
    bool spoiled;
    bool delivered;
    bool breaking;
}
singleton Night
{
    PlayerID player;
    int seed = 1;
    int serial;
    int phase; // 0: depot manifest, 1: on the street, 2: debrief
    bool started;
    float left = SHIFT_SECONDS;
    float2 position = float2(-15, -9);
    float2 facing = float2(0, 1);
    float speed;
    bool lit = true;
    Parcel[4] parcels;
    bool[20] visited;
    bool repeated;
    int edge = -1;
    int lastEdge = -1;
    int travelEdge = -1;
    int travelSign;
    int trip;
    int bundle;
    int tripDelivered;
    bool tripFailed;
    int pendingBonus;
    int earnings;
    int delivered;
    int spoiled;
    int bonuses;
    float distance;
    float[4] violations;
    float notice;
    int message; // 1 delivered, 2 spoiled, 3 depot, 4 no parcel here
    int messageKind;
}
scene Main { }

// Touch controls are local; the match receives only this bounded input.
local singleton TouchPad { float2 move; bool brace; bool handoff; }
input CourierInput
{
    [Clamp(-1, 1)] float2 move;
    bool brace;
    bool handoff;
    Sample(TouchPad touch)
    {
        move = touch.move;
        brace = touch.brace;
        handoff = touch.handoff;
    }
}
command Depart { int serial; int mask; }
command Shift { int serial; int seed; }
command ReturnToDepot { int serial; }

void Manifest(mut Night night)
{
    for (var kind = 0; kind < 4; kind++)
    {
        var address = (kind + night.seed - 1 + night.trip) % 4;
        night.parcels[kind] = Parcel { destination = address, value = 26 + ((night.seed * 7 + kind * 3 + night.trip) % 5) * 6 };
    }
    night.phase = 0;
    night.serial++;
    night.edge = -1;
    night.lastEdge = -1;
    night.travelEdge = -1;
    night.travelSign = 0;
    night.repeated = false;
    for (var edge = 0; edge < STREETS; edge++) night.visited[edge] = false;
}
void ResetNight(mut Night night, int seed)
{
    night.seed = seed;
    night.started = false;
    night.left = SHIFT_SECONDS;
    night.position = Junction(8);
    night.facing = float2(0, 1);
    night.speed = 0;
    night.lit = true;
    night.trip = 0;
    night.bundle = 0;
    night.tripDelivered = 0;
    night.tripFailed = false;
    night.pendingBonus = 0;
    night.earnings = 0;
    night.delivered = 0;
    night.spoiled = 0;
    night.bonuses = 0;
    night.distance = 0;
    night.notice = 0;
    night.message = 0;
    night.messageKind = 0;
    for (var kind = 0; kind < 4; kind++) night.violations[kind] = 0;
    Manifest(night);
}
event(PlayerJoined joined) StartShift(mut Night night)
{
    night.player = joined.player;
    Manifest(night);
}
command(Shift shift, PlayerID sender) ChangeShift(mut Night night)
{
    if (sender != night.player || shift.serial != night.serial || shift.seed < 1 || shift.seed > 999) return;
    ResetNight(night, shift.seed);
}
command(Depart depart, PlayerID sender) LoadCargo(mut Night night)
{
    if (sender != night.player || depart.serial != night.serial || night.phase != 0 || depart.mask < 1 || depart.mask > 15 || BitCount(depart.mask) > 3) return;
    night.bundle = BitCount(depart.mask);
    night.tripDelivered = 0;
    night.tripFailed = false;
    night.pendingBonus = 0;
    for (var kind = 0; kind < 4; kind++) night.parcels[kind].carried = (depart.mask & (1 << kind)) != 0;
    night.phase = 1;
    night.started = true;
    night.serial++;
    night.notice = 0;
}
int CargoCount(Night night)
{
    mut var count = 0;
    for (var kind = 0; kind < 4; kind++) if (night.parcels[kind].carried) count++;
    return count;
}
void Spoil(mut Night night, int kind)
{
    night.parcels[kind].carried = false;
    night.parcels[kind].spoiled = true;
    night.parcels[kind].breaking = false;
    night.spoiled++;
    night.tripFailed = true;
    night.pendingBonus = 0;
    night.earnings -= 10;
    night.notice = 3;
    night.message = 2;
    night.messageKind = kind;
}
void Depot(mut Night night)
{
    for (var kind = 0; kind < 4; kind++) if (night.parcels[kind].carried) Spoil(night, kind);
    night.trip++;
    night.position = Junction(8);
    night.facing = float2(0, 1);
    night.speed = 0;
    Manifest(night);
    night.message = 3;
    night.notice = 2;
}
command(ReturnToDepot back, PlayerID sender) Unload(mut Night night)
{
    if (sender != night.player || back.serial != night.serial || night.phase != 1 || Math.Length(night.position - Junction(8)) > 1.5) return;
    Depot(night);
}
// Intersections are neutral for Echo. Entering any edge again counts even
// when traversing it the other way. Reversing before leaving counts too.
void TrackStreet(mut Night night, float2 displacement)
{
    night.edge = -1;
    for (var node = 0; node < 12; node++)
        if (Math.Length(night.position - Junction(node)) < 1.05) return;
    mut var best = ROAD_RADIUS + 0.01;
    for (var edge = 0; edge < STREETS; edge++)
    {
        var distance = StreetDistance(night.position, edge);
        if (distance < best) { best = distance; night.edge = edge; }
    }
    if (night.edge < 0) return;
    if (night.edge != night.lastEdge)
    {
        night.repeated = night.visited[night.edge];
        night.visited[night.edge] = true;
        night.lastEdge = night.edge;
    }
    // A same-edge U-turn is recognized from progress along its endpoints.
    if (Math.Length(displacement) > 0.001)
    {
        var line = Junction(StreetB(night.edge)) - Junction(StreetA(night.edge));
        var toward = Math.Dot(displacement, line);
        // Facing stores visual direction, so keep route direction separately.
        if (night.travelSign != 0 && night.travelEdge == night.edge && toward * night.travelSign < 0) night.repeated = true;
        night.travelSign = toward > 0 ? 1 : -1;
        night.travelEdge = night.edge;
    }
}

system LateShift(CourierInput input, mut Night night, Time time)
{
    night.notice = Math.Max(0, night.notice - time.dt);
    if (night.phase == 2) return;
    if (night.started)
    {
        night.left = Math.Max(0, night.left - time.dt);
        if (night.left <= 0)
        {
            for (var kind = 0; kind < 4; kind++) if (night.parcels[kind].carried) Spoil(night, kind);
            night.phase = 2;
            night.serial++;
            return;
        }
    }
    if (night.phase != 1) return;
    var move = Math.Length(input.move) > 1 ? Math.Normalize(input.move) : input.move;
    if (input.brace) night.facing = float2(0, 1);
    else if (Math.Length(move) > 0.1) night.facing = Math.Normalize(move);
    var pace = input.brace && move.y < 0.85 ? 2.4 : 4.2;
    var before = night.position;
    var desired = move * pace * time.dt;
    if (Walkable(night.position + desired)) night.position += desired;
    else
    {
        if (Walkable(night.position + float2(desired.x, 0))) night.position.x += desired.x;
        if (Walkable(night.position + float2(0, desired.y))) night.position.y += desired.y;
    }
    var displacement = night.position - before;
    night.speed = Math.Length(displacement) / time.dt;
    night.distance += Math.Length(displacement);
    night.lit = InLight(night.position);
    TrackStreet(night, displacement);

    // A handoff happens before strain: a parcel can be saved at the door.
    if (input.handoff)
    {
        if (Math.Length(night.position - Junction(8)) < 1.5) { Depot(night); return; }
        for (var kind = 0; kind < 4; kind++)
        {
            if (!night.parcels[kind].carried || Math.Length(night.position - Junction(AddressNode(night.parcels[kind].destination))) > 1.5) continue;
            var base = night.parcels[kind].value;
            var bonus = base * (night.bundle - 1) * 35 / 100;
            night.earnings += base;
            night.tripDelivered++;
            if (!night.tripFailed) night.pendingBonus += bonus;
            if (!night.tripFailed && night.tripDelivered == night.bundle)
            {
                night.earnings += night.pendingBonus;
                night.bonuses += night.pendingBonus;
                night.pendingBonus = 0;
            }
            night.delivered++;
            night.parcels[kind].carried = false;
            night.parcels[kind].delivered = true;
            night.parcels[kind].breaking = false;
            night.notice = 3;
            night.message = 1;
            night.messageKind = kind;
        }
    }
    for (var kind = 0; kind < 4; kind++)
    {
        if (!night.parcels[kind].carried) continue;
        var wrong = kind == 0 ? !night.lit : kind == 1 ? night.speed < 0.6 : kind == 2 ? night.facing.y < 0.85 : night.edge >= 0 && night.repeated;
        night.parcels[kind].breaking = wrong;
        if (wrong) night.violations[kind] += time.dt;
        var rate = kind == 0 ? 18.0 : kind == 1 ? 24.0 : kind == 2 ? 15.0 : 18.0;
        night.parcels[kind].strain = Math.Clamp(night.parcels[kind].strain + (wrong ? rate : -8.0) * time.dt, 0, 100);
        if (night.parcels[kind].strain >= 100) Spoil(night, kind);
    }
}
