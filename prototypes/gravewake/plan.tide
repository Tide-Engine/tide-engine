// Ashwick Wood as one plan: a clearing in the forest outside the burned
// village, every kit piece and where it stands, the boxes nobody walks
// through, where the survivors start round the fire and where the dead claw
// up out of the ground. MakePlan() is deterministic: the match keeps what it
// needs (Ashwick, made at the start), and each machine makes it again for
// what it draws. Change one, and both follow.
//
// The clearing, metres, x east and z north, about 20 m round the fire:
//
//                       N   the chapel's ruin
//                    .-------------------.
//                  /     [ruin walls]      \
//                 |  graves    (fire)  camp |  E
//                 |  (fence)           wagon|
//                  \      rocks  twisted   /
//                    '-------------------'
//                       S       tree
//
// Beyond its edge the trees stand close, and the ground there is nobody's.

enum Brew { Ironhide, Quickhand, SecondWind, Twinstrike, Fleetfoot, Packmule }

const int BREW_COUNT = 6;

// One kit piece, placed: turned `yaw` about up, then moved to `at`.
struct Put
{
    Piece piece;
    float3 at;
    float yaw;
    float3 scale = float3(1);
    float open = 1;          // How much sky it sees: 0 indoors
    float tint = 1;
}

// A box nobody walks through, in the world's axes.
struct Solid
{
    float3 center;
    float3 half;
}

// A place in the ground the dead rise from: a grave, or the roots at the clearing's edge.
struct Riser
{
    float3 at;
    bool grave;
}

// One of the items (art/items) set about the clearing: a gravestone, a mound, a brazier.
struct ItemPut
{
    string item;
    float3 at;
    float yaw;
    float scale = 1;
}

struct Plan
{
    List<Put> placements;
    List<Solid> solids;
    List<Riser> risers;
    List<float3> starts;
    List<float3> torches;    // Where a torch burns
    List<float3> fires;      // The braziers, always burning: the camp's fire in the middle, and the wagon's
    List<ItemPut> dressing;
    List<float4> paved;      // Stone underfoot: x0, z0, x1, z1
}

const float STOREY = 3.12;    // A kit wall's height
const float CLEARING = 20;    // About how far the clearing reaches from the fire

// How far the clearing reaches from the fire, toward a turn about up (0 east, a quarter north).
float Reach(float angle)
{
    return CLEARING + 2.5 * Math.Sin(angle * 3 + 0.7) + 1.2 * Math.Sin(angle * 7 + 2.1);
}

bool InClearing(float3 at)
{
    return Math.Length(at.xz) < Reach(Math.Atan2(at.z, at.x));
}

// The place at the clearing's edge (or `out` metres past it) toward a turn.
float3 EdgeAt(float angle, float out)
{
    var far = Reach(angle) + out;
    return float3(Math.Cos(angle) * far, 0, Math.Sin(angle) * far);
}

// The turn that has a piece's +z face the way `side` says: 0 north (+z), 1 east (+x), 2 south (-z), 3 west (-x).
float SideYaw(int side)
{
    return side * Math.PI * 0.5;
}

float2 SideWay(int side)
{
    if (side == 0) return float2(0, 1);
    if (side == 1) return float2(1, 0);
    if (side == 2) return float2(0, -1);
    return float2(-1, 0);
}

float3 Flat3(float2 at)
{
    return float3(at.x, 0, at.y);
}

void Place(mut Plan plan, Piece piece, float3 at, float yaw)
{
    plan.placements.Add(Put { piece = piece, at = at, yaw = yaw });
}

void PlaceScaled(mut Plan plan, Piece piece, float3 at, float yaw, float scale)
{
    plan.placements.Add(Put { piece = piece, at = at, yaw = yaw, scale = float3(scale) });
}

// A torch in its bracket on a wall: the bracket's plate at `at`, on the wall's face, the torch leaning out toward `side`
// (see SideYaw). Its flame burns over the torch's head.
void WallTorch(mut Plan plan, float3 at, int side)
{
    Place(plan, Piece.Torch_Metal, at, SideYaw(side));
    var way = SideWay(side);
    plan.torches.Add(at + float3(way.x * 0.27, 0.42, way.y * 0.27));
}

// A prop that stands in the way: placed, with a box round its footprint (turned with it). Its footprint is the kit
// model's as the game has it (the importer mirrors x): the middle's offset from its origin, half its size across and
// deep, and its height.
void PlaceSolid(mut Plan plan, Piece piece, float3 at, float yaw, float scale = 1)
{
    mut var foot = float4(0, 0, 0.3, 0.3);
    mut var high = 1.0;
    switch (piece)
    {
        case Piece.Stall_Cart_Empty: foot = float4(0.6, 0, 1.51, 0.53); high = 1.3; break;
        case Piece.Prop_Wagon: foot = float4(0, -1.14, 0.97, 2.0); high = 1.5; break;
        case Piece.Barrel: foot = float4(0, 0, 0.34, 0.34); high = 0.9; break;
        case Piece.Crate_Wooden: foot = float4(0, 0, 0.54, 0.58); high = 1.1; break;
        case Piece.Bench: foot = float4(0, 0, 1.39, 0.26); high = 0.53; break;
        case Piece.Anvil_Log: foot = float4(-0.06, 0.06, 0.46, 0.41); high = 1.07; break;
        case Piece.Cauldron: foot = float4(0, 0, 0.5, 0.47); high = 0.82; break;
        case Piece.Chest_Wood: foot = float4(0, 0, 0.64, 0.38); high = 0.72; break;
        case Piece.Prop_WoodenFence_Single: foot = float4(0, 0, 1.03, 0.08); high = 0.84; break;
        case Piece.Prop_WoodenFence_Extension1: foot = float4(0, 0, 1.01, 0.08); high = 0.84; break;
        case Piece.Prop_MetalFence_Ornament: foot = float4(0, 0, 0.97, 0.08); high = 2.85; break;
        case Piece.Rock_Medium_1: foot = float4(0.12, 0.35, 1.45, 1.3); high = 2.0; break;
        case Piece.Rock_Medium_2: foot = float4(0.18, 0.08, 1.4, 1.1); high = 1.8; break;
        case Piece.Rock_Medium_3: foot = float4(0.11, 0.85, 1.55, 1.6); high = 2.0; break;
    }
    foot *= scale;
    high *= scale;
    plan.placements.Add(Put { piece = piece, at = at, yaw = yaw, scale = float3(scale) });
    var c = Math.Cos(yaw);
    var s = Math.Sin(yaw);
    // The middle turned with the prop (its +x goes to (cos, -sin) on the ground), and the turned footprint's box
    var middle = at + float3(foot.x * c + foot.y * s, 0, -foot.x * s + foot.y * c);
    var half = float2(Math.Abs(c) * foot.z + Math.Abs(s) * foot.w, Math.Abs(s) * foot.z + Math.Abs(c) * foot.w);
    Block(plan, float3(middle.x - half.x, at.y, middle.z - half.y), float3(middle.x + half.x, at.y + high, middle.z + half.y));
}

// A tree in the clearing: its trunk is in the way.
void Tree(mut Plan plan, Piece piece, float3 at, float yaw, float scale = 1)
{
    PlaceScaled(plan, piece, at, yaw, scale);
    var trunk = 0.42 * scale;
    Block(plan, at - float3(trunk, 0, trunk), at + float3(trunk, 4, trunk));
}

void Block(mut Plan plan, float3 lo, float3 hi)
{
    plan.solids.Add(Solid { center = (lo + hi) * 0.5, half = (hi - lo) * 0.5 });
}

void BlockFlat(mut Plan plan, float2 lo, float2 hi, float high)
{
    Block(plan, float3(lo.x, 0, lo.y), float3(hi.x, high, hi.y));
}

// The unit step from a to b along whichever axis they differ on.
float2 Toward(float2 a, float2 b)
{
    var d = b - a;
    if (Math.Abs(d.x) > Math.Abs(d.y)) return float2(d.x >= 0 ? 1.0 : -1.0, 0);
    if (Math.Abs(d.y) > 0.001) return float2(0, d.y >= 0 ? 1.0 : -1.0);
    return float2(0);
}

// What's left of a stone wall from `a` to `b` (whole 2 m segments along x or z), stone on both faces. Bits of `windows`
// make a segment a window, and bits of `fallen` leave a segment out, a gap in the ruin.
void StoneWall(mut Plan plan, float2 a, float2 b, long windows, long fallen)
{
    var step = Toward(a, b);
    var count = int(Math.Round(Math.Length(b - a) / 2));
    var side = step.x != 0 ? 0 : 1;           // Its face: north for a wall along x, east for one along z
    var thick = float2(Math.Abs(step.y), Math.Abs(step.x)) * 0.32;
    mut var runStart = 0;
    for (var s = 0; s <= count; s++)
    {
        var gone = s < count && (fallen & (1L << s)) != 0;
        if (s < count && !gone)
        {
            var at = a + step * (1 + s * 2);
            var piece = (windows & (1L << s)) != 0 ? Piece.Wall_UnevenBrick_Window_Wide_Round : Piece.Wall_UnevenBrick_Straight;
            // Two pieces back to back, so both faces are stone: each one's plaster inside is hidden in the other
            var way = SideWay(side);
            Place(plan, piece, Flat3(at + way * 0.21), SideYaw(side));
            Place(plan, piece, Flat3(at - way * 0.21), SideYaw((side + 2) % 4));
            continue;
        }
        // A run of standing segments ends: its box, and a post at each end
        if (s > runStart)
        {
            var from = a + step * (runStart * 2);
            var to = a + step * (s * 2);
            BlockFlat(plan, Math.Min(from, to) - thick, Math.Max(from, to) + thick, STOREY);
            Place(plan, Piece.Corner_ExteriorWide_Brick, Flat3(from), 0);
            Place(plan, Piece.Corner_ExteriorWide_Brick, Flat3(to), 0);
        }
        runStart = s + 1;
    }
}

// Paving: the kit's floor tiles, 2 m square, over x0..x1 by z0..z1, and stone underfoot there.
void Pave(mut Plan plan, Piece tile, float x0, float z0, float x1, float z1, float y)
{
    for (var x = x0 + 1; x < x1; x += 2)
    {
        for (var z = z0 + 1; z < z1; z += 2)
        {
            var turn = (Math.Hash(int2(int(x * 7), int(z * 13))) & 3) * Math.PI * 0.5;
            plan.placements.Add(Put { piece = tile, at = float3(x, y, z), yaw = turn });
        }
    }
    plan.paved.Add(float4(x0, z0, x1, z1));
}

bool Paved(Plan plan, float3 at)
{
    foreach (var p in plan.paved)
        if (at.x >= p.x && at.x <= p.z && at.z >= p.y && at.z <= p.w) return true;
    return false;
}

// Whether a place is clear of every box so far, by `room` metres.
bool Clear(Plan plan, float3 at, float room)
{
    foreach (var solid in plan.solids)
    {
        if (Math.Abs(at.x - solid.center.x) < solid.half.x + room && Math.Abs(at.z - solid.center.z) < solid.half.z + room) return false;
    }
    return true;
}

// A unit number from a hash's bits.
float Unit01(int h, int shift)
{
    return ((h >> shift) & 1023) / 1023.0;
}

Plan MakePlan()
{
    mut Plan plan = Plan { };

    // ---- The camp in the middle: the fire, logs to sit on, what was carried out of the village ----
    plan.fires.Add(float3(0, 0, 0));
    PlaceSolid(plan, Piece.Bench, float3(0, 0, 2.7), 0);
    PlaceSolid(plan, Piece.Cauldron, float3(2.5, 0, 1.9), 0.4);
    PlaceSolid(plan, Piece.Crate_Wooden, float3(-2.6, 0, 2.1), 0.3);
    Place(plan, Piece.Bag, float3(-2.9, 0, -1.2), 0.9);
    Place(plan, Piece.Bucket_Wooden_1, float3(2.9, 0, -0.9), 0);
    Place(plan, Piece.Rope_1, float3(-1.9, 0, 3.4), 0.6);
    plan.starts.Add(float3(-1.6, 0, -3.1));
    plan.starts.Add(float3(1.6, 0, -3.1));
    plan.starts.Add(float3(-3.4, 0, 0.4));
    plan.starts.Add(float3(3.4, 0, 0.4));

    // ---- North: the chapel's ruin, its walls half down, its floor still there ----
    Pave(plan, Piece.Floor_UnevenBrick, -6, 8, 6, 14, 0.02);
    StoneWall(plan, float2(-6, 14), float2(6, 14), (1L << 2) | (1L << 3), 1L << 5);
    StoneWall(plan, float2(-6, 8), float2(-6, 14), 0, 1L << 0);
    StoneWall(plan, float2(6, 10), float2(6, 14), 1L << 0, 0);
    WallTorch(plan, float3(-3, 2.0, 13.69), 2);
    WallTorch(plan, float3(1.6, 2.0, 13.69), 2);
    PlaceSolid(plan, Piece.Chest_Wood, float3(-1, 0.02, 12.9), Math.PI);
    for (var i = 0; i < 9; i++)
    {
        var h = Math.Hash(int2(i, 515));
        var at = float3(-6 + Unit01(h, 0) * 13, 0.05, 6.5 + Unit01(h, 10) * 7);
        Place(plan, i % 2 == 0 ? Piece.Prop_Brick1 : Piece.Prop_Brick3, at, Unit01(h, 20) * 6);
    }

    // ---- West: the old graveyard, its iron fence fallen in places ----
    for (var i = 0; i < 8; i++)
    {
        var h = Math.Hash(int2(i, 77));
        var at = float3(-14 + (i % 2) * 4.2 + ((h & 7) - 3) * 0.1, 0, -5.4 + (i / 2) * 3.2 + ((h >> 3) & 7) * 0.05);
        plan.risers.Add(Riser { at = at, grave = true });
    }
    PlaceSolid(plan, Piece.Prop_MetalFence_Ornament, float3(-7.2, 0, -4.4), Math.PI * 0.5);
    PlaceSolid(plan, Piece.Prop_MetalFence_Ornament, float3(-7.2, 0, 4.6), Math.PI * 0.5);
    PlaceSolid(plan, Piece.Prop_MetalFence_Ornament, float3(-11, 0, -7.6), 0);
    PlaceSolid(plan, Piece.Prop_MetalFence_Ornament, float3(-14.4, 0, -7.6), 0.06);
    Tree(plan, Piece.DeadTree_1, float3(-15, 0, 7), 0.4, 0.9);
    Tree(plan, Piece.DeadTree_3, float3(-11.5, 0, 8.5), 2.1, 0.8);

    // ---- East: where a cart was left, and a second fire ----
    PlaceSolid(plan, Piece.Prop_Wagon, float3(13, 0, 2.5), 0.35);
    PlaceSolid(plan, Piece.Stall_Cart_Empty, float3(10.5, 0, -5), 1.2);
    PlaceSolid(plan, Piece.Barrel, float3(9.6, 0, 4.8), 0.3);
    PlaceSolid(plan, Piece.Barrel, float3(10.4, 0, 5.5), 1.1);
    PlaceSolid(plan, Piece.Crate_Wooden, float3(15.5, 0, -2.6), 0.2);
    PlaceSolid(plan, Piece.Anvil_Log, float3(8.6, 0, -1.6), 0.7);
    PlaceSolid(plan, Piece.Prop_WoodenFence_Single, float3(17, 0, -5.5), Math.PI * 0.5 + 0.1);
    PlaceSolid(plan, Piece.Prop_WoodenFence_Extension1, float3(16.6, 0, 6), Math.PI * 0.5 - 0.15);
    plan.fires.Add(float3(11.5, 0, -1));

    // ---- South: boulders, and a twisted oak ----
    PlaceSolid(plan, Piece.Rock_Medium_1, float3(-4.5, 0, -12.5), 0.3);
    PlaceSolid(plan, Piece.Rock_Medium_2, float3(2.5, 0, -14.5), 2.0);
    PlaceSolid(plan, Piece.Rock_Medium_3, float3(-10.5, 0, -10.5), 4.1, 0.8);
    Tree(plan, Piece.TwistedTree_3, float3(7, 0, -10), 1.0, 0.9);
    Tree(plan, Piece.Pine_5, float3(-5.5, 0, -7.5), 0.7, 0.85);
    Tree(plan, Piece.CommonTree_1, float3(-9.5, 0, 11.5), 2.6);
    Tree(plan, Piece.CommonTree_3, float3(10, 0, 10), 0.2);

    // ---- The dead's other way in: up through the roots at the clearing's edge ----
    for (var i = 0; i < 14; i++)
    {
        var angle = (i + 0.5) * Math.TAU / 14;
        mut var at = EdgeAt(angle, -1.6);
        if (!Clear(plan, at, 0.8)) at = EdgeAt(angle, -0.9);
        if (!Clear(plan, at, 0.6)) continue;
        plan.risers.Add(Riser { at = at });
    }

    // ---- The graves' mounds and stones, with a few older stones among them ----
    foreach (var riser in plan.risers)
    {
        if (!riser.grave) continue;
        var h = Math.Hash(int2(int(riser.at.x * 10), int(riser.at.z * 10)));
        plan.dressing.Add(ItemPut { item = "grave_mound", at = riser.at, yaw = Math.PI * 0.5 + ((h & 7) - 3) * 0.04 });
        var stone = (h >> 3) % 3 == 0 ? "gravestone_a" : (h >> 3) % 3 == 1 ? "gravestone_b" : "gravestone_c";
        plan.dressing.Add(ItemPut { item = stone, at = riser.at + float3(-1.15, 0, 0), yaw = Math.PI * 0.5 + ((h >> 6) & 7) * 0.04 - 0.14 });
        Block(plan, riser.at + float3(-1.32, 0, -0.4), riser.at + float3(-0.98, 1.1, 0.4));
    }
    for (var i = 0; i < 7; i++)
    {
        var h = Math.Hash(int2(i, 911));
        var at = float3(-16 + Unit01(h, 0) * 8, 0, -6.5 + Unit01(h, 10) * 13);
        mut var near = false;
        foreach (var riser in plan.risers)
            if (Math.Distance(riser.at, at) < 2.2) near = true;
        if (near || !Clear(plan, at, 0.5) || !InClearing(at)) continue;
        var stone = (h >> 20) % 3 == 0 ? "gravestone_a" : (h >> 20) % 3 == 1 ? "gravestone_b" : "gravestone_c";
        plan.dressing.Add(ItemPut { item = stone, at = at, yaw = Math.PI * 0.5 + ((h >> 22) & 63) * 0.02 - 0.6, scale = 0.9 + ((h >> 28) & 3) * 0.08 });
        Block(plan, at - float3(0.18, 0, 0.35), at + float3(0.18, 1.1, 0.35));
    }

    // ---- The fires' braziers ----
    foreach (var at in plan.fires)
    {
        plan.dressing.Add(ItemPut { item = "brazier", at = at });
        Block(plan, at - float3(0.5, 0, 0.5), at + float3(0.5, 1.4, 0.5));
    }

    // ---- The forest: close round the edge, thinning into the fog ----
    for (var i = 0; i < 96; i++)
    {
        var h = Math.Hash(int2(i, 4242));
        var angle = (i + Unit01(h, 0) * 0.8) * Math.TAU / 96;
        var at = EdgeAt(angle, 1.2 + Unit01(h, 10) * 5.5);
        var kind = (h >> 20) % 9;
        var piece = kind == 0 ? Piece.CommonTree_1 : kind == 1 ? Piece.CommonTree_3 : kind == 2 ? Piece.CommonTree_5 : kind == 3 ? Piece.Pine_1
                  : kind == 4 ? Piece.Pine_3 : kind == 5 ? Piece.Pine_5 : kind == 6 ? Piece.DeadTree_2 : kind == 7 ? Piece.CommonTree_1 : Piece.Pine_3;
        PlaceScaled(plan, piece, at, Unit01(h, 4) * Math.TAU, 1.0 + Unit01(h, 14) * 0.45);
    }
    for (var i = 0; i < 110; i++)
    {
        var h = Math.Hash(int2(i, 4343));
        var angle = Unit01(h, 0) * Math.TAU;
        var at = EdgeAt(angle, 8 + Unit01(h, 10) * 55);
        var kind = (h >> 20) % 6;
        var piece = kind == 0 ? Piece.CommonTree_3 : kind == 1 ? Piece.Pine_1 : kind == 2 ? Piece.Pine_5 : kind == 3 ? Piece.DeadTree_1
                  : kind == 4 ? Piece.CommonTree_5 : Piece.TwistedTree_3;
        PlaceScaled(plan, piece, at, Unit01(h, 4) * Math.TAU, 1.1 + Unit01(h, 14) * 0.5);
    }
    // Undergrowth along the edge, a few ferns and plants, and grass and mushrooms over the clearing
    for (var i = 0; i < 48; i++)
    {
        var h = Math.Hash(int2(i, 5151));
        var angle = (i + Unit01(h, 0)) * Math.TAU / 48;
        var at = EdgeAt(angle, -0.6 + Unit01(h, 10) * 1.6);
        var kind = (h >> 20) % 4;
        if (kind == 0) PlaceScaled(plan, Piece.Fern_1, at, Unit01(h, 4) * Math.TAU, 0.22 + Unit01(h, 14) * 0.1);
        else if (kind == 1) PlaceScaled(plan, Piece.Plant_1_Big, at, Unit01(h, 4) * Math.TAU, 0.5 + Unit01(h, 14) * 0.3);
        else PlaceScaled(plan, Piece.Bush_Common, at, Unit01(h, 4) * Math.TAU, 0.9 + Unit01(h, 14) * 0.6);
    }
    for (var i = 0; i < 90; i++)
    {
        var h = Math.Hash(int2(i, 6161));
        var at = EdgeAt(Unit01(h, 0) * Math.TAU, -1 - Unit01(h, 10) * 15);
        if (Paved(plan, at) || !Clear(plan, at, 0.2) || Math.Length(at.xz) < 4) continue;
        if ((h >> 20) % 6 == 0) PlaceScaled(plan, Piece.Mushroom_Common, at, Unit01(h, 4) * Math.TAU, 0.6 + Unit01(h, 14) * 0.5);
        else PlaceScaled(plan, Piece.Grass_Common_Tall, at, Unit01(h, 4) * Math.TAU, 0.5 + Unit01(h, 14) * 0.4);
    }
    return plan;
}
