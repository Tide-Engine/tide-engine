// Ashwick Wood as one plan: a wide clearing in the forest outside the burned
// village, its ground (the chapel's rise, the beacon's spire in two tiers, the
// sunken graveyard, the ravine, ramps up and down them all), every kit piece
// and where it stands, the
// boxes nobody walks through, where the survivors start round the fire and
// where the dead claw up out of the ground. Ground() and MakePlan() are
// deterministic: the match keeps what it needs (Ashwick, made at the start),
// and each machine makes it again for what it draws. Change one, and both
// follow.
//
// The clearing, metres, x east and z north, about 62 m round the fire (it was 44: the owner, "we should make the map
// bigger; also include less obstructions"):
//
//                          N    the chapel's rise, 6 m up, the ruin on it
//                  .-----------[ ruin ]-----------.
//                /  stones   ramp /    \ ramp       \
//               |                           beacon's  |
//               | graves         fire       spire     |  E
//               | (sunken)                 4 m, 9 m   |
//               |  ~~~~~~~~~~~ the ravine ~~~~~~~~~~~  |
//                '-----------------------------------'
//                          S
//
// Beyond its edge the ground climbs into the trees, and it's nobody's.

// One kit piece, placed: turned `yaw` about up, then moved to `at`.
struct Put
{
    Piece piece;
    float3 at;
    float yaw;
    float3 scale = float3(1);
    float open = 1;          // How much sky it sees: 0 indoors
    float tint = 1;
}

// A box nobody walks through, in the world's axes.
struct Solid
{
    float3 center;
    float3 half;
}

// A place in the ground the dead rise from: a grave, or the roots at the clearing's edge.
struct Riser
{
    float3 at;
    bool grave;
}

// One of the items (art/items) set about the clearing: a gravestone, a mound, a brazier.
struct ItemPut
{
    string item;
    float3 at;
    float yaw;
    float scale = 1;
}

struct Plan
{
    List<Put> placements;
    List<Solid> solids;
    List<Riser> risers;
    List<float3> starts;
    List<float3> torches;    // Where a torch burns
    List<float3> fires;      // The braziers, always burning: the camp's fire in the middle, and the wagon's
    List<ItemPut> dressing;
    List<float4> paved;      // Stone underfoot: x0, z0, x1, z1
}

const float STOREY = 3.12;    // A kit wall's height
const float CLEARING = 62;    // About how far the clearing reaches from the fire
const float RUIN_TOP = 6;     // The chapel's rise, the ruin on it
const float SPIRE_LOW = 4;    // The beacon's spire: its lower tier...
const float SPIRE_TOP = 9;    // ...and its top, where the beacon burns
const float RAVINE_DEPTH = 3; // The ravine across the south

// How far the clearing reaches from the fire, toward a turn about up (0 east, a quarter north).
float Reach(float angle)
{
    return CLEARING + 4 * Math.Sin(angle * 3 + 0.7) + 2 * Math.Sin(angle * 7 + 2.1);
}

bool InClearing(float3 at)
{
    return Math.Length(at.xz) < Reach(Math.Atan2(at.z, at.x));
}

// The place at the clearing's edge (or `out` metres past it) toward a turn, on the ground.
float3 EdgeAt(float angle, float out)
{
    var far = Reach(angle) + out;
    return On(Math.Cos(angle) * far, Math.Sin(angle) * far);
}

// A flat top `top` high within `r` of `c`, falling away over `w` (a cliff when `w` is short): 0 to 1 of the way up.
float Mesa(float2 at, float2 c, float r, float w)
{
    return 1 - Math.SmoothStep(r, r + w, Math.Distance(at, c));
}

// A ramp from `a` (as high as what it climbs to) down to `b`, `half` wide each side: 0 to 1 of the way up.
float Ramp(float2 at, float2 a, float2 b, float half)
{
    var ab = b - a;
    var t = Math.Saturate(Math.Dot(at - a, ab) / Math.Dot(ab, ab));
    var side = Math.Distance(at, a + ab * t);
    return (1 - t) * (1 - Math.SmoothStep(half, half + 0.8, side));
}

// A round hill or, with a negative height, a hollow.
float Bump(float2 at, float2 c, float r, float h)
{
    var d = Math.Saturate(Math.Distance(at, c) / r);
    return h * (1 - d * d * (3 - 2 * d));
}

// A ramp from `a` (as high as `top`) down to `b`, `half` wide each side, its sides cliffs: the ground `h` there
// A ramp from `a` (at `top`) straight down to the ground at `b`, `half` wide each side, laid over `h`: down to `below`,
// the ground before what it climbs was raised, so the rise's own edge doesn't bend it (a ramp that met `h` there was
// too steep for the dead where it left the top); and never under `h`, so the top stays flat.
float RampTo(float h, float below, float2 at, float2 a, float2 b, float half, float top)
{
    var ab = b - a;
    var t = Math.Dot(at - a, ab) / Math.Dot(ab, ab);
    var along = Math.Saturate(t);
    var side = Math.Distance(at, a + ab * along);
    var weight = (1 - Math.SmoothStep(half, half + 0.8, side)) * (1 - Math.SmoothStep(1.0, 1.1, t));
    // At the top from `a` till RAMP_FLAT of the way: out past the rise's edge, whose own blend climbs faster than a ramp
    // (it had left a steep lip at the head of each ramp, which a survivor could only jump)
    var slope = Math.Saturate((along - RAMP_FLAT) / (1 - RAMP_FLAT));
    return Math.Lerp(h, Math.Max(h, Math.Lerp(top, below, slope)), weight);
}

const float RAMP_FLAT = 0.2;
const float GRAVESTONE_SCALE = 0.75;    // Gravestones, smaller than the kit's: nothing to walk round, stepped past
const float BEACON_SCALE = 1.5;         // The beacons' braziers, against the fires'

// How far into a ditch along `a` to `b` a place is: 1 on its floor (`half` each side), 0 past its banks.
float Ditch(float2 at, float2 a, float2 b, float half, float fall)
{
    var ab = b - a;
    var along = Math.Saturate(Math.Dot(at - a, ab) / Math.Dot(ab, ab));
    return 1 - Math.SmoothStep(half, half + fall, Math.Distance(at, a + ab * along));
}

// The landmarks' places (each as big as it was when the clearing was 44 m: they moved out with its edge)
const float2 CHAPEL = float2(0, 42);
const float2 SPIRE = float2(43, -4);        // The lower tier's middle
const float2 BEACON = float2(46, -1);       // The top's
const float2 GRAVES = float2(-38, 4);
const float2 STONES = float2(-36, 34);
const float2 RAVINE_A = float2(-48, -38);
const float2 RAVINE_B = float2(45, -32);
// The ramps: from the top end down to the foot
const float2 WEST_RAMP_A = float2(-8, 35);
const float2 WEST_RAMP_B = float2(-21, 24);
const float2 EAST_RAMP_A = float2(8, 35);
const float2 EAST_RAMP_B = float2(20, 25);
const float2 SPIRE_RAMP_A = float2(31.5, -9);
const float2 SPIRE_RAMP_B = float2(22, -15);
const float2 BEACON_RAMP_A = float2(43.5, -4.5);
const float2 BEACON_RAMP_B = float2(36, -11);

// The ground's height at a place: the same everywhere it's asked, in the match and in the picture.
float Ground(float x, float z)
{
    var at = float2(x, z);
    var far = Math.Length(at);
    // Rolling ground, laid flat round the fire
    mut var h = (Math.Perlin(at * 0.045 + float2(3.1, 7.7)) * 1.1 + Math.Perlin(at * 0.13 + float2(11, 5)) * 0.35) * Math.SmoothStep(6, 12, far);
    // The graveyard sunk in its hollow, the ravine cut across the south
    h += Bump(at, GRAVES, 11, -2.4);
    h -= RAVINE_DEPTH * Ditch(at, RAVINE_A, RAVINE_B, 2.5, 9);
    // Up into the trees past the edge
    h += 4 * Math.SmoothStep(-6, 6, far - Reach(Math.Atan2(z, x)));
    // The chapel's rise, a ramp down each side
    var below = h;
    h = Math.Lerp(h, RUIN_TOP, Mesa(at, CHAPEL, 12, 1.5));
    h = RampTo(h, below, at, WEST_RAMP_A, WEST_RAMP_B, 2.5, RUIN_TOP);
    h = RampTo(h, below, at, EAST_RAMP_A, EAST_RAMP_B, 2.5, RUIN_TOP);
    // The beacon's spire: the lower tier and its ramp, then the top and its ramp up from the tier
    var low = h;
    h = Math.Lerp(h, SPIRE_LOW, Mesa(at, SPIRE, 13, 1.4));
    h = RampTo(h, low, at, SPIRE_RAMP_A, SPIRE_RAMP_B, 2.5, SPIRE_LOW);
    var tier = h;
    h = Math.Lerp(h, SPIRE_TOP, Mesa(at, BEACON, 4.5, 1.0));
    h = RampTo(h, tier, at, BEACON_RAMP_A, BEACON_RAMP_B, 1.8, SPIRE_TOP);
    return h;
}

// Whether a place is on one of the landmarks or their ramps (by `room` metres): nothing grows or is left there.
bool OnLandmark(float2 at, float room)
{
    if (Math.Distance(at, CHAPEL) < 13.5 + room || Math.Distance(at, SPIRE) < 14.5 + room) return true;
    if (Ditch(at, WEST_RAMP_A, WEST_RAMP_B, 3.3 + room, 0) > 0 || Ditch(at, EAST_RAMP_A, EAST_RAMP_B, 3.3 + room, 0) > 0) return true;
    if (Ditch(at, SPIRE_RAMP_A, SPIRE_RAMP_B, 3.3 + room, 0) > 0) return true;
    return false;
}

float3 On(float x, float z)
{
    return float3(x, Ground(x, z), z);
}

// How steep the ground is about a place: the most it climbs over a metre either way.
float Steepness(float x, float z)
{
    var here = Ground(x, z);
    return Math.Max(Math.Max(Math.Abs(Ground(x + 0.5, z) - here), Math.Abs(Ground(x - 0.5, z) - here)),
                    Math.Max(Math.Abs(Ground(x, z + 0.5) - here), Math.Abs(Ground(x, z - 0.5) - here))) * 2;
}

// The turn that has a piece's +z face the way `side` says: 0 north (+z), 1 east (+x), 2 south (-z), 3 west (-x).
float SideYaw(int side)
{
    return side * Math.PI * 0.5;
}

float2 SideWay(int side)
{
    if (side == 0) return float2(0, 1);
    if (side == 1) return float2(1, 0);
    if (side == 2) return float2(0, -1);
    return float2(-1, 0);
}

float3 Flat3(float2 at, float y)
{
    return float3(at.x, y, at.y);
}

void Place(mut Plan plan, Piece piece, float3 at, float yaw)
{
    plan.placements.Add(Put { piece = piece, at = at, yaw = yaw });
}

void PlaceScaled(mut Plan plan, Piece piece, float3 at, float yaw, float scale)
{
    plan.placements.Add(Put { piece = piece, at = at, yaw = yaw, scale = float3(scale) });
}

// A torch in its bracket on a wall: the bracket's plate at `at`, on the wall's face, the torch leaning out toward `side`
// (see SideYaw). Its flame burns over the torch's head.
void WallTorch(mut Plan plan, float3 at, int side)
{
    Place(plan, Piece.Torch_Metal, at, SideYaw(side));
    var way = SideWay(side);
    plan.torches.Add(at + float3(way.x * 0.27, 0.42, way.y * 0.27));
}

// A prop that stands in the way: placed, with a box round its footprint (turned with it). Its footprint is the kit
// model's as the game has it (the importer mirrors x): the middle's offset from its origin, half its size across and
// deep, and its height.
void PlaceSolid(mut Plan plan, Piece piece, float3 at, float yaw, float scale = 1)
{
    mut var foot = float4(0, 0, 0.3, 0.3);
    mut var high = 1.0;
    switch (piece)
    {
        case Piece.Stall_Cart_Empty: foot = float4(0.6, 0, 1.51, 0.53); high = 1.3; break;
        case Piece.Prop_Wagon: foot = float4(0, -1.14, 0.97, 2.0); high = 1.5; break;
        case Piece.Barrel: foot = float4(0, 0, 0.34, 0.34); high = 0.9; break;
        case Piece.Crate_Wooden: foot = float4(0, 0, 0.54, 0.58); high = 1.1; break;
        case Piece.Bench: foot = float4(0, 0, 1.39, 0.26); high = 0.53; break;
        case Piece.Anvil_Log: foot = float4(-0.06, 0.06, 0.46, 0.41); high = 1.07; break;
        case Piece.Cauldron: foot = float4(0, 0, 0.5, 0.47); high = 0.82; break;
        case Piece.Chest_Wood: foot = float4(0, 0, 0.64, 0.38); high = 0.72; break;
        case Piece.Prop_WoodenFence_Single: foot = float4(0, 0, 1.03, 0.08); high = 0.84; break;
        case Piece.Prop_WoodenFence_Extension1: foot = float4(0, 0, 1.01, 0.08); high = 0.84; break;
        case Piece.Prop_MetalFence_Ornament: foot = float4(0, 0, 0.97, 0.08); high = 2.85; break;
        case Piece.Rock_Medium_1: foot = float4(0.12, 0.35, 1.45, 1.3); high = 2.0; break;
        case Piece.Rock_Medium_2: foot = float4(0.18, 0.08, 1.4, 1.1); high = 1.8; break;
        case Piece.Rock_Medium_3: foot = float4(0.11, 0.85, 1.55, 1.6); high = 2.0; break;
    }
    foot *= scale;
    high *= scale;
    plan.placements.Add(Put { piece = piece, at = at, yaw = yaw, scale = float3(scale) });
    var c = Math.Cos(yaw);
    var s = Math.Sin(yaw);
    // The middle turned with the prop (its +x goes to (cos, -sin) on the ground), and the turned footprint's box
    var middle = at + float3(foot.x * c + foot.y * s, 0, -foot.x * s + foot.y * c);
    var half = float2(Math.Abs(c) * foot.z + Math.Abs(s) * foot.w, Math.Abs(s) * foot.z + Math.Abs(c) * foot.w);
    Block(plan, float3(middle.x - half.x, at.y, middle.z - half.y), float3(middle.x + half.x, at.y + high, middle.z + half.y));
}

// A tree in the clearing: its trunk is in the way.
void Tree(mut Plan plan, Piece piece, float3 at, float yaw, float scale = 1)
{
    PlaceScaled(plan, piece, at - float3(0, 0.25, 0), yaw, scale);
    var trunk = 0.42 * scale;
    Block(plan, at - float3(trunk, 0.25, trunk), at + float3(trunk, 4, trunk));
}

void Block(mut Plan plan, float3 lo, float3 hi)
{
    plan.solids.Add(Solid { center = (lo + hi) * 0.5, half = (hi - lo) * 0.5 });
}

void BlockFlat(mut Plan plan, float2 lo, float2 hi, float y, float high)
{
    Block(plan, float3(lo.x, y, lo.y), float3(hi.x, y + high, hi.y));
}

// The unit step from a to b along whichever axis they differ on.
float2 Toward(float2 a, float2 b)
{
    var d = b - a;
    if (Math.Abs(d.x) > Math.Abs(d.y)) return float2(d.x >= 0 ? 1.0 : -1.0, 0);
    if (Math.Abs(d.y) > 0.001) return float2(0, d.y >= 0 ? 1.0 : -1.0);
    return float2(0);
}

// What's left of a stone wall from `a` to `b` (whole 2 m segments along x or z), stone on both faces. Bits of `windows`
// make a segment a window, and bits of `fallen` leave a segment out, a gap in the ruin. It stands on `y`.
void StoneWall(mut Plan plan, float2 a, float2 b, long windows, long fallen, float y)
{
    var step = Toward(a, b);
    var count = int(Math.Round(Math.Length(b - a) / 2));
    var side = step.x != 0 ? 0 : 1;           // Its face: north for a wall along x, east for one along z
    var thick = float2(Math.Abs(step.y), Math.Abs(step.x)) * 0.32;
    mut var runStart = 0;
    for (var s = 0; s <= count; s++)
    {
        var gone = s < count && (fallen & (1L << s)) != 0;
        if (s < count && !gone)
        {
            var at = a + step * (1 + s * 2);
            var piece = (windows & (1L << s)) != 0 ? Piece.Wall_UnevenBrick_Window_Wide_Round : Piece.Wall_UnevenBrick_Straight;
            // Two pieces back to back, so both faces are stone: each one's plaster inside is hidden in the other
            var way = SideWay(side);
            Place(plan, piece, Flat3(at + way * 0.21, y), SideYaw(side));
            Place(plan, piece, Flat3(at - way * 0.21, y), SideYaw((side + 2) % 4));
            continue;
        }
        // A run of standing segments ends: its box, and a post at each end
        if (s > runStart)
        {
            var from = a + step * (runStart * 2);
            var to = a + step * (s * 2);
            BlockFlat(plan, Math.Min(from, to) - thick, Math.Max(from, to) + thick, y, STOREY);
            Place(plan, Piece.Corner_ExteriorWide_Brick, Flat3(from, y), 0);
            Place(plan, Piece.Corner_ExteriorWide_Brick, Flat3(to, y), 0);
        }
        runStart = s + 1;
    }
}

// Paving: the kit's floor tiles, 2 m square, over x0..x1 by z0..z1, and stone underfoot there.
void Pave(mut Plan plan, Piece tile, float x0, float z0, float x1, float z1, float y)
{
    for (var x = x0 + 1; x < x1; x += 2)
    {
        for (var z = z0 + 1; z < z1; z += 2)
        {
            var turn = (Math.Hash(int2(int(x * 7), int(z * 13))) & 3) * Math.PI * 0.5;
            plan.placements.Add(Put { piece = tile, at = float3(x, y, z), yaw = turn });
        }
    }
    plan.paved.Add(float4(x0, z0, x1, z1));
}

bool Paved(Plan plan, float3 at)
{
    foreach (var p in plan.paved)
        if (at.x >= p.x && at.x <= p.z && at.z >= p.y && at.z <= p.w) return true;
    return false;
}

// Whether a place is clear of every box so far, by `room` metres.
bool Clear(Plan plan, float3 at, float room)
{
    foreach (var solid in plan.solids)
    {
        if (Math.Abs(at.x - solid.center.x) < solid.half.x + room && Math.Abs(at.z - solid.center.z) < solid.half.z + room) return false;
    }
    return true;
}

// A unit number from a hash's bits.
float Unit01(int h, int shift)
{
    return ((h >> shift) & 1023) / 1023.0;
}

// Whether a place on the ground suits a tree, a stone or a riser: in the clearing, not steep (nor the middle of its
// navigation cell, ashwick.tide's), clear of every box.
bool Open(Plan plan, float3 at, float room)
{
    var cell = CellMiddle(CellOf(at));
    return InClearing(at) && InClearing(cell) && Steepness(at.x, at.z) < 0.5 && Steepness(cell.x, cell.z) < 0.5 && Clear(plan, at, room);
}

// A big stone standing on end, for cover and to know a place by.
void Standing(mut Plan plan, float2 at, float yaw, int kind, float scale)
{
    var piece = kind % 3 == 0 ? Piece.Rock_Medium_1 : kind % 3 == 1 ? Piece.Rock_Medium_2 : Piece.Rock_Medium_3;
    PlaceSolid(plan, piece, On(at.x, at.y) - float3(0, 0.2, 0), yaw, scale);
}

Plan MakePlan()
{
    mut Plan plan = Plan { };

    // ---- The camp in the middle: the fire, logs to sit on, what was carried out of the village ----
    plan.fires.Add(On(0, 0));
    PlaceSolid(plan, Piece.Bench, On(0, 2.7), 0);
    PlaceSolid(plan, Piece.Cauldron, On(2.5, 1.9), 0.4);
    Place(plan, Piece.Bag, On(-3.3, 1.5), 0.9);
    Place(plan, Piece.Bucket_Wooden_1, On(2.9, -0.9), 0);
    Place(plan, Piece.Rope_1, On(-1.9, 3.4), 0.6);
    plan.starts.Add(On(-1.6, -3.1));
    plan.starts.Add(On(1.6, -3.1));
    plan.starts.Add(On(-3.4, 0.4));
    plan.starts.Add(On(3.4, 0.4));

    // ---- North: the chapel's ruin on its rise, its walls half down, its floor still there; the ramps up from the
    // south-west and the south-east ----
    var cz = CHAPEL.y;
    Pave(plan, Piece.Floor_UnevenBrick, -6, cz - 4, 6, cz + 4, RUIN_TOP + 0.02);
    StoneWall(plan, float2(-4, cz + 4), float2(4, cz + 4), (1L << 1) | (1L << 2), 0, RUIN_TOP);
    StoneWall(plan, float2(-6, cz - 4), float2(-6, cz + 2), 0, 1L << 0, RUIN_TOP);
    StoneWall(plan, float2(6, cz - 2), float2(6, cz + 2), 1L << 0, 0, RUIN_TOP);
    WallTorch(plan, float3(-2, RUIN_TOP + 2.0, cz + 3.69), 2);
    WallTorch(plan, float3(2, RUIN_TOP + 2.0, cz + 3.69), 2);
    PlaceSolid(plan, Piece.Chest_Wood, float3(0, RUIN_TOP + 0.02, cz + 2.9), Math.PI);
    for (var i = 0; i < 9; i++)
    {
        var h = Math.Hash(int2(i, 515));
        var x = -6 + Unit01(h, 0) * 12;
        var z = cz - 6 + Unit01(h, 10) * 9;
        Place(plan, i % 2 == 0 ? Piece.Prop_Brick1 : Piece.Prop_Brick3, On(x, z) + float3(0, 0.05, 0), Unit01(h, 20) * 6);
    }

    // ---- West: the old graveyard sunk in its hollow, a brazier at its edge (its iron fences are gone: they were in the
    // way) ----
    for (var i = 0; i < 10; i++)
    {
        var h = Math.Hash(int2(i, 77));
        var x = GRAVES.x - 2 + (i % 2) * 4.4 + ((h & 7) - 3) * 0.1;
        var z = GRAVES.y - 7.5 + (i / 2) * 3.4 + ((h >> 3) & 7) * 0.05;
        plan.risers.Add(Riser { at = On(x, z), grave = true });
    }
    Tree(plan, Piece.DeadTree_1, On(GRAVES.x - 6, GRAVES.y + 9), 0.4, 0.9);
    Tree(plan, Piece.DeadTree_3, On(GRAVES.x + 5, GRAVES.y + 11), 2.1, 0.8);

    // ---- North-west: a ring of standing stones ----
    for (var i = 0; i < 7; i++)
    {
        var turn = i * Math.TAU / 7 + 0.3;
        Standing(plan, STONES + float2(Math.Cos(turn), Math.Sin(turn)) * 4.8, turn * 1.7, i, 1.15 + (i % 3) * 0.12);
    }

    // ---- East: the beacon's spire; a cart and a wagon left at its foot, the camp's second fire ----
    PlaceSolid(plan, Piece.Prop_Wagon, On(18, 11), 0.35);
    PlaceSolid(plan, Piece.Stall_Cart_Empty, On(10, -8.4), 1.2);
    plan.fires.Add(On(16, 1.4));

    // ---- The ravine's banks, boulders along them; and big stones about the clearing, to stand behind ----
    Standing(plan, float2(-25, -27), 0.3, 0, 1.4);
    Standing(plan, float2(6, -24), 2.0, 2, 1.2);
    Standing(plan, float2(28, -43), 4.1, 1, 1.5);
    Standing(plan, float2(-11, -46), 1.2, 0, 1.3);
    Standing(plan, float2(-48, -17), 2.6, 2, 1.4);
    Standing(plan, float2(50, 31), 0.5, 0, 1.6);

    // ---- Groves within the clearing: a few stands of trees, room to run between them, the ground between them open ----
    List<float2> groves = [float2(-49, 25), float2(31, 43), float2(-50, -27), float2(39, -38), float2(11, -53), float2(-3, -22)];
    for (var g = 0; g < groves.count; g++)
    {
        for (var i = 0; i < 7; i++)
        {
            var h = Math.Hash(int2(i + g * 31, 2323));
            var turn = Unit01(h, 0) * Math.TAU;
            var far = 2 + Unit01(h, 10) * 6.5;
            var at = On(groves[g].x + Math.Cos(turn) * far, groves[g].y + Math.Sin(turn) * far);
            if (!Open(plan, at, 2.6) || OnLandmark(at.xz, 1) || Ditch(at.xz, RAVINE_A, RAVINE_B, 4, 0) > 0) continue;
            var kind = (h >> 20) % 5;
            var piece = kind == 0 ? Piece.CommonTree_1 : kind == 1 ? Piece.CommonTree_3 : kind == 2 ? Piece.Pine_3 : kind == 3 ? Piece.Pine_5 : Piece.CommonTree_5;
            Tree(plan, piece, at, Unit01(h, 4) * Math.TAU, 0.95 + Unit01(h, 14) * 0.35);
        }
    }

    // ---- The dead's other way in: up through the roots at the clearing's edge ----
    for (var i = 0; i < 36; i++)
    {
        var angle = (i + 0.5) * Math.TAU / 36;
        mut var at = EdgeAt(angle, -4);
        if (!Open(plan, at, 0.8)) at = EdgeAt(angle, -6);
        if (!Open(plan, at, 0.6)) continue;
        plan.risers.Add(Riser { at = at });
    }

    // ---- The graves' mounds and stones, with a few older stones among them ----
    foreach (var riser in plan.risers)
    {
        if (!riser.grave) continue;
        var h = Math.Hash(int2(int(riser.at.x * 10), int(riser.at.z * 10)));
        plan.dressing.Add(ItemPut { item = "grave_mound", at = riser.at, yaw = Math.PI * 0.5 + ((h & 7) - 3) * 0.04 });
        var stone = (h >> 3) % 3 == 0 ? "gravestone_a" : (h >> 3) % 3 == 1 ? "gravestone_b" : "gravestone_c";
        var head = On(riser.at.x - 1.35, riser.at.z);
        plan.dressing.Add(ItemPut { item = stone, at = head, yaw = Math.PI * 0.5 + ((h >> 6) & 7) * 0.04 - 0.14, scale = GRAVESTONE_SCALE });
    }
    for (var i = 0; i < 5; i++)
    {
        var h = Math.Hash(int2(i, 911));
        var at = On(GRAVES.x - 6 + Unit01(h, 0) * 12, GRAVES.y - 10 + Unit01(h, 10) * 17);
        mut var near = false;
        foreach (var riser in plan.risers)
            if (Math.Distance(riser.at, at) < 2.2) near = true;
        if (near || !Open(plan, at, 0.5)) continue;
        var stone = (h >> 20) % 3 == 0 ? "gravestone_a" : (h >> 20) % 3 == 1 ? "gravestone_b" : "gravestone_c";
        plan.dressing.Add(ItemPut { item = stone, at = at, yaw = Math.PI * 0.5 + ((h >> 22) & 63) * 0.02 - 0.6, scale = GRAVESTONE_SCALE * (0.9 + ((h >> 28) & 3) * 0.08) });
    }

    // ---- The fires' braziers; and the five beacons, great braziers cold but on the night they're lit (nights.tide) ----
    foreach (var at in plan.fires)
    {
        plan.dressing.Add(ItemPut { item = "brazier", at = at });
        Block(plan, at - float3(0.5, 0, 0.5), at + float3(0.5, 1.4, 0.5));
    }
    for (var place = 0; place < BEACON_PLACES; place++)
    {
        var at = BeaconPlace(place);
        plan.dressing.Add(ItemPut { item = "brazier", at = at, scale = BEACON_SCALE });
        Block(plan, at - float3(0.7, 0, 0.7), at + float3(0.7, 1.4 * BEACON_SCALE, 0.7));
    }

    // ---- The forest: close round the edge, thinning into the fog ----
    for (var i = 0; i < 210; i++)
    {
        var h = Math.Hash(int2(i, 4242));
        var angle = (i + Unit01(h, 0) * 0.8) * Math.TAU / 210;
        var at = EdgeAt(angle, 1.2 + Unit01(h, 10) * 7);
        var kind = (h >> 20) % 9;
        var piece = kind == 0 ? Piece.CommonTree_1 : kind == 1 ? Piece.CommonTree_3 : kind == 2 ? Piece.CommonTree_5 : kind == 3 ? Piece.Pine_1
                  : kind == 4 ? Piece.Pine_3 : kind == 5 ? Piece.Pine_5 : kind == 6 ? Piece.DeadTree_2 : kind == 7 ? Piece.CommonTree_1 : Piece.Pine_3;
        PlaceScaled(plan, piece, at - float3(0, 0.3, 0), Unit01(h, 4) * Math.TAU, 1.0 + Unit01(h, 14) * 0.5);
    }
    for (var i = 0; i < 240; i++)
    {
        var h = Math.Hash(int2(i, 4343));
        var angle = Unit01(h, 0) * Math.TAU;
        var at = EdgeAt(angle, 9 + Unit01(h, 10) * 55);
        var kind = (h >> 20) % 6;
        var piece = kind == 0 ? Piece.CommonTree_3 : kind == 1 ? Piece.Pine_1 : kind == 2 ? Piece.Pine_5 : kind == 3 ? Piece.DeadTree_1
                  : kind == 4 ? Piece.CommonTree_5 : Piece.TwistedTree_3;
        PlaceScaled(plan, piece, at - float3(0, 0.3, 0), Unit01(h, 4) * Math.TAU, 1.1 + Unit01(h, 14) * 0.5);
    }
    // Undergrowth along the edge, a few ferns and plants, and grass and mushrooms over the clearing
    for (var i = 0; i < 110; i++)
    {
        var h = Math.Hash(int2(i, 5151));
        var angle = (i + Unit01(h, 0)) * Math.TAU / 110;
        var at = EdgeAt(angle, -0.6 + Unit01(h, 10) * 1.6);
        var kind = (h >> 20) % 4;
        if (kind == 0) PlaceScaled(plan, Piece.Fern_1, at, Unit01(h, 4) * Math.TAU, 0.22 + Unit01(h, 14) * 0.1);
        else if (kind == 1) PlaceScaled(plan, Piece.Plant_1_Big, at, Unit01(h, 4) * Math.TAU, 0.5 + Unit01(h, 14) * 0.3);
        else PlaceScaled(plan, Piece.Bush_Common, at, Unit01(h, 4) * Math.TAU, 0.9 + Unit01(h, 14) * 0.6);
    }
    // Grass in tufts round the groves and the edge, not everywhere
    for (var i = 0; i < 170; i++)
    {
        var h = Math.Hash(int2(i, 6161));
        mut var at = EdgeAt(Unit01(h, 0) * Math.TAU, -1 - Unit01(h, 10) * 6);
        if (i % 2 == 0)
        {
            var g = groves[i / 2 % groves.count];
            var turn = Unit01(h, 0) * Math.TAU;
            at = On(g.x + Math.Cos(turn) * (2 + Unit01(h, 10) * 7), g.y + Math.Sin(turn) * (2 + Unit01(h, 10) * 7));
        }
        if (Paved(plan, at) || !Clear(plan, at, 0.2) || Math.Length(at.xz) < 6 || Steepness(at.x, at.z) > 0.9 || OnLandmark(at.xz, 0)) continue;
        if ((h >> 20) % 5 == 0) PlaceScaled(plan, Piece.Mushroom_Common, at, Unit01(h, 4) * Math.TAU, 0.6 + Unit01(h, 14) * 0.5);
        else plan.placements.Add(Put { piece = Piece.Grass_Common_Tall, at = at, yaw = Unit01(h, 4) * Math.TAU, scale = float3(0.4 + Unit01(h, 14) * 0.3), tint = 0.6 });
    }
    return plan;
}
