using Rooms;

// Hazards (the owner, 2026-10-18: "the maps need some hazzard to avoid or
// have to walk around"):
//
// - The plague pits: open mass graves brimming with black blood and bones,
//   out in the open between the landmarks (plan.tide's pits). Nobody walks
//   through one: survivors and the dead alike go round (each is a low box,
//   which rounds go over).
// - The eruptions: every few seconds near one of the survivors (half the
//   time under the thickest of the dead there) the ground cracks and glows,
//   a ring round where it'll burst, and ERUPT_WARN later it bursts into fire:
//   whoever's in it is burned and thrown (unless they roll through it), and
//   the dead in it are torn apart. It burns on BLAZE_SECONDS, setting the
//   dead that walk into it alight and burning survivors who stand in it.
//   They come more often each night, and more for a party.
//
// Every number is mine, Provisional.

const float ERUPT_FIRST = 15;        // Seconds into a night before the first
const float ERUPT_REACH = 2.6;       // How wide one bursts and burns
const float ERUPT_WARN = 1.6;        // The ground glowing before it bursts
const float ERUPT_HURT = 24;         // Its burst, to a survivor in it (times the dead's Harm)
const float ERUPT_NEAR = 3;          // How far from a survivor one opens...
const float ERUPT_FAR = 12;          // ...at most
const float BLAZE_SECONDS = 8;       // Burning after
const float BLAZE_HURT = 12;         // A second, to a survivor standing in it (times Harm)
const float BLAZE_BITE = 0.5;        // How often its fire bites
const int BLAZES_MOST = 12;

component Blaze
{
    [Position] float3 at;
    float reach;
    float timer;                     // Seconds since the ground cracked: it bursts at ERUPT_WARN, and is out BLAZE_SECONDS after
    bool burst;
    float bite;                      // Seconds till its fire bites again
}

// The ground cracking where one will burst; and its bursting.
event Cracked
{
    float3 at;
}

event Erupted
{
    float3 at;
    float reach;
}

// No eruption for a while: a new night's, or a new run's.
void ResetEruptions(mut Match match)
{
    match.eruptWait = ERUPT_FIRST;
}

// Seconds between one eruption and the next: eight on the first night, a second less each night after, down to three;
// a party's come oftener (by the root of how many more of the dead they bring).
float EruptGap(Match match)
{
    return Math.Max(3, 9 - match.night) / Math.Sqrt(match.crowd);
}

// Whether a place is in (or `room` metres from) any of the fires, burning or about to burst.
bool Afire(Match match, float3 at, float room)
{
    foreach (var blaze in match.blazes)
        if (Math.Length(at.xz - blaze.xy) < blaze.z + room) return true;
    return false;
}

// Every few seconds the ground cracks near one of the survivors standing: under the thickest of the dead about them,
// or anywhere round them, on open ground, clear of the other fires.
[Stage(Tick.Rounds, 6)]
system Erupt(mut Match match, Ashwick ashwick, Herd herd, Time time, query (Survivor survivor) survivors)
{
    if (match.paused || match.phase != Phase.Fighting) return;
    match.eruptWait -= time.dt;
    if (match.eruptWait > 0) return;
    mut List<float3> near = [];
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.role != Role.None && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
    if (near.count == 0 || match.blazes.count >= BLAZES_MOST) return;
    var pick = Random.NextInt(near.count);
    var under = Random.NextFloat() < 0.5;
    var turn = Random.NextFloat(Math.TAU);
    var off = Random.NextFloat(ERUPT_NEAR + 2, ERUPT_FAR);
    var gap = Random.NextFloat(0.7, 1.3) * EruptGap(match);
    match.eruptWait = gap;
    var from = near[pick];
    mut var at = from + float3(Math.Sin(turn), 0, Math.Cos(turn)) * off;
    if (under)
    {
        var bodies = Near(herd, from, ERUPT_FAR);
        var thick = Thickest(from, bodies, ERUPT_NEAR + ERUPT_REACH, ERUPT_FAR, out var found);
        if (found) at = thick;
    }
    var cell = CellOf(at);
    if (cell < 0 || !InClearing(at) || !Open(ashwick, cell) || Afire(match, at, 1)) return;
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.life == Life.Standing && Math.Length((row.survivor.feet - at).xz) < ERUPT_NEAR) return;
    var spot = On(at.x, at.z);
    Spawn(Blaze { at = spot, reach = ERUPT_REACH });
    Send(Cracked { at = spot });
}

// Each fire, each tick: bursting at ERUPT_WARN (the survivors in it burned and thrown, the dead in it torn apart), then
// burning BLAZE_SECONDS, biting every BLAZE_BITE (the survivors standing in it burned, unless rolling; the dead in it
// set alight); and out. All of them out at dawn, and at a new run.
[Stage(Tick.Rounds, 7)]
system Burn(mut Blaze blaze, Match match, Herd herd, Time time, query (Survivor survivor) survivors)
{
    if (match.restarting || match.phase == Phase.Dawn || match.phase == Phase.Waiting)
    {
        this.Destroy();
        return;
    }
    if (match.paused || match.phase != Phase.Fighting) return;
    blaze.timer += time.dt;
    if (blaze.timer >= ERUPT_WARN + BLAZE_SECONDS)
    {
        this.Destroy();
        return;
    }
    if (blaze.timer < ERUPT_WARN) return;
    var harm = Harm(match.danger);
    if (!blaze.burst)
    {
        blaze.burst = true;
        blaze.bite = BLAZE_BITE;
        foreach (var row in survivors)
        {
            var s = row.survivor;
            if (!s.ready || s.life != Life.Standing) continue;
            if (Math.Length((s.feet - blaze.at).xz) > blaze.reach + BODY_RADIUS) continue;
            row.entity.Send(Hurt { damage = ERUPT_HURT * harm, from = blaze.at });
            if (!Guarded(s)) row.entity.Send(Shoved { velocity = Flatten(s.feet - blaze.at) * 7 + float3(0, 3, 0) });
        }
        foreach (var body in Near(herd, blaze.at, blaze.reach))
        {
            if (body.boss >= 0 || !body.hittable) continue;
            if (Math.Length((body.at - blaze.at).xz) > blaze.reach) continue;
            body.entity.Send(Wound { damage = ZombieHealth(match.danger) * 1.6, seat = -1, from = blaze.at - float3(0, 0.5, 0), knock = 5, down = true, element = Element.Fire,
                                     blow = Blow.Burst });
        }
        Send(Erupted { at = blaze.at, reach = blaze.reach });
        return;
    }
    blaze.bite -= time.dt;
    if (blaze.bite > 0) return;
    blaze.bite += BLAZE_BITE;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready || s.life != Life.Standing || Guarded(s)) continue;
        if (Math.Length((s.feet - blaze.at).xz) > blaze.reach) continue;
        row.entity.Send(Hurt { damage = BLAZE_HURT * BLAZE_BITE * harm, from = blaze.at });
    }
    foreach (var body in Near(herd, blaze.at, blaze.reach))
    {
        if (body.boss >= 0 || !body.hittable) continue;
        if (Math.Length((body.at - blaze.at).xz) > blaze.reach) continue;
        body.entity.Send(Wound { damage = 0, seat = -1, from = blaze.at, knock = -1, element = Element.Fire, blow = Blow.Burning });
    }
}

// The night's fires as the match keeps them, for what's placed round them (chests, missions, eruptions): x, z, reach,
// each tick.
[Stage(Tick.Rounds, 8)]
system KeepBlazes(mut Match match, query (Blaze blaze) blazes)
{
    match.blazes.Clear();
    foreach (var row in blazes) match.blazes.Add(float3(row.blaze.at.x, row.blaze.at.z, row.blaze.reach));
}

// ---- What's seen and heard ----

// What the ground's drawn with (look.tide's Earth): the pits, x0, z0, x1, z1; and the fires, x, z, reach, and how far
// along (below 0, the ground cracking, -1 to 0 as it nears bursting; then its heat, 1 fresh down to 0 as it goes out).
local singleton Hazards
{
    List<float4> pits;
    List<float4> fires;
}

// Each frame: the pits (once), the fires, and each fire's light.
[Stage(Layers.Prepare, 2)]
view SeeHazards(mut Hazards hazards, mut Lights lights, Village village, Me me, Look look, query (Blaze blaze) blazes)
{
    if (hazards.pits.count != village.plan.pits.count)
    {
        hazards.pits.Clear();
        foreach (var p in village.plan.pits) hazards.pits.Add(p);
    }
    hazards.fires.Clear();
    foreach (var row in blazes)
    {
        var b = row.blaze;
        var along = b.timer < ERUPT_WARN ? -(1 - b.timer / ERUPT_WARN) : 1 - Math.Saturate((b.timer - ERUPT_WARN - BLAZE_SECONDS * 0.6) / (BLAZE_SECONDS * 0.4));
        hazards.fires.Add(float4(b.at.x, b.at.z, b.reach, along));
        if (Math.Distance(b.at, me.eye) > 45) continue;
        var flicker = 0.8 + Math.Perlin(float2(look.time * 7.1 + b.at.x, b.at.z)) * 0.35;
        var glow = b.timer < ERUPT_WARN ? b.timer / ERUPT_WARN * 0.6 : along * flicker * (b.timer < ERUPT_WARN + 0.3 ? 3.0 : 1.0);
        if (glow > 0.02) AddLight(lights, me.eye, Light { at = b.at + float3(0, 1.2, 0), color = float3(1.0, 0.4, 0.1) * 5 * glow, reach = 11 });
    }
}

// The fires' flames, embers and smoke; the cracking ground's smoke and sparks.
[Stage(Layers.Gather, 4)]
view BlazeFlames(Blaze blaze, mut Fx fx, Me me)
{
    if (!fx.made || Math.Distance(blaze.at, me.eye) > 50) return;
    var dt = me.dt;
    if (blaze.timer < ERUPT_WARN)
    {
        var warn = blaze.timer / ERUPT_WARN;
        if (fx.random.NextFloat() < dt * (10 + 40 * warn))
        {
            var turn = fx.random.NextFloat(Math.TAU);
            var far = blaze.reach * Math.Sqrt(fx.random.NextFloat());
            var at = On(blaze.at.x + Math.Cos(turn) * far, blaze.at.z + Math.Sin(turn) * far);
            Murk(fx, Mote { at = at + float3(0, 0.1, 0), velocity = float3(0, fx.random.NextFloat(0.6, 1.4), 0), life = 0.9, size = 0.25, grow = 0.5, color = float3(0.12, 0.1, 0.09),
                            alpha = 0.45, drag = 1 });
            Glow(fx, Mote { at = at + float3(0, 0.05, 0), velocity = float3(fx.random.NextFloat(-0.5, 0.5), fx.random.NextFloat(1.5, 3), fx.random.NextFloat(-0.5, 0.5)), life = 0.5,
                            size = 0.035, color = float3(1.0, 0.45, 0.12), alpha = 3, gravity = 4 });
        }
        return;
    }
    var heat = 1 - Math.Saturate((blaze.timer - ERUPT_WARN - BLAZE_SECONDS * 0.6) / (BLAZE_SECONDS * 0.4));
    var flames = int(dt * 70 * heat + fx.random.NextFloat());
    for (var k = 0; k < flames; k++)
    {
        var turn = fx.random.NextFloat(Math.TAU);
        var far = blaze.reach * Math.Sqrt(fx.random.NextFloat()) * 0.95;
        var at = On(blaze.at.x + Math.Cos(turn) * far, blaze.at.z + Math.Sin(turn) * far);
        Glow(fx, Mote { at = at + float3(0, 0.05, 0), velocity = float3(0, fx.random.NextFloat(1.2, 2.6), 0), life = fx.random.NextFloat(0.35, 0.7), size = fx.random.NextFloat(0.25, 0.45),
                        grow = -0.4, color = float3(1.0, 0.45, 0.12), alpha = 1.5, cool = 1 });
    }
    if (fx.random.NextFloat() < dt * 25 * heat)
        Glow(fx, Mote { at = blaze.at + float3(fx.random.NextFloat(-1.5, 1.5), 0.3, fx.random.NextFloat(-1.5, 1.5)),
                        velocity = float3(fx.random.NextFloat(-0.6, 0.6), fx.random.NextFloat(2.5, 4), fx.random.NextFloat(-0.6, 0.6)), life = 1.6, size = 0.03,
                        color = float3(1.0, 0.6, 0.2), alpha = 4, drag = 0.4 });
    if (fx.random.NextFloat() < dt * 6)
        Murk(fx, Mote { at = blaze.at + float3(fx.random.NextFloat(-1, 1), 1.2, fx.random.NextFloat(-1, 1)), velocity = float3(0.3, 1.2, 0.1), life = 2.5, size = 0.6, grow = 0.6,
                        color = float3(0.06, 0.055, 0.05), alpha = 0.35, drag = 0.5 });
}

// A ring round where the ground will burst, red and pulsing, and another growing out from its middle to meet it as it
// comes; round a burning one, a faint ring at its edge.
[Stage(Layers.Hud, -1)]
view BlazeRings(Me me, Look look, Lobby lobby, Match match, query (Blaze blaze) blazes)
{
    if (lobby.page != Page.Playing || !me.playing || match.phase == Phase.Over) return;
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Unit();
    foreach (var row in blazes)
    {
        var b = row.blaze;
        if (Math.Length((b.at - me.ears).xz) > 30) continue;
        if (b.timer < ERUPT_WARN)
        {
            var near = Math.Saturate(b.timer / ERUPT_WARN);
            var pulse = 0.7 + 0.3 * Math.Sin(look.time * 24);
            GroundRing(look, b.at, b.reach, 3 * u, Color(1.0, 0.25, 0.08, 0.9 * pulse), w, h);
            GroundRing(look, b.at, b.reach * near, 2.5 * u, Color(1.0, 0.6, 0.15, 0.85), w, h);
            continue;
        }
        GroundRing(look, b.at, b.reach, 1.5 * u, Color(1.0, 0.5, 0.15, 0.3), w, h);
    }
}

local event(Cracked cracked) HearCracked()
{
    Audio.Play(riseClip, cracked.at, 1.0, 0.55);
}

local event(Erupted erupted) HearErupted(mut Ears ears)
{
    Audio.Play(explosions[ears.random.NextInt(explosions.count)], erupted.at, 1.0, 0.8);
    Audio.Play(fireBurst, erupted.at, 1.0, 0.7);
}

local event(Erupted erupted) FeelErupted(mut Me me)
{
    var far = Math.Distance(erupted.at, me.ears);
    me.shake = Math.Max(me.shake, Math.Saturate(1.1 - far / 16));
}

// Its burst: a flash, a column of fire and a ring of it thrown out, earth flung up, smoke.
local event(Erupted erupted) EruptedFlash(mut Fx fx)
{
    if (!fx.made) return;
    var at = erupted.at;
    fx.flashes.Add(Flash { at = at + float3(0, 1, 0), color = float3(1.0, 0.45, 0.12) * 14, reach = 12, life = 0.45 });
    for (var i = 0; i < 70; i++)
    {
        var turn = fx.random.NextFloat(Math.TAU);
        var far = erupted.reach * Math.Sqrt(fx.random.NextFloat());
        Glow(fx, Mote { at = at + float3(Math.Cos(turn) * far, 0.1, Math.Sin(turn) * far), velocity = float3(Math.Cos(turn) * 1.5, fx.random.NextFloat(3, 8), Math.Sin(turn) * 1.5),
                        life = fx.random.NextFloat(0.4, 0.9), size = fx.random.NextFloat(0.3, 0.6), grow = -0.4, color = float3(1.0, 0.5, 0.14), alpha = 1.8, cool = 1, drag = 1.5 });
    }
    for (var i = 0; i < 40; i++)
        Glow(fx, Mote { at = at + float3(0, 0.3, 0), velocity = Scatter(fx, 7) + float3(0, 5, 0), life = fx.random.NextFloat(0.8, 1.6), size = 0.04, color = float3(1.0, 0.65, 0.25),
                        alpha = 4, gravity = 9, drag = 0.5 });
    for (var i = 0; i < 30; i++)
        Murk(fx, Mote { at = at + float3(0, 0.2, 0), velocity = Scatter(fx, 5) + float3(0, 5, 0), life = fx.random.NextFloat(0.6, 1.2), size = fx.random.NextFloat(0.06, 0.12),
                        gravity = 12, color = float3(0.16, 0.12, 0.08), alpha = 1 });
    for (var i = 0; i < 8; i++)
        Murk(fx, Mote { at = at + float3(fx.random.NextFloat(-1.5, 1.5), 1, fx.random.NextFloat(-1.5, 1.5)), velocity = float3(0, 1.5, 0) + Scatter(fx, 0.8), life = 2.5,
                        size = 0.8, grow = 0.9, color = float3(0.07, 0.06, 0.055), alpha = 0.5, drag = 0.8 });
}
