using Rooms;

// Hazards (the owner, 2026-10-18: "the maps need some hazzard to avoid or
// have to walk around"):
//
// - The plague pits: open mass graves brimming with black blood and bones,
//   out in the open between the landmarks (plan.tide's pits). Nobody walks
//   through one: survivors and the dead alike go round (each is a low box,
//   which rounds go over).
// - The bramble thickets (plan.tide's brambles): a survivor wades through one
//   at half pace (hands.tide's Steer); the dead don't care.
// - Fire on the ground (Blaze): where the Engineer's napalm splashed, burning a
//   few seconds, setting the dead that walk into it alight. It doesn't burn the
//   living. (The eruptions, the ground cracking and bursting into fire near the
//   survivors every few seconds, went: the owner, 2026-10-20, "the random
//   exploding circles are out of place, we can maybe just add bushes in the map
//   that make you walk slower". Their fire is the napalm's.)
//
// Every number is mine, Provisional.

const float BLAZE_BITE = 0.5;        // How often a fire bites
const int BLAZES_MOST = 12;

component Blaze
{
    [Position] float3 at;
    float reach;
    float timer;                     // Seconds burning...
    float seconds = 4;               // ...till it's out
    float bite;                      // Seconds till its fire bites again...
    float hurt;                      // ...for so much, to each of the dead in it
    int seat = -1;                   // Whose napalm it was
}

// Whether a place is in (or `room` metres from) any of the fires, burning or about to burst.
bool Afire(Match match, float3 at, float room)
{
    foreach (var blaze in match.blazes)
        if (Math.Length(at.xz - blaze.xy) < blaze.z + room) return true;
    return false;
}

// Each fire, each tick: biting every BLAZE_BITE, the dead in it (bosses too) burned and set alight, its maker's; and out.
// All of them out at dawn, and at a new run.
[Stage(Tick.Rounds, 7)]
system Burn(mut Blaze blaze, Match match, Herd herd, Time time)
{
    if (match.restarting || match.phase == Phase.Dawn || match.phase == Phase.Waiting)
    {
        this.Destroy();
        return;
    }
    if (match.paused || match.phase != Phase.Fighting) return;
    blaze.timer += time.dt;
    if (blaze.timer >= blaze.seconds)
    {
        this.Destroy();
        return;
    }
    blaze.bite -= time.dt;
    if (blaze.bite > 0) return;
    blaze.bite += BLAZE_BITE;
    foreach (var body in Near(herd, blaze.at, blaze.reach + 1))
    {
        if (!body.hittable || Math.Length((body.at - blaze.at).xz) > blaze.reach + (body.boss >= 0 ? 1.0 : 0.0)) continue;
        body.entity.Send(Wound { damage = blaze.hurt, seat = blaze.seat, from = blaze.at, knock = -1, element = Element.Fire, blow = Blow.Burning, echo = true });
    }
}

// The fires as the match keeps them, for what's placed round them (chests, missions): x, z, reach,
// each tick.
[Stage(Tick.Rounds, 8)]
system KeepBlazes(mut Match match, query (Blaze blaze) blazes)
{
    match.blazes.Clear();
    foreach (var row in blazes) match.blazes.Add(float3(row.blaze.at.x, row.blaze.at.z, row.blaze.reach));
}

// ---- What's seen and heard ----

// What the ground's drawn with (look.tide's Earth): the pits, x0, z0, x1, z1; and the fires, x, z, reach, and its heat,
// 1 fresh down to 0 as it goes out.
const int FUSES_SEEN = 16;           // Bloaters swelling drawn on the ground at once, at most

local singleton Hazards
{
    List<float4> pits;
    List<float4> fires;
    float4 ring;                     // The wake-fire's ring (nights.tide): x, z, reach (0, none)
    List<float4> fuses;              // Bloaters swelling to burst (zombies.tide): x, z, reach, how near (0 to 1)
    float4 mission;                  // The mission's circle (missions.tide): x, z, reach (0, none), what's done of it (0 to 1)...
    float missionPieces;             // ...in how many pieces...
    float missionLate;               // ...how near its time's up (0, MISSION_HURRY or more left; 1, none)...
    float missionFill;               // ...and whether the ground inside it's lit
}

// Each frame: the pits (once), the fires, and each fire's light.
[Stage(Layers.Prepare, 2)]
view SeeHazards(mut Hazards hazards, mut Lights lights, Village village, Me me, Look look, Match match, query (Blaze blaze) blazes,
                query (Zombie zombie) zombies)
{
    hazards.mission = float4(0);
    if (match.phase == Phase.Fighting && match.mission != MissionKind.None)
    {
        var wisps = match.mission == MissionKind.Wisps;
        hazards.mission = float4(match.missionAt.x, match.missionAt.z, wisps ? WISP_FAR + 1.5 : MissionReach(match.mission),
                                 Math.Saturate(match.missionDone / Math.Max(1, match.missionGoal)));
        hazards.missionPieces = Math.Clamp(match.missionGoal, 1, 60);
        hazards.missionLate = 1 - Math.Saturate(match.missionLeft / MISSION_HURRY);
        hazards.missionFill = wisps ? 0.0 : 1.0;
    }
    hazards.fuses.Clear();
    foreach (var row in zombies)
    {
        var z = row.zombie;
        if (z.kind != ZombieKind.Bloater || z.popped || z.fuse <= 0 || hazards.fuses.count >= FUSES_SEEN) continue;
        if (Math.Distance(z.at, me.eye) > 60) continue;
        var near = Math.Saturate(z.fuse / BLOAT_FUSE);
        hazards.fuses.Add(float4(z.chestAt.x, z.chestAt.z, BLOAT_REACH, near));
        AddLight(lights, me.eye, Light { at = z.chestAt + float3(0, 0.6, 0), color = Math.Lerp(float3(0.5, 0.9, 0.1), float3(1.0, 0.25, 0.05), near) * (0.5 + 1.5 * near), reach = 5 });
    }
    hazards.ring = match.phase == Phase.Fighting && match.ringReach > 0 ? float4(match.ringAt.x, match.ringAt.z, match.ringReach, 0) : float4(0);
    if (hazards.pits.count != village.plan.pits.count)
    {
        hazards.pits.Clear();
        foreach (var p in village.plan.pits) hazards.pits.Add(p);
    }
    hazards.fires.Clear();
    foreach (var row in blazes)
    {
        var b = row.blaze;
        var along = BlazeHeat(b);
        hazards.fires.Add(float4(b.at.x, b.at.z, b.reach, along));
        if (Math.Distance(b.at, me.eye) > 45) continue;
        var flicker = 0.8 + Math.Perlin(float2(look.time * 7.1 + b.at.x, b.at.z)) * 0.35;
        var glow = along * flicker * (b.timer < 0.3 ? 3.0 : 1.0);
        if (glow > 0.02) AddLight(lights, me.eye, Light { at = b.at + float3(0, 1.2, 0), color = float3(1.0, 0.4, 0.1) * 5 * glow, reach = 11 });
    }
}

// How hot a fire still burns: 1, going out over its last 40%.
float BlazeHeat(Blaze blaze)
{
    return 1 - Math.Saturate((blaze.timer - blaze.seconds * 0.6) / (blaze.seconds * 0.4));
}

// The fires' flames, embers and smoke.
[Stage(Layers.Gather, 4)]
view BlazeFlames(Blaze blaze, mut Fx fx, Me me)
{
    if (!fx.made || Math.Distance(blaze.at, me.eye) > 50) return;
    var dt = me.dt;
    var heat = BlazeHeat(blaze);
    var flames = int(dt * 70 * heat * (blaze.reach * blaze.reach) / 6.8 + fx.random.NextFloat());
    for (var k = 0; k < flames; k++)
    {
        var turn = fx.random.NextFloat(Math.TAU);
        var far = blaze.reach * Math.Sqrt(fx.random.NextFloat()) * 0.95;
        var at = On(blaze.at.x + Math.Cos(turn) * far, blaze.at.z + Math.Sin(turn) * far);
        Glow(fx, Mote { at = at + float3(0, 0.05, 0), velocity = float3(0, fx.random.NextFloat(1.2, 2.6), 0), life = fx.random.NextFloat(0.35, 0.7), size = fx.random.NextFloat(0.25, 0.45),
                        grow = -0.4, color = float3(1.0, 0.45, 0.12), alpha = 1.5, cool = 1 });
    }
    if (fx.random.NextFloat() < dt * 25 * heat)
        Glow(fx, Mote { at = blaze.at + float3(fx.random.NextFloat(-1.5, 1.5), 0.3, fx.random.NextFloat(-1.5, 1.5)),
                        velocity = float3(fx.random.NextFloat(-0.6, 0.6), fx.random.NextFloat(2.5, 4), fx.random.NextFloat(-0.6, 0.6)), life = 1.6, size = 0.03,
                        color = float3(1.0, 0.6, 0.2), alpha = 4, drag = 0.4 });
    if (fx.random.NextFloat() < dt * 6)
        Murk(fx, Mote { at = blaze.at + float3(fx.random.NextFloat(-1, 1), 1.2, fx.random.NextFloat(-1, 1)), velocity = float3(0.3, 1.2, 0.1), life = 2.5, size = 0.6, grow = 0.6,
                        color = float3(0.06, 0.055, 0.05), alpha = 0.35, drag = 0.5 });
}

// Round a fire on the ground, a faint ring at its edge.
[Stage(Layers.Hud, -1)]
view BlazeRings(Me me, Look look, Lobby lobby, Match match, query (Blaze blaze) blazes)
{
    if (lobby.page != Page.Playing || !me.playing || match.phase == Phase.Over) return;
    Draw.SetScreen();
    var u = Unit();
    foreach (var row in blazes)
    {
        var b = row.blaze;
        if (Math.Length((b.at - me.ears).xz) > 30) continue;
        GroundRing(look, b.at, b.reach, 1.5 * u, Color(1.0, 0.5, 0.15, 0.3 * BlazeHeat(b)), Screen.width, Screen.height);
    }
}
