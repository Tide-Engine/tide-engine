using Rooms;

// What this machine hears: the night in Ashwick Wood and a low dread under
// it that rises with the waves, the bell that starts each one, the dead
// groaning where they are, feet on earth and the ruin's stones, the fires,
// every gun's shot and load, the skills, what each hit sounds like, the items
// taken, the levels, the power-ups.

[Bus]
enum Bus { Master, Effects, Music, Ambience }

asset Clip musicLow = "sfx/music_low.ogg";
asset Clip musicHigh = "sfx/music_high.ogg";
asset Clip roundEnd = "sfx/round_end.ogg";
asset Clip gameOverClip = "sfx/game_over.ogg";
asset Clip fireLoop = "sfx/fire_loop.ogg";
asset Clip heartbeatClip = "sfx/heartbeat.ogg";
asset Clip breathClip = "sfx/breath.ogg";
asset List<Clip> groans = "sfx/groan_*.ogg";
asset List<Clip> screams = "sfx/scream_*.ogg";
asset List<Clip> snarls = "sfx/snarl_*.ogg";
asset List<Clip> deaths = "sfx/death_*.ogg";
asset List<Clip> swingsLight = "sfx/swing_light_*.ogg";
asset List<Clip> swingsHeavy = "sfx/swing_heavy_*.ogg";
asset List<Clip> hitsBlunt = "sfx/hit_blunt_*.ogg";
asset List<Clip> gores = "sfx/gore_*.ogg";
asset List<Clip> headshots = "sfx/headshot_*.ogg";
asset List<Clip> fleshHits = "sfx/bullet_flesh_*.ogg";
asset List<Clip> woodHits = "sfx/arrow_hit_wood_*.ogg";
asset List<Clip> stoneHits = "sfx/arrow_hit_stone_*.ogg";
asset List<Clip> explosions = "sfx/explode_*.ogg";
asset List<Clip> stepsStone = "sfx/step_stone_*.ogg";
asset List<Clip> stepsDirt = "sfx/step_dirt_*.ogg";
asset List<Clip> hurts = "sfx/hurt_*.ogg";
asset Clip emptyClip = "sfx/empty.ogg";
asset List<Clip> rifleShots = "sfx/rifle_fire_*.ogg";
asset List<Clip> smgShots = "sfx/smg_fire_*.ogg";
asset List<Clip> shotgunShots = "sfx/shotgun_fire_*.ogg";
asset List<Clip> pistolShots = "sfx/pistol_fire_*.ogg";
asset Clip pistolReload = "sfx/pistol_reload.ogg";
asset Clip turretFire = "sfx/turret_fire.ogg";
asset Clip magReload = "sfx/mag_reload.ogg";
asset Clip shellLoad = "sfx/shell_load.ogg";
asset Clip pumpClip = "sfx/pump.ogg";
asset Clip fireBurst = "sfx/fire_burst.ogg";
asset Clip freezeClip = "sfx/freeze.ogg";
asset Clip chainZap = "sfx/chain_zap.ogg";
asset Clip throwClip = "sfx/throw.ogg";
asset Clip biteClip = "sfx/bite.ogg";
asset Clip riseClip = "sfx/rise.ogg";
asset Clip chestOpenClip = "sfx/chest_open.ogg";
asset List<Clip> orbClips = "sfx/orb_*.ogg";
asset Clip landClip = "sfx/land.ogg";
asset Clip downedClip = "sfx/downed.ogg";
asset Clip reviveClip = "sfx/revive.ogg";
asset Clip levelClip = "sfx/level_up.ogg";
asset Clip itemUncommon = "sfx/item_uncommon.ogg";
asset Clip itemRare = "sfx/item_rare.ogg";
asset Clip powerupGrab = "sfx/powerup_grab.ogg";
asset Clip hitmarkerClip = "sfx/hitmarker.ogg";

// The master's limiter: whatever piles up (a bell over two dozen groans) is held under full scale, at once, and let back
// up over a tenth of a second.
struct Squeeze
{
    float held;               // How much is taken off, 0 to 1
}

audio Limit(mut Samples samples, mut Squeeze squeeze)
{
    for (var i = 0; i < samples.values.count; i += 2)
    {
        var left = samples.values[i];
        var right = samples.values[i + 1];
        var peak = Math.Max(Math.Abs(left), Math.Abs(right));
        var want = peak > 0.86 ? 1 - 0.86 / peak : 0.0;
        if (want > squeeze.held) squeeze.held = want;
        else squeeze.held += (want - squeeze.held) * 0.0002;
        var gain = 1 - squeeze.held;
        samples.values[i] = left * gain;
        samples.values[i + 1] = right * gain;
    }
}

local singleton Ears
{
    Sound low;
    Sound high;
    Sound heart;
    Sound breath;
    Sound brazier;
    Sound torch;
    Random random;
    float stepped;            // Metres walked at this machine's last footfall
    float[4] othersStepped;
    Act lastAct;
    float lastActTime;
    float orbChime;           // When the last orb's chime was, and how far up the scale the run of them has got
    int orbStep;
    float voices;             // The dead's voices that may start now, coming back at eight a second
    float lastPoints;
}

// The bed: the night, the dread under it, the heart when it's bad.
[Stage(Layers.Hud, 30)]
view Listen(mut Ears ears, Me me, Match match, Lobby lobby, Village village, query (Survivor survivor) survivors)
{
    Audio.SetEffect(Bus.Master, Limit());
    var dt = me.dt;
    var playing = lobby.playing;
    // The dread: low through the early rounds, the high one later or when the dead are many
    var fighting = match.phase == Phase.Fighting;
    var tense = fighting && (match.danger >= 3.5 || match.alive >= 150) ? 1.0 : 0.0;
    var under = fighting ? 1.0 : 0.15;
    ears.low.clip = musicLow;
    ears.low.loop = true;
    ears.low.bus = Bus.Music;
    ears.low.volume += (under * (1 - tense) * 0.7 - ears.low.volume) * Math.Min(1, dt * 0.6);
    ears.low.playing = playing && match.phase != Phase.Over;
    ears.high.clip = musicHigh;
    ears.high.loop = true;
    ears.high.bus = Bus.Music;
    ears.high.volume += (tense * 0.6 - ears.high.volume) * Math.Min(1, dt * 0.5);
    ears.high.playing = playing && match.phase != Phase.Over && ears.high.volume > 0.01;
    // This machine's survivor: a heart when near death, breath after a sprint
    mut var mine = Survivor { };
    foreach (var row in survivors)
        if (row.survivor.seat == me.seat) mine = row.survivor;
    var low = mine.life == Life.Standing && mine.health < MaxHealth(mine) * 0.4;
    ears.heart.clip = heartbeatClip;
    ears.heart.loop = true;
    ears.heart.volume = low || mine.life == Life.Downed ? 0.8 : 0.0;
    ears.heart.playing = playing && (low || mine.life == Life.Downed);
    ears.breath.clip = breathClip;
    ears.breath.loop = true;
    ears.breath.volume = 0.5;
    ears.breath.playing = playing && mine.life == Life.Downed;
    // The nearest torch, and the nearest fire
    mut var nearest = 1000.0;
    mut var at = float3(0);
    foreach (var t in village.plan.torches)
    {
        var far = Math.Distance(t, me.eye);
        if (far < nearest)
        {
            nearest = far;
            at = t;
        }
    }
    ears.torch.clip = fireLoop;
    ears.torch.loop = true;
    ears.torch.spatial = true;
    ears.torch.position = at;
    ears.torch.volume = 0.35;
    ears.torch.bus = Bus.Ambience;
    ears.torch.playing = nearest < 12;
    mut var brazierFar = 1000.0;
    mut var brazierAt = float3(0);
    foreach (var b in village.plan.fires)
    {
        var far = Math.Distance(b, me.eye);
        if (far < brazierFar)
        {
            brazierFar = far;
            brazierAt = b + float3(0, 1.4, 0);
        }
    }
    ears.brazier.clip = fireLoop;
    ears.brazier.loop = true;
    ears.brazier.spatial = true;
    ears.brazier.position = brazierAt;
    ears.brazier.volume = 1.0;
    ears.brazier.pitch = 0.8;
    ears.brazier.bus = Bus.Ambience;
    ears.brazier.playing = brazierFar < 25;
    ears.voices = Math.Min(4, ears.voices + dt * 8);
}

// The dead's voices: a groan now and then from each, a scream from the fast ones.
[Stage(Layers.Hud, 31)]
view Groan(mut Zombie zombie, mut Ears ears, Me me)
{
    zombie.voice -= me.dt;
    if (zombie.voice > 0 || zombie.state == ZombieState.Dying) return;
    zombie.voice = ears.random.NextFloat(2.5, 6.5);
    var far = Math.Distance(zombie.at, me.eye);
    if (far > 30) return;
    var head = zombie.at + float3(0, 1.6, 0);
    // A horde would drown everything: a few voices a second at most, the nearest first come
    if (ears.voices < 1) return;
    ears.voices -= 1;
    var woman = MeshOf(zombie.look) == 1 || MeshOf(zombie.look) == 2;
    var pitch = ears.random.NextFloat(0.85, 1.12) * (woman ? 1.15 : 1.0);
    if (zombie.gait != Gait.Shamble && zombie.state == ZombieState.Hunting && ears.random.NextInt(3) == 0)
        Audio.Play(screams[ears.random.NextInt(screams.count)], head, 0.9, pitch);
    else
        Audio.Play(groans[ears.random.NextInt(groans.count)], head, 0.75, pitch);
}

// Footfalls: this machine's survivor's, and the others', on what's underfoot.
[Stage(Layers.Hud, 32)]
view Footfalls(Survivor survivor, mut Ears ears, Me me, Village village)
{
    var s = survivor;
    if (!s.ready || s.life == Life.Gone) return;
    var mine = s.seat == me.seat;
    var walked = survivor.stride;
    mut var last = mine ? ears.stepped : ears.othersStepped[s.seat];
    var speed = Math.Length(s.velocity.xz);
    var stride = speed > WALK_SPEED * 1.15 ? 2.2 : 1.7;
    if (walked < last) last = walked;
    if (walked - last < stride || !s.grounded)
    {
        if (mine) ears.stepped = last;
        else ears.othersStepped[s.seat] = last;
        return;
    }
    if (mine) ears.stepped = walked;
    else ears.othersStepped[s.seat] = walked;
    mut Clip clip = stepsDirt[ears.random.NextInt(stepsDirt.count)];
    if (Paved(village.plan, s.feet)) clip = stepsStone[ears.random.NextInt(stepsStone.count)];
    var pitch = ears.random.NextFloat(0.92, 1.08);
    if (mine) Audio.Play(clip, 0.42, pitch);
    else Audio.Play(clip, s.feet, 0.7, pitch);
}

// What this machine's own hands do that the match sends no event for: a magazine changed, a shotgun pumped.
[Stage(Layers.Hud, 33)]
view Handling(mut Ears ears, Me me, query (Survivor survivor) survivors)
{
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (s.seat != me.seat) continue;
        var info = Info(s.gun);
        if (s.act == Act.Reload && ears.lastAct != Act.Reload && !info.shells)
            Audio.Play(s.gun == Weapon.Pistol ? pistolReload : magReload, 0.8, (s.gun == Weapon.Pistol ? 1.5 : 1.4) / Math.Max(0.4, s.actLength));
        // The pump, a moment after the shot
        if (s.gun == Weapon.Shotgun && s.act == Act.Fire && s.actTime >= 0.28 && (ears.lastActTime < 0.28 || ears.lastAct != Act.Fire)) Audio.Play(pumpClip, 0.75);
        ears.lastAct = s.act;
        ears.lastActTime = s.actTime;
    }
}

// ---- What the match's events sound like ----

float VolumeFor(Me me, int seat)
{
    return seat == me.seat ? 0.85 : 0.7;
}

void PlayAt(Clip clip, float3 at, bool mine, float volume, float pitch)
{
    if (mine) Audio.Play(clip, volume, pitch);
    else Audio.Play(clip, at, volume, pitch);
}

local event(Kicked kicked) HearKick(mut Ears ears, Me me, Survivor survivor)
{
    PlayAt(swingsLight[ears.random.NextInt(swingsLight.count)], survivor.feet + float3(0, 0.8, 0), kicked.seat == me.seat, 0.55, ears.random.NextFloat(0.7, 0.8));
}

local event(Struck struck) HearStruck(mut Ears ears, Me me)
{
    var mine = struck.seat == me.seat && struck.seat >= 0;
    if (struck.blow == Blow.Burning || struck.blow == Blow.Bleeding)
    {
        if (struck.killed) Audio.Play(deaths[ears.random.NextInt(deaths.count)], struck.at, 0.8, ears.random.NextFloat(0.9, 1.1));
        return;
    }
    if (struck.blow == Blow.Shove) return;
    // A horde's worth of hits at once would be noise: the kills, the heads and this machine's own
    if (!struck.killed && !struck.head && !mine) return;
    mut Clip clip = fleshHits[ears.random.NextInt(fleshHits.count)];
    if (struck.blow == Blow.Blunt) clip = hitsBlunt[ears.random.NextInt(hitsBlunt.count)];
    if (struck.blow != Blow.Burst) Audio.Play(clip, struck.at, 0.8, ears.random.NextFloat(0.92, 1.08));
    // On the head: its own crack, every time, louder for the one that takes it off
    if (struck.head) Audio.Play(headshots[ears.random.NextInt(headshots.count)], struck.at, struck.killed ? 1.0 : 0.55, struck.killed ? 1.0 : 1.12);
    if (struck.killed) Audio.Play(gores[ears.random.NextInt(gores.count)], struck.at, struck.head ? 0.9 : 0.7, ears.random.NextFloat(0.9, 1.1));
    if (struck.killed && ears.voices >= 1)
    {
        ears.voices -= 1;
        Audio.Play(deaths[ears.random.NextInt(deaths.count)], struck.at, 0.75, ears.random.NextFloat(0.88, 1.12));
    }
    if (struck.element == Element.Frost) Audio.Play(freezeClip, struck.at, 0.6, 1.0);
    if (mine) Audio.Play(hitmarkerClip, struck.head ? 0.6 : struck.killed ? 0.5 : 0.3, struck.crit ? 1.7 : struck.head ? 1.45 : struck.killed ? 0.8 : 1.0);
}

local event(Loosed loosed) HearLoosed(mut Ears ears, Me me)
{
    var mine = loosed.seat == me.seat;
    mut Clip clip = rifleShots[ears.random.NextInt(rifleShots.count)];
    mut var volume = 1.0;
    mut var pitch = ears.random.NextFloat(0.96, 1.04);
    switch (loosed.source)
    {
        case Source.Phase:
            clip = shotgunShots[ears.random.NextInt(shotgunShots.count)];
            pitch *= 0.75;
            volume = 1;
            break;
        case Source.Turret:
            clip = turretFire;
            volume = 0.5;
            break;
        case Source.Drone:
            clip = turretFire;
            volume = 0.4;
            pitch *= 1.3;
            break;
        default:
            if (loosed.weapon == Weapon.Shotgun) clip = shotgunShots[ears.random.NextInt(shotgunShots.count)];
            else if (loosed.weapon == Weapon.Smg) clip = smgShots[ears.random.NextInt(smgShots.count)];
            else if (loosed.weapon == Weapon.Pistol) clip = pistolShots[ears.random.NextInt(pistolShots.count)];
            if (!mine) volume = 0.75;
            break;
    }
    var near = mine && loosed.source != Source.Turret;
    PlayAt(clip, loosed.at, near, volume, pitch);
}

local event(Spell spell) HearSpell(mut Ears ears)
{
    Audio.Play(chainZap, spell.to, 0.55, ears.random.NextFloat(0.9, 1.2));
}

local event(Thud thud) HearThud(mut Ears ears, Village village, Me me)
{
    if (Math.Distance(thud.at, me.eye) > 30 || ears.voices < 0.5) return;
    ears.voices -= 0.25;
    // Into the ruin's walls or floor, or the boulders south of the fire: stone; into earth and wood, not
    var stone = Paved(village.plan, thud.at) || (thud.normal.y < 0.5 && (thud.at.z > 7 || thud.at.z < -8));
    Audio.Play(stone ? stoneHits[ears.random.NextInt(stoneHits.count)] : woodHits[ears.random.NextInt(woodHits.count)], thud.at, 0.5, ears.random.NextFloat(1.1, 1.4));
}

local event(Blast blast) HearBlast(mut Ears ears)
{
    if (blast.kind == Shot.Pot || blast.kind == Shot.Keg) Audio.Play(fireBurst, blast.at, blast.kind == Shot.Keg ? 0.6 : 1.0, ears.random.NextFloat(0.9, 1.1));
    else if (blast.kind == Shot.Quake) Audio.Play(explosions[ears.random.NextInt(explosions.count)], blast.at, 1.0, 0.55);
    else Audio.Play(explosions[ears.random.NextInt(explosions.count)], blast.at, 1.0, ears.random.NextFloat(0.9, 1.1));
}

local event(Cue cue) HearCue(mut Ears ears, Me me)
{
    var near = Math.Distance(cue.at, me.eye) < 2.5;
    switch (cue.sound)
    {
        case Sfx.Rise: Audio.Play(riseClip, cue.at, 0.9, ears.random.NextFloat(0.9, 1.1)); return;
        case Sfx.Snarl: Audio.Play(snarls[ears.random.NextInt(snarls.count)], cue.at, 0.85, ears.random.NextFloat(0.85, 1.15)); return;
        case Sfx.Revive: Audio.Play(reviveClip, cue.at, 0.9, 1.0); return;
        case Sfx.Downed: PlayAt(downedClip, cue.at, near, 0.9, 1.0); return;
        case Sfx.Hurt:
            PlayAt(hurts[ears.random.NextInt(hurts.count)], cue.at, near, 0.8, ears.random.NextFloat(0.95, 1.05));
            PlayAt(biteClip, cue.at, near, 0.7, ears.random.NextFloat(0.9, 1.1));
            return;
        case Sfx.Empty: PlayAt(emptyClip, cue.at, near, 0.6, 1.0); return;
        case Sfx.Throw: PlayAt(throwClip, cue.at, near, 0.7, 1.0); return;
        case Sfx.Mine: Audio.Play(emptyClip, cue.at, 0.8, 0.7); return;
        case Sfx.Shell: PlayAt(shellLoad, cue.at, near, 0.7, ears.random.NextFloat(0.95, 1.05)); return;
        case Sfx.BossRoar: Audio.Play(screams[ears.random.NextInt(screams.count)], cue.at, 1.0, 0.42); return;
        case Sfx.BossCharge: Audio.Play(snarls[ears.random.NextInt(snarls.count)], cue.at, 1.0, 0.5); return;
        case Sfx.BossDeath:
            Audio.Play(deaths[ears.random.NextInt(deaths.count)], cue.at, 1.0, 0.45);
            Audio.Play(roundEnd, 0.9);
            return;
    }
}

// An item taken: this machine's own, a tune by its rarity.
local event(Picked picked) HearPicked(Me me)
{
    if (picked.seat != me.seat) return;
    var rarity = RarityOf(picked.item);
    if (rarity == Rarity.Common) Audio.Play(powerupGrab, 0.8);
    else Audio.Play(rarity == Rarity.Rare ? itemRare : itemUncommon, 0.85);
}

// A skill used: a slide's rush, a leap's and its landing, a blink's snap, an air jump.
local event(Unleashed used) HearUnleashed(mut Ears ears, Me me)
{
    var mine = used.seat == me.seat;
    switch (used.skill)
    {
        case Skill.None: PlayAt(swingsLight[ears.random.NextInt(swingsLight.count)], used.at, mine, 0.4, 1.4); return;
        case Skill.Leap:
            if (used.landed) Audio.Play(explosions[0], used.at, 1.0, 0.65);
            else PlayAt(swingsHeavy[ears.random.NextInt(swingsHeavy.count)], used.at, mine, 0.9, 0.8);
            return;
        case Skill.Slide: PlayAt(swingsHeavy[ears.random.NextInt(swingsHeavy.count)], used.at, mine, 0.9, 1.3); return;
        case Skill.Blink: Audio.Play(chainZap, used.to, 0.8, 1.5); return;
        case Skill.Turret: Audio.Play(pumpClip, used.at, 0.9, 0.7); return;
    }
}

local event(Chosen chosen) HearChosen(Me me)
{
    if (chosen.seat == me.seat) Audio.Play(pumpClip, 0.9);
}

local event(Levelled levelled) HearLevel()
{
    Audio.Play(levelClip, 0.6);
}

// A Brute: its roar coming up out of the ground, and its fall.
local event(BossCame came) HearBoss(mut Ears ears)
{
    Audio.Play(screams[ears.random.NextInt(screams.count)], came.at + float3(0, 4, 0), 1.0, 0.45);
}

local event(GameOver over) HearGameOver()
{
    Audio.Play(gameOverClip, 1.0);
}


local event(ChestOpened opened) HearChest()
{
    Audio.Play(chestOpenClip, opened.at, 1.0, 1.0);
}

// An orb taken by this machine's survivor: a glass chime, each in a quick run of them a step up a pentatonic scale
// (two octaves of it, then on at the top), the run starting again at the bottom after a breath; a dozen a second at most.
local event(OrbTaken taken) HearOrb(mut Ears ears, Me me, Look look)
{
    if (taken.seat != me.seat) return;
    var since = look.time - ears.orbChime;
    if (since >= 0 && since < 0.07) return;
    ears.orbStep = since >= 0 && since < 0.7 ? Math.Min(ears.orbStep + 1, 10) : 0;
    ears.orbChime = look.time;
    Audio.Play(orbClips[ears.random.NextInt(orbClips.count)], 0.32, Math.Pow(2, OrbSemitone(ears.orbStep) / 12.0));
}

// The scale an orb run climbs: C D E G A, two octaves.
float OrbSemitone(int step)
{
    switch (step % 5)
    {
        case 0: return 12.0 * (step / 5);
        case 1: return 2 + 12.0 * (step / 5);
        case 2: return 4 + 12.0 * (step / 5);
        case 3: return 7 + 12.0 * (step / 5);
    }
    return 9 + 12.0 * (step / 5);
}
