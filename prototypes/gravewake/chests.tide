using Rooms;

// Chests: each night hides CHESTS_A_NIGHT of them about the clearing as it
// falls (nights.tide), each somewhere random and open; they're there till the
// next night falls, and the ones not opened by then are gone with it. Standing
// by one for CHEST_SECONDS opens it, and every survivor picks one of three
// items, as at a level: the party's, whoever found it (the owner, 2026-10-18:
// "i want players to share chests and for them to be an option so we all play
// together for the same goals"). Nothing points to them: they're found by
// going about the clearing, a warm glint and the light on the ground round
// them in the dark. (The owner: "lets make the chests be random, but not be
// pinged; players should discover them by roaming around". A night's set in
// place of one on a timer is mine, Provisional: so looking for them is
// weighed against lighting the beacon.)

const float CHEST_SECONDS = 1.5;     // Standing by one to open it
const float CHEST_REACH = 2.5;
const float CHEST_FROM = 14;         // At least this far from every survivor when it comes
const float CHEST_APART = 16;        // ...and from the other chests
const float CHEST_BEACON = 10;       // ...and from the night's beacon

component Chest
{
    float3 at;
    int night;                       // The night it's hidden for
    float yaw;
    float pried;                     // 0 to 1: how far it's been opened; it shuts again when nobody stands by it
}

// A tick's share of opening a chest, from a survivor standing by it.
event Prying
{
    float amount;
    int by;
}

event ChestCame
{
    float3 at;
}

event ChestOpened
{
    float3 at;
    int seat;
}

// The night's chests, one a tick as it falls, each somewhere open in the clearing: flat ground (not a cliff, a wall or
// a box) with open ground round it, away from the survivors, the other chests and the beacon. (A tick with no room
// found tries again the next.)
[Stage(Tick.Rounds, 2)]
system ChestComing(mut Match match, Ashwick ashwick, query (Survivor survivor) survivors, query (Chest chest) chests)
{
    if (match.paused || match.phase != Phase.Fighting || match.chestsDue <= 0) return;
    for (var tries = 0; tries < 40; tries++)
    {
        var x = Random.NextFloat(-52, 52);
        var z = Random.NextFloat(-52, 52);
        var there = On(x, z);
        var cell = CellOf(there);
        if (cell < 0 || !InClearing(there) || !Open(ashwick, cell)) continue;
        mut var room = Math.Length((match.beaconAt - there).xz) >= CHEST_BEACON;
        for (var dz = -1; dz <= 1; dz++)
            for (var dx = -1; dx <= 1; dx++)
                if (!Open(ashwick, cell + dz * NAV_W + dx)) room = false;
        foreach (var row in survivors)
            if (row.survivor.ready && Math.Length((row.survivor.feet - there).xz) < CHEST_FROM) room = false;
        foreach (var row in chests)
            if (row.chest.night == match.night && Math.Length((row.chest.at - there).xz) < CHEST_APART) room = false;
        if (!room) continue;
        var yaw = Random.NextFloat(Math.TAU);
        Spawn(Chest { at = there, yaw = yaw, night = match.night });
        match.chestsDue -= 1;
        match.chestsPlaced += 1;
        Send(ChestCame { at = there });
        return;
    }
}

// Standing by a chest (and not by a friend who's down) pries it open.
[Stage(Tick.Hands, 1)]
system PryChest(Survivor survivor, Match match, Time time, query (Chest chest) chests)
{
    if (match.paused || match.phase == Phase.Over || !survivor.ready || survivor.life != Life.Standing || survivor.role == Role.None || survivor.aimed >= 0) return;
    mut Entity best = default;
    mut var nearest = CHEST_REACH;
    foreach (var row in chests)
    {
        var far = Math.Length((row.chest.at - survivor.feet).xz);
        if (far >= nearest) continue;
        nearest = far;
        best = row.entity;
    }
    // Twice the tick's share: ChestShut takes one back every tick
    if (best != default) best.Send(Prying { amount = time.dt / CHEST_SECONDS * 2, by = survivor.seat });
}

// Shutting again while nobody pries it; gone when its night is (the next has fallen).
[Stage(Tick.Late)]
system ChestShut(mut Chest chest, Match match, Time time)
{
    if (chest.night != match.night && match.phase != Phase.Over)
    {
        this.Destroy();
        return;
    }
    if (match.paused) return;
    chest.pried = Math.Max(0, chest.pried - time.dt / CHEST_SECONDS);
}

// Open: every survivor picks an item, and it's gone.
event(Prying prying) Pry(mut Chest chest, Party party)
{
    if (chest.pried >= 1) return;
    chest.pried += prying.amount;
    if (chest.pried < 1) return;
    for (var seat = 0; seat < 4; seat++)
        if (party.taken[seat]) party.survivors[seat].Send(Owed { picks = 1 });
    Send(ChestOpened { at = chest.at, seat = prying.by });
    this.Destroy();
}

[Stage(Tick.Restart)]
system ClearChest(with Chest, Match match)
{
    if (match.restarting) this.Destroy();
}

// ---- What's seen and heard ----

// The kit's wooden chest, bright with what's in it, shaking as it's pried.
[Stage(Layers.Scene, 5)]
view DrawChest(Chest chest, Lens lens, Kit kit, Look look)
{
    if (!lens.made || !kit.made) return;
    var shake = chest.pried > 0 ? Math.Sin(look.time * 60) * 0.05 * chest.pried : 0.0;
    var pulse = 1.5 + Math.Sin(look.time * 3) * 0.3;
    List<Placed> one = [Placed { transform = float4x4.TRS(chest.at, quaternion.AxisAngle(float3(0, 1, 0), chest.yaw + shake), float3(1.2)), tint = pulse }];
    var list = kit.partsOf[int(Piece.Chest_Wood)];
    for (var k = 0; k < list.count; k++)
    {
        var i = list[k];
        lens.scene.Instanced(parts[i], one, TextureOf(kit.info[i].tex), Wobble, KitLit);
    }
}

// Its light on the ground round it, warm gold.
[Stage(Layers.Gather, 3)]
view ChestLights(mut Lights lights, Me me, Look look, query (Chest chest) chests)
{
    foreach (var row in chests)
    {
        var flicker = 0.9 + Math.Sin(look.time * 3 + row.chest.yaw) * 0.1;
        AddLight(lights, me.eye, Light { at = row.chest.at + float3(0, 1.0, 0), color = float3(1.0, 0.75, 0.3) * 1.4 * flicker, reach = 5 });
    }
}

// Now and then a glint off its lid: seen close, not across the clearing.
[Stage(Layers.Gather, 2)]
view ChestGlints(Chest chest, mut Fx fx, Me me)
{
    if (!fx.made || fx.random.NextFloat() > me.dt * 3) return;
    Glow(fx, Mote { at = chest.at + float3(fx.random.NextFloat(-0.35, 0.35), 0.7, fx.random.NextFloat(-0.35, 0.35)), velocity = float3(0, 0.3, 0),
                    life = fx.random.NextFloat(0.5, 0.9), size = 0.03, color = float3(1.0, 0.8, 0.35), alpha = 3, drag = 0.5 });
}

local event(ChestOpened opened) ShowChest(mut Feed feed)
{
    feed.banner = "A CHEST: EVERYONE PICKS AN ITEM";
    feed.bannerLeft = 2.4;
    feed.bannerColor = GOLD;
}

local event(ChestOpened opened) ChestBurst(mut Fx fx)
{
    fx.flashes.Add(Flash { at = opened.at + float3(0, 1, 0), color = float3(1.0, 0.8, 0.4) * 8, reach = 9, life = 0.5 });
    for (var i = 0; i < 40; i++)
        Glow(fx, Mote { at = opened.at + float3(0, 0.6, 0), velocity = Scatter(fx, 4) + float3(0, 3, 0), life = fx.random.NextFloat(0.6, 1.2), size = 0.05,
                        color = float3(1.0, 0.8, 0.35), alpha = 4, gravity = 6, drag = 1 });
}

// By a chest: standing by it opens it. (Nothing marks where they are.)
[Stage(Layers.Hud, 1)]
view ChestMarks(Me me, Lobby lobby, Match match, query (Survivor survivor) survivors, query (Chest chest) chests)
{
    if (lobby.page != Page.Playing || match.phase == Phase.Over) return;
    mut var mine = Survivor { };
    mut var found = false;
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found || mine.role == Role.None || mine.choosing || match.paused) return;
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Unit();
    mut var near = -1.0;
    foreach (var row in chests)
    {
        var c = row.chest;
        var far = Math.Length((c.at - mine.feet).xz);
        if (far < CHEST_REACH && (near < 0 || c.pried > near)) near = c.pried;
    }
    if (near >= 0 && mine.life == Life.Standing && mine.aimed < 0)
    {
        var y = h * 0.74;
        WriteBold("Stay by the chest to open it: everyone picks an item", float2(w * 0.5, y), 18 * u, Color(1.0, 0.85, 0.5), Anchor.MiddleCenter);
        Draw.Rect(float2(w * 0.5, y + 22 * u), float2(200 * u, 5 * u), Color(0, 0, 0, 0.6));
        if (near > 0) Draw.Rect(float2(w * 0.5 - 100 * u + 100 * u * Math.Saturate(near), y + 22 * u), float2(200 * u * Math.Saturate(near), 5 * u), Color(1.0, 0.8, 0.35));
    }
}



