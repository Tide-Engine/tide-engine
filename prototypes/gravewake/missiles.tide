// What's thrown, laid and called down (rounds are rays, hands.tide's Shoot):
// frag grenades, which burst on the dead or after a moment; firebombs, which
// burst into flame where they land; mines, which wait for the dead to come
// near; the Mortar Beacon's shells. Each tick one moves, drops, and meets the
// dead before the walls.

// What a missile is. A Keg and a Quake are none: a Powder Keg's burst and a Brute's slam, for what's seen and heard.
enum Shot { Grenade, Pot, Mine, Shell, Keg, Quake }

component Missile
{
    Shot kind;
    float3 at;
    float3 velocity;
    float gravity;
    float damage;
    Element element;
    float splash;                // Bursts this wide, metres
    int seat = -1;
    float life;                  // Seconds left
    float age;
    bool echo;                  // Set off by an item: what it kills sets off nothing more
}

// A burst: fire, a grenade's, a mine's, a shell's.
event Blast
{
    float3 at;
    float reach;
    Element element;
    Shot kind;
}

// A round, a grenade or a shell meeting a wall or the ground.
event Thud
{
    float3 at;
    float3 normal;
}

const float HEAD_RADIUS = 0.26;
const float MINE_ARMS = 0.6;         // Seconds after it's laid
const float MINE_REACH = 1.8;        // How near the dead come to set it off

// Where a segment first comes within `radius` of a point, as a fraction of it (2 for never).
float SphereHit(float3 from, float3 to, float3 middle, float radius)
{
    var way = to - from;
    var a = Math.Dot(way, way);
    if (a < 0.0000001) return 2;
    var off = from - middle;
    var b = Math.Dot(off, way);
    var c = Math.Dot(off, off) - radius * radius;
    if (c <= 0) return 0;
    var d = b * b - a * c;
    if (d < 0) return 2;
    var t = (-b - Math.Sqrt(d)) / a;
    return t >= 0 && t <= 1 ? t : 2;
}

[Stage(Tick.Missiles)]
system Fly(mut Missile missile, Ashwick ashwick, Herd herd, Time time)
{
    var dt = time.dt;
    missile.age += dt;
    missile.life -= dt;
    if (missile.kind == Shot.Mine)
    {
        // Waiting: the first of the dead near enough sets it off
        if (missile.age < MINE_ARMS) return;
        mut var near = missile.life <= 0;
        if (!near)
        {
            foreach (var z in Near(herd, missile.at, MINE_REACH))
                if (z.hittable && z.risen > 0.5 && Math.Distance(z.at, missile.at) < MINE_REACH) near = true;
        }
        if (near)
        {
            Burst(missile, missile.at + float3(0, 0.3, 0), Near(herd, missile.at, missile.splash + 1));
            this.Destroy();
        }
        return;
    }
    if (missile.life <= 0)
    {
        // A grenade's fuse run out where it lies; anything else gone
        if (missile.kind == Shot.Grenade) Burst(missile, missile.at, Near(herd, missile.at, missile.splash + 1));
        this.Destroy();
        return;
    }
    var from = missile.at;
    missile.velocity.y -= missile.gravity * dt;
    var to = from + missile.velocity * dt;
    var wall = RayHit(ashwick, from, to, out var normal);
    // The dead on the way: a grenade or a firebomb bursts on the first
    if (missile.kind != Shot.Shell)
    {
        foreach (var z in Near(herd, from, Math.Length(to - from) + 1.5))
        {
            if (!z.hittable) continue;
            var first = Math.Min(SphereHit(from, to, z.head, (HEAD_RADIUS + 0.1) * z.size), Math.Min(SphereHit(from, to, z.chest, 0.45 * z.size), SphereHit(from, to, z.hips, 0.4 * z.size)));
            if (first > 1 || first > wall) continue;
            var where = Math.Lerp(from, to, first);
            Burst(missile, where, Near(herd, where, missile.splash + 1));
            this.Destroy();
            return;
        }
    }
    if (wall <= 1)
    {
        var where = Math.Lerp(from, to, wall);
        if (missile.kind != Shot.Grenade)
        {
            Burst(missile, where, Near(herd, where, missile.splash + 1));
            this.Destroy();
            return;
        }
        // A grenade bounces, losing most of its speed, and rests on the ground till its fuse is out
        Send(Thud { at = where, normal = normal });
        var into = Math.Dot(missile.velocity, normal);
        missile.velocity = (missile.velocity - normal * into * 1.4) * 0.45;
        missile.at = where + normal * 0.05;
        if (Math.Length(missile.velocity) < 1.5 && normal.y > 0.5)
        {
            // At rest
            missile.velocity = float3(0);
            missile.gravity = 0;
        }
        return;
    }
    missile.at = to;
}

// A burst: everything near enough is wounded, the nearer the more, and thrown back.
void Burst(Missile missile, float3 at, List<Body> bodies)
{
    foreach (var z in bodies)
    {
        if (!z.hittable) continue;
        var far = Math.Distance(z.at + float3(0, 1, 0), at);
        if (far > missile.splash) continue;
        var share = Math.Sqrt(1 - far / missile.splash);
        z.entity.Send(Wound { damage = missile.damage * (0.4 + 0.6 * share), seat = missile.seat, element = missile.element, from = at, knock = 7 * share,
                              down = share > 0.5 && missile.element == Element.Blast, blow = Blow.Burst, echo = missile.echo });
    }
    Send(Blast { at = at, reach = missile.splash, element = missile.element, kind = missile.kind });
}
