// Where this machine looks from, and what it gathers for the frame: the
// clearing's pieces once, the ones near enough each frame, and the lamps:
// the torches on the ruin, the fires, the dead that burn and fireballs.
using Rooms;

// Which survivor this machine plays, and how its eye moves.
local singleton Me
{
    int seat = -1;
    float3 eye;
    quaternion turn = quaternion.identity;
    float yaw;
    float pitch;
    float dt;
    float clock;
    float bob;
    float settle;               // The eye's height, catching up with a step or a landing
    float dip;                  // A landing's dip
    float kick;                 // Recoil, radians up
    float shake;                // A blast's or a blow's, 0 to 1
    float hurt;                 // The red of a fresh blow
    bool wasGrounded = true;
    float3 last;                // Last frame's feet, for footfalls
    int overhead;               // Development: 1 looks down on the whole clearing (F9), 2 from over the trees
    bool outside;               // This frame's eye isn't the survivor's own: it's over the shoulder or above (Feel.view)...
    bool above;                 // ...above
    float fov = 74;             // The eye's breadth, eased: wider at a run and in a dash
    // From above (Pointing): the cursor on the screen (from the top left; x below 0 for none yet), what it's on (the
    // input's aim), whether that's one of the dead, and the right stick's way from the survivor, while it has the aim
    float2 cursor = float2(-1, -1);
    float3 pointed;
    bool onBody;
    bool pad;
    float3 padWay = float3(0, 0, 1);
}

local singleton Village
{
    Plan plan;
    bool made;
}

[Stage(Layers.Prepare, -2)]
view Forget(mut Me me)
{
    me.seat = -1;
}

[Stage(Layers.Prepare, -1)]
view Mine(Survivor survivor, mut Me me, with ownership)
{
    me.seat = survivor.seat;
}

// The eye: this machine's survivor's, or a slow circle round the fire behind the title.
[Stage(Layers.Prepare)]
view Prepare(mut Me me, mut Lens lens, mut Look look, mut Lights lights, mut Kit kit, mut Shapes shapes, mut Village village, Match match,
             Lobby lobby, Devices devices, mut Feel feel, query (Survivor survivor) survivors, query (Zombie zombie) zombies, query (Missile missile) missiles)
{
    if (!village.made)
    {
        village.plan = MakePlan();
        village.made = true;
    }
    if (!kit.made)
    {
        LoadKit(kit);
        PlaceKit(kit, village.plan);
        kit.made = true;
    }
    if (!shapes.made) MakeShapes(shapes);
    me.dt = Math.Min(Frame.dt, 0.05);
    me.clock += me.dt;
    if (me.clock > 3600) me.clock -= 3600;
    Focus(lens, look);
    NightLook(look, match, me.dt);

    // Whose eyes
    var seat = me.seat;
    mut var found = false;
    mut var mine = Survivor { };
    foreach (var row in survivors)
    {
        if (row.survivor.seat != seat) continue;
        mine = row.survivor;
        found = true;
    }
    var playing = lobby.playing && found && mine.ready;
    // Bled out: watching a friend still standing, over their shoulder, till the beacon calls them back
    mut var watching = false;
    if (playing && mine.life == Life.Gone)
    {
        foreach (var row in survivors)
        {
            if (watching || !row.survivor.ready || row.survivor.life != Life.Standing) continue;
            mine = row.survivor;
            watching = true;
        }
    }
    me.kick = Math.Max(0, me.kick - me.dt * 4);
    me.shake = Math.Max(0, me.shake - me.dt * 2.5);
    me.hurt = Math.Max(0, me.hurt - me.dt * 0.9);
    mut var eye = float3(0);
    if (playing)
    {
        var moving = Math.Length(mine.velocity.xz);
        if (mine.grounded && moving > 0.5) me.bob += me.dt * moving * 1.9;
        var bob = Math.Sin(me.bob) * 0.035 * Math.Saturate(moving / 4);
        if (mine.grounded && !me.wasGrounded) me.dip = 0.12;
        me.wasGrounded = mine.grounded;
        me.dip = Math.Max(0, me.dip - me.dt * 0.6);
        var height = EyeHeight(mine);
        me.settle += (mine.feet.y + height - me.settle) * Math.Min(1, me.dt * (mine.life == Life.Downed ? 4.0 : 18.0));
        if (Math.Abs(mine.feet.y + height - me.settle) > 1.2 || mine.placed) me.settle = mine.feet.y + height;
        eye = float3(mine.feet.x, me.settle + bob - me.dip, mine.feet.z);
        var wobble = me.shake * 0.04;
        var shakeYaw = (Math.Perlin(float2(me.clock * 23, 1.7)) * wobble);
        var shakePitch = (Math.Perlin(float2(me.clock * 21, 7.1)) * wobble);
        me.yaw = mine.yaw + shakeYaw;
        me.pitch = mine.pitch + me.kick + shakePitch;
        var roll = mine.life == Life.Downed ? 0.25 : Math.Sin(me.bob * 0.5) * 0.004 * Math.Saturate(moving / 4);
        me.turn = Math.Mul(quaternion.Euler(-me.pitch, me.yaw, 0), quaternion.AxisAngle(float3(0, 0, 1), roll));
        if (feel.view == View.Above)
        {
            // From above: high behind them to the south, looking down on them, north up the screen
            var feet = float3(mine.feet.x, me.settle - height, mine.feet.z);
            var up = TOP_HIGH * feel.zoom;
            var back = TOP_BACK * feel.zoom;
            eye = feet + float3(shakeYaw * 4, up + shakePitch * 4, 0) - Flat(TOP_YAW) * back;
            me.yaw = TOP_YAW;
            me.pitch = -Math.Atan2(up - 1, back);
            me.turn = quaternion.Euler(-me.pitch, me.yaw, 0);
        }
        // From over the shoulder: behind the head, up a little, out to the right, pulled in where the ground's in the way
        else if (feel.view == View.Shoulder || watching) eye = ShoulderFrom(eye, me.yaw, me.pitch);
        look.downed = mine.life == Life.Downed ? 1.0 : 0.0;
        var low = 1 - Math.Saturate(mine.health / MaxHealth(mine));
        look.hurt = Math.Max(me.hurt, mine.life == Life.Standing ? low * low * 0.9 : 0.6);
        // Wider running, and wider again in a dash: the speed felt
        var pace = Math.Length(mine.velocity.xz);
        var wide = 74 + 4 * Math.Saturate((pace - WALK_SPEED) / (SPRINT_SPEED - WALK_SPEED)) + 9 * Math.Saturate((pace - SPRINT_SPEED) / (DASH_SPEED - SPRINT_SPEED));
        me.fov += (wide - me.fov) * Math.Min(1, me.dt * (wide > me.fov ? 18 : 6));
        look.fov = feel.view == View.Above ? TOP_FOV : me.fov;
    }
    else
    {
        // Behind the title: a slow drift round the fire, looking past it into the trees
        var drift = me.clock * 0.035;
        eye = float3(Math.Sin(drift) * 6.5, 2.2 + Math.Sin(me.clock * 0.13) * 0.3, Math.Cos(drift) * 6.5);
        me.yaw = YawTo(eye, float3(0)) + 0.35 + Math.Sin(me.clock * 0.07) * 0.15;
        me.pitch = -0.02;
        me.turn = quaternion.Euler(-me.pitch, me.yaw, 0);
        look.downed = 0;
        look.hurt = 0;
        look.fov = 70;
    }
    if (devices.keyboard.f9.down) me.overhead = (me.overhead + 1) % 3;
    if (lobby.playing && (devices.keyboard.v.down || devices.gamepad.rightStickButton.down))
        feel.view = feel.view == View.Shoulder ? View.Above : feel.view == View.Above ? View.Eyes : View.Shoulder;
    // From above, the wheel brings the camera in or takes it further off
    if (lobby.playing && feel.view == View.Above && devices.mouse.scroll.y != 0)
        feel.zoom = Math.Clamp(feel.zoom * (1 - Math.Clamp(devices.mouse.scroll.y, -1, 1) * 0.1), TOP_ZOOM_LEAST, TOP_ZOOM_MOST);
    if (me.overhead == 1)
    {
        eye = float3(0, 98, 0);
        me.turn = quaternion.Euler(Math.PI * 0.5, 0, 0);
        look.fov = 62;
    }
    else if (me.overhead == 2)
    {
        eye = float3(36, 42, -36);
        me.turn = quaternion.Euler(0.68, -0.785, 0);
        look.fov = 62;
    }
    me.eye = eye;
    me.outside = playing && (feel.view != View.Eyes || watching) && me.overhead == 0;
    me.above = me.outside && feel.view == View.Above;
    look.eye = eye;
    look.time = me.clock;
    look.fade = match.phase == Phase.Over ? Math.Saturate(match.timer * 0.25) * 0.55 : 0.0;
    lens.scene.SetCamera(float4x4.TRS(eye, me.turn, float3(1)), float4x4.PerspectiveFov(Math.Radians(look.fov), lens.size.x / Math.Max(1, lens.size.y), NEAR, FAR));
    lens.hands.SetCamera(float4x4.TRS(eye, me.turn, float3(1)), float4x4.PerspectiveFov(Math.Radians(look.fov), lens.size.x / Math.Max(1, lens.size.y), NEAR, FAR));
    look.toClip = lens.scene.WorldToClip();
    AimMoon(lens, look);
    CullKit(kit, eye);
    // From above, the ears are the survivor's, turned as the screen is
    if (me.above) Audio.SetListener(EyeOf(mine), quaternion.Euler(0, TOP_YAW, 0));
    else Audio.SetListener(eye, me.turn);
    Audio.SetFalloff(2, 40);

    // The lamps: nearest first, a few dozen at most
    lights.list.Clear();
    var plan = village.plan;
    foreach (var at in plan.torches)
    {
        var flicker = 0.8 + Math.Perlin(float2(me.clock * 6.1 + at.x, at.z)) * 0.3;
        AddLight(lights, eye, Light { at = at, color = float3(1.0, 0.5, 0.18) * 3.2 * flicker, reach = 10 });
    }
    foreach (var at in plan.fires)
    {
        var flicker = 0.85 + Math.Perlin(float2(me.clock * 4.3 + at.x, at.z)) * 0.25;
        AddLight(lights, eye, Light { at = at + float3(0, 1.8, 0), color = float3(1.0, 0.42, 0.14) * 4.2 * flicker, reach = 18 });
    }
    foreach (var row in zombies)
    {
        if (row.zombie.burn <= 0 || row.zombie.state == ZombieState.Dying) continue;
        AddLight(lights, eye, Light { at = row.zombie.at + float3(0, 1.2, 0), color = float3(1.0, 0.45, 0.1) * 2.5, reach = 6 });
    }
    foreach (var row in missiles)
    {
        if (row.missile.kind != Shot.Pot) continue;
        AddLight(lights, eye, Light { at = row.missile.at, color = float3(1.0, 0.5, 0.15) * 3, reach = 7 });
    }
}

// From above: how high over the survivor the camera is and how far behind (times Feel.zoom, between the two), and how
// wide it sees.
const float TOP_HIGH = 11.5;
const float TOP_BACK = 7;
const float TOP_FOV = 52;
const float TOP_ZOOM_LEAST = 0.6;
const float TOP_ZOOM_MOST = 1.6;
const float CURSOR_SPEED = 1;       // Screen pixels a pixel of the mouse's moves the cursor from above
const float PAD_REACH = 9;          // From above, how far off a survivor the right stick aims
const float POINT_FAR = 150;        // How far the cursor's line is followed

// From above, what the cursor's on: the mouse moves the cursor (the lock holds the real one); the right stick, once
// it's moved, aims its way from the survivor instead, till the mouse moves. On one of the dead, the aim is its chest,
// or its weak spot when the cursor's on that (a round from the gun then goes into it, as one from over the shoulder
// does: from above, every cursor on the dead would otherwise be on a head); else where the line crosses the gun's
// height, so the shots go level and pass under the cursor. Its input sends it (Hands.aim). Not from above, where the look goes, so a turn to
// above starts there.
[Stage(Layers.Prepare, 1)]
view Pointing(mut Me me, Look look, Devices devices, Ashwick ashwick, Herd herd, query (Survivor survivor) survivors)
{
    mut var mine = Survivor { };
    mut var found = false;
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found) return;
    if (!me.above)
    {
        me.cursor = float2(-1, -1);
        me.pointed = mine.feet + Flat(mine.yaw) * 10 + float3(0, GUN_UP, 0);
        return;
    }
    var w = Screen.width;
    var h = Screen.height;
    if (me.cursor.x < 0)
    {
        // Where the look was, on the screen
        float4 was = Math.Mul(look.toClip, float4(me.pointed, 1));
        me.cursor = was.w > 0.01 ? float2((was.x / was.w * 0.5 + 0.5) * w, (0.5 - was.y / was.w * 0.5) * h) : float2(w * 0.5, h * 0.35);
    }
    var mouse = devices.mouse.delta;
    if (Cursor.locked && Math.Length(mouse) > 0)
    {
        me.cursor += float2(mouse.x, -mouse.y) * CURSOR_SPEED;
        me.pad = false;
    }
    me.cursor = Math.Clamp(me.cursor, float2(0), float2(w, h));
    var stick = devices.gamepad.rightStick;
    if (Math.Length(stick) > 0.3)
    {
        me.padWay = Math.Normalize(Flat(TOP_YAW) * stick.y + Flat(TOP_YAW + Math.PI * 0.5) * stick.x);
        me.pad = true;
    }
    if (me.pad)
    {
        var ahead = mine.feet + me.padWay * PAD_REACH;
        me.pointed = On(ahead.x, ahead.z) + float3(0, GUN_UP, 0);
        me.onBody = false;
        float4 clip = Math.Mul(look.toClip, float4(me.pointed, 1));
        if (clip.w > 0.01) me.cursor = float2((clip.x / clip.w * 0.5 + 0.5) * w, (0.5 - clip.y / clip.w * 0.5) * h);
        return;
    }
    // The line from the eye through the cursor
    var tall = Math.Tan(Math.Radians(look.fov) * 0.5);
    var across = float2(me.cursor.x / Math.Max(1, w) * 2 - 1, 1 - me.cursor.y / Math.Max(1, h) * 2);
    var way = Math.Normalize(Math.Rotate(me.turn, float3(across.x * tall * w / Math.Max(1, h), across.y * tall, 1)));
    var to = me.eye + way * POINT_FAR;
    var ground = LongRay(ashwick, me.eye, to, out _);
    var body = BodyFirst(me.eye, to, herd, out var who);
    if (body <= 1 && body < ground)
    {
        var at = Math.Lerp(me.eye, to, body);
        var spots = SpotsOf(who, herd);
        me.pointed = spots.weakRadius > 0 && Math.Length(at - spots.weak) <= spots.weakRadius * WEAK_PATCH ? spots.weak : who.chest;
        me.onBody = true;
        return;
    }
    // Else where the line crosses the gun's height (so a level shot passes under the cursor), or, where the ground rises
    // into the line before that, the gun's height above where it meets the ground
    var height = mine.feet.y + GUN_UP;
    var level = way.y < -0.01 ? (height - me.eye.y) / (way.y * POINT_FAR) : 2.0;
    me.pointed = level >= 0 && level <= Math.Min(1, ground) ? Math.Lerp(me.eye, to, level) : Math.Lerp(me.eye, to, Math.Min(1, ground)) + float3(0, GUN_UP, 0);
    me.onBody = false;
}

const int LIGHTS_MOST = 28;

// A lamp, if it's among the nearest to the eye that can light what's seen.
void AddLight(mut Lights lights, float3 eye, Light light)
{
    var far = Math.Distance(light.at, eye) - light.reach;
    if (far > 30) return;
    if (lights.list.count < LIGHTS_MOST)
    {
        lights.list.Add(light);
        return;
    }
    // Full: in place of the farthest, if this is nearer
    mut var worst = 0;
    mut var worstFar = -1000.0;
    for (var i = 0; i < lights.list.count; i++)
    {
        var f = Math.Distance(lights.list[i].at, eye) - lights.list[i].reach;
        if (f > worstFar)
        {
            worstFar = f;
            worst = i;
        }
    }
    if (far < worstFar) lights.list[worst] = light;
}

// Kicks to the eye from what happens: a blow taken, a blast near, a shot.
local event(Hurt hurt) FeelHurt(mut Me me, Survivor survivor)
{
    if (survivor.seat != me.seat) return;
    me.hurt = 1;
    me.shake = Math.Max(me.shake, 0.6);
}

// A dash going through the dead: a jolt for the one who made it, harder the more it struck.
local event(Barged barged) FeelBarged(mut Me me)
{
    if (barged.seat != me.seat) return;
    me.shake = Math.Max(me.shake, Math.Min(0.55, 0.22 + 0.08 * barged.count));
}

local event(Blast blast) FeelBlast(mut Me me)
{
    if (blast.kind == Shot.Pop || blast.kind == Shot.Spit) return;
    var far = Math.Distance(blast.at, me.eye);
    me.shake = Math.Max(me.shake, Math.Saturate(1.2 - far / 14));
}

local event(Loosed loosed) FeelLoosed(mut Me me)
{
    if (loosed.seat != me.seat || loosed.source == Source.Turret || loosed.source == Source.Drone) return;
    me.kick += loosed.source == Source.Phase ? 0.05 : Info(loosed.weapon).kick;
    if (loosed.weapon == Weapon.Shotgun || loosed.source == Source.Phase) me.shake = Math.Max(me.shake, loosed.weapon == Weapon.Shotgun ? 0.5 : 0.3);
}
