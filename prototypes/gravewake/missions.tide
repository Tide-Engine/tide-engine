using Rooms;

// Missions: optional, on a timer, one at a time while a night's bosses are
// still to come (the owner, 2026-10-18: "i do like the rotating missions in The
// Spell Brigade where they just give you an optional extra enhancement").
// Every so often one appears somewhere in the clearing, pointed to at the
// screen's edge: hold a circle, cull the dead in one, or catch the wisps
// scattered about a place (in place of hunting down a marked elite, 2026-10-19:
// "killing a scaled zombie with some weird crown of fire; that felt awkward"),
// each before its time's up, its circle on the ground lit round as it's done.
// Begun near enough to be seen at the screen's edge, a horn, a long banner and
// a big pointer, and told again with MISSION_HURRY left (the owner, 2026-10-19:
// "i also missed a mission ... i just didnt realize it was active"). Done, every survivor picks one of three
// uncommon or rare items (a boon: items.tide's Owed); out of time, nothing.
// None begins that the night's end would cut short, and its bosses rising
// calls off any going. Which, where and every number are mine, Provisional.

enum MissionKind { None, Hold, Cull, Wisps }

const float MISSION_FIRST = 25;      // Seconds into a night before the first...
const float MISSION_GAP_LEAST = 20;  // ...and from one's end to the next
const float MISSION_GAP_MOST = 35;
const float MISSION_NEAR = 14;       // How far from a survivor one appears
const float MISSION_FAR = 28;
const float MISSION_HURRY = 15;      // Seconds left when it's told again (and its circle's unlit pieces go red)
const float MISSION_NEW = 6;         // Seconds its pointer's big for, begun
const float MISSION_ROOM = 70;       // None begins with less than so long left till the night's bosses
const float HOLD_REACH = 6;          // The circle to hold...
const float HOLD_SECONDS = 12;       // ...for so long, all told, with someone in it (half again as fast for each more)...
const float HOLD_TIME = 50;          // ...within so long
const float CULL_REACH = 9;          // The circle to cull the dead in...
const float CULL_TIME = 45;          // ...within so long
const float CULL_EACH = 25;          // ...so many of them for one survivor (times Crowd)
const float WISPS_TIME = 45;         // The wisps to catch, within so long...
const int WISPS = 5;                 // ...so many of them...
const float WISP_NEAR = 6;           // ...so far from where it is...
const float WISP_FAR = 18;
const float WISP_CATCH = 1.6;        // ...each caught by walking so near it

string MissionName(MissionKind kind)
{
    switch (kind)
    {
        case MissionKind.Hold: return "HOLD THE CIRCLE";
        case MissionKind.Cull: return "CULL THE DEAD IN THE CIRCLE";
        case MissionKind.Wisps: return "CATCH THE WISPS";
    }
    return "";
}

string MissionMark(MissionKind kind)
{
    switch (kind)
    {
        case MissionKind.Hold: return "HOLD";
        case MissionKind.Cull: return "CULL";
        case MissionKind.Wisps: return "WISP";
    }
    return "";
}

float MissionTime(MissionKind kind)
{
    return kind == MissionKind.Hold ? HOLD_TIME : kind == MissionKind.Cull ? CULL_TIME : WISPS_TIME;
}

float MissionReach(MissionKind kind)
{
    return kind == MissionKind.Hold ? HOLD_REACH : kind == MissionKind.Cull ? CULL_REACH : 0.0;
}

// No mission going, the first a while off: a new night's, or a new run's.
void ResetMissions(mut Match match)
{
    match.mission = MissionKind.None;
    match.missionWait = MISSION_FIRST;
    match.wisps.Clear();
}

// The mission, each tick: begun when its time comes, kept while it runs (a cull's kills are counted in zombies.tide's
// TakeWound), ended done or out of time.
[Stage(Tick.Rounds, 3)]
system Missions(mut Match match, Ashwick ashwick, Party party, Time time, query (Survivor survivor) survivors)
{
    if (match.paused || match.phase != Phase.Fighting) return;
    var dt = time.dt;
    if (match.reckoning)
    {
        if (match.mission != MissionKind.None) EndMission(match, party, false);
        return;
    }
    if (match.mission == MissionKind.None)
    {
        match.missionWait -= dt;
        if (match.missionWait > 0 || (match.devMission < 0 && match.nightEnds - match.nightClock < MISSION_ROOM)) return;
        mut List<float3> near = [];
        foreach (var row in survivors)
            if (row.survivor.ready && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
        if (near.count == 0) return;
        var pick = Random.NextInt(near.count);
        var roll = Random.NextInt(3);
        var kind = match.devMission >= 1 && match.devMission <= 3 ? MissionKind(match.devMission) : MissionKind(1 + roll);
        var at = MissionPlace(match, ashwick, near[pick]);
        if (at.y < -100 || (kind == MissionKind.Wisps && !ScatterWisps(match, ashwick, at)))
        {
            match.missionWait = 1;
            return;
        }
        match.devMission = -1;
        match.mission = kind;
        match.missionAt = at;
        match.missionLeft = MissionTime(kind);
        match.missionDone = 0;
        match.missionGoal = kind == MissionKind.Hold ? HOLD_SECONDS : kind == MissionKind.Cull ? Math.Round(CULL_EACH * match.crowd) : match.wisps.count;
        Send(MissionBegan { kind = kind, at = at });
        return;
    }
    var before = match.missionLeft;
    match.missionLeft -= dt;
    if (before > MISSION_HURRY && match.missionLeft <= MISSION_HURRY && match.missionDone < match.missionGoal) Send(MissionHurry { kind = match.mission });
    if (match.mission == MissionKind.Hold)
    {
        mut var inside = 0;
        foreach (var row in survivors)
            if (row.survivor.ready && row.survivor.life == Life.Standing && Math.Length((row.survivor.feet - match.missionAt).xz) <= HOLD_REACH) inside += 1;
        if (inside > 0) match.missionDone += dt * (1 + 0.5 * (inside - 1));
    }
    if (match.mission == MissionKind.Wisps)
    {
        for (var k = match.wisps.count - 1; k >= 0; k--)
        {
            var wisp = match.wisps[k];
            foreach (var row in survivors)
            {
                var s = row.survivor;
                if (!s.ready || s.life != Life.Standing || Math.Length((s.feet - wisp).xz) > WISP_CATCH) continue;
                match.wisps.RemoveAt(k);
                match.missionDone += 1;
                Send(WispCaught { at = wisp, seat = s.seat });
                break;
            }
        }
    }
    if (match.missionDone >= match.missionGoal) EndMission(match, party, true);
    else if (match.missionLeft <= 0) EndMission(match, party, false);
}

// Done (every survivor owed a boon) or not, and the next a while off.
void EndMission(mut Match match, Party party, bool done)
{
    if (done)
        for (var seat = 0; seat < 4; seat++)
            if (party.taken[seat]) party.survivors[seat].Send(Owed { boons = 1, delay = MISSION_REWARD_WAIT });
    Send(MissionEnded { kind = match.mission, at = match.missionAt, done = done });
    match.mission = MissionKind.None;
    match.wisps.Clear();
    var gap = Random.NextFloat(MISSION_GAP_LEAST, MISSION_GAP_MOST);
    match.missionWait = gap;
}

// Where a mission is: open ground MISSION_NEAR to MISSION_FAR from a survivor, the dead's way from it clear, out of
// the fires (twenty tries); else nowhere (far below the world).
float3 MissionPlace(Match match, Ashwick ashwick, float3 focus)
{
    for (var tries = 0; tries < 20; tries++)
    {
        var turn = Random.NextFloat(Math.TAU);
        var off = Random.NextFloat(MISSION_NEAR, MISSION_FAR);
        var there = focus + float3(Math.Sin(turn), 0, Math.Cos(turn)) * off;
        var cell = CellOf(there);
        if (cell < 0 || !InClearing(there) || !Open(ashwick, cell) || FieldAt(ashwick, there) >= UNREACHED) continue;
        if (Afire(match, there, HOLD_REACH)) continue;
        return On(there.x, there.z);
    }
    return float3(0, -1000, 0);
}

// The wisps to catch: WISPS of them, round where the mission is (one to each share of the way round), WISP_NEAR to
// WISP_FAR from it, on open ground the dead's way reaches, out of the fires (a dozen tries each); whether three or more
// were.
bool ScatterWisps(mut Match match, Ashwick ashwick, float3 at)
{
    match.wisps.Clear();
    for (var k = 0; k < WISPS; k++)
    {
        for (var tries = 0; tries < 12; tries++)
        {
            var turn = (k + Random.NextFloat(0.8)) * Math.TAU / WISPS;
            var there = at + float3(Math.Sin(turn), 0, Math.Cos(turn)) * Random.NextFloat(WISP_NEAR, WISP_FAR);
            var cell = CellOf(there);
            if (cell < 0 || !InClearing(there) || !Open(ashwick, cell) || FieldAt(ashwick, there) >= UNREACHED || Afire(match, there, 1.5)) continue;
            match.wisps.Add(On(there.x, there.z));
            break;
        }
    }
    return match.wisps.count >= 3;
}

event WispCaught
{
    float3 at;
    int seat;
}

event MissionBegan
{
    MissionKind kind;
    float3 at;
}

event MissionEnded
{
    MissionKind kind;
    float3 at;
    bool done;
}

event MissionHurry
{
    MissionKind kind;
}

// ---- What's seen and heard ----

// Gold motes rising off the circle (it's drawn in the ground: look.tide's Earth, from Hazards.mission); the wisps,
// pale gold flames bobbing waist high, sparks rising off them, each lighting the ground round it.
[Stage(Layers.Gather, 4)]
view MissionMarks(Match match, mut Fx fx, mut Lights lights, Me me, Look look)
{
    if (!fx.made || match.phase != Phase.Fighting || match.mission == MissionKind.None) return;
    var reach = MissionReach(match.mission);
    if (reach > 0 && Math.Distance(match.missionAt, look.eye) < 90)
    {
        for (var k = 0; k < 3; k++)
        {
            var turn = fx.random.NextFloat(Math.TAU);
            var at = match.missionAt + float3(Math.Cos(turn) * (reach - 0.35), 0, Math.Sin(turn) * (reach - 0.35));
            Glow(fx, Mote { at = On(at.x, at.z) + float3(0, 0.1, 0), velocity = float3(0, 0.8, 0), life = 0.5, size = 0.12, color = float3(1.0, 0.8, 0.25), alpha = 1.8 });
        }
    }
    foreach (var wisp in match.wisps)
    {
        if (Math.Distance(wisp, look.eye) > 90) continue;
        var at = WispAt(wisp, look.time);
        var flicker = 0.85 + 0.3 * Math.Perlin(float2(look.time * 9 + wisp.x, wisp.z));
        Glow(fx, Mote { at = at, life = 0.05, size = 0.55 * flicker, color = float3(1.0, 0.55, 0.15), alpha = 0.45 });
        Glow(fx, Mote { at = at, life = 0.05, size = 0.22 * flicker, color = float3(1.0, 0.8, 0.45), alpha = 1.6 });
        if (fx.random.NextFloat() < Math.Min(Frame.dt, 0.05) * 50)
            Glow(fx, Mote { at = at + Scatter(fx, 0.12), velocity = float3(0, 1.1, 0) + Scatter(fx, 0.3), life = fx.random.NextFloat(0.3, 0.7), size = 0.08, grow = -0.1,
                            color = float3(1.0, 0.65, 0.25), alpha = 2 });
        AddLight(lights, me.eye, Light { at = at, color = float3(1.0, 0.75, 0.35) * 2.5, reach = 6 });
    }
}

// Where a wisp is seen: bobbing and swaying a little, waist high over its place.
float3 WispAt(float3 wisp, float time)
{
    var phase = wisp.x * 1.7 + wisp.z;
    return wisp + float3(Math.Sin(time * 1.3 + phase) * 0.15, 1.1 + Math.Sin(time * 2.2 + phase) * 0.15, Math.Cos(time * 1.1 + phase) * 0.15);
}

// Under the night's panel: the mission, what's done of it and the time left.
[Stage(Layers.Hud, 2)]
view MissionPanel(Me me, Lobby lobby, Match match, Look look, query (Survivor survivor) survivors)
{
    if (lobby.page != Page.Playing || match.phase != Phase.Fighting || match.mission == MissionKind.None) return;
    mut var mine = Survivor { };
    mut var found = false;
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found || mine.role == Role.None) return;
    Draw.SetScreen();
    var u = Unit();
    var box = float2(34 * u + 150 * u, 172 * u);
    Panel(box, float2(300 * u, 70 * u), u);
    var left = box.x - 136 * u;
    var pulse = 0.8 + 0.2 * Math.Sin(look.time * 4);
    WriteBold("OPTIONAL", float2(left, box.y - 20 * u), 11 * u, Color(GOLD.r, GOLD.g, GOLD.b, pulse), Anchor.MiddleLeft);
    WriteBold($"{int(Math.Ceil(Math.Max(0, match.missionLeft)))} s", float2(box.x + 136 * u, box.y - 20 * u), 12 * u, BONE, Anchor.MiddleRight);
    WriteBold(MissionName(match.mission), float2(left, box.y - 2 * u), 14 * u, GOLD, Anchor.MiddleLeft);
    Bar(float2(left, box.y + 16 * u), float2(190 * u, 7 * u), match.missionDone / Math.Max(1, match.missionGoal), 0, GOLD, Color(0.55, 0.4, 0.1), 1, u);
    var done = match.mission == MissionKind.Hold ? $"{int(match.missionDone)} / {int(match.missionGoal)} s" : $"{int(match.missionDone)} / {int(match.missionGoal)}";
    Write(done, float2(left + 198 * u, box.y + 16 * u), 11 * u, BONE, Anchor.MiddleLeft);
    Write("Reward: everyone picks a rarer item", float2(left, box.y + 30 * u), 10 * u, ASH, Anchor.MiddleLeft);
}

// Where the night's bosses are while they stand, and the mission: over each while it's on the screen, else at the
// screen's edge the way it is (the owner, 2026-10-18: "objective was not clear, didnt even find it"). Over the panels.
[Stage(Layers.Hud, 6)]
view Objectives(Me me, Lobby lobby, Match match, Look look, query (Survivor survivor) survivors, query (Boss boss) bosses)
{
    if (lobby.page != Page.Playing || match.phase != Phase.Fighting || match.paused) return;
    mut var mine = Survivor { };
    mut var found = false;
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found || mine.role == Role.None || mine.choosing || mine.life != Life.Standing) return;
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Unit();
    foreach (var row in bosses)
    {
        var b = row.boss;
        if (!b.own || b.move == BossMove.Dying) continue;
        Pointer(look, b.at + float3(0, MutantOf(b.kind).size * 1.4, 0), mine.feet, "BOSS", Color(0.98, 0.32, 0.2), w, h, u, look.time, 1);
    }
    if (match.mission == MissionKind.None) return;
    // With what's done of it; big while it's new and in its last seconds
    var age = MissionTime(match.mission) - match.missionLeft;
    var big = age < MISSION_NEW ? 1.6 - 0.6 * Math.Saturate((age - MISSION_NEW + 1) / 1) : match.missionLeft < MISSION_HURRY ? 1.3 : 1.0;
    var label = match.mission == MissionKind.Hold ? $"{MissionMark(match.mission)} {int(match.missionDone)}/{int(match.missionGoal)} s"
              : $"{MissionMark(match.mission)} {int(match.missionDone)}/{int(match.missionGoal)}";
    // The wisps: the nearest
    if (match.mission == MissionKind.Wisps)
    {
        mut var nearest = float3(0);
        mut var best = 1e9;
        foreach (var wisp in match.wisps)
        {
            var far = Math.Length((wisp - mine.feet).xz);
            if (far >= best) continue;
            best = far;
            nearest = wisp;
        }
        if (match.wisps.count > 0) Pointer(look, WispAt(nearest, look.time) + float3(0, 0.4, 0), mine.feet, label, GOLD, w, h, u, look.time, big);
        return;
    }
    // The circle: over its middle, or over its far edge from inside it (not over the survivor's head)
    var reach = MissionReach(match.mission);
    var inside = Math.Length((match.missionAt - mine.feet).xz) <= reach;
    var at = inside ? On(match.missionAt.x, match.missionAt.z + reach) : match.missionAt;
    Pointer(look, at, mine.feet, label, GOLD, w, h, u, look.time, big, !inside);
}

local event(MissionBegan began) ShowMissionBegan(mut Feed feed)
{
    feed.banner = $"OPTIONAL MISSION: {MissionName(began.kind)}";
    feed.bannerLeft = 4;
    feed.bannerColor = GOLD;
}

local event(MissionHurry hurry) ShowMissionHurry(mut Feed feed)
{
    feed.banner = $"{MissionName(hurry.kind)}: {int(MISSION_HURRY)} s LEFT";
    feed.bannerLeft = 2.6;
    feed.bannerColor = GOLD;
}

local event(MissionHurry hurry) HearMissionHurry()
{
    Audio.Play(levelClip, 0.8, 0.6);
}

local event(MissionEnded ended) ShowMissionEnded(mut Feed feed)
{
    if (ended.kind == MissionKind.None) return;
    feed.banner = ended.done ? "MISSION DONE: EVERYONE PICKS A RARER ITEM" : "MISSION LOST";
    feed.bannerLeft = 2.6;
    feed.bannerColor = ended.done ? GOLD : ASH;
}

local event(MissionBegan began) HearMissionBegan()
{
    Audio.Play(levelClip, 1.0, 0.7);
    Audio.Play(itemRare, 0.8, 0.6);
}

local event(MissionEnded ended) HearMissionEnded()
{
    if (ended.done) Audio.Play(itemRare, 0.85);
}

// A wisp caught: a burst of gold sparks, and a chime.
local event(WispCaught caught) ShowWispCaught(mut Fx fx, Look look)
{
    if (!fx.made) return;
    var at = WispAt(caught.at, look.time);
    fx.flashes.Add(Flash { at = at, color = float3(1.0, 0.8, 0.4) * 4, reach = 5, life = 0.25 });
    for (var i = 0; i < 30; i++)
        Glow(fx, Mote { at = at, velocity = Scatter(fx, 4) + float3(0, 1.5, 0), life = fx.random.NextFloat(0.3, 0.7), size = 0.06, color = float3(1.0, 0.8, 0.35), alpha = 2.5,
                        drag = 2, gravity = 2 });
}

local event(WispCaught caught) HearWispCaught()
{
    Audio.Play(powerupGrab, caught.at, 0.8, 1.3);
}
