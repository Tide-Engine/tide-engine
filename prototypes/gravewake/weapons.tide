// The guns: each survivor's own, and the pistol a downed one fights on with.
// A gun's numbers are one switch, Info(), read by the match and by what's
// drawn and heard. Every shot is a ray (hands.tide's Shoot): no bullet flies.

enum Weapon { None, Rifle, Shotgun, Smg, Pistol }

// What a hit does besides the damage: fire burns, frost slows (and again freezes), shock stuns, a blast throws.
enum Element { None, Fire, Frost, Shock, Bleed, Blast }

struct WeaponInfo
{
    string name;
    string model;           // Its file in art/guns
    float damage;           // A hit's, before a head's, a crit's and the survivor's might
    float head = 2;         // How much more a hit on the head does
    float rate;             // Seconds between shots
    int mag;                // Rounds loaded at once (there are always more)
    float reload;           // Seconds to load a magazine, or one shell
    bool shells;            // Loaded a shell at a time, and a shot cuts the loading short
    float spread;           // Radians off the aim
    int pellets = 1;
    float range = 70;
    int pierce = 1;         // How many of the dead a round goes through
    float kick = 0.02;      // How far the eye kicks up a shot
    float proc = 1;         // How likely a round's items are to go off (a pellet's less)
}

WeaponInfo Info(Weapon weapon)
{
    switch (weapon)
    {
        case Weapon.Rifle:
            return WeaponInfo { name = "Carbine", model = "rifle", damage = 22, rate = 0.1, mag = 30, reload = 1.5, spread = 0.008, pierce = 2, kick = 0.012 };
        case Weapon.Shotgun:
            return WeaponInfo { name = "Pump Shotgun", model = "shotgun", damage = 15, head = 1.5, rate = 0.75, mag = 6, reload = 0.42, shells = true, spread = 0.065,
                                pellets = 9, range = 24, pierce = 2, kick = 0.07, proc = 0.3 };
        case Weapon.Smg:
            return WeaponInfo { name = "SMG", model = "smg", damage = 14, rate = 0.066, mag = 40, reload = 1.3, spread = 0.028, range = 45, kick = 0.008 };
        case Weapon.Pistol:
            return WeaponInfo { name = "Sidearm", model = "pistol", damage = 26, rate = 0.22, mag = 12, reload = 1.1, spread = 0.01, kick = 0.025 };
    }
    return WeaponInfo { name = "", model = "pistol", rate = 1, mag = 1, reload = 1 };
}
