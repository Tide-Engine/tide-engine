// The first-person arms (art/fp): CoinCoin's rigged arms (CC-BY 4.0) and their clips, with clips the kit has none
// for made for it by art/fp/tools/make_fp.py: a long gun held to the shoulder by its stock (the crossbow's clips),
// a pistol in the right hand alone (the hand crossbow's), a throw. What's in the hand rides the skeleton's `weapon`
// bone, its grip at the bone.

struct FpRig
{
    [Name("weapon")] Bone weapon;
    [Name("Shoulder_L")] Bone shoulderL;
    [Name("UpperArm_L")] Bone upperArmL;
}

asset SkinnedMesh<Corner, FpRig> fpArms = "art/fp/arms.glb";
asset AnimationCatalog fpMoves = "art/fp/moves.glb";

// How a gun is held, and so which clips move the arms.
enum Grasp { Long, Pistol, Thrown }

Grasp GraspOf(Weapon weapon)
{
    return weapon == Weapon.Pistol ? Grasp.Pistol : Grasp.Long;
}

// Where the eye is in the kit's space (x right, y up, z ahead): the arms hang from there. The kit's own clips (a
// throw) have the eye where the kit has it; make_fp.py's have it higher, `low` of the way.
float3 FpEye(float low)
{
    return float3(-0.02, 0.52 + 0.15 * low, -0.04);
}

// Where the arms are held for each grasp, beyond where the clips have them: a long gun down, right and out from the
// eye, so its stock is at the shoulder and not in the face.
float3 GraspShift(Grasp grasp)
{
    if (grasp == Grasp.Long) return float3(0.1, -0.09, 0.16);
    if (grasp == Grasp.Pistol) return float3(0.05, -0.05, 0.1);
    return float3(0);
}

// Which eye a grasp's clips were made for: 1 the high one, 0 the kit's.
float LowFor(Act act)
{
    return act == Act.Throw ? 0.0 : 1.0;
}

// The arms' pose this frame, for what the survivor's hands are doing.
Pose FpPose(Survivor mine, Grasp grasp, float t, float clock)
{
    mut var pose = fpArms.defaultPose;
    pose.Sample(grasp == Grasp.Pistol ? fpMoves.h_Idle : fpMoves.x_Idle, clock, Playback.Loop);
    mut var act = fpArms.defaultPose;
    mut var weight = 0.0;
    var fade = Math.Saturate(Math.Min(t * 8, (1 - t) * 6));
    switch (mine.act)
    {
        case Act.Fire:
            if (grasp == Grasp.Pistol)
            {
                act.Sample(fpMoves.h_Fire, t * 0.33);
                weight = 1;
            }
            break;
        case Act.Reload:
            if (grasp == Grasp.Pistol) act.Sample(fpMoves.h_Reload, t * 1.0);
            else act.Sample(fpMoves.x_Reload, Info(mine.gun).shells ? 0.5 + t * 0.6 : t * 1.5);
            weight = fade;
            break;
        case Act.Throw:
            act.Sample(fpMoves.toss, t * 0.65);
            weight = Math.Saturate(Math.Min(t * 10, (1 - t) * 8));
            break;
    }
    if (weight > 0) pose.Blend(act, weight);
    // The pistol's held in the right hand alone: the left only loads it, and throws
    if (grasp == Grasp.Pistol && mine.act != Act.Reload && mine.act != Act.Throw)
        TurnBone(pose, fpArms.skeleton.bones.upperArmL, fpArms.skeleton.bones.shoulderL, quaternion.AxisAngle(float3(1, 0, 0), Math.Radians(70)));
    return pose;
}

// A bone turned in the model's axes (about its own joint), its children with it.
void TurnBone(mut Pose pose, Bone bone, Bone parent, quaternion turn)
{
    var p = Unscaled(pose.Model(parent));
    var q = Math.Normalize(quaternion(float3x3(p.c0.xyz, p.c1.xyz, p.c2.xyz)));
    var local = pose[bone].rotation;
    pose[bone].rotation = Math.Mul(Math.Inverse(q), Math.Mul(turn, Math.Mul(q, local)));
}

// A bone's place with the kit's scale taken out: its axes made a unit long.
float4x4 Unscaled(float4x4 m)
{
    return float4x4(float4(Math.Normalize(m.c0.xyz), 0), float4(Math.Normalize(m.c1.xyz), 0), float4(Math.Normalize(m.c2.xyz), 0), m.c3);
}

// How a gun sits on the weapon bone, whose +z runs up what the fist holds and -x is ahead of it (the importer mirrors
// x): held by its grip as a pistol is, its top (+y) up the bone, its barrel (+z) ahead. A thrown pot or grenade the same.
quaternion Seat()
{
    return quaternion.LookRotation(float3(-1, 0, 0), float3(0, 0, 1));
}
