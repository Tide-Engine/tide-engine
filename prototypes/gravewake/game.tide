// GRAVEWAKE: Ashwick is burned, and up to four survivors hold a clearing in
// the wood outside it through night after night, against the dead without
// end, in their thousands, with guns, skills and items that stack, taking one
// at each level. Each night ends at a beacon they light and keep till dawn
// (nights.tide). This file is who plays: the survivors, what a player's
// hands send, joining and leaving, and starting over.
using Rooms;

settings
{
    title = "GRAVEWAKE";
    tickRate = 60;
    maxPlayers = 4;
    hostMigration = true;
}

scene Main { }

enum Life { Standing, Downed, Gone }

// What a survivor's hands are busy with.
enum Act { Idle, Raise, Fire, Reload, Throw, Kick }

// A survivor: one of the four, walking, fighting and choosing. `seat` is which: 0 Wat, 1 Maud, 2 Godric, 3 Agnes.
component Survivor
{
    int seat;
    [Position] float3 feet;
    [Rotation] float yaw;            // 0 looks along +z, a quarter turn right is +x
    float pitch;
    float3 velocity;
    bool grounded;
    bool sliding;                    // On ground steeper than a ramp: no footing, down it they go
    float health = 100;
    float calm = 10;                 // Seconds since last hurt: health comes back after a while
    Life life;
    float bleed;                     // Seconds left before a downed survivor is gone
    float revive;                    // How far someone's got raising them, 0 to 1
    int reviver = -1;                // Whose hands are on them
    int selfRevives;                 // Second Winds not yet used
    // The kit (kits.tide): the gun in hand (the role's, or the pistol while down) and the skills' cooldowns
    Role role;                       // None till it's picked, before the first wave
    Weapon gun;
    int mag;                         // The gun's rounds loaded
    int stowed;                      // The gun's rounds, kept while the pistol's in hand (down)
    float shotWait;                  // Seconds till the gun fires again
    float[3] cooldowns;              // Seconds till each skill comes back: secondary, utility, special
    Act act;
    float actTime;                   // Seconds into what the hands do
    float actLength;
    bool landed;                     // This throw or kick has been dealt
    Skill throwing;                  // What's thrown
    float steady;                    // Seconds since the last shot, for the spread's bloom and the run
    int airJumps;                    // Jumps taken in the air since the ground (Spring Boots)
    bool leaping;                    // In the air from a leap: it slams down where it lands
    float dash;                      // Seconds left of a dash, and which way
    int dashes = 2;                  // Dash charges ready (DASHES)
    float dashWait;                  // Seconds till a spent dash comes back
    float3 dashWay;
    float slimed;                    // Seconds left slowed by a Spitter's bile
    int aimed = -1;                  // The friend down within reach, a seat, for the prompt
    View view;                       // How their player sees (Hands.view)
    float3 aim;                      // From above: what the cursor's on (Hands.aim)
    // The items (items.tide): stacks of each, the three on offer at a level while `choosing`
    int[24] items;
    Item[3] offers;
    bool choosing;
    int pending;                     // Picks owed: a level's, a boss's, after the one on offer
    int picks;
    float gone;                      // Seconds since bleeding out: they're back beside the beacon when it's lit, or at dawn
    int level = 1;                   // The party's, as it reached this survivor
    float droneWait;
    float emberWait;
    int kills;
    int headshots;
    int downs;
    int revives;
    bool ready;                      // Past the menu
    bool placed;                     // Put somewhere at once: views don't slide them there
    float hurtFrom;                  // Which way the last blow came from (a yaw), for the screen's red
    float leech;                     // What Leech Rounds may still heal: it comes back at 5% of health a second each
    local Pose pose;                 // This machine's: the frame's pose, sampled once
    local float4x4 place = float4x4.identity;
    local float stride;              // Metres walked, the walk's clock
    local float bash;                // How far into a shoulder charge the body is (0 to 1): a dash's pose, eased in and out
    local float bashTurn;            // ...and how far the body turns from the aim for it (side-on, the leading shoulder first)
    local float legYaw;              // How far the legs are turned from the aim, toward the way they're going
    local float feetYaw;             // Which way the feet face, in the world: they stay put while the aim turns, then step round
    local float turning;             // Seconds left of a step round
    local float stepClock;           // The stepping round's walk clock
    local bool footed;               // feetYaw has been set
    local float air;                 // Seconds off the ground
    local float touched = 10;        // Seconds since they came down
    local float4x4 held = float4x4.identity;  // Where the gun is in the hands, in the world, this frame
}

input Hands
{
    [Clamp(-1, 1)] float2 move;
    [Clamp(-0.5, 0.5)] float2 look;
    bool attack;                     // The gun
    bool secondary;                  // The skills: right mouse, Shift, Q
    bool utility;
    bool special;
    bool use;
    bool reload;
    bool jump;
    bool pick1;                      // An item, or a survivor before the first wave
    bool pick2;
    bool pick3;
    View view;                       // How its player sees: over the shoulder, the shots aim where its camera's crosshair is
    float3 aim;                      // ...from above, at what the cursor's on (eye.tide's Pointing)
    [Absolute] bool ready;

    Sample(Devices devices, Lobby lobby, Feel feel, Me me)
    {
        ready = lobby.playing;
        if (!lobby.playing) return;
        var keys = devices.keyboard;
        var pad = devices.gamepad;
        move.x = (keys.d.pressed ? 1 : 0) - (keys.a.pressed ? 1 : 0);
        move.y = (keys.w.pressed ? 1 : 0) - (keys.s.pressed ? 1 : 0);
        move += pad.leftStick;
        // From above, the mouse and the right stick move the cursor, not the eye
        if (feel.view == View.Above) aim = me.pointed;
        else
        {
            if (Cursor.locked) look = devices.mouse.delta * feel.sensitivity;
            look += pad.rightStick * float2(0.055, 0.045);
        }
        attack = devices.mouse.left.pressed || pad.rightTrigger > 0.4;
        secondary = devices.mouse.right.pressed || pad.leftTrigger > 0.4;
        utility = keys.leftShift.pressed || pad.leftShoulder.pressed;
        special = keys.q.pressed || pad.rightShoulder.pressed;
        use = keys.e.pressed || pad.buttonWest.pressed;
        reload = keys.r.pressed || pad.buttonWest.pressed;
        jump = keys.space.pressed || pad.buttonSouth.pressed;
        pick1 = keys.digit1.pressed || pad.dpad.left.pressed;
        pick2 = keys.digit2.pressed || pad.dpad.up.pressed;
        pick3 = keys.digit3.pressed || pad.dpad.right.pressed;
        view = feel.view;
    }
}

// How a survivor's player sees: through the eyes, from over the shoulder, or from above, the camera high behind them
// looking down, north up the screen, the shots going where the cursor is (the owner, 2026-10-18: "I want to play with a
// top down camera too").
enum View { Eyes, Shoulder, Above }

// This machine's feel for the controls.
local singleton Feel
{
    float sensitivity = 0.0022;
    View view = View.Shoulder;       // V goes round them: over the shoulder, from above, through the eyes
    float zoom = 1;                  // From above, how far off the camera is (the mouse's wheel)
}

// Who plays whom: a seat for each of the four.
singleton Party
{
    Entity[4] survivors;
    PlayerID[4] players;
    bool[4] taken;
    int joined;
}

// Start again from the first night, from a menu's New game or Play.
command Restart { }

const float BODY_RADIUS = 0.32;
const float BODY_HIGH = 1.8;
const float EYE_HIGH = 1.62;
const float DOWNED_EYE = 0.55;
const float WALK_SPEED = 5.6;       // Any way, firing or not
const float SPRINT_SPEED = 7.0;     // Running: whenever a survivor goes forward and hasn't fired for a moment
const float STEP_UP = 0.45;
const float GRAVITY = 24;
const float JUMP_SPEED = 7.0;
const float REACH = 2.4;

float3 LookDirection(float yaw, float pitch)
{
    var flat = Math.Cos(pitch);
    return float3(Math.Sin(yaw) * flat, Math.Sin(pitch), Math.Cos(yaw) * flat);
}

float3 Flat(float yaw)
{
    return float3(Math.Sin(yaw), 0, Math.Cos(yaw));
}

float YawTo(float3 from, float3 to)
{
    return Math.Atan2(to.x - from.x, to.z - from.z);
}

// The shortest turn from one yaw to another, from -PI to PI.
float TurnBetween(float from, float to)
{
    mut var turn = to - from;
    while (turn > Math.PI) turn -= Math.TAU;
    while (turn < -Math.PI) turn += Math.TAU;
    return turn;
}

float EyeHeight(Survivor s)
{
    return s.life == Life.Downed ? DOWNED_EYE : EYE_HIGH;
}

float3 EyeOf(Survivor s)
{
    return s.feet + float3(0, EyeHeight(s), 0);
}

// A survivor as they start: no kit till one's picked, nothing taken.
Survivor Outfitted(int seat, float3 at, float yaw)
{
    return Survivor { seat = seat, feet = at, yaw = yaw, placed = true, act = Act.Raise, actLength = 0.5 };
}

event(Spawned) Begin(with Main, mut Ashwick ashwick, mut Match match)
{
    BuildAshwick(ashwick);
    ResetMatch(match);
}

event(PlayerJoined joined) TakeSeat(mut Party party, Ashwick ashwick)
{
    for (var seat = 0; seat < 4; seat++)
        if (party.taken[seat] && party.players[seat] == joined.player) return;
    for (var seat = 0; seat < 4; seat++)
    {
        if (party.taken[seat]) continue;
        party.taken[seat] = true;
        party.players[seat] = joined.player;
        party.joined += 1;
        var start = ashwick.starts[seat];
        party.survivors[seat] = Spawn(Survivor { seat = seat, feet = start, yaw = YawTo(float3(0), start), placed = true, act = Act.Raise, actLength = 0.5 },
                                      Owner { player = joined.player });
        return;
    }
}

event(PlayerLeft left) LeaveSeat(mut Party party)
{
    for (var seat = 0; seat < 4; seat++)
    {
        if (!party.taken[seat] || party.players[seat] != left.player) continue;
        party.taken[seat] = false;
        party.players[seat] = default;
        party.joined -= 1;
        party.survivors[seat].Destroy();
        party.survivors[seat] = default;
    }
}

// New game: asked for by any of the survivors' players, done at the start of the next tick (Restarting, below).
command(Restart restart, PlayerID sender) StartOver(Party party, mut Match match)
{
    for (var seat = 0; seat < 4; seat++)
        if (party.taken[seat] && party.players[seat] == sender) match.restarting = true;
}

[Stage(Tick.Restart)]
system ClearZombie(with Zombie, Match match)
{
    if (match.restarting) this.Destroy();
}

[Stage(Tick.Restart)]
system ClearMissile(with Missile, Match match)
{
    if (match.restarting) this.Destroy();
}

[Stage(Tick.Restart)]
system ClearTurret(with Turret, Match match)
{
    if (match.restarting) this.Destroy();
}

[Stage(Tick.Restart)]
system ClearBoss(with Boss, Match match)
{
    if (match.restarting) this.Destroy();
}

[Stage(Tick.Restart)]
system RestartSurvivor(mut Survivor survivor, Match match, Ashwick ashwick)
{
    if (!match.restarting) return;
    var start = ashwick.starts[survivor.seat];
    var ready = survivor.ready;
    survivor = Outfitted(survivor.seat, start, YawTo(float3(0), start));
    survivor.ready = ready;
}

[Stage(Tick.Restart, 1)]
system Restarting(mut Match match)
{
    if (!match.restarting) return;
    ResetMatch(match);
}

// Development shortcuts, not in play's interface (hud.tide's DevKeys): a horde of two thousand, a level (and so an
// offer), an item, a boss, six of one kind of the dead, the night kept, a walk to a place.
command Cheat
{
    int what;
}

command(Cheat cheat, PlayerID sender) Cheating(mut Match match, Party party)
{
    mut var seat = -1;
    for (var s = 0; s < 4; s++)
        if (party.taken[s] && party.players[s] == sender) seat = s;
    if (seat < 0) return;
    switch (cheat.what)
    {
        case 3:
            // A horde: two thousand more of the dead, six a tick
            match.rush += 2000;
            return;
        case 4:
            match.level += 1;
            match.xp = 0;
            Send(Levelled { level = match.level });
            return;
        case 6:
            match.bossNext = match.nightClock;
            return;
        case 30:
        case 31:
        case 32:
            // A boss of a kind, now
            match.devBoss = cheat.what - 30;
            match.bossNext = match.nightClock;
            return;
        case 8:
            // The night kept: dawn now, everyone up
            if (match.phase != Phase.Fighting) return;
            match.phase = Phase.Dawn;
            match.timer = 0;
            match.vigil = false;
            match.kept = match.night;
            for (var s = 0; s < 4; s++)
                if (party.taken[s]) party.survivors[s].Send(Dawned { at = match.beaconAt });
            Send(DawnBroke { night = match.night, at = match.beaconAt });
            return;
        case 5:
            party.survivors[seat].Send(Given { item = Item(Random.NextInt(ITEM_COUNT)) });
            return;
    }
    // Six of a kind of the dead, the next six to rise: 20 Bloaters, 21 Spitters, 22 Wardens
    if (cheat.what >= 20 && cheat.what < 23)
    {
        match.special = cheat.what == 20 ? ZombieKind.Bloater : cheat.what == 21 ? ZombieKind.Spitter : ZombieKind.Warden;
        match.specials += 6;
        match.rush += 6;
        return;
    }
    if (cheat.what >= 10 && cheat.what < 20) party.survivors[seat].Send(Moved { to = Showplace(cheat.what - 10) });
}

// Where each part of the clearing is seen from, for the development walks: x, z and the way to look.
float4 Showplace(int place)
{
    mut var at = float3(0, -6, 0);                          // South of the fire, looking north to the chapel's rise
    switch (place)
    {
        case 1: at = float3(0, CHAPEL.y - 3, Math.PI); break;                       // On the chapel's rise, looking out over the clearing
        case 2: at = float3(GRAVES.x + 12, GRAVES.y, -Math.PI * 0.5); break;        // Above the sunken graveyard
        case 3: at = float3(BEACON.x, BEACON.y, -Math.PI * 0.5); break;            // The beacon's top, back toward the fire
        case 4: at = float3(SPIRE.x - 5, SPIRE.y - 3, -Math.PI * 0.6); break;      // The spire's lower tier
        case 5: at = float3(WEST_RAMP_B.x + 2, WEST_RAMP_B.y - 2, 0.8); break;     // The foot of the chapel's west ramp
        case 6: at = float3(0, -35, Math.PI * 0.5); break;                          // In the ravine, along it
        case 7: at = float3(STONES.x + 9, STONES.y - 7, -0.9); break;              // By the standing stones
    }
    return float4(On(at.x, at.y), at.z);
}

event Moved
{
    float4 to;
}

// The development key's item.
event Given
{
    Item item;
}

event(Given given) TakeGiven(mut Survivor survivor)
{
    if (survivor.role == Role.None) return;
    Take(survivor, given.item);
    Send(Picked { seat = survivor.seat, item = given.item });
}

event(Moved moved) TakeMoved(mut Survivor survivor)
{
    survivor.feet = moved.to.xyz;
    survivor.yaw = moved.to.w;
    survivor.pitch = 0;
    survivor.velocity = float3(0);
    survivor.placed = true;
}

// How many survivors are in the match.
int Players(Party party)
{
    return Math.Max(1, party.joined);
}
