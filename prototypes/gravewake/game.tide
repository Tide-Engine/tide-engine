// GRAVEWAKE: Ashwick is burned, and up to four survivors hold a clearing in
// the wood outside it, round its fire, wave after wave of the dead, taking a
// card after each: a new weapon, a brew, something that lasts. This file is
// who plays: the survivors, what a player's hands send, joining and leaving,
// and starting over.
using Rooms;

settings
{
    title = "GRAVEWAKE";
    tickRate = 60;
    maxPlayers = 4;
    hostMigration = true;
}

scene Main { }

enum Life { Standing, Downed, Gone }

// What a survivor's hands are busy with.
enum Act { Idle, Raise, Swing, Heavy, Stab, Loose, Draw, Reload, Drink, Throw, Lower, Kick }

// A survivor: one of the four, walking, fighting and choosing. `seat` is which: 0 Wat, 1 Maud, 2 Godric, 3 Agnes.
component Survivor
{
    int seat;
    [Position] float3 feet;
    [Rotation] float yaw;            // 0 looks along +z, a quarter turn right is +x
    float pitch;
    float3 velocity;
    bool grounded;
    float health = 100;
    float calm = 10;                 // Seconds since last hurt: health comes back after a while
    Life life;
    float bleed;                     // Seconds left before a downed survivor is gone
    float revive;                    // How far someone's got raising them, 0 to 1
    int reviver = -1;                // Whose hands are on them
    int selfRevives;                 // Second Wind's, alone: one a wave
    int points;                      // The score: what the dead have paid
    Weapon[3] weapons;               // One carried, two with Packmule; the third is the last stand's (LastStand)
    int[3] mag;
    int[3] ammo;
    bool[3] forged;
    int slot;
    Act act;
    float actTime;                   // Seconds into what the hands do
    float actLength;
    bool landed;                     // This swing's blow has been dealt
    int swings;                      // Swings so far: they go one way then the other
    float charge;                    // A bow's draw, 0 to 1
    int brews;                       // A bit per Brew
    float stamina = 1;
    int aimed = -1;                  // The friend down within reach, a seat, for the prompt
    // The class and the ability on Q (abilities.tide)
    Role role;                       // None till it's picked, before the first wave
    Ability ability;
    float cooldown;                  // Seconds till it can be used again
    int honed;
    bool leaping;                    // In the air from a leap: it slams down where it lands
    float dash;                      // Seconds left of a dash, and which way
    float3 dashWay;
    float mana;                      // A staff's next charge coming back, 0 to 1
    // The cards (cards.tide): the three on offer after a wave while `choosing`, each one's weapon or brew
    Card[3] cards;
    int[3] cardItems;
    bool choosing;
    int dealt;                       // The wave whose cards were dealt
    int picks;
    int edge;                        // Whetstones, broadheads or focus: a fifth more damage each
    int vigor;                       // Hearts of oak
    int boots;                       // Hobnailed boots
    int fleet;                       // Fleet feet
    int quiver;                      // A Ranger's deep quivers
    int cleave;                      // A Warrior's wide swings
    int thirst;                      // ...and bloodthirst
    int fletch;                      // A Ranger's bodkin heads
    int volley;                      // ...volleys
    int steady;                      // ...and steady hands
    int split;                       // A Mage's split spells
    int flow;                        // ...and wellsprings
    int kills;
    int headshots;
    int downs;
    int revives;
    bool ready;                      // Past the menu
    bool placed;                     // Put somewhere at once: views don't slide them there
    float hurtFrom;                  // Which way the last blow came from (a yaw), for the screen's red
    local Pose pose;                 // This machine's: the frame's pose, sampled once
    local float4x4 place = float4x4.identity;
    local float stride;              // Metres walked, the walk's clock
}

input Hands
{
    [Clamp(-1, 1)] float2 move;
    [Clamp(-0.5, 0.5)] float2 look;
    bool attack;
    bool aim;
    bool use;
    bool reload;
    bool jump;
    bool sprint;
    bool stab;
    bool kick;
    bool ability;
    bool next;
    bool pick1;                      // A card, or the first weapon
    bool pick2;                      // ...or the second
    bool pick3;
    [Absolute] bool ready;

    Sample(Devices devices, Lobby lobby, Feel feel)
    {
        ready = lobby.playing;
        if (!lobby.playing) return;
        var keys = devices.keyboard;
        var pad = devices.gamepad;
        move.x = (keys.d.pressed ? 1 : 0) - (keys.a.pressed ? 1 : 0);
        move.y = (keys.w.pressed ? 1 : 0) - (keys.s.pressed ? 1 : 0);
        move += pad.leftStick;
        if (Cursor.locked) look = devices.mouse.delta * feel.sensitivity;
        look += pad.rightStick * float2(0.055, 0.045);
        attack = devices.mouse.left.pressed || pad.rightTrigger > 0.4;
        aim = devices.mouse.right.pressed || pad.leftTrigger > 0.4;
        use = keys.e.pressed || pad.buttonWest.pressed;
        reload = keys.r.pressed || pad.buttonWest.pressed;
        jump = keys.space.pressed || pad.buttonSouth.pressed;
        sprint = keys.leftShift.pressed || pad.leftStickButton.pressed;
        stab = keys.v.pressed || keys.c.pressed || pad.rightStickButton.pressed;
        kick = keys.f.pressed || pad.buttonEast.pressed;
        ability = keys.q.pressed || pad.leftShoulder.pressed;
        next = devices.mouse.scroll.y != 0 || pad.buttonNorth.pressed;
        pick1 = keys.digit1.pressed || pad.dpad.left.pressed;
        pick2 = keys.digit2.pressed || pad.dpad.up.pressed;
        pick3 = keys.digit3.pressed || pad.dpad.right.pressed;
    }
}

// This machine's feel for the controls.
local singleton Feel
{
    float sensitivity = 0.0022;
}

// Who plays whom: a seat for each of the four.
singleton Party
{
    Entity[4] survivors;
    PlayerID[4] players;
    bool[4] taken;
    int joined;
}

// Start again from round one, from a menu's New game or Play.
command Restart { }

const float BODY_RADIUS = 0.32;
const float BODY_HIGH = 1.8;
const float EYE_HIGH = 1.62;
const float DOWNED_EYE = 0.55;
const float WALK_SPEED = 4.2;
const float SPRINT_SPEED = 6.2;
const float STEP_UP = 0.45;
const float GRAVITY = 20;
const float JUMP_SPEED = 6.2;
const float REACH = 2.4;

float3 LookDirection(float yaw, float pitch)
{
    var flat = Math.Cos(pitch);
    return float3(Math.Sin(yaw) * flat, Math.Sin(pitch), Math.Cos(yaw) * flat);
}

float3 Flat(float yaw)
{
    return float3(Math.Sin(yaw), 0, Math.Cos(yaw));
}

float YawTo(float3 from, float3 to)
{
    return Math.Atan2(to.x - from.x, to.z - from.z);
}

// The shortest turn from one yaw to another, from -PI to PI.
float TurnBetween(float from, float to)
{
    mut var turn = to - from;
    while (turn > Math.PI) turn -= Math.TAU;
    while (turn < -Math.PI) turn += Math.TAU;
    return turn;
}

float EyeHeight(Survivor s)
{
    return s.life == Life.Downed ? DOWNED_EYE : EYE_HIGH;
}

float3 EyeOf(Survivor s)
{
    return s.feet + float3(0, EyeHeight(s), 0);
}

bool HasBrew(Survivor s, Brew brew)
{
    return (s.brews & (1 << int(brew))) != 0;
}

int BrewCount(Survivor s)
{
    mut var count = 0;
    for (var i = 0; i < BREW_COUNT; i++)
        if ((s.brews & (1 << i)) != 0) count += 1;
    return count;
}

// How many weapons a survivor carries: one, two with Packmule Stout. The stab and the kick are always to hand.
int Slots(Survivor s)
{
    return HasBrew(s, Brew.Packmule) ? 2 : 1;
}

float MaxHealth(Survivor s)
{
    return (HasBrew(s, Brew.Ironhide) ? 250 : 100) + 40 * s.vigor;
}

// A survivor as they start: the hand crossbow, two fire pots (and always the stab and the kick).
Survivor Outfitted(int seat, float3 at, float yaw)
{
    mut var s = Survivor { seat = seat, feet = at, yaw = yaw, placed = true };
    s.weapons[0] = Weapon.HandCrossbow;
    s.mag[0] = Info(Weapon.HandCrossbow).mag;
    s.ammo[0] = Info(Weapon.HandCrossbow).reserve;
    s.act = Act.Raise;
    s.actLength = 0.5;
    return s;
}

event(Spawned) Begin(with Main, mut Ashwick ashwick, mut Match match)
{
    BuildAshwick(ashwick);
    ResetMatch(match);
}

event(PlayerJoined joined) TakeSeat(mut Party party, Ashwick ashwick)
{
    for (var seat = 0; seat < 4; seat++)
        if (party.taken[seat] && party.players[seat] == joined.player) return;
    for (var seat = 0; seat < 4; seat++)
    {
        if (party.taken[seat]) continue;
        party.taken[seat] = true;
        party.players[seat] = joined.player;
        party.joined += 1;
        var start = ashwick.starts[seat];
        party.survivors[seat] = Spawn(Survivor
        {
            seat = seat,
            feet = start,
            yaw = YawTo(float3(0), start),
            placed = true,
            weapons = [Weapon.HandCrossbow, Weapon.None, Weapon.None],
            mag = [1, 0, 0],
            ammo = [40, 0, 0],
            act = Act.Raise,
            actLength = 0.5,
        }, Owner { player = joined.player });
        return;
    }
}

event(PlayerLeft left) LeaveSeat(mut Party party)
{
    for (var seat = 0; seat < 4; seat++)
    {
        if (!party.taken[seat] || party.players[seat] != left.player) continue;
        party.taken[seat] = false;
        party.players[seat] = default;
        party.joined -= 1;
        party.survivors[seat].Destroy();
        party.survivors[seat] = default;
    }
}

// New game: asked for by any of the survivors' players, done at the start of the next tick (Restarting, below).
command(Restart restart, PlayerID sender) StartOver(Party party, mut Match match)
{
    for (var seat = 0; seat < 4; seat++)
        if (party.taken[seat] && party.players[seat] == sender) match.restarting = true;
}

[Stage(Tick.Restart)]
system ClearZombie(with Zombie, Match match)
{
    if (match.restarting) this.Destroy();
}

[Stage(Tick.Restart)]
system ClearMissile(with Missile, Match match)
{
    if (match.restarting) this.Destroy();
}

[Stage(Tick.Restart)]
system ClearDrop(with Drop, Match match)
{
    if (match.restarting) this.Destroy();
}

[Stage(Tick.Restart)]
system RestartSurvivor(mut Survivor survivor, Match match, Ashwick ashwick)
{
    if (!match.restarting) return;
    var start = ashwick.starts[survivor.seat];
    var ready = survivor.ready;
    survivor = Outfitted(survivor.seat, start, YawTo(float3(0), start));
    survivor.ready = ready;
}

[Stage(Tick.Restart, 1)]
system Restarting(mut Match match)
{
    if (!match.restarting) return;
    ResetMatch(match);
}

// Development shortcuts, not in play's interface (hud.tide's DevKeys): a horde of two thousand, the wave's end (and so
// the cards), the next weapon, a walk to a place.
command Cheat
{
    int what;
}

command(Cheat cheat, PlayerID sender) Cheating(mut Match match, Party party)
{
    mut var seat = -1;
    for (var s = 0; s < 4; s++)
        if (party.taken[s] && party.players[s] == sender) seat = s;
    if (seat < 0) return;
    switch (cheat.what)
    {
        case 3:
            // A horde: two thousand more of the dead in this wave, one a tick
            match.toSpawn += 2000;
            match.rush += 2000;
            return;
        case 4:
            match.toSpawn = 0;
            match.culling = true;
            return;
        case 5:
            party.survivors[seat].Send(Rearmed { });
            return;
    }
    if (cheat.what >= 10) party.survivors[seat].Send(Moved { to = Showplace(cheat.what - 10) });
}

// Where each part of the clearing is seen from, for the development walks: x, z and the way to look.
float4 Showplace(int place)
{
    mut var at = float3(0, -6, 0);                          // South of the fire, looking north to the ruin
    switch (place)
    {
        case 1: at = float3(0, 22, Math.PI); break;          // On the ruin's cliff, looking out over the clearing
        case 2: at = float3(-14, 2, -Math.PI * 0.5); break;   // The graveyard in its hollow
        case 3: at = float3(26, -2, -Math.PI * 0.5); break;   // The hill's top, back toward the fire
        case 4: at = float3(-18, -20, 0.9); break;           // The shelf
        case 5: at = float3(-16, 5, 0.8); break;             // The foot of the ruin's ramp
        case 6: at = float3(10, -26, Math.PI); break;         // South, toward the edge
        case 7: at = float3(14, 14, 0.7); break;             // North-east
    }
    return float4(On(at.x, at.y), at.z);
}

event Moved
{
    float4 to;
}

// The development key's next weapon in hand.
event Rearmed { }

event(Rearmed rearmed) TakeRearmed(mut Survivor survivor)
{
    mut var next = (int(survivor.weapons[survivor.slot]) + 1) % WEAPON_COUNT;
    if (next == 0) next = 1;
    Give(survivor, Weapon(next), false);
}

event(Moved moved) TakeMoved(mut Survivor survivor)
{
    survivor.feet = moved.to.xyz;
    survivor.yaw = moved.to.w;
    survivor.pitch = 0;
    survivor.velocity = float3(0);
    survivor.placed = true;
}

// How many survivors are in the match.
int Players(Party party)
{
    return Math.Max(1, party.joined);
}
