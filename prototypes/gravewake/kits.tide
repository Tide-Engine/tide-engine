// The survivors' kits, after Risk of Rain 2's: each picked before the first
// night and kept to the end, a gun to aim and three skills on cooldowns: a
// secondary on the right mouse button, a special that uses itself
// (AutoSkill), and every survivor's roll on Space, a dodge after Dark Souls'
// (the owner, 2026-10-18:
// "instead of dashing its more so a rolling that makes you dodge like in dark
// soul games"). The Gunner carries a carbine, a piercing round and frag
// grenades; the Breacher a pump shotgun, a boot and a firebomb, and takes less
// from the dead; the Engineer an SMG whose rounds set items off more, mines and
// a turret that carries their items. (The Leap and the Blink are kept but
// given to nobody.)

enum Role { None, Gunner, Breacher, Engineer }

enum Skill { None, PhaseRound, Roll, Frag, Boot, Leap, Firebomb, Mine, Blink, Turret }

const int ROLE_COUNT = 3;

string RoleName(Role role)
{
    switch (role)
    {
        case Role.Gunner: return "Gunner";
        case Role.Breacher: return "Breacher";
        case Role.Engineer: return "Engineer";
    }
    return "";
}

// How much less of a blow a survivor takes: the Breacher, built to be in among them, a third less; Kevlar 6% each; 60%
// at most.
float Armor(Survivor survivor)
{
    return Math.Min(0.6, (survivor.role == Role.Breacher ? BREACHER_ARMOR : 0.0) + 0.06 * Has(survivor, Item.Kevlar));
}

const float BREACHER_ARMOR = 0.35;

string RoleLine(Role role)
{
    switch (role)
    {
        case Role.Gunner: return "A carbine for any range. A heavy round through a whole line of the dead, and grenades into the thick of them by themselves.";
        case Role.Breacher: return "A pump shotgun up close, and takes a third less from the dead. Kicks them flat, and sets the ground alight by itself.";
        case Role.Engineer: return "An SMG whose rounds set items off half again as often. Lays mines, and sets down a turret by itself, carrying your items.";
    }
    return "";
}

Weapon RoleWeapon(Role role)
{
    switch (role)
    {
        case Role.Gunner: return Weapon.Rifle;
        case Role.Breacher: return Weapon.Shotgun;
        case Role.Engineer: return Weapon.Smg;
    }
    return Weapon.Pistol;
}

// A kit's skills: 0 the secondary (right mouse), 1 the roll (Space), 2 the special, which uses itself.
Skill SkillOf(Role role, int slot)
{
    switch (role)
    {
        case Role.Gunner: return slot == 0 ? Skill.PhaseRound : slot == 1 ? Skill.Roll : Skill.Frag;
        case Role.Breacher: return slot == 0 ? Skill.Boot : slot == 1 ? Skill.Roll : Skill.Firebomb;
        case Role.Engineer: return slot == 0 ? Skill.Mine : slot == 1 ? Skill.Roll : Skill.Turret;
    }
    return Skill.None;
}

string SkillName(Skill skill)
{
    switch (skill)
    {
        case Skill.PhaseRound: return "Phase Round";
        case Skill.Roll: return "Roll";
        case Skill.Frag: return "Frag Grenade";
        case Skill.Boot: return "Boot";
        case Skill.Leap: return "Leap";
        case Skill.Firebomb: return "Firebomb";
        case Skill.Mine: return "Mine";
        case Skill.Blink: return "Blink";
        case Skill.Turret: return "Turret";
    }
    return "";
}

string SkillLine(Skill skill)
{
    switch (skill)
    {
        case Skill.PhaseRound: return "A heavy round through every one of the dead in its line";
        case Skill.Roll: return "Roll the way you're going, through the dead: nothing they do touches you for most of it. Two charges";
        case Skill.Frag: return "A grenade that bursts on the dead or after a moment";
        case Skill.Boot: return "Kick the dead in front off their feet; one down is stamped on";
        case Skill.Leap: return "Leap high and far, and knock down the dead where you land";
        case Skill.Firebomb: return "Throw a pot of burning fuel";
        case Skill.Mine: return "Lay a mine that bursts when the dead come near";
        case Skill.Blink: return "Step through the air to where you look";
        case Skill.Turret: return "Set down a turret that fires at the dead on its own a while, setting off your items";
    }
    return "";
}

// Seconds between uses, before the Field Batteries.
float BaseCooldown(Skill skill)
{
    switch (skill)
    {
        case Skill.PhaseRound: return 3;
        case Skill.Roll: return 2.5;
        case Skill.Frag: return 7;
        case Skill.Boot: return 3.5;
        case Skill.Leap: return 7;
        case Skill.Firebomb: return 9;
        case Skill.Mine: return 5;
        case Skill.Blink: return 5;
        case Skill.Turret: return 18;
    }
    return 5;
}

float Cooldown(Survivor survivor, Skill skill)
{
    return BaseCooldown(skill) * Math.Pow(0.85, survivor.items[int(Item.Battery)]);
}

const float ROLL_SECONDS = 0.5;     // A roll, start to finish...
const float ROLL_SPEED = 9.5;       // ...how fast in its middle (quick at first, slowing)...
const float ROLL_GUARD = 0.36;      // ...and how long from its start nothing the dead do touches the one rolling
const int ROLLS = 2;                // Charges
const float SLAM_REACH = 4.5;
const float KICK_REACH = 2.6;
const float TURRET_SECONDS = 15;
const float TURRET_REACH = 24;
const float TURRET_HIGH = 0.95;          // Where its gun turns, above its feet

// Whether a survivor is in the guarded part of a roll: nothing the dead do touches them (hands.tide's TakeHurt, the
// bile's slime, a boss's shove).
bool Guarded(Survivor survivor)
{
    return survivor.roll > ROLL_SECONDS - ROLL_GUARD;
}

// A roll (Space): the way they're going on the screen, or the way they face; a charge spent, each back a cooldown after
// it's spent, one at a time (hands.tide's Rolling). Not while one's still going.
void StartRoll(mut Survivor survivor, float2 move)
{
    if (survivor.roll > 0 || survivor.rolls <= 0) return;
    mut var way = Flat(TOP_YAW) * move.y + Flat(TOP_YAW + Math.PI * 0.5) * move.x;
    if (Math.Length(way) < 0.1) way = Flat(survivor.yaw);
    survivor.rollWay = Math.Normalize(way);
    survivor.roll = ROLL_SECONDS;
    survivor.rolls -= 1;
    if (survivor.rollWait <= 0) survivor.rollWait = Cooldown(survivor, Skill.Roll);
    survivor.cooldowns[1] = survivor.rolls > 0 ? 0 : survivor.rollWait;
    Send(Unleashed { seat = survivor.seat, skill = Skill.Roll, at = survivor.feet, to = survivor.feet });
}

// The secondary, on the right mouse button (the owner, 2026-10-18: "i like this new "automatic" abilities direction but
// i miss the right click power"): as soon as it's ready while it's held, at the cursor. A phase round through every one
// of the dead down its line (a headshot through the head the cursor's on); the boot at the dead in front, toward the
// cursor, stamping on the nearest one down; a mine set down the cursor's way. Not mid-roll.
void UseSecondary(Entity self, mut Survivor survivor, Ashwick ashwick, Herd herd)
{
    var skill = SkillOf(survivor.role, 0);
    if (skill == Skill.None || survivor.cooldowns[0] > 0 || survivor.roll > 0) return;
    switch (skill)
    {
        case Skill.PhaseRound:
        {
            var from = AimFrom(survivor, 90, out var look);
            Shoot(ArmsOf(survivor), from, look, 90, 100 * Might(survivor), 1.5, 1000, ashwick, herd, Trace.Phase, 1, AimedAt(survivor, 90));
            Send(Loosed { seat = survivor.seat, weapon = survivor.gun, at = from, way = look, source = Source.Phase });
            survivor.act = Act.Fire;
            survivor.actTime = 0;
            survivor.actLength = 0.3;
            break;
        }
        case Skill.Boot:
            Kick(self, survivor, Near(herd, survivor.feet, KICK_REACH + 1.5), survivor.yaw);
            survivor.kicked = 0;
            break;
        case Skill.Mine:
        {
            var ahead = survivor.feet + Flat(survivor.yaw) * 1.2;
            mut var at = On(ahead.x, ahead.z);
            if (Math.Distance(PushOut(ashwick, at, 0.2, 0.3), at) > 0.001 || at.y > survivor.feet.y + 1) at = On(survivor.feet.x, survivor.feet.z);
            Spawn(Missile { kind = Shot.Mine, at = at + float3(0, 0.03, 0), damage = 220 * Might(survivor), splash = 4.5, seat = survivor.seat, life = 40 });
            Send(Cue { sound = Sfx.Mine, at = at });
            break;
        }
    }
    survivor.cooldowns[0] = Cooldown(survivor, skill);
    Send(Unleashed { seat = survivor.seat, skill = skill, at = survivor.feet, to = survivor.feet });
}

// The special, by itself (the owner, 2026-10-18: "everything other than dodge and main weapon firing should be
// automatic", then the secondary back on its key): as soon as it's ready and one of the dead is in its reach, where it
// does the most: a grenade or a firebomb into the thickest of them; a turret where they're aiming. With nobody in reach
// it looks again AUTO_LOOK later, not every tick (a horde's worth gathered each tick would cost).
void AutoSkill(mut Survivor survivor, int slot, Ashwick ashwick, Herd herd)
{
    var skill = SkillOf(survivor.role, slot);
    if (skill == Skill.None || skill == Skill.Roll || survivor.cooldowns[slot] > 0) return;
    var bodies = Near(herd, survivor.feet, AutoReach(skill) + 1);
    mut var used = false;
    switch (skill)
    {
        case Skill.Frag:
        case Skill.Firebomb:
        {
            var target = Thickest(survivor.feet, bodies, 3, AutoReach(skill), out var found);
            if (!found) break;
            Throw(survivor, skill, target);
            used = true;
            break;
        }
        case Skill.Turret:
        {
            if (!Within(survivor.feet, bodies, AutoReach(skill))) break;
            var ahead = survivor.feet + Flat(survivor.yaw) * 1.5;
            mut var at = On(ahead.x, ahead.z);
            if (Math.Distance(PushOut(ashwick, at, 0.4, 1.2), at) > 0.001 || at.y > survivor.feet.y + 1) at = On(survivor.feet.x, survivor.feet.z);
            Spawn(Turret { seat = survivor.seat, at = at, yaw = survivor.yaw, life = TURRET_SECONDS, arms = ArmsOf(survivor) });
            used = true;
            break;
        }
    }
    survivor.cooldowns[slot] = used ? Cooldown(survivor, skill) : AUTO_LOOK;
    if (used) Send(Unleashed { seat = survivor.seat, skill = skill, at = survivor.feet, to = survivor.feet });
}

const float AUTO_LOOK = 0.25;       // Seconds before a ready skill with nobody in reach looks again

// How far a skill that uses itself looks for the dead.
float AutoReach(Skill skill)
{
    switch (skill)
    {
        case Skill.Frag: return 18;
        case Skill.Firebomb: return 15;
        case Skill.Turret: return 16;
    }
    return 10;
}

// Whether any of the dead that can be hit stands within `reach` of a place, across the ground.
bool Within(float3 at, List<Body> bodies, float reach)
{
    foreach (var z in bodies)
        if (z.hittable && Math.Length((z.at - at).xz) <= reach) return true;
    return false;
}

// The middle of the thickest knot of the dead `near` to `far` away across the ground: whichever of the nearest few has
// the most within AUTO_KNOT of it (a boss counts as five).
float3 Thickest(float3 from, List<Body> bodies, float near, float far, out bool found)
{
    mut var best = float3(0);
    mut var most = 0.0;
    mut var tried = 0;
    foreach (var c in bodies)
    {
        if (tried >= AUTO_TRIES) break;
        if (!c.hittable) continue;
        var away = Math.Length((c.at - from).xz);
        if (away < near || away > far) continue;
        tried += 1;
        mut var count = 0.0;
        mut var looked = 0;
        foreach (var z in bodies)
        {
            if (looked >= AUTO_CROWD) break;
            if (!z.hittable) continue;
            looked += 1;
            if (Math.Length((z.at - c.at).xz) < AUTO_KNOT) count += z.size > 1.5 ? 5.0 : 1.0;
        }
        if (count <= most) continue;
        most = count;
        best = c.at;
    }
    found = most > 0;
    return best;
}

const int AUTO_TRIES = 24;          // How many of the nearest are tried as a skill's target...
const int AUTO_CROWD = 200;         // ...against how many of the dead about
const float AUTO_KNOT = 4;          // How near a grenade's mark one of the dead counts as in the knot

// A leap come down: what's near goes over.
void Slam(Survivor survivor, List<Body> bodies)
{
    foreach (var z in bodies)
    {
        if (!z.hittable || Math.Distance(z.at, survivor.feet) > SLAM_REACH) continue;
        z.entity.Send(Wound { damage = 150 * Might(survivor), seat = survivor.seat, from = survivor.feet, knock = 6, down = true, blow = Blow.Blunt });
    }
    Send(Unleashed { seat = survivor.seat, skill = Skill.Leap, at = survivor.feet, to = survivor.feet, landed = true });
}

// The boot, toward `yaw`: the dead that way, within a stride, go over backwards (six at most); the nearest one already
// down is stamped on, on the head.
void Kick(Entity self, Survivor survivor, List<Body> bodies, float yaw)
{
    mut var hits = 0;
    mut var stampAt = -1;
    mut var stampFar = 1000.0;
    var might = Might(survivor);
    for (var i = 0; i < bodies.count; i++)
    {
        var z = bodies[i];
        if (!z.hittable) continue;
        var to = (z.down ? z.head : z.chest) - survivor.feet;
        var far = Math.Length(to.xz);
        if (far > KICK_REACH + ZOMBIE_RADIUS * z.size) continue;
        var angle = Math.Abs(TurnBetween(yaw, Math.Atan2(to.x, to.z)));
        if (angle > 0.9 && far > 0.6) continue;
        if (z.down)
        {
            if (far >= stampFar) continue;
            stampFar = far;
            stampAt = i;
        }
        else if (hits < 6)
        {
            hits += 1;
            z.entity.Send(Wound { damage = 80 * might, seat = survivor.seat, from = survivor.feet, knock = 7, down = true, blow = Blow.Blunt });
        }
    }
    if (stampAt >= 0)
        bodies[stampAt].entity.Send(Wound { damage = 160 * might, seat = survivor.seat, head = true, from = survivor.feet, blow = Blow.Blunt });
    self.Send(Kicked { seat = survivor.seat, hits = hits + (stampAt >= 0 ? 1 : 0), stamp = stampAt >= 0 });
}

// A grenade or a firebomb, lobbed to land at a place (THROW_MOST at most), a grenade's fuse running out just as it
// lands, so it bursts there and doesn't bounce on past.
void Throw(Survivor survivor, Skill skill, float3 target)
{
    var eye = EyeOf(survivor);
    var right = Flat(survivor.yaw + Math.PI * 0.5);
    var from = eye + right * 0.2;
    var frag = skill == Skill.Frag;
    var velocity = ThrowTo(from, target, THROW_GRAVITY, out var flight);
    var fuse = flight + 0.1;
    if (frag)
        Spawn(Missile { kind = Shot.Grenade, at = from, velocity = velocity, gravity = THROW_GRAVITY, damage = 180 * Might(survivor), splash = 5.5, element = Element.Blast,
                        seat = survivor.seat, life = fuse });
    else
        Spawn(Missile { kind = Shot.Pot, at = from, velocity = velocity, gravity = THROW_GRAVITY, damage = 90 * Might(survivor), splash = 4.8, element = Element.Fire,
                        seat = survivor.seat, life = 5 });
    Send(Cue { sound = Sfx.Throw, at = eye });
}

// How fast to throw from a place to land on the ground under another (no further than THROW_MOST): an arc whose
// flight is longer the further it goes.
float3 ThrowTo(float3 from, float3 aim, float gravity, out float flight)
{
    mut var flat = aim.xz - from.xz;
    var far = Math.Length(flat);
    if (far > THROW_MOST) flat = flat / far * THROW_MOST;
    var at = On(from.x + flat.x, from.z + flat.y);
    flight = Math.Clamp(Math.Length(flat) / 13, 0.35, 1.3);
    return (at - from) / flight + float3(0, 0.5 * gravity * flight, 0);
}

const float THROW_GRAVITY = 14;
const float THROW_MOST = 20;

// ---- The Engineer's turret ----

// A turret where it was set down: it turns to the nearest of the dead it can see and fires, till its time is up, each
// round setting off its maker's items (a little less often than his own).
component Turret
{
    int seat;
    [Position] float3 at;
    float yaw;
    float pitch;
    float life;
    float wait;
    Arms arms;              // Its maker's, when it was set down
}

const float TURRET_PROC = 0.6;

[Stage(Tick.Missiles, 1)]
system Sentry(mut Turret turret, Ashwick ashwick, Herd herd, Match match, Time time)
{
    if (match.paused) return;
    turret.life -= time.dt;
    if (turret.life <= 0)
    {
        this.Destroy();
        return;
    }
    turret.wait -= time.dt;
    if (turret.wait > 0) return;
    var gun = turret.at + float3(0, TURRET_HIGH, 0);
    // The nearest it can see, of a few nearest
    mut Body best = default;
    mut var bestFar = TURRET_REACH;
    foreach (var z in Near(herd, turret.at, TURRET_REACH))
    {
        if (!z.hittable || z.risen < 0.6) continue;
        var far = Math.Distance(z.chest, gun);
        if (far >= bestFar) continue;
        bestFar = far;
        best = z;
    }
    if (best.entity == default)
    {
        turret.wait = 0.25;
        return;
    }
    var to = best.chest - gun;
    var way = to / Math.Max(Math.Length(to), 0.001);
    if (LongRay(ashwick, gun, best.chest, out _) <= 1)
    {
        turret.wait = 0.2;
        return;
    }
    turret.yaw = Math.Atan2(way.x, way.z);
    turret.pitch = Math.Asin(Math.Clamp(way.y, -1, 1));
    turret.wait = 0.09;
    Land(turret.arms, best, 11 * turret.arms.might, false, false, gun, 0.6, TURRET_PROC, herd);
    var muzzle = gun + way * 0.45;
    Send(Traced { seat = turret.seat, from = muzzle, to = best.chest, kind = Trace.Turret });
    Send(Loosed { seat = turret.seat, weapon = Weapon.Smg, at = muzzle, way = way, source = Source.Turret });
}

// A skill used, for what's seen and heard: where from and to (a blink's two ends), a leap's landing.
event Unleashed
{
    int seat;
    Skill skill;
    float3 at;
    float3 to;
    bool landed;
}

event Kicked
{
    int seat;
    int hits;
    bool stamp;
}
