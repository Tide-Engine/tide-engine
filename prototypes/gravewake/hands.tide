// What a survivor does with a tick of their player's hands: turns to the
// cursor and runs (there's no jumping: the owner, 2026-10-18, "just not be
// able to jump"); fires the gun, every round a ray through the dead; loads;
// uses the kit's three skills; and raises a friend who's down.

const float REVIVE_SECONDS = 3;
const float BLEED_SECONDS = 30;

[Stage(Tick.Survivors)]
system Steer(Hands hands, mut Survivor survivor, Ashwick ashwick, Herd herd, Match match, Time time, query (Survivor survivor) others)
{
    survivor.placed = false;
    survivor.ready = hands.ready;
    survivor.aim = hands.aim;
    if (match.paused) return;
    var dt = time.dt;
    if (!survivor.ready || survivor.life == Life.Gone || match.phase == Phase.Over) return;
    FaceAim(survivor);

    // Health comes back slowly after a few calm seconds (items.tide's RegenDelay, RegenRate: it had come back whole in
    // under two, so a survivor who dashed clear a moment never had to fear a blow), sooner and faster with First Aid Kits;
    // what Leech Rounds may heal comes back all the time
    survivor.calm += dt;
    survivor.slimed = Math.Max(0, survivor.slimed - dt);
    var leechMost = MaxHealth(survivor) * 0.08 * Has(survivor, Item.Leech);
    survivor.leech = Math.Min(leechMost, survivor.leech + leechMost * dt);
    var kits = Has(survivor, Item.FirstAid);
    if (survivor.life == Life.Standing && survivor.calm > RegenDelay(kits))
        survivor.health = Math.Min(MaxHealth(survivor), survivor.health + MaxHealth(survivor) * dt * RegenRate(kits));

    // Down: bleeding out, crawling, unless someone comes
    if (survivor.life == Life.Downed)
    {
        survivor.bleed -= dt;
        if (survivor.reviver < 0) survivor.revive = Math.Max(0, survivor.revive - dt);
        survivor.reviver = -1;
        if (survivor.bleed <= 0)
        {
            survivor.life = Life.Gone;
            survivor.velocity = float3(0);
            Send(Cue { sound = Sfx.Downed, at = survivor.feet });
            return;
        }
    }

    // Running: whenever they move and haven't fired for a moment
    var downed = survivor.life == Life.Downed;
    var running = Math.Length(hands.move) > 0.3 && survivor.steady > 0.35 && !downed;
    mut var speed = (running ? SPRINT_SPEED : WALK_SPEED) * Fleetness(survivor);
    if (downed) speed = 0.6;
    speed *= Wading(survivor, herd);
    if (survivor.slimed > 0) speed *= SLIME_SLOW;
    if (InBrambles(ashwick, survivor.feet)) speed *= BRAMBLE_SLOW;
    mut var wish = Flat(TOP_YAW) * hands.move.y + Flat(TOP_YAW + Math.PI * 0.5) * hands.move.x;
    if (Math.Length(wish) > 1) wish = Math.Normalize(wish);
    // On a slope too steep to stand on, no walking up it
    if (survivor.sliding)
    {
        var uphill = Uphill(survivor.feet);
        var up = Math.Dot(wish, uphill);
        if (up > 0) wish -= uphill * up;
    }
    var target = wish * speed;
    // (in a leap, hardly any: it carries them its way)
    var grip = survivor.grounded ? GRIP : 3.5;
    var blend = Math.Min(1, dt * grip);
    survivor.velocity.x += (target.x - survivor.velocity.x) * blend;
    survivor.velocity.z += (target.z - survivor.velocity.z) * blend;
    // A roll carries them its way whatever they press, quick at first and slowing, through the dead (they don't hold
    // a survivor rolling; Hunt's crowding doesn't push one)
    if (survivor.roll > 0)
    {
        survivor.roll -= dt;
        var along = 1 - Math.Max(0, survivor.roll) / ROLL_SECONDS;
        var pace = ROLL_SPEED * Math.Lerp(1.3, 0.5, along) * Fleetness(survivor);
        survivor.velocity.x = survivor.rollWay.x * pace;
        survivor.velocity.z = survivor.rollWay.z * pace;
    }
    // Down a slope too steep to stand on: pulled down it, and no jumping off it (jumping again and again up a hill
    // the feet couldn't climb had walked them up any cliff)
    if (survivor.sliding)
    {
        var downhill = -Uphill(survivor.feet);
        survivor.velocity.x += downhill.x * SLIDE_PULL * dt;
        survivor.velocity.z += downhill.z * SLIDE_PULL * dt;
    }
    survivor.velocity.y -= GRAVITY * dt;
    var before = survivor.feet;
    mut var feet = survivor.feet + float3(survivor.velocity.x, 0, survivor.velocity.z) * dt;
    feet = PushOut(ashwick, feet, BODY_RADIUS, BODY_HIGH);
    foreach (var row in others)
    {
        var other = row.survivor;
        if (other.seat == survivor.seat || !other.ready || other.life == Life.Gone) continue;
        var off = feet.xz - other.feet.xz;
        var far = Math.Length(off);
        if (far < BODY_RADIUS * 2 && far > 0.0001) feet = float3(other.feet.x + off.x / far * BODY_RADIUS * 2, feet.y, other.feet.z + off.y / far * BODY_RADIUS * 2);
    }
    // Never past the clearing's edge, and not up a cliff: the ground may climb as a ramp does and no more, unless
    // they're above it (jumping, leaping, falling)
    if (!Passable(feet, before, survivor.feet.y))
    {
        var alongX = float3(feet.x, feet.y, before.z);
        var alongZ = float3(before.x, feet.y, feet.z);
        if (Passable(alongX, before, survivor.feet.y)) feet = alongX;
        else if (Passable(alongZ, before, survivor.feet.y)) feet = alongZ;
        else feet = before;
    }
    // The night's end: held in the wake-fire's ring (nights.tide)
    feet = InRing(match, feet);
    var ground = GroundUnder(ashwick, feet, BODY_RADIUS * 0.6, survivor.feet.y);
    feet.y += survivor.velocity.y * dt;
    if (feet.y <= ground)
    {
        feet.y = ground;
        survivor.velocity.y = 0;
        survivor.grounded = true;
    }
    else
    {
        survivor.grounded = feet.y - ground < 0.05;
    }
    // Footing: the ground (not a box's top) no steeper than a ramp
    survivor.sliding = survivor.grounded && ground < Ground(feet.x, feet.z) + 0.05 && Steepness(feet.x, feet.z) > SLIDE_STEEP;
    survivor.feet = feet;
}

// Turned to what the cursor's on, the gun's line up or down to it (not when it's right at their feet).
void FaceAim(mut Survivor survivor)
{
    var off = survivor.aim - (survivor.feet + float3(0, GUN_UP, 0));
    var flat = Math.Length(off.xz);
    if (flat < 0.4) return;
    survivor.yaw = Math.Atan2(off.x, off.z);
    survivor.pitch = Math.Clamp(Math.Atan2(off.y, flat), -1.2, 1.2);
}

const float TOP_YAW = 0;            // The camera looks north: up the screen is north, and moving goes by it

// How much of their speed a survivor keeps among the dead: each one pressed against them (on its feet, about as high)
// takes TOUCH_SLOW of it, down to TOUCH_SLOW_MOST. A roll goes through at full speed.
float Wading(Survivor survivor, Herd herd)
{
    if (survivor.roll > 0) return 1;
    mut var touching = 0;
    foreach (var z in Near(herd, survivor.feet, BODY_RADIUS + ZOMBIE_RADIUS * BOSS_SIZE))
    {
        if (!z.hittable || z.down || z.risen < 0.5 || Math.Abs(z.at.y - survivor.feet.y) > 1.2) continue;
        if (Math.Length((z.at - survivor.feet).xz) < BODY_RADIUS + ZOMBIE_RADIUS * z.size + TOUCH_GAP) touching += 1;
    }
    return Math.Max(1 - TOUCH_SLOW_MOST, 1 - TOUCH_SLOW * touching);
}

const float SLIME_SLOW = 0.6;       // Of their speed a survivor keeps while a Spitter's bile is on them (zombies.tide)
const float GRIP = 22;              // How fast feet on the ground take up the way they're asked to go (a second's share)
const float TOUCH_SLOW = 0.22;      // Speed lost to each of the dead pressed against a survivor
const float TOUCH_SLOW_MOST = 0.6;  // ...and the most lost to them all
const float TOUCH_GAP = 0.1;        // How near counts as pressed against

// Which way the ground climbs at a place, flat.
float3 Uphill(float3 at)
{
    var dx = Ground(at.x + 0.5, at.z) - Ground(at.x - 0.5, at.z);
    var dz = Ground(at.x, at.z + 0.5) - Ground(at.x, at.z - 0.5);
    var way = float3(dx, 0, dz);
    return Math.Length(way) > 0.0001 ? Math.Normalize(way) : float3(0);
}

const float SLIDE_STEEP = 0.9;      // Ground climbing more than this a metre isn't footing (a ramp is 0.75 at most)
const float SLIDE_PULL = 22;        // How hard a slope like that pulls one down it, metres a second each second

// Whether a survivor whose feet are `height` up can step from `before` to `at`: in the clearing, and not climbing
// steeper than a ramp.
bool Passable(float3 at, float3 before, float height)
{
    if (!InClearing(at) && InClearing(before)) return false;
    var rise = Ground(at.x, at.z) - height;
    return rise <= 0.75 * Math.Length((at - before).xz) + 0.03;
}

// Up again (raised, or by a Second Wind, or at a wave's end): the kit's gun back in hand, as loaded as it was.
void StandUp(mut Survivor survivor)
{
    if (survivor.gun == Weapon.Pistol && survivor.role != Role.None)
    {
        survivor.gun = RoleWeapon(survivor.role);
        survivor.mag = survivor.stowed;
    }
    survivor.life = Life.Standing;
    survivor.health = MaxHealth(survivor);
    survivor.bleed = 0;
    survivor.revive = 0;
    survivor.reviver = -1;
    survivor.calm = 0;
    survivor.act = Act.Raise;
    survivor.actTime = 0;
    survivor.actLength = 0.5;
}

// The nearest friend down within reach, a seat, or -1.
int FindAim(Survivor survivor, Party party, World world)
{
    mut var best = -1;
    mut var nearest = 2.2;
    for (var seat = 0; seat < 4; seat++)
    {
        if (seat == survivor.seat || !party.taken[seat]) continue;
        var friend = world.Get<Survivor>(party.survivors[seat]);
        if (friend.life != Life.Downed) continue;
        var far = Math.Distance(friend.feet.xz, survivor.feet.xz);
        if (far < nearest)
        {
            nearest = far;
            best = seat;
        }
    }
    return best;
}

// Who's in reach to raise, for the prompt and for Raise.
[Stage(Tick.Survivors, 1)]
system Use(mut Survivor survivor, Match match, Party party, World world)
{
    if (match.paused) return;
    survivor.aimed = -1;
    if (!survivor.ready || survivor.life != Life.Standing || match.phase == Phase.Over) return;
    survivor.aimed = FindAim(survivor, party, world);
}

// Raising a friend: standing by them (no key: the owner, 2026-10-18, everything but the roll and the gun by itself).
[Stage(Tick.Survivors, 2)]
system Raise(Survivor survivor, Party party, Match match, Time time)
{
    if (match.paused) return;
    if (!survivor.ready || survivor.life != Life.Standing || survivor.roll > 0 || survivor.aimed < 0) return;
    var seat = survivor.aimed;
    // Twice the tick's share: Steer lets it fall back on any tick nobody holds them
    party.survivors[seat].Send(Helped { amount = time.dt / REVIVE_SECONDS * 2 * (1 + 0.5 * Has(survivor, Item.Salts)), by = survivor.seat });
}

// A hand to someone who's down; up when it's done.
event(Helped helped) BeHelped(mut Survivor survivor, Party party)
{
    if (survivor.life != Life.Downed) return;
    survivor.revive += helped.amount;
    survivor.reviver = helped.by;
    if (survivor.revive < 1) return;
    StandUp(survivor);
    Send(Cue { sound = Sfx.Revive, at = survivor.feet });
    if (helped.by >= 0 && helped.by < 4 && party.taken[helped.by]) party.survivors[helped.by].Send(Revived { seat = survivor.seat, by = helped.by });
}

event(Revived revived) CountRevive(mut Survivor survivor)
{
    survivor.revives += 1;
}

event Helped
{
    float amount;
    int by;
}

// The gun, the roll, the secondary, the special that uses itself, and what the hands are in the middle of.
[Stage(Tick.Hands)]
system Fight(Hands hands, mut Survivor survivor, Match match, Ashwick ashwick, Herd herd, Time time)
{
    if (match.paused) return;
    if (!survivor.ready || survivor.life == Life.Gone || match.phase == Phase.Over || survivor.role == Role.None) return;
    var dt = time.dt;
    var downed = survivor.life == Life.Downed;
    for (var i = 0; i < 3; i++) survivor.cooldowns[i] = Math.Max(0, survivor.cooldowns[i] - dt);
    survivor.shotWait = Math.Max(0, survivor.shotWait - dt);
    survivor.steady += dt;
    survivor.actTime += dt;
    survivor.kicked += dt;

    // The roll and the secondary on their keys; the special by itself
    if (!downed)
    {
        if (hands.roll.down) StartRoll(survivor, hands.move);
        if (hands.secondary) UseSecondary(this, survivor, ashwick, herd);
        AutoSkill(this, survivor, 2, ashwick, herd);
    }

    // Finishing what the hands were doing (the gun as its cards have made it)
    var info = GunOf(survivor, survivor.gun);
    var holds = MagOf(survivor, survivor.gun);
    switch (survivor.act)
    {
        case Act.Reload:
            if (survivor.actTime >= survivor.actLength)
            {
                if (info.shells)
                {
                    // A shell at a time, till it's full
                    survivor.mag = Math.Min(holds, survivor.mag + 1);
                    Send(Cue { sound = Sfx.Shell, at = survivor.feet });
                    if (survivor.mag < holds) survivor.actTime = 0;
                    else survivor.act = Act.Idle;
                }
                else
                {
                    survivor.mag = holds;
                    survivor.act = Act.Idle;
                }
            }
            break;
        case Act.Raise:
        case Act.Fire:
            if (survivor.actTime >= survivor.actLength) survivor.act = Act.Idle;
            break;
    }
    // Rolling, no shot (a load goes on)
    if (survivor.act == Act.Raise || survivor.roll > 0) return;

    // Loading, by choice or when empty
    if (survivor.act != Act.Reload && survivor.mag < holds && (hands.reload.down || survivor.mag <= 0) && survivor.shotWait <= 0)
    {
        StartAct(survivor, Act.Reload, info.reload / Haste(survivor));
        return;
    }
    if (!hands.attack || survivor.shotWait > 0 || survivor.mag <= 0) return;
    // A fresh pull of the trigger cuts a shotgun's loading short (held down, it loads on till it's full: held, it had
    // fired each shell as it went in, and never filled); a magazine's has to finish
    if (survivor.act == Act.Reload && (!info.shells || !hands.attack.down)) return;

    // A shot: each pellet a ray (the gun's cards' rounds besides: items.tide's GunOf for the rest)
    var round = survivor.mag;
    if (!info.bottomless) survivor.mag -= 1;
    survivor.shotWait = info.rate / Haste(survivor);
    survivor.steady = 0;
    var from = AimFrom(survivor, info.range, out var look);
    var aimed = AimedAt(survivor, info.range);
    var right = Math.Normalize(Math.Cross(float3(0, 1, 0), look));
    var up = Math.Cross(look, right);
    var own = survivor.gun == RoleWeapon(survivor.role);
    var arms = ArmsOf(survivor);
    var might = Might(survivor);
    var pierce = info.pierce + Has(survivor, Item.ApRounds);
    if (info.cone > 0)
    {
        var sticky = own ? Has(survivor, Item.StickyFuel) : 0;
        Scorch(arms, from, look, info.range, info.cone, info.damage * might, info.proc, ashwick, herd, FLAME_MOST + WIDE_MOST * (own ? Has(survivor, Item.WideNozzle) : 0),
               FLAME_IGNITE * (1 + sticky));
    }
    else if (info.pellets > 1)
    {
        // The shotgun: its pellets (Concussion Shells pushing harder and knocking down near, Dragon Shells burning), and a
        // Slug Core's slug down the middle
        var concussion = own ? Has(survivor, Item.Concussion) : 0;
        var dragon = own ? Has(survivor, Item.DragonShells) : 0;
        var trace = dragon > 0 ? Trace.Ember : Trace.Pellet;
        for (var p = 0; p < info.pellets; p++)
        {
            var off = Random.NextFloat2Direction() * Random.NextFloat(info.spread);
            var way = Math.Normalize(look + right * off.x + up * off.y);
            var lit = dragon > 0 && Random.NextFloat() < DRAGON_CHANCE * dragon;
            Shoot(arms, from, way, info.range, info.damage * might, info.head, pierce, ashwick, herd, trace, info.proc, aimed, ignite: lit,
                  push: 1 + CONCUSS_KNOCK * concussion, down: CONCUSS_DOWN * concussion);
        }
        var slug = own ? Has(survivor, Item.Slug) : 0;
        if (slug > 0)
            Shoot(arms, from, look, info.range * 1.5, SLUG_HURT * might * (1 + 0.5 * (slug - 1)), 3, 1 + 2 * slug, ashwick, herd, Trace.Slug, 1, aimed, push: 3);
    }
    else
    {
        // A round (the carbine's cards: a burst's more in a fan, heavier rounds, a marksman's headshots going on, now and
        // then an incendiary one)
        var burst = own ? Has(survivor, Item.Burst) : 0;
        var caliber = own ? Has(survivor, Item.Caliber) : 0;
        var incendiary = own ? Has(survivor, Item.Incendiary) : 0;
        var lit = incendiary > 0 && round % Math.Max(1, INCENDIARY_EVERY - incendiary) == 0;
        var damage = info.damage * might * (incendiary >= 3 ? 1.1 : 1.0);
        var trace = lit ? Trace.Fire : Trace.Bullet;
        var weight = 1 + 0.25 * caliber;
        var knock = 1 + CALIBER_KNOCK * caliber;
        var headPierce = own ? Has(survivor, Item.Marksman) : 0;
        // (each past the first on alternate sides, the side flipping a shot: two rounds don't always lean one way)
        var flip = round % 2 == 0 ? 1.0 : -1.0;
        for (var k = 0; k <= burst; k++)
        {
            var turn = k == 0 ? 0.0 : flip * (k % 2 == 1 ? 1.0 : -1.0) * ((k + 1) / 2) * BURST_FAN;
            var off = Random.NextFloat2Direction() * Random.NextFloat(info.spread);
            var straight = Math.Normalize(look + right * off.x + up * off.y);
            var way = turn == 0 ? straight : Math.Rotate(quaternion.AxisAngle(float3(0, 1, 0), turn), straight);
            Shoot(arms, from, way, info.range, damage * (k == 0 ? 1.0 : BURST_SHARE), info.head, pierce, ashwick, herd, trace, info.proc, aimed, headPierce: headPierce,
                  ignite: lit, weight: weight, push: knock);
        }
    }
    Send(Loosed { seat = survivor.seat, weapon = survivor.gun, at = from, way = look, source = Source.Gun, reach = info.range, cone = info.cone,
                  heat = own ? Has(survivor, Item.HotFuel) : 0, rank = own ? GunLevel(survivor) : 1 });
    survivor.act = Act.Fire;
    survivor.actTime = 0;
    survivor.actLength = Math.Max(0.12, info.rate / Haste(survivor));
}

// Whether a place is in one of the bramble thickets (hazards.tide).
bool InBrambles(Ashwick ashwick, float3 at)
{
    foreach (var b in ashwick.brambles)
        if (Math.Length(at.xz - b.xy) < b.z) return true;
    return false;
}

// Where a survivor's gun's barrel is as their body holds it (people.tide's pose: from the right shoulder along the aim,
// both hands on it): the shots leave from here.
float3 GunHand(Survivor survivor)
{
    var look = LookDirection(survivor.yaw, survivor.pitch);
    return survivor.feet + Flat(survivor.yaw + Math.PI * 0.5) * GUN_RIGHT + float3(0, GUN_UP, 0) + Flat(survivor.yaw) * GUN_AHEAD + look * GUN_REACH;
}

// What the cursor's on, as its player's machine sent it, no further than `range` from the gun.
float3 AimedAt(Survivor survivor, float range)
{
    var hand = GunHand(survivor);
    var off = survivor.aim - hand;
    var length = Math.Length(off);
    return length > range ? hand + off / length * range : survivor.aim;
}

// How far along a line (0 to 1; more than 1 for nothing) the first wall, ground or one of the dead is.
float FirstHit(float3 from, float3 to, Ashwick ashwick, Herd herd)
{
    mut var first = LongRay(ashwick, from, to, out _);
    foreach (var z in Along(herd, from, Math.Lerp(from, to, Math.Min(1, first))))
    {
        if (!z.hittable) continue;
        var spots = SpotsOf(z, herd);
        var body = Math.Min(Math.Min(SphereHit(from, to, z.chest, spots.chestRadius), SphereHit(from, to, z.hips, 0.33 * z.size)), LegsHit(from, to, z, 0));
        var bulk = ColumnHit(from, to, spots.base, spots.columnRadius, spots.columnHigh);
        first = Math.Min(first, Math.Min(Math.Min(SphereHit(from, to, z.head, spots.headRadius), body), bulk));
    }
    return first;
}

// How far along a line (0 to 1; 2 for none) the first of the dead is, which, and what of it: 1 its head, 2 a boss's
// weak spot, 0 the rest. eye.tide's Pointing, for what the cursor's on.
float BodyFirst(float3 from, float3 to, Herd herd, out Body hit, out int part)
{
    mut var first = 2.0;
    mut var found = Body { };
    mut var which = 0;
    foreach (var z in Along(herd, from, to))
    {
        if (!z.hittable) continue;
        var spots = SpotsOf(z, herd);
        var head = SphereHit(from, to, z.head, spots.headRadius);
        var weak = spots.weakRadius > 0 ? SphereHit(from, to, spots.weak, spots.weakRadius) : 2.0;
        var rest = Math.Min(Math.Min(SphereHit(from, to, z.chest, spots.chestRadius), SphereHit(from, to, z.hips, 0.33 * z.size)),
                            Math.Min(LegsHit(from, to, z, 0), ColumnHit(from, to, spots.base, spots.columnRadius, spots.columnHigh)));
        var at = Math.Min(Math.Min(head, weak), rest);
        if (at >= first) continue;
        first = at;
        found = z;
        which = weak <= at ? 2 : head <= at ? 1 : 0;
    }
    hit = found;
    part = which;
    return first;
}

// Where along a segment (0 to 1; 2 for never) it first meets an upright column `radius` round `base` and `high` tall,
// by its side or, coming down on it, its top (a boss's bulk; none at a radius of 0).
float ColumnHit(float3 from, float3 to, float3 base, float radius, float high)
{
    if (radius <= 0) return 2;
    var way = to - from;
    var top = base.y + high;
    var off = from.xz - base.xz;
    if (Math.Dot(off, off) <= radius * radius && from.y >= base.y && from.y <= top) return 0;
    mut var first = 2.0;
    var a = Math.Dot(way.xz, way.xz);
    if (a > 0.0000001)
    {
        var b = Math.Dot(off, way.xz);
        var c = Math.Dot(off, off) - radius * radius;
        var d = b * b - a * c;
        if (d >= 0)
        {
            var t = (-b - Math.Sqrt(d)) / a;
            var y = from.y + way.y * t;
            if (t >= 0 && t <= 1 && y >= base.y && y <= top) first = t;
        }
    }
    if (way.y < -0.0000001 && from.y > top)
    {
        var t = (top - from.y) / way.y;
        var across = off + way.xz * t;
        if (t >= 0 && t < first && t <= 1 && Math.Dot(across, across) <= radius * radius) first = t;
    }
    return first;
}

// The cursor this near a boss's weak spot (for its size) when the round's fired is on it.
const float WEAK_PATCH = 1.15;
// How wide one of the dead is to a level round, at its size: round its line from its hips to its head (upright, about
// one place; lying, along the ground).
const float BODY_HIT = 0.42;

// Where along a segment across the ground (0 to 1; 2 for never) it first comes within `radius` of the line from `a` to
// `b` (a body's hips to its head; a boss's column, a point).
float FlatHit(float2 from, float2 to, float2 a, float2 b, float radius)
{
    var way = to - from;
    var length = Math.Length(way);
    if (length < 0.0001) return 2;
    var dir = way / length;
    mut var best = 2.0;
    for (var k = 0; k <= 4; k++)
    {
        var p = Math.Lerp(a, b, k / 4.0);
        var along = Math.Dot(p - from, dir);
        if (along < -radius || along > length + radius) continue;
        var off = Math.Length(from + dir * along - p);
        if (off > radius) continue;
        best = Math.Min(best, Math.Max(0, along - Math.Sqrt(radius * radius - off * off)) / length);
    }
    return best;
}
// The cursor this near one of the dead's head (for its size) when the round's fired: a headshot, whatever of it the
// round goes into first.
const float AIM_HEAD = 1.25;

// Where a survivor's shots start, and which way they go: from the gun in their hand toward what the cursor is on (or,
// when that's right at the gun, the way they face).
float3 AimFrom(Survivor survivor, float range, out float3 way)
{
    var look = LookDirection(survivor.yaw, survivor.pitch);
    var hand = GunHand(survivor);
    var line = AimedAt(survivor, range) - hand;
    var length = Math.Length(line);
    way = length > 0.8 && Math.Dot(line / length, look) > 0.5 ? line / length : look;
    return hand;
}

const float GUN_RIGHT = 0.12;
const float GUN_UP = 1.36;
const float GUN_AHEAD = 0.08;
const float GUN_REACH = 0.45;

void StartAct(mut Survivor survivor, Act act, float seconds)
{
    survivor.act = act;
    survivor.actTime = 0;
    survivor.actLength = seconds;
}

// A round from `from` along `way`: the dead in its line, nearest first, as many as it goes through, then the wall or the
// ground it ends in. What it hits is wounded through the items (Land); with HE Rounds it bursts on the first (a pellet's
// as often as it sets items off). What it leaves is a tracer and, in a wall, a chip. The gun's cards: a headshot goes on
// through `headPierce` more (Marksman), `ignite` sets what it strikes alight (an incendiary round, a dragon shell), its
// tracer `weight` times as thick (Heavy Caliber), pushing `push` times as hard, and within CONCUSS_NEAR knocking one down
// `down` of the time (Concussion Shells).
void Shoot(Arms arms, float3 from, float3 way, float range, float damage, float head, int pierce, Ashwick ashwick, Herd herd, Trace kind, float chance, float3 aim,
           int headPierce = 0, bool ignite = false, float weight = 1, float push = 1, float down = 0)
{
    // Level, across the ground (the owner, 2026-10-18: "when i shoot from a slight slope i completely miss the zombies,
    // we should likely ignore elevation"): the round keeps the gun's height, goes over the ground's rise and fall, is
    // stopped only by what stands up from it, and strikes the dead by where they stand, not how high
    var flat = Math.Length(way.xz);
    var level = flat > 0.001 ? float3(way.x / flat, 0, way.z / flat) : way;
    var to = from + level * range;
    var wall = WallRay(ashwick, from, to, out var normal);
    var stop = Math.Lerp(from, to, Math.Min(1, wall));
    mut List<Body> struck = [];
    mut List<float> when = [];
    mut List<bool> heads = [];
    mut List<bool> weaks = [];
    foreach (var z in Along(herd, from, stop))
    {
        if (!z.hittable) continue;
        var spots = SpotsOf(z, herd);
        var first = spots.columnRadius > 0 ? FlatHit(from.xz, to.xz, spots.base.xz, spots.base.xz, spots.columnRadius)
                                           : FlatHit(from.xz, to.xz, z.hips.xz, z.head.xz, BODY_HIT * z.size);
        if (first > 1 || first > wall) continue;
        mut var at = struck.count;
        while (at > 0 && when[at - 1] > first) at -= 1;
        struck.Insert(at, z);
        when.Insert(at, first);
        // The cursor on its head makes it a headshot, on a boss's weak spot (on the side of it facing the round) a weak
        // hit (the owner, 2026-10-18: "if you shoot while aiming at the head it deals a headshot")
        var aimedWeak = spots.weakRadius > 0 && Math.Length(aim - spots.weak) <= spots.weakRadius * WEAK_PATCH
                        && Math.Dot(spots.weakFace.xz, (from - spots.base).xz) >= 0;
        var aimedHead = Math.Length(aim - z.head) <= spots.headRadius * AIM_HEAD;
        weaks.Insert(at, aimedWeak);
        heads.Insert(at, !aimedWeak && aimedHead);
    }
    var knock = (kind == Trace.Phase ? 3.0 : kind == Trace.Pellet || kind == Trace.Ember ? 1.5 : 1.0) * push;
    mut var end = Math.Min(1, wall);
    // So many of the dead in its line as it goes through (a headshot, with Marksman, taking it on through more)
    mut var left = pierce;
    mut var count = 0;
    for (var i = 0; i < struck.count && left > 0; i++)
    {
        mut var dealt = weaks[i] ? damage * SpotsOf(struck[i], herd).weakTimes : heads[i] ? damage * head : damage;
        // A boss takes a pellet at half: every one of a shotgun's eleven finds something that big, and it had done twice
        // what the carbine and the SMG do to one (boss.tide's BOSS_PELLET)
        if ((kind == Trace.Pellet || kind == Trace.Ember) && struck[i].boss >= 0) dealt *= BOSS_PELLET;
        var downed = down > 0 && Math.Length((struck[i].at - from).xz) < CONCUSS_NEAR && Random.NextFloat() < down;
        Land(arms, struck[i], dealt, heads[i], weaks[i], from, knock, chance, herd, true, ignite: ignite, down: downed);
        count += 1;
        left -= 1;
        if (heads[i]) left += headPierce;
        if (left == 0) end = when[i];
    }
    // Ricochet Rounds: on from the last it struck (a pellet's as often as it sets items off)
    var bounces = Holds(arms, Item.Ricochet);
    if (count > 0 && bounces > 0 && Random.NextFloat() < chance) Ricochet(arms, struck[count - 1], damage * 0.6, bounces, herd);
    if (count > 0 && Holds(arms, Item.HeRounds) > 0)
    {
        var roll = Random.NextFloat();
        if (roll < chance) Detonate(arms, struck[0], Math.Lerp(from, to, when[0]), damage, herd);
    }
    Send(Traced { seat = arms.seat, from = from, to = Math.Lerp(from, to, end), kind = kind, weight = weight });
    if (wall <= 1 && left > 0) Send(Thud { at = Math.Lerp(from, to, wall), normal = normal });
}

// A flamethrower's puff: every one of the dead in its cone, `reach` ahead of the nozzle across the ground (short of what
// stands in the way) and `cone` metres either side of the aim for each metre out, and any close by in front; the
// `most` nearest (FLAME_MOST, more with a Wide Nozzle). Each takes it through the items (Land, as a Blow.Flame), no
// shove or reel, and catches fire one puff in `ignite` (FLAME_IGNITE, more with Sticky Fuel). The flames go through them:
// there's no round to stop.
void Scorch(Arms arms, float3 from, float3 way, float reach, float cone, float damage, float chance, Ashwick ashwick, Herd herd, int most, float ignite)
{
    var flat = Math.Length(way.xz);
    var level = flat > 0.001 ? float3(way.x / flat, 0, way.z / flat) : float3(0, 0, 1);
    var wall = WallRay(ashwick, from, from + level * reach, out _);
    var far = reach * Math.Min(1, wall);
    mut List<Body> caught = [];
    mut List<float> nears = [];
    foreach (var z in Near(herd, from + level * (far * 0.5), far * 0.5 + 2))
    {
        if (!z.hittable) continue;
        var spots = SpotsOf(z, herd);
        var size = spots.columnRadius > 0 ? spots.columnRadius : BODY_HIT * z.size;
        var to = (spots.columnRadius > 0 ? spots.base : z.at) - from;
        var along = to.x * level.x + to.z * level.z;
        var side = Math.Abs(to.x * level.z - to.z * level.x);
        var d = Math.Length(to.xz);
        if (along < -size || d > far + size) continue;
        if (d > FLAME_NEAR && side > Math.Max(0, along) * cone + size) continue;
        mut var at = caught.count;
        while (at > 0 && nears[at - 1] > d) at -= 1;
        caught.Insert(at, z);
        nears.Insert(at, d);
    }
    for (var i = 0; i < Math.Min(caught.count, most); i++)
    {
        var roll = Random.NextFloat();
        Land(arms, caught[i], damage, false, false, from, -1, chance, herd, true, Blow.Flame, roll < ignite);
    }
}

const float FLAME_NEAR = 1.3;       // Within this, any of the dead in front is in the flames, whatever the cone
const int FLAME_MOST = 14;          // A puff reaches so many of the dead at most, the nearest
const float FLAME_IGNITE = 0.06;    // How likely a puff is to set one it reaches alight (about a second in the flames)
const float FLAME_BOSS = 3.5;       // A boss takes a puff so many times over: a great body in the flames, and the fire can't catch on it

// The dead whose feet are near a segment (within a lying body's length of it), row by row of the herd's cells.
List<Body> Along(Herd herd, float3 from, float3 to)
{
    mut List<Body> found = [];
    if (herd.first.count == 0) return found;
    var pad = 1.6 / HERD_CELL;
    var x0 = (from.x - NAV_X0) / HERD_CELL;
    var z0 = (from.z - NAV_Z0) / HERD_CELL;
    var x1 = (to.x - NAV_X0) / HERD_CELL;
    var z1 = (to.z - NAV_Z0) / HERD_CELL;
    var rowLo = Math.Clamp(int(Math.Floor(Math.Min(z0, z1) - pad)), 0, HERD_W - 1);
    var rowHi = Math.Clamp(int(Math.Floor(Math.Max(z0, z1) + pad)), 0, HERD_W - 1);
    for (var cz = rowLo; cz <= rowHi; cz++)
    {
        // Where the segment is while it's within the pad of this row
        var bandLo = cz - pad;
        var bandHi = cz + 1 + pad;
        mut var t0 = 0.0;
        mut var t1 = 1.0;
        var dz = z1 - z0;
        if (Math.Abs(dz) < 0.000001)
        {
            if (z0 < bandLo || z0 > bandHi) continue;
        }
        else
        {
            var ta = (bandLo - z0) / dz;
            var tb = (bandHi - z0) / dz;
            t0 = Math.Max(0, Math.Min(ta, tb));
            t1 = Math.Min(1, Math.Max(ta, tb));
            if (t0 > t1) continue;
        }
        var xa = x0 + (x1 - x0) * t0;
        var xb = x0 + (x1 - x0) * t1;
        var colLo = Math.Clamp(int(Math.Floor(Math.Min(xa, xb) - pad)), 0, HERD_W - 1);
        var colHi = Math.Clamp(int(Math.Floor(Math.Max(xa, xb) + pad)), 0, HERD_W - 1);
        for (var cx = colLo; cx <= colHi; cx++)
        {
            mut var slot = herd.first[cz * HERD_W + cx];
            while (slot >= 0)
            {
                found.Add(herd.bodies[slot]);
                slot = herd.next[slot];
            }
        }
    }
    return found;
}

// A blow to a survivor: health, and down at none (or straight back up, with a Second Wind).
event(Hurt hurt) TakeHurt(mut Survivor survivor, Match match)
{
    if (survivor.life != Life.Standing || match.phase == Phase.Over) return;
    // Rolling: dodged
    if (Guarded(survivor))
    {
        Send(Dodged { seat = survivor.seat, at = survivor.feet });
        return;
    }
    survivor.health -= hurt.damage * (1 - Armor(survivor));
    survivor.calm = 0;
    survivor.hurtFrom = YawTo(survivor.feet, hurt.from);
    Send(Cue { sound = Sfx.Hurt, at = survivor.feet + float3(0, 1.4, 0) });
    if (survivor.health > 0) return;
    if (survivor.selfRevives > 0)
    {
        survivor.selfRevives -= 1;
        survivor.items[int(Item.SecondWind)] -= 1;
        survivor.health = MaxHealth(survivor);
        Send(Cue { sound = Sfx.Revive, at = survivor.feet });
        Send(Winded { seat = survivor.seat, at = survivor.feet, left = survivor.selfRevives });
        return;
    }
    survivor.health = 0;
    survivor.life = Life.Downed;
    survivor.bleed = BLEED_SECONDS;
    survivor.downs += 1;
    survivor.revive = 0;
    survivor.reviver = -1;
    // The pistol, down: what was in the gun is kept for when they're up
    survivor.stowed = survivor.mag;
    survivor.gun = Weapon.Pistol;
    survivor.mag = Info(Weapon.Pistol).mag;
    survivor.act = Act.Raise;
    survivor.actTime = 0;
    survivor.actLength = 0.4;
    survivor.roll = 0;
    survivor.velocity = float3(0);
    Send(Cue { sound = Sfx.Downed, at = survivor.feet });
}

event Revived
{
    int seat;
    int by;
}

// A Second Wind used: a survivor who'd have gone down straight back up, whole, for what's seen and heard (the owner,
// 2026-10-20: "second wind needs to be clear when it was used"). `left`: how many more they have.
event Winded
{
    int seat;
    float3 at;
    int left;
}

// What fired: the gun, a phase round, a turret, a drone.
enum Source { Gun, Phase, Turret, Drone }

// A shot, for what's heard and felt: the trigger pulled.
event Loosed
{
    int seat;
    Weapon weapon;
    float3 at;
    float3 way;                 // The way it was aimed
    Source source;
    float reach;                // How far it reaches (a flamethrower's fire is drawn as far)...
    float cone;                 // ...and how wide (Wide Nozzle)
    int heat;                   // Hot Fuel's ranks: its fire burns brighter, then blue
    int rank = 1;               // The gun's level (its cards' ranks and one)
}

// What a round's line looks like: an incendiary round's (Fire), a dragon shell's pellet (Ember) and a slug's are the gun
// cards'.
enum Trace { Bullet, Pellet, Phase, Turret, Drone, Bounce, Shard, Fire, Ember, Slug }

// A round's line, from the eye (or a turret's or a drone's gun) to where it stopped.
event Traced
{
    int seat;
    float3 from;
    float3 to;
    Trace kind;
    float weight = 1;           // How thick, against its kind's (Heavy Caliber's rounds)
}

// Live Wire's arc, from one of the dead to the next.
event Spell
{
    int seat;
    float3 from;
    float3 to;
}

// A roll's charges coming back: when the cooldown's come round with one spent, another's ready (one at a time, each
// the whole cooldown; with none ready, the roll's cooldown is the wait for the next). With Kerosene, the dead it
// passes catch fire (it doesn't knock them about: it's a dodge).
[Stage(Tick.Hands, 2)]
system Rolling(mut Survivor survivor, Match match, Herd herd, Time time)
{
    if (match.paused || !survivor.ready || survivor.life != Life.Standing) return;
    var most = RollCharges(survivor);
    if (survivor.rolls < most)
    {
        survivor.rollWait -= time.dt;
        if (survivor.rollWait <= 0)
        {
            survivor.rolls += 1;
            survivor.rollWait = survivor.rolls < most ? Cooldown(survivor, Skill.Roll) : 0;
        }
        if (survivor.rolls == 0) survivor.cooldowns[1] = survivor.rollWait;
    }
    var kerosene = Has(survivor, Item.Kerosene);
    if (survivor.roll <= 0 || kerosene == 0) return;
    var reach = 0.9 + 0.4 * kerosene;
    foreach (var z in Near(herd, survivor.feet, reach + 0.5))
    {
        if (!z.hittable || z.risen < 1 || Math.Length((z.at - survivor.feet).xz) > reach * z.size) continue;
        z.entity.Send(Wound { damage = 5 * Might(survivor), seat = survivor.seat, from = survivor.feet, blow = Blow.Blunt, element = Element.Fire });
    }
}

// A blow the roll's guard took instead of a survivor, for what's seen and heard.
event Dodged
{
    int seat;
    float3 at;
}
