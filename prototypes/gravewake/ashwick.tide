// What the match keeps of the plan: the boxes, the risers and the starts, and
// a grid of metre cells over the clearing that says where the dead can walk
// (not through boxes, not up or down the cliffs, not past the edge). Every few ticks the dead's way is worked out over that grid:
// how far each cell is from the nearest survivor on their feet, and each
// zombie walks downhill.

// The tick, in order.
enum Tick { Restart, Survivors, Hands, Missiles, Zombies, Field, Rounds, Late }

const float CELL = 1;
const float NAV_X0 = -78;
const float NAV_Z0 = -78;
const int NAV_W = 156;            // To x 78
const int NAV_H = 156;            // To z 78
const float BUCKET = 8;
const int BUCKETS_W = 20;         // 160 m
const int BUCKETS_H = 20;
const float STEEP = 0.6;          // Ground that climbs more than this a metre is a cliff: the dead pile up its face
const int CLIMB_COST = 5;         // A step up a cliff's face, to the dead's way, against one of open ground (down or along it, one)
const int CLIMB_RISE = 4;         // ...a step up being one whose cell is this much higher (Ashwick.heights' steps: half a metre)
const float CLIMB_RATE = 1.3;     // How fast the dead climb onto each other, metres up a second (a sprinter half again)
const float LAYER = 0.55;         // How much higher one of the dead is, on another (a body lying under it)
const float FALL_SPEED = 5;       // How fast the dead come down off a pile with nothing under them
const float SCRAMBLE = 1.1;       // A ledge this much above a step the dead get up alone; higher, only on each other
const int UNREACHED = 255;        // A cell nothing reaches

singleton Ashwick
{
    List<Solid> solids;
    List<List<int>> buckets;      // The solids near each 8 m square, by bucket
    List<Riser> risers;
    List<float3> starts;
    List<byte> cells;             // 0 open, 1 a wall (a box, or the forest past the clearing's edge), 2 a cliff
    List<float> ledges;           // By cliff cell: the top of the cliff there (the highest ground within two cells)
    List<byte> heights;           // By cell: the ground at its middle, in eighths of a metre from 4 m down (HeightStep)
    List<byte> field;             // Cells to the nearest survivor, UNREACHED where none can be reached
    List<float3> brambles;        // The bramble thickets (plan.tide): x, z, reach
    bool made;
}

int BucketOf(float x, float z)
{
    var bx = Math.Clamp(int(Math.Floor((x - NAV_X0) / BUCKET)), 0, BUCKETS_W - 1);
    var bz = Math.Clamp(int(Math.Floor((z - NAV_Z0) / BUCKET)), 0, BUCKETS_H - 1);
    return bz * BUCKETS_W + bx;
}

int CellOf(float3 at)
{
    var cx = int(Math.Floor((at.x - NAV_X0) / CELL));
    var cz = int(Math.Floor((at.z - NAV_Z0) / CELL));
    if (cx < 0 || cz < 0 || cx >= NAV_W || cz >= NAV_H) return -1;
    return cz * NAV_W + cx;
}

float3 CellMiddle(int cell)
{
    var cx = cell % NAV_W;
    var cz = cell / NAV_W;
    return float3(NAV_X0 + (cx + 0.5) * CELL, 0, NAV_Z0 + (cz + 0.5) * CELL);
}

void BuildAshwick(mut Ashwick ashwick)
{
    var plan = MakePlan();
    ashwick.solids = plan.solids;
    ashwick.risers = plan.risers;
    ashwick.starts = plan.starts;
    ashwick.brambles = plan.brambles;
    ashwick.buckets.Clear();
    for (var b = 0; b < BUCKETS_W * BUCKETS_H; b++)
    {
        List<int> none = [];
        ashwick.buckets.Add(none);
    }
    for (var i = 0; i < ashwick.solids.count; i++)
    {
        var solid = ashwick.solids[i];
        var lo = solid.center - solid.half - float3(1);
        var hi = solid.center + solid.half + float3(1);
        var b0x = Math.Clamp(int(Math.Floor((lo.x - NAV_X0) / BUCKET)), 0, BUCKETS_W - 1);
        var b0z = Math.Clamp(int(Math.Floor((lo.z - NAV_Z0) / BUCKET)), 0, BUCKETS_H - 1);
        var b1x = Math.Clamp(int(Math.Floor((hi.x - NAV_X0) / BUCKET)), 0, BUCKETS_W - 1);
        var b1z = Math.Clamp(int(Math.Floor((hi.z - NAV_Z0) / BUCKET)), 0, BUCKETS_H - 1);
        for (var bz = b0z; bz <= b1z; bz++)
            for (var bx = b0x; bx <= b1x; bx++)
                ashwick.buckets[bz * BUCKETS_W + bx].Add(i);
    }
    // The cells: a wall where a box stands taller than a step above the ground
    ashwick.cells.Resize(NAV_W * NAV_H);
    for (var c = 0; c < NAV_W * NAV_H; c++) ashwick.cells[c] = 0;
    foreach (var solid in ashwick.solids)
    {
        if (solid.center.y + solid.half.y - Ground(solid.center.x, solid.center.z) < 0.6) continue;
        // Every cell the box (and a little round it) overlaps: a fence thinner than a cell walls its cells too
        var grow = 0.12;
        var lo = solid.center - solid.half - float3(grow, 0, grow);
        var hi = solid.center + solid.half + float3(grow, 0, grow);
        var c0x = Math.Max(0, int(Math.Floor((lo.x - NAV_X0) / CELL)));
        var c0z = Math.Max(0, int(Math.Floor((lo.z - NAV_Z0) / CELL)));
        var c1x = Math.Min(NAV_W - 1, int(Math.Floor((hi.x - NAV_X0) / CELL)));
        var c1z = Math.Min(NAV_H - 1, int(Math.Floor((hi.z - NAV_Z0) / CELL)));
        for (var cz = c0z; cz <= c1z; cz++)
        {
            for (var cx = c0x; cx <= c1x; cx++) ashwick.cells[cz * NAV_W + cx] = 1;
        }
    }
    // Past the clearing's edge is nobody's ground: walls there, so the field stays in the clearing. A cliff in it the
    // dead climb (survivors can't): so nowhere high is out of their reach, and they come up every side of it
    for (var c = 0; c < NAV_W * NAV_H; c++)
    {
        var middle = CellMiddle(c);
        if (!InClearing(middle)) ashwick.cells[c] = 1;
        else if (ashwick.cells[c] == 0 && Steepness(middle.x, middle.z) > STEEP) ashwick.cells[c] = 2;
    }
    // Each cliff cell's ledge: what the dead have to be up to, on each other, to go over it
    ashwick.ledges.Resize(NAV_W * NAV_H);
    for (var c = 0; c < NAV_W * NAV_H; c++)
    {
        ashwick.ledges[c] = 0;
        if (ashwick.cells[c] != 2) continue;
        var cx = c % NAV_W;
        var cz = c / NAV_W;
        mut var top = -100.0;
        for (var dz = -2; dz <= 2; dz++)
        {
            for (var dx = -2; dx <= 2; dx++)
            {
                var nx = Math.Clamp(cx + dx, 0, NAV_W - 1);
                var nz = Math.Clamp(cz + dz, 0, NAV_H - 1);
                var middle = CellMiddle(nz * NAV_W + nx);
                top = Math.Max(top, Ground(middle.x, middle.z));
            }
        }
        ashwick.ledges[c] = top;
    }
    ashwick.heights.Resize(NAV_W * NAV_H);
    for (var c = 0; c < NAV_W * NAV_H; c++)
    {
        var middle = CellMiddle(c);
        ashwick.heights[c] = HeightStep(Ground(middle.x, middle.z));
    }
    ashwick.field.Resize(NAV_W * NAV_H);
    for (var c = 0; c < NAV_W * NAV_H; c++) ashwick.field[c] = byte(UNREACHED);
    ashwick.made = true;
}

// A height as Ashwick.heights keeps it: eighths of a metre from 4 m below the fire, 0 to 255.
byte HeightStep(float height)
{
    return byte(Math.Clamp(int(Math.Round((height + 4) * 8)), 0, 255));
}

// Whether the dead can go in a cell: walk it, or climb it.
bool Walkable(Ashwick ashwick, int cell)
{
    return cell >= 0 && ashwick.cells[cell] != 1;
}

// Whether a cell is open ground (not a cliff), where the dead can rise.
bool Open(Ashwick ashwick, int cell)
{
    return cell >= 0 && ashwick.cells[cell] == 0;
}

// Whether a cell is a cliff the dead climb.
bool Cliff(Ashwick ashwick, int cell)
{
    return cell >= 0 && ashwick.cells[cell] == 2;
}

// Whether one of the dead `up` metres high can step from `before` to `at`: anywhere but up a cliff, and up into a
// cliff only when its ledge is within a scramble (a bank, a low ledge) or a pile has it up that near. Within a cliff's
// cells a step may rise as walkable ground does (along its face, or off it over ground that climbs a little away
// from it); one that rose not at all had held the dead in the band of cliff cells at a face's foot for good, where the
// ground beyond climbed a hair.
bool Reaches(Ashwick ashwick, float3 before, float3 at, float up)
{
    var cell = CellOf(at);
    if (!Cliff(ashwick, cell) || up >= ashwick.ledges[cell] - STEP_UP - SCRAMBLE) return true;
    return Ground(at.x, at.z) - Ground(before.x, before.z) <= STEEP * Math.Length((at - before).xz) + 0.001;
}

// How high a boss may go in a step of `dt` up a cliff (it climbs, slowly, on its own): a step that would rise more is
// cut short to what it may.
float3 Climbed(Ashwick ashwick, float3 before, float3 at, float rate, float dt)
{
    if (!Cliff(ashwick, CellOf(at)) && !Cliff(ashwick, CellOf(before))) return at;
    var rise = Ground(at.x, at.z) - before.y;
    var most = rate * dt;
    if (rise <= most) return at;
    var part = most / rise;
    return float3(before.x + (at.x - before.x) * part, at.y, before.z + (at.z - before.z) * part);
}

// ---- Bodies against the boxes ----

// The highest floor under a circle, no more than a step above `current`: the ground, or a box on it.
float GroundUnder(Ashwick ashwick, float3 feet, float radius, float current)
{
    mut var ground = Ground(feet.x, feet.z);
    var bucket = BucketOf(feet.x, feet.z);
    var count = ashwick.buckets[bucket].count;
    for (var k = 0; k < count; k++)
    {
        var solid = ashwick.solids[ashwick.buckets[bucket][k]];
        var top = solid.center.y + solid.half.y;
        if (top > current + STEP_UP + 0.001 || top <= ground) continue;
        if (Math.Abs(feet.x - solid.center.x) > solid.half.x + radius || Math.Abs(feet.z - solid.center.z) > solid.half.z + radius) continue;
        ground = top;
    }
    return ground;
}

// A circle pushed out of every box its height meets, a few times over.
float3 PushOut(Ashwick ashwick, float3 feet, float radius, float high)
{
    mut var at = feet;
    var bucket = BucketOf(feet.x, feet.z);
    var count = ashwick.buckets[bucket].count;
    for (var pass = 0; pass < 3; pass++)
    {
        for (var k = 0; k < count; k++)
        {
            var solid = ashwick.solids[ashwick.buckets[bucket][k]];
                var bottom = solid.center.y - solid.half.y;
            var top = solid.center.y + solid.half.y;
            if (top <= at.y + STEP_UP || bottom >= at.y + high) continue;
            var lo = solid.center.xz - solid.half.xz;
            var hi = solid.center.xz + solid.half.xz;
            var closest = Math.Clamp(at.xz, lo, hi);
            var off = at.xz - closest;
            var far = Math.Length(off);
            if (far >= radius) continue;
            if (far > 0.0001)
            {
                var out = off / far * (radius - far);
                at.x += out.x;
                at.z += out.y;
                continue;
            }
            // Inside it: out the nearest side
            var left = at.x - lo.x;
            var right = hi.x - at.x;
            var down = at.z - lo.y;
            var up = hi.y - at.z;
            var least = Math.Min(Math.Min(left, right), Math.Min(down, up));
            if (least == left) at.x = lo.x - radius;
            else if (least == right) at.x = hi.x + radius;
            else if (least == down) at.z = lo.y - radius;
            else at.z = hi.y + radius;
        }
    }
    return at;
}

// Where a line from `from` first meets a box or (with `ground`) the ground, as a fraction of the way to `to` (2 for
// nothing on the way), and that box's face.
float RayHit(Ashwick ashwick, float3 from, float3 to, bool ground, out float3 normal)
{
    normal = float3(0, 1, 0);
    var way = to - from;
    mut var best = 1.0;
    mut var hit = false;
    // The ground: the first of a few points along the line that's under it, then halved down to where it goes in
    mut var above = 0.0;
    for (var step = 1; step <= (ground ? 4 : 0); step++)
    {
        var t = step / 4.0;
        var at = from + way * t;
        if (at.y >= Ground(at.x, at.z))
        {
            above = t;
            continue;
        }
        mut var lo = above;
        mut var hi = t;
        for (var k = 0; k < 6; k++)
        {
            var mid = (lo + hi) * 0.5;
            var there = from + way * mid;
            if (there.y >= Ground(there.x, there.z)) lo = mid;
            else hi = mid;
        }
        best = hi;
        var where = from + way * hi;
        normal = Math.Normalize(float3(Ground(where.x - 0.25, where.z) - Ground(where.x + 0.25, where.z), 0.5,
                                       Ground(where.x, where.z - 0.25) - Ground(where.x, where.z + 0.25)));
        hit = true;
        break;
    }
    var middle = (from + to) * 0.5;
    var bucket = BucketOf(middle.x, middle.z);
    var count = ashwick.buckets[bucket].count;
    for (var k = 0; k < count; k++)
    {
        var solid = ashwick.solids[ashwick.buckets[bucket][k]];
        mut var enter = 0.0;
        mut var leave = best;
        mut var missed = false;
        mut var face = float3(0);
        for (var axis = 0; axis < 3; axis++)
        {
            var o = axis == 0 ? from.x : axis == 1 ? from.y : from.z;
            var d = axis == 0 ? way.x : axis == 1 ? way.y : way.z;
            var c = axis == 0 ? solid.center.x : axis == 1 ? solid.center.y : solid.center.z;
            var h = axis == 0 ? solid.half.x : axis == 1 ? solid.half.y : solid.half.z;
            if (Math.Abs(d) < 0.000001)
            {
                if (Math.Abs(o - c) > h) missed = true;
                continue;
            }
            var a = (c - h - o) / d;
            var b = (c + h - o) / d;
            var near = Math.Min(a, b);
            if (near > enter)
            {
                enter = near;
                var sign = d > 0 ? -1.0 : 1.0;
                face = float3(axis == 0 ? sign : 0, axis == 1 ? sign : 0, axis == 2 ? sign : 0);
            }
            leave = Math.Min(leave, Math.Max(a, b));
        }
        if (missed || enter >= leave || enter <= 0) continue;
        if (enter < best)
        {
            best = enter;
            normal = face;
            hit = true;
        }
    }
    return hit ? best : 2.0;
}

// RayHit along a line of any length, the ground and the boxes.
float LongRay(Ashwick ashwick, float3 from, float3 to, out float3 normal)
{
    return Ray(ashwick, from, to, true, out normal);
}

// ...the boxes alone: a round going level over the ground, whatever its rise and fall (hands.tide's Shoot).
float WallRay(Ashwick ashwick, float3 from, float3 to, out float3 normal)
{
    return Ray(ashwick, from, to, false, out normal);
}

// RayHit along a line of any length: a few metres at a time, as RayHit looks for the boxes near each piece's middle.
float Ray(Ashwick ashwick, float3 from, float3 to, bool ground, out float3 normal)
{
    normal = float3(0, 1, 0);
    var steps = Math.Max(1, int(Math.Ceil(Math.Distance(from, to) / 2)));
    for (var i = 0; i < steps; i++)
    {
        var a = Math.Lerp(from, to, float(i) / steps);
        var b = Math.Lerp(from, to, float(i + 1) / steps);
        var t = RayHit(ashwick, a, b, ground, out var n);
        if (t <= 1)
        {
            normal = n;
            return (i + t) / steps;
        }
    }
    return 2;
}

// Whether the line between two places at the height of a body's middle crosses no wall cell.
bool ClearPath(Ashwick ashwick, float3 a, float3 b)
{
    var way = b - a;
    var far = Math.Length(way.xz);
    var steps = int(far / (CELL * 0.5)) + 1;
    for (var i = 1; i < steps; i++)
    {
        var at = a + way * (float(i) / steps);
        if (!Walkable(ashwick, CellOf(at))) return false;
    }
    return true;
}

// ---- The dead's way ----

// Every few ticks: how far each walkable cell is from the nearest standing survivor.
[Stage(Tick.Field)]
system Wayfinding(mut Ashwick ashwick, Time time, query (Survivor survivor) survivors)
{
    if (!ashwick.made || time.tick % 6 != 0) return;
    mut List<int> sources = [];
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (s.life != Life.Standing || !s.ready) continue;
        Seed(ashwick, sources, s.feet);
    }
    if (sources.count == 0)
    {
        foreach (var row in survivors)
        {
            if (row.survivor.life != Life.Downed) continue;
            Seed(ashwick, sources, row.survivor.feet);
        }
    }
    Spread(ashwick, sources);
}

// Where the field starts for a survivor: their cell; and if that's a wall's (beside a wall, by the chest), the cells the
// dead can go in round it, within a metre and a half and in plain reach (no box between, so not the far side of the
// wall), so the way still leads to them. A wall's cell the dead never step in: from it the field had spread, and the
// dead beside it, with nowhere lower they could go, stood still.
void Seed(Ashwick ashwick, mut List<int> sources, float3 feet)
{
    var cell = CellOf(feet);
    if (cell < 0) return;
    sources.Add(cell);
    if (Walkable(ashwick, cell)) return;
    var cx = cell % NAV_W;
    var cz = cell / NAV_W;
    for (var dz = -2; dz <= 2; dz++)
    {
        for (var dx = -2; dx <= 2; dx++)
        {
            var nx = cx + dx;
            var nz = cz + dz;
            if (nx < 0 || nz < 0 || nx >= NAV_W || nz >= NAV_H) continue;
            var next = nz * NAV_W + nx;
            if (!Walkable(ashwick, next)) continue;
            var middle = CellMiddle(next);
            if (Math.Length((middle - feet).xz) > 1.6) continue;
            var chest = feet + float3(0, 1, 0);
            if (RayHit(ashwick, chest, float3(middle.x, Ground(middle.x, middle.z) + 1, middle.z), true, out _) <= 1) continue;
            sources.Add(next);
        }
    }
}

// A walk out from the sources over the cells the dead can go in, counting how far: a step of open ground 1, and one of
// the dead would take up a cliff's face (from a cell lower by CLIMB_RISE, one of the two a cliff's) CLIMB_COST. So
// they go up a face, piling up it, unless the way round is only a few metres longer (a low ramp's side, which the
// stragglers beside it had pressed against for good, too few of them to pile up it). A cell is walked again when a
// shorter way to it turns up.
void Spread(mut Ashwick ashwick, List<int> sources)
{
    var total = NAV_W * NAV_H;
    for (var c = 0; c < total; c++) ashwick.field[c] = byte(UNREACHED);
    mut List<int> queue = [];
    foreach (var cell in sources)
    {
        ashwick.field[cell] = 0;
        queue.Add(cell);
    }
    mut var head = 0;
    while (head < queue.count)
    {
        var cell = queue[head];
        head += 1;
        var here = int(ashwick.field[cell]);
        var cx = cell % NAV_W;
        var cz = cell / NAV_W;
        for (var n = 0; n < 4; n++)
        {
            var nx = cx + (n == 0 ? 1 : n == 1 ? -1 : 0);
            var nz = cz + (n == 2 ? 1 : n == 3 ? -1 : 0);
            if (nx < 0 || nz < 0 || nx >= NAV_W || nz >= NAV_H) continue;
            var next = nz * NAV_W + nx;
            if (!Walkable(ashwick, next)) continue;
            var face = ashwick.cells[next] == 2 || ashwick.cells[cell] == 2;
            var up = face && int(ashwick.heights[cell]) > int(ashwick.heights[next]) + CLIMB_RISE;
            var far = here + (up ? CLIMB_COST : 1);
            if (far >= UNREACHED || far >= int(ashwick.field[next])) continue;
            ashwick.field[next] = byte(far);
            queue.Add(next);
        }
    }
}

// Which way is downhill from a place: toward the neighbouring cell nearest what draws the dead.
float3 Downhill(Ashwick ashwick, float3 at)
{
    var cell = CellOf(at);
    if (cell < 0) return float3(0);
    var cx = cell % NAV_W;
    var cz = cell / NAV_W;
    var here = int(ashwick.field[cell]);
    mut var best = here;
    mut var way = float3(0);
    for (var dz = -1; dz <= 1; dz++)
    {
        for (var dx = -1; dx <= 1; dx++)
        {
            if (dx == 0 && dz == 0) continue;
            var nx = cx + dx;
            var nz = cz + dz;
            if (nx < 0 || nz < 0 || nx >= NAV_W || nz >= NAV_H) continue;
            var next = nz * NAV_W + nx;
            if (!Walkable(ashwick, next)) continue;
            // A diagonal step needs both of its sides open, not to cut a corner
            if (dx != 0 && dz != 0)
            {
                if (!Walkable(ashwick, cz * NAV_W + nx) || !Walkable(ashwick, nz * NAV_W + cx)) continue;
            }
            var there = int(ashwick.field[next]);
            if (there < best || (there == best && there < here))
            {
                best = there;
                way = CellMiddle(next) - at;
            }
        }
    }
    way.y = 0;
    return Math.Normalize(way);
}

int FieldAt(Ashwick ashwick, float3 at)
{
    var cell = CellOf(at);
    if (cell < 0) return UNREACHED;
    return int(ashwick.field[cell]);
}
