// What the match keeps of the plan: the boxes, the risers and the starts, and
// a grid of metre cells over the clearing that says where the dead can walk
// (not through boxes, not up or down the cliffs, not past the edge). Every few ticks the dead's way is worked out over that grid:
// how far each cell is from the nearest survivor on their feet, and each
// zombie walks downhill.

// The tick, in order.
enum Tick { Restart, Survivors, Hands, Missiles, Zombies, Field, Rounds, Late }

const float CELL = 1;
const float NAV_X0 = -56;
const float NAV_Z0 = -56;
const int NAV_W = 112;            // To x 56
const int NAV_H = 112;            // To z 56
const float BUCKET = 8;
const int BUCKETS_W = 14;
const int BUCKETS_H = 14;
const float STEEP = 0.6;          // Ground that climbs more than this a metre is a cliff: the dead go round
const int UNREACHED = 255;        // A cell nothing reaches

singleton Ashwick
{
    List<Solid> solids;
    List<List<int>> buckets;      // The solids near each 8 m square, by bucket
    List<Riser> risers;
    List<float3> starts;
    List<byte> cells;             // 0 open, 1 a wall (a box, a cliff, or the forest past the clearing's edge)
    List<byte> field;             // Cells to the nearest survivor, UNREACHED where none can be reached
    bool made;
}

int BucketOf(float x, float z)
{
    var bx = Math.Clamp(int(Math.Floor((x - NAV_X0) / BUCKET)), 0, BUCKETS_W - 1);
    var bz = Math.Clamp(int(Math.Floor((z - NAV_Z0) / BUCKET)), 0, BUCKETS_H - 1);
    return bz * BUCKETS_W + bx;
}

int CellOf(float3 at)
{
    var cx = int(Math.Floor((at.x - NAV_X0) / CELL));
    var cz = int(Math.Floor((at.z - NAV_Z0) / CELL));
    if (cx < 0 || cz < 0 || cx >= NAV_W || cz >= NAV_H) return -1;
    return cz * NAV_W + cx;
}

float3 CellMiddle(int cell)
{
    var cx = cell % NAV_W;
    var cz = cell / NAV_W;
    return float3(NAV_X0 + (cx + 0.5) * CELL, 0, NAV_Z0 + (cz + 0.5) * CELL);
}

void BuildAshwick(mut Ashwick ashwick)
{
    var plan = MakePlan();
    ashwick.solids = plan.solids;
    ashwick.risers = plan.risers;
    ashwick.starts = plan.starts;
    ashwick.buckets.Clear();
    for (var b = 0; b < BUCKETS_W * BUCKETS_H; b++)
    {
        List<int> none = [];
        ashwick.buckets.Add(none);
    }
    for (var i = 0; i < ashwick.solids.count; i++)
    {
        var solid = ashwick.solids[i];
        var lo = solid.center - solid.half - float3(1);
        var hi = solid.center + solid.half + float3(1);
        var b0x = Math.Clamp(int(Math.Floor((lo.x - NAV_X0) / BUCKET)), 0, BUCKETS_W - 1);
        var b0z = Math.Clamp(int(Math.Floor((lo.z - NAV_Z0) / BUCKET)), 0, BUCKETS_H - 1);
        var b1x = Math.Clamp(int(Math.Floor((hi.x - NAV_X0) / BUCKET)), 0, BUCKETS_W - 1);
        var b1z = Math.Clamp(int(Math.Floor((hi.z - NAV_Z0) / BUCKET)), 0, BUCKETS_H - 1);
        for (var bz = b0z; bz <= b1z; bz++)
            for (var bx = b0x; bx <= b1x; bx++)
                ashwick.buckets[bz * BUCKETS_W + bx].Add(i);
    }
    // The cells: a wall where a box stands taller than a step above the ground
    ashwick.cells.Resize(NAV_W * NAV_H);
    for (var c = 0; c < NAV_W * NAV_H; c++) ashwick.cells[c] = 0;
    foreach (var solid in ashwick.solids)
    {
        if (solid.center.y + solid.half.y - Ground(solid.center.x, solid.center.z) < 0.6) continue;
        // Every cell the box (and a little round it) overlaps: a fence thinner than a cell walls its cells too
        var grow = 0.12;
        var lo = solid.center - solid.half - float3(grow, 0, grow);
        var hi = solid.center + solid.half + float3(grow, 0, grow);
        var c0x = Math.Max(0, int(Math.Floor((lo.x - NAV_X0) / CELL)));
        var c0z = Math.Max(0, int(Math.Floor((lo.z - NAV_Z0) / CELL)));
        var c1x = Math.Min(NAV_W - 1, int(Math.Floor((hi.x - NAV_X0) / CELL)));
        var c1z = Math.Min(NAV_H - 1, int(Math.Floor((hi.z - NAV_Z0) / CELL)));
        for (var cz = c0z; cz <= c1z; cz++)
        {
            for (var cx = c0x; cx <= c1x; cx++) ashwick.cells[cz * NAV_W + cx] = 1;
        }
    }
    // Past the clearing's edge is nobody's ground, and a cliff nobody walks: walls there too, so the field stays in
    // the clearing and goes round by the ramps
    for (var c = 0; c < NAV_W * NAV_H; c++)
    {
        var middle = CellMiddle(c);
        if (!InClearing(middle) || Steepness(middle.x, middle.z) > STEEP) ashwick.cells[c] = 1;
    }
    ashwick.field.Resize(NAV_W * NAV_H);
    for (var c = 0; c < NAV_W * NAV_H; c++) ashwick.field[c] = byte(UNREACHED);
    ashwick.made = true;
}

// Whether a cell can be walked.
bool Walkable(Ashwick ashwick, int cell)
{
    return cell >= 0 && ashwick.cells[cell] == 0;
}

// ---- Bodies against the boxes ----

// The highest floor under a circle, no more than a step above `current`: the ground, or a box on it.
float GroundUnder(Ashwick ashwick, float3 feet, float radius, float current)
{
    mut var ground = Ground(feet.x, feet.z);
    var bucket = BucketOf(feet.x, feet.z);
    var count = ashwick.buckets[bucket].count;
    for (var k = 0; k < count; k++)
    {
        var solid = ashwick.solids[ashwick.buckets[bucket][k]];
        var top = solid.center.y + solid.half.y;
        if (top > current + STEP_UP + 0.001 || top <= ground) continue;
        if (Math.Abs(feet.x - solid.center.x) > solid.half.x + radius || Math.Abs(feet.z - solid.center.z) > solid.half.z + radius) continue;
        ground = top;
    }
    return ground;
}

// A circle pushed out of every box its height meets, a few times over.
float3 PushOut(Ashwick ashwick, float3 feet, float radius, float high)
{
    mut var at = feet;
    var bucket = BucketOf(feet.x, feet.z);
    var count = ashwick.buckets[bucket].count;
    for (var pass = 0; pass < 3; pass++)
    {
        for (var k = 0; k < count; k++)
        {
            var solid = ashwick.solids[ashwick.buckets[bucket][k]];
                var bottom = solid.center.y - solid.half.y;
            var top = solid.center.y + solid.half.y;
            if (top <= at.y + STEP_UP || bottom >= at.y + high) continue;
            var lo = solid.center.xz - solid.half.xz;
            var hi = solid.center.xz + solid.half.xz;
            var closest = Math.Clamp(at.xz, lo, hi);
            var off = at.xz - closest;
            var far = Math.Length(off);
            if (far >= radius) continue;
            if (far > 0.0001)
            {
                var out = off / far * (radius - far);
                at.x += out.x;
                at.z += out.y;
                continue;
            }
            // Inside it: out the nearest side
            var left = at.x - lo.x;
            var right = hi.x - at.x;
            var down = at.z - lo.y;
            var up = hi.y - at.z;
            var least = Math.Min(Math.Min(left, right), Math.Min(down, up));
            if (least == left) at.x = lo.x - radius;
            else if (least == right) at.x = hi.x + radius;
            else if (least == down) at.z = lo.y - radius;
            else at.z = hi.y + radius;
        }
    }
    return at;
}

// Where a line from `from` first meets a box or the ground, as a fraction of the way to `to` (2 for nothing on the way),
// and that box's face.
float RayHit(Ashwick ashwick, float3 from, float3 to, out float3 normal)
{
    normal = float3(0, 1, 0);
    var way = to - from;
    mut var best = 1.0;
    mut var hit = false;
    // The ground: the first of a few points along the line that's under it, then halved down to where it goes in
    mut var above = 0.0;
    for (var step = 1; step <= 4; step++)
    {
        var t = step / 4.0;
        var at = from + way * t;
        if (at.y >= Ground(at.x, at.z))
        {
            above = t;
            continue;
        }
        mut var lo = above;
        mut var hi = t;
        for (var k = 0; k < 6; k++)
        {
            var mid = (lo + hi) * 0.5;
            var there = from + way * mid;
            if (there.y >= Ground(there.x, there.z)) lo = mid;
            else hi = mid;
        }
        best = hi;
        var where = from + way * hi;
        normal = Math.Normalize(float3(Ground(where.x - 0.25, where.z) - Ground(where.x + 0.25, where.z), 0.5,
                                       Ground(where.x, where.z - 0.25) - Ground(where.x, where.z + 0.25)));
        hit = true;
        break;
    }
    var middle = (from + to) * 0.5;
    var bucket = BucketOf(middle.x, middle.z);
    var count = ashwick.buckets[bucket].count;
    for (var k = 0; k < count; k++)
    {
        var solid = ashwick.solids[ashwick.buckets[bucket][k]];
        mut var enter = 0.0;
        mut var leave = best;
        mut var missed = false;
        mut var face = float3(0);
        for (var axis = 0; axis < 3; axis++)
        {
            var o = axis == 0 ? from.x : axis == 1 ? from.y : from.z;
            var d = axis == 0 ? way.x : axis == 1 ? way.y : way.z;
            var c = axis == 0 ? solid.center.x : axis == 1 ? solid.center.y : solid.center.z;
            var h = axis == 0 ? solid.half.x : axis == 1 ? solid.half.y : solid.half.z;
            if (Math.Abs(d) < 0.000001)
            {
                if (Math.Abs(o - c) > h) missed = true;
                continue;
            }
            var a = (c - h - o) / d;
            var b = (c + h - o) / d;
            var near = Math.Min(a, b);
            if (near > enter)
            {
                enter = near;
                var sign = d > 0 ? -1.0 : 1.0;
                face = float3(axis == 0 ? sign : 0, axis == 1 ? sign : 0, axis == 2 ? sign : 0);
            }
            leave = Math.Min(leave, Math.Max(a, b));
        }
        if (missed || enter >= leave || enter <= 0) continue;
        if (enter < best)
        {
            best = enter;
            normal = face;
            hit = true;
        }
    }
    return hit ? best : 2.0;
}

// RayHit along a line of any length: a few metres at a time, as RayHit looks for the boxes near each piece's middle.
float LongRay(Ashwick ashwick, float3 from, float3 to, out float3 normal)
{
    normal = float3(0, 1, 0);
    var steps = Math.Max(1, int(Math.Ceil(Math.Distance(from, to) / 2)));
    for (var i = 0; i < steps; i++)
    {
        var a = Math.Lerp(from, to, float(i) / steps);
        var b = Math.Lerp(from, to, float(i + 1) / steps);
        var t = RayHit(ashwick, a, b, out var n);
        if (t <= 1)
        {
            normal = n;
            return (i + t) / steps;
        }
    }
    return 2;
}

// Whether the line between two places at the height of a body's middle crosses no wall cell.
bool ClearPath(Ashwick ashwick, float3 a, float3 b)
{
    var way = b - a;
    var far = Math.Length(way.xz);
    var steps = int(far / (CELL * 0.5)) + 1;
    for (var i = 1; i < steps; i++)
    {
        var at = a + way * (float(i) / steps);
        if (!Walkable(ashwick, CellOf(at))) return false;
    }
    return true;
}

// ---- The dead's way ----

// Every few ticks: how far each walkable cell is from the nearest standing survivor.
[Stage(Tick.Field)]
system Wayfinding(mut Ashwick ashwick, Time time, query (Survivor survivor) survivors)
{
    if (!ashwick.made || time.tick % 6 != 0) return;
    mut List<int> sources = [];
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (s.life != Life.Standing || !s.ready) continue;
        var cell = CellOf(s.feet);
        if (cell >= 0) sources.Add(cell);
    }
    if (sources.count == 0)
    {
        foreach (var row in survivors)
        {
            if (row.survivor.life != Life.Downed) continue;
            var cell = CellOf(row.survivor.feet);
            if (cell >= 0) sources.Add(cell);
        }
    }
    Spread(ashwick, sources);
}

// A breadth-first walk out from the sources over walkable cells, counting steps.
void Spread(mut Ashwick ashwick, List<int> sources)
{
    var total = NAV_W * NAV_H;
    for (var c = 0; c < total; c++) ashwick.field[c] = byte(UNREACHED);
    mut List<int> queue = [];
    foreach (var cell in sources)
    {
        ashwick.field[cell] = 0;
        queue.Add(cell);
    }
    mut var head = 0;
    while (head < queue.count)
    {
        var cell = queue[head];
        head += 1;
        var here = int(ashwick.field[cell]);
        if (here >= UNREACHED - 1) continue;
        var cx = cell % NAV_W;
        var cz = cell / NAV_W;
        for (var n = 0; n < 4; n++)
        {
            var nx = cx + (n == 0 ? 1 : n == 1 ? -1 : 0);
            var nz = cz + (n == 2 ? 1 : n == 3 ? -1 : 0);
            if (nx < 0 || nz < 0 || nx >= NAV_W || nz >= NAV_H) continue;
            var next = nz * NAV_W + nx;
            if (int(ashwick.field[next]) != UNREACHED || !Walkable(ashwick, next)) continue;
            ashwick.field[next] = byte(here + 1);
            queue.Add(next);
        }
    }
}

// Which way is downhill from a place: toward the neighbouring cell nearest what draws the dead.
float3 Downhill(Ashwick ashwick, float3 at)
{
    var cell = CellOf(at);
    if (cell < 0) return float3(0);
    var cx = cell % NAV_W;
    var cz = cell / NAV_W;
    var here = int(ashwick.field[cell]);
    mut var best = here;
    mut var way = float3(0);
    for (var dz = -1; dz <= 1; dz++)
    {
        for (var dx = -1; dx <= 1; dx++)
        {
            if (dx == 0 && dz == 0) continue;
            var nx = cx + dx;
            var nz = cz + dz;
            if (nx < 0 || nz < 0 || nx >= NAV_W || nz >= NAV_H) continue;
            var next = nz * NAV_W + nx;
            if (!Walkable(ashwick, next)) continue;
            // A diagonal step needs both of its sides open, not to cut a corner
            if (dx != 0 && dz != 0)
            {
                if (!Walkable(ashwick, cz * NAV_W + nx) || !Walkable(ashwick, nz * NAV_W + cx)) continue;
            }
            var there = int(ashwick.field[next]);
            if (there < best || (there == best && there < here))
            {
                best = there;
                way = CellMiddle(next) - at;
            }
        }
    }
    way.y = 0;
    return Math.Normalize(way);
}

int FieldAt(Ashwick ashwick, float3 at)
{
    var cell = CellOf(at);
    if (cell < 0) return UNREACHED;
    return int(ashwick.field[cell]);
}
