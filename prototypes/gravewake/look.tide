// How Ashwick Wood looks at night, as a console of the nineties would have
// drawn it, but for the distance: the picture made at the window's size and
// cut into pixels by how far away each part of it is (as chunky as 270 lines
// up close, finer further out, the window's own far off), every corner put
// on those pixels (so things wobble), its colours cut to 32 steps a channel
// and dithered, its textures read without blending. The moon
// and the sky, the fires and the ruin's torches, fog in the trees. The picture is lit in light (linear), into a float
// target with smooth edges, the moon's shadows from a map of what it sees,
// and brought to the window by Develop: its bright parts bloom, then it's
// toned down under one, graded, and the corners darkened.

enum Layers { Prepare, Gather, Shadows, Scene, Glass, Develop, Hud }

const float NEAR = 0.05;
const float FAR = 400;
const int MOON_PIXELS = 2048;
const float LINES = 270;           // The picture's height in pixels, whatever the window's
const float MOON_REACH = 46;       // Half the width the moon's shadow map covers, round the eye

// A lamp: a torch, a brazier, a candle, a lantern. Light falls off to nothing at `reach`.
struct Light
{
    float3 at;
    float3 color;
    float reach;
}

// What every frag reads of the frame.
local singleton Look
{
    float3 eye;
    float time;
    float fov = 70;
    float3 moonWay = float3(0.35, 0.8, 0.45);    // Toward the moon
    float3 moonColor = float3(0.52, 0.57, 0.74);
    float3 skyLight = float3(0.09, 0.1, 0.13);
    float3 groundLight = float3(0.02, 0.018, 0.02);
    float3 fogColor = float3(0.045, 0.05, 0.07);
    float fog = 0.007;
    float3 mistColor = float3(0.075, 0.085, 0.11);  // The mist in the low ground, paler than the haze
    float mist = 0.022;
    float4x4 toMoon;
    float4x4 toClip;                              // The eye's camera, world to clip, for what's marked on the screen
    float3 focus;                                 // This machine's survivor's middle: what's between it and the eye is cut away...
    float see;                                    // ...while there's one to see (1; not behind the title, nor in F9's views)
    float4x4 toStain;                             // The stains' camera, world to clip (gore.tide)
    float2 pixel;                                 // One pixel of the window, in uv
    float2 low;                                   // The picture's size in its biggest (nearest) pixels
    float2 full;                                  // ...and in the window's
    float block;                                  // How many of the window's pixels across the biggest is
    float exposure = 1.75;
    float hurt;                                   // The red of being hit, 0 to 1
    float downed;                                 // Grey of being down
    float fade;                                   // To black
}

local singleton Lights
{
    List<Light> list;
}

local singleton Lens
{
    RenderTarget scene;                // At the window's size
    DepthTexture sceneDepth;           // ...and how far each of its pixels is, for how big Develop makes them
    RenderTarget moon;
    DepthTexture moonDepth;
    RenderTarget bright;
    RenderTarget blur;
    RenderTarget stains;               // Blood on the ground, seen from above over the whole clearing (gore.tide)
    Texture stainsColor;
    Texture glow;
    float2 size;
    bool made;
}

struct BlurStep
{
    float2 along;
}

// A sphere round the eye, its faces looking in, for the sky; and a quad for the ground.
local singleton Shapes
{
    List<Corner> dome;
    List<int> domeFaces;
    List<Corner> ground;
    List<int> groundFaces;
    bool made;
}

float3 Rgb(Color c)
{
    return float3(c.r, c.g, c.b);
}

// A colour as the screen shows it, as light.
float3 Linear(float3 c)
{
    return c * c * (c * 0.3 + float3(0.7));
}

float Speck(float x, float y)
{
    return (Math.Hash(int2(int(Math.Floor(x)), int(Math.Floor(y)))) & 1023) / 1023.0;
}

// ---- Light ----

// How much of the moon reaches a place: what its map says is in the way, softened over four looks.
float Moonlit(DepthTexture depth, Look look, float3 world, float3 normal)
{
    var facing = Math.Dot(normal, look.moonWay);
    if (facing <= 0) return 0;
    float4 seen = Math.Mul(look.toMoon, float4(world + normal * 0.06, 1));
    var uv = float2(seen.x * 0.5 + 0.5, 0.5 - seen.y * 0.5);
    if (uv.x < 0 || uv.y < 0 || uv.x > 1 || uv.y > 1) return 1;
    var far = seen.z * 0.5 + 0.5 - 0.0008;
    var soft = 0.6 / MOON_PIXELS;
    var lit = (depth.Compare(uv + float2(-soft, -soft), far) + depth.Compare(uv + float2(soft, -soft), far)
             + depth.Compare(uv + float2(-soft, soft), far) + depth.Compare(uv + float2(soft, soft), far)) * 0.25;
    return lit;
}

float3 LampLight(List<Light> lights, float3 world, float3 normal)
{
    mut var sum = float3(0);
    foreach (var light in lights)
    {
        var to = light.at - world;
        var far = Math.Length(to);
        if (far > light.reach) continue;
        var way = to / Math.Max(far, 0.0001);
        var facing = Math.Saturate(Math.Dot(normal, way) * 0.85 + 0.15);
        var fall = 1 - far / light.reach;
        sum += light.color * (facing * fall * fall / (1 + far * far * 0.08));
    }
    return sum;
}

// A surface of `albedo` (light) at a place, lit by the sky, the moon and the lamps. `open` is how much of the sky it sees.
float3 Shade(float3 albedo, float3 world, float3 normal, float open, Look look, List<Light> lights, DepthTexture moon)
{
    var sky = Math.Lerp(look.groundLight, look.skyLight, normal.y * 0.5 + 0.5) * (0.3 + 0.7 * open);
    var moonlit = look.moonColor * (Math.Saturate(Math.Dot(normal, look.moonWay)) * Moonlit(moon, look, world, normal));
    return albedo * (sky + moonlit + LampLight(lights, world, normal));
}

// The air between the eye and a place: a haze thicker with distance and low down, and a mist lying in the low ground
// (thickest at the ground, thin by two metres up, drifting), both lit by the moon, brighter looking toward it. What's
// far off goes into it, and what stands in it is dark against it.
float3 Hazed(float3 lit, float3 world, Look look)
{
    var toward = world - look.eye;
    var far = Math.Length(toward);
    var way = toward / Math.Max(far, 0.0001);
    var low = Math.Saturate(1.2 - world.y * 0.25);
    var haze = far * look.fog * (0.7 + low * 0.6);
    var drift = Math.Perlin(world.xz * 0.045 + float2(look.time * 0.025, look.time * 0.017)) * 0.7 + 0.75;
    var mist = far * look.mist * (MistAt(look.eye.y) + MistAt(world.y)) * 0.5 * drift;
    var clear = Math.Exp(-(haze + mist));
    return Math.Lerp(AirColor(way, mist / Math.Max(haze + mist, 0.0001), look), lit, clear);
}

// How thick the mist is at a height: all of it at the ground of the clearing, a third a metre up, nothing above the hills.
float MistAt(float y)
{
    return Math.Exp(-Math.Max(y - MIST_FLOOR, 0) * 1.1);
}

// The colour of the air looking one way: the haze, or (by `misty`, how much of it is the mist) the paler mist, both
// brighter toward the moon.
float3 AirColor(float3 way, float misty, Look look)
{
    var moonward = Math.Saturate(Math.Dot(way, look.moonWay) * 0.5 + 0.5);
    var glow = 0.7 + Math.Pow(moonward, 5) * 1.1;
    return Math.Lerp(look.fogColor, look.mistColor, misty) * glow;
}

const float MIST_FLOOR = 0.2;

// ---- Frags ----

// Whether a place on what's drawn stands between the eye and this machine's survivor: in a cone from the eye CUT_RADIUS
// across at the survivor, ragged at its edge. The kit's parts there aren't drawn, so the trees and walls south of a
// survivor, between them and the camera above, don't hide them.
bool InTheWay(float3 at, Look look)
{
    if (look.see < 0.5) return false;
    var line = look.focus - look.eye;
    var length = Math.Length(line);
    var way = line / Math.Max(length, 0.001);
    var along = Math.Dot(at - look.eye, way);
    if (along <= 0 || along > length - 0.8) return false;
    var off = Math.Length(at - look.eye - way * along);
    var grain = Math.Frac(Math.Sin(Math.Dot(Math.Floor(at * 6), float3(12.9898, 78.233, 37.719))) * 43758.5453);
    return off < CUT_RADIUS * along / length * (0.8 + 0.2 * grain);
}

const float CUT_RADIUS = 2.6;

// The kits' parts, with their texture.
frag KitLit(Corner corner, out Color color, Texture source, Instance instance, Placed placed, Look look, Lights lights, Lens lens)
{
    if (InTheWay(this.world, look)) this.Discard();
    var paint = source.Sample(corner.uv);
    var albedo = Linear(Rgb(paint)) * Linear(Rgb(corner.color)) * placed.tint;
    var normal = instance.Normal(corner.normal);
    var lit = Shade(albedo, this.world, normal, placed.open, look, lights.list, lens.moonDepth);
    color = Color(Hazed(lit, this.world, look), 1);
}

// Leaves and vines: their texture's alpha cuts them out, and either side is lit.
frag KitCutout(Corner corner, out Color color, Texture source, Instance instance, Placed placed, Look look, Lights lights, Lens lens)
{
    var paint = source.Sample(corner.uv);
    if (paint.a < 0.5 || InTheWay(this.world, look)) this.Discard();
    // The kits' leaves are a daylit green: at night duller and darker, so the trees don't outshine what's in front of them
    var leaf = Linear(Rgb(paint)) * Linear(Rgb(corner.color)) * placed.tint;
    var albedo = Math.Lerp(float3(Math.Dot(leaf, float3(0.3, 0.55, 0.15))), leaf, 0.7) * 0.6;
    mut var normal = instance.Normal(corner.normal);
    if (Math.Dot(normal, look.eye - this.world) < 0) normal = -normal;
    var lit = Shade(albedo, this.world, normal, placed.open, look, lights.list, lens.moonDepth);
    color = Color(Hazed(lit, this.world, look), 1);
}

// What casts the moon's shadows, with holes where the texture has them.
frag CastCutout(Corner corner, out Color color, Texture source)
{
    var paint = source.Sample(corner.uv);
    if (paint.a < 0.5) this.Discard();
    color = Color.white;
}

// The forest floor: loam, moss and fallen leaves, trodden bare round the fire, in sixteenths of a metre.
frag Earth(Corner corner, out Color color, Look look, Lights lights, Lens lens)
{
    var at = this.world.xz;
    var t = Math.Floor(at * 16);
    var patch = Math.Perlin(at * 0.18);
    var fine = Math.Perlin(at * 1.3);
    mut var paint = Math.Lerp(float3(0.13, 0.105, 0.075), float3(0.12, 0.16, 0.07), Math.Saturate(patch * 1.4 + 0.5));
    paint *= 0.8 + fine * 0.2 + Speck(t.x, t.y) * 0.15;
    // Fallen leaves: soft drifts of rust and ochre, thicker toward the trees
    var under = Math.Saturate((Math.Length(at) - 12) * 0.12);
    var drift = Math.Perlin(at * 0.9 + float2(31, 17)) + Math.Perlin(at * 4.3 + float2(5, 9)) * 0.45;
    var rust = Math.Saturate(Math.Perlin(at * 0.35 + float2(3, 41)) * 1.5 + 0.5);
    var fallen = Math.SmoothStep(0.25 - under * 0.35, 0.45 - under * 0.35, drift);
    paint = Math.Lerp(paint, Math.Lerp(float3(0.2, 0.15, 0.06), float3(0.24, 0.11, 0.045), rust) * (0.75 + fine * 0.25), fallen * 0.55);
    if (Math.Perlin(at * 0.07 + float2(13, 7)) > 0.3) paint = Math.Lerp(paint, float3(0.08, 0.07, 0.05), 0.5);
    // Bare and trodden round the fire, and paths worn from it to the landmarks
    paint = Math.Lerp(paint, float3(0.17, 0.14, 0.11) * (0.85 + fine * 0.15), Math.Saturate(1.4 - Math.Length(at) * 0.28) * 0.8);
    var wobble = float2(Math.Perlin(at * 0.21), Math.Perlin(at * 0.21 + float2(7, 3))) * 1.4;
    var path = Math.Min(Math.Min(Lane(at + wobble, float2(0), CHAPEL - float2(0, 5)), Lane(at + wobble, float2(0), CAIRN - float2(5, 0))),
                        Math.Min(Math.Min(Lane(at + wobble, float2(0), GRAVES + float2(8, 0)), Lane(at + wobble, float2(0), STONES + float2(6, -6))),
                                 Lane(at + wobble, float2(0), OAK + float2(0, 4))));
    paint = Math.Lerp(paint, float3(0.19, 0.155, 0.11) * (0.8 + fine * 0.25), Math.SmoothStep(1.9, 0.9, path + fine * 0.5) * 0.85);
    // Cliffs and steep banks are bare rock and earth
    var normal = Math.Normalize(corner.normal);
    paint = Math.Lerp(paint, float3(0.16, 0.15, 0.14) * (0.8 + fine * 0.3), Math.SmoothStep(0.8, 0.55, normal.y));
    mut var ground = Linear(paint * 1.45);
    // Blood soaked in where it fell (gore.tide's stains), and a wet shine on it
    float4 seen = Math.Mul(look.toStain, float4(this.world, 1));
    var blood = lens.stainsColor.Sample(float2(seen.x * 0.5 + 0.5, 0.5 - seen.y * 0.5));
    ground = Math.Lerp(ground, Linear(float3(blood.r, blood.g, blood.b) / Math.Max(blood.a, 0.001)) * 0.9, Math.Saturate(blood.a * 1.15));
    mut var lit = Shade(ground, this.world, normal, 1, look, lights.list, lens.moonDepth);
    var toEye = Math.Normalize(look.eye - this.world);
    lit += look.moonColor * Math.Pow(Math.Saturate(Math.Dot(Math.Reflect(-toEye, normal), look.moonWay)), 30) * blood.a * 0.8;
    color = Color(Hazed(lit, this.world, look), 1);
}

// How far a place is from the line between two others.
float Lane(float2 at, float2 a, float2 b)
{
    var ab = b - a;
    var along = Math.Saturate(Math.Dot(at - a, ab) / Math.Dot(ab, ab));
    return Math.Distance(at, a + ab * along);
}

// The sky: a dome round the eye, from the haze at the horizon up to the night, the moon and its halo, stars and cloud.
frag SkyDome(Corner corner, out Color color, Look look)
{
    var way = Math.Normalize(corner.position);
    var up = Math.Saturate(way.y);
    mut var sky = Math.Lerp(AirColor(way, Math.Saturate(1 - up * 6), look) * 1.05, float3(0.006, 0.008, 0.018), Math.Pow(up, 0.45));
    var grid = way * 260;
    var cell = int3(int(Math.Floor(grid.x)), int(Math.Floor(grid.y)), int(Math.Floor(grid.z)));
    var star = Math.Hash(cell) & 4095;
    if (star < 7 && way.y > 0.05)
    {
        // A point in the cell, soft round it, so a star is a speck and not a square
        var spot = float3((star & 3) * 0.2 + 0.2, ((star >> 2) & 1) * 0.4 + 0.3, 0.5);
        var off = Math.Frac(grid) - spot;
        var near = Math.Saturate(1 - Math.Length(off.xy) * 3.5);
        sky += float3(0.7, 0.72, 0.8) * near * near * (0.4 + (star & 3) * 0.25) * Math.Saturate(way.y * 4);
    }
    var moon = Math.Dot(way, look.moonWay);
    var halo = Math.Pow(Math.Saturate(moon), 60) * 0.12 + Math.Pow(Math.Saturate(moon), 600) * 0.4;
    sky += float3(0.55, 0.65, 0.85) * halo;
    if (moon > 0.9993) sky = float3(2.2, 2.3, 2.4) * (0.85 + Math.Perlin(way.xz * 900) * 0.15);
    var cloud = Math.Saturate(Math.Perlin(way.xz / Math.Max(way.y, 0.08) * 0.9 + float2(look.time * 0.01, 0)) * 1.6 + 0.1);
    sky = Math.Lerp(sky, look.fogColor * 0.7 + float3(0.02, 0.022, 0.03) * halo * 30, cloud * 0.6 * Math.Saturate(way.y * 3));
    if (way.y < 0) sky = AirColor(way, 1, look);
    color = Color(sky, 1);
}

// Light over one, into a quarter-size image, for the bloom.
frag Bright(Vertex vertex, out Color color, Texture source)
{
    var seen = Rgb(source.Sample(vertex.uv));
    var most = Math.Max(seen.x, Math.Max(seen.y, seen.z));
    var over = Math.Max(most - 1.1, 0) / Math.Max(most, 0.0001);
    color = Color(seen * over, 1);
}

frag Blur(Vertex vertex, out Color color, Texture source, BlurStep step)
{
    var near = step.along * 1.3846;
    var far = step.along * 3.2308;
    var sum = source.Sample(vertex.uv) * 0.227
            + (source.Sample(vertex.uv + near) + source.Sample(vertex.uv - near)) * 0.3162
            + (source.Sample(vertex.uv + far) + source.Sample(vertex.uv - far)) * 0.0703;
    color = Color(sum.r, sum.g, sum.b, 1);
}

// The picture, to the window: the bloom added, exposed, toned under one, graded cold in the dark and warm in the light,
// the corners darker, and what being hurt or down does to it.
frag Develop(Vertex vertex, out Color color, Texture source, Lens lens, Look look)
{
    // The pixel this one is part of: how big is how far away the scene is there (read once for the biggest pixel round
    // it, so a pixel is all one size)
    var px = vertex.uv * look.full;
    var coarse = look.block;
    var cell = (Math.Floor(px / coarse) + float2(0.5)) * coarse;
    var far = NEAR / Math.Max(1 - lens.sceneDepth.Sample(cell / look.full), 0.000001);
    var block = Math.Max(1, Math.Round(coarse / Fineness(far)));
    var at = (Math.Floor(px / block) + float2(0.5)) * block;
    var picture = Rgb(source.Sample(at / look.full, Filter.Point));
    var seen = picture + Rgb(lens.glow.Sample(vertex.uv)) * 0.4;
    var exposed = seen * look.exposure;
    // A filmic curve (Narkowicz's fit of ACES)
    var a = exposed * (exposed * 2.51 + float3(0.03));
    var b = exposed * (exposed * 2.43 + float3(0.59)) + float3(0.14);
    mut var shown = float3(Math.Saturate(a.x / b.x), Math.Saturate(a.y / b.y), Math.Saturate(a.z / b.z));
    // Graded: the shadows cold, the lights warm, a little more colour
    var luma = Math.Dot(shown, float3(0.2126, 0.7152, 0.0722));
    shown *= Math.Lerp(float3(0.86, 0.97, 1.16), float3(1.08, 1.0, 0.9), Math.SmoothStep(0.03, 0.5, luma));
    shown = Math.Saturate(Math.Lerp(float3(luma), shown, 1.1));
    var grey = Math.Dot(shown, float3(0.3, 0.59, 0.11));
    shown = Math.Lerp(shown, float3(grey), look.downed * 0.75);
    shown = float3(Math.Pow(shown.x, 0.4545), Math.Pow(shown.y, 0.4545), Math.Pow(shown.z, 0.4545));
    var middle = vertex.uv - float2(0.5);
    var corner = Math.Dot(middle, middle);
    shown *= 1 - Math.Saturate(corner * 1.25 - 0.05);
    var red = Math.Saturate(corner * 3.2 - 0.1) * look.hurt;
    shown = Math.Lerp(shown, float3(0.45, 0.02, 0.02), red);
    shown *= 1 - look.fade;
    // 32 steps a channel, dithered in its own pixels by the 4 by 4 ordered pattern
    var dot = Math.Floor(px / block);
    var step = (Bayer(int(dot.x) & 3, int(dot.y) & 3) + 0.5) / 16 - 0.5;
    shown = float3(Math.Floor(shown.x * 31 + 0.5 + step), Math.Floor(shown.y * 31 + 0.5 + step), Math.Floor(shown.z * 31 + 0.5 + step)) / 31;
    color = Color(Math.Saturate(shown), 1);
}

// The 4 by 4 ordered dither's threshold at a pixel, 0 to 15.
float Bayer(int x, int y)
{
    switch (y * 4 + x)
    {
        case 0: return 0;
        case 1: return 8;
        case 2: return 2;
        case 3: return 10;
        case 4: return 12;
        case 5: return 4;
        case 6: return 14;
        case 7: return 6;
        case 8: return 3;
        case 9: return 11;
        case 10: return 1;
        case 11: return 9;
        case 12: return 15;
        case 13: return 7;
        case 14: return 13;
    }
    return 5;
}

// How many times finer than the nearest the pixels are at a distance: 1 to 18 m, then a third finer to 40 m, then half
// the size, no finer: far off still pixelled, only less (the owner: "distant stuff feels too detailed almost now").
float Fineness(float far)
{
    return far < 18 ? 1.0 : far < 40 ? 1.34 : 2.0;
}

// Each corner onto the nearest pixel, as a console of the nineties put them, as big as Develop makes them at its
// distance: what's still shimmers a little as the eye moves, and what moves wobbles.
vert Wobble(mut Corner corner, out float4 clip, Look look)
{
    var at = this.clip;
    clip = Snapped(at, look);
}

float4 Snapped(float4 at, Look look)
{
    if (at.w <= 0.0001) return at;
    var half = Math.Min(look.low * Fineness(at.w), look.full) * 0.5;
    return float4(Math.Round(at.xy / at.w * half) / half * at.w, at.z, at.w);
}

// ---- Views ----

void MakeShapes(mut Shapes shapes)
{
    shapes.dome.Clear();
    shapes.domeFaces.Clear();
    var rings = 16;
    var around = 24;
    for (var ring = 0; ring <= rings; ring++)
    {
        var tilt = ring * Math.PI / rings;
        for (var step = 0; step <= around; step++)
        {
            var turn = step * Math.TAU / around;
            var way = float3(Math.Sin(tilt) * Math.Cos(turn), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(turn));
            shapes.dome.Add(Corner { position = way * 300, normal = -way });
            if (ring == rings || step == around) continue;
            var corner = ring * (around + 1) + step;
            shapes.domeFaces.Add(corner);
            shapes.domeFaces.Add(corner + around + 1);
            shapes.domeFaces.Add(corner + 1);
            shapes.domeFaces.Add(corner + 1);
            shapes.domeFaces.Add(corner + around + 1);
            shapes.domeFaces.Add(corner + around + 2);
        }
    }
    // The ground: its heights (plan.tide's Ground) on a grid of 1.25 m out to 150 m, its normals from its slopes
    shapes.ground.Clear();
    shapes.groundFaces.Clear();
    var cells = 240;
    var size = 300.0 / cells;
    for (var z = 0; z <= cells; z++)
    {
        for (var x = 0; x <= cells; x++)
        {
            var px = -150 + x * size;
            var pz = -150 + z * size;
            var normal = Math.Normalize(float3(Ground(px - 0.5, pz) - Ground(px + 0.5, pz), 1, Ground(px, pz - 0.5) - Ground(px, pz + 0.5)));
            shapes.ground.Add(Corner { position = float3(px, Ground(px, pz), pz), normal = normal });
            if (x == cells || z == cells) continue;
            var c = z * (cells + 1) + x;
            shapes.groundFaces.Add(c);
            shapes.groundFaces.Add(c + cells + 1);
            shapes.groundFaces.Add(c + 1);
            shapes.groundFaces.Add(c + 1);
            shapes.groundFaces.Add(c + cells + 1);
            shapes.groundFaces.Add(c + cells + 2);
        }
    }
    shapes.made = true;
}

// The targets, at the window's size.
void Focus(mut Lens lens, mut Look look)
{
    var size = float2(Screen.width, Screen.height);
    // The nearest pixels: a whole number of the window's, about LINES of them up the window
    var full = float2(Math.Max(1, size.x), Math.Max(1, size.y));
    var block = Math.Max(1, Math.Round(full.y / LINES));
    var low = float2(Math.Max(1, Math.Ceil(full.x / block)), Math.Max(1, Math.Ceil(full.y / block)));
    if (!lens.made)
    {
        lens.made = true;
        lens.scene = RenderTarget(int(full.x), int(full.y), 1, Format.Rgba16f);
        lens.sceneDepth = lens.scene.depth;
        lens.moon = RenderTarget(MOON_PIXELS, MOON_PIXELS, 1, Format.Depth);
        lens.moonDepth = lens.moon.depth;
        lens.bright = RenderTarget(int(Math.Max(1, low.x / 2)), int(Math.Max(1, low.y / 2)), 1, Format.Rgba16f);
        lens.blur = RenderTarget(int(Math.Max(1, low.x / 2)), int(Math.Max(1, low.y / 2)), 1, Format.Rgba16f);
        lens.glow = lens.bright.color;
        // The stains: straight down on the clearing, north up, never moving
        lens.stains = RenderTarget(STAIN_PIXELS, STAIN_PIXELS, 1, Format.Rgba8);
        lens.stainsColor = lens.stains.color;
        lens.stains.SetCamera(float4x4.TRS(float3(NAV_X0 + STAIN_REACH, 120, NAV_Z0 + STAIN_REACH), quaternion.LookRotation(float3(0, -1, 0), float3(0, 0, 1)), float3(1)),
                              float4x4.Ortho(STAIN_REACH * 2, STAIN_REACH * 2, 1, 260));
        look.toStain = lens.stains.WorldToClip();
    }
    else if (full.x != look.full.x || full.y != look.full.y)
    {
        lens.scene.Resize(int(full.x), int(full.y));
        lens.bright.Resize(int(Math.Max(1, low.x / 2)), int(Math.Max(1, low.y / 2)));
        lens.blur.Resize(int(Math.Max(1, low.x / 2)), int(Math.Max(1, low.y / 2)));
    }
    look.low = low;
    look.full = full;
    look.block = block;
    lens.size = size;
    look.pixel = float2(1 / Math.Max(1, size.x), 1 / Math.Max(1, size.y));
}

// The moon's camera: looking down its way at what's round the eye, moved in whole pixels of its map so its shadows
// don't crawl as the eye moves.
void AimMoon(mut Lens lens, mut Look look)
{
    var turn = quaternion.LookRotation(-look.moonWay, float3(0, 1, 0));
    var texel = MOON_REACH * 2 / MOON_PIXELS;
    var right = Math.Rotate(turn, float3(1, 0, 0));
    var up = Math.Rotate(turn, float3(0, 1, 0));
    var center = look.eye + float3(0, 0, 0);
    var u = Math.Floor(Math.Dot(center, right) / texel) * texel;
    var v = Math.Floor(Math.Dot(center, up) / texel) * texel;
    var along = Math.Dot(center, look.moonWay);
    var snapped = right * u + up * v + look.moonWay * along;
    lens.moon.SetCamera(float4x4.TRS(snapped + look.moonWay * 120, turn, float3(1)), float4x4.Ortho(MOON_REACH * 2, MOON_REACH * 2, 1, 260));
    look.toMoon = lens.moon.WorldToClip();
}

[Stage(Layers.Shadows)]
view MoonShadows(Lens lens, Kit kit, Shapes shapes, Me me, Look look)
{
    if (!lens.made || !kit.made || !shapes.made) return;
    lens.moon.Clear(Color.white);
    // Each mesh's shadow at the level the player sees it at
    lens.moon.SetLODCamera(float4x4.TRS(me.eye, me.turn, float3(1)), float4x4.PerspectiveFov(Math.Radians(look.fov), lens.size.x / Math.Max(1, lens.size.y), NEAR, FAR));
    lens.moon.Mesh(shapes.ground, shapes.groundFaces, float4x4.identity);
    for (var i = 0; i < kit.near.count; i++)
    {
        if (kit.near[i].count == 0 || kit.info[i].glass) continue;
        if (kit.info[i].cutout) lens.moon.Instanced(parts[i], kit.near[i], TextureOf(kit.info[i].tex), CastCutout);
        else lens.moon.Instanced(parts[i], kit.near[i]);
    }
}

[Stage(Layers.Scene)]
view DrawScene(Lens lens, Kit kit, Shapes shapes, Look look)
{
    if (!lens.made || !kit.made) return;
    lens.scene.Clear(Color(look.fogColor, 1));
    lens.scene.Depth(Depth.None),
    lens.scene.Cull(Cull.Front)
    {
        lens.scene.Mesh(shapes.dome, shapes.domeFaces, float4x4.Translate(look.eye), SkyDome);
    }
    lens.scene.Mesh(shapes.ground, shapes.groundFaces, float4x4.identity, Wobble, Earth);
    for (var i = 0; i < kit.near.count; i++)
    {
        if (kit.near[i].count == 0 || kit.info[i].glass) continue;
        if (kit.info[i].cutout)
        {
            lens.scene.Cull(Cull.None)
            {
                lens.scene.Instanced(parts[i], kit.near[i], TextureOf(kit.info[i].tex), Wobble, KitCutout);
            }
        }
        else
        {
            lens.scene.Instanced(parts[i], kit.near[i], TextureOf(kit.info[i].tex), Wobble, KitLit);
        }
    }
}

[Stage(Layers.Develop)]
view Show(Lens lens, Look look)
{
    if (!lens.made) return;
    Draw.Blit(lens.scene.color, lens.bright, Bright);
    Draw.Blit(lens.bright.color, lens.blur, Blur, BlurStep { along = float2(2 / look.low.x, 0) });
    Draw.Blit(lens.blur.color, lens.bright, Blur, BlurStep { along = float2(0, 2 / look.low.y) });
    Draw.Blit(lens.scene.color, Draw.window, Develop);
}
