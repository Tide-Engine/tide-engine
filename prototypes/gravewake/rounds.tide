// The run: once everyone has picked a survivor, a few seconds' breath, the
// siren, and the dead never stop coming, more of them and tougher the longer
// it goes (the danger, after Risk of Rain 2's difficulty); every few minutes
// a Brute among them. There's no end but the last of the survivors falling;
// how long they held out is the score.

enum Phase { Waiting, Fighting, Over }

singleton Match
{
    Phase phase;
    float timer;                 // Seconds into the phase (the countdown, while waiting)
    float clock;                 // Seconds the run has gone
    float danger;                // How dangerous the night has got (Danger), each tick
    bool paused;                 // Someone has items to choose: everything waits for them (Pause)
    int alive;                   // Up now, counted each tick
    int killed;
    float spawnWait;
    int rush;                    // Of the dead, how many more come six a tick (the development key's horde)
    int bloaters;                // How many of the next to rise are Bloaters whatever the share (the development key's)
    // The party's experience (items.tide)
    int level;
    float xp;                    // Toward the next level
    // The Brutes (boss.tide)
    float bossNext;              // When the next comes, on the run's clock
    float chestWait = CHEST_FIRST;  // Seconds till the next chest (chests.tide)
    int chestsCome;              // How many have come this run
    int orbs;                    // Experience orbs lying (orbs.tide)
    int bosses;                  // How many have come
    // The end
    float lasted;                // How long the run went
    bool restarting;
    bool culling;                // Development: the dead all go
}

const int MAX_ALIVE = 4000;      // Up at once: the most the tick and the frame afford (notes/gravewake.md)
const float START_SECONDS = 4;   // The breath before the first of the dead, once everyone has picked
const float RETURN_SECONDS = 30; // How long one who bled out is gone before they're back at the fire
const float BOSS_FIRST = 180;    // When the first Brute comes, and how long after each the next does
const float BOSS_EVERY = 180;

void ResetMatch(mut Match match)
{
    match.phase = Phase.Waiting;
    match.timer = 0;
    match.clock = 0;
    match.danger = 1;
    match.paused = false;
    match.alive = 0;
    match.killed = 0;
    match.spawnWait = 0;
    match.rush = 0;
    match.bloaters = 0;
    match.level = 1;
    match.xp = 0;
    match.bossNext = BOSS_FIRST;
    match.bosses = 0;
    match.chestWait = CHEST_FIRST;
    match.chestsCome = 0;
    match.orbs = 0;
    match.lasted = 0;
    match.restarting = false;
    match.culling = false;
}

// How dangerous the night has got: 1 at the start, one more every minute and a half, a quarter more for each survivor
// How dangerous the night has got: 1 at the start, one more every two and a half minutes, nearly half again for each
// survivor past the first. (Balanced with the bots, test/balance.c: the dead's health a second had grown as the minutes
// to the 2.6th, a survivor's power about as the levels, and every run drowned by the third minute.)
float Danger(Match match, int players)
{
    return (1 + match.clock / 150) * (1 + 0.45 * (players - 1));
}

// What one of the dead can take, at a danger.
float ZombieHealth(float danger)
{
    return 25 * Math.Pow(danger, 1.1);
}

// How many of the dead come a second, at a danger: three at the start, fifteen ten minutes in.
float SpawnRate(float danger)
{
    return 3 * danger;
}

// The words for a danger, after Risk of Rain 2's.
string DangerName(float danger)
{
    if (danger < 2) return "Easy";
    if (danger < 3) return "Medium";
    if (danger < 4.5) return "Hard";
    if (danger < 6) return "Very Hard";
    if (danger < 8) return "Insane";
    if (danger < 11) return "Impossible";
    return "HAHAHAHA";
}

// Waiting for everyone's survivor, the breath, the run, and the end.
[Stage(Tick.Rounds)]
system RunRounds(mut Match match, Time time, Party party, query (Survivor survivor) survivors)
{
    if (match.paused) return;
    match.timer += time.dt;
    mut var ready = 0;
    mut var hope = 0;
    mut var unpicked = 0;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready) continue;
        ready += 1;
        if (s.role == Role.None) unpicked += 1;
        if (s.life == Life.Standing) hope += 1;
    }
    switch (match.phase)
    {
        case Phase.Waiting:
            // Everyone's survivor picked, then a breath
            if (ready == 0 || unpicked > 0)
            {
                match.timer = 0;
                return;
            }
            if (match.timer < START_SECONDS) return;
            match.phase = Phase.Fighting;
            match.timer = 0;
            match.clock = 0;
            match.spawnWait = 1;
            Send(RunBegan { });
            return;
        case Phase.Fighting:
            match.clock += time.dt;
            match.danger = Danger(match, Players(party));
            if (ready > 0 && hope == 0)
            {
                match.phase = Phase.Over;
                match.timer = 0;
                match.lasted = match.clock;
                Send(GameOver { lasted = match.clock });
                return;
            }
            if (match.culling && match.alive == 0) match.culling = false;
            return;
        case Phase.Over:
            return;
    }
}

// While anyone has items to choose, everything waits: the clock, the dead, the Brutes, what flies, the guns and the
// skills; the next tick's choosing is this one's (the owner: "the upgrade screen should pause the game, in
// multiplayer it should wait for all").
[Stage(Tick.Restart, 2)]
system Pause(mut Match match, query (Survivor survivor) survivors)
{
    mut var waiting = false;
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.role != Role.None && row.survivor.choosing) waiting = true;
    match.paused = waiting && match.phase == Phase.Fighting;
}

// Count who's up, each tick, before the run looks.
[Stage(Tick.Rounds, -1)]
system CountDead(mut Match match, query (Zombie zombie) zombies)
{
    mut var alive = 0;
    foreach (var row in zombies)
        if (row.zombie.state != ZombieState.Dying) alive += 1;
    match.alive = alive;
}

// The dead come all the time, clawing up out of the ground all round a survivor, 16 to 32 m off and from every side,
// wherever the ground is open and their way to the survivors is clear; a rush (the development key's horde) six a
// tick. Where no such ground is found, out of a grave or the roots at the clearing's edge.
[Stage(Tick.Rounds, 1)]
system SpawnDead(mut Match match, Ashwick ashwick, Time time, query (Survivor survivor) survivors)
{
    if (match.paused) return;
    if (match.phase != Phase.Fighting || match.alive >= MAX_ALIVE || match.culling) return;
    var danger = match.danger;
    mut var count = 0;
    if (match.rush > 0)
    {
        count = Math.Min(6, match.rush);
        match.rush -= count;
    }
    else
    {
        match.spawnWait -= time.dt;
        while (match.spawnWait <= 0 && count < 10)
        {
            match.spawnWait += 1 / SpawnRate(danger);
            count += 1;
        }
        if (count == 0) return;
    }
    // Whom they come for: a survivor on their feet, any of them
    mut List<float3> near = [];
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
    if (near.count == 0) return;
    for (var k = 0; k < count; k++)
    {
        var focus = near[Random.NextInt(near.count)];
        var at = RisingPlace(ashwick, focus, 16, 32);
        if (at.y < -100) return;
        var gait = GaitFor(danger);
        var look = Random.NextInt(ZOMBIE_LOOKS);
        var pace = Random.NextFloat(0.9, 1.1);
        var phase = Random.NextInt(64);
        mut var bloat = Random.NextFloat() < BloaterShare(match);
        if (match.bloaters > 0)
        {
            match.bloaters -= 1;
            bloat = true;
        }
        Spawn(Zombie { at = at, yaw = YawTo(at, focus), health = ZombieHealth(danger) * (bloat ? BLOAT_HEALTH : 1.0), gait = bloat ? Gait.Shamble : gait, look = look,
                       state = ZombieState.Rising, pace = pace, phase = phase, kind = bloat ? ZombieKind.Bloater : ZombieKind.Walker });
        if (k == 0) Send(Cue { sound = Sfx.Rise, at = at });
    }
}

// How many of the dead that rise are Bloaters: none in the first BLOATERS_FROM seconds, then one in 40, up to one in 14
// as the danger grows.
float BloaterShare(Match match)
{
    return match.clock < BLOATERS_FROM ? 0 : Math.Min(0.07, 0.025 + 0.01 * (match.danger - 1));
}

const float BLOATERS_FROM = 40;

// Where one of the dead can claw up near a survivor: `near` to `far` metres off, any side, on open ground the dead can
// walk and from which their way to the survivors is clear (eight tries); else a riser 7 m or more off; else a place far
// below the world (none).
float3 RisingPlace(Ashwick ashwick, float3 focus, float near, float far)
{
    for (var tries = 0; tries < 8; tries++)
    {
        var turn = Random.NextFloat(Math.TAU);
        var off = Random.NextFloat(near, far);
        var there = focus + float3(Math.Sin(turn), 0, Math.Cos(turn)) * off;
        var cell = CellOf(there);
        if (cell < 0 || !InClearing(there) || !Open(ashwick, cell) || FieldAt(ashwick, there) >= UNREACHED) continue;
        return On(there.x, there.z);
    }
    mut List<int> picks = [];
    for (var i = 0; i < ashwick.risers.count; i++)
        if (Math.Distance(ashwick.risers[i].at, focus) >= 7) picks.Add(i);
    if (picks.count == 0) return float3(0, -1000, 0);
    var riser = ashwick.risers[picks[Random.NextInt(picks.count)]].at;
    return On(riser.x, riser.z);
}

Gait GaitFor(float danger)
{
    var runners = Math.Clamp((danger - 1.4) * 0.3, 0, 0.92);
    if (Random.NextFloat() >= runners) return Gait.Shamble;
    var sprinters = Math.Clamp((danger - 3.5) * 0.15, 0, 0.6);
    return Random.NextFloat() < sprinters ? Gait.Sprint : Gait.Run;
}

// One who bled out is gone a while, then back at their place by the fire with everything they had.
[Stage(Tick.Rounds, 2)]
system Return(mut Survivor survivor, Match match, Ashwick ashwick, Time time)
{
    if (match.paused) return;
    if (match.phase != Phase.Fighting || survivor.life != Life.Gone) return;
    survivor.gone += time.dt;
    if (survivor.gone < RETURN_SECONDS) return;
    var start = ashwick.starts[survivor.seat];
    StandUp(survivor);
    Refill(survivor);
    survivor.gone = 0;
    survivor.feet = start;
    survivor.yaw = YawTo(float3(0), start);
    survivor.pitch = 0;
    survivor.velocity = float3(0);
    survivor.placed = true;
    Send(Cue { sound = Sfx.Revive, at = start });
}

event RunBegan { }

event GameOver
{
    float lasted;
}
