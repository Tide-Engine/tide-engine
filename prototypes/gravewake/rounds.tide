// Waves: a few seconds' breath, then the bell, and the dead come, more of
// them each wave, tougher and faster, until every one of the wave is down.
// Then each survivor is offered three items and takes one. There's no end but
// the last of them falling; how far they got is the score.

enum Phase { Waiting, Break, Fighting, Over }

singleton Match
{
    Phase phase;
    int round;
    float timer;                 // Seconds into the phase (into the countdown, once everyone has chosen)
    int toSpawn;                 // Of this wave's dead, still to come
    int alive;                   // Up now, counted each tick
    int killed;                  // This wave's, for the wave's end
    float spawnWait;
    int rush;                    // Of the dead still to come, how many come six a tick (the development key's horde)
    float choosing;              // Seconds the survivors have had to choose their items
    // The party's experience (items.tide)
    int level;
    float xp;                    // Toward the next level
    // Power-ups
    float instakill;             // Seconds left
    int drops;                   // This wave's
    int dropTurn;                // Where in the round of power-ups the next one is
    // The end
    int lastRound;
    bool restarting;
    bool culling;                // Development: the wave's dead all go
}

const int MAX_ALIVE = 3000;      // Up at once: the most the tick and the frame afford (notes/gravewake.md)
const float BREAK_SECONDS = 5;   // The countdown to the next wave, once everyone has taken an item
const float CHOICE_MOST = 45;    // How long the others wait for one who hasn't

void ResetMatch(mut Match match)
{
    match.phase = Phase.Waiting;
    match.round = 0;
    match.timer = 0;
    match.toSpawn = 0;
    match.alive = 0;
    match.killed = 0;
    match.spawnWait = 0;
    match.rush = 0;
    match.choosing = 0;
    match.level = 1;
    match.xp = 0;
    match.instakill = 0;
    match.drops = 0;
    match.dropTurn = 0;
    match.lastRound = 0;
    match.restarting = false;
    match.culling = false;
}

// How many dead a wave brings, for so many survivors: a horde, growing faster each wave (74, 128, 190, 290 by the
// fifth, 740 by the tenth, 2,240 by the twentieth for one).
int RoundCount(int round, int players)
{
    var crowd = 1 + 0.6 * (players - 1);
    return int(Math.Round((40 + 30 * round + 4 * round * round) * crowd));
}

// How much a wave's dead can take: little each, with so many.
float RoundHealth(int round)
{
    if (round < 10) return 40 + 25 * (round - 1);
    return 265 * Math.Pow(1.08, round - 9);
}

float SpawnGap(int round, int players)
{
    return Math.Max(0.017, 0.4 * Math.Pow(0.88, round - 1)) / (1 + 0.3 * (players - 1));
}

// Waiting for someone, the cards and the breath between waves, the wave, and the end.
[Stage(Tick.Rounds)]
system RunRounds(mut Match match, Time time, Party party, query (Survivor survivor) survivors)
{
    match.timer += time.dt;
    match.instakill = Math.Max(0, match.instakill - time.dt);
    mut var ready = 0;
    mut var hope = 0;
    mut var choosing = 0;
    mut var unpicked = 0;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready) continue;
        ready += 1;
        if (s.choosing) choosing += 1;
        if (s.role == Role.None) unpicked += 1;
        if (s.life == Life.Standing) hope += 1;
    }
    switch (match.phase)
    {
        case Phase.Waiting:
            // Everyone's survivor picked first
            if (ready > 0 && unpicked == 0)
            {
                match.phase = Phase.Break;
                match.timer = BREAK_SECONDS - 3;
            }
            return;
        case Phase.Break:
            if (ready == 0)
            {
                match.phase = Phase.Waiting;
                return;
            }
            // The countdown starts once every item is taken (or the one who hasn't has had long enough), and every
            // survivor is picked
            if ((choosing > 0 || unpicked > 0) && match.choosing < CHOICE_MOST)
            {
                match.choosing += time.dt;
                match.timer = 0;
                return;
            }
            if (match.timer < BREAK_SECONDS) return;
            match.round += 1;
            match.phase = Phase.Fighting;
            match.timer = 0;
            match.choosing = 0;
            match.toSpawn = RoundCount(match.round, Players(party));
            match.killed = 0;
            match.drops = 0;
            match.spawnWait = 1.5;
            Send(RoundBegan { round = match.round });
            return;
        case Phase.Fighting:
            if (ready > 0 && hope == 0)
            {
                match.phase = Phase.Over;
                match.timer = 0;
                match.lastRound = match.round;
                Send(GameOver { round = match.round });
                return;
            }
            if (match.toSpawn == 0 && match.alive == 0)
            {
                match.culling = false;
                match.phase = Phase.Break;
                match.timer = 0;
                match.choosing = 0;
                Send(RoundEnded { round = match.round });
            }
            return;
        case Phase.Over:
            return;
    }
}

// Count who's up, each tick, before the waves look.
[Stage(Tick.Rounds, -1)]
system CountDead(mut Match match, query (Zombie zombie) zombies)
{
    mut var alive = 0;
    foreach (var row in zombies)
        if (row.zombie.state != ZombieState.Dying) alive += 1;
    match.alive = alive;
}

// The dead come in a trickle, clawing up out of the ground all round a survivor, 16 to 32 m off and from every side,
// wherever the ground is open and their way to the survivors is clear; a rush (the development key's horde) six a
// tick. Where no such ground is found, out of a grave or the roots at the clearing's edge.
[Stage(Tick.Rounds, 1)]
system SpawnDead(mut Match match, Ashwick ashwick, Time time, Party party, query (Survivor survivor) survivors)
{
    if (match.phase != Phase.Fighting || match.toSpawn <= 0 || match.alive >= MAX_ALIVE) return;
    mut var count = 1;
    if (match.rush > 0)
    {
        count = Math.Min(6, match.rush);
        match.rush -= count;
    }
    else
    {
        match.spawnWait -= time.dt;
        if (match.spawnWait > 0) return;
        match.spawnWait = SpawnGap(match.round, Players(party));
    }
    // Whom they come for: a survivor on their feet, any of them
    mut List<float3> near = [];
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
    if (near.count == 0) return;
    for (var k = 0; k < count && match.toSpawn > 0; k++)
    {
        var focus = near[Random.NextInt(near.count)];
        mut var at = float3(0);
        mut var found = false;
        for (var tries = 0; tries < 8 && !found; tries++)
        {
            var turn = Random.NextFloat(Math.TAU);
            var far = Random.NextFloat(16, 32);
            var there = focus + float3(Math.Sin(turn), 0, Math.Cos(turn)) * far;
            var cell = CellOf(there);
            if (cell < 0 || !InClearing(there) || !Walkable(ashwick, cell) || FieldAt(ashwick, there) >= UNREACHED) continue;
            at = there;
            found = true;
        }
        if (!found)
        {
            // A riser, any of them not at the survivor's feet
            mut List<int> picks = [];
            for (var i = 0; i < ashwick.risers.count; i++)
                if (Math.Distance(ashwick.risers[i].at, focus) >= 7) picks.Add(i);
            if (picks.count == 0) return;
            at = ashwick.risers[picks[Random.NextInt(picks.count)]].at;
        }
        var gait = GaitFor(match.round);
        var health = RoundHealth(match.round);
        var look = Random.NextInt(ZOMBIE_LOOKS);
        at.y = Ground(at.x, at.z);
        Spawn(Zombie { at = at, yaw = YawTo(at, focus), health = health, gait = gait, look = look, state = ZombieState.Rising, pace = Random.NextFloat(0.9, 1.1),
                       phase = Random.NextInt(64) });
        if (k == 0) Send(Cue { sound = Sfx.Rise, at = at });
        match.toSpawn -= 1;
    }
}

Gait GaitFor(int round)
{
    var runners = Math.Clamp((round - 2) * 0.12, 0, 0.92);
    if (Random.NextFloat() >= runners) return Gait.Shamble;
    var sprinters = Math.Clamp((round - 8) * 0.08, 0, 0.6);
    return Random.NextFloat() < sprinters ? Gait.Sprint : Gait.Run;
}

// A wave's end: who's down gets up, who bled out comes back to the fire with what they had, everyone's gun is loaded
// and their skills ready, and each is offered three items. An offer not taken by the next wave is lost.
[Stage(Tick.Rounds, 2)]
system Regroup(mut Survivor survivor, Match match, Ashwick ashwick)
{
    if (match.phase == Phase.Fighting && survivor.choosing) survivor.choosing = false;
    if (match.phase != Phase.Break || match.round <= 0 || !survivor.ready || survivor.role == Role.None || survivor.dealt == match.round) return;
    survivor.dealt = match.round;
    if (survivor.life == Life.Gone)
    {
        var start = ashwick.starts[survivor.seat];
        StandUp(survivor);
        survivor.feet = start;
        survivor.yaw = YawTo(float3(0), start);
        survivor.pitch = 0;
        survivor.velocity = float3(0);
        survivor.placed = true;
        Send(Cue { sound = Sfx.Revive, at = start });
    }
    else if (survivor.life == Life.Downed)
    {
        StandUp(survivor);
        Send(Cue { sound = Sfx.Revive, at = survivor.feet });
    }
    survivor.health = MaxHealth(survivor);
    Refill(survivor);
    Offer(survivor, match.round);
}

event RoundBegan
{
    int round;
}

event RoundEnded
{
    int round;
}

event GameOver
{
    int round;
}
