// The run: once everyone has picked a survivor, a few seconds' breath, and
// the first night falls (nights.tide): the dead never stop coming, more of
// them and tougher the longer it goes and the further into the nights (the
// danger, after Risk of Rain 2's difficulty). Each night ends as its clock
// runs out, in its bosses and a dawn; then the next, harder. There's no end but the last of the
// survivors falling; how many nights, and how long, they held out is the
// score.

enum Phase { Waiting, Fighting, Dawn, Over }

singleton Match
{
    Phase phase;
    float timer;                 // Seconds into the phase (the countdown while waiting, the dawn)
    float clock;                 // Seconds the run has gone
    float danger;                // How dangerous it's got (Danger), each tick
    bool paused;                 // Someone has items to choose: everything waits for them (Pause)
    int players = 1;             // Survivors in the match, each tick
    float crowd = 1;             // How many more of the dead they bring than one alone (nights.tide's Crowd)
    int alive;                   // Up now, counted each tick
    int killed;
    float spawnWait;
    // The hordes (SpawnDead): of the dead owed, the share that rises alone, how many wait for the next horde, and the
    // horde rising now (how many of it are still to come up, of how many, how long since it began, its middle, how wide,
    // whom it's for and at what pace)
    float strays;
    int hordePool;
    float hordeWait;             // Seconds till the next can form
    int hordeLeft;
    int hordeSize;
    float hordeClock;
    float3 hordeAt;
    float hordeRadius;
    float3 hordeFocus;
    Gait hordeGait;
    float hordeTurn;             // Which way from whom it's for it rose (the next comes from the far side)
    bool scattered;              // Development and tests: every one rises alone, as before the hordes
    int rush;                    // Of the dead, how many more come six a tick (the development key's horde)
    int specials;                // How many of the next to rise are of `special`'s kind whatever the shares (the development key's)
    ZombieKind special;
    // The nights (nights.tide)
    int night;                   // Which, from 1
    float nightClock;            // Seconds into it
    float nightEnds;             // When, on its clock, its bosses rise (NIGHT_SECONDS)
    bool reckoning;              // ...and they have: it's dawn once they're down
    int kept;                    // Nights kept to their dawn
    int chestsDue;               // Of its chests, how many are still to be put out...
    int chestsPlaced;            // ...and how many have been
    // The party's experience (items.tide)
    int level;
    float xp;                    // Toward the next level
    // The bosses (boss.tide)
    int orbs;                    // Experience orbs lying (orbs.tide)
    int bosses;                  // How many have come
    int devBoss = -1;            // Development: a boss of this kind now, not one of the night's own (the key's), or -1 for none
    // The eruptions (hazards.tide)
    float eruptWait;             // Seconds till the next
    List<float3> blazes;         // The fires on the ground, x, z, reach (KeepBlazes)
    // The missions (missions.tide): the one going (None, none), where, the seconds it has left, what's done of it
    // against its goal; the seconds till the next; and the development key's kind for the next, or -1 for any
    MissionKind mission;
    float3 missionAt;
    float missionLeft;
    float missionDone;
    float missionGoal;
    float missionWait;
    int devMission = -1;
    // The end
    float lasted;                // How long the run went
    bool restarting;
    bool culling;                // Development: the dead all go
}

const int MAX_ALIVE = 4000;      // Up at once: the most the tick and the frame afford (notes/gravewake.md)
const float START_SECONDS = 4;   // The breath before the first of the dead, once everyone has picked
const float BOSS_THIN = 0.45;    // Of the dead that come, while a boss stands
// The hordes (the owner, 2026-10-18: "i think zombies should spawn in "hordes" more so than one randomly")
const float STRAY_SHARE = 0.25;  // Of the dead owed, how many rise alone, anywhere round; the rest come as hordes
const int HORDE_LEAST = 6;       // A horde waits for at least so many
const int HORDE_MOST = 400;      // ...and is no more than so many (the rest wait for the next)
const float HORDE_FIRST = 3;     // Seconds into a night before the first can form...
const float HORDE_EVERY_LEAST = 5;   // ...and between one and the next
const float HORDE_EVERY_MOST = 9;
const float HORDE_NEAR = 22;     // How far off a survivor its middle is
const float HORDE_FAR = 32;
const float HORDE_SWING = 0.8;   // Each horde from the far side of whom it's for from the last, give or take so many radians
const float HORDE_SPREAD = 0.9;  // How wide a horde's patch is: so many metres times the root of how many, 2 to 12 m
const float HORDE_RISE = 1.0;    // Seconds for the whole of it to claw up
const int HORDE_PER_TICK = 12;

// No horde forming or rising, none owed: a new night's, or a new run's.
void ResetHordes(mut Match match)
{
    match.strays = 0;
    match.hordePool = 0;
    match.hordeWait = HORDE_FIRST;
    match.hordeLeft = 0;
    match.hordeSize = 0;
    match.hordeClock = 0;
}

void ResetMatch(mut Match match)
{
    match.phase = Phase.Waiting;
    match.timer = 0;
    match.clock = 0;
    match.danger = 1;
    match.paused = false;
    match.alive = 0;
    match.killed = 0;
    match.spawnWait = 0;
    ResetHordes(match);
    match.scattered = false;
    match.rush = 0;
    match.specials = 0;
    match.special = ZombieKind.Walker;
    match.night = 0;
    match.nightClock = 0;
    match.nightEnds = NIGHT_SECONDS;
    match.reckoning = false;
    match.kept = 0;
    match.chestsDue = 0;
    match.chestsPlaced = 0;
    match.level = 1;
    match.xp = 0;
    match.bosses = 0;
    match.devBoss = -1;
    ResetMissions(match);
    ResetEruptions(match);
    match.devMission = -1;
    match.orbs = 0;
    match.lasted = 0;
    match.restarting = false;
    match.culling = false;
}

// How dangerous it's got: 1 at the start, one more every two and a half minutes of the run, and each night beyond the
// first NIGHT_STEP times the one before. The same for one
// survivor as for four: a party brings more of the dead (SpawnDead, by Crowd), not tougher ones. (Balanced with the
// bots, test/balance.c.)
float Danger(Match match)
{
    return (1 + match.clock / DANGER_EVERY) * Math.Pow(NIGHT_STEP, Math.Max(0, match.night - 1));
}

// How hard the dead hit at a danger, against at the start: a claw, bile, a Bloater's burst, a boss's blows. (A claw was
// 30 at every danger, which the levels' health soon made nothing.)
float Harm(float danger)
{
    return Math.Pow(danger, 0.4);
}

// What one of the dead can take, at a danger.
float ZombieHealth(float danger)
{
    return 25 * Math.Pow(danger, 1.1);
}

// How many of the dead come a second for one survivor, at a danger: four at the start, twenty at danger 5. (Three
// till the nights went on a clock: with no beacon to hold, the survivors roamed clear of the dead.)
float SpawnRate(float danger)
{
    return 4 * danger;
}

// The words for a danger, after Risk of Rain 2's.
string DangerName(float danger)
{
    if (danger < 2) return "Easy";
    if (danger < 3) return "Medium";
    if (danger < 4.5) return "Hard";
    if (danger < 6) return "Very Hard";
    if (danger < 8) return "Insane";
    if (danger < 11) return "Impossible";
    return "HAHAHAHA";
}

// Waiting for everyone's survivor, the breath, the nights and their dawns, and the end.
[Stage(Tick.Rounds)]
system RunRounds(mut Match match, Time time, Party party, query (Survivor survivor) survivors)
{
    match.players = Players(party);
    match.crowd = Crowd(match.players);
    if (match.paused) return;
    match.timer += time.dt;
    mut var ready = 0;
    mut var hope = 0;
    mut var unpicked = 0;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready) continue;
        ready += 1;
        if (s.role == Role.None) unpicked += 1;
        if (s.life == Life.Standing) hope += 1;
    }
    switch (match.phase)
    {
        case Phase.Waiting:
            // Everyone's survivor picked, then a breath
            if (ready == 0 || unpicked > 0)
            {
                match.timer = 0;
                return;
            }
            if (match.timer < START_SECONDS) return;
            match.phase = Phase.Fighting;
            match.timer = 0;
            match.clock = 0;
            match.spawnWait = 1;
            Nightfall(match);
            match.danger = Danger(match);
            Send(RunBegan { });
            return;
        case Phase.Fighting:
        case Phase.Dawn:
            match.clock += time.dt;
            if (match.phase == Phase.Fighting) match.nightClock += time.dt;
            match.danger = Danger(match);
            if (ready > 0 && hope == 0)
            {
                match.phase = Phase.Over;
                match.timer = 0;
                match.lasted = match.clock;
                Send(GameOver { lasted = match.clock, nights = match.kept });
                return;
            }
            // Dawn's breath over: the next night
            if (match.phase == Phase.Dawn && match.timer >= DAWN_SECONDS)
            {
                match.phase = Phase.Fighting;
                match.timer = 0;
                Nightfall(match);
                match.danger = Danger(match);
            }
            if (match.culling && match.alive == 0) match.culling = false;
            return;
        case Phase.Over:
            return;
    }
}

// While anyone has items to choose, everything waits: the clock, the dead, the bosses, what flies, the guns and the
// skills; the next tick's choosing is this one's (the owner: "the upgrade screen should pause the game, in
// multiplayer it should wait for all").
[Stage(Tick.Restart, 2)]
system Pause(mut Match match, query (Survivor survivor) survivors)
{
    mut var waiting = false;
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.role != Role.None && row.survivor.choosing) waiting = true;
    match.paused = waiting && (match.phase == Phase.Fighting || match.phase == Phase.Dawn);
}

// Count who's up, each tick, before the run looks.
[Stage(Tick.Rounds, -1)]
system CountDead(mut Match match, query (Zombie zombie) zombies)
{
    mut var alive = 0;
    foreach (var row in zombies)
        if (row.zombie.state != ZombieState.Dying) alive += 1;
    match.alive = alive;
}

// The dead come all the time, at a rate: more for a party (Crowd), thicker toward a night's end (nights.tide's Rush),
// fewer while a boss stands (BOSS_THIN: a boss's fight had been lost in the crowd round it). Most come as hordes: every
// HORDE_EVERY_LEAST to HORDE_EVERY_MOST seconds the ones owed since the last claw up together out of one patch of
// ground, 22 to 32 m round a standing survivor, from the far side of the last (HORDE_SWING: so they come from both
// sides, and roaming clear of one runs into the next), at one pace, a groan going up from them
// (HordeRose). The rest (STRAY_SHARE) rise one at a time anywhere 16 to 32 m round, so no side is ever quite safe. A
// rush (the development key's) comes six a tick, alone. Where no open ground is found, out of a grave or the roots at
// the clearing's edge.
[Stage(Tick.Rounds, 1)]
system SpawnDead(mut Match match, Ashwick ashwick, Time time, query (Survivor survivor) survivors, query (Boss boss) bosses)
{
    if (match.paused) return;
    if (match.phase != Phase.Fighting || match.alive >= MAX_ALIVE || match.culling) return;
    var danger = match.danger;
    // Whom they come for: a survivor on their feet, any of them
    mut List<float3> near = [];
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
    if (near.count == 0) return;
    mut var alone = 0;
    if (match.rush > 0)
    {
        alone = Math.Min(6, match.rush);
        match.rush -= alone;
    }
    else
    {
        match.spawnWait -= time.dt;
        mut var brute = false;
        foreach (var row in bosses)
            if (row.boss.move != BossMove.Dying) brute = true;
        var rate = SpawnRate(danger) * match.crowd * Rush(match) * (brute ? BOSS_THIN : 1.0);
        mut var owed = 0;
        while (match.spawnWait <= 0 && owed < 10)
        {
            match.spawnWait += 1 / rate;
            owed += 1;
        }
        // Of those owed, the strays' share rises now; the rest wait for the next horde
        match.strays += owed * (match.scattered ? 1.0 : STRAY_SHARE);
        alone = int(Math.Floor(match.strays));
        match.strays -= alone;
        match.hordePool += owed - alone;
        match.hordeWait -= time.dt;
        if (match.hordeLeft == 0 && match.hordeWait <= 0 && match.hordePool >= HORDE_LEAST)
        {
            var pick = Random.NextInt(near.count);
            var wait = Random.NextFloat(HORDE_EVERY_LEAST, HORDE_EVERY_MOST);
            var swing = Random.NextFloat(-HORDE_SWING, HORDE_SWING);
            var gait = GaitFor(danger);
            var focus = near[pick];
            var turn = match.hordeTurn + Math.PI + swing;
            var middle = RisingToward(ashwick, focus, HORDE_NEAR, HORDE_FAR, turn);
            match.hordeWait = wait;
            if (middle.y > -100)
            {
                var size = Math.Min(match.hordePool, HORDE_MOST);
                match.hordePool -= size;
                match.hordeSize = size;
                match.hordeLeft = size;
                match.hordeClock = 0;
                match.hordeAt = middle;
                match.hordeRadius = Math.Clamp(HORDE_SPREAD * Math.Sqrt(size), 2, 12);
                match.hordeFocus = focus;
                match.hordeGait = gait;
                match.hordeTurn = Math.Atan2(middle.x - focus.x, middle.z - focus.z);
                Send(HordeRose { at = middle, count = size, radius = match.hordeRadius });
            }
        }
    }
    // The horde rising: all of it within HORDE_RISE of its beginning
    if (match.hordeLeft > 0)
    {
        match.hordeClock += time.dt;
        var behind = int(Math.Ceil(match.hordeSize * (1 - Math.Saturate(match.hordeClock / HORDE_RISE))));
        var up = Math.Clamp(match.hordeLeft - behind, 0, HORDE_PER_TICK);
        for (var k = 0; k < up; k++)
        {
            var at = HordePlace(ashwick, match.hordeAt, match.hordeRadius);
            RaiseOne(match, at, match.hordeFocus, match.hordeGait, danger);
        }
        match.hordeLeft -= up;
    }
    for (var k = 0; k < alone; k++)
    {
        var pick = Random.NextInt(near.count);
        var focus = near[pick];
        var at = RisingPlace(ashwick, focus, 16, 32);
        if (at.y < -100) return;
        var gait = GaitFor(danger);
        RaiseOne(match, at, focus, gait, danger);
        if (k == 0) Send(Cue { sound = Sfx.Rise, at = at });
    }
}

// One of the dead clawing up, of a kind by the shares (or the development key's), facing whom it's for.
void RaiseOne(mut Match match, float3 at, float3 focus, Gait gait, float danger)
{
    var look = Random.NextInt(ZOMBIE_LOOKS);
    var pace = Random.NextFloat(0.9, 1.1);
    var phase = Random.NextInt(64);
    var roll = Random.NextFloat();
    mut var kind = KindFor(match, roll);
    if (match.specials > 0)
    {
        match.specials -= 1;
        kind = match.special;
    }
    Spawn(Zombie { at = at, yaw = YawTo(at, focus), health = ZombieHealth(danger) * KindHealth(kind), gait = KindGait(kind, gait), look = look,
                   state = ZombieState.Rising, pace = pace, phase = phase, kind = kind, spit = SPIT_EVERY });
}

// Where one of a horde claws up: anywhere in its patch where the ground is open and the way to the survivors clear
// (four tries), else at its middle.
float3 HordePlace(Ashwick ashwick, float3 middle, float radius)
{
    for (var tries = 0; tries < 4; tries++)
    {
        var turn = Random.NextFloat(Math.TAU);
        var off = radius * Math.Sqrt(Random.NextFloat());
        var there = middle + float3(Math.Sin(turn), 0, Math.Cos(turn)) * off;
        var cell = CellOf(there);
        if (cell < 0 || !InClearing(there) || !Open(ashwick, cell) || FieldAt(ashwick, there) >= UNREACHED) continue;
        return On(there.x, there.z);
    }
    return middle;
}

// A horde clawing up: where its middle is, how many and how wide (for what's heard and seen).
event HordeRose
{
    float3 at;
    int count;
    float radius;
}

// What kind of the dead rises, from a roll: none but the walking dead at first; then Bloaters from BLOATERS_FROM (one
// in 40, up to one in 14 as the danger climbs), Spitters from SPITTERS_FROM (one in 50 up to one in 20) and Wardens
// from WARDENS_FROM (one in 50 up to one in 12).
ZombieKind KindFor(Match match, float roll)
{
    var steps = match.danger - 1;
    var bloaters = match.clock < BLOATERS_FROM ? 0 : Math.Min(0.07, 0.025 + 0.01 * steps);
    var spitters = match.clock < SPITTERS_FROM ? 0 : Math.Min(0.05, 0.02 + 0.006 * steps);
    var wardens = match.clock < WARDENS_FROM ? 0 : Math.Min(0.08, 0.02 + 0.008 * steps);
    if (roll < bloaters) return ZombieKind.Bloater;
    if (roll < bloaters + spitters) return ZombieKind.Spitter;
    if (roll < bloaters + spitters + wardens) return ZombieKind.Warden;
    return ZombieKind.Walker;
}

const float BLOATERS_FROM = 40;
const float SPITTERS_FROM = 75;
const float WARDENS_FROM = 120;

// Where one of the dead can claw up near a survivor: `near` to `far` metres off, any side, on open ground the dead can
// walk and from which their way to the survivors is clear (eight tries); else a riser 7 m or more off; else a place far
// below the world (none).
float3 RisingPlace(Ashwick ashwick, float3 focus, float near, float far)
{
    for (var tries = 0; tries < 8; tries++)
    {
        var turn = Random.NextFloat(Math.TAU);
        var off = Random.NextFloat(near, far);
        var there = focus + float3(Math.Sin(turn), 0, Math.Cos(turn)) * off;
        var cell = CellOf(there);
        if (cell < 0 || !InClearing(there) || !Open(ashwick, cell) || FieldAt(ashwick, there) >= UNREACHED) continue;
        return On(there.x, there.z);
    }
    mut List<int> picks = [];
    for (var i = 0; i < ashwick.risers.count; i++)
        if (Math.Distance(ashwick.risers[i].at, focus) >= 7) picks.Add(i);
    if (picks.count == 0) return float3(0, -1000, 0);
    var riser = ashwick.risers[picks[Random.NextInt(picks.count)]].at;
    return On(riser.x, riser.z);
}

// As RisingPlace, toward a turn from the focus first (give or take a little, four tries), else any way.
float3 RisingToward(Ashwick ashwick, float3 focus, float near, float far, float turn)
{
    for (var tries = 0; tries < 4; tries++)
    {
        var way = turn + Random.NextFloat(-0.35, 0.35);
        var off = Random.NextFloat(near, far);
        var there = focus + float3(Math.Sin(way), 0, Math.Cos(way)) * off;
        var cell = CellOf(there);
        if (cell < 0 || !InClearing(there) || !Open(ashwick, cell) || FieldAt(ashwick, there) >= UNREACHED) continue;
        return On(there.x, there.z);
    }
    return RisingPlace(ashwick, focus, near, far);
}

Gait GaitFor(float danger)
{
    var runners = Math.Clamp((danger - 1.4) * 0.3, 0, 0.92);
    if (Random.NextFloat() >= runners) return Gait.Shamble;
    var sprinters = Math.Clamp((danger - 3.5) * 0.15, 0, 0.6);
    return Random.NextFloat() < sprinters ? Gait.Sprint : Gait.Run;
}

event RunBegan { }

event GameOver
{
    float lasted;
    int nights;                  // Kept to their dawn
}
