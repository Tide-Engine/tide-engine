// Rounds: a few seconds' breath, then the bell, and the dead come, more of
// them each round, tougher and faster, until every one of the round is down.
// What the match keeps of the fight is here: the round, the doors bought,
// the boards on the windows, the chest, the Runeforge, the power-ups.

enum Phase { Waiting, Break, Fighting, Over }

enum ChestState { Shut, Spinning, Offering, Fleeing, Gone }

enum ForgeState { Cold, Working, Offering }

singleton Match
{
    Phase phase;
    int round;
    float timer;                 // Seconds into the phase
    int toSpawn;                 // Of this round's dead, still to come
    int alive;                   // Up now, counted each tick
    int killed;                  // This round's, for the round's end
    float spawnWait;
    int gatesOpen;               // A bit per Gate
    int zonesOpen;               // A bit per Zone
    bool power;
    List<int> boards;            // Per window: boards across it, 0 to 6
    int[4] boardPoints;          // Per seat: points for boards this round (they stop at a few hundred)
    // The chest
    int chestSpot;               // Which of the chest's places it's at (an index into the Chest stalls)
    ChestState chest;
    float chestTime;
    Weapon chestWeapon;
    int chestFor = -1;           // Whose turn it is: they paid
    int chestUses;
    bool chestSkull;             // This turn shows the skull, and the chest leaves
    // The Runeforge
    ForgeState forge;
    float forgeTime;
    Weapon forgeWeapon;
    int forgeFor = -1;
    // Power-ups
    float instakill;             // Seconds left
    float doubled;
    int drops;                   // This round's
    int dropTurn;                // Where in the round of power-ups the next one is
    // The end
    float overTime;
    int lastRound;
    bool restarting;
    bool culling;                // Development: the round's dead all go
}

const int MAX_ALIVE = 24;
const int BOARDS = 6;
const float BREAK_SECONDS = 9;

void ResetMatch(mut Match match, Ashwick ashwick)
{
    match.phase = Phase.Waiting;
    match.round = 0;
    match.timer = 0;
    match.toSpawn = 0;
    match.alive = 0;
    match.killed = 0;
    match.spawnWait = 0;
    match.gatesOpen = 0;
    match.power = false;
    for (var seat = 0; seat < 4; seat++) match.boardPoints[seat] = 0;
    match.chest = ChestState.Shut;
    match.chestTime = 0;
    match.chestWeapon = Weapon.None;
    match.chestFor = -1;
    match.chestUses = 0;
    match.chestSkull = false;
    match.forge = ForgeState.Cold;
    match.forgeTime = 0;
    match.forgeWeapon = Weapon.None;
    match.forgeFor = -1;
    match.instakill = 0;
    match.doubled = 0;
    match.drops = 0;
    match.dropTurn = 0;
    match.overTime = 0;
    match.lastRound = 0;
    match.restarting = false;
    match.culling = false;
    match.zonesOpen = 1 << int(Zone.Square);
    match.boards.Clear();
    for (var i = 0; i < ashwick.windows.count; i++) match.boards.Add(BOARDS);
    match.chestSpot = 0;
}

// How many dead a round brings, for so many survivors.
int RoundCount(int round, int players)
{
    var crowd = 1 + 0.6 * (players - 1);
    if (round <= 4)
    {
        var early = round == 1 ? 6 : round == 2 ? 8 : round == 3 ? 13 : 18;
        return int(Math.Round(early * crowd));
    }
    return int(Math.Round(24 * crowd * (0.6 + round * 0.1)));
}

// How much a round's dead can take.
float RoundHealth(int round)
{
    if (round < 10) return 150 + 100 * (round - 1);
    return 950 * Math.Pow(1.1, round - 9);
}

float SpawnGap(int round, int players)
{
    return Math.Max(0.35, 2.0 * Math.Pow(0.95, round - 1)) / (1 + 0.3 * (players - 1));
}

// Waiting for someone, the breath between rounds, the round, and the end.
[Stage(Tick.Rounds)]
system RunRounds(mut Match match, Time time, Party party, query (Survivor survivor) survivors)
{
    match.timer += time.dt;
    match.instakill = Math.Max(0, match.instakill - time.dt);
    match.doubled = Math.Max(0, match.doubled - time.dt);
    mut var ready = 0;
    mut var hope = 0;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready) continue;
        ready += 1;
        if (s.life == Life.Standing || (s.life == Life.Downed && s.selfRevives > 0 && party.joined == 1)) hope += 1;
    }
    switch (match.phase)
    {
        case Phase.Waiting:
            if (ready > 0)
            {
                match.phase = Phase.Break;
                match.timer = BREAK_SECONDS - 3;
            }
            return;
        case Phase.Break:
            if (ready == 0)
            {
                match.phase = Phase.Waiting;
                return;
            }
            if (match.timer < BREAK_SECONDS) return;
            match.round += 1;
            match.phase = Phase.Fighting;
            match.timer = 0;
            match.toSpawn = RoundCount(match.round, Players(party));
            match.killed = 0;
            match.drops = 0;
            match.spawnWait = 1.5;
            for (var seat = 0; seat < 4; seat++) match.boardPoints[seat] = 0;
            Send(RoundBegan { round = match.round });
            return;
        case Phase.Fighting:
            if (ready > 0 && hope == 0)
            {
                match.phase = Phase.Over;
                match.timer = 0;
                match.lastRound = match.round;
                Send(GameOver { round = match.round });
                return;
            }
            if (match.toSpawn == 0 && match.alive == 0)
            {
                match.culling = false;
                match.phase = Phase.Break;
                match.timer = 0;
                Send(RoundEnded { round = match.round });
            }
            return;
        case Phase.Over:
            return;
    }
}

// Count who's up, each tick, before the rounds look.
[Stage(Tick.Rounds, -1)]
system CountDead(mut Match match, query (Zombie zombie) zombies)
{
    mut var alive = 0;
    foreach (var row in zombies)
        if (row.zombie.state != ZombieState.Dying) alive += 1;
    match.alive = alive;
}

// The dead come in a trickle, from the windows and the ground of the open areas nearest the survivors.
[Stage(Tick.Rounds, 1)]
system SpawnDead(mut Match match, Ashwick ashwick, Time time, Party party, query (Survivor survivor) survivors)
{
    if (match.phase != Phase.Fighting || match.toSpawn <= 0 || match.alive >= MAX_ALIVE) return;
    match.spawnWait -= time.dt;
    if (match.spawnWait > 0) return;
    match.spawnWait = SpawnGap(match.round, Players(party));
    // Whom they come for: a survivor on their feet, any of them
    mut List<float3> near = [];
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
    if (near.count == 0) return;
    var focus = near[Random.NextInt(near.count)];
    // The open places they can come from, nearest that survivor first
    mut List<int> picks = [];
    mut List<float> distances = [];
    for (var i = 0; i < ashwick.windows.count; i++)
    {
        var window = ashwick.windows[i];
        if (!ZoneOpen(match.zonesOpen, window.zone)) continue;
        Insert(picks, distances, i, Math.Distance(window.inside, focus) + 2);
    }
    for (var i = 0; i < ashwick.risers.count; i++)
    {
        var riser = ashwick.risers[i];
        if (!ZoneOpen(match.zonesOpen, riser.zone)) continue;
        var far = Math.Distance(riser.at, focus);
        if (far < 6) continue;          // Not at their feet
        Insert(picks, distances, 1000 + i, far);
    }
    if (picks.count == 0) return;
    var pick = picks[Random.NextInt(Math.Min(4, picks.count))];
    var gait = GaitFor(match.round);
    var health = RoundHealth(match.round);
    var look = Random.NextInt(ZOMBIE_LOOKS);
    if (pick >= 1000)
    {
        var riser = ashwick.risers[pick - 1000];
        var at = riser.at + float3(Random.NextFloat(-0.6, 0.6), 0, Random.NextFloat(-0.6, 0.6));
        Spawn(Zombie { at = at, yaw = YawTo(at, focus), health = health, gait = gait, look = look, state = ZombieState.Rising, pace = Random.NextFloat(0.9, 1.1) });
        Send(Cue { sound = Sfx.Rise, at = at });
    }
    else
    {
        var window = ashwick.windows[pick];
        Spawn(Zombie { at = window.spawn, yaw = YawTo(window.spawn, window.outside), health = health, gait = gait, look = look, state = ZombieState.Outside,
                       window = pick, pace = Random.NextFloat(0.9, 1.1) });
    }
    match.toSpawn -= 1;
}

// Into a list kept nearest first.
void Insert(mut List<int> picks, mut List<float> distances, int pick, float distance)
{
    mut var at = picks.count;
    while (at > 0 && distances[at - 1] > distance) at -= 1;
    picks.Insert(at, pick);
    distances.Insert(at, distance);
}

Gait GaitFor(int round)
{
    var runners = Math.Clamp((round - 2) * 0.12, 0, 0.92);
    if (Random.NextFloat() >= runners) return Gait.Shamble;
    var sprinters = Math.Clamp((round - 8) * 0.08, 0, 0.6);
    return Random.NextFloat() < sprinters ? Gait.Sprint : Gait.Run;
}

// Between rounds, those who bled out come back, with what they started with.
[Stage(Tick.Rounds, 2)]
system ComeBack(mut Survivor survivor, Match match, Ashwick ashwick)
{
    if (survivor.life != Life.Gone || match.phase != Phase.Break) return;
    var start = ashwick.starts[survivor.seat];
    mut var fresh = Outfitted(survivor.seat, start, YawTo(start, float3(0, 0, 4)));
    fresh.points = survivor.points;
    fresh.kills = survivor.kills;
    fresh.headshots = survivor.headshots;
    fresh.downs = survivor.downs;
    fresh.revives = survivor.revives;
    fresh.ready = survivor.ready;
    survivor = fresh;
    Send(Cue { sound = Sfx.Revive, at = start });
}

event RoundBegan
{
    int round;
}

event RoundEnded
{
    int round;
}

event GameOver
{
    int round;
}
