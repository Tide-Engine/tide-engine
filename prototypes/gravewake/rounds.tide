// Waves: a few seconds' breath, then the bell, and the dead come, more of
// them each wave, tougher and faster, until every one of the wave is down.
// Then each survivor is dealt three cards and takes one: a new weapon, a
// brew, or something that makes them harder to kill. There's no end but the
// last of them falling; how far they got is the score.

enum Phase { Waiting, Break, Fighting, Over }

singleton Match
{
    Phase phase;
    int round;
    float timer;                 // Seconds into the phase (into the countdown, once everyone has chosen)
    int toSpawn;                 // Of this wave's dead, still to come
    int alive;                   // Up now, counted each tick
    int killed;                  // This wave's, for the wave's end
    float spawnWait;
    float choosing;              // Seconds the survivors have had to choose their cards
    // Power-ups
    float instakill;             // Seconds left
    int drops;                   // This wave's
    int dropTurn;                // Where in the round of power-ups the next one is
    // The end
    int lastRound;
    bool restarting;
    bool culling;                // Development: the wave's dead all go
}

const int MAX_ALIVE = 24;
const float BREAK_SECONDS = 5;   // The countdown to the next wave, once everyone has taken a card
const float CHOICE_MOST = 45;    // How long the others wait for one who hasn't

void ResetMatch(mut Match match)
{
    match.phase = Phase.Waiting;
    match.round = 0;
    match.timer = 0;
    match.toSpawn = 0;
    match.alive = 0;
    match.killed = 0;
    match.spawnWait = 0;
    match.choosing = 0;
    match.instakill = 0;
    match.drops = 0;
    match.dropTurn = 0;
    match.lastRound = 0;
    match.restarting = false;
    match.culling = false;
}

// How many dead a wave brings, for so many survivors.
int RoundCount(int round, int players)
{
    var crowd = 1 + 0.6 * (players - 1);
    if (round <= 4)
    {
        var early = round == 1 ? 6 : round == 2 ? 8 : round == 3 ? 13 : 18;
        return int(Math.Round(early * crowd));
    }
    return int(Math.Round(24 * crowd * (0.6 + round * 0.1)));
}

// How much a wave's dead can take.
float RoundHealth(int round)
{
    if (round < 10) return 150 + 100 * (round - 1);
    return 950 * Math.Pow(1.1, round - 9);
}

float SpawnGap(int round, int players)
{
    return Math.Max(0.35, 2.0 * Math.Pow(0.95, round - 1)) / (1 + 0.3 * (players - 1));
}

// Waiting for someone, the cards and the breath between waves, the wave, and the end.
[Stage(Tick.Rounds)]
system RunRounds(mut Match match, Time time, Party party, query (Survivor survivor) survivors)
{
    match.timer += time.dt;
    match.instakill = Math.Max(0, match.instakill - time.dt);
    mut var ready = 0;
    mut var hope = 0;
    mut var choosing = 0;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready) continue;
        ready += 1;
        if (s.choosing) choosing += 1;
        if (s.life == Life.Standing || (s.life == Life.Downed && s.selfRevives > 0 && party.joined == 1)) hope += 1;
    }
    switch (match.phase)
    {
        case Phase.Waiting:
            if (ready > 0)
            {
                match.phase = Phase.Break;
                match.timer = BREAK_SECONDS - 3;
            }
            return;
        case Phase.Break:
            if (ready == 0)
            {
                match.phase = Phase.Waiting;
                return;
            }
            // The countdown starts once every card is taken (or the one who hasn't has had long enough)
            if (choosing > 0 && match.choosing < CHOICE_MOST)
            {
                match.choosing += time.dt;
                match.timer = 0;
                return;
            }
            if (match.timer < BREAK_SECONDS) return;
            match.round += 1;
            match.phase = Phase.Fighting;
            match.timer = 0;
            match.choosing = 0;
            match.toSpawn = RoundCount(match.round, Players(party));
            match.killed = 0;
            match.drops = 0;
            match.spawnWait = 1.5;
            Send(RoundBegan { round = match.round });
            return;
        case Phase.Fighting:
            if (ready > 0 && hope == 0)
            {
                match.phase = Phase.Over;
                match.timer = 0;
                match.lastRound = match.round;
                Send(GameOver { round = match.round });
                return;
            }
            if (match.toSpawn == 0 && match.alive == 0)
            {
                match.culling = false;
                match.phase = Phase.Break;
                match.timer = 0;
                match.choosing = 0;
                Send(RoundEnded { round = match.round });
            }
            return;
        case Phase.Over:
            return;
    }
}

// Count who's up, each tick, before the waves look.
[Stage(Tick.Rounds, -1)]
system CountDead(mut Match match, query (Zombie zombie) zombies)
{
    mut var alive = 0;
    foreach (var row in zombies)
        if (row.zombie.state != ZombieState.Dying) alive += 1;
    match.alive = alive;
}

// The dead come in a trickle, out of the graves and the roots at the clearing's edge nearest the survivors.
[Stage(Tick.Rounds, 1)]
system SpawnDead(mut Match match, Ashwick ashwick, Time time, Party party, query (Survivor survivor) survivors)
{
    if (match.phase != Phase.Fighting || match.toSpawn <= 0 || match.alive >= MAX_ALIVE) return;
    match.spawnWait -= time.dt;
    if (match.spawnWait > 0) return;
    match.spawnWait = SpawnGap(match.round, Players(party));
    // Whom they come for: a survivor on their feet, any of them
    mut List<float3> near = [];
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
    if (near.count == 0) return;
    var focus = near[Random.NextInt(near.count)];
    // The places they can come from, nearest that survivor first, but not at their feet
    mut List<int> picks = [];
    mut List<float> distances = [];
    for (var i = 0; i < ashwick.risers.count; i++)
    {
        var far = Math.Distance(ashwick.risers[i].at, focus);
        if (far < 7) continue;
        Insert(picks, distances, i, far);
    }
    if (picks.count == 0) return;
    var riser = ashwick.risers[picks[Random.NextInt(Math.Min(5, picks.count))]];
    var gait = GaitFor(match.round);
    var health = RoundHealth(match.round);
    var look = Random.NextInt(ZOMBIE_LOOKS);
    var at = riser.at + float3(Random.NextFloat(-0.5, 0.5), 0, Random.NextFloat(-0.5, 0.5));
    Spawn(Zombie { at = at, yaw = YawTo(at, focus), health = health, gait = gait, look = look, state = ZombieState.Rising, pace = Random.NextFloat(0.9, 1.1) });
    Send(Cue { sound = Sfx.Rise, at = at });
    match.toSpawn -= 1;
}

// Into a list kept nearest first.
void Insert(mut List<int> picks, mut List<float> distances, int pick, float distance)
{
    mut var at = picks.count;
    while (at > 0 && distances[at - 1] > distance) at -= 1;
    picks.Insert(at, pick);
    distances.Insert(at, distance);
}

Gait GaitFor(int round)
{
    var runners = Math.Clamp((round - 2) * 0.12, 0, 0.92);
    if (Random.NextFloat() >= runners) return Gait.Shamble;
    var sprinters = Math.Clamp((round - 8) * 0.08, 0, 0.6);
    return Random.NextFloat() < sprinters ? Gait.Sprint : Gait.Run;
}

// A wave's end: who's down gets up, who bled out comes back to the fire with what they had, everyone's arrows and pots
// are filled, and each is dealt their cards. A card not taken by the next wave is lost.
[Stage(Tick.Rounds, 2)]
system Regroup(mut Survivor survivor, Match match, Ashwick ashwick, Party party)
{
    if (match.phase == Phase.Fighting && survivor.choosing) survivor.choosing = false;
    if (match.phase != Phase.Break || match.round <= 0 || !survivor.ready || survivor.dealt == match.round) return;
    survivor.dealt = match.round;
    if (survivor.life == Life.Gone)
    {
        var start = ashwick.starts[survivor.seat];
        StandUp(survivor);
        survivor.feet = start;
        survivor.yaw = YawTo(float3(0), start);
        survivor.pitch = 0;
        survivor.velocity = float3(0);
        survivor.placed = true;
        Send(Cue { sound = Sfx.Revive, at = start });
    }
    else if (survivor.life == Life.Downed)
    {
        StandUp(survivor);
        Send(Cue { sound = Sfx.Revive, at = survivor.feet });
    }
    survivor.health = MaxHealth(survivor);
    Refill(survivor);
    if (HasBrew(survivor, Brew.SecondWind) && party.joined <= 1) survivor.selfRevives = 1;
    Deal(survivor, match.round);
}

event RoundBegan
{
    int round;
}

event RoundEnded
{
    int round;
}

event GameOver
{
    int round;
}
