using Rooms;

// The nights: a run is a string of them in the clearing, each harder than
// the last, each on its own clock (after The Spell Brigade's: the owner,
// 2026-10-18, "maybe the bosses are time based instead of that one mission?
// ... i just wanna roam, shoot and level"). As a night falls its chests are
// hidden about and its clock starts: NIGHT_SECONDS to roam, kill and level,
// the dead coming thicker over its last minute (NIGHT_RUSH), the boss's
// coming told WARN_SECONDS before. When it runs out a ring of pale
// wake-fire rises round the survivors (RING_REACH), which the living can't
// cross and the dead walk through, and the night's boss (two from the fourth
// night, three from the seventh) claws up in it with them: a stand, as in a
// Dark Souls boss's arena, not a chase (with nowhere to hold, the bots had
// never gone down). Whoever has bled out is back. Once its bosses are down, dawn
// breaks: the dead burn away, the orbs fly in, whoever's down is up, and a
// moment later the next night falls, with new chests (the ones not found are
// gone with the night). One who bleeds out is back beside a friend
// BACK_AFTER later, if the boss or the dawn hasn't brought them sooner. (The
// beacon each night had to be found, lit and kept by is gone: the owner,
// "that mission just feels like something annoying to do".) The numbers are
// mine, Provisional.

const float NIGHT_STEP = 1.25;       // How much more dangerous each night is than the one before, on top of the clock's climb
const float DANGER_EVERY = 150;      // Seconds of the run for each step of danger the clock brings
const float NIGHT_SECONDS = 180;     // To roam, till the night's boss claws up
const float RUSH_SECONDS = 60;       // Over a night's last so many seconds...
const float NIGHT_RUSH = 2;          // ...the dead come thicker, up to so many times as fast
const float WARN_SECONDS = 10;       // The boss's coming told so long before
const float DAWN_SECONDS = 10;       // The breath between one night and the next
const float BACK_AFTER = 60;         // Bled out: back beside a friend after so long, if nothing's brought them sooner
const float RING_REACH = 17;         // The wake-fire's ring at the night's end: how far from its middle

// How many more of the dead a party brings than one survivor alone: each beyond the first, most of another's worth.
// The dead are as tough for four as for one; the experience a level takes grows the same way (items.tide), so each
// survivor's picks come about as often in a party as alone.
float Crowd(int players)
{
    return 1 + 0.8 * (players - 1);
}

// How many chests a night hides, however many there are: each one's a pick for all of them.
const int CHESTS_A_NIGHT = 4;

// How many bosses rise at a night's end.
int NightBosses(int night)
{
    return 1 + (night - 1) / 3;
}

// How many times as fast the dead come, by the night's clock: thickening over its last RUSH_SECONDS to NIGHT_RUSH.
// (While its bosses stand, rounds.tide's BOSS_THIN.)
float Rush(Match match)
{
    if (match.reckoning) return 1;
    return 1 + (NIGHT_RUSH - 1) * Math.Saturate((match.nightClock - (match.nightEnds - RUSH_SECONDS)) / RUSH_SECONDS);
}

// What each night is like: the first moonlit, then mist, a blood moon, a starless one, the wake (a sick green), and
// round again from the mist.
int NightKind(int night)
{
    if (night <= 1) return 0;
    return 1 + (night - 2) % 4;
}

string NightName(int night)
{
    switch (NightKind(night))
    {
        case 1: return "Mist";
        case 2: return "Blood Moon";
        case 3: return "Starless";
        case 4: return "The Wake";
    }
    return "Moonlit";
}

// Seconds as a clock: 2:05.
string ClockText(float seconds)
{
    var whole = int(Math.Ceil(Math.Max(0, seconds)));
    var s = whole % 60;
    return s < 10 ? $"{whole / 60}:0{s}" : $"{whole / 60}:{s}";
}

event DawnBroke
{
    int night;
    float3 at;
}

event NightFell
{
    int night;
}

// The night's clock run out: its bosses rising.
event Reckoning
{
    int night;
    int bosses;
}

// To each survivor at dawn: up, whole and ready, wherever they are (or, bled out, beside a friend).
event Dawned
{
    float3 at;
}

// To each survivor as the night's bosses rise: one who bled out is back beside a friend.
event Recalled
{
    float3 at;
}

// A night falls: its chests to come, its own clock and its end.
void Nightfall(mut Match match)
{
    match.night += 1;
    match.nightClock = 0;
    match.nightEnds = NIGHT_SECONDS;
    match.reckoning = false;
    match.ringReach = 0;
    ResetHordes(match);
    ResetMissions(match);
    match.chestsDue = CHESTS_A_NIGHT;
    match.chestsPlaced = 0;
    Send(NightFell { night = match.night });
}

// The night's clock run out: the wake-fire's ring rises round the survivors standing (its middle theirs), its bosses
// claw up in it, 8 m from its middle to 4 m short of its fire, and whoever bled out is back by its middle; once its
// bosses are down (or dying), dawn, and the ring's gone.
[Stage(Tick.Rounds, 4)]
system Reckon(mut Match match, Ashwick ashwick, Party party, query (Survivor survivor) survivors, query (Boss boss) bosses)
{
    if (match.paused || match.phase != Phase.Fighting) return;
    mut List<float3> near = [];
    foreach (var row in survivors)
        if (row.survivor.ready && row.survivor.role != Role.None && row.survivor.life == Life.Standing) near.Add(row.survivor.feet);
    if (near.count == 0) return;
    if (!match.reckoning)
    {
        if (match.nightClock < match.nightEnds) return;
        match.reckoning = true;
        mut var middle = float3(0);
        foreach (var at in near) middle += at;
        middle /= near.count;
        match.ringAt = On(middle.x, middle.z);
        match.ringReach = RING_REACH;
        var count = NightBosses(match.night);
        for (var k = 0; k < count; k++) RaiseBoss(match, ashwick, match.ringAt, true, 8, RING_REACH - 4, KindForNight(match.night, k));
        for (var seat = 0; seat < 4; seat++)
            if (party.taken[seat]) party.survivors[seat].Send(Recalled { at = match.ringAt });
        Send(Reckoning { night = match.night, bosses = count });
        return;
    }
    foreach (var row in bosses)
        if (row.boss.own && row.boss.move != BossMove.Dying) return;
    // Dawn
    match.phase = Phase.Dawn;
    match.timer = 0;
    match.reckoning = false;
    match.ringReach = 0;
    match.kept = match.night;
    for (var seat = 0; seat < 4; seat++)
        if (party.taken[seat]) party.survivors[seat].Send(Dawned { at = near[0] });
    Send(DawnBroke { night = match.night, at = near[0] });
}

// Bled out: back beside a friend still standing BACK_AFTER later, if the night's bosses or its dawn haven't brought
// them back sooner.
[Stage(Tick.Rounds, 5)]
system ComeBack(mut Survivor survivor, Match match, Time time, query (Survivor survivor) others)
{
    if (match.paused || match.phase != Phase.Fighting || !survivor.ready || survivor.role == Role.None || survivor.life != Life.Gone) return;
    survivor.gone += time.dt;
    if (survivor.gone < BACK_AFTER) return;
    foreach (var row in others)
    {
        var other = row.survivor;
        if (other.seat == survivor.seat || !other.ready || other.life != Life.Standing) continue;
        Recall(survivor, other.feet);
        return;
    }
}

// A survivor's feet kept inside the wake-fire's ring while it stands.
float3 InRing(Match match, float3 feet)
{
    var off = (feet - match.ringAt).xz;
    var far = Math.Length(off);
    var most = match.ringReach - BODY_RADIUS;
    if (match.ringReach <= 0 || far <= most || far < 0.001) return feet;
    return float3(match.ringAt.x + off.x / far * most, feet.y, match.ringAt.z + off.y / far * most);
}

// Back beside a friend, as they were when they went, whole: by their seat, a few steps off them.
void Recall(mut Survivor survivor, float3 at)
{
    var off = Flat(survivor.seat * Math.PI * 0.5 + 0.4) * 2.4;
    StandUp(survivor);
    Refill(survivor);
    survivor.gone = 0;
    survivor.feet = On(at.x + off.x, at.z + off.z);
    survivor.yaw = YawTo(survivor.feet, at) + Math.PI;
    survivor.pitch = 0;
    survivor.velocity = float3(0);
    survivor.placed = true;
    Send(Cue { sound = Sfx.Revive, at = survivor.feet });
}

event(Recalled recalled) TakeRecalled(mut Survivor survivor)
{
    if (survivor.ready && survivor.role != Role.None && survivor.life == Life.Gone) Recall(survivor, recalled.at);
}

// Dawn: everyone up, whole and ready; one who bled out back beside a friend.
event(Dawned dawned) TakeDawn(mut Survivor survivor)
{
    if (!survivor.ready || survivor.role == Role.None) return;
    if (survivor.life == Life.Gone)
    {
        Recall(survivor, dawned.at);
        return;
    }
    if (survivor.life == Life.Downed) StandUp(survivor);
    survivor.health = MaxHealth(survivor);
    Refill(survivor);
}

// ---- What's seen and heard ----

// The night's light: each kind of night its moon, sky and fog, eased into as it falls; and dawn's grey-rose light as
// the night's kept, back to the next night's dark as it falls. (eye.tide's Prepare, each frame.)
void NightLook(mut Look look, Match match, float dt)
{
    mut var moon = float3(0.52, 0.57, 0.74);
    mut var sky = float3(0.09, 0.1, 0.13);
    mut var fogColor = float3(0.045, 0.05, 0.07);
    mut var mistColor = float3(0.075, 0.085, 0.11);
    mut var fog = 0.007;
    mut var mist = 0.018;
    switch (NightKind(match.night))
    {
        case 1:
            moon = float3(0.46, 0.5, 0.62);
            fogColor = float3(0.07, 0.076, 0.09);
            mistColor = float3(0.11, 0.12, 0.14);
            fog = 0.011;
            mist = 0.035;
            break;
        case 2:
            moon = float3(0.78, 0.32, 0.27);
            sky = float3(0.1, 0.06, 0.065);
            fogColor = float3(0.065, 0.028, 0.03);
            mistColor = float3(0.1, 0.045, 0.045);
            break;
        case 3:
            moon = float3(0.32, 0.35, 0.48);
            sky = float3(0.06, 0.065, 0.085);
            fogColor = float3(0.025, 0.028, 0.036);
            mistColor = float3(0.04, 0.045, 0.055);
            fog = 0.009;
            break;
        case 4:
            moon = float3(0.42, 0.7, 0.5);
            sky = float3(0.06, 0.09, 0.07);
            fogColor = float3(0.03, 0.06, 0.045);
            mistColor = float3(0.05, 0.1, 0.07);
            fog = 0.011;
            mist = 0.035;
            break;
    }
    if (match.phase == Phase.Dawn)
    {
        var up = Math.SmoothStep(0, 4, match.timer) * (1 - Math.SmoothStep(DAWN_SECONDS - 3, DAWN_SECONDS, match.timer));
        moon = Math.Lerp(moon, float3(0.95, 0.62, 0.48), up);
        sky = Math.Lerp(sky, float3(0.22, 0.17, 0.19), up);
        fogColor = Math.Lerp(fogColor, float3(0.3, 0.22, 0.23), up);
        mistColor = Math.Lerp(mistColor, float3(0.36, 0.28, 0.28), up);
        fog = Math.Lerp(fog, 0.006, up);
    }
    var ease = Math.Min(1, dt * 0.6);
    look.moonColor += (moon - look.moonColor) * ease;
    look.skyLight += (sky - look.skyLight) * ease;
    look.fogColor += (fogColor - look.fogColor) * ease;
    look.mistColor += (mistColor - look.mistColor) * ease;
    look.fog += (fog - look.fog) * ease;
    look.mist += (mist - look.mist) * ease;
}

// The night, top left under the menu: which, and what's coming: the time till its boss (going red as it nears) and how
// many of its chests are found; its bosses to fell; or dawn.
[Stage(Layers.Hud, 1)]
view NightPanel(Me me, Lobby lobby, Match match, Look look, query (Survivor survivor) survivors, query (Chest chest) chests, query (Boss boss) bosses)
{
    if (lobby.page != Page.Playing || match.phase == Phase.Waiting || match.phase == Phase.Over || match.night < 1) return;
    mut var mine = Survivor { };
    mut var found = false;
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found || mine.role == Role.None) return;
    mut var standing = 0;
    foreach (var row in chests)
        if (row.chest.night == match.night) standing += 1;
    mut var brutes = 0;
    foreach (var row in bosses)
        if (row.boss.own && row.boss.move != BossMove.Dying) brutes += 1;
    Draw.SetScreen();
    var u = Unit();
    var box = float2(34 * u + 150 * u, 92 * u);
    Panel(box, float2(300 * u, 74 * u), u);
    var left = box.x - 136 * u;
    var right = box.x + 136 * u;
    WriteBold($"NIGHT {match.night}", float2(left, box.y - 20 * u), 18 * u, BONE, Anchor.MiddleLeft);
    Write(NightName(match.night).ToUpper(), float2(left + Draw.MeasureText($"NIGHT {match.night}", 18 * u, Font.Bold).x + 12 * u, box.y - 19 * u), 12 * u,
          Color(look.moonColor.x * 1.6 + 0.2, look.moonColor.y * 1.6 + 0.2, look.moonColor.z * 1.6 + 0.2, 1), Anchor.MiddleLeft);
    if (match.phase == Phase.Dawn)
    {
        WriteBold("DAWN", float2(left, box.y + 6 * u), 15 * u, GOLD, Anchor.MiddleLeft);
        Write($"Night {match.night} survived. The next falls in {int(Math.Ceil(Math.Max(0, DAWN_SECONDS - match.timer)))}", float2(left, box.y + 24 * u), 12 * u, ASH,
              Anchor.MiddleLeft);
        return;
    }
    if (match.reckoning)
    {
        var pulse = 0.75 + 0.25 * Math.Sin(look.time * 5);
        WriteBold(brutes > 1 ? $"FELL THE BOSSES  -  {brutes} LEFT" : "FELL THE BOSS", float2(left, box.y + 6 * u), 15 * u, Color(EMBER.r, EMBER.g, EMBER.b, pulse),
                  Anchor.MiddleLeft);
        Write("The wake-fire holds you in till dawn", float2(left, box.y + 24 * u), 11 * u, ASH, Anchor.MiddleLeft);
        return;
    }
    // The clock to the boss: its time left over a bar running down, red in its last seconds
    var remaining = Math.Max(0, match.nightEnds - match.nightClock);
    var soon = remaining <= WARN_SECONDS;
    var share = Math.Saturate(remaining / Math.Max(1, match.nightEnds));
    var tint = soon ? Color(1.0, 0.3, 0.2, 0.7 + 0.3 * Math.Sin(look.time * 10)) : remaining <= RUSH_SECONDS ? EMBER : Color(0.75, 0.8, 0.95);
    WriteBold(ClockText(remaining), float2(right, box.y - 20 * u), 18 * u, tint, Anchor.MiddleRight);
    WriteBold("BOSS IN", float2(right - Draw.MeasureText(ClockText(remaining), 18 * u, Font.Bold).x - 10 * u, box.y - 19 * u), 11 * u,
              Color(tint.r, tint.g, tint.b, 0.85), Anchor.MiddleRight);
    Bar(float2(left, box.y + 4 * u), float2(272 * u, 7 * u), share, 0, Color(tint.r, tint.g, tint.b, 1), Color(0.25, 0.1, 0.06), 12, u);
    var opened = Math.Max(0, match.chestsPlaced - standing);
    Write($"Chests found {opened} of {match.chestsPlaced + match.chestsDue}   (left at dawn, they're lost)", float2(left, box.y + 24 * u), 11 * u, ASH, Anchor.MiddleLeft);
}

// The boss's coming, told WARN_SECONDS before: a bell, and a banner.
local singleton Warned
{
    int night;
}

[Stage(Layers.Hud, 1)]
view WarnBoss(Match match, Lobby lobby, mut Warned warned, mut Feed feed)
{
    if (!lobby.playing || match.phase != Phase.Fighting || match.reckoning || match.paused || warned.night == match.night) return;
    if (match.nightEnds - match.nightClock > WARN_SECONDS) return;
    warned.night = match.night;
    feed.banner = "THE BOSS IS COMING";
    feed.bannerLeft = 2.6;
    feed.bannerColor = Color(0.95, 0.3, 0.2);
    Audio.Play(bellClip, 0.9, 0.6);
}

local event(RunBegan began) WarnAgain(mut Warned warned)
{
    warned.night = 0;
}

local event(NightFell fell) ShowNightFell(mut Feed feed)
{
    feed.banner = fell.night == 1 ? "NIGHT 1" : $"NIGHT {fell.night}  -  {NightName(fell.night).ToUpper()}";
    feed.bannerLeft = 3;
    feed.bannerColor = Color(0.6, 1.0, 0.8);
}

local event(DawnBroke broke) ShowDawn(mut Feed feed)
{
    feed.banner = "DAWN";
    feed.bannerLeft = 3;
    feed.bannerColor = GOLD;
}

local event(Reckoning reckoning) HearReckoning(mut Ears ears)
{
    Audio.Play(bellClip, 1.0, 0.45);
    Audio.Play(fireBurst, 1.0, 0.5);
    Audio.Play(screams[ears.random.NextInt(screams.count)], 0.7, 0.36);
}

local event(DawnBroke broke) HearDawn()
{
    Audio.Play(roundEnd, 0.9);
}

local event(NightFell fell) HearNightFell(mut Ears ears)
{
    if (fell.night > 1) Audio.Play(screams[ears.random.NextInt(screams.count)], 0.45, 0.32);
}

// The wake-fire's ring: pale flames standing all round it (the nearest of them, a post every few metres), embers off
// them, and its line burning in the ground (look.tide's Earth, from Hazards.ring).
[Stage(Layers.Gather, 3)]
view RingFlames(Match match, mut Fx fx, Me me, Look look)
{
    if (!fx.made || match.ringReach <= 0 || match.phase != Phase.Fighting) return;
    var posts = 72;
    for (var k = 0; k < posts; k++)
    {
        var turn = k * Math.TAU / posts;
        var at = On(match.ringAt.x + Math.Sin(turn) * match.ringReach, match.ringAt.z + Math.Cos(turn) * match.ringReach);
        if (Math.Distance(at, me.eye) > 45) continue;
        var high = 1.6 + 0.7 * Math.Perlin(float2(look.time * 2.3 + k * 0.7, k));
        fx.streakSprites.Add(Sprite { at = at, to = at + float3(0, high, 0), size = 0.3, color = float4(0.45, 1.0, 0.75, 0.22) });
        if (fx.random.NextFloat() < me.dt * 4)
            Glow(fx, Mote { at = at + float3(fx.random.NextFloat(-0.3, 0.3), 0.2, fx.random.NextFloat(-0.3, 0.3)), velocity = float3(0, fx.random.NextFloat(1.2, 2.4), 0),
                            life = fx.random.NextFloat(0.4, 0.8), size = 0.22, grow = -0.25, color = float3(0.4, 1.0, 0.7), alpha = 1.4 });
    }
}

// Ringed in: a flash of the wake-fire rising all round.
local event(Reckoning reckoning) RingRises(mut Fx fx, Match match)
{
    if (!fx.made) return;
    for (var i = 0; i < 90; i++)
    {
        var turn = fx.random.NextFloat(Math.TAU);
        var at = On(match.ringAt.x + Math.Sin(turn) * match.ringReach, match.ringAt.z + Math.Cos(turn) * match.ringReach);
        Glow(fx, Mote { at = at + float3(0, 0.2, 0), velocity = float3(0, fx.random.NextFloat(3, 6), 0), life = fx.random.NextFloat(0.5, 1.0), size = 0.35, grow = -0.3,
                        color = float3(0.45, 1.0, 0.75), alpha = 2 });
    }
}
