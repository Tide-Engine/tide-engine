// The dead: they claw out of the ground, out of the graves or among the roots
// at the clearing's edge; then they hunt the nearest survivor on their feet,
// downhill on the way the field gives, straight at them when nothing's
// between. Close enough, they swing. Hit, they reel; kicked, they go over;
// killed, they're torn apart, gone at once, nothing left lying but the pieces
// (the owner, 2026-10-19: "when the zombies die i think they should just
// explode, them laying for a while makes it hard to know where I can walk or
// not"): only a Bloater lies a moment, swelling, and at dawn they burn and fall.

enum ZombieState { Rising, Hunting, Dying, Fallen }

enum Gait { Shamble, Run, Sprint }

// What kind of the dead: the ordinary walking dead; a Bloater (wider, slower, tougher, swollen with what's rotting in
// it): near a survivor it stops and swells, and killed it falls and swells, then bursts, hurting the dead and the
// living round it, how far it'll reach burning in the ground as it swells (the owner, 2026-10-19: "it shouldnt be
// instant, they should have some animation and the circle should show where it is about to explode"); a
// Spitter (thin, sallow, its throat glowing): it hangs back behind the rest and, with a clear line to a survivor, lobs
// bile that hurts and slows where it lands; a Warden (the town's watch, still in their mail): rounds, blasts and blows
// to its body do a quarter as much, so it's its bare head that's shot, or it's knocked down first (on its back its
// mail doesn't help), or burned; a Runner (lean, quicker than any): from a few metres off it crouches and leaps at
// whom it's after (a roll's guard turns it); a Brute (big as a door, slow, eight times as tough): no blow staggers it
// or throws it down, and its own throws a survivor back; a Howler (tall, thin): it hangs back and now and then stops
// and howls, and the dead round it are frenzied, quicker, so it's the one to shoot first (the owner, 2026-10-19: "we
// need more variety of enemies"). Each but the ordinary dead is drawn in its own strong colour (crowd.tide's
// KindMark).
enum ZombieKind { Walker, Bloater, Spitter, Warden, Runner, Brute, Howler }

const float BLOAT_NEAR = 2.4;      // How near a survivor sets a Bloater swelling
const float BLOAT_FUSE = 1.4;      // Seconds from that to its burst
const float BLOAT_DEAD_FUSE = 1.0; // Killed, seconds from its fall to its burst (if it wasn't nearer already)
const float BLOAT_REACH = 3.6;     // How far its burst reaches
const float BLOAT_HURT = 45;       // A survivor at its heart takes this (40% of it at the edge)
const float BLOAT_SIZE = 1.25;     // How much wider it is to hit and to bump into
const float BLOAT_HEALTH = 2.5;    // Its health against one of the ordinary dead's

const float SPIT_FAR = 20;         // How far a Spitter spits from...
const float SPIT_NEAR = 4;         // ...and how near it comes before it claws instead
const float SPIT_KEEP = 13;        // Within this, with a clear line, it stands its ground and spits
const float SPIT_WINDUP = 0.8;     // Seconds its throat swells before the bile comes
const float SPIT_EVERY = 3.2;      // Seconds between spits
const float SPIT_SPEED = 13;       // How fast its bile flies, across the ground
const float SPIT_GRAVITY = 12;
const float SPIT_LEAD = 0.5;       // How much of the way a survivor's going it aims ahead
const float SPIT_HURT = 18;        // Bile's harm at its heart (half at the edge)...
const float SPIT_REACH = 1.6;      // ...and how far it splashes
const float SLIME_SECONDS = 2;     // Slowed by it, so long
const float SPITTER_HEALTH = 1.2;

const float WARDEN_HEALTH = 2;
const float WARDEN_MAIL = 0.25;    // Of a blow to its body that gets through its mail
const float WARDEN_HIT = 1.5;      // Its claws, against the ordinary dead's

const float RUNNER_HEALTH = 0.6;
const float RUNNER_PACE = 1.15;    // Against a sprinter's
const float POUNCE_FAR = 5.5;      // How far off a Runner pounces from...
const float POUNCE_NEAR = 2.2;     // ...and how near (nearer, it claws)
const float POUNCE_CROUCH = 0.45;  // Seconds it crouches first
const float POUNCE_SECONDS = 0.35; // The leap...
const float POUNCE_SPEED = 13;     // ...this fast (4.5 m)
const float POUNCE_HIT = 0.8;      // Landing on a survivor, against a claw
const float POUNCE_EVERY = 3;      // Seconds between pounces

const float BRUTE_HEALTH = 8;
const float BRUTE_SIZE = 1.3;      // How much bigger it is all round, and its reach
const float BRUTE_PACE = 1.35;     // Against a shambler's
const float BRUTE_HIT = 2.5;       // Its blow, against a claw...
const float BRUTE_THROW = 9;       // ...throwing a survivor back so fast, metres a second
const float BRUTE_SHOVE = 0.25;    // Of a blow's push that moves it

const float HOWLER_HEALTH = 1.5;
const float HOWL_FAR = 22;         // How near whom it's after sets a Howler howling...
const float HOWL_KEEP = 11;        // ...within this it stands back (nearer than HOWL_CLOSE, it claws)
const float HOWL_CLOSE = 3;
const float HOWL_WINDUP = 1.1;     // Seconds its howl rises before the dead are frenzied
const float HOWL_EVERY = 7;        // Seconds between howls
const float HOWL_REACH = 10;       // How far round it the dead are frenzied...
const float HOWL_FRENZY = 5;       // ...so long

const int ZOMBIE_LOOKS = 6;
const float ZOMBIE_RADIUS = 0.34;
const float RISE_SECONDS = 1.8;
const float DEATH_SECONDS = 4.5;
const float KNOCK_SECONDS = 0.83;  // Going over backwards (the knockback clip)
const float GETUP_SECONDS = 1.53;  // Getting up again
const float ATTACK_SECONDS = 1.1;
const float ATTACK_LANDS = 0.5;
const float ATTACK_REACH = 1.35;
const float ZOMBIE_HIT = 30;

component Zombie
{
    [Position] float3 at;
    [Rotation] float yaw;
    float health;
    ZombieState state;
    float timer;                // Seconds into its state
    Gait gait;
    float pace = 1;             // Its own quickness
    float speed;                // Metres a second now
    int look;                   // Which of the bodies it has
    float stride;               // Metres walked: the walk's clock
    float swing;                // Seconds into an attack, 0 when none
    bool struck;                // This attack's blow has landed
    float flinch;               // Seconds left reeling from a hit
    float burn;                 // Seconds left burning
    float bleed;                // Seconds left bleeding
    float chill;                // Seconds left slowed by frost
    float frozen;               // Seconds left frozen solid
    float stun;                 // Seconds left dazed
    float3 headAt;              // Where its head, chest and hips are this tick (Muster), from its state
    float3 chestAt;
    float3 hipsAt;
    int phase;                  // Its own offset in its idle, and a little of its looks
    int slot = -1;              // Where it is in the Herd this tick
    float downFor;              // Knocked down: how long it lies before getting up
    float3 shove;               // Knocked back, metres a second
    int killer = -1;            // The seat that killed it
    bool head;                  // Killed by a blow to the head
    int fall;                   // Which way it falls
    int burner = -1;            // Who set it alight
    int bleeder = -1;           // Who opened the wound
    bool climbing;              // In a pile against a cliff, or clawing its way up one this tick
    float lift;                 // How high it is off the ground: up a pile
    ZombieKind kind;
    bool torn;                  // Killed: torn apart, gone the next tick (a Bloater once it's burst)
    float fuse;                 // A Bloater: seconds since it began to swell (0, not yet)
    bool popped;                // ...and it has burst
    float frenzy;               // Seconds left frenzied by a Stalker's shriek: faster
    float spit;                 // A Spitter, a Runner, a Howler: seconds till it can spit, pounce or howl again...
    float windup;               // ...seconds into its throat's swelling, its crouch, its howl (0, none)...
    bool sight;                 // ...and (a Spitter) whether it has a clear line to whom it's after (looked for a few times a second)
    float leap;                 // A Runner: seconds into its leap (0, none)
    local float flash;          // The flash of a fresh blow
    local float voice = 1;      // Seconds till it groans
}

// Every one of the dead the match can strike, this tick, in a grid of 2 m cells: blows, kicks, missiles, bursts and
// the dead's own crowding look in the cells near them, not through the whole horde. Made again each tick after the dead
// move (Muster), so what's struck is where it stood when the tick began.
const float HERD_CELL = 2;
const int HERD_W = 78;                  // From NAV_X0, NAV_Z0: 156 m each way

singleton Herd
{
    List<Body> bodies;          // By slot
    List<float3> feet;          // By slot: where it stands, or (lying) far below, for the dead's own crowding
    List<float> lifts;          // By slot: how high it is off the ground, up a pile
    List<int> next;             // By slot: the next in its cell, or -1
    List<int> first;            // By cell: the first slot in it, or -1
    List<Spots> bosses;         // The bosses' hit spots, by Body.boss (kept apart: thousands of the dead don't carry them)
}

int HerdCell(float3 at)
{
    var cx = Math.Clamp(int(Math.Floor((at.x - NAV_X0) / HERD_CELL)), 0, HERD_W - 1);
    var cz = Math.Clamp(int(Math.Floor((at.z - NAV_Z0) / HERD_CELL)), 0, HERD_W - 1);
    return cz * HERD_W + cx;
}

// The dead whose feet are within `reach` of a place (a little more: whole cells), nearest cells first.
List<Body> Near(Herd herd, float3 at, float reach)
{
    mut List<Body> found = [];
    if (herd.first.count == 0) return found;
    var cx = int(Math.Floor((at.x - NAV_X0) / HERD_CELL));
    var cz = int(Math.Floor((at.z - NAV_Z0) / HERD_CELL));
    var cells = int(Math.Ceil(reach / HERD_CELL));
    for (var z = Math.Max(0, cz - cells); z <= Math.Min(HERD_W - 1, cz + cells); z++)
    {
        for (var x = Math.Max(0, cx - cells); x <= Math.Min(HERD_W - 1, cx + cells); x++)
        {
            mut var slot = herd.first[z * HERD_W + x];
            while (slot >= 0)
            {
                var body = herd.bodies[slot];
                if (Math.Length((body.at - at).xz) <= reach + 0.5) found.Add(body);
                slot = herd.next[slot];
            }
        }
    }
    return found;
}

[Stage(Tick.Zombies, 1)]
system HerdClear(mut Herd herd)
{
    herd.bodies.Clear();
    herd.feet.Clear();
    herd.lifts.Clear();
    herd.next.Clear();
    herd.bosses.Clear();
    if (herd.first.count != HERD_W * HERD_W) herd.first.Resize(HERD_W * HERD_W);
    for (var c = 0; c < HERD_W * HERD_W; c++) herd.first[c] = -1;
}

// Each tick, where each of the dead's head, chest and hips are (from its state: hunched on its feet, flat on its back,
// half out of the ground), and its place in the herd.
[Stage(Tick.Zombies, 2)]
system Muster(mut Zombie zombie, mut Herd herd)
{
    var turn = quaternion.AxisAngle(float3(0, 1, 0), zombie.yaw);
    var lying = LyingOf(zombie);
    var risen = zombie.state == ZombieState.Rising ? Math.SmoothStep(0, 1, zombie.timer / RISE_SECONDS) : 1.0;
    var low = (1 - risen) * 1.9;
    var big = (zombie.look == 3 ? 1.06 : 1.0) * KindScale(zombie.kind);
    zombie.headAt = zombie.at + Math.Rotate(turn, Math.Lerp(float3(0, 1.5, 0.2) + KindHead(zombie.kind), float3(0, 0.25, -1.35), lying) * big) - float3(0, low, 0);
    zombie.chestAt = zombie.at + Math.Rotate(turn, Math.Lerp(float3(0, 1.15, 0.12) + KindChest(zombie.kind), float3(0, 0.25, -0.85), lying) * big) - float3(0, low, 0);
    zombie.hipsAt = zombie.at + Math.Rotate(turn, Math.Lerp(float3(0, 0.92, 0) + KindHips(zombie.kind), float3(0, 0.2, -0.3), lying) * big) - float3(0, low, 0);
    if (zombie.state == ZombieState.Dying)
    {
        zombie.slot = -1;
        return;
    }
    zombie.slot = herd.bodies.count;
    var cell = HerdCell(zombie.at);
    var body = BodyOf(this, zombie);
    herd.bodies.Add(body);
    herd.feet.Add(body.down || body.risen < 1 ? float3(0, -1000, 0) : zombie.at);
    herd.lifts.Add(zombie.lift);
    herd.next.Add(herd.first[cell]);
    herd.first[cell] = zombie.slot;
}

// One of the dead as a blow or a missile sees them: where, how far out of the ground, and whether they can be hit.
struct Body
{
    Entity entity;
    float3 at;
    float yaw;
    float risen = 1;
    bool hittable;
    float3 head;                // Where its head is, its chest and its hips: low when it's down
    float3 chest;
    float3 hips;
    bool down;                  // On its back
    float size = 1;             // How much bigger than one of the dead (a boss's)
    int boss = -1;              // A boss's place in Herd.bosses
}

// How wide a body's head and chest are to a round, and its weak spot: where, how wide (0, none) and how many times a
// round there does; and a boss's bulk, an upright column from its feet to the top of its head that any round into it
// strikes (the owner, 2026-10-18: "they are so big yet shooting at their feet felt like was always a miss"). A boss's
// are its mesh's (boss.tide's MutantOf); one of the dead's are a man's at its size, and no column.
struct Spots
{
    float headRadius;
    float chestRadius;
    float3 weak;
    float weakRadius;
    float weakTimes;
    float3 weakFace;            // ...the way it faces (a round from behind it doesn't reach it), none for any
    float3 base;
    float columnRadius;
    float columnHigh;
}

Spots SpotsOf(Body z, Herd herd)
{
    if (z.boss >= 0 && z.boss < herd.bosses.count) return herd.bosses[z.boss];
    return Spots { headRadius = HEAD_RADIUS * z.size, chestRadius = 0.36 * z.size, weakTimes = 1 };
}

Body BodyOf(Entity entity, Zombie zombie)
{
    var risen = zombie.state == ZombieState.Rising ? Math.SmoothStep(0, 1, zombie.timer / RISE_SECONDS) : 1.0;
    var placed = Math.Length(zombie.headAt) > 0;
    var up = float3(0, 1, 0);
    return Body { entity = entity, at = zombie.at, yaw = zombie.yaw, risen = risen,
                  hittable = zombie.state != ZombieState.Dying,
                  head = placed ? zombie.headAt : zombie.at + up * 1.62,
                  chest = placed ? zombie.chestAt : zombie.at + up * 1.15,
                  hips = placed ? zombie.hipsAt : zombie.at + up * 0.6,
                  down = LyingOf(zombie) > 0.5, size = zombie.kind == ZombieKind.Bloater ? BLOAT_SIZE : KindScale(zombie.kind) };
}

// How tough each kind is, against the ordinary dead at the same danger.
float KindHealth(ZombieKind kind)
{
    switch (kind)
    {
        case ZombieKind.Bloater: return BLOAT_HEALTH;
        case ZombieKind.Spitter: return SPITTER_HEALTH;
        case ZombieKind.Warden: return WARDEN_HEALTH;
        case ZombieKind.Runner: return RUNNER_HEALTH;
        case ZombieKind.Brute: return BRUTE_HEALTH;
        case ZombieKind.Howler: return HOWLER_HEALTH;
    }
    return 1;
}

// How each kind goes: a Bloater, a Warden and a Brute always shamble; a Spitter and a Howler run at most; a Runner
// always sprints.
Gait KindGait(ZombieKind kind, Gait gait)
{
    if (kind == ZombieKind.Bloater || kind == ZombieKind.Warden || kind == ZombieKind.Brute) return Gait.Shamble;
    if (kind == ZombieKind.Runner) return Gait.Sprint;
    if ((kind == ZombieKind.Spitter || kind == ZombieKind.Howler) && gait == Gait.Sprint) return Gait.Run;
    return gait;
}

// Where each kind's own body (art/kinds) has its head, chest and hips standing, against one of the ordinary dead's:
// its marks in kinds.json less those of a body make_kinds.py left as it was (the Howler's head up its long neck, the
// Brute's sunk between its shoulders, a Runner's and a Spitter's thrust out).
float3 KindHead(ZombieKind kind)
{
    switch (kind)
    {
        case ZombieKind.Bloater: return float3(0, -0.13, 0.03);
        case ZombieKind.Brute: return float3(0, -0.2, 0.09);
        case ZombieKind.Howler: return float3(0, 0.46, -0.13);
        case ZombieKind.Runner: return float3(0, -0.17, 0.19);
        case ZombieKind.Spitter: return float3(0, -0.19, 0.15);
    }
    return float3(0);
}

float3 KindChest(ZombieKind kind)
{
    switch (kind)
    {
        case ZombieKind.Bloater: return float3(0, -0.07, 0.03);
        case ZombieKind.Brute: return float3(0, -0.09, 0.08);
        case ZombieKind.Howler: return float3(0, 0.27, -0.03);
        case ZombieKind.Runner: return float3(0, -0.03, 0.12);
        case ZombieKind.Spitter: return float3(0, -0.05, 0.05);
    }
    return float3(0);
}

float3 KindHips(ZombieKind kind)
{
    switch (kind)
    {
        case ZombieKind.Bloater: return float3(0, -0.1, 0);
        case ZombieKind.Brute: return float3(0, -0.03, 0);
        case ZombieKind.Howler: return float3(0, 0.2, 0);
        case ZombieKind.Runner: return float3(0, 0.1, 0);
    }
    return float3(0);
}

// How much bigger each kind is all round than the ordinary dead (its spots to hit, and its reach).
float KindScale(ZombieKind kind)
{
    return kind == ZombieKind.Brute ? BRUTE_SIZE : 1.0;
}

// How hard each kind's claws are, against the ordinary dead's.
float KindHit(ZombieKind kind)
{
    return kind == ZombieKind.Warden ? WARDEN_HIT : kind == ZombieKind.Brute ? BRUTE_HIT : 1.0;
}

// How long each kind's windup is: a Spitter's throat, a Runner's crouch, a Howler's howl.
float WindupSeconds(ZombieKind kind)
{
    return kind == ZombieKind.Runner ? POUNCE_CROUCH : kind == ZombieKind.Howler ? HOWL_WINDUP : SPIT_WINDUP;
}

// How much more each kind's orb is worth than the ordinary dead's.
float KindWorth(ZombieKind kind)
{
    switch (kind)
    {
        case ZombieKind.Bloater: return 3;
        case ZombieKind.Spitter: return 2;
        case ZombieKind.Warden: return 3;
        case ZombieKind.Runner: return 1.5;
        case ZombieKind.Brute: return 6;
        case ZombieKind.Howler: return 3;
    }
    return 1;
}

// How far over one of the dead is: 0 on its feet, 1 flat on its back (it falls away from the blow).
float LyingOf(Zombie zombie)
{
    if (zombie.state == ZombieState.Dying) return zombie.fall >= 2 ? 1.0 : 0.0;
    if (zombie.state != ZombieState.Fallen) return 0;
    var t = zombie.timer;
    if (t < KNOCK_SECONDS) return Math.SmoothStep(0.1, 0.6, t);
    var up = t - KNOCK_SECONDS - zombie.downFor;
    if (up <= 0) return 1;
    return 1 - Math.SmoothStep(0.3, 1.2, up);
}

// A blow to one of the dead.
event Wound
{
    float damage;
    int seat;                   // Whose: -1 for nobody's
    bool head;
    Element element;
    float3 from;                // Where the blow came from
    float knock;                // How hard it pushes, metres a second
    Blow blow;                  // What dealt it, for what's heard and seen
    bool down;                  // Knocks it off its feet
    float freeze;               // Freezes it solid, so many seconds
    bool crit;                  // Lucky Shot's double
    bool echo;                  // Set off by an item: a kill sets off nothing more
    bool weak;                  // To a boss's weak spot (the damage already the more for it)
}

// What dealt a blow.
enum Blow { Blade, Blunt, Missile, Burst, Burning, Bleeding, Shove }

// A kill, to the survivor who made it (or a blow that wasn't one, for nothing).
event Earned
{
    bool kill;
    bool head;
    float3 at;                  // Where it died
    bool echo;                  // Killed by what an item set off
}

// A blow to a survivor.
event Hurt
{
    float damage;
    float3 from;
}

// What everyone sees and hears of a blow: blood, a spark, a groan.
event Struck
{
    float3 at;
    float3 from;                // Where the blow came from
    bool head;
    bool killed;
    Element element;
    int seat;
    Blow blow;
    bool crit;
    bool mail;                  // Turned by a Warden's mail
    bool weak;                  // On a boss's weak spot
}

// A Stalker's shriek or a Howler's howl, to each of the dead near it.
event Frenzied
{
    float seconds;
}

event(Frenzied frenzied) TakeFrenzied(mut Zombie zombie)
{
    if (zombie.state != ZombieState.Dying) zombie.frenzy = Math.Max(zombie.frenzy, frenzied.seconds);
}

const float FRENZY_PACE = 1.6;     // How much faster the frenzied go

// A Spitter's bile on a survivor: slowed a while.
event Slimed
{
    float seconds;
}

event(Slimed slimed) TakeSlimed(mut Survivor survivor)
{
    if (survivor.life == Life.Standing) survivor.slimed = Math.Max(survivor.slimed, slimed.seconds);
}

// How much quicker the dead are as the danger climbs: none to danger 4, then up to HASTE_MOST more by danger 16 (a
// sprinter then outpaces a survivor walking as they fire, though not one running).
float Haste(float danger)
{
    return 1 + HASTE_MOST * Math.Saturate((danger - 4) / 12);
}

const float HASTE_MOST = 0.4;

float GaitSpeed(Gait gait)
{
    if (gait == Gait.Sprint) return 4.8;
    if (gait == Gait.Run) return 3.3;
    return 1.15;
}

[Stage(Tick.Zombies)]
system Hunt(mut Zombie zombie, Match match, Ashwick ashwick, Herd herd, Time time, query (Survivor survivor) survivors)
{
    if (match.paused) return;
    var dt = time.dt;
    if (match.culling)
    {
        this.Destroy();
        return;
    }
    // Dawn: each of the dead catches fire and falls, a little apart (by where it stands), with no orb, no burst
    if (match.phase == Phase.Dawn && zombie.state != ZombieState.Dying)
    {
        var h = Math.Hash(int2(int(zombie.at.x * 37), int(zombie.at.z * 41)));
        if (match.timer >= (h & 255) / 255.0 * 2.0)
        {
            zombie.state = ZombieState.Dying;
            zombie.timer = 0;
            zombie.fall = (h >> 8) & 1;
            zombie.popped = true;
            zombie.killer = -1;
            zombie.burn = 3;
            zombie.swing = 0;
            zombie.windup = 0;
            return;
        }
    }
    zombie.timer += dt;
    zombie.flinch = Math.Max(0, zombie.flinch - dt);
    zombie.chill = Math.Max(0, zombie.chill - dt);
    zombie.frozen = Math.Max(0, zombie.frozen - dt);
    zombie.stun = Math.Max(0, zombie.stun - dt);
    zombie.frenzy = Math.Max(0, zombie.frenzy - dt);
    // A Bloater swelling bursts when its time's up; killed, it swells as it falls, sooner
    if (zombie.kind == ZombieKind.Bloater && !zombie.popped)
    {
        if (zombie.state == ZombieState.Dying && zombie.fuse < BLOAT_FUSE - BLOAT_DEAD_FUSE)
        {
            zombie.fuse = BLOAT_FUSE - BLOAT_DEAD_FUSE;
            Send(Cue { sound = Sfx.Swell, at = zombie.chestAt });
        }
        if (zombie.fuse > 0) zombie.fuse += dt;
        if (zombie.fuse >= BLOAT_FUSE)
        {
            // The living round it hurt and thrown back, the nearer the more, every one of them (a Gas Mask kept it off its
            // wearer till the owner, 2026-10-20: "that shouldnt be a thing, it removes way too much danger"); one killed by
            // a survivor with Bile Bombs bursts wider and harder on the dead
            mut var bombs = 0;
            foreach (var row in survivors)
                if (row.survivor.seat == zombie.killer) bombs = Has(row.survivor, Item.BileBomb);
            foreach (var row in survivors)
            {
                var s = row.survivor;
                if (!s.ready || s.life != Life.Standing) continue;
                var far = Math.Length((s.feet - zombie.chestAt).xz);
                if (far > BLOAT_REACH) continue;
                var share = Math.Sqrt(1 - far / BLOAT_REACH);
                row.entity.Send(Hurt { damage = BLOAT_HURT * Harm(match.danger) * (0.4 + 0.6 * share), from = zombie.chestAt });
                row.entity.Send(Shoved { velocity = Flatten(s.feet - zombie.chestAt) * 9 * share + float3(0, 4 * share, 0) });
            }
            Rupture(this, zombie, match, herd, BLOAT_REACH * (1 + 0.3 * bombs), 1 + 0.5 * bombs);
            return;
        }
    }
    if (zombie.state == ZombieState.Dying)
    {
        // Torn apart: gone (its pieces are gore.tide's)
        if (zombie.torn && zombie.kind != ZombieKind.Bloater)
        {
            this.Destroy();
            return;
        }
        // Burning at dawn: off a pile, it drops (and what it held up comes down after it)
        zombie.at.y = Math.Max(Ground(zombie.at.x, zombie.at.z), zombie.at.y - FALL_SPEED * dt);
        if (zombie.timer > DEATH_SECONDS) this.Destroy();
        return;
    }
    // Burning: the fire's own damage, a little at a time
    if (zombie.burn > 0)
    {
        zombie.burn -= dt;
        if (Math.Floor((zombie.burn + dt) * 4) != Math.Floor(zombie.burn * 4))
            this.Send(Wound { damage = 40 + ZombieHealth(match.danger) * 0.06, seat = zombie.burner, element = Element.None, from = zombie.at, blow = Blow.Burning, knock = -1 });
    }
    // Bleeding: the same
    if (zombie.bleed > 0)
    {
        zombie.bleed -= dt;
        if (Math.Floor((zombie.bleed + dt) * 2) != Math.Floor(zombie.bleed * 2))
            this.Send(Wound { damage = 30 + ZombieHealth(match.danger) * 0.05, seat = zombie.bleeder, element = Element.None, from = zombie.at, blow = Blow.Bleeding, knock = -1 });
    }
    switch (zombie.state)
    {
        case ZombieState.Rising:
            if (zombie.timer >= RISE_SECONDS) Become(zombie, ZombieState.Hunting);
            return;
        case ZombieState.Fallen:
        {
            // Thrown back as it goes over, then still a while, then up again
            zombie.speed = 0;
            zombie.swing = 0;
            var before = zombie.at;
            mut var at = zombie.at + zombie.shove * dt;
            zombie.shove *= Math.Max(0, 1 - dt * 5);
            at = PushOut(ashwick, at, ZOMBIE_RADIUS, 1.7);
            if ((!Walkable(ashwick, CellOf(at)) && Walkable(ashwick, CellOf(before))) || !Reaches(ashwick, before, at, before.y)) at = before;
            at.y = Math.Max(Ground(at.x, at.z), before.y - FALL_SPEED * dt);
            zombie.at = at;
            // What it's thrown into goes over too
            var flung = Math.Length(zombie.shove);
            if (zombie.timer < 0.45 && flung > 2.5)
            {
                foreach (var o in Near(herd, zombie.at, 0.65))
                {
                    if (o.entity == this || o.down || o.risen < 1) continue;
                    if (Math.Length((o.at - zombie.at).xz) < 0.65)
                        o.entity.Send(Wound { seat = -1, from = zombie.at, knock = flung * 0.6, down = true, blow = Blow.Shove });
                }
            }
            if (zombie.timer >= KNOCK_SECONDS + zombie.downFor + GETUP_SECONDS) Become(zombie, ZombieState.Hunting);
            return;
        }
    }

    // Hunting: whom, and which way
    mut Entity target = default;
    mut var targetAt = float3(0);
    mut var targetGoes = float3(0);
    mut var nearest = 1000.0;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready || s.life == Life.Gone) continue;
        var far = Math.Distance(s.feet, zombie.at) + (s.life == Life.Downed ? 40 : 0);
        if (far >= nearest) continue;
        nearest = far;
        target = row.entity;
        targetAt = s.feet;
        targetGoes = s.velocity;
    }
    mut var wish = float3(0);
    if (target != default)
    {
        var to = targetAt - zombie.at;
        var straight = Math.Length(to.xz);
        if (straight < 14 && ClearPath(ashwick, zombie.at, targetAt)) wish = Math.Normalize(float3(to.x, 0, to.z));
        else wish = Downhill(ashwick, zombie.at);
    }
    // Room among the others
    // (straight from the herd's cells, a dozen at most, of two dozen looked at: in a crowd of thousands, more change
    // nothing but the cost). And the pile: what's under it holds it up (`under`); one ahead of it no higher than a body
    // it can climb onto (`onto`), if it's pressed against a cliff or behind others already up off the ground.
    // (the ground is asked for once a tick, at the step's end: it's the costliest thing here; under it now is where it
    // stood less how high it was)
    var ground = zombie.at.y - zombie.lift;
    var way = Math.Length(wish) > 0.001 ? Math.Normalize(wish) : float3(0);
    var aheadAt = zombie.at + way * 0.7;
    var aheadCell = CellOf(aheadAt);
    var pressing = Cliff(ashwick, aheadCell) && zombie.at.y < ashwick.ledges[aheadCell] - STEP_UP - SCRAMBLE;
    mut var under = ground;
    mut var props = 0;                // How many hold it up
    mut var onto = -1000.0;
    mut var liftedAhead = false;
    if (herd.first.count > 0)
    {
        var cx = Math.Clamp(int(Math.Floor((zombie.at.x - NAV_X0) / HERD_CELL)), 1, HERD_W - 2);
        var cz = Math.Clamp(int(Math.Floor((zombie.at.z - NAV_Z0) / HERD_CELL)), 1, HERD_W - 2);
        mut var seen = 0;
        mut var looked = 0;
        for (var z = cz - 1; z <= cz + 1; z++)
        {
            for (var x = cx - 1; x <= cx + 1; x++)
            {
                mut var slot = herd.first[z * HERD_W + x];
                while (slot >= 0 && seen < 12 && looked < 24)
                {
                    looked += 1;
                    var other = herd.feet[slot];
                    if (slot != zombie.slot)
                    {
                        var off = zombie.at.xz - other.xz;
                        var far = Math.Length(off);
                        var rise = other.y - zombie.at.y;
                        if (far < 0.75 && far > 0.0001 && Math.Abs(rise) < 0.4)
                        {
                            wish += float3(off.x, 0, off.y) / far * (0.75 - far) * 2.2;
                            seen += 1;
                        }
                        if (far < 0.6 && rise < -0.25 && rise > -LAYER * 1.6)
                        {
                            under = Math.Max(under, other.y + LAYER);
                            props += 1;
                        }
                        // Onto one lower than itself; of two about as high, only one climbs the other, the one later in the herd
                        // (two climbing each other at once had leapfrogged up a wall into the air with nothing under either)
                        var lower = rise < -0.12 || (rise < 0.12 && slot < zombie.slot);
                        if (far < 0.6 && rise > -0.35 && lower && (pressing || Math.Dot(-off, way.xz) > 0)) onto = Math.Max(onto, other.y + LAYER);
                        if (far < 1.3 && herd.lifts[slot] > 0.3 && Math.Dot(-off, way.xz) > 0) liftedAhead = true;
                    }
                    slot = herd.next[slot];
                }
            }
        }
    }
    // A Spitter: a few times a second it looks for a clear line to whom it's after; with one, from far enough off, its
    // throat swells and it spits
    var spitter = zombie.kind == ZombieKind.Spitter;
    if (spitter)
    {
        zombie.spit = Math.Max(0, zombie.spit - dt);
        if (Math.Floor(zombie.timer * 3) != Math.Floor((zombie.timer - dt) * 3))
            zombie.sight = target != default && nearest < SPIT_FAR && nearest > SPIT_NEAR && LongRay(ashwick, zombie.headAt, targetAt + float3(0, 1.2, 0), out _) > 1;
        if (zombie.windup > 0)
        {
            zombie.windup += dt;
            if (zombie.windup >= SPIT_WINDUP)
            {
                zombie.windup = 0;
                zombie.spit = SPIT_EVERY;
                if (target != default) Spit(zombie, targetAt, targetGoes, match.danger);
            }
        }
        else if (zombie.sight && zombie.spit <= 0 && zombie.frozen <= 0 && zombie.stun <= 0 && zombie.flinch <= 0 && nearest > SPIT_NEAR)
        {
            zombie.windup = 0.0001;
            Send(Cue { sound = Sfx.Retch, at = zombie.headAt });
        }
    }
    // A Runner: from a few metres off, with nothing between, it crouches facing whom it's after, then leaps the way it
    // faces; landing by them, it strikes (a roll's guard turns it: hands.tide's TakeHurt)
    var runner = zombie.kind == ZombieKind.Runner;
    if (runner)
    {
        zombie.spit = Math.Max(0, zombie.spit - dt);
        if (zombie.leap > 0)
        {
            zombie.leap += dt;
            if (!zombie.struck && target != default && nearest < ATTACK_REACH + 0.3)
            {
                zombie.struck = true;
                target.Send(Hurt { damage = ZOMBIE_HIT * POUNCE_HIT * Harm(match.danger), from = zombie.at });
            }
            if (zombie.leap >= POUNCE_SECONDS)
            {
                zombie.leap = 0;
                zombie.spit = POUNCE_EVERY;
            }
        }
        else if (zombie.windup > 0)
        {
            zombie.windup += dt;
            if (zombie.windup >= POUNCE_CROUCH)
            {
                zombie.windup = 0;
                zombie.leap = 0.0001;
                zombie.struck = false;
                if (target != default) zombie.yaw = YawTo(zombie.at, targetAt + targetGoes * 0.15);
                Send(Cue { sound = Sfx.Pounce, at = zombie.headAt });
            }
        }
        else if (target != default && zombie.spit <= 0 && nearest < POUNCE_FAR && nearest > POUNCE_NEAR && zombie.frozen <= 0 && zombie.stun <= 0 && zombie.flinch <= 0
                 && zombie.swing <= 0 && ClearPath(ashwick, zombie.at, targetAt))
            zombie.windup = 0.0001;
    }
    // A Howler: whom it's after near enough, now and then it stands and howls; at the howl's end the dead round it are
    // frenzied
    var howler = zombie.kind == ZombieKind.Howler;
    if (howler)
    {
        zombie.spit = Math.Max(0, zombie.spit - dt);
        if (zombie.windup > 0)
        {
            zombie.windup += dt;
            if (zombie.windup >= HOWL_WINDUP)
            {
                zombie.windup = 0;
                zombie.spit = HOWL_EVERY;
                foreach (var z in Near(herd, zombie.at, HOWL_REACH))
                {
                    if (!z.hittable || z.entity == this || Math.Length((z.at - zombie.at).xz) > HOWL_REACH) continue;
                    z.entity.Send(Frenzied { seconds = HOWL_FRENZY });
                }
                Send(Howled { at = zombie.at, reach = HOWL_REACH });
            }
        }
        else if (target != default && zombie.spit <= 0 && nearest < HOWL_FAR && zombie.frozen <= 0 && zombie.stun <= 0 && zombie.flinch <= 0 && zombie.swing <= 0)
        {
            zombie.windup = 0.0001;
            Send(Cue { sound = Sfx.Howl, at = zombie.headAt });
        }
    }
    // A Bloater doesn't swing: near enough a survivor, it stops and swells
    if (zombie.kind == ZombieKind.Bloater)
    {
        if (zombie.fuse == 0 && target != default && nearest < BLOAT_NEAR && zombie.frozen <= 0)
        {
            zombie.fuse = 0.0001;
            Send(Cue { sound = Sfx.Swell, at = zombie.at + float3(0, 1.2, 0) });
        }
    }
    // The blow
    else if (zombie.swing > 0)
    {
        zombie.swing += dt;
        if (!zombie.struck && zombie.swing >= ATTACK_LANDS)
        {
            zombie.struck = true;
            foreach (var row in survivors)
            {
                if (row.entity != target || row.survivor.life != Life.Standing) continue;
                var to = row.survivor.feet - zombie.at;
                if (Math.Length(to.xz) >= ATTACK_REACH * KindScale(zombie.kind) + 0.45 || Math.Dot(Math.Normalize(to.xz), Flat(zombie.yaw).xz) <= 0.2) continue;
                target.Send(Hurt { damage = ZOMBIE_HIT * Harm(match.danger) * KindHit(zombie.kind), from = zombie.at });
                // A Brute's throws them back
                if (zombie.kind == ZombieKind.Brute && !Guarded(row.survivor))
                {
                    target.Send(Shoved { velocity = Flatten(to) * BRUTE_THROW + float3(0, 3, 0) });
                    Send(Cue { sound = Sfx.Pound, at = row.survivor.feet + float3(0, 1, 0) });
                }
            }
        }
        if (zombie.swing >= ATTACK_SECONDS) zombie.swing = 0;
    }
    else if (target != default && nearest < ATTACK_REACH * KindScale(zombie.kind) && zombie.flinch <= 0 && zombie.stun <= 0 && zombie.frozen <= 0 && zombie.windup <= 0
             && zombie.leap <= 0)
    {
        zombie.swing = 0.0001;
        zombie.struck = false;
        Send(Cue { sound = zombie.kind == ZombieKind.Brute ? Sfx.Bellow : Sfx.Snarl, at = zombie.headAt });
    }

    // The step
    mut var speed = GaitSpeed(zombie.gait) * zombie.pace * Haste(match.danger);
    if (zombie.chill > 0) speed *= 0.45;
    if (zombie.flinch > 0) speed *= 0.3;
    if (zombie.swing > 0) speed *= zombie.gait == Gait.Shamble ? 0.2 : 0.45;
    if (zombie.frozen > 0 || zombie.stun > 0 || zombie.fuse > 0) speed = 0;
    if (zombie.kind == ZombieKind.Bloater) speed *= BLOAT_PACE;
    if (runner) speed *= RUNNER_PACE;
    if (zombie.kind == ZombieKind.Brute) speed *= BRUTE_PACE;
    if (zombie.frenzy > 0) speed *= FRENZY_PACE;
    // A Spitter with a clear line stands its ground and spits; a Howler stands back, and still as it howls; a Runner
    // crouched is still
    if (spitter && (zombie.windup > 0 || (zombie.sight && nearest < SPIT_KEEP))) speed = 0;
    if (howler && (zombie.windup > 0 || (nearest < HOWL_KEEP && nearest > HOWL_CLOSE))) speed = 0;
    if (runner && zombie.windup > 0) speed = 0;
    if (target != default && nearest < ATTACK_REACH * KindScale(zombie.kind) * 0.8) speed *= 0.1;
    var wanted = Math.Length(wish) > 0.001 ? Math.Normalize(wish) : float3(0);
    if (Math.Length(wanted) > 0.5 && zombie.leap <= 0)
    {
        var turn = TurnBetween(zombie.yaw, Math.Atan2(wanted.x, wanted.z));
        var rate = zombie.gait == Gait.Shamble ? 3.0 : 7.0;
        zombie.yaw += Math.Clamp(turn, -rate * dt, rate * dt);
    }
    // Close, or winding up, it turns to face them
    if (target != default && (nearest < 2.2 || zombie.windup > 0) && zombie.leap <= 0)
    {
        var face = TurnBetween(zombie.yaw, YawTo(zombie.at, targetAt));
        zombie.yaw += Math.Clamp(face, -8 * dt, 8 * dt);
    }
    zombie.speed += (speed - zombie.speed) * Math.Min(1, dt * 6);
    // A Runner leaping goes straight the way it faces, at the leap's speed
    if (zombie.leap > 0) zombie.speed = POUNCE_SPEED;
    var forward = zombie.leap > 0 ? Flat(zombie.yaw) : Flat(zombie.yaw) * Math.Max(0, Math.Dot(Flat(zombie.yaw), wanted)) + wanted * 0.25;
    var before = zombie.at;
    mut var at = zombie.at + forward * zombie.speed * dt + zombie.shove * dt;
    zombie.shove *= Math.Max(0, 1 - dt * 7);
    at = PushOut(ashwick, at, ZOMBIE_RADIUS, 1.7);
    // Keep to cells the dead can walk, and off a cliff's face till a pile has them up to its ledge; a step into either
    // slides along it (one already in a wall's cell, risen or thrown there, walks out)
    var up = before.y;
    if ((!Walkable(ashwick, CellOf(at)) && Walkable(ashwick, CellOf(before))) || !Reaches(ashwick, before, at, up))
    {
        var alongX = float3(at.x, at.y, before.z);
        var alongZ = float3(before.x, at.y, at.z);
        if (Walkable(ashwick, CellOf(alongX)) && Reaches(ashwick, before, alongX, up)) at = alongX;
        else if (Walkable(ashwick, CellOf(alongZ)) && Reaches(ashwick, before, alongZ, up)) at = alongZ;
        else at = before;
    }
    // Its height: on the ground; held up by what's under it; climbing onto the one ahead when it's pressed against a
    // cliff or behind others already up; coming down when nothing holds it
    // (what's under it only stops it falling, never lifts it: on a slope the one below isn't under it)
    // Held up only by what's under it: one nearly straight beneath, and two once it's more than a body up, so a pile
    // spreads at its foot as a heap does (a lean of one on one, each a little off the last, had stood out over a slope
    // with nothing under it)
    var floor = Ground(at.x, at.z);
    var held = props >= (before.y - floor > LAYER * 1.5 ? 2 : 1) ? Math.Min(under, before.y) : floor;
    var climb = zombie.frozen <= 0 && zombie.stun <= 0 && (pressing || liftedAhead) && onto > before.y + 0.05;
    var rate = CLIMB_RATE * (zombie.gait == Gait.Sprint ? 1.5 : 1.0);
    if (climb) at.y = Math.Min(before.y + rate * dt, onto);
    else at.y = Math.Max(held, before.y - FALL_SPEED * dt);
    at.y = Math.Max(at.y, floor);
    zombie.lift = at.y - floor;
    zombie.climbing = climb || pressing || zombie.lift > 0.25;
    zombie.stride += Math.Length((at - before).xz);
    zombie.at = at;
}

const float BLOAT_PACE = 0.8;      // A Bloater's speed against the ordinary dead's of its gait

// A Bloater bursting, as far as `reach`, `harder` times as hard: the dead round it wounded and thrown down (credited to
// whoever killed it, if anyone did), and it gone, in pieces. (Hunt hurts the living round it.)
void Rupture(Entity self, mut Zombie zombie, Match match, Herd herd, float reach, float harder)
{
    zombie.popped = true;
    var at = zombie.chestAt;
    foreach (var z in Near(herd, at, reach))
    {
        if (!z.hittable || z.entity == self) continue;
        var far = Math.Distance(z.at + float3(0, 1, 0), at);
        if (far > reach) continue;
        var share = Math.Sqrt(1 - far / reach);
        z.entity.Send(Wound { damage = ZombieHealth(match.danger) * 2 * harder * (0.4 + 0.6 * share), seat = zombie.killer, element = Element.Blast, from = at,
                              knock = 8 * share, down = share > 0.3, blow = Blow.Burst, echo = true });
    }
    Send(Blast { at = at, reach = reach, element = Element.Blast, kind = Shot.Bile });
    if (zombie.state != ZombieState.Dying)
        self.Send(Struck { at = at, from = at - Flat(zombie.yaw), killed = true, element = Element.None, seat = -1, blow = Blow.Burst });
    self.Destroy();
}

// A Spitter's bile: lobbed from its mouth to land where the survivor will be (half of the way they're going), arcing
// over the dead between.
void Spit(Zombie zombie, float3 target, float3 goes, float danger)
{
    var from = zombie.headAt + Flat(zombie.yaw) * 0.3;
    var aim = target + float3(0, 1.0, 0);
    var flight = Math.Clamp(Math.Length((aim - from).xz) / SPIT_SPEED, 0.4, 1.6);
    var to = aim + float3(goes.x, 0, goes.z) * flight * SPIT_LEAD;
    var velocity = (to - from) / flight + float3(0, 0.5 * SPIT_GRAVITY * flight, 0);
    Spawn(Missile { kind = Shot.Spit, at = from, velocity = velocity, gravity = SPIT_GRAVITY, damage = SPIT_HURT * Harm(danger), splash = SPIT_REACH, seat = -1, life = 4 });
    Send(Cue { sound = Sfx.Spit, at = from });
}

void Become(mut Zombie zombie, ZombieState state)
{
    zombie.state = state;
    zombie.timer = 0;
}

// A blow lands: the damage (a Warden's mail turning most of one to its body), a reel, death; the kill to whoever dealt
// it. A Brute doesn't reel or go over, and is pushed a little.
event(Wound wound) TakeWound(mut Zombie zombie, mut Match match, Party party)
{
    if (zombie.state == ZombieState.Dying) return;
    var steady = zombie.kind == ZombieKind.Brute;
    // On its back it's open: blows land harder, and a Warden's mail doesn't help
    var over = zombie.state == ZombieState.Fallen && wound.blow != Blow.Burning && wound.blow != Blow.Bleeding;
    var mail = zombie.kind == ZombieKind.Warden && !wound.head && !over && wound.blow != Blow.Burning && wound.blow != Blow.Bleeding && wound.blow != Blow.Shove;
    var damage = wound.damage * (over ? 1.5 : 1.0) * (mail ? WARDEN_MAIL : 1.0);
    zombie.health -= damage;
    var killed = zombie.health <= 0;
    // What the element does besides
    if (wound.element == Element.Fire)
    {
        zombie.burn = 3;
        zombie.burner = wound.seat;
    }
    if (wound.element == Element.Bleed)
    {
        zombie.bleed = 3;
        zombie.bleeder = wound.seat;
    }
    // Frost slows; frost again while slowed freezes solid a moment
    if (wound.element == Element.Frost)
    {
        if (zombie.chill > 0) zombie.frozen = Math.Max(zombie.frozen, 1.2);
        zombie.chill = 3;
    }
    if (wound.element == Element.Shock) zombie.stun = Math.Max(zombie.stun, 0.6);
    if (wound.freeze > 0) zombie.frozen = Math.Max(zombie.frozen, wound.freeze);
    if (wound.knock > 0)
    {
        mut var away = zombie.at - wound.from;
        away.y = 0;
        zombie.shove = Math.Normalize(away) * wound.knock * (steady ? BRUTE_SHOVE : 1.0);
    }
    if (killed)
    {
        var wasDown = zombie.state == ZombieState.Fallen;
        zombie.state = ZombieState.Dying;
        zombie.timer = 0;
        zombie.torn = true;
        zombie.killer = wound.seat;
        zombie.head = wound.head;
        zombie.fall = Random.NextInt(2);
        // Dying where it lies, or thrown off its feet by the blow that kills it
        if (wasDown) zombie.fall = 2;
        else if (wound.down)
        {
            zombie.fall = 3;
            zombie.yaw = YawTo(zombie.at, wound.from);
        }
        zombie.swing = 0;
        zombie.windup = 0;
        zombie.leap = 0;
        match.killed += 1;
        // A cull's kills in its circle (missions.tide)
        if (match.mission == MissionKind.Cull && Math.Length((zombie.at - match.missionAt).xz) <= CULL_REACH) match.missionDone += 1;
        // The party's experience, and a level when there's enough
        DropOrb(match, zombie.at, KindWorth(zombie.kind) * OrbWorth(match.danger));
    }
    else
    {
        if (wound.down && zombie.state == ZombieState.Hunting && !steady)
        {
            // Off its feet, falling away from the blow
            Become(zombie, ZombieState.Fallen);
            zombie.downFor = 1.3 + Random.NextFloat() * 1.2;
            zombie.yaw = YawTo(zombie.at, wound.from);
            zombie.swing = 0;
            zombie.windup = 0;
            zombie.leap = 0;
            zombie.flinch = 0;
        }
        else if (wound.damage >= 1 && zombie.state == ZombieState.Hunting && wound.knock >= 0 && !steady)
            zombie.flinch = Math.Max(zombie.flinch, wound.head ? 0.45 : 0.3);
    }
    if (killed && wound.seat >= 0 && wound.seat < 4 && party.taken[wound.seat])
        party.survivors[wound.seat].Send(Earned { kill = true, head = wound.head, at = zombie.at,
                                                  echo = wound.echo || wound.blow == Blow.Burning || wound.blow == Blow.Bleeding });
    var body = BodyOf(this, zombie);
    this.Send(Struck { at = wound.head ? body.head : body.chest, from = wound.from, head = wound.head, killed = killed, element = wound.element, seat = wound.seat,
                       blow = wound.blow, crit = wound.crit, mail = mail && wound.damage >= 1 });
}

// A Howler's howl, for what's seen: where, and how far the dead round it are frenzied.
event Howled
{
    float3 at;
    float reach;
}
