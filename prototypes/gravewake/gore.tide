// Gore: the ground soaks up blood, and the dead come apart.
//
// Blood on the ground is a texture over the whole clearing (Lens.stains, 2048
// texels across NAV's 156 m: about 7.6 cm each), cleared at a new run and
// drying slowly away (DRY_EVERY): each splat is drawn into it once, from
// above, and the forest floor's frag (look.tide's Earth) reads it. So there can be any number of them, for
// nothing after the frame they land. A hit leaves drops under it, a kill a
// pool and a spray thrown the way the blow went, and every piece that flies
// leaves a trail and a smear where it comes down.
//
// A kill by a blow (not burning or bleeding) throws pieces of the dead: limbs
// and lumps of flesh (the head too, on a head shot), tumbling, bouncing and
// lying a while in the dirt before they sink away. They're boxes in the PSX
// way, painted as raw meat, all one instanced draw. All of this is this
// machine's alone (the owner: "more gore, more blood, body parts flying, maybe
// decals of blood ... or maybe we just draw to a texture that overlays the
// terrain").

const int STAIN_PIXELS = 2048;
const float STAIN_REACH = 78;        // Half the clearing's width the stains cover (NAV_X0, NAV_Z0 to 78)
const int GIBS_MOST = 1000;
const float GIB_SECONDS = 22;        // How long a piece lies before it's gone
const float DRY_EVERY = 2;           // Every so often the stains fade by DRY_SHARE: old blood's gone in a few minutes
const float DRY_SHARE = 0.025;

struct Gib
{
    float3 at;
    float3 velocity;
    quaternion turn;
    float3 spin;                     // Its axis, as long as radians a second
    float3 size;
    float3 color;
    float age;
    bool resting;
    float drip;                      // Seconds till its next drop of blood in the air
}

// A piece as it's drawn.
struct GibPiece
{
    float4x4 transform;
    float3 color;
    float wet;                       // 1 fresh, down to 0 as it dries
}

// A splat into the stains: where on the ground, how big, turned how, how much shows, its colour and its own shape.
struct Splat
{
    float3 at;
    float size;
    float turn;
    float alpha;
    float seed;
    float stretch;                   // Along its turn: 1 round, more a smear
    float3 tint;                     // Blood, or a Bloater's bile
}

const float3 BLOOD = float3(0.36, 0.025, 0.02);

// A pool spreading under one of the dead fallen: where, how wide it'll be, and how long it has to get there.
struct Pool
{
    float3 at;
    float size;
    float left;
    float wait;                      // Seconds till it spreads again
}

local singleton Gore
{
    List<Gib> gibs;
    List<GibPiece> pieces;
    List<Splat> splats;              // To draw into the stains this frame
    List<Pool> pools;
    List<Corner> box;
    List<int> boxFaces;
    Random random;
    bool wipe = true;                // Clear the stains (made, and at each new run)
    float dry;                       // Seconds till they fade again
    List<Splat> all;                 // One splat over the whole of them, to fade them by
    bool made;
}

void MakeGore(mut Gore gore)
{
    gore.box.Clear();
    gore.boxFaces.Clear();
    // A unit box, its faces each with their own corners and normal
    for (var f = 0; f < 6; f++)
    {
        var axis = f / 2;
        var sign = f % 2 == 0 ? 1.0 : -1.0;
        var n = axis == 0 ? float3(sign, 0, 0) : axis == 1 ? float3(0, sign, 0) : float3(0, 0, sign);
        var u = axis == 0 ? float3(0, 1, 0) : axis == 1 ? float3(0, 0, 1) : float3(1, 0, 0);
        var v = Math.Cross(n, u);
        var first = gore.box.count;
        gore.box.Add(Corner { position = (n - u - v) * 0.5, normal = n, uv = float2(0, 0) });
        gore.box.Add(Corner { position = (n + u - v) * 0.5, normal = n, uv = float2(1, 0) });
        gore.box.Add(Corner { position = (n + u + v) * 0.5, normal = n, uv = float2(1, 1) });
        gore.box.Add(Corner { position = (n - u + v) * 0.5, normal = n, uv = float2(0, 1) });
        gore.boxFaces.Add(first);
        gore.boxFaces.Add(first + 1);
        gore.boxFaces.Add(first + 2);
        gore.boxFaces.Add(first);
        gore.boxFaces.Add(first + 2);
        gore.boxFaces.Add(first + 3);
    }
    gore.made = true;
}

void Stain(mut Gore gore, float3 at, float size, float alpha, float turn, float stretch, float3 tint = BLOOD)
{
    if (gore.splats.count >= 6000) return;
    gore.splats.Add(Splat { at = at, size = size, turn = turn, alpha = alpha, seed = gore.random.NextFloat(100), stretch = stretch, tint = tint });
}

void Throw(mut Gore gore, float3 at, float3 velocity, float3 size, float3 color)
{
    if (gore.gibs.count >= GIBS_MOST) gore.gibs.RemoveAt(0);
    var axis = Math.Normalize(gore.random.NextFloat3Direction() + float3(0, 0.0001, 0));
    gore.gibs.Add(Gib { at = at, velocity = velocity, turn = quaternion.AxisAngle(axis, gore.random.NextFloat(Math.TAU)), spin = gore.random.NextFloat3Direction() * gore.random.NextFloat(6, 16),
                        size = size, color = color, drip = gore.random.NextFloat(0.05) });
}

// ---- What a blow leaves ----

local event(Struck struck) Spill(mut Gore gore)
{
    if (struck.blow == Blow.Shove || struck.blow == Blow.Burning) return;
    var ground = On(struck.at.x, struck.at.z);
    mut var away = struck.at - struck.from;
    away.y = 0;
    away = Math.Length(away) > 0.01 ? Math.Normalize(away) : gore.random.NextFloat3Direction() * float3(1, 0, 1);
    var turn = Math.Atan2(away.x, away.z);
    if (!struck.killed)
    {
        // Drops under it, and a spray out the far side, smeared the way it went
        Stain(gore, ground + away * gore.random.NextFloat(0.1, 0.5), gore.random.NextFloat(0.18, 0.34), 0.6, gore.random.NextFloat(Math.TAU), 1);
        Stain(gore, ground + away * gore.random.NextFloat(0.9, 2.2), gore.random.NextFloat(0.18, 0.32), 0.55, turn + gore.random.NextFloat(-0.25, 0.25), gore.random.NextFloat(2, 3.5));
        if (struck.head) Stain(gore, ground + away * gore.random.NextFloat(1.4, 2.8), gore.random.NextFloat(0.25, 0.4), 0.55, turn, 3);
        return;
    }
    // A kill: a pool where it falls (spreading a while: Pool), a spray thrown far on the way the blow went
    Stain(gore, ground, gore.random.NextFloat(0.6, 1.0), 0.8, gore.random.NextFloat(Math.TAU), 1.2);
    if (gore.pools.count < 300) gore.pools.Add(Pool { at = ground + away * 0.5, size = gore.random.NextFloat(1.0, 1.6), left = 2.5 });
    for (var i = 0; i < 7; i++)
        Stain(gore, ground + away * gore.random.NextFloat(0.6, 4.5) + gore.random.NextFloat3Direction() * float3(0.5, 0, 0.5), gore.random.NextFloat(0.18, 0.5), 0.65,
              turn + gore.random.NextFloat(-0.4, 0.4), gore.random.NextFloat(1.5, 3.5));
    if (struck.blow == Blow.Bleeding) return;
    // Pieces: limbs, lumps and ropes of gut, the head too on a head shot, a burst many more of them
    var burst = struck.blow == Blow.Burst || struck.element == Element.Blast;
    var flesh = float3(0.42, 0.12, 0.1);
    var skin = float3(0.36, 0.36, 0.3);
    var gut = float3(0.55, 0.22, 0.2);
    var count = burst ? 12 : 5 + gore.random.NextInt(3);
    for (var i = 0; i < count; i++)
    {
        var kind = gore.random.NextInt(4);
        var size = (kind == 0 ? float3(0.13, 0.13, 0.45) : kind == 1 ? float3(0.2, 0.15, 0.17) : kind == 2 ? float3(0.1, 0.09, 0.12) : float3(0.06, 0.06, 0.55)) * 1.25;
        var color = kind == 0 ? skin : kind == 3 ? gut : flesh;
        var push = burst ? 8.0 : 5.0;
        var velocity = away * gore.random.NextFloat(push * 0.4, push) + gore.random.NextFloat3Direction() * 2.6 + float3(0, gore.random.NextFloat(2.5, 6), 0);
        Throw(gore, struck.at + gore.random.NextFloat3Direction() * 0.15, velocity, size, color);
    }
    if (struck.head)
        Throw(gore, struck.at, away * gore.random.NextFloat(3, 6) + float3(0, gore.random.NextFloat(4, 6.5), 0), float3(0.24, 0.27, 0.25), skin);
}

// A Bloater's burst and a Spitter's bile: green over the ground, and the burst's blood too.
local event(Blast blast) Splash(mut Gore gore)
{
    if (blast.kind != Shot.Bile && blast.kind != Shot.Spit) return;
    var bile = float3(0.2, 0.26, 0.03);
    var ground = On(blast.at.x, blast.at.z);
    Stain(gore, ground, blast.kind == Shot.Bile ? blast.reach * 0.6 : 0.7, 0.75, gore.random.NextFloat(Math.TAU), 1.1, bile);
    if (blast.kind != Shot.Bile) return;
    for (var i = 0; i < 14; i++)
    {
        var turn = gore.random.NextFloat(Math.TAU);
        var far = gore.random.NextFloat(0.5, blast.reach);
        Stain(gore, ground + float3(Math.Sin(turn), 0, Math.Cos(turn)) * far, gore.random.NextFloat(0.25, 0.6), 0.7, turn, gore.random.NextFloat(1.5, 3), i % 3 == 0 ? BLOOD : bile);
    }
}

local event(RunBegan began) WipeGore(mut Gore gore)
{
    gore.wipe = true;
    gore.gibs.Clear();
}

// ---- Each frame: the pools spread; the pieces fly, bounce and lie; what they drip and where they land go into the stains ----

[Stage(Layers.Gather, 4)]
view Tumble(mut Gore gore, mut Fx fx, Me me)
{
    if (!gore.made) MakeGore(gore);
    var dt = me.dt;
    // Each pool a little wider every few tenths of a second, faint, so it creeps out over the ground
    for (var i = gore.pools.count - 1; i >= 0; i--)
    {
        mut var p = gore.pools[i];
        p.left -= dt;
        p.wait -= dt;
        if (p.left <= 0)
        {
            gore.pools.RemoveAt(i);
            continue;
        }
        if (p.wait <= 0)
        {
            p.wait = 0.2;
            var grown = p.size * (1 - p.left / 2.5 * 0.6);
            Stain(gore, p.at + gore.random.NextFloat3Direction() * float3(0.15, 0, 0.15), grown * gore.random.NextFloat(0.4, 0.55), 0.22, gore.random.NextFloat(Math.TAU), 1.2);
        }
        gore.pools[i] = p;
    }
    gore.pieces.Clear();
    for (var i = gore.gibs.count - 1; i >= 0; i--)
    {
        mut var g = gore.gibs[i];
        g.age += dt;
        if (g.age > GIB_SECONDS)
        {
            gore.gibs.RemoveAt(i);
            continue;
        }
        if (!g.resting)
        {
            g.velocity.y -= 14 * dt;
            g.at += g.velocity * dt;
            var spinRate = Math.Length(g.spin);
            if (spinRate > 0.01) g.turn = Math.Normalize(Math.Mul(quaternion.AxisAngle(g.spin / spinRate, spinRate * dt), g.turn));
            // Blood on the way, trailing it through the air and spattering where it falls
            g.drip -= dt;
            if (g.drip <= 0)
            {
                g.drip = 0.045;
                Murk(fx, Mote { at = g.at, velocity = g.velocity * 0.3 + Scatter(fx, 0.4), life = 1.2, size = gore.random.NextFloat(0.05, 0.09), gravity = 10,
                                color = float3(0.45, 0.03, 0.03), alpha = 0.9, stain = 0.08 });
            }
            var floor = Ground(g.at.x, g.at.z) + g.size.y * 0.4;
            if (g.at.y < floor)
            {
                g.at.y = floor;
                // A smear where it hits, the way it was going
                var flat = float3(g.velocity.x, 0, g.velocity.z);
                var speed = Math.Length(flat);
                Stain(gore, On(g.at.x, g.at.z) + flat * 0.05, 0.12 + Math.Min(0.25, speed * 0.04), 0.6, Math.Atan2(g.velocity.x, g.velocity.z), 1 + Math.Min(2.5, speed * 0.4));
                if (-g.velocity.y < 1.5 && speed < 1.2)
                {
                    g.resting = true;
                    g.velocity = float3(0);
                }
                else
                {
                    g.velocity = float3(g.velocity.x * 0.45, -g.velocity.y * 0.3, g.velocity.z * 0.45);
                    g.spin *= 0.5;
                }
            }
        }
        gore.gibs[i] = g;
        // Sinking into the ground its last two seconds
        var sink = Math.Saturate((g.age - (GIB_SECONDS - 2)) / 2) * 0.3;
        if (Math.Distance(g.at, me.eye) < 60)
            gore.pieces.Add(GibPiece { transform = float4x4.TRS(g.at - float3(0, sink, 0), g.turn, g.size), color = g.color, wet = Math.Saturate(1 - g.age / 12) });
    }
}

// Into the stains: the ground seen from straight above, every splat this frame laid over what's there.
[Stage(Layers.Shadows, 3)]
view Soak(mut Gore gore, Lens lens)
{
    if (!lens.made) return;
    if (gore.wipe)
    {
        lens.stains.Clear(Color(0, 0, 0, 0));
        gore.wipe = false;
    }
    gore.dry -= Math.Min(Frame.dt, 0.1);
    var drying = gore.dry <= 0;
    if (gore.splats.count == 0 && !drying) return;
    AimStains(lens);
    lens.stains.Depth(Depth.None),
    lens.stains.Cull(Cull.None),
    lens.stains.Blend(Blend.Alpha)
    {
        if (drying)
        {
            gore.dry = DRY_EVERY;
            gore.all.Clear();
            gore.all.Add(Splat { at = float3(NAV_X0 + STAIN_REACH, 0, NAV_Z0 + STAIN_REACH), size = STAIN_REACH * 1.05, stretch = 1, alpha = DRY_SHARE });
            lens.stains.Instanced(gore.box, gore.boxFaces, gore.all, SplatAt, Dry);
        }
        if (gore.splats.count > 0) lens.stains.Instanced(gore.box, gore.boxFaces, gore.splats, SplatAt, SplatBlood);
    }
    gore.splats.Clear();
}

// Fading what's there: nothing laid over it, a little at a time.
frag Dry(Corner corner, out Color color, Splat splat)
{
    color = Color(0, 0, 0, splat.alpha);
}

// A splat's square on the ground: the box's top face (y up) laid flat, turned, stretched along its way, sized.
vert SplatAt(mut Corner corner, Splat splat)
{
    var x = corner.position.x * 2;
    var z = corner.position.z * 2;
    var c = Math.Cos(splat.turn);
    var s = Math.Sin(splat.turn);
    var along = z * splat.stretch;
    corner.position = float3(splat.at.x + (x * c + along * s) * splat.size, 0, splat.at.z + (-x * s + along * c) * splat.size);
    corner.uv = float2(x, z);
}

// Its blot: a ragged round, darker at the middle, a few drops thrown round its edge.
frag SplatBlood(Corner corner, out Color color, Splat splat)
{
    var p = corner.uv;
    var r = Math.Length(p);
    var angle = Math.Atan2(p.y, p.x);
    var ragged = 0.62 + Math.Perlin(float2(angle * 2.2 + splat.seed, splat.seed * 0.37)) * 0.28 + Math.Perlin(float2(angle * 7 + splat.seed * 3, 1.7)) * 0.08;
    var drop = Math.Perlin(p * 5.5 + float2(splat.seed, splat.seed * 1.3)) > 0.42 && r < 0.95 ? 1.0 : 0.0;
    var inside = Math.Max(1 - Math.SmoothStep(ragged - 0.06, ragged + 0.02, r), drop);
    if (inside <= 0.01) this.Discard();
    var dark = 1 - r * 0.45;
    color = Color(splat.tint.x * dark, splat.tint.y * dark, splat.tint.z * dark, inside * splat.alpha);
}

// The pieces: raw and wet, darker as they dry.
[Stage(Layers.Scene, 4)]
view DrawGore(Gore gore, Lens lens)
{
    if (!lens.made || !gore.made || gore.pieces.count == 0) return;
    lens.scene.Instanced(gore.box, gore.boxFaces, gore.pieces, Wobble, Meat);
}

frag Meat(Corner corner, out Color color, GibPiece piece, Instance instance, Look look, Lights lights, Lens lens)
{
    var normal = instance.Normal(corner.normal);
    var p = this.world * 9;
    var mottle = Math.Perlin(p.xz + float2(p.y, -p.y)) * 0.5 + 0.5;
    var raw = Math.Lerp(Linear(piece.color), Linear(float3(0.3, 0.02, 0.02)), Math.Saturate(mottle * 0.9 - 0.15));
    mut var lit = Shade(raw, this.world, normal, 1, look, lights.list, lens.moonDepth);
    // A wet shine while it's fresh
    var toEye = Math.Normalize(look.eye - this.world);
    var shine = Math.Pow(Math.Saturate(Math.Dot(Math.Reflect(-toEye, normal), look.moonWay)), 20) * piece.wet;
    lit += look.moonColor * shine * 1.5;
    color = Color(Hazed(lit, this.world, look), 1);
}
