// The chest that gives what it likes, the Runeforge, and what the dead drop:
// full quivers, a skull that kills at a touch, doubled gold, holy fire, a
// carpenter's hammer. And the cues the match sends for what's heard.

enum Boon { MaxAmmo, InstaKill, DoublePoints, Nuke, Carpenter }

const int BOON_COUNT = 5;
const float CHEST_SPIN = 4.6;
const float CHEST_OFFER = 12;
const float FORGE_WORK = 4.2;
const float FORGE_OFFER = 16;
const float BOON_SECONDS = 30;
const int DROPS_MOST = 4;

// A power-up, floating where one of the dead fell.
component Drop
{
    float3 at;
    Boon kind;
    float life = 27;
    local Sound hum;
}

// What's heard, where: the match says, each machine plays it.
enum Sfx { Rise, Snarl, Deny, Coins, ChestOpen, ChestClose, ChestFlee, ChestLand, Forge, ForgeReady, Drink, Revive, Downed, Hurt, Empty, Throw, Bell }

event Cue
{
    Sfx sound;
    float3 at;
}

// A power-up taken.
event Boons
{
    Boon kind;
    float3 at;
}

// Points back, as they were paid.
event Refund
{
    int points;
}

// Every arrow, bolt and charge back, and the fire pots.
event Restock { }

// The chest: spinning, offering, sometimes leaving for another place.
[Stage(Tick.Rounds, 3)]
system Shrines(mut Match match, Ashwick ashwick, Party party, Time time)
{
    match.chestTime += time.dt;
    switch (match.chest)
    {
        case ChestState.Spinning:
            if (match.chestTime < CHEST_SPIN) break;
            match.chestTime = 0;
            if (match.chestSkull)
            {
                match.chest = ChestState.Fleeing;
                if (match.chestFor >= 0 && party.taken[match.chestFor]) party.survivors[match.chestFor].Send(Refund { points = CHEST_COST });
                Send(Cue { sound = Sfx.ChestFlee, at = ashwick.stalls[ChestStall(ashwick, match.chestSpot)].at });
            }
            else
            {
                match.chest = ChestState.Offering;
            }
            break;
        case ChestState.Offering:
            if (match.chestTime < CHEST_OFFER) break;
            match.chest = ChestState.Shut;
            match.chestTime = 0;
            match.chestFor = -1;
            break;
        case ChestState.Fleeing:
            if (match.chestTime < 4) break;
            match.chest = ChestState.Gone;
            match.chestTime = 0;
            break;
        case ChestState.Gone:
            if (match.chestTime < 6) break;
            var spots = ChestSpots(ashwick);
            match.chestSpot = (match.chestSpot + 1 + Random.NextInt(Math.Max(1, spots - 1))) % spots;
            match.chest = ChestState.Shut;
            match.chestTime = 0;
            match.chestFor = -1;
            match.chestUses = 0;
            match.chestSkull = false;
            Send(Cue { sound = Sfx.ChestLand, at = ashwick.stalls[ChestStall(ashwick, match.chestSpot)].at });
            break;
    }
    match.forgeTime += time.dt;
    if (match.forge == ForgeState.Working && match.forgeTime >= FORGE_WORK)
    {
        match.forge = ForgeState.Offering;
        match.forgeTime = 0;
    }
    else if (match.forge == ForgeState.Offering && match.forgeTime >= FORGE_OFFER)
    {
        match.forge = ForgeState.Cold;
        match.forgeTime = 0;
        match.forgeFor = -1;
    }
}

event(Refund refund) TakeRefund(mut Survivor survivor)
{
    survivor.points += refund.points;
}

event(Restock restock) TakeRestock(mut Survivor survivor)
{
    for (var i = 0; i < 3; i++)
    {
        if (survivor.weapons[i] == Weapon.None) continue;
        var info = InfoOf(survivor.weapons[i], survivor.forged[i]);
        survivor.ammo[i] = info.reserve;
        survivor.mag[i] = info.mag;
    }
    survivor.firePots = Math.Max(survivor.firePots, 2);
}

// Now and then one of the dead drops something, a few a round at most.
void MaybeDrop(mut Match match, float3 at)
{
    if (match.drops >= DROPS_MOST || Random.NextInt(1000) >= 28) return;
    match.drops += 1;
    var order = match.dropTurn % 7;
    match.dropTurn += 1 + Random.NextInt(2);
    var kind = order == 0 ? Boon.MaxAmmo : order == 1 ? Boon.InstaKill : order == 2 ? Boon.DoublePoints : order == 3 ? Boon.Carpenter
             : order == 4 ? Boon.MaxAmmo : order == 5 ? Boon.Nuke : Boon.DoublePoints;
    Spawn(Drop { at = float3(at.x, 0, at.z), kind = kind });
}

// A power-up floats a while, blinking at the end, and goes to the first survivor to walk into it.
[Stage(Tick.Late)]
system Pickup(mut Drop drop, mut Match match, Party party, Time time, query (Survivor survivor) survivors, query (Zombie zombie) zombies)
{
    drop.life -= time.dt;
    if (drop.life <= 0)
    {
        this.Destroy();
        return;
    }
    mut var taken = false;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready || s.life != Life.Standing) continue;
        if (Math.Length((s.feet - drop.at).xz) < 1.3) taken = true;
    }
    if (!taken) return;
    switch (drop.kind)
    {
        case Boon.InstaKill:
            match.instakill = BOON_SECONDS;
            break;
        case Boon.DoublePoints:
            match.doubled = BOON_SECONDS;
            break;
        case Boon.MaxAmmo:
            for (var seat = 0; seat < 4; seat++)
                if (party.taken[seat]) party.survivors[seat].Send(Restock { });
            break;
        case Boon.Nuke:
            foreach (var row in zombies)
                if (row.zombie.state != ZombieState.Dying) row.entity.Send(Wound { damage = 1000000, seat = -1, element = Element.Fire, from = drop.at, blow = Blow.Burst });
            for (var seat = 0; seat < 4; seat++)
                if (party.taken[seat]) party.survivors[seat].Send(Refund { points = 400 });
            break;
        case Boon.Carpenter:
            for (var i = 0; i < match.boards.count; i++) match.boards[i] = BOARDS;
            for (var seat = 0; seat < 4; seat++)
                if (party.taken[seat]) party.survivors[seat].Send(Refund { points = 200 });
            break;
    }
    Send(Boons { kind = drop.kind, at = drop.at });
    this.Destroy();
}
