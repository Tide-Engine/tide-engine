// What's written over the picture, on dark glass panels: this survivor's
// health and the party's level in the bottom left, everyone's kills over it
// and the items taken; the night and what's to do in the top left
// (nights.tide); how long the run has gone and how dangerous it's got in the
// top right; the gun and its magazine and the three skills in the bottom
// right; the crosshair, the mark of a hit landing and where a blow came from;
// a friend down, a boss's health across the top, the items offered at a
// level, the survivors to pick from, and the end.
using Rooms;

local singleton Feed
{
    float marker;                // Seconds left of the hit marker
    bool markerKill;
    bool markerHead;             // On the head: gold, or red and bigger for a kill
    bool markerCrit;             // A Lucky Shot's double: yellow
    bool markerMail;             // Turned by a Warden's mail: grey
    bool markerWeak;             // On a boss's weak spot: orange and big
    float headshot;              // Seconds left of HEADSHOT over the crosshair
    float dangerFlash;           // Seconds since the danger's words changed
    string dangerShown;
    string banner;               // A power-up's name, the item just taken, a level, big in the middle
    float bannerLeft;
    Color bannerColor = Color.white;
    float played;                // Seconds played, for the controls' reminder
    float gameOver;
    float dealt;                 // Seconds the offer has been showing, for its rise
    List<string> news;           // What the others took, a line each...
    List<float> newsAge;         // ...and how long ago
    float trail = 1;             // The health bar's share a moment ago, trailing down to what's left
    float bossTrail = 1;
    List<float3> blows;          // Where the blows taken came from...
    List<float> blowAges;        // ...and how long ago
}

const Color GOLD = Color(0.95, 0.82, 0.45);
const Color CHALK = Color(0.62, 0.04, 0.03);
const Color BONE = Color(0.92, 0.88, 0.8);
const Color ASH = Color(0.6, 0.57, 0.52);
const Color SHADOW = Color(0, 0, 0, 0.8);

float Unit()
{
    return Math.Max(1, Screen.height / 720);
}

// A panel of dark glass: darker toward its foot, a faint light edge, a soft shadow under it.
void Panel(float2 center, float2 size, float u)
{
    Draw.Shape(Shape { center = center + float2(0, 3 * u), size = size, radius = 5 * u, color = Color(0, 0, 0, 0.3), soft = 12 * u });
    Draw.Shape(Shape { center = center, size = size, radius = 5 * u, color = Color(0.08, 0.06, 0.055, 0.8), color2 = Color(0.025, 0.02, 0.02, 0.88), outline = Math.Max(1, u),
                       outlineColor = Color(1, 0.9, 0.75, 0.13) });
}

// A bar from `left` (the middle of its left end): a dark track, what's left from `fill` at its top to `fill2` at its
// foot with a shine, what was just lost (`trail`) paler behind it, and `ticks` marks across.
void Bar(float2 left, float2 size, float share, float trail, Color fill, Color fill2, int ticks, float u)
{
    Draw.Shape(Shape { center = left + float2(size.x * 0.5, 0), size = size + float2(4, 4) * u, radius = 2 * u, color = Color(0, 0, 0, 0.65) });
    var kept = Math.Saturate(share);
    var lost = Math.Saturate(trail);
    if (lost > kept + 0.001)
        Draw.Shape(Shape { center = left + float2(size.x * (kept + lost) * 0.5, 0), size = float2(size.x * (lost - kept), size.y), color = Color(1.0, 0.86, 0.7, 0.75) });
    if (kept > 0.001)
    {
        Draw.Shape(Shape { center = left + float2(size.x * kept * 0.5, 0), size = float2(size.x * kept, size.y), color = fill, color2 = fill2 });
        Draw.Shape(Shape { center = left + float2(size.x * kept * 0.5, -size.y * 0.28), size = float2(size.x * kept, size.y * 0.32), color = Color(1, 1, 1, 0.2),
                           color2 = Color(1, 1, 1, 0) });
    }
    for (var t = 1; t < ticks; t++) Draw.Rect(left + float2(size.x * t / ticks, 0), float2(Math.Max(1, u), size.y), Color(0, 0, 0, 0.5));
}

const Color EMBER = Color(0.98, 0.5, 0.18);
const Color HEALTH = Color(0.86, 0.16, 0.1);
const Color HEALTH_FOOT = Color(0.5, 0.04, 0.03);
const Color SKY_BLUE = Color(0.6, 0.82, 1.0);

void Write(string text, float2 at, float size, Color tint, Anchor anchor)
{
    Draw.Text(text, at + float2(1.5, 1.5) * Unit(), size, Color(0, 0, 0, tint.a * 0.85), anchor);
    Draw.Text(text, at, size, tint, anchor);
}

void WriteBold(string text, float2 at, float size, Color tint, Anchor anchor)
{
    Draw.Text(text, at + float2(2, 2) * Unit(), size, Color(0, 0, 0, tint.a * 0.85), anchor, Font.Bold);
    Draw.Text(text, at, size, tint, anchor, Font.Bold);
}

string HeroName(int seat)
{
    switch (seat)
    {
        case 0: return "Wat";
        case 1: return "Maud";
        case 2: return "Godric";
    }
    return "Agnes";
}

Color HeroColor(int seat)
{
    switch (seat)
    {
        case 0: return Color(0.45, 0.78, 0.38);
        case 1: return Color(0.86, 0.3, 0.26);
        case 2: return Color(0.38, 0.6, 0.92);
    }
    return Color(0.93, 0.76, 0.3);
}

// Minutes and seconds.
string Clock(float seconds)
{
    var whole = int(Math.Floor(seconds));
    var s = whole % 60;
    return s < 10 ? $"{whole / 60}:0{s}" : $"{whole / 60}:{s}";
}

// How far the danger's got, red the higher: its colour for its words.
Color DangerColor(float danger)
{
    return Math.Lerp(Color(0.95, 0.85, 0.55), Color(0.95, 0.12, 0.08), Math.Saturate((danger - 1) / 7));
}

[Stage(Layers.Hud)]
view Overlay(Me me, Look look, Match match, Party party, Lobby lobby, mut Feed feed, Ashwick ashwick, Herd herd, query (Survivor survivor) survivors)
{
    if (lobby.page != Page.Playing) return;
    Cursor.Lock();
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Unit();
    var dt = Math.Min(Frame.dt, 0.05);
    feed.played += dt;
    mut var mine = Survivor { };
    mut var found = false;
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found) return;

    // ---- How long the run has gone, and how dangerous it's got: top right, the danger a meter of eight that fills ----
    var words = DangerName(match.danger);
    if (words != feed.dangerShown)
    {
        feed.dangerShown = words;
        feed.dangerFlash = 0;
    }
    feed.dangerFlash += dt;
    if (match.phase != Phase.Waiting)
    {
        var box = float2(w - 34 * u - 120 * u, 58 * u);
        Panel(box, float2(240 * u, 80 * u), u);
        WriteBold(Clock(match.phase == Phase.Over ? match.lasted : match.clock), float2(box.x + 106 * u, box.y - 14 * u), 32 * u, BONE, Anchor.MiddleRight);
        var flash = Math.Saturate(1 - feed.dangerFlash * 0.7);
        var c = DangerColor(match.danger);
        Write("DANGER", float2(box.x - 106 * u, box.y - 22 * u), 10 * u, ASH, Anchor.MiddleLeft);
        WriteBold(words.ToUpper(), float2(box.x - 106 * u, box.y - 6 * u), (15 + flash * 6) * u, Color(c.r, c.g, c.b, 1), Anchor.MiddleLeft);
        var filled = Math.Saturate((match.danger - 1) / 7) * 8;
        var seg = 212 * u / 8;
        for (var k = 0; k < 8; k++)
        {
            var at = float2(box.x - 106 * u + seg * (k + 0.5), box.y + 22 * u);
            var tone = DangerColor(1 + k * 7.0 / 7);
            var part = Math.Saturate(filled - k);
            Draw.Shape(Shape { center = at, size = float2(seg - 4 * u, 8 * u), radius = 1.5 * u, color = Color(0, 0, 0, 0.6) });
            if (part > 0)
                Draw.Shape(Shape { center = at - float2((seg - 4 * u) * (1 - part) * 0.5, 0), size = float2((seg - 4 * u) * part, 8 * u), radius = 1.5 * u, color = tone,
                                   color2 = Color(tone.r * 0.55, tone.g * 0.55, tone.b * 0.55, 1) });
        }
        // The segment filling now glows as the danger climbs into it
        var now = Math.Min(7, int(filled));
        Draw.Shape(Shape { center = float2(box.x - 106 * u + seg * (now + 0.5), box.y + 22 * u), size = float2(seg - 4 * u, 8 * u), radius = 2 * u, color = Color.none,
                           soft = 8 * u, outline = 0, outlineColor = Color.none });
    }

    // ---- Everyone's kills, a line each ----
    mut var line = 0;
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (!s.ready) continue;
        var own = s.seat == me.seat;
        var y = h - 128 * u - line * 30 * u;
        var size = own ? 22 * u : 17 * u;
        var x = 34 * u;
        Draw.Rect(float2(x - 10 * u, y), float2(5 * u, size * 0.9), HeroColor(s.seat));
        var state = s.life == Life.Downed ? "  down" : s.life == Life.Gone ? "  gone" : "";
        Write($"{s.kills} kills{state}", float2(x, y), size, own ? GOLD : Color(GOLD.r, GOLD.g, GOLD.b, 0.75), Anchor.MiddleLeft);
        line += 1;
    }

    // ---- The items taken, over the scores ----
    var shelf = h - 128 * u - line * 30 * u - 16 * u;
    mut var slot = 0;
    for (var i = 0; i < ITEM_COUNT; i++)
    {
        var count = mine.items[i];
        if (count <= 0) continue;
        var at = float2(40 * u + (slot % 12) * 30 * u, shelf - (slot / 12) * 30 * u);
        DrawItemMark(Item(i), at, 26 * u, 1);
        if (count > 1) Write($"{count}", at + float2(12 * u, 10 * u), 11 * u, BONE, Anchor.MiddleRight);
        slot += 1;
    }

    // ---- This survivor: who, their health (or how long they've to bleed), and the party's level, bottom left ----
    {
        var box = float2(34 * u + 170 * u, h - 62 * u);
        Panel(box, float2(340 * u, 84 * u), u);
        var left = box.x - 156 * u;
        var hero = HeroColor(mine.seat);
        Draw.Shape(Shape { center = float2(box.x - 167 * u, box.y), size = float2(3 * u, 70 * u), color = hero });
        WriteBold(HeroName(mine.seat).ToUpper(), float2(left, box.y - 26 * u), 15 * u, hero, Anchor.MiddleLeft);
        if (mine.role != Role.None)
            Write(RoleName(mine.role).ToUpper(), float2(left + Draw.MeasureText(HeroName(mine.seat).ToUpper(), 15 * u, Font.Bold).x + 10 * u, box.y - 25 * u), 11 * u, ASH,
                  Anchor.MiddleLeft);
        WriteBold($"LV {match.level}", float2(box.x + 156 * u, box.y - 26 * u), 15 * u, SKY_BLUE, Anchor.MiddleRight);
        var most = MaxHealth(mine);
        var share = mine.life == Life.Standing ? mine.health / Math.Max(1, most) : mine.life == Life.Downed ? mine.bleed / BLEED_SECONDS : 0.0;
        feed.trail = share > feed.trail ? share : Math.Max(share, feed.trail - dt * 0.5);
        var down = mine.life == Life.Downed;
        Bar(float2(left, box.y - 2 * u), float2(312 * u, 18 * u), share, feed.trail, down ? Color(0.55, 0.06, 0.05) : HEALTH, down ? Color(0.25, 0.02, 0.02) : HEALTH_FOOT,
            down ? 1 : Math.Clamp(int(most / 25), 1, 16), u);
        var label = down ? "BLEEDING OUT" : mine.life == Life.Gone ? "GONE" : $"{int(Math.Ceil(mine.health))} / {int(most)}";
        WriteBold(label, float2(left + 8 * u, box.y - 2 * u), 12 * u, BONE, Anchor.MiddleLeft);
        var span = LevelSpan(match.level, match.crowd);
        Bar(float2(left, box.y + 24 * u), float2(312 * u, 5 * u), match.xp / span, 0, SKY_BLUE, Color(0.3, 0.5, 0.8), 1, u);
    }

    // ---- The gun, bottom right: its name, the rounds in it big, the magazine as a bar ----
    var info = Info(mine.gun);
    var right = w - 34 * u;
    if (mine.gun != Weapon.None)
    {
        var box = float2(right - 120 * u, h - 52 * u);
        Panel(box, float2(240 * u, 64 * u), u);
        Write(info.name.ToUpper(), float2(box.x - 106 * u, box.y - 14 * u), 12 * u, ASH, Anchor.MiddleLeft);
        var holds = MagOf(mine, mine.gun);
        var low = mine.mag == 0 ? Color(0.95, 0.3, 0.2) : mine.mag <= holds / 4 ? Color(0.98, 0.7, 0.35) : BONE;
        var loading = mine.act == Act.Reload;
        if (!info.bottomless || mine.gun != RoleWeapon(mine.role))
        {
            WriteBold(loading && !info.shells ? "RELOADING" : $"{mine.mag}", float2(box.x + 60 * u, box.y - 4 * u), (loading && !info.shells ? 16 : 34) * u, low, Anchor.MiddleRight);
            Write($"/ {holds}", float2(box.x + 106 * u, box.y + 2 * u), 15 * u, ASH, Anchor.MiddleRight);
            var fill = loading && !info.shells ? Math.Saturate(mine.actTime / Math.Max(0.01, mine.actLength)) : float(mine.mag) / Math.Max(1, holds);
            Bar(float2(box.x - 106 * u, box.y + 18 * u), float2(120 * u, 4 * u), fill, 0, low, Color(low.r * 0.6, low.g * 0.6, low.b * 0.6, 1), 1, u);
        }
    }
    // The three skills: each a slot with its key, shaded as it comes back with the seconds left, lit when it's ready
    if (mine.role != Role.None && mine.life == Life.Standing)
    {
        for (var k = 0; k < 3; k++)
        {
            var skill = SkillOf(mine.role, k);
            var at = float2(right - 27 * u - (2 - k) * 64 * u, h - 140 * u);
            var full = Cooldown(mine, skill);
            var ready = mine.cooldowns[k] <= 0;
            var square = float2(52, 52) * u;
            if (ready) Draw.Shape(Shape { center = at, size = square, radius = 6 * u, color = Color(EMBER.r, EMBER.g, EMBER.b, 0.18), soft = 10 * u });
            Draw.Shape(Shape { center = at, size = square, radius = 6 * u, color = Color(0.1, 0.08, 0.07, 0.86), color2 = Color(0.03, 0.025, 0.02, 0.92), outline = 1.5 * u,
                               outlineColor = ready ? Color(EMBER.r, EMBER.g, EMBER.b, 0.95) : Color(1, 0.9, 0.75, 0.15) });
            var key = k == 0 ? "RMB" : k == 1 ? "SHIFT" : "Q";
            WriteBold(key, at, (k == 1 ? 12 : 16) * u, ready ? BONE : Color(ASH.r, ASH.g, ASH.b, 0.6), Anchor.MiddleCenter);
            if (!ready)
            {
                var left = Math.Saturate(mine.cooldowns[k] / Math.Max(0.01, full));
                Draw.Shape(Shape { center = at + float2(0, square.y * (1 - left) * 0.5), size = float2(square.x - 3 * u, (square.y - 3 * u) * left), radius = 4 * u,
                                   color = Color(0, 0, 0, 0.55) });
                WriteBold($"{int(Math.Ceil(mine.cooldowns[k]))}", at + float2(0, 14 * u), 12 * u, BONE, Anchor.MiddleCenter);
            }
            Write(SkillName(skill).ToUpper(), at + float2(0, 36 * u), 9 * u, ready ? BONE : ASH, Anchor.MiddleCenter);
            // The dash's charges: a pip each, lit when ready
            if (skill == Skill.Slide)
            {
                var charges = DashCharges(mine);
                for (var c = 0; c < charges; c++)
                    Draw.Circle(at + float2((c - (charges - 1) * 0.5) * 9 * u, -33 * u), 2.5 * u, c < mine.dashes ? EMBER : Color(0.3, 0.27, 0.25, 0.8));
            }
        }
    }

    // ---- From above, a ring on the ground round each survivor standing, in their colour, to find them by in a crowd ----
    if (me.above)
    {
        foreach (var row in survivors)
        {
            var s = row.survivor;
            if (!s.ready || s.life == Life.Gone || s.role == Role.None) continue;
            var hue = HeroColor(s.seat);
            var ring = Color(hue.r, hue.g, hue.b, s.seat == me.seat ? 0.55 : 0.4);
            mut var last = float2(0);
            mut var seen = false;
            for (var k = 0; k <= 32; k++)
            {
                var turn = k * Math.TAU / 32;
                var at = s.feet + float3(Math.Sin(turn) * 0.75, 0.05, Math.Cos(turn) * 0.75);
                float4 clip = Math.Mul(look.toClip, float4(at, 1));
                if (clip.w <= 0.01)
                {
                    seen = false;
                    continue;
                }
                var dot = float2((clip.x / clip.w * 0.5 + 0.5) * w, (0.5 - clip.y / clip.w * 0.5) * h);
                if (seen) Draw.Line(last, dot, 2 * u, ring);
                last = dot;
                seen = true;
            }
        }
    }

    // ---- The crosshair and the hit marker ----
    var middle = float2(w * 0.5, h * 0.5);
    // From above, the crosshair is the cursor, and the blows' arcs go round the survivor
    var reticle = me.above && me.cursor.x >= 0 ? me.cursor : middle;
    mut var round = middle;
    if (me.above)
    {
        float4 body = Math.Mul(look.toClip, float4(mine.feet + float3(0, 1, 0), 1));
        if (body.w > 0.01) round = float2((body.x / body.w * 0.5 + 0.5) * w, (0.5 - body.y / body.w * 0.5) * h);
    }
    // Where each blow taken came from: a red arc round the crosshair on that side, fading
    for (var i = feed.blows.count - 1; i >= 0; i--)
    {
        feed.blowAges[i] = feed.blowAges[i] + dt;
        if (feed.blowAges[i] > 1.4)
        {
            feed.blows.RemoveAt(i);
            feed.blowAges.RemoveAt(i);
        }
    }
    for (var i = 0; i < feed.blows.count; i++)
    {
        var to = feed.blows[i] - mine.feet;
        var side = Math.Dot(to, Flat(me.yaw + Math.PI * 0.5));
        var ahead = Math.Dot(to, Flat(me.yaw));
        var turn = Math.Atan2(-ahead, side);
        var fade = Math.Saturate(1.4 - feed.blowAges[i]);
        Draw.Arc(round, 118 * u, turn - 0.32, 0.64, 7 * u, Color(0.95, 0.12, 0.08, 0.85 * fade));
        Draw.Arc(round, 108 * u, turn - 0.18, 0.36, 3 * u, Color(1.0, 0.5, 0.4, 0.6 * fade));
    }
    if (mine.life != Life.Gone && mine.role != Role.None)
    {
        var gap = (5 + info.spread * h * 0.6) * u / Unit();
        var tick = 7 * u;
        // Over the shoulder a round goes from the gun to what the crosshair is on; where something's in the way (a
        // rise, a wall, one of the dead nearer the gun) and it'd stop away from the crosshair, a red ring is where,
        // and the crosshair dims.
        mut var blocked = false;
        if (me.outside && !me.above && mine.life == Life.Standing)
        {
            var from = AimFrom(mine, info.range, ashwick, herd, out var way);
            var reach = Math.Distance(from, AimedAt(mine, info.range, ashwick, herd));
            var stop = FirstHit(from, from + way * reach, ashwick, herd);
            float4 clip = Math.Mul(look.toClip, float4(from + way * reach * Math.Min(1, stop), 1));
            if (stop < 1 && clip.w > 0.01)
            {
                var seen = float2((clip.x / clip.w * 0.5 + 0.5) * w, (0.5 - clip.y / clip.w * 0.5) * h);
                if (Math.Distance(seen, middle) > 14 * u)
                {
                    blocked = true;
                    Draw.WireCircle(seen, 9 * u, 2.5 * u, Color(1.0, 0.25, 0.15, 0.95));
                    Draw.Circle(seen, 2.5 * u, Color(1.0, 0.25, 0.15, 0.95));
                }
            }
        }
        // (from above, warmer on one of the dead)
        var c = me.above && me.onBody ? Color(1.0, 0.6, 0.45, 0.9) : Color(1, 1, 1, blocked ? 0.3 : 0.75);
        Draw.Line(reticle + float2(gap, 0), reticle + float2(gap + tick, 0), 2 * u, c);
        Draw.Line(reticle - float2(gap, 0), reticle - float2(gap + tick, 0), 2 * u, c);
        Draw.Line(reticle + float2(0, gap), reticle + float2(0, gap + tick), 2 * u, c);
        Draw.Line(reticle - float2(0, gap), reticle - float2(0, gap + tick), 2 * u, c);
        Draw.Circle(reticle, 1.5 * u, c);
    }
    feed.marker = Math.Max(0, feed.marker - dt);
    if (feed.marker > 0)
    {
        var a = Math.Saturate(feed.marker * 5);
        var c = feed.markerWeak ? Color(1.0, 0.55, 0.1, a) : feed.markerMail ? Color(0.55, 0.6, 0.68, a) : feed.markerCrit ? Color(1.0, 0.95, 0.35, a)
              : feed.markerHead ? (feed.markerKill ? Color(1.0, 0.18, 0.1, a) : Color(1.0, 0.78, 0.25, a)) : feed.markerKill ? Color(0.95, 0.2, 0.15, a) : Color(1, 1, 1, a);
        var s = (feed.markerWeak ? 14 : feed.markerHead ? (feed.markerKill ? 15 : 11) : feed.markerKill ? 11 : 8) * u;
        var thick = (feed.markerHead ? 3.5 : 2.5) * u;
        Draw.Line(reticle + float2(-s, -s), reticle + float2(-s * 0.4, -s * 0.4), thick, c);
        Draw.Line(reticle + float2(s, -s), reticle + float2(s * 0.4, -s * 0.4), thick, c);
        Draw.Line(reticle + float2(-s, s), reticle + float2(-s * 0.4, s * 0.4), thick, c);
        Draw.Line(reticle + float2(s, s), reticle + float2(s * 0.4, s * 0.4), thick, c);
    }
    feed.headshot = Math.Max(0, feed.headshot - dt);
    if (feed.headshot > 0)
    {
        var a = Math.Saturate(feed.headshot * 3);
        var rise = (0.9 - feed.headshot) * 14 * u;
        WriteBold("HEADSHOT", reticle + float2(0, -46 * u - rise), 17 * u, Color(1.0, 0.25, 0.12, a), Anchor.MiddleCenter);
    }

    // ---- A friend to raise ----
    if (mine.aimed >= 0 && mine.life == Life.Standing) Write($"Hold E to revive {HeroName(mine.aimed)}", float2(w * 0.5, h * 0.64), 18 * u, BONE, Anchor.MiddleCenter);


    // ---- What the others took ----
    for (var i = feed.news.count - 1; i >= 0; i--)
    {
        feed.newsAge[i] = feed.newsAge[i] + dt;
        if (feed.newsAge[i] > 6)
        {
            feed.news.RemoveAt(i);
            feed.newsAge.RemoveAt(i);
        }
    }
    for (var i = 0; i < feed.news.count; i++)
        Write(feed.news[i], float2(w - 34 * u, 140 * u + i * 20 * u), 14 * u, Color(BONE.r, BONE.g, BONE.b, Math.Saturate(6 - feed.newsAge[i])), Anchor.MiddleRight);

    // ---- The banner: a power-up's name, the card taken ----
    feed.bannerLeft = Math.Max(0, feed.bannerLeft - dt);
    if (feed.bannerLeft > 0 && feed.banner != "" && !mine.choosing && !match.paused)
    {
        var a = Math.Saturate(feed.bannerLeft * 1.5) * Math.Saturate((2.6 - feed.bannerLeft) * 4);
        WriteBold(feed.banner, float2(w * 0.5, h * 0.3), 34 * u, Color(feed.bannerColor.r, feed.bannerColor.g, feed.bannerColor.b, a), Anchor.MiddleCenter);
    }

    // ---- A friend down: where they are, and the hands on them ----
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (s.seat == me.seat || s.life != Life.Downed) continue;
        float4 clip = Math.Mul(look.toClip, float4(s.feet + float3(0, 1.0, 0), 1));
        if (clip.w <= 0.01) continue;
        var seen = float2((clip.x / clip.w * 0.5 + 0.5) * w, (0.5 - clip.y / clip.w * 0.5) * h);
        var at = float2(Math.Clamp(seen.x, 40 * u, w - 40 * u), Math.Clamp(seen.y, 40 * u, h - 40 * u));
        var pulse = 0.6 + Math.Sin(feed.played * 6) * 0.4;
        Draw.Circle(at, 14 * u, Color(0.1, 0.02, 0.02, 0.7));
        Draw.Rect(at, float2(4 * u, 16 * u), Color(0.9, 0.2, 0.15, pulse));
        Draw.Rect(at, float2(16 * u, 4 * u), Color(0.9, 0.2, 0.15, pulse));
        if (s.revive > 0) Draw.Arc(at, 20 * u, -Math.PI * 0.5, Math.TAU * s.revive, 3 * u, BONE);
    }

    // ---- Down ----
    if (mine.life == Life.Downed && match.phase != Phase.Over)
    {
        WriteBold("BLEEDING OUT", float2(w * 0.5, h * 0.38), 30 * u, Color(0.85, 0.15, 0.12), Anchor.MiddleCenter);
        Draw.Rect(float2(w * 0.5, h * 0.38 + 30 * u), float2(260 * u, 6 * u), Color(0, 0, 0, 0.6));
        Draw.Rect(float2(w * 0.5 - 130 * u + 130 * u * Math.Saturate(mine.bleed / BLEED_SECONDS), h * 0.38 + 30 * u),
                  float2(260 * u * Math.Saturate(mine.bleed / BLEED_SECONDS), 6 * u), Color(0.8, 0.12, 0.1));
        if (mine.revive > 0)
        {
            Write("Being raised...", float2(w * 0.5, h * 0.62), 18 * u, BONE, Anchor.MiddleCenter);
            Draw.Rect(float2(w * 0.5, h * 0.62 + 22 * u), float2(200 * u * Math.Saturate(mine.revive), 5 * u), GOLD);
        }
    }
    if (mine.life == Life.Gone && match.phase != Phase.Over)
    {
        WriteBold("You bled out", float2(w * 0.5, h * 0.36), 26 * u, BONE, Anchor.MiddleCenter);
        Write("The beacon calls you back when it's lit, and at dawn", float2(w * 0.5, h * 0.36 + 28 * u), 16 * u, ASH, Anchor.MiddleCenter);
    }
    // A Spitter's bile on them: green at the edges
    if (mine.slimed > 0 && mine.life == Life.Standing)
    {
        var green = Color(0.35, 0.5, 0.05, 0.3 * Math.Saturate(mine.slimed / SLIME_SECONDS));
        Draw.Shape(Shape { center = float2(w * 0.5, 0), size = float2(w, 50 * u), color = green, soft = 90 * u });
        Draw.Shape(Shape { center = float2(w * 0.5, h), size = float2(w, 50 * u), color = green, soft = 90 * u });
        Draw.Shape(Shape { center = float2(0, h * 0.5), size = float2(50 * u, h), color = green, soft = 90 * u });
        Draw.Shape(Shape { center = float2(w, h * 0.5), size = float2(50 * u, h), color = green, soft = 90 * u });
    }

    // ---- How to play, for the first minute ----
    if (feed.played < 45 && match.phase != Phase.Over && mine.role != Role.None && !mine.choosing)
    {
        var fade = Math.Saturate((45 - feed.played) * 0.2);
        Write("WASD move (forward runs)   Space jump   Mouse fire   RMB / Shift / Q skills   R reload   E revive, open, light   V view",
              float2(w * 0.5, h - 30 * u), 12 * u, Color(ASH.r, ASH.g, ASH.b, fade), Anchor.LowerCenter);
    }
    if (party.joined < 2 && feed.played < 20)
        Write("Alone. Host a room from the menu to fight with friends.", float2(w - 34 * u, 110 * u), 12 * u, Color(ASH.r, ASH.g, ASH.b, 0.7), Anchor.UpperRight);
}

// The end: how many nights and how long they held out, and what each did.
[Stage(Layers.Hud, 5)]
view Ending(Match match, Lobby lobby, mut Feed feed, Devices devices, query (Survivor survivor) survivors)
{
    if (lobby.page != Page.Playing || match.phase != Phase.Over) return;
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Unit();
    feed.gameOver += Math.Min(Frame.dt, 0.05);
    var a = Math.Saturate(match.timer * 0.8);
    Draw.Rect(float2(w * 0.5, h * 0.5), float2(w, h), Color(0.02, 0, 0, 0.55 * a));
    WriteBold("GAME OVER", float2(w * 0.5, h * 0.24), 64 * u, Color(CHALK.r * 1.4, CHALK.g, CHALK.b, a), Anchor.MiddleCenter);
    var nights = match.kept == 1 ? "1 night" : $"{match.kept} nights";
    Write($"You held out {nights} and {Clock(match.lasted)}, at {DangerName(match.danger)}", float2(w * 0.5, h * 0.33), 24 * u, Color(BONE.r, BONE.g, BONE.b, a),
          Anchor.MiddleCenter);
    var top = h * 0.43;
    var columns = float4(-90, 40, 140, 240) * u;
    mut var rows = 0;
    foreach (var r in survivors)
        if (r.survivor.ready) rows += 1;
    if (a > 0.5) Panel(float2(w * 0.5 - 20 * u, top + rows * 16 * u + 2 * u), float2(640 * u, (rows + 1) * 32 * u + 28 * u), u);
    Draw.Shape(Shape { center = float2(w * 0.5, h * 0.24), size = float2(560, 80) * u, ellipse = true, color = Color(0.6, 0.04, 0.02, 0.3 * a), soft = 80 * u });
    Write("Kills", float2(w * 0.5 + columns.x, top), 14 * u, Color(ASH.r, ASH.g, ASH.b, a), Anchor.MiddleCenter);
    Write("Heads", float2(w * 0.5 + columns.y, top), 14 * u, Color(ASH.r, ASH.g, ASH.b, a), Anchor.MiddleCenter);
    Write("Downs", float2(w * 0.5 + columns.z, top), 14 * u, Color(ASH.r, ASH.g, ASH.b, a), Anchor.MiddleCenter);
    Write("Raised", float2(w * 0.5 + columns.w, top), 14 * u, Color(ASH.r, ASH.g, ASH.b, a), Anchor.MiddleCenter);
    mut var row = 1;
    foreach (var r in survivors)
    {
        var s = r.survivor;
        if (!s.ready) continue;
        var y = top + row * 32 * u;
        Write(HeroName(s.seat), float2(w * 0.5 - 300 * u, y), 18 * u, Color(HeroColor(s.seat).r, HeroColor(s.seat).g, HeroColor(s.seat).b, a), Anchor.MiddleLeft);
        Write(RoleName(s.role), float2(w * 0.5 - 170 * u, y), 15 * u, Color(ASH.r, ASH.g, ASH.b, a), Anchor.MiddleCenter);
        Write($"{s.kills}", float2(w * 0.5 + columns.x, y), 18 * u, Color(BONE.r, BONE.g, BONE.b, a), Anchor.MiddleCenter);
        Write($"{s.headshots}", float2(w * 0.5 + columns.y, y), 18 * u, Color(BONE.r, BONE.g, BONE.b, a), Anchor.MiddleCenter);
        Write($"{s.downs}", float2(w * 0.5 + columns.z, y), 18 * u, Color(BONE.r, BONE.g, BONE.b, a), Anchor.MiddleCenter);
        Write($"{s.revives}", float2(w * 0.5 + columns.w, y), 18 * u, Color(BONE.r, BONE.g, BONE.b, a), Anchor.MiddleCenter);
        row += 1;
    }
    if (match.timer > 3)
    {
        Write("Press E to rise again", float2(w * 0.5, h * 0.8), 20 * u, Color(GOLD.r, GOLD.g, GOLD.b, 0.6 + Math.Sin(feed.gameOver * 3) * 0.3), Anchor.MiddleCenter);
        if (devices.keyboard.e.down || devices.keyboard.enter.down || devices.gamepad.buttonSouth.down) Send(Restart { });
    }
}

// Development keys, not in play's interface: F2 six of the next kind of the dead (Bloaters, Spitters, Wardens in turn),
// F3 a boss (the Mauler, the Broodmother, the Stalker in turn), F4 a horde of two thousand more, F5 a level (and so an
// offer), F6 a walk to the next place, F7 the night kept (dawn), F10 an item.
local singleton DevWalk
{
    int next;
    int kind;
    int boss;
}

[Stage(Layers.Hud, 21)]
view DevKeys(Devices devices, Lobby lobby, mut DevWalk walk)
{
    if (!lobby.playing) return;
    var keys = devices.keyboard;
    if (keys.f2.down)
    {
        Send(Cheat { what = 20 + walk.kind });
        walk.kind = (walk.kind + 1) % 3;
    }
    if (keys.f7.down) Send(Cheat { what = 8 });
    if (keys.f3.down)
    {
        Send(Cheat { what = 30 + walk.boss });
        walk.boss = (walk.boss + 1) % BOSS_KINDS;
    }
    if (keys.f4.down) Send(Cheat { what = 3 });
    if (keys.f5.down) Send(Cheat { what = 4 });
    if (keys.f10.down) Send(Cheat { what = 5 });
    if (keys.f6.down)
    {
        walk.next = (walk.next + 1) % 8;
        Send(Cheat { what = 10 + walk.next });
    }
}

// A new game from the menu starts over at the first night.
[Stage(Layers.Hud, 20)]
view Menus(Lobby lobby)
{
    if (lobby.newGame) Send(Restart { });
}

// The menu's button in the top left, out of the round's way.
override Rect Rooms.MenuButton(float2 screen)
{
    return Rect(8, 8, 84, 36);
}

// The title's words, over the picture (TitlePage's own drawing would be under it: the picture is brought to the window
// after the package's views).
[Stage(Layers.Hud, -1)]
view TitleCard(Lobby lobby)
{
    if (lobby.page != Page.Title) return;
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Math.Max(0.6, h / 720);
    var left = 84 * u;
    // A dark band behind the words, fading out to the right
    List<Vertex> band = [Vertex { position = float2(0, 0), color = Color(0, 0, 0, 0.7) }, Vertex { position = float2(w * 0.62, 0), color = Color(0, 0, 0, 0) },
                         Vertex { position = float2(w * 0.62, h), color = Color(0, 0, 0, 0) }, Vertex { position = float2(0, h), color = Color(0, 0, 0, 0.7) }];
    List<int> faces = [0, 1, 2, 0, 2, 3];
    Draw.Mesh(band, faces);
    Draw.Shape(Shape { center = float2(left + 260 * u, h * 0.3), size = float2(520, 90) * u, ellipse = true, color = Color(0.6, 0.06, 0.03, 0.35), soft = 90 * u });
    Draw.Text("GRAVEWAKE", float2(left + 4 * u, h * 0.3 + 5 * u), 96 * u, Color(0, 0, 0, 0.85), Anchor.MiddleLeft, Font.Bold);
    Draw.Text("GRAVEWAKE", float2(left, h * 0.3), 96 * u, Color(0.62, 0.05, 0.04), Anchor.MiddleLeft, Font.Bold);
    Draw.Text("GRAVEWAKE", float2(left + 1.5 * u, h * 0.3 - 1.5 * u), 96 * u, Color(0.78, 0.1, 0.07, 0.45), Anchor.MiddleLeft, Font.Bold);
    Draw.Shape(Shape { center = float2(left + 230 * u, h * 0.3 + 112 * u), size = float2(460 * u, 2 * u), color = Color(0.9, 0.35, 0.12, 0.8), soft = 4 * u });
    Draw.Text("Ashwick burned. Hold the fire in the wood as long as you can.", float2(left + 4 * u, h * 0.3 + 64 * u), 20 * u, Color(0.85, 0.8, 0.72),
              Anchor.MiddleLeft);
    Draw.Text("Night after night: find the beacon, light it, hold it till dawn. Thousands of the dead, items that stack  -  for one to four",
              float2(left + 4 * u, h * 0.3 + 92 * u), 15 * u,
              Color(0.6, 0.57, 0.52), Anchor.MiddleLeft);
    if (lobby.message != "") Draw.Text(lobby.message, float2(left + 4 * u, h * 0.86), 15 * u, Color(0.9, 0.5, 0.4), Anchor.MiddleLeft);
    // The licence the first-person arms come under asks for their maker's name
    Draw.Text("First-person arms by CoinCoin (CC BY 4.0). Forest, ruins, people and guns by Quaternius (CC0).", float2(w - 14 * u, h - 12 * u), 11 * u,
              Color(0.6, 0.57, 0.52, 0.7), Anchor.LowerRight);
}

// The title: GRAVEWAKE in blood over the clearing at night, and the way in.
override void Rooms.TitlePage(Session session, mut Lobby lobby)
{
    var connected = session.state == SessionState.Connected;
    var h = Screen.height;
    var u = Math.Max(0.6, h / 720);
    var left = 84 * u;
    mut var play = false;
    mut var host = false;
    var y = h * 0.3 + 140 * u;
    var size = float2(290 * u, 46 * u);
    GUI.Theme(GUITheme { text = Color(0.92, 0.88, 0.8), control = Color(0.1, 0.05, 0.04, 0.88), hot = Color(0.42, 0.07, 0.05), pressed = Color(0.6, 0.1, 0.06),
                         accent = Color(0.8, 0.15, 0.1), panel = Color(0, 0, 0, 0), radius = 3 })
    {
        GUI.Disabled(!connected)
        {
            play = GUI.Button(Rect(left, y, size.x, size.y), "Play");
            host = GUI.Button(Rect(left, y + 56 * u, size.x, size.y), "Host a room");
        }
        var join = GUI.Button(Rect(left, y + 112 * u, size.x, size.y), "Join a room");
        var settings = GUI.Button(Rect(left, y + 168 * u, size.x, size.y), "Settings");
        if (join) ShowJoin(lobby);
        if (settings) ShowSettings(lobby);
    }
    if (play) Play(lobby);
    if (host) Host(lobby);
}

override string Rooms.Tagline()
{
    return "Ashwick burned. Hold the fire in the wood as long as you can.";
}

// ---- What the feed hears ----

local event(Struck struck) ShowMarker(mut Feed feed, Me me)
{
    if (struck.seat != me.seat || struck.seat < 0 || struck.blow == Blow.Shove) return;
    // Fire and bleeding wear them down quietly; only the kill shows
    if (!struck.killed && (struck.blow == Blow.Burning || struck.blow == Blow.Bleeding)) return;
    feed.marker = struck.head ? 0.35 : 0.25;
    feed.markerKill = struck.killed;
    feed.markerHead = struck.head;
    feed.markerCrit = struck.crit;
    feed.markerWeak = struck.weak;
    feed.markerMail = struck.mail && !struck.killed;
    if (struck.head && struck.killed) feed.headshot = 0.9;
}

// A blow taken, for the arc that says where it came from.
local event(Hurt hurt) ShowHurt(mut Feed feed, Survivor survivor, Me me)
{
    if (survivor.seat != me.seat) return;
    feed.blows.Add(hurt.from);
    feed.blowAges.Add(0);
    if (feed.blows.count > 8)
    {
        feed.blows.RemoveAt(0);
        feed.blowAges.RemoveAt(0);
    }
}

// An item taken: this machine's own as a banner, the others' as a line in the corner.
local event(Picked picked) ShowPicked(mut Feed feed, Me me)
{
    var title = ItemName(picked.item);
    if (picked.seat == me.seat)
    {
        feed.banner = title.ToUpper();
        feed.bannerLeft = 2.4;
        feed.bannerColor = RarityColor(RarityOf(picked.item));
        return;
    }
    feed.news.Add($"{HeroName(picked.seat)} took {title}");
    feed.newsAge.Add(0);
}

local event(Levelled levelled) ShowLevel(mut Feed feed)
{
    if (feed.bannerLeft > 1) return;
    feed.banner = $"LEVEL {levelled.level}";
    feed.bannerLeft = 1.8;
    feed.bannerColor = Color(0.6, 0.85, 1.0);
}

Color RarityColor(Rarity rarity)
{
    switch (rarity)
    {
        case Rarity.Uncommon: return Color(0.45, 0.9, 0.45);
        case Rarity.Rare: return Color(0.95, 0.35, 0.3);
    }
    return Color(0.9, 0.88, 0.84);
}

string RarityName(Rarity rarity)
{
    switch (rarity)
    {
        case Rarity.Uncommon: return "Uncommon";
        case Rarity.Rare: return "Rare";
    }
    return "Common";
}

// A card: a shadow and a glow of its colour under it, dark glass, its colour along its top fading down, a fine edge.
void Card(float2 middle, float2 size, Color tint, float a, float u)
{
    Draw.Shape(Shape { center = middle + float2(0, 8 * u), size = size, radius = 10 * u, color = Color(0, 0, 0, 0.55 * a), soft = 24 * u });
    Draw.Shape(Shape { center = middle, size = size, radius = 10 * u, color = Color(tint.r, tint.g, tint.b, 0.1 * a), soft = 16 * u });
    Draw.Shape(Shape { center = middle, size = size, radius = 10 * u, color = Color(0.1, 0.075, 0.065, 0.95 * a), color2 = Color(0.03, 0.022, 0.02, 0.97 * a) });
    Draw.Shape(Shape { center = middle - float2(0, size.y * 0.5 - 40 * u), size = float2(size.x, 80 * u), radius = 10 * u, color = Color(tint.r, tint.g, tint.b, 0.22 * a),
                       color2 = Color(tint.r, tint.g, tint.b, 0) });
    Draw.Shape(Shape { center = middle, size = size, radius = 10 * u, color = Color.none, outline = 1.5 * u, outlineColor = Color(tint.r, tint.g, tint.b, 0.75 * a) });
}

// An item's mark: a rounded square in its rarity's colour, with two letters of its name.
void DrawItemMark(Item item, float2 at, float size, float a)
{
    var tint = RarityColor(RarityOf(item));
    Draw.RoundRect(at, float2(size, size), size * 0.2, Color(0.06, 0.05, 0.05, 0.85 * a));
    Draw.WireRoundRect(at, float2(size, size) * 0.92, size * 0.18, Math.Max(1, size * 0.06), Color(tint.r, tint.g, tint.b, 0.9 * a));
    var name = ItemName(item);
    var words = name.Split(" ");
    var letters = words.count > 1 ? $"{words[0].Substring(0, 1)}{words[1].Substring(0, 1)}" : name.Substring(0, 2);
    WriteBold(letters, at, size * 0.42, Color(tint.r, tint.g, tint.b, a), Anchor.MiddleCenter);
}

// Text in lines no wider than `width`, broken between words, its first line's middle at `at`.
void WriteWrapped(string text, float2 at, float width, float size, Color tint)
{
    var words = text.Split(" ");
    mut var line = "";
    mut var y = at.y;
    foreach (var word in words)
    {
        var tried = line == "" ? word : $"{line} {word}";
        if (line != "" && Draw.MeasureText(tried, size).x > width)
        {
            Write(line, float2(at.x, y), size, tint, Anchor.MiddleCenter);
            y += size * 1.3;
            line = word;
        }
        else
        {
            line = tried;
        }
    }
    if (line != "") Write(line, float2(at.x, y), size, tint, Anchor.MiddleCenter);
}

// The items at a level: the run waits (rounds.tide's Pause) while three cards across the middle are offered, taken with
// 1, 2 or 3; and for one who has chosen, who it's still waiting for.
[Stage(Layers.Hud, 2)]
view Offers(Me me, Lobby lobby, mut Feed feed, Match match, query (Survivor survivor) survivors)
{
    if (lobby.page != Page.Playing || match.phase == Phase.Over) return;
    mut var mine = Survivor { };
    mut var found = false;
    mut var waiting = "";
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (s.seat == me.seat)
        {
            mine = s;
            found = true;
        }
        else if (s.ready && s.choosing)
        {
            waiting = waiting == "" ? HeroName(s.seat) : $"{waiting}, {HeroName(s.seat)}";
        }
    }
    if (!found || (!mine.choosing && !match.paused))
    {
        feed.dealt = 0;
        return;
    }
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Unit();
    Draw.Rect(float2(w * 0.5, h * 0.5), float2(w, h), Color(0, 0, 0, 0.45));
    if (!mine.choosing)
    {
        feed.dealt = 0;
        WriteBold($"Waiting for {waiting} to choose", float2(w * 0.5, h * 0.4), 22 * u, BONE, Anchor.MiddleCenter);
        return;
    }
    feed.dealt += Math.Min(Frame.dt, 0.05);
    var more = mine.pending > 0 ? $"  ({mine.pending} more to come)" : "";
    WriteBold("LEVEL UP", float2(w * 0.5, h * 0.17), 36 * u, Color(0.65, 0.85, 1.0), Anchor.MiddleCenter);
    Write($"Take one{more}", float2(w * 0.5, h * 0.17 + 32 * u), 15 * u, ASH, Anchor.MiddleCenter);
    var size = float2(232, 270) * u;
    for (var k = 0; k < 3; k++)
    {
        var rise = Math.SmoothStep(0, 1, Math.Saturate(feed.dealt * 4 - k * 0.3));
        var middle = float2(w * 0.5 + (k - 1) * (size.x + 26 * u), h * 0.5 + (1 - rise) * 40 * u);
        var item = mine.offers[k];
        var rarity = RarityOf(item);
        var tint = RarityColor(rarity);
        var a = rise;
        Card(middle, size, tint, a, u);
        var key = middle + float2(0, -size.y * 0.5 + 24 * u);
        Draw.Shape(Shape { center = key, size = float2(30, 30) * u, radius = 15 * u, color = Color(0.05, 0.04, 0.04, 0.9 * a), outline = 1.5 * u,
                           outlineColor = Color(tint.r, tint.g, tint.b, 0.9 * a) });
        WriteBold($"{k + 1}", key, 16 * u, Color(BONE.r, BONE.g, BONE.b, a), Anchor.MiddleCenter);
        Draw.Shape(Shape { center = middle + float2(0, -40 * u), size = float2(60, 60) * u, radius = 30 * u, color = Color(tint.r, tint.g, tint.b, 0.16 * a), soft = 22 * u });
        DrawItemMark(item, middle + float2(0, -40 * u), 60 * u, a);
        var have = mine.items[int(item)];
        Write(have > 0 ? $"{RarityName(rarity).ToUpper()}  -  YOU HAVE {have}" : RarityName(rarity).ToUpper(), middle + float2(0, 8 * u), 11 * u, Color(ASH.r, ASH.g, ASH.b, a),
              Anchor.MiddleCenter);
        WriteBold(ItemName(item), middle + float2(0, 32 * u), 21 * u, Color(tint.r, tint.g, tint.b, a), Anchor.MiddleCenter);
        WriteWrapped(ItemLine(item), middle + float2(0, 62 * u), size.x - 34 * u, 13 * u, Color(BONE.r, BONE.g, BONE.b, 0.85 * a));
    }
    Write("1, 2 or 3   (pad: d-pad left, up, right)", float2(w * 0.5, h * 0.5 + size.y * 0.5 + 26 * u), 13 * u, Color(ASH.r, ASH.g, ASH.b, 0.8), Anchor.MiddleCenter);
}

// A boss's health across the top: the nearest of them, if any is about.
[Stage(Layers.Hud, 4)]
view BossBar(Lobby lobby, Look look, mut Feed feed, query (Boss boss) bosses)
{
    if (lobby.page != Page.Playing) return;
    mut var found = false;
    mut var nearest = 1000.0;
    mut var shown = Boss { };
    foreach (var row in bosses)
    {
        var b = row.boss;
        if (b.move == BossMove.Dying) continue;
        var far = Math.Distance(b.at, look.eye);
        if (far < nearest)
        {
            nearest = far;
            shown = b;
            found = true;
        }
    }
    if (!found) return;
    Draw.SetScreen();
    var w = Screen.width;
    var u = Unit();
    var at = float2(w * 0.5, 62 * u);
    var width = 560 * u;
    var share = Math.Saturate(shown.health / Math.Max(1, shown.healthMost));
    feed.bossTrail = share > feed.bossTrail ? share : Math.Max(share, feed.bossTrail - Math.Min(Frame.dt, 0.05) * 0.25);
    Draw.Shape(Shape { center = at - float2(0, 8 * u), size = float2(width + 120 * u, 70 * u), radius = 30 * u, color = Color(0, 0, 0, 0.35), soft = 30 * u });
    var m = MutantOf(shown.kind);
    WriteBold(m.name, at - float2(0, 24 * u), 20 * u, Color(0.98, 0.32, 0.2), Anchor.MiddleCenter);
    Write($"Weak spot: {m.hint.ToLower()}", at + float2(0, 22 * u), 12 * u, Color(1.0, 0.75, 0.4, 0.85), Anchor.MiddleCenter);
    Bar(at - float2(width * 0.5, 0), float2(width, 12 * u), share, feed.bossTrail, Color(0.85, 0.12, 0.08), Color(0.45, 0.03, 0.02), 10, u);
    // A spike at each end
    Draw.Shape(Shape { center = at - float2(width * 0.5 + 14 * u, 0), size = float2(12, 12) * u, rotation = Math.PI * 0.25, color = Color(0.85, 0.12, 0.08) });
    Draw.Shape(Shape { center = at + float2(width * 0.5 + 14 * u, 0), size = float2(12, 12) * u, rotation = Math.PI * 0.25, color = Color(0.85, 0.12, 0.08) });
}

local event(BossCame came) ShowBoss(mut Feed feed)
{
    feed.banner = came.vigil ? $"{MutantOf(came.kind).name} CLAWS UP" : "THE NIGHT GROWS IMPATIENT";
    feed.bannerLeft = 3;
    feed.bannerColor = Color(0.95, 0.3, 0.2);
}

local event(BossFelled felled) ShowFelled(mut Feed feed)
{
    if (feed.bannerLeft > 2) return;
    feed.banner = "IT FALLS";
    feed.bannerLeft = 2.6;
    feed.bannerColor = Color(0.95, 0.82, 0.45);
}

// Before the first night (or on joining), the three survivors: 1, 2 or 3.
[Stage(Layers.Hud, 3)]
view Callings(Me me, Lobby lobby, Match match, query (Survivor survivor) survivors)
{
    if (lobby.page != Page.Playing) return;
    mut var mine = Survivor { };
    mut var found = false;
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found || !mine.ready) return;
    if (mine.role != Role.None)
    {
        // Picked: the breath before the dead come
        if (match.phase != Phase.Waiting) return;
        Draw.SetScreen();
        var left = START_SECONDS - match.timer;
        WriteBold(left > START_SECONDS - 0.05 ? "Waiting for the others to pick" : $"The dead come in {int(Math.Ceil(Math.Max(0, left)))}", float2(Screen.width * 0.5, Screen.height * 0.3),
                  26 * Unit(), BONE, Anchor.MiddleCenter);
        return;
    }
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var u = Unit();
    Draw.Rect(float2(w * 0.5, h * 0.5), float2(w, h), Color(0, 0, 0, 0.45));
    WriteBold("CHOOSE YOUR SURVIVOR", float2(w * 0.5, h * 0.14), 36 * u, Color(CHALK.r * 1.5, CHALK.g * 1.5, CHALK.b, 1), Anchor.MiddleCenter);
    Write("A gun you aim, and three skills: right mouse, Shift and Q", float2(w * 0.5, h * 0.14 + 34 * u), 15 * u, ASH, Anchor.MiddleCenter);
    var size = float2(270, 360) * u;
    for (var k = 0; k < 3; k++)
    {
        var role = Role(k + 1);
        var middle = float2(w * 0.5 + (k - 1) * (size.x + 22 * u), h * 0.55);
        var tint = k == 0 ? Color(0.95, 0.75, 0.35) : k == 1 ? Color(0.9, 0.45, 0.35) : Color(0.5, 0.8, 0.95);
        Card(middle, size, tint, 1, u);
        var top = middle.y - size.y * 0.5;
        var key = float2(middle.x, top + 32 * u);
        Draw.Shape(Shape { center = key, size = float2(32, 32) * u, radius = 16 * u, color = Color(0.05, 0.04, 0.04, 0.9), outline = 1.5 * u, outlineColor = tint });
        WriteBold($"{k + 1}", key, 17 * u, BONE, Anchor.MiddleCenter);
        WriteBold(RoleName(role).ToUpper(), float2(middle.x, top + 76 * u), 26 * u, tint, Anchor.MiddleCenter);
        Write(Info(RoleWeapon(role)).name, float2(middle.x, top + 104 * u), 15 * u, GOLD, Anchor.MiddleCenter);
        for (var s = 0; s < 3; s++)
        {
            var key2 = s == 0 ? "RMB" : s == 1 ? "Shift" : "Q";
            Write($"{key2}  {SkillName(SkillOf(role, s))}", float2(middle.x, top + 132 * u + s * 20 * u), 13 * u, BONE, Anchor.MiddleCenter);
        }
        WriteWrapped(RoleLine(role), float2(middle.x, top + 214 * u), size.x - 36 * u, 13 * u, Color(ASH.r, ASH.g, ASH.b, 0.95));
    }
    Write("1, 2 or 3   (pad: d-pad left, up, right)", float2(w * 0.5, h * 0.55 + size.y * 0.5 + 24 * u), 13 * u, Color(ASH.r, ASH.g, ASH.b, 0.8), Anchor.MiddleCenter);
}
