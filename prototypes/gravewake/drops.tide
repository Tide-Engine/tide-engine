// What the match says is heard, where (each machine plays it); and a survivor's guns loaded and skills ready, for one
// back at the fire. (The dead dropped power-ups once: a recharge, a skull that killed at a touch, holy fire that killed
// every one of them; the owner: "that ability that kills everything should maybe go; in general i dont like the drops
// from zombies being random abilities". They're gone; items come from levels and chests.)

enum Sfx { Rise, Snarl, Revive, Downed, Hurt, Empty, Throw, Mine, Shell, BossRoar, BossCharge, BossDeath, Swell }

event Cue
{
    Sfx sound;
    float3 at;
}

// Every gun loaded and every skill ready.
void Refill(mut Survivor survivor)
{
    if (survivor.role == Role.None) return;
    if (survivor.gun == Weapon.Pistol) survivor.stowed = MagOf(survivor, RoleWeapon(survivor.role));
    survivor.mag = MagOf(survivor, survivor.gun);
    for (var i = 0; i < 3; i++) survivor.cooldowns[i] = 0;
    survivor.dashes = DASHES;
    survivor.dashWait = 0;
}
