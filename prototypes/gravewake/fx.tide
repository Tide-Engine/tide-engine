// What flares and spatters: tracers and muzzle flashes, blood from a hit,
// sparks off stone, the flames of torches and braziers and of the dead that
// burn, earth thrown up by a riser, bursts, frost, lightning, the ember ring,
// smoke. All of it is
// this machine's: motes in local lists, made by what the match's events say
// and by the frame, and drawn as soft quads that face the eye.

// A mote: a soft quad facing the eye.
struct Mote
{
    float3 at;
    float3 velocity;
    float age;
    float life = 1;
    float size = 0.1;
    float grow;               // Metres a second its size changes by
    float3 color = float3(1); // Light, for glowing ones; paint, for the others
    float gravity;
    float drag;
    float alpha = 1;
    float cool;               // How far a glowing one goes toward a dull red over its life (a flame's cooling)
    float stain;              // Blood or bile: where it lands it soaks into the ground, a stain so wide (gore.tide)
}

// A streak between two places, facing the eye: a tracer, lightning.
struct Streak
{
    float3 from;
    float3 to;
    float age;
    float life = 0.2;
    float width = 0.05;
    float3 color = float3(1);
}

// A moment's light: a muzzle's flash, a blast. It lights what's round it as a lamp does, fading over its life.
struct Flash
{
    float3 at;
    float3 color;
    float reach;
    float age;
    float life = 0.06;
}

// What a mote or a streak is drawn with, per instance.
struct Sprite
{
    float3 at;
    float3 to;                // A streak's other end (a mote's is its own place)
    float size;
    float4 color;             // Light and how much of it, or paint and how solid
}

local singleton Fx
{
    List<Mote> glow;          // Added light: fire, sparks, magic
    List<Mote> murk;          // Laid over: blood, smoke, earth, splinters
    List<Streak> streaks;
    List<Flash> flashes;
    List<Sprite> glowSprites;
    List<Sprite> murkSprites;
    List<Sprite> streakSprites;
    List<Sprite> orbSprites;     // The experience orbs, gathered each frame (orbs.tide)
    List<Corner> quad;
    List<int> quadFaces;
    float emberClock;
    float blasts;             // How many blasts lately (each 1, gone over a second and a half): many at once, each less
    Random random;
    bool made;
}

const int GLOW_MOST = 1400;
const int MURK_MOST = 2600;

void Glow(mut Fx fx, Mote mote)
{
    if (fx.glow.count < GLOW_MOST) fx.glow.Add(mote);
}

void Murk(mut Fx fx, Mote mote)
{
    if (fx.murk.count < MURK_MOST) fx.murk.Add(mote);
}

float3 Scatter(mut Fx fx, float speed)
{
    return fx.random.NextFloat3Direction() * fx.random.NextFloat(speed * 0.3, speed);
}

// A quad's corners facing the eye: a mote's square, or a streak's length.
vert Face(mut Corner corner, Sprite sprite, Look look)
{
    var toEye = Math.Normalize(look.eye - sprite.at);
    var along = sprite.to - sprite.at;
    if (Math.Length(along) > 0.0001)
    {
        var across = Math.Normalize(Math.Cross(along, toEye)) * sprite.size;
        corner.position = sprite.at + along * (corner.position.y * 0.5 + 0.5) + across * corner.position.x;
    }
    else
    {
        var right = Math.Normalize(Math.Cross(float3(0, 1, 0), toEye));
        var up = Math.Cross(toEye, right);
        corner.position = sprite.at + (right * corner.position.x + up * corner.position.y) * sprite.size;
    }
}

frag GlowMote(Corner corner, out Color color, Sprite sprite, Look look)
{
    var off = corner.uv * 2 - float2(1);
    var soft = Math.Saturate(1 - Math.Dot(off, off));
    var light = float3(sprite.color.x, sprite.color.y, sprite.color.z) * sprite.color.w * soft * soft;
    var far = Math.Distance(sprite.at, look.eye);
    color = Color(light * Math.Exp(-far * look.fog * 0.6) * Math.Saturate((far - 0.4) / 1.5), 1);
}

frag MurkMote(Corner corner, out Color color, Sprite sprite, Look look, Lights lights)
{
    var off = corner.uv * 2 - float2(1);
    var edge = Math.Dot(off, off) + Math.Perlin(corner.uv * 5 + float2(sprite.size * 40)) * 0.35;
    if (edge > 1) this.Discard();
    var paint = Linear(float3(sprite.color.x, sprite.color.y, sprite.color.z));
    var lit = paint * (look.skyLight * 2 + look.moonColor * 0.5 + LampLight(lights.list, sprite.at, Math.Normalize(look.eye - sprite.at)));
    // Smoke and dust by the eye thin away, so they never cover the picture
    var near = Math.Saturate((Math.Distance(sprite.at, look.eye) - 1.0 - sprite.size) / 3.5);
    color = Color(Hazed(lit, sprite.at, look), sprite.color.w * near);
}

frag StreakLight(Corner corner, out Color color, Sprite sprite)
{
    var across = Math.Abs(corner.uv.x * 2 - 1);
    var core = Math.Saturate(1 - across);
    color = Color(float3(sprite.color.x, sprite.color.y, sprite.color.z) * sprite.color.w * core * core, 1);
}

void MakeQuad(mut Fx fx)
{
    fx.quad.Clear();
    fx.quadFaces.Clear();
    fx.quad.Add(Corner { position = float3(-1, -1, 0), uv = float2(0, 1) });
    fx.quad.Add(Corner { position = float3(1, -1, 0), uv = float2(1, 1) });
    fx.quad.Add(Corner { position = float3(1, 1, 0), uv = float2(1, 0) });
    fx.quad.Add(Corner { position = float3(-1, 1, 0), uv = float2(0, 0) });
    fx.quadFaces.Add(0);
    fx.quadFaces.Add(2);
    fx.quadFaces.Add(1);
    fx.quadFaces.Add(0);
    fx.quadFaces.Add(3);
    fx.quadFaces.Add(2);
    fx.made = true;
}

// Each frame: what burns gives off flames, and every mote moves on.
[Stage(Layers.Gather, 2)]
view Flicker(mut Fx fx, mut Gore gore, Me me, Village village, query (Zombie zombie) zombies, query (Missile missile) missiles,
             query (Survivor survivor) survivors, query (Boss boss) bosses)
{
    if (!fx.made) MakeQuad(fx);
    var dt = me.dt;
    fx.emberClock += dt;
    // Torches and the fires
    if (fx.emberClock > 0.045)
    {
        fx.emberClock = 0;
        foreach (var at in village.plan.torches)
        {
            if (Math.Distance(at, me.eye) > 40) continue;
            Glow(fx, Mote { at = at + float3(fx.random.NextFloat(-0.05, 0.05), 0.05, fx.random.NextFloat(-0.05, 0.05)), velocity = float3(0, 0.7, 0),
                            life = fx.random.NextFloat(0.3, 0.5), size = 0.12, grow = -0.15, color = float3(1.0, 0.5, 0.15), alpha = 2.4, cool = 1 });
        }
        foreach (var at in village.plan.fires)
        {
            if (Math.Distance(at, me.eye) > 50) continue;
            for (var k = 0; k < 3; k++)
                Glow(fx, Mote { at = at + float3(fx.random.NextFloat(-0.3, 0.3), 1.4, fx.random.NextFloat(-0.3, 0.3)), velocity = float3(0, 1.2, 0),
                                life = fx.random.NextFloat(0.3, 0.6), size = 0.2, grow = -0.25, color = float3(1.0, 0.5, 0.14), alpha = 1.3, cool = 1 });
            Glow(fx, Mote { at = at + float3(0, 1.6, 0), velocity = float3(fx.random.NextFloat(-0.3, 0.3), 2.2, fx.random.NextFloat(-0.3, 0.3)),
                            life = 1.6, size = 0.025, color = float3(1.0, 0.6, 0.2), alpha = 4, drag = 0.4 });
        }
        foreach (var row in zombies)
        {
            var z = row.zombie;
            if (z.burn <= 0 || z.state == ZombieState.Dying || Math.Distance(z.at, me.eye) > 40) continue;
            for (var k = 0; k < 2; k++)
                Glow(fx, Mote { at = z.at + float3(fx.random.NextFloat(-0.25, 0.25), fx.random.NextFloat(0.3, 1.7), fx.random.NextFloat(-0.25, 0.25)),
                                velocity = float3(0, 1.2, 0), life = 0.45, size = 0.18, grow = -0.25, color = float3(1.0, 0.4, 0.08), alpha = 2 });
        }
        // The ember rings, round their survivors
        foreach (var row in survivors)
        {
            var s = row.survivor;
            var embers = Has(s, Item.EmberRing);
            if (embers == 0 || s.life != Life.Standing || Math.Distance(s.feet, me.eye) > 40) continue;
            var reach = 3 + 0.5 * embers;
            for (var k = 0; k < 3; k++)
            {
                var turn = fx.random.NextFloat(Math.TAU);
                var at = s.feet + float3(Math.Cos(turn) * reach * fx.random.NextFloat(0.5, 1), 0.1, Math.Sin(turn) * reach * fx.random.NextFloat(0.5, 1));
                Glow(fx, Mote { at = at, velocity = float3(-Math.Sin(turn), 0.8, Math.Cos(turn)) * 0.8, life = 0.6, size = 0.06, color = float3(1.0, 0.4, 0.08), alpha = 2.5 });
            }
        }
    }
    foreach (var row in missiles)
    {
        var m = row.missile;
        if (m.kind == Shot.Pot) Glow(fx, Mote { at = m.at + float3(0, 0.12, 0), life = 0.15, size = 0.1, color = float3(1.0, 0.5, 0.15), alpha = 3 });
        if (m.kind == Shot.Grenade) Glow(fx, Mote { at = m.at, life = 0.08, size = 0.04, color = float3(1.0, 0.3, 0.1), alpha = 2 });
        if (m.kind == Shot.Shell) Glow(fx, Mote { at = m.at + float3(0, 0.6, 0), life = 0.2, size = 0.12, color = float3(1.0, 0.6, 0.3), alpha = 2 });
        if (m.kind == Shot.Mine && m.age >= MINE_ARMS && Math.Frac(me.clock * 2) < 0.2)
            Glow(fx, Mote { at = m.at + float3(0, 0.1, 0), life = 0.05, size = 0.12, color = float3(1.0, 0.15, 0.1), alpha = 3 });
        // A Spitter's bile: a glowing gob, dripping
        if (m.kind == Shot.Spit)
        {
            Glow(fx, Mote { at = m.at, life = 0.12, size = 0.16, color = float3(0.7, 0.95, 0.15), alpha = 2.2 });
            if (fx.random.NextFloat() < 0.5)
                Murk(fx, Mote { at = m.at, velocity = Scatter(fx, 0.5), life = 0.5, size = 0.04, gravity = 8, color = float3(0.3, 0.34, 0.06), alpha = 1 });
        }
    }
    // A boss's warnings: a ring of red where a slam comes down, filling in as it comes; a line where a charge runs
    foreach (var row in bosses)
    {
        var b = row.boss;
        var mauler = b.kind == BossKind.Mauler;
        if (b.move == BossMove.SlamWindup || b.move == BossMove.LeapWindup)
        {
            var leap = b.move == BossMove.LeapWindup;
            var fill = Math.Saturate(b.timer / (leap ? LEAP_WINDUP : mauler ? SLAM_WINDUP : SWIPE_WINDUP));
            var ring = leap ? LEAP_RADIUS : mauler ? SLAM_RADIUS : SWIPE_RADIUS;
            for (var k = 0; k < 10; k++)
            {
                var turn = fx.random.NextFloat(Math.TAU);
                var r = ring * (k < 6 ? 1.0 : fx.random.NextFloat(0, fill));
                var at = b.aim + float3(Math.Cos(turn) * r, 0, Math.Sin(turn) * r);
                Glow(fx, Mote { at = On(at.x, at.z) + float3(0, 0.08, 0), life = 0.12, size = 0.18, color = float3(1.0, 0.12, 0.05), alpha = 2.5 });
            }
        }
        if (b.move == BossMove.ChargeWindup)
        {
            for (var k = 0; k < 8; k++)
            {
                var along = fx.random.NextFloat(1, CHARGE_SPEED * CHARGE_SECONDS);
                var at = b.at + b.aim * along;
                Glow(fx, Mote { at = On(at.x, at.z) + float3(0, 0.08, 0), life = 0.12, size = 0.2, color = float3(1.0, 0.2, 0.05), alpha = 2.5 });
            }
        }
        if (b.move == BossMove.Charge)
            Murk(fx, Mote { at = b.at + float3(fx.random.NextFloat(-1, 1), 0.2, fx.random.NextFloat(-1, 1)), velocity = Scatter(fx, 1.5) + float3(0, 1, 0), life = 0.8,
                            size = 0.5, grow = 0.8, color = float3(0.17, 0.14, 0.11), alpha = 0.6, drag = 2 });
        // A birth coming, a volley, a shriek: the weak spot's glow spilling out of it
        if (b.move == BossMove.Birth || b.move == BossMove.VolleyWindup || b.move == BossMove.Shriek)
        {
            var m = MutantOf(b.kind);
            var spot = b.at + Math.Rotate(quaternion.AxisAngle(float3(0, 1, 0), b.yaw), m.weak * m.size);
            var hue = b.kind == BossKind.Stalker ? float3(1.0, 0.3, 0.25) : float3(0.7, 1.0, 0.2);
            Glow(fx, Mote { at = spot + Scatter(fx, 0.4), velocity = Scatter(fx, 1) + float3(0, 0.6, 0), life = 0.4, size = 0.12, color = hue, alpha = 2.5, drag = 2 });
        }
    }

    fx.blasts = Math.Max(0, fx.blasts - dt / 1.5);
    // Rolls: dust kicked up behind each survivor in one
    foreach (var row in survivors)
    {
        var s = row.survivor;
        if (s.roll <= 0 || !s.ready) continue;
        var back = -s.rollWay;
        Murk(fx, Mote { at = s.feet + float3(fx.random.NextFloat(-0.2, 0.2), 0.15, fx.random.NextFloat(-0.2, 0.2)), velocity = back * 2 + float3(0, 0.6, 0), life = 0.45,
                        size = 0.2, grow = 0.7, color = float3(0.17, 0.14, 0.11), alpha = 0.55, drag = 3 });
        // Kerosene: flames off them as they go
        if (Has(s, Item.Kerosene) > 0)
            for (var k = 0; k < 2; k++)
                Glow(fx, Mote { at = s.feet + float3(fx.random.NextFloat(-0.4, 0.4), fx.random.NextFloat(0.2, 1.2), fx.random.NextFloat(-0.4, 0.4)), velocity = back * 1.5 + float3(0, 1.2, 0),
                                life = 0.4, size = 0.22, grow = -0.3, color = float3(1.0, 0.45, 0.1), alpha = 1.8, cool = 1 });
    }
    // (Embers and ash drifted about the eye once, from the burning of Ashwick: specks over everything, gone for the
    // picture's sake)

    // Moving on
    for (var i = fx.glow.count - 1; i >= 0; i--)
    {
        mut var m = fx.glow[i];
        m.age += dt;
        if (m.age >= m.life)
        {
            fx.glow.RemoveAt(i);
            continue;
        }
        m.velocity.y -= m.gravity * dt;
        m.velocity *= Math.Max(0, 1 - m.drag * dt);
        m.at += m.velocity * dt;
        m.size = Math.Max(0.002, m.size + m.grow * dt);
        fx.glow[i] = m;
    }
    for (var i = fx.murk.count - 1; i >= 0; i--)
    {
        mut var m = fx.murk[i];
        m.age += dt;
        if (m.age >= m.life)
        {
            fx.murk.RemoveAt(i);
            continue;
        }
        m.velocity.y -= m.gravity * dt;
        m.velocity *= Math.Max(0, 1 - m.drag * dt);
        m.at += m.velocity * dt;
        if (m.gravity > 0)
        {
            var floor = Ground(m.at.x, m.at.z) + 0.02;
            if (m.at.y < floor)
            {
                m.at.y = floor;
                // Blood soaks in where it lands, smeared the way it was going, and is gone a moment later
                if (m.stain > 0)
                {
                    var flat = Math.Length(m.velocity.xz);
                    Stain(gore, m.at, m.stain * (1 + Math.Min(1, flat * 0.1)), 0.6, Math.Atan2(m.velocity.x, m.velocity.z), 1 + Math.Min(2.2, flat * 0.3), m.color * 0.7);
                    m.stain = 0;
                    m.life = Math.Min(m.life, m.age + 0.25);
                }
                m.velocity = float3(0);
            }
        }
        m.size = Math.Max(0.002, m.size + m.grow * dt);
        fx.murk[i] = m;
    }
    for (var i = fx.streaks.count - 1; i >= 0; i--)
    {
        mut var s = fx.streaks[i];
        s.age += dt;
        if (s.age >= s.life) fx.streaks.RemoveAt(i);
        else fx.streaks[i] = s;
    }
    for (var i = fx.flashes.count - 1; i >= 0; i--)
    {
        mut var f = fx.flashes[i];
        f.age += dt;
        if (f.age >= f.life) fx.flashes.RemoveAt(i);
        else fx.flashes[i] = f;
    }
    // Into what's drawn
    fx.glowSprites.Clear();
    fx.orbSprites.Clear();
    foreach (var m in fx.glow)
    {
        var fade = 1 - m.age / m.life;
        var tint = Math.Lerp(m.color, float3(0.75, 0.13, 0.03), Math.Saturate(m.age / m.life * m.cool));
        fx.glowSprites.Add(Sprite { at = m.at, to = m.at, size = m.size, color = float4(tint, m.alpha * fade) });
    }
    fx.murkSprites.Clear();
    foreach (var m in fx.murk)
    {
        var fade = Math.Saturate((1 - m.age / m.life) * 3);
        fx.murkSprites.Add(Sprite { at = m.at, to = m.at, size = m.size, color = float4(m.color, m.alpha * fade) });
    }
    fx.streakSprites.Clear();
    foreach (var s in fx.streaks)
    {
        var fade = 1 - s.age / s.life;
        fx.streakSprites.Add(Sprite { at = s.from, to = s.to, size = s.width, color = float4(s.color, 3 * fade) });
    }
}

// The flashes among the lamps, after the frame's lamps are chosen.
[Stage(Layers.Gather, 3)]
view FlashLights(Fx fx, mut Lights lights, Me me)
{
    foreach (var f in fx.flashes)
    {
        var fade = 1 - f.age / f.life;
        AddLight(lights, me.eye, Light { at = f.at, color = f.color * fade * fade, reach = f.reach });
    }
}

[Stage(Layers.Glass, 1)]
view DrawFx(Fx fx, Lens lens)
{
    if (!lens.made || !fx.made) return;
    lens.scene.Depth(Depth.Read),
    lens.scene.Cull(Cull.None)
    {
        if (fx.murkSprites.count > 0) lens.scene.Instanced(fx.quad, fx.quadFaces, fx.murkSprites, Face, MurkMote);
        lens.scene.Blend(Blend.Add)
        {
            if (fx.glowSprites.count > 0) lens.scene.Instanced(fx.quad, fx.quadFaces, fx.glowSprites, Face, GlowMote);
            if (fx.orbSprites.count > 0) lens.scene.Instanced(fx.quad, fx.quadFaces, fx.orbSprites, Face, GlowMote);
            if (fx.streakSprites.count > 0) lens.scene.Instanced(fx.quad, fx.quadFaces, fx.streakSprites, Face, StreakLight);
        }
    }
}

// ---- What the match's events leave ----

local event(Struck struck) Bleed(mut Fx fx)
{
    if (struck.blow == Blow.Shove) return;
    // Turned by a Warden's mail: sparks off iron, no blood
    if (struck.mail && !struck.killed)
    {
        for (var i = 0; i < 6; i++)
            Glow(fx, Mote { at = struck.at, velocity = (Math.Normalize(struck.at - struck.from) * -2 + Scatter(fx, 3)), life = 0.25, size = 0.025, color = float3(1.0, 0.85, 0.5),
                            alpha = 5, gravity = 8 });
        return;
    }
    // The way the blow went, across the ground: what comes out the far side goes on that way
    mut var away = struck.at - struck.from;
    away.y = 0;
    away = Math.Length(away) > 0.01 ? Math.Normalize(away) : float3(1, 0, 0);
    var blood = float3(0.5, 0.03, 0.03);
    var slow = struck.blow == Blow.Burning || struck.blow == Blow.Bleeding;
    mut var count = struck.killed ? 22 : 12;
    if (struck.head) count += 14;
    if (slow) count = struck.killed ? 10 : 3;
    // A kill blows it apart: a burst of blood where the blow struck, and bits of what burst
    var gib = struck.killed && !slow;
    if (gib)
    {
        count += 50;
        for (var i = 0; i < 8; i++)
            Murk(fx, Mote { at = struck.at, velocity = Scatter(fx, 1.8) + away * 1.2, life = 0.55, size = 0.35, grow = 1.2, color = float3(0.3, 0.01, 0.01), alpha = 0.75 });
        for (var i = 0; i < 18; i++)
            Murk(fx, Mote { at = struck.at, velocity = Scatter(fx, 5) + away * 2 + float3(0, 2.5, 0), life = fx.random.NextFloat(0.8, 1.4),
                            size = fx.random.NextFloat(0.07, 0.13), gravity = 10, color = float3(0.35, 0.05, 0.04), alpha = 1, stain = 0.14 });
        for (var i = 0; i < 9; i++)
            Murk(fx, Mote { at = struck.at, velocity = Scatter(fx, 4.5) + float3(0, 2.5, 0), life = fx.random.NextFloat(0.6, 1.1),
                            size = fx.random.NextFloat(0.04, 0.07), gravity = 9, color = float3(0.42, 0.36, 0.3), alpha = 1 });
        // The spray thrown on the blow's way, far, in a long fan
        for (var i = 0; i < 26; i++)
            Murk(fx, Mote { at = struck.at, velocity = away * fx.random.NextFloat(3, 9) + Scatter(fx, 1.6) + float3(0, fx.random.NextFloat(0.5, 2.5), 0),
                            life = fx.random.NextFloat(0.9, 1.5), size = fx.random.NextFloat(0.06, 0.12), gravity = 10, color = blood, alpha = 0.95, stain = 0.12 });
    }
    // The drops: out the way the blow went more than back, and every one that lands soaks in (gore.tide)
    for (var i = 0; i < count; i++)
    {
        var on = slow ? 0.0 : fx.random.NextFloat(0.5, struck.head ? 5.0 : 3.5);
        Murk(fx, Mote { at = struck.at, velocity = Scatter(fx, struck.head ? 3.0 : 2.2) + away * on + float3(0, 1.4, 0), life = fx.random.NextFloat(0.6, 1.2),
                        size = fx.random.NextFloat(0.06, 0.13), gravity = 9, color = blood, alpha = 0.95, stain = i % 2 == 0 ? 0.1 : 0.0 });
    }
    // A head blown off: a fountain from the neck, high and falling round it
    if (struck.killed && struck.head && !slow)
        for (var i = 0; i < 30; i++)
            Murk(fx, Mote { at = struck.at, velocity = Scatter(fx, 1.3) + float3(0, fx.random.NextFloat(3.5, 7), 0) + away * 0.6, life = fx.random.NextFloat(1.0, 1.6),
                            size = fx.random.NextFloat(0.06, 0.12), gravity = 11, color = blood, alpha = 0.95, stain = 0.11 });
    // A puff of it where the round went in, and a glint of the hit
    if (!slow)
    {
        Murk(fx, Mote { at = struck.at, velocity = Scatter(fx, 0.6) + away * 0.8, life = 0.4, size = struck.head ? 0.4 : 0.28, grow = 1.4, color = float3(0.45, 0.03, 0.03), alpha = 0.8,
                        drag = 4 });
        Glow(fx, Mote { at = struck.at, life = 0.05, size = struck.head ? 0.16 : 0.1, color = float3(1.0, 0.85, 0.6), alpha = 2.5 });
    }
    if (struck.element == Element.Fire)
        for (var i = 0; i < 8; i++) Glow(fx, Mote { at = struck.at, velocity = Scatter(fx, 2.5), life = 0.4, size = 0.09, color = float3(1.0, 0.45, 0.1), alpha = 2.5 });
    if (struck.element == Element.Frost)
        for (var i = 0; i < 8; i++) Glow(fx, Mote { at = struck.at, velocity = Scatter(fx, 2), life = 0.6, size = 0.05, color = float3(0.5, 0.75, 1.0), alpha = 2.5, gravity = 4 });
    if (struck.element == Element.Shock)
        for (var i = 0; i < 6; i++) Glow(fx, Mote { at = struck.at, velocity = Scatter(fx, 4), life = 0.25, size = 0.03, color = float3(0.6, 0.7, 1.0), alpha = 5, gravity = 6 });
}

local event(Blast blast) Explode(mut Fx fx)
{
    if (blast.kind == Shot.Spit)
    {
        // Bile splashing: a sick green flash, a splat of it thrown up and falling
        fx.flashes.Add(Flash { at = blast.at, color = float3(0.6, 0.9, 0.12) * 3, reach = 4, life = 0.2 });
        for (var i = 0; i < 24; i++)
            Murk(fx, Mote { at = blast.at + Scatter(fx, 0.2), velocity = Scatter(fx, 3) + float3(0, fx.random.NextFloat(1, 3), 0), life = fx.random.NextFloat(0.5, 0.9),
                            size = fx.random.NextFloat(0.06, 0.12), gravity = 10, drag = 0.8, color = float3(0.3, 0.34, 0.06), alpha = 1, stain = 0.14 });
        Murk(fx, Mote { at = On(blast.at.x, blast.at.z) + float3(0, 0.03, 0), life = 3, size = 0.3, grow = 0.25, color = float3(0.16, 0.19, 0.04), alpha = 0.7 });
        return;
    }
    if (blast.kind == Shot.Pop)
    {
        // An HE round's: a small flash and a spit of sparks, many of them at once without hiding the fight
        fx.flashes.Add(Flash { at = blast.at, color = float3(1.0, 0.6, 0.25) * 3, reach = blast.reach * 1.5, life = 0.08 });
        Glow(fx, Mote { at = blast.at, life = 0.08, size = 0.35 * blast.reach / 2.5, grow = 2, color = float3(1.0, 0.7, 0.35), alpha = 1.6 });
        for (var i = 0; i < 4; i++)
            Glow(fx, Mote { at = blast.at, velocity = Scatter(fx, 5), life = 0.25, size = 0.025, color = float3(1.0, 0.7, 0.35), alpha = 4, gravity = 8 });
        return;
    }
    if (blast.kind == Shot.Bile)
    {
        // A Bloater bursting: a sick green flash, bile and blood sprayed out and falling, a foul mist hanging
        fx.flashes.Add(Flash { at = blast.at, color = float3(0.7, 0.9, 0.15) * 6, reach = blast.reach * 2, life = 0.3 });
        for (var i = 0; i < 90; i++)
            Murk(fx, Mote { at = blast.at + Scatter(fx, 0.3), velocity = Scatter(fx, blast.reach * 2.2) + float3(0, fx.random.NextFloat(1, 4), 0), life = fx.random.NextFloat(0.6, 1.2),
                            size = fx.random.NextFloat(0.07, 0.16), gravity = 10, drag = 0.8, color = i % 3 == 0 ? float3(0.3, 0.02, 0.01) : float3(0.3, 0.34, 0.06), alpha = 1,
                            stain = 0.2 });
        for (var i = 0; i < 6; i++)
            Murk(fx, Mote { at = blast.at + Scatter(fx, 0.5), velocity = Scatter(fx, 1.0) + float3(0, 0.4, 0), life = fx.random.NextFloat(0.9, 1.4), size = fx.random.NextFloat(0.3, 0.5),
                            grow = 0.6, color = float3(0.16, 0.18, 0.05), alpha = 0.16, drag = 1.5 });
        return;
    }
    if (blast.kind == Shot.Quake)
    {
        // A slam: earth thrown up in a ring as wide as it reaches
        for (var i = 0; i < 70; i++)
        {
            var turn = i * Math.TAU / 70;
            var way = float3(Math.Cos(turn), 0, Math.Sin(turn));
            Murk(fx, Mote { at = blast.at + way * fx.random.NextFloat(0.5, blast.reach) + float3(0, 0.2, 0), velocity = way * fx.random.NextFloat(2, 6) + float3(0, fx.random.NextFloat(1, 4), 0),
                            life = 1.4, size = fx.random.NextFloat(0.3, 0.7), grow = 0.7, color = float3(0.17, 0.14, 0.11), alpha = 0.75, drag = 2, gravity = 3 });
        }
        return;
    }
    var hot = blast.element == Element.Frost ? float3(0.5, 0.75, 1.0) : blast.element == Element.Fire ? float3(1.0, 0.42, 0.08) : float3(1.0, 0.62, 0.25);
    var size = Math.Saturate(blast.reach / 5.5) * 0.6 + 0.4;
    // A Powder Keg's burst (a kill's, often many at once) is a small one: a flash, a ball of fire and sparks, a wisp.
    // And the more blasts lately, the less each leaves: in a chain of them the fight stays in sight
    fx.blasts += 1;
    var small = blast.kind == Shot.Keg;
    var crowd = Math.Saturate((fx.blasts - 2) / 4);
    var share = (small ? 0.4 : 1.0) * (1 - crowd * 0.75);
    fx.flashes.Add(Flash { at = blast.at + float3(0, 0.8, 0), color = hot * (small ? 7.0 : 16.0) * (1 - crowd * 0.5), reach = blast.reach * (small ? 2.0 : 3.0),
                           life = small ? 0.25 : 0.45 });
    if (small || crowd > 0.5)
    {
        for (var i = 0; i < int(14 * share) + 4; i++)
            Glow(fx, Mote { at = blast.at + Scatter(fx, 0.3), velocity = Scatter(fx, blast.reach * 1.4) + float3(0, 1.2, 0), life = fx.random.NextFloat(0.15, 0.35),
                            size = fx.random.NextFloat(0.2, 0.4) * size, grow = 0.6, color = hot, alpha = 1.0, drag = 5, gravity = -3, cool = 1.4 });
        for (var i = 0; i < int(16 * share) + 4; i++)
            Glow(fx, Mote { at = blast.at, velocity = Scatter(fx, blast.reach * 3.5) + float3(0, 2, 0), life = fx.random.NextFloat(0.4, 0.8), size = 0.03,
                            color = float3(1.0, 0.7, 0.35), alpha = 5, gravity = 9, drag = 0.6 });
        for (var i = 0; i < 3; i++)
            Murk(fx, Mote { at = blast.at + Scatter(fx, 0.4), velocity = Scatter(fx, 0.8) + float3(0, 1.4, 0), life = fx.random.NextFloat(0.8, 1.3), size = 0.3 * size,
                            grow = 0.6, color = float3(0.22, 0.21, 0.2), alpha = 0.3, drag = 1.5 });
        return;
    }
    Glow(fx, Mote { at = blast.at + float3(0, 0.3, 0), life = 0.07, size = 0.9 * size, grow = 5, color = float3(1.0, 0.9, 0.75), alpha = 3 });
    // The fireball, rolling up and cooling to red as it goes
    for (var i = 0; i < 22; i++)
        Glow(fx, Mote { at = blast.at + Scatter(fx, 0.4) + float3(0, 0.3, 0), velocity = Scatter(fx, blast.reach * 1.4) + float3(0, 1.5, 0), life = fx.random.NextFloat(0.2, 0.45),
                        size = fx.random.NextFloat(0.3, 0.6) * size, grow = 0.9, color = hot, alpha = 1.1, drag = 5, gravity = -3, cool = 1.4 });
    // Sparks flung out and falling
    for (var i = 0; i < 34; i++)
        Glow(fx, Mote { at = blast.at + float3(0, 0.2, 0), velocity = Scatter(fx, blast.reach * 4) + float3(0, 3, 0), life = fx.random.NextFloat(0.5, 1.2), size = 0.035,
                        color = float3(1.0, 0.7, 0.35), alpha = 5, gravity = 9, drag = 0.6 });
    // Earth thrown up, and a ring of dust along the ground
    for (var i = 0; i < 22; i++)
        Murk(fx, Mote { at = blast.at + float3(0, 0.1, 0), velocity = Scatter(fx, 5) + float3(0, fx.random.NextFloat(4, 8), 0), life = fx.random.NextFloat(0.9, 1.5),
                        size = fx.random.NextFloat(0.05, 0.11), gravity = 12, color = float3(0.16, 0.12, 0.09), alpha = 1 });
    for (var i = 0; i < 24; i++)
    {
        var turn = i * Math.TAU / 24;
        var way = float3(Math.Cos(turn), 0, Math.Sin(turn));
        Murk(fx, Mote { at = blast.at + way * 0.5 + float3(0, 0.15, 0), velocity = way * fx.random.NextFloat(4, 7) + float3(0, 0.5, 0), life = 1.0, size = 0.35 * size,
                        grow = 0.9, color = float3(0.17, 0.14, 0.11), alpha = 0.6, drag = 3 });
    }
    // Smoke, rising and spreading after
    for (var i = 0; i < 10; i++)
        Murk(fx, Mote { at = blast.at + Scatter(fx, 0.8) + float3(0, 0.6, 0), velocity = Scatter(fx, 1.2) + float3(0, 1.8, 0), life = fx.random.NextFloat(1.3, 2.3),
                        size = 0.5 * size, grow = 0.8, color = float3(0.22, 0.21, 0.2), alpha = 0.35, drag = 1.2 });
}

local event(Thud thud) Chip(mut Fx fx)
{
    for (var i = 0; i < 6; i++)
        Murk(fx, Mote { at = thud.at, velocity = (thud.normal + Scatter(fx, 1)) * 1.6, life = 0.5, size = 0.025, gravity = 8, color = float3(0.45, 0.42, 0.38), alpha = 1 });
    for (var i = 0; i < 3; i++)
        Glow(fx, Mote { at = thud.at, velocity = (thud.normal + Scatter(fx, 1)) * 3, life = 0.15, size = 0.02, color = float3(1.0, 0.8, 0.5), alpha = 4, gravity = 5 });
}

// Live Wire: a jagged bolt, segments each a little off the line.
local event(Spell spell) Conjure(mut Fx fx)
{
    mut var from = spell.from;
    var steps = 6;
    for (var i = 1; i <= steps; i++)
    {
        var t = float(i) / steps;
        var to = Math.Lerp(spell.from, spell.to, t) + (i < steps ? Scatter(fx, 0.3) : float3(0));
        fx.streaks.Add(Streak { from = from, to = to, life = 0.15, width = 0.05, color = float3(0.55, 0.65, 1.0) });
        from = to;
    }
    for (var i = 0; i < 4; i++) Glow(fx, Mote { at = spell.to, velocity = Scatter(fx, 3), life = 0.2, size = 0.05, color = float3(0.7, 0.8, 1.0), alpha = 5 });
}

// A round's line: from the muzzle (where the gun was drawn), a thin bright streak to where it stopped; a phase round's
// wide and pale, a drone's red. And the muzzle's flash.
local event(Traced traced) Tracer(mut Fx fx, Grip grip)
{
    var way = Math.Normalize(traced.to - traced.from);
    var gun = traced.kind == Trace.Bullet || traced.kind == Trace.Pellet || traced.kind == Trace.Phase;
    var drawn = gun && traced.seat >= 0 && traced.seat < 4 ? grip.muzzles[traced.seat] : float3(0);
    var from = gun && Math.Distance(drawn, traced.from) < 1.5 ? drawn : gun ? traced.from + way * 0.6 : traced.from;
    if (Math.Distance(from, traced.to) < 0.3) return;
    switch (traced.kind)
    {
        case Trace.Phase:
            fx.streaks.Add(Streak { from = from, to = traced.to, life = 0.3, width = 0.09, color = float3(0.6, 0.75, 1.0) });
            break;
        case Trace.Drone:
            fx.streaks.Add(Streak { from = from, to = traced.to, life = 0.06, width = 0.02, color = float3(1.0, 0.3, 0.2) });
            break;
        case Trace.Pellet:
            fx.streaks.Add(Streak { from = from, to = traced.to, life = 0.06, width = 0.035, color = float3(1.0, 0.75, 0.45) });
            break;
        default:
            fx.streaks.Add(Streak { from = from, to = traced.to, life = 0.08, width = 0.05, color = float3(1.0, 0.82, 0.5) });
            break;
    }
}

// A shot's flash at the muzzle, as the gun is drawn: a burst of light and a few tongues of flame along the barrel's way,
// the light of it on what's round, a wisp of smoke, and the spent case thrown out to the right.
local event(Loosed loosed) MuzzleFlash(mut Fx fx, Grip grip)
{
    if (loosed.source != Source.Gun && loosed.source != Source.Phase && loosed.source != Source.Turret) return;
    var drawn = loosed.seat >= 0 && loosed.seat < 4 ? grip.muzzles[loosed.seat] : float3(0);
    var at = loosed.source != Source.Turret && Math.Distance(drawn, loosed.at) < 1.5 ? drawn : loosed.at;
    var way = loosed.way;
    var heavy = loosed.weapon == Weapon.Shotgun || loosed.source == Source.Phase;
    var scale = (heavy ? 1.5 : 1.0) * (loosed.source == Source.Turret ? 0.7 : 1.0);
    var hot = loosed.source == Source.Phase ? float3(0.6, 0.75, 1.0) : float3(1.0, 0.68, 0.32);
    Glow(fx, Mote { at = at, life = 0.05, size = 0.2 * scale, color = hot, alpha = 4 });
    for (var k = 1; k <= 3; k++)
        Glow(fx, Mote { at = at + way * (0.09 * k * scale), life = 0.04, size = (0.13 - k * 0.025) * scale, color = float3(1.0, 0.8, 0.45), alpha = 3 });
    fx.flashes.Add(Flash { at = at + way * 0.2, color = hot * (heavy ? 7.0 : 4.5), reach = heavy ? 9.0 : 7.0, life = 0.07 });
    Murk(fx, Mote { at = at + way * 0.15, velocity = way * 0.6 + float3(0, 0.4, 0), life = 0.6, size = 0.08 * scale, grow = 0.5, color = float3(0.3, 0.29, 0.28), alpha = 0.3, drag = 2 });
    if (loosed.source == Source.Gun && loosed.weapon != Weapon.Shotgun)
    {
        var right = Math.Normalize(Math.Cross(float3(0, 1, 0), way));
        Glow(fx, Mote { at = at - way * 0.3, velocity = right * fx.random.NextFloat(1.5, 2.5) + float3(0, fx.random.NextFloat(1.5, 2.5), 0) - way * 0.5, life = 0.5,
                        size = 0.018, color = float3(0.9, 0.65, 0.25), alpha = 0.7, gravity = 9 });
    }
}

local event(Cue cue) Dust(mut Fx fx)
{
    if (cue.sound != Sfx.Rise) return;
    for (var i = 0; i < 22; i++)
        Murk(fx, Mote { at = cue.at + float3(fx.random.NextFloat(-0.4, 0.4), 0.05, fx.random.NextFloat(-0.4, 0.4)), velocity = float3(0, fx.random.NextFloat(1, 3), 0) + Scatter(fx, 1),
                        life = 1.2, size = fx.random.NextFloat(0.03, 0.09), gravity = 7, color = float3(0.18, 0.14, 0.1), alpha = 1 });
}

// A horde clawing up: earth thrown up all over its patch.
local event(HordeRose horde) HordeDust(mut Fx fx)
{
    var motes = Math.Clamp(horde.count * 4, 40, 160);
    for (var i = 0; i < motes; i++)
    {
        var turn = fx.random.NextFloat(Math.TAU);
        var off = horde.radius * Math.Sqrt(fx.random.NextFloat());
        var at = horde.at + float3(Math.Sin(turn) * off, 0, Math.Cos(turn) * off);
        Murk(fx, Mote { at = On(at.x, at.z) + float3(0, 0.05, 0), velocity = float3(0, fx.random.NextFloat(1, 3.5), 0) + Scatter(fx, 1.2),
                        life = 1.5, size = fx.random.NextFloat(0.04, 0.12), gravity = 6, color = float3(0.18, 0.14, 0.1), alpha = 1 });
    }
}

// An ability used: a leap's landing throws up a ring of earth, a roll's dust, a blink's light at both ends. And a blow
// dodged in a roll: a pale ring off the survivor.
local event(Dodged dodged) DodgeFlash(mut Fx fx)
{
    for (var i = 0; i < 16; i++)
    {
        var turn = i * Math.TAU / 16;
        Glow(fx, Mote { at = dodged.at + float3(0, 0.9, 0), velocity = float3(Math.Cos(turn), 0.2, Math.Sin(turn)) * 3, life = 0.3, size = 0.07,
                        color = float3(0.8, 0.9, 1.0), alpha = 2.5, drag = 4 });
    }
}

local event(Unleashed used) Flourish(mut Fx fx)
{
    switch (used.skill)
    {
        case Skill.Leap:
            if (!used.landed) return;
            for (var i = 0; i < 40; i++)
            {
                var turn = i * Math.TAU / 40;
                var way = float3(Math.Cos(turn), 0, Math.Sin(turn));
                Murk(fx, Mote { at = used.at + way * 0.4 + float3(0, 0.1, 0), velocity = way * fx.random.NextFloat(3, 6) + float3(0, fx.random.NextFloat(0.5, 2), 0), life = 1.1,
                                size = fx.random.NextFloat(0.2, 0.4), grow = 0.6, color = float3(0.17, 0.14, 0.11), alpha = 0.7, drag = 2.5 });
            }
            return;
        case Skill.None:
        case Skill.Roll:
            for (var i = 0; i < 12; i++)
                Murk(fx, Mote { at = used.at + float3(0, fx.random.NextFloat(0.1, 0.8), 0), velocity = Scatter(fx, 1), life = 0.5, size = 0.18, grow = 0.4,
                                color = float3(0.18, 0.16, 0.14), alpha = 0.5, drag = 2 });
            return;
        case Skill.Blink:
            for (var i = 0; i < 24; i++)
            {
                Glow(fx, Mote { at = used.at + float3(0, 1, 0), velocity = Scatter(fx, 3), life = 0.4, size = 0.12, color = float3(0.7, 0.55, 1.0), alpha = 3, drag = 3 });
                Glow(fx, Mote { at = used.to + float3(0, 1, 0), velocity = Scatter(fx, 3), life = 0.5, size = 0.12, color = float3(0.7, 0.55, 1.0), alpha = 3, drag = 3 });
            }
            return;
    }
}

