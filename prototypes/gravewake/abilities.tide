// The classes each survivor picks before the first wave, and the one ability
// on Q every survivor carries (its cooldown shortened by honing, swapped for
// another by a card). A Warrior starts with an arming sword and Leap, a Ranger
// with a hunting bow and Dash, a Mage with the Staff of Embers and Frost Nova.

enum Role { None, Warrior, Ranger, Mage }

enum Ability { None, Leap, Dash, Nova, FirePot, Bell, WarCry, Blink }

const int ABILITY_COUNT = 8;

string RoleName(Role role)
{
    switch (role)
    {
        case Role.Warrior: return "Warrior";
        case Role.Ranger: return "Ranger";
        case Role.Mage: return "Mage";
    }
    return "";
}

string RoleLine(Role role)
{
    switch (role)
    {
        case Role.Warrior: return "Swords, axes, hammers and polearms. Leaps into the dead and knocks them flat.";
        case Role.Ranger: return "Bows, crossbows, javelins and the handgonne, with twice the arrows. Dashes clear.";
        case Role.Mage: return "The staffs of embers, rime and storms, their charges coming back on their own. Freezes what's near.";
    }
    return "";
}

// What a class starts with in hand, and on Q.
Weapon RoleWeapon(Role role)
{
    switch (role)
    {
        case Role.Warrior: return Weapon.ArmingSword;
        case Role.Ranger: return Weapon.HuntingBow;
        case Role.Mage: return Weapon.StaffFire;
    }
    return Weapon.HandCrossbow;
}

Ability RoleAbility(Role role)
{
    switch (role)
    {
        case Role.Warrior: return Ability.Leap;
        case Role.Ranger: return Ability.Dash;
        case Role.Mage: return Ability.Nova;
    }
    return Ability.None;
}

// Whether a weapon is the class's: what its weapon cards give.
bool OfRole(Weapon weapon, Role role)
{
    var kind = Info(weapon).kind;
    switch (role)
    {
        case Role.Warrior: return kind == Kind.Melee;
        case Role.Ranger: return kind == Kind.Bow || kind == Kind.Crossbow || kind == Kind.Gun || kind == Kind.Thrown;
        case Role.Mage: return kind == Kind.Staff;
    }
    return false;
}

string AbilityName(Ability ability)
{
    switch (ability)
    {
        case Ability.Leap: return "Leap";
        case Ability.Dash: return "Dash";
        case Ability.Nova: return "Frost Nova";
        case Ability.FirePot: return "Fire Pot";
        case Ability.Bell: return "Grave Bell";
        case Ability.WarCry: return "War Cry";
        case Ability.Blink: return "Blink";
    }
    return "";
}

string AbilityLine(Ability ability)
{
    switch (ability)
    {
        case Ability.Leap: return "Leap high and far, and knock down the dead where you land";
        case Ability.Dash: return "A burst of speed the way you're going";
        case Ability.Nova: return "Freeze the dead around you solid";
        case Ability.FirePot: return "Throw a pot of burning pitch";
        case Ability.Bell: return "Throw a bell the dead go to, until it bursts";
        case Ability.WarCry: return "Throw back and knock down the dead around you";
        case Ability.Blink: return "Step through the air to where you look";
    }
    return "";
}

// Seconds between uses, a fifth less for each honing.
float Cooldown(Ability ability, int honed)
{
    mut var seconds = 6.0;
    switch (ability)
    {
        case Ability.Leap: seconds = 8; break;
        case Ability.Dash: seconds = 3.5; break;
        case Ability.Nova: seconds = 9; break;
        case Ability.FirePot: seconds = 7; break;
        case Ability.Bell: seconds = 25; break;
        case Ability.WarCry: seconds = 10; break;
        case Ability.Blink: seconds = 6; break;
    }
    return seconds * Math.Pow(0.8, honed);
}

const float DASH_SECONDS = 0.18;
const float DASH_SPEED = 19;
const float SLAM_REACH = 3.2;

// Q: the ability, if it's ready (and the hands are free for a throw).
void Unleash(mut Survivor survivor, float2 move, Ashwick ashwick, List<Body> bodies, int round)
{
    var ability = survivor.ability;
    if (ability == Ability.None || survivor.cooldown > 0) return;
    var throwing = ability == Ability.FirePot || ability == Ability.Bell;
    if (throwing && survivor.act != Act.Idle) return;
    var power = 1 + 0.25 * survivor.honed;
    var health = RoundHealth(round);
    switch (ability)
    {
        case Ability.Leap:
        {
            if (!survivor.grounded) return;
            var ahead = Flat(survivor.yaw);
            survivor.velocity = ahead * 7.5 + float3(0, 9.5, 0);
            survivor.grounded = false;
            survivor.leaping = true;
            break;
        }
        case Ability.Dash:
        {
            mut var way = Flat(survivor.yaw) * move.y + Flat(survivor.yaw + Math.PI * 0.5) * move.x;
            if (Math.Length(way) < 0.1) way = Flat(survivor.yaw);
            survivor.dashWay = Math.Normalize(way);
            survivor.dash = DASH_SECONDS;
            break;
        }
        case Ability.Nova:
        {
            foreach (var z in bodies)
            {
                if (!z.hittable || Math.Distance(z.at, survivor.feet) > 5.5) continue;
                z.entity.Send(Wound { damage = (60 + health * 0.3) * power * Might(survivor), seat = survivor.seat, element = Element.Frost, from = survivor.feet,
                                      blow = Blow.Burst, freeze = 2.2 });
            }
            break;
        }
        case Ability.FirePot:
            StartAct(survivor, Act.Throw, 0.65);
            survivor.charge = 0;
            break;
        case Ability.Bell:
            StartAct(survivor, Act.Throw, 0.65);
            survivor.charge = 1;
            break;
        case Ability.WarCry:
        {
            foreach (var z in bodies)
            {
                if (!z.hittable || Math.Distance(z.at, survivor.feet) > 4.5) continue;
                z.entity.Send(Wound { damage = (30 + health * 0.15) * power, seat = survivor.seat, from = survivor.feet, knock = 7, down = true, blow = Blow.Shove });
            }
            break;
        }
        case Ability.Blink:
        {
            // As far as 9 m the way they look, but not through anything nor off the clearing
            var way = Flat(survivor.yaw);
            mut var to = survivor.feet;
            for (var k = 1; k <= 36; k++)
            {
                var step = survivor.feet + way * (k * 0.25);
                var ground = Ground(step.x, step.z);
                var at = float3(step.x, Math.Max(ground, survivor.feet.y), step.z);
                if (!InClearing(at) || Math.Distance(PushOut(ashwick, at, BODY_RADIUS, BODY_HIGH), at) > 0.001 || ground > survivor.feet.y + 1.5) break;
                to = at;
            }
            if (Math.Distance(to, survivor.feet) < 1) return;
            Send(Unleashed { seat = survivor.seat, ability = ability, at = survivor.feet, to = to });
            survivor.feet = float3(to.x, Ground(to.x, to.z), to.z);
            survivor.velocity = float3(0);
            survivor.cooldown = Cooldown(ability, survivor.honed);
            return;
        }
    }
    survivor.cooldown = Cooldown(ability, survivor.honed);
    Send(Unleashed { seat = survivor.seat, ability = ability, at = survivor.feet, to = survivor.feet });
}

// A leap come down: what's near goes over.
void Slam(Survivor survivor, List<Body> bodies, int round)
{
    var power = 1 + 0.25 * survivor.honed;
    foreach (var z in bodies)
    {
        if (!z.hittable || Math.Distance(z.at, survivor.feet) > SLAM_REACH) continue;
        z.entity.Send(Wound { damage = (50 + RoundHealth(round) * 0.35) * power * Might(survivor), seat = survivor.seat, from = survivor.feet, knock = 6, down = true,
                              blow = Blow.Blunt });
    }
    Send(Unleashed { seat = survivor.seat, ability = Ability.Leap, at = survivor.feet, to = survivor.feet, landed = true });
}

// An ability used, for what's seen and heard: where from and to (a blink's two ends), a leap's landing.
event Unleashed
{
    int seat;
    Ability ability;
    float3 at;
    float3 to;
    bool landed;
}
