using Rooms;

// What's held, and what's thrown and set down: this machine's survivor's arms
// (fp.tide) and the gun in them, drawn over the world (firing, loading,
// throwing, the boot coming up); every survivor's gun in their hand; grenades,
// firebombs, mines and shells on their way; the Engineer's turrets; the gun
// drones. The guns are art/guns, each with its grip at the origin (guns.json
// says where its muzzle is).

asset Map<string, Mesh<Corner>> gunMeshes = "art/guns/*.glb";
asset Map<string, Mesh<Corner>> items = "art/items/*.glb";
asset string gunsJson = "art/guns/guns.json";
asset Mesh<Corner> potMesh = "art/weapons/fire_pot.glb";
asset Mesh<Corner> ballMesh = "art/weapons/cannonball.glb";
asset Mesh<Corner> legMesh = "art/weapons/kick_leg.glb";
asset Mesh<Corner> tripodMesh = "art/guns/tripod.glb";

// What guns.json says of a gun: its muzzle, in its own space.
struct GunData
{
    string name;
    float length;
    float[3] muzzle;
}

// How a flat-coloured model is drawn: what glows on it, how open to the sky it is, a tint.
struct Finish
{
    float glow = 1;
    float open = 1;
    float3 tint = float3(1);
}

local singleton Armory
{
    List<GunData> data;
    Map<string, int> byName;
    List<Corner> box;            // A unit box round the origin, for the drones
    List<int> boxFaces;
    bool made;
}

// This machine's hands: how they lag behind a turn, and what they showed last.
local singleton Grip
{
    float2 sway;
    float lastYaw;
    float lastPitch;
    float sprint;
    float low;                   // How far the arms hang below the kit's eye (fp.tide's LowFor), eased
    float3 muzzle;               // Where the gun's muzzle was last frame, in the world, for the tracers
}

Mesh<Corner> GunMesh(Weapon weapon)
{
    return gunMeshes[$"art/guns/{Info(weapon).model}.glb"];
}

Mesh<Corner> ItemMesh(string name)
{
    return items[$"art/items/{name}.glb"];
}

float3 V3(float[3] a)
{
    return float3(a[0], a[1], a[2]);
}

GunData DataOf(Armory armory, Weapon weapon)
{
    if (armory.byName.TryGet(Info(weapon).model, out var index)) return armory.data[index];
    return GunData { };
}

void MakeArmory(mut Armory armory)
{
    armory.data = Json.Read<List<GunData>>(gunsJson) ?? [];
    armory.byName.Clear();
    for (var i = 0; i < armory.data.count; i++) armory.byName[armory.data[i].name] = i;
    armory.box.Clear();
    armory.boxFaces.Clear();
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        var sign = face % 2 == 0 ? 1.0 : -1.0;
        var n = float3(axis == 0 ? sign : 0, axis == 1 ? sign : 0, axis == 2 ? sign : 0);
        var u = axis == 0 ? float3(0, 0, 1) : float3(1, 0, 0);
        var v = Math.Cross(n, u);
        var first = armory.box.count;
        for (var c = 0; c < 4; c++)
        {
            var a = c == 1 || c == 2 ? 0.5 : -0.5;
            var b = c >= 2 ? 0.5 : -0.5;
            armory.box.Add(Corner { position = n * 0.5 + u * a + v * b, normal = n, color = Color(0.16, 0.17, 0.18) });
        }
        armory.boxFaces.Add(first);
        armory.boxFaces.Add(first + 2);
        armory.boxFaces.Add(first + 1);
        armory.boxFaces.Add(first);
        armory.boxFaces.Add(first + 3);
        armory.boxFaces.Add(first + 2);
    }
    armory.made = true;
}

// A flat-coloured model, lit as the world is: what glows on it (uv2.x over a half) glows, bare metal catches the moon.
frag Steel(Corner corner, out Color color, Instance instance, Finish finish, Look look, Lights lights, Lens lens)
{
    var normal = instance.Normal(corner.normal);
    var paint = Linear(Rgb(corner.color)) * finish.tint;
    mut var lit = Shade(paint, this.world, normal, finish.open, look, lights.list, lens.moonDepth);
    var toEye = Math.Normalize(look.eye - this.world);
    var shine = Math.Pow(Math.Saturate(Math.Dot(Math.Reflect(-toEye, normal), look.moonWay)), 24);
    var grey = Math.Abs(paint.x - paint.y) + Math.Abs(paint.y - paint.z) < 0.05 && paint.x > 0.08 ? 1.0 : 0.0;
    lit += look.moonColor * shine * grey * 2.5;
    if (corner.uv2.x > 0.5) lit += paint * 3.5 * finish.glow;
    color = Color(Hazed(lit, this.world, look), 1);
}

// The turn that takes one direction onto another.
quaternion FromTo(float3 from, float3 to)
{
    var a = Math.Normalize(from);
    var b = Math.Normalize(to);
    var d = Math.Dot(a, b);
    if (d < -0.9999)
    {
        var side = Math.Abs(a.x) < 0.9 ? float3(1, 0, 0) : float3(0, 1, 0);
        return quaternion.AxisAngle(Math.Normalize(Math.Cross(a, side)), Math.PI);
    }
    var axis = Math.Cross(a, b);
    return Math.Normalize(quaternion(axis.x, axis.y, axis.z, 1 + d));
}

float Ease(float t)
{
    var s = Math.Saturate(t);
    return s * s * (3 - 2 * s);
}

float EaseOut(float t)
{
    var s = Math.Saturate(t);
    return 1 - (1 - s) * (1 - s);
}

quaternion Degrees(float x, float y, float z)
{
    return quaternion.Euler(Math.Radians(x), Math.Radians(y), Math.Radians(z));
}

float3 Point(float4x4 m, float3 local)
{
    return Math.Transform(m, local);
}

[Stage(Layers.Hands)]
view DrawHands(Me me, mut Grip grip, mut Armory armory, Lens lens, Look look, Match match, Lobby lobby, query (Survivor survivor) survivors)
{
    if (!armory.made) MakeArmory(armory);
    if (!lens.made || me.overhead != 0 || !lobby.playing) return;
    mut var found = false;
    mut var mine = Survivor { };
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found || !mine.ready || mine.life == Life.Gone || match.phase == Phase.Over || mine.role == Role.None) return;
    var dt = me.dt;
    var weapon = mine.gun;
    var data = DataOf(armory, weapon);
    var grasp = mine.act == Act.Throw ? Grasp.Thrown : GraspOf(weapon);
    var eye = float4x4.TRS(me.eye, me.turn, float3(1));

    // How the hands lag a turn, and bob with each step
    var turnYaw = TurnBetween(grip.lastYaw, me.yaw);
    var turnPitch = me.pitch - grip.lastPitch;
    grip.lastYaw = me.yaw;
    grip.lastPitch = me.pitch;
    grip.sway += (float2(-turnYaw, -turnPitch) * 0.9 - grip.sway) * Math.Min(1, dt * 9);
    grip.sway = Math.Clamp(grip.sway, float2(-0.08), float2(0.08));
    var speed = Math.Length(mine.velocity.xz);
    var running = speed > WALK_SPEED * 1.1 && mine.grounded && mine.act == Act.Idle;
    grip.sprint += ((running ? 1.0 : 0.0) - grip.sprint) * Math.Min(1, dt * 8);
    grip.low += (LowFor(mine.act) - grip.low) * Math.Min(1, dt * 14);
    var stepping = Math.Saturate(speed / 4) * (mine.grounded ? 1.0 : 0.3);
    var bob = float3(Math.Sin(me.bob) * 0.014, -Math.Abs(Math.Cos(me.bob)) * 0.018, 0) * stepping * (1 + grip.sprint);
    var breathe = float3(0, Math.Sin(me.clock * 1.6) * 0.004, 0);

    // The arms taken down out of the way (a gun taken up, the boot), and a shot's kick
    var t = mine.actTime / Math.Max(0.01, mine.actLength);
    mut var lowered = 0.0;
    mut var recoil = 0.0;
    switch (mine.act)
    {
        case Act.Raise:
            lowered = 1 - EaseOut(t);
            break;
        case Act.Kick:
            lowered = Math.Saturate(Math.Min(t * 4, (1 - t) * 4)) * 0.4;
            break;
        case Act.Fire:
            recoil = Math.Saturate(1 - mine.actTime / 0.09) * (weapon == Weapon.Shotgun ? 2.6 : weapon == Weapon.Pistol ? 1.2 : 0.8);
            break;
    }

    // Where the arms hang: from the eye, swaying, bobbing, carried at a run, low when down
    var wobble = bob + breathe + float3(grip.sway.x, grip.sway.y, 0) * 0.6 + float3(0, -me.dip * 0.5, 0);
    var carried = float3(0.04, -0.07, -0.05) * grip.sprint + (mine.life == Life.Downed ? float3(0.02, -0.06, 0) : float3(0));
    var sink = float3(0.05, -0.55, -0.1) * lowered + float3(0, 0.012, -0.06) * recoil;
    var tilt = Degrees(55 * lowered + 14 * grip.sprint - 5 * recoil, -10 * grip.sprint, -8 * grip.sprint);
    mut var place = Math.Mul(eye, float4x4.Translate(GraspShift(grasp) - FpEye(grip.low)));
    var pose = FpPose(mine, grasp, t, me.clock);
    // The gun laid along the crosshair's line: its bore turned onto the point 30 m ahead of the eye
    if (grasp != Grasp.Thrown)
    {
        var held = Math.Mul(Unscaled(Math.Mul(place, pose.Model(fpArms.skeleton.bones.weapon))), float4x4.TRS(float3(0), Seat(), float3(1)));
        var lineAt = Point(held, float3(0, V3(data.muzzle).y, 0));
        var lineWay = Math.Normalize(Math.Rotate(held, float3(0, 0, 1)));
        var ahead = Math.Mul(me.turn, float3(0, 0, 1));
        var wantWay = Math.Normalize(me.eye + ahead * 30 - lineAt);
        var lay = mine.act == Act.Reload ? 0.3 : 1.0;
        var turn = Math.Slerp(quaternion.identity, FromTo(lineWay, wantWay), lay);
        place = Math.Mul(Math.Mul(float4x4.TRS(lineAt, turn, float3(1)), float4x4.Translate(-lineAt)), place);
    }
    // ...then swayed, bobbed, carried at a run, lowered and kicked, about the eye
    place = Math.Mul(Math.Mul(Math.Mul(eye, float4x4.TRS(wobble + carried + sink, tilt, float3(1))), Math.Inverse(eye)), place);
    var onBone = Math.Mul(Unscaled(Math.Mul(place, pose.Model(fpArms.skeleton.bones.weapon))), float4x4.TRS(float3(0), Seat(), float3(1)));
    grip.muzzle = Point(onBone, V3(data.muzzle));
    lens.hands.Cull(Cull.None)
    {
        if (lowered < 0.98)
        {
            lens.hands.SkinnedMesh(fpArms, place, pose, Wobble, Steel, Finish { });
            if (mine.act == Act.Throw)
            {
                // The grenade or the firebomb, gone from the hand once thrown
                if (t > 0.06 && t < 0.38)
                {
                    if (mine.throwing == Skill.Frag) lens.hands.Mesh(ballMesh, Math.Mul(onBone, float4x4.TRS(float3(0), quaternion.identity, float3(0.32))), Wobble, Steel, Finish { tint = float3(0.45, 0.5, 0.35) });
                    else lens.hands.Mesh(potMesh, onBone, Wobble, Steel, Finish { });
                }
            }
            else
            {
                lens.hands.Mesh(GunMesh(weapon), onBone, Wobble, Steel, Finish { });
            }
        }
        // The boot: it comes up from below and out at the dead, its sole first
        if (mine.act == Act.Kick)
        {
            var out = t < 0.3 ? EaseOut(t / 0.3) : t < 0.42 ? 1.0 : 1 - Ease((t - 0.42) / 0.58);
            var knee = Math.Lerp(float3(0.2, -1.1, 0.0), float3(0.1, -0.36, 0.26), out);
            var leg = Math.Mul(eye, float4x4.TRS(knee, Degrees(Math.Lerp(-10, -104, out), Math.Lerp(-20, -18, out), Math.Lerp(14, -4, out)), float3(1.15)));
            lens.hands.Mesh(legMesh, leg, Wobble, Steel, Finish { });
        }
    }
}

// ---- What's thrown, laid and called down ----

[Stage(Layers.Scene, 3)]
view DrawMissile(Missile missile, Lens lens, Look look)
{
    if (!lens.made || Math.Distance(missile.at, look.eye) > 70) return;
    switch (missile.kind)
    {
        case Shot.Grenade:
            lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at, quaternion.Euler(missile.age * 9, missile.age * 5, 0), float3(0.32)), Wobble, Steel,
                            Finish { tint = float3(0.45, 0.5, 0.35) });
            return;
        case Shot.Pot:
            lens.scene.Mesh(potMesh, float4x4.TRS(missile.at, quaternion.Euler(missile.age * 9, missile.age * 5, 0), float3(1)), Wobble, Steel, Finish { });
            return;
        case Shot.Mine:
        {
            // A flat disc on the ground, its light blinking once it's armed
            var armed = missile.age >= MINE_ARMS;
            var blink = armed && Math.Frac(look.time * 2) < 0.2 ? 6.0 : 0.0;
            lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at, quaternion.identity, float3(0.9, 0.25, 0.9)), Wobble, Steel, Finish { tint = float3(0.35, 0.37, 0.3) });
            if (blink > 0) lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at + float3(0, 0.07, 0), quaternion.identity, float3(0.12)), Steel,
                                           Finish { tint = float3(4, 0.3, 0.2), open = 0 });
            return;
        }
        case Shot.Shell:
            lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at, quaternion.identity, float3(0.3, 0.6, 0.3)), Wobble, Steel, Finish { tint = float3(0.3, 0.3, 0.32) });
            return;
    }
}

// ---- Every other survivor's gun, in their hand ----

[Stage(Layers.Scene, 3)]
view DrawCarried(Survivor survivor, Lens lens, Me me, Armory armory)
{
    if (!lens.made || !armory.made || !survivor.ready || survivor.life == Life.Gone || survivor.seat == me.seat || survivor.role == Role.None) return;
    var body = HeroBody(survivor.seat);
    var hand = Math.Mul(survivor.place, survivor.pose.Model(body.skeleton.bones.wristR));
    var grip = Math.Mul(hand, float4x4.TRS(float3(0, 0.07, 0.02), Degrees(-90, 0, 90), float3(1)));
    lens.scene.Mesh(GunMesh(survivor.gun), grip, Wobble, Steel, Finish { });
}

// ---- The Engineer's turrets ----

[Stage(Layers.Scene, 3)]
view DrawTurret(Turret turret, Lens lens, Look look)
{
    if (!lens.made || Math.Distance(turret.at, look.eye) > 90) return;
    lens.scene.Mesh(tripodMesh, float4x4.TRS(turret.at, quaternion.AxisAngle(float3(0, 1, 0), turret.yaw), float3(1)), Wobble, Steel, Finish { });
    var aim = Math.Mul(quaternion.AxisAngle(float3(0, 1, 0), turret.yaw), quaternion.AxisAngle(float3(1, 0, 0), -turret.pitch));
    lens.scene.Mesh(GunMesh(Weapon.Smg), float4x4.TRS(turret.at + float3(0, TURRET_HIGH - 0.1, 0), aim, float3(1.15)), Wobble, Steel, Finish { });
}

[Stage(Layers.Shadows, 1)]
view ShadowTurret(Turret turret, Lens lens)
{
    if (!lens.made) return;
    lens.moon.Mesh(tripodMesh, float4x4.TRS(turret.at, quaternion.AxisAngle(float3(0, 1, 0), turret.yaw), float3(1)));
}

// ---- The gun drones, over their survivors' shoulders ----

[Stage(Layers.Scene, 3)]
view DrawDrone(Survivor survivor, Lens lens, Look look, Armory armory)
{
    if (!lens.made || !armory.made || !survivor.ready || survivor.life != Life.Standing || Has(survivor, Item.GunDrone) == 0) return;
    var at = DroneAt(survivor) + float3(0, Math.Sin(look.time * 2.3 + survivor.seat) * 0.06, 0);
    var turn = quaternion.AxisAngle(float3(0, 1, 0), survivor.yaw + Math.Sin(look.time * 0.7) * 0.3);
    lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(at, turn, float3(0.3, 0.09, 0.3)), Wobble, Steel, Finish { });
    lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(at + Math.Rotate(turn, float3(0, -0.02, 0.15)), turn, float3(0.07, 0.04, 0.04)), Steel,
                    Finish { tint = float3(8, 1.2, 0.6), open = 0 });
}
