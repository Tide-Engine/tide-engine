using Rooms;

// What's held, and what flies: this machine's survivor's arms (fp.tide) and
// the weapon in them, drawn over the world (swinging, drawing a bow, spanning a
// crossbow, casting, throwing, drinking), every survivor's weapon in their
// hand, and the arrows, bolts, javelins, axes and pots on their way. The
// models are art/weapons, each with its grip at the origin (weapons.json says
// where a bow's string is tied, where a bolt lies).

asset Map<string, Mesh<Corner>> arms = "art/weapons/*.glb";
asset Map<string, Mesh<Corner>> items = "art/items/*.glb";
asset string weaponsJson = "art/weapons/weapons.json";

// What weapons.json says of a model: its points, in its own space.
struct ArmsData
{
    string name;
    string kind;
    float length;
    float[3] tip;
    float[3] offhand;
    float[3] head;
    float[3] stringTop;
    float[3] stringBottom;
    float[3] stringLeft;
    float[3] stringRight;
    float[3] nock;
    float[3] boltTail;
    float[3] boltTip;
    float[3] muzzle;
}

// How a flat-coloured model is drawn: its runes, if the Runeforge has had it; what glows on it.
struct Finish
{
    float runes;
    float glow = 1;
    float open = 1;
    float3 tint = float3(1);
}

local singleton Armory
{
    List<ArmsData> data;
    Map<string, int> byName;
    List<Corner> stick;          // A thin box along +y from 0 to 1, for strings
    List<int> stickFaces;
    bool made;
}

// This machine's hands: how they lag behind a turn, and what they showed last.
local singleton Grip
{
    float2 sway;
    float lastYaw;
    float lastPitch;
    float sprint;
    float aim;
    float3 lastTip;              // Where the blade's tip was last frame, for its trail
    bool trailing;
    float sinceLoose = 9;        // Seconds since a bow's last shot, for the next arrow's nocking
    float low;                   // How far the arms hang below the kit's eye (fp.tide's LowFor), eased
}

string ModelName(Weapon weapon)
{
    switch (weapon)
    {
        case Weapon.RustySword: return "rusty_sword";
        case Weapon.Dagger: return "dagger";
        case Weapon.ArmingSword: return "arming_sword";
        case Weapon.Falchion: return "falchion";
        case Weapon.Longsword: return "longsword";
        case Weapon.Claymore: return "claymore";
        case Weapon.HandAxe: return "hand_axe";
        case Weapon.BeardedAxe: return "bearded_axe";
        case Weapon.Greataxe: return "greataxe";
        case Weapon.WarHammer: return "war_hammer";
        case Weapon.Maul: return "maul";
        case Weapon.Mace: return "mace";
        case Weapon.MorningStar: return "morning_star";
        case Weapon.Flail: return "flail";
        case Weapon.Spear: return "spear";
        case Weapon.Halberd: return "halberd";
        case Weapon.Scythe: return "scythe";
        case Weapon.Pitchfork: return "pitchfork";
        case Weapon.SpikedClub: return "spiked_club";
        case Weapon.HuntingBow: return "hunting_bow";
        case Weapon.Longbow: return "longbow";
        case Weapon.SunBow: return "sun_bow";
        case Weapon.WraithBow: return "wraith_bow";
        case Weapon.HandCrossbow: return "hand_crossbow";
        case Weapon.LightCrossbow: return "light_crossbow";
        case Weapon.Arbalest: return "arbalest";
        case Weapon.Repeater: return "repeater";
        case Weapon.Handgonne: return "handgonne";
        case Weapon.StaffFire: return "staff_fire";
        case Weapon.StaffFrost: return "staff_frost";
        case Weapon.StaffStorm: return "staff_storm";
        case Weapon.Javelins: return "javelin";
        case Weapon.ThrowingAxes: return "throwing_axe";
    }
    return "dagger";
}

Mesh<Corner> ArmsMesh(string name)
{
    return arms[$"art/weapons/{name}.glb"];
}

Mesh<Corner> ItemMesh(string name)
{
    return items[$"art/items/{name}.glb"];
}

float3 V3(float[3] a)
{
    return float3(a[0], a[1], a[2]);
}

ArmsData DataOf(Armory armory, string name)
{
    if (armory.byName.TryGet(name, out var index)) return armory.data[index];
    return ArmsData { };
}

void MakeArmory(mut Armory armory)
{
    armory.data = Json.Read<List<ArmsData>>(weaponsJson) ?? [];
    armory.byName.Clear();
    for (var i = 0; i < armory.data.count; i++) armory.byName[armory.data[i].name] = i;
    // The stick: a box a unit long up +y, a unit across
    armory.stick.Clear();
    armory.stickFaces.Clear();
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        var sign = face % 2 == 0 ? 1.0 : -1.0;
        var n = float3(axis == 0 ? sign : 0, axis == 1 ? sign : 0, axis == 2 ? sign : 0);
        var u = axis == 0 ? float3(0, 0, 1) : axis == 1 ? float3(1, 0, 0) : float3(1, 0, 0);
        var v = Math.Cross(n, u);
        var first = armory.stick.count;
        for (var c = 0; c < 4; c++)
        {
            var a = c == 1 || c == 2 ? 0.5 : -0.5;
            var b = c >= 2 ? 0.5 : -0.5;
            var p = n * 0.5 + u * a + v * b;
            armory.stick.Add(Corner { position = float3(p.x, p.y + 0.5, p.z), normal = n, color = Color(0.85, 0.82, 0.72) });
        }
        armory.stickFaces.Add(first);
        armory.stickFaces.Add(first + 2);
        armory.stickFaces.Add(first + 1);
        armory.stickFaces.Add(first);
        armory.stickFaces.Add(first + 3);
        armory.stickFaces.Add(first + 2);
    }
    armory.made = true;
}

// A flat-coloured model, lit as the world is: what glows on it (uv2.x over a half) glows, and the Runeforge's runes crawl
// over a forged weapon's metal.
frag Steel(Corner corner, out Color color, Instance instance, Finish finish, Look look, Lights lights, Lens lens)
{
    var normal = instance.Normal(corner.normal);
    var paint = Linear(Rgb(corner.color)) * finish.tint;
    mut var lit = Shade(paint, this.world, normal, finish.open, look, lights.list, lens.moonDepth);
    var toEye = Math.Normalize(look.eye - this.world);
    var shine = Math.Pow(Math.Saturate(Math.Dot(Math.Reflect(-toEye, normal), look.moonWay)), 24);
    var grey = Math.Abs(paint.x - paint.y) + Math.Abs(paint.y - paint.z) < 0.05 && paint.x > 0.08 ? 1.0 : 0.0;
    lit += look.moonColor * shine * grey * 2.5;
    if (corner.uv2.x > 0.5) lit += paint * 3.5 * finish.glow;
    if (finish.runes > 0)
    {
        var p = corner.position;
        var flow = Math.Perlin(float2(p.y * 14 - look.time * 1.6, (p.x + p.z) * 14)) ;
        var band = Math.Saturate(1 - Math.Abs(flow) * 7);
        var pulse = 0.6 + 0.4 * Math.Sin(look.time * 3 + p.y * 9);
        lit = Math.Lerp(lit, lit * 0.6, finish.runes * 0.3) + float3(0.35, 0.45, 1.6) * band * pulse * finish.runes;
    }
    color = Color(Hazed(lit, this.world, look), 1);
}

// The turn that takes one direction onto another.
quaternion FromTo(float3 from, float3 to)
{
    var a = Math.Normalize(from);
    var b = Math.Normalize(to);
    var d = Math.Dot(a, b);
    if (d < -0.9999)
    {
        var side = Math.Abs(a.x) < 0.9 ? float3(1, 0, 0) : float3(0, 1, 0);
        return quaternion.AxisAngle(Math.Normalize(Math.Cross(a, side)), Math.PI);
    }
    var axis = Math.Cross(a, b);
    return Math.Normalize(quaternion(axis.x, axis.y, axis.z, 1 + d));
}

float Ease(float t)
{
    var s = Math.Saturate(t);
    return s * s * (3 - 2 * s);
}

float EaseOut(float t)
{
    var s = Math.Saturate(t);
    return 1 - (1 - s) * (1 - s);
}

quaternion Degrees(float x, float y, float z)
{
    return quaternion.Euler(Math.Radians(x), Math.Radians(y), Math.Radians(z));
}

float3 Point(float4x4 m, float3 local)
{
    return Math.Transform(m, local);
}

// A string or a strand: the stick from one place to another.
float4x4 Strand(float3 from, float3 to, float thick)
{
    var way = to - from;
    var far = Math.Length(way);
    var turn = FromTo(float3(0, 1, 0), way / Math.Max(far, 0.0001));
    return float4x4.TRS(from, turn, float3(thick, far, thick));
}

[Stage(Layers.Hands)]
view DrawHands(Me me, mut Grip grip, mut Armory armory, mut Fx fx, Lens lens, Look look, Match match, Lobby lobby, Devices devices, query (Survivor survivor) survivors)
{
    if (!armory.made) MakeArmory(armory);
    if (!lens.made || me.overhead != 0 || !lobby.playing) return;
    mut var found = false;
    mut var mine = Survivor { };
    foreach (var row in survivors)
    {
        if (row.survivor.seat != me.seat) continue;
        mine = row.survivor;
        found = true;
    }
    if (!found || !mine.ready || mine.life == Life.Gone || match.phase == Phase.Over) return;
    var dt = me.dt;
    var weapon = mine.weapons[mine.slot];
    var info = InfoOf(weapon, mine.forged[mine.slot]);
    var data = DataOf(armory, ModelName(weapon));
    var grasp = GraspOf(weapon, info);
    var eye = float4x4.TRS(me.eye, me.turn, float3(1));

    // How the hands lag a turn, and bob with each step
    var turnYaw = TurnBetween(grip.lastYaw, me.yaw);
    var turnPitch = me.pitch - grip.lastPitch;
    grip.lastYaw = me.yaw;
    grip.lastPitch = me.pitch;
    grip.sway += (float2(-turnYaw, -turnPitch) * 0.9 - grip.sway) * Math.Min(1, dt * 9);
    grip.sway = Math.Clamp(grip.sway, float2(-0.08), float2(0.08));
    var speed = Math.Length(mine.velocity.xz);
    var sprinting = speed > WALK_SPEED * 1.15 && mine.grounded && mine.act == Act.Idle;
    grip.sprint += ((sprinting ? 1.0 : 0.0) - grip.sprint) * Math.Min(1, dt * 8);
    var aiming = (devices.mouse.right.pressed || devices.gamepad.leftTrigger > 0.4) && info.kind != Kind.Melee && mine.life == Life.Standing;
    grip.aim += ((aiming ? 1.0 : 0.0) - grip.aim) * Math.Min(1, dt * 10);
    grip.sinceLoose = mine.act == Act.Loose ? 0.0 : grip.sinceLoose + dt;
    grip.low += (LowFor(grasp, mine.act) - grip.low) * Math.Min(1, dt * 14);
    var stepping = Math.Saturate(speed / 4) * (mine.grounded ? 1.0 : 0.3);
    var bob = float3(Math.Sin(me.bob) * 0.014, -Math.Abs(Math.Cos(me.bob)) * 0.018, 0) * stepping * (1 + grip.sprint);
    var breathe = float3(0, Math.Sin(me.clock * 1.6) * 0.004, 0);

    // The arms taken down out of the way (raising a weapon, a javelin thrown and the next taken up), a kick's
    // shrug, a shot's kick
    var t = mine.actTime / Math.Max(0.01, mine.actLength);
    mut var lowered = 0.0;
    mut var recoil = 0.0;
    switch (mine.act)
    {
        case Act.Raise:
            lowered = 1 - EaseOut(t);
            break;
        case Act.Kick:
            lowered = Math.Saturate(Math.Min(t * 4, (1 - t) * 4)) * 0.4;
            break;
        case Act.Loose:
            recoil = grasp == Grasp.Cross || grasp == Grasp.Pistol ? Math.Saturate(1 - t * 3) * (info.kind == Kind.Gun ? 2.5 : 1.0) : 0.0;
            break;
        case Act.Reload:
            if (info.kind == Kind.Thrown) lowered = 1 - EaseOut((t - 0.4) / 0.6);
            if (grasp == Grasp.Staff) lowered = Math.Sin(Math.Saturate(t) * Math.PI) * 0.5;
            break;
    }
    if (weapon == Weapon.None) lowered = 1;

    // Where the arms hang: from the eye, swaying, bobbing, carried at a run, low when down
    var bow = grasp == Grasp.Bow;
    var wobble = bob + breathe + float3(grip.sway.x, grip.sway.y, 0) * 0.6 + float3(0, -me.dip * 0.5, 0);
    var carried = float3(0.04, -0.06, -0.04) * grip.sprint + (mine.life == Life.Downed ? float3(0.02, -0.06, 0) : float3(0));
    var sink = float3(0.05, -0.55, -0.1) * lowered + float3(0, 0.01, -0.05) * recoil + AimShift(grasp) * grip.aim * (mine.act == Act.Reload ? 0.3 : 1.0);
    var tilt = Degrees(55 * lowered + 10 * grip.sprint - 6 * recoil, -8 * grip.sprint + 5 * grip.aim * (grasp == Grasp.Cross ? 1.0 : 0.0), -6 * grip.sprint);
    mut var place = Math.Mul(eye, float4x4.TRS(wobble + carried + sink + GraspShift(grasp), Math.Mul(tilt, GraspTurn(grasp)), float3(1)));
    place = Math.Mul(place, float4x4.TRS(-FpEye(grasp, grip.low), quaternion.identity, float3(1)));
    var pose = FpPose(fpArms, mine, info, grasp, t, me.clock, speed, grip.sinceLoose);
    var onBone = Math.Mul(Unscaled(Math.Mul(place, pose.Model(fpArms.skeleton.bones.weapon))), float4x4.TRS(float3(0), BladeSeat(grasp), float3(1)));
    var drinking = mine.act == Act.Drink;
    var tossing = mine.act == Act.Throw && t < 0.45;
    var stabbing = mine.act == Act.Stab;
    var finish = Finish { runes = mine.forged[mine.slot] ? 1.0 : 0.0 };
    mut List<float4x4> strings = [];
    lens.scene.ClearDepth();
    lens.scene.Cull(Cull.None)
    {
        if (lowered < 0.98)
        {
            lens.scene.SkinnedMesh(fpArms, place, pose, Steel, Finish { });
            if (drinking)
            {
                // A brew to the lips, held round its middle
                var bottle = Math.Mul(Math.Mul(Unscaled(Math.Mul(place, pose.Model(fpArms.skeleton.bones.weapon))), float4x4.TRS(float3(0), Seat(), float3(1))), float4x4.Translate(float3(0, -0.07, 0)));
                lens.scene.Mesh(ItemMesh(PotionModel(Brew(int(mine.charge)))), bottle, Steel, Finish { glow = 1.5 });
            }
            else if (mine.act == Act.Throw)
            {
                // A fire pot or a bell, gone from the hand once thrown
                var pot = Math.Mul(Unscaled(Math.Mul(place, pose.Model(fpArms.skeleton.bones.weapon))), float4x4.TRS(float3(0), Seat(), float3(1)));
                if (tossing) lens.scene.Mesh(ArmsMesh(mine.charge > 0.5 ? "lure_bell" : "fire_pot"), pot, Steel, Finish { });
            }
            else if (bow)
            {
                lens.scene.SkinnedMesh(fpBow, place, FpPose(fpBow, mine, info, grasp, t, me.clock, speed, grip.sinceLoose), Steel, Finish { runes = finish.runes, tint = BowTint(weapon) });
                var nocked = mine.mag[mine.slot] > 0 && mine.act != Act.Loose && grip.sinceLoose > 0.3;
                if (nocked) lens.scene.SkinnedMesh(fpArrow, place, FpPose(fpArrow, mine, info, grasp, t, me.clock, speed, grip.sinceLoose), Steel, Finish { runes = finish.runes });
            }
            else if (weapon != Weapon.None)
            {
                // The weapon in the hand, or the stab's dagger in its stead
                if (stabbing)
                {
                    var knife = Math.Mul(Unscaled(Math.Mul(place, pose.Model(fpArms.skeleton.bones.knife))), float4x4.TRS(float3(0), KnifeSeat(), float3(1)));
                    lens.scene.Mesh(ArmsMesh("dagger"), knife, Steel, Finish { });
                }
                else
                {
                    var thrown = info.kind == Kind.Thrown && (mine.act == Act.Loose && t > 0.45 || mine.mag[mine.slot] <= 0 && mine.act != Act.Reload);
                    if (!thrown) lens.scene.Mesh(ArmsMesh(data.name), onBone, Steel, finish);
                }
                // The blade's trail through the blow
                var striking = (mine.act == Act.Swing || mine.act == Act.Heavy) && info.kind == Kind.Melee && t > info.hitAt * 0.55 && t < info.hitAt + 0.2;
                var tip = Point(onBone, V3(data.tip) * 0.92);
                if (striking && grip.trailing)
                {
                    var glow = mine.forged[mine.slot] ? float3(0.45, 0.6, 1.4) : float3(0.55, 0.55, 0.6);
                    fx.streaks.Add(Streak { from = grip.lastTip, to = tip, life = 0.11, width = mine.act == Act.Heavy ? 0.05 : 0.035, color = glow });
                }
                grip.trailing = striking;
                grip.lastTip = tip;
                if (info.kind == Kind.Crossbow && !stabbing)
                {
                    // The string: drawn back to the nut when spanned, straight across the prod when not; the bolt when loaded
                    var spanned = mine.mag[mine.slot] > 0 || (mine.act == Act.Reload && t > 0.55);
                    var span = mine.act == Act.Reload ? Ease((t - 0.2) / 0.45) : spanned ? 1.0 : 0.0;
                    var left = V3(data.stringLeft);
                    var right = V3(data.stringRight);
                    var middle = Math.Lerp((left + right) * 0.5, V3(data.nock), span);
                    strings.Add(Math.Mul(onBone, Strand(left, middle, 0.005)));
                    strings.Add(Math.Mul(onBone, Strand(middle, right, 0.005)));
                    var bolted = mine.mag[mine.slot] > 0 || (mine.act == Act.Reload && t > 0.7);
                    if (bolted) lens.scene.Mesh(ArmsMesh("bolt"), Math.Mul(onBone, float4x4.Translate(V3(data.boltTail))), Steel, Finish { runes = finish.runes });
                }
            }
        }
        // The kick: a boot comes up from below and out at the dead, its sole first
        if (mine.act == Act.Kick)
        {
            var out = t < 0.3 ? EaseOut(t / 0.3) : t < 0.42 ? 1.0 : 1 - Ease((t - 0.42) / 0.58);
            var knee = Math.Lerp(float3(0.2, -1.1, 0.0), float3(0.13, -0.5, 0.14), out);
            var leg = Math.Mul(eye, float4x4.TRS(knee, Degrees(Math.Lerp(-10, -100, out), Math.Lerp(-20, -28, out), Math.Lerp(14, -6, out)), float3(1)));
            lens.scene.Mesh(ArmsMesh("kick_leg"), leg, Steel, Finish { });
        }
        foreach (var m in strings) lens.scene.Mesh(armory.stick, armory.stickFaces, m, Steel, Finish { });
    }
}

string PotionModel(Brew brew)
{
    switch (brew)
    {
        case Brew.Ironhide: return "potion_red";
        case Brew.Quickhand: return "potion_green";
        case Brew.SecondWind: return "potion_blue";
        case Brew.Twinstrike: return "potion_amber";
        case Brew.Fleetfoot: return "potion_white";
    }
    return "potion_violet";
}

// ---- Missiles in flight, and stuck where they struck ----

[Stage(Layers.Scene, 3)]
view DrawMissile(Missile missile, Lens lens, Look look)
{
    if (!lens.made || missile.kind == Shot.Fireball || Math.Distance(missile.at, look.eye) > 60) return;
    var way = Math.Normalize(missile.velocity);
    var finish = Finish { runes = missile.forged ? 1.0 : 0.0 };
    switch (missile.kind)
    {
        case Shot.Arrow:
            lens.scene.Mesh(ArmsMesh("arrow"), float4x4.TRS(missile.at - way * 0.6, quaternion.LookRotation(way, float3(0, 1, 0)), float3(1)), Steel, finish);
            return;
        case Shot.Bolt:
            lens.scene.Mesh(ArmsMesh("bolt"), float4x4.TRS(missile.at - way * 0.3, quaternion.LookRotation(way, float3(0, 1, 0)), float3(1)), Steel, finish);
            return;
        case Shot.Ball:
            lens.scene.Mesh(ArmsMesh("cannonball"), float4x4.TRS(missile.at, quaternion.identity, float3(0.35)), Steel, finish);
            return;
        case Shot.Javelin:
            lens.scene.Mesh(ArmsMesh("javelin"), float4x4.TRS(missile.at - way * 0.6, FromTo(float3(0, 1, 0), way), float3(1)), Steel, finish);
            return;
        case Shot.Axe:
        {
            var spin = missile.stuck ? 0.0 : missile.age * 22;
            var flat = Math.Normalize(float3(way.x, 0, way.z));
            var turn = Math.Mul(quaternion.LookRotation(flat, float3(0, 1, 0)), quaternion.AxisAngle(float3(1, 0, 0), spin));
            lens.scene.Mesh(ArmsMesh("throwing_axe"), float4x4.TRS(missile.at, turn, float3(1)), Steel, finish);
            return;
        }
        case Shot.Pot:
            lens.scene.Mesh(ArmsMesh("fire_pot"), float4x4.TRS(missile.at, quaternion.Euler(missile.age * 9, missile.age * 5, 0), float3(1)), Steel, finish);
            return;
        case Shot.Bell:
        {
            var ring = missile.stuck ? Math.Sin(look.time * 30) * 0.3 : missile.age * 8;
            lens.scene.Mesh(ArmsMesh("lure_bell"), float4x4.TRS(missile.at, quaternion.Euler(ring, 0, ring * 0.5), float3(1.4)), Steel, Finish { glow = 2 });
            return;
        }
    }
}

// ---- Every other survivor's weapon, in their hand ----

[Stage(Layers.Scene, 3)]
view DrawCarried(Survivor survivor, Lens lens, Me me, Armory armory)
{
    if (!lens.made || !armory.made || !survivor.ready || survivor.life == Life.Gone || survivor.seat == me.seat) return;
    var weapon = survivor.weapons[survivor.slot];
    if (weapon == Weapon.None) return;
    var body = HeroBody(survivor.seat);
    var hand = Math.Mul(survivor.place, survivor.pose.Model(body.skeleton.bones.wristR));
    var info = Info(weapon);
    var held = info.kind == Kind.Bow ? Degrees(0, 0, 90) : info.kind == Kind.Crossbow || info.kind == Kind.Gun ? Degrees(-90, 0, 90) : Degrees(0, 0, 90);
    var grip = Math.Mul(hand, float4x4.TRS(float3(0, 0.07, 0.02), held, float3(1)));
    lens.scene.Mesh(ArmsMesh(ModelName(weapon)), grip, Steel, Finish { runes = survivor.forged[survivor.slot] ? 1.0 : 0.0 });
}
