using Rooms;

// What's held, and what's thrown and set down: every survivor's gun in their
// hand; grenades, firebombs, napalm and shells on their way; the Engineer's
// attack drones; the gun drones. The guns are art/guns, each with its grip at
// the origin (guns.json says where its muzzle is).

asset Map<string, Mesh<Corner>> gunMeshes = "art/guns/*.glb";
asset Map<string, Mesh<Corner>> items = "art/items/*.glb";
asset string gunsJson = "art/guns/guns.json";
asset Mesh<Corner> potMesh = "art/weapons/fire_pot.glb";
asset Mesh<Corner> ballMesh = "art/weapons/cannonball.glb";
asset Mesh<Corner> droneMesh = "art/guns/drone.glb";

// What guns.json says of a gun: its muzzle, in its own space.
struct GunData
{
    string name;
    float length;
    float[3] muzzle;
}

// How a flat-coloured model is drawn: what glows on it, how open to the sky it is, a tint.
struct Finish
{
    float glow = 1;
    float open = 1;
    float3 tint = float3(1);
    float3 light;                // Its own light: lit whatever lights it
}

local singleton Armory
{
    List<GunData> data;
    Map<string, int> byName;
    List<Corner> box;            // A unit box round the origin, for the drones
    List<int> boxFaces;
    bool made;
}

// Where each seat's gun's muzzle was drawn in the world last frame (DrawCarried), for the tracers.
local singleton Grip
{
    float3[4] muzzles;
}

Mesh<Corner> GunMesh(Weapon weapon)
{
    return gunMeshes[$"art/guns/{Info(weapon).model}.glb"];
}

Mesh<Corner> ItemMesh(string name)
{
    return items[$"art/items/{name}.glb"];
}

float3 V3(float[3] a)
{
    return float3(a[0], a[1], a[2]);
}

GunData DataOf(Armory armory, Weapon weapon)
{
    if (armory.byName.TryGet(Info(weapon).model, out var index)) return armory.data[index];
    return GunData { };
}

void MakeArmory(mut Armory armory)
{
    armory.data = Json.Read<List<GunData>>(gunsJson) ?? [];
    armory.byName.Clear();
    for (var i = 0; i < armory.data.count; i++) armory.byName[armory.data[i].name] = i;
    armory.box.Clear();
    armory.boxFaces.Clear();
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        var sign = face % 2 == 0 ? 1.0 : -1.0;
        var n = float3(axis == 0 ? sign : 0, axis == 1 ? sign : 0, axis == 2 ? sign : 0);
        var u = axis == 0 ? float3(0, 0, 1) : float3(1, 0, 0);
        var v = Math.Cross(n, u);
        var first = armory.box.count;
        for (var c = 0; c < 4; c++)
        {
            var a = c == 1 || c == 2 ? 0.5 : -0.5;
            var b = c >= 2 ? 0.5 : -0.5;
            armory.box.Add(Corner { position = n * 0.5 + u * a + v * b, normal = n, color = Color(0.16, 0.17, 0.18) });
        }
        armory.boxFaces.Add(first);
        armory.boxFaces.Add(first + 2);
        armory.boxFaces.Add(first + 1);
        armory.boxFaces.Add(first);
        armory.boxFaces.Add(first + 3);
        armory.boxFaces.Add(first + 2);
    }
    armory.made = true;
}

// A flat-coloured model, lit as the world is: what glows on it (uv2.x over a half) glows, bare metal catches the moon.
frag Steel(Corner corner, out Color color, Instance instance, Finish finish, Look look, Lights lights, Lens lens)
{
    var normal = instance.Normal(corner.normal);
    var paint = Linear(Rgb(corner.color)) * finish.tint;
    mut var lit = Shade(paint, this.world, normal, finish.open, look, lights.list, lens.moonDepth);
    var toEye = Math.Normalize(look.eye - this.world);
    var shine = Math.Pow(Math.Saturate(Math.Dot(Math.Reflect(-toEye, normal), look.moonWay)), 24);
    var grey = Math.Abs(paint.x - paint.y) + Math.Abs(paint.y - paint.z) < 0.05 && paint.x > 0.08 ? 1.0 : 0.0;
    lit += look.moonColor * shine * grey * 2.5;
    if (corner.uv2.x > 0.5) lit += paint * 3.5 * finish.glow;
    lit += finish.light;
    color = Color(Hazed(lit, this.world, look), 1);
}

// The turn that takes one direction onto another.
quaternion FromTo(float3 from, float3 to)
{
    var a = Math.Normalize(from);
    var b = Math.Normalize(to);
    var d = Math.Dot(a, b);
    if (d < -0.9999)
    {
        var side = Math.Abs(a.x) < 0.9 ? float3(1, 0, 0) : float3(0, 1, 0);
        return quaternion.AxisAngle(Math.Normalize(Math.Cross(a, side)), Math.PI);
    }
    var axis = Math.Cross(a, b);
    return Math.Normalize(quaternion(axis.x, axis.y, axis.z, 1 + d));
}

float Ease(float t)
{
    var s = Math.Saturate(t);
    return s * s * (3 - 2 * s);
}

float EaseOut(float t)
{
    var s = Math.Saturate(t);
    return 1 - (1 - s) * (1 - s);
}

quaternion Degrees(float x, float y, float z)
{
    return quaternion.Euler(Math.Radians(x), Math.Radians(y), Math.Radians(z));
}

float3 Point(float4x4 m, float3 local)
{
    return Math.Transform(m, local);
}

// The guns' data, once.
[Stage(Layers.Prepare, 2)]
view ReadyArmory(mut Armory armory)
{
    if (!armory.made) MakeArmory(armory);
}

// ---- What's thrown, laid and called down ----

[Stage(Layers.Scene, 3)]
view DrawMissile(Missile missile, Lens lens, Look look)
{
    if (!lens.made || Math.Distance(missile.at, look.eye) > 70) return;
    switch (missile.kind)
    {
        case Shot.Grenade:
            lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at, quaternion.Euler(missile.age * 9, missile.age * 5, 0), float3(0.32)), Wobble, Steel,
                            Finish { tint = float3(0.45, 0.5, 0.35) });
            return;
        case Shot.Pot:
            lens.scene.Mesh(potMesh, float4x4.TRS(missile.at, quaternion.Euler(missile.age * 9, missile.age * 5, 0), float3(1)), Wobble, Steel, Finish { });
            return;
        case Shot.Napalm:
            // A glob of burning fuel: a ball of it, alight (flames.tide's fire trails it)
            lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at, quaternion.Euler(missile.age * 7, missile.age * 4, 0), float3(0.24)), Wobble, Steel,
                            Finish { tint = float3(0.9, 0.35, 0.08), light = float3(2.2, 0.8, 0.15) });
            return;
        case Shot.Shell:
            lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at, quaternion.identity, float3(0.3, 0.6, 0.3)), Wobble, Steel, Finish { tint = float3(0.3, 0.3, 0.32) });
            return;
        case Shot.Rocket:
        {
            var way = Math.Length(missile.velocity) > 0.01 ? Math.Normalize(missile.velocity) : float3(0, 0, 1);
            var turn = quaternion.LookRotation(way, Math.Abs(way.y) > 0.95 ? float3(1, 0, 0) : float3(0, 1, 0));
            lens.scene.Mesh(ballMesh, float4x4.TRS(missile.at, turn, float3(0.13, 0.13, 0.42)), Wobble, Steel, Finish { tint = float3(0.6, 0.62, 0.55) });
            return;
        }
    }
}

// ---- Every survivor's gun, in their hand ----

// The gun where the pose put it (people.tide's PoseSurvivor: along the line to what it's aimed at, in both hands).
[Stage(Layers.Scene, 3)]
view DrawCarried(Survivor survivor, Lens lens, mut Grip grip, Armory armory)
{
    if (!lens.made || !armory.made || !survivor.ready || survivor.life == Life.Gone || survivor.role == Role.None || survivor.roll > 0) return;
    lens.scene.Mesh(GunMesh(survivor.gun), survivor.held, Wobble, Steel, Finish { });
    if (survivor.seat >= 0 && survivor.seat < 4) grip.muzzles[survivor.seat] = Point(survivor.held, V3(DataOf(armory, survivor.gun).muzzle));
}

// ---- The Engineer's attack drones ----

// Its body bobbing and tipped the way it flies (more the faster), turned to what it shoots; its four rotors turning.
[Stage(Layers.Scene, 3)]
view DrawTurret(Turret turret, Lens lens, Look look, Armory armory)
{
    if (!lens.made || !armory.made || Math.Distance(turret.at, look.eye) > 90) return;
    var place = DronePlace(turret, look.time);
    lens.scene.Mesh(droneMesh, place, Wobble, Steel, Finish { });
    for (var sx = -1; sx <= 1; sx += 2)
        for (var sz = -1; sz <= 1; sz += 2)
        {
            var hub = Point(place, float3(sx * ROTOR_OUT, 0.08, sz * ROTOR_OUT));
            var spin = quaternion.AxisAngle(float3(0, 1, 0), look.time * 47 * sx + sz);
            for (var blade = 0; blade < 2; blade++)
                lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(hub, Math.Mul(spin, quaternion.AxisAngle(float3(0, 1, 0), blade * Math.PI * 0.5)),
                                float3(0.34, 0.006, 0.03)), Wobble, Steel, Finish { tint = float3(0.25) });
        }
}

const float ROTOR_OUT = 0.34;       // How far out along each diagonal the drone's rotors turn (art/guns/tools/make_drone.py's ARM)

// Where a drone is seen: bobbing, tipped toward the way it flies, turned to its aim.
float4x4 DronePlace(Turret turret, float time)
{
    var bob = float3(0, Math.Sin(time * 3.1 + turret.seat) * 0.07, 0);
    var tip = Math.Min(0.35, turret.pace * 0.05);
    var turn = Math.Mul(quaternion.AxisAngle(float3(0, 1, 0), turret.yaw), quaternion.AxisAngle(float3(1, 0, 0), tip));
    return float4x4.TRS(turret.at + bob, turn, float3(1.3));
}

[Stage(Layers.Shadows, 1)]
view ShadowTurret(Turret turret, Lens lens, Look look)
{
    if (!lens.made) return;
    lens.moon.Mesh(droneMesh, DronePlace(turret, look.time));
}

// ---- The gun drones, over their survivors' shoulders ----

[Stage(Layers.Scene, 3)]
view DrawDrone(Survivor survivor, Lens lens, Look look, Armory armory)
{
    var drones = Has(survivor, Item.GunDrone);
    if (!lens.made || !armory.made || !survivor.ready || survivor.life != Life.Standing || drones == 0) return;
    // A drone each (items.tide's DroneAt), facing the way they aim
    var shown = Math.Min(drones, DRONES_SHOWN);
    for (var k = 0; k < shown; k++)
    {
        var at = DroneAt(survivor, k, drones) + float3(0, Math.Sin(look.time * 2.3 + survivor.seat + k * 1.7) * 0.06, 0);
        var turn = quaternion.AxisAngle(float3(0, 1, 0), survivor.yaw + Math.Sin(look.time * 0.7 + k) * 0.3);
        lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(at, turn, float3(0.3, 0.09, 0.3)), Wobble, Steel, Finish { });
        lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(at + Math.Rotate(turn, float3(0, -0.02, 0.15)), turn, float3(0.07, 0.04, 0.04)), Steel,
                        Finish { tint = float3(8, 1.2, 0.6), open = 0 });
    }
}

// ---- Saw blades, circling their survivors: two squares of bright steel crossed, spinning, a hot hub, and behind each
// its path in solid slivers of light fading, as pixel art draws a swing (no soft glow: the owner, 2026-10-20, "the saw
// VFX look very blurry again") ----

[Stage(Layers.Scene, 3)]
view DrawSaws(Survivor survivor, Lens lens, Look look, Armory armory)
{
    var saws = Has(survivor, Item.SawBlades);
    if (!lens.made || !armory.made || !survivor.ready || survivor.life != Life.Standing || saws == 0) return;
    var shown = Math.Min(saws, SAWS_SHOWN);
    var up = float3(0, 1, 0);
    for (var k = 0; k < shown; k++)
    {
        var at = SawAt(survivor, k, shown);
        var spin = quaternion.AxisAngle(up, look.time * 24 + k);
        var across = Math.Mul(spin, quaternion.AxisAngle(up, Math.PI * 0.25));
        var steel = Finish { tint = float3(1.8, 1.8, 1.9), light = float3(0.3, 0.32, 0.38) };
        lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(at, spin, float3(0.6, 0.04, 0.6)), Wobble, Steel, steel);
        lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(at, across, float3(0.6, 0.04, 0.6)), Wobble, Steel, steel);
        lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(at + float3(0, 0.03, 0), spin, float3(0.16, 0.05, 0.16)), Wobble, Steel,
                        Finish { tint = float3(0.5), light = float3(2.2, 0.7, 0.15) });
        // Its path: four slivers along the circle behind it, each dimmer
        for (var j = 1; j <= 4; j++)
        {
            var back = survivor.sawTurn - j * 0.16 + k * Math.TAU / shown;
            var where = survivor.feet + float3(Math.Sin(back) * SAW_REACH, 0.85, Math.Cos(back) * SAW_REACH);
            var along = quaternion.AxisAngle(up, back + Math.PI * 0.5);
            var fade = 1 - j * 0.22;
            lens.scene.Mesh(armory.box, armory.boxFaces, float4x4.TRS(where, along, float3(0.07 * fade, 0.03, 0.34)), Wobble, Steel,
                            Finish { tint = float3(0), light = float3(0.55, 0.62, 0.8) * fade });
        }
    }
}
