string ChamberName(int level)
{
    switch (level)
    {
        case 0: return "It takes two";
        case 1: return "A little resistance";
        case 2: return "One or the other";
        case 3: return "The quiet hours";
        case 4: return "On the same wavelength";
    }
    return "The last light";
}
string Brief(int level)
{
    switch (level)
    {
        case 0: return "The lift needs both inputs on. Copper: fit the right mixer. Coil: watch the test board. Then stand on both round pads.";
        case 1: return "The old pump only runs when A is on and B is off. Copper handles the mixer; Coil can invert input B.";
        case 2: return "One generator at a time. Power must flow with exactly one input on, but never with both.";
        case 3: return "A night-light for the sleeping station. It should glow only when both generators are off. Coil can invert the output.";
        case 4: return "The radio wants agreement: power when A and B match, whether they are both on or both off. Both input inverters are available.";
    }
    return "Bring the lighthouse home. Exactly one of A and B must be on, and the safety signal C must also be on. A second mixer joins C to your circuit.";
}
string Hint(int level)
{
    switch (level)
    {
        case 0: return "AND means both. Walk Copper beside the MIX console and press E until it says AND.";
        case 1: return "Make B into NOT B, then combine it with A using AND. Each robot has a job on its own bank.";
        case 2: return "XOR is exclusive OR: one input or the other, but never both.";
        case 3: return "OR notices either generator. NOT turns that into neither generator. Use the OUT console on Coil's bank.";
        case 4: return "XOR detects disagreement. Invert its output to detect agreement. Leave both input consoles on WIRE.";
    }
    return "Leave inputs on WIRE, set MIX to XOR and OUT to WIRE. Set the C mixer to AND. Check all eight test rows.";
}
string GateName(Gate gate)
{
    switch (gate)
    {
        case Gate.Not: return "NOT";
        case Gate.And: return "AND";
        case Gate.Or: return "OR";
        case Gate.Xor: return "XOR";
    }
    return "WIRE";
}
string SocketName(int index)
{
    switch (index)
    {
        case 0: return "A";
        case 1: return "B";
        case 2: return "MIX";
        case 3: return "OUT";
    }
    return "+ C";
}
