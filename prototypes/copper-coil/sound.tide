asset Clip footstep = "sfx/step.wav";
asset Clip circuitClick = "sfx/switch.wav";
asset Clip refused = "sfx/blocked.wav";
asset Clip bridgePower = "sfx/power.wav";
asset Clip chamberComplete = "sfx/complete.wav";
asset Clip rewindSound = "sfx/reset.wav";

local event(Feedback feedback) SoundFeedback()
{
    var pitch = feedback.robot == 0 ? 1.0 : 1.2;
    switch (feedback.kind)
    {
        case Cue.Step: Audio.Play(footstep, .55, pitch); break;
        case Cue.Change: Audio.Play(circuitClick, .45, pitch); break;
        case Cue.Blocked: Audio.Play(refused, .35); break;
        case Cue.Power: Audio.Play(bridgePower, .7); break;
        case Cue.Complete: Audio.Play(chamberComplete, .7); break;
        case Cue.Reset: Audio.Play(rewindSound, .5); break;
    }
}
