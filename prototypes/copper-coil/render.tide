using Rooms;
// A miniature industrial diorama drawn entirely with authored game geometry.
// Match coordinates stay on the grid; easing and electrical pulses are local.
float2 Project(float2 cell, float2 origin, float tile, float height = 0)
{
    return origin + float2((cell.x - cell.y) * tile, (cell.x + cell.y) * tile * .46 - height);
}
void Quad(float2 a, float2 b, float2 c, float2 d, Color color)
{
    Draw.Mesh([Vertex { position = a, color = color }, Vertex { position = b, color = color },
        Vertex { position = c, color = color }, Vertex { position = d, color = color }], [0, 1, 2, 0, 2, 3]);
}
void Block(float2 cell, float2 origin, float tile, float span, float height, Color color)
{
    var p = Project(cell, origin, tile);
    var a = p + float2(0, -span * tile * .46);
    var b = p + float2(span * tile, 0);
    var c = p + float2(0, span * tile * .46);
    var d = p + float2(-span * tile, 0);
    var up = float2(0, -height);
    Quad(d, c, c + up, d + up, Color(color.r * .53, color.g * .57, color.b * .60, color.a));
    Quad(c, b, b + up, c + up, Color(color.r * .72, color.g * .77, color.b * .78, color.a));
    Quad(a + up, b + up, c + up, d + up, color);
}
void Cable(float2 a, float2 b, bool on, float2 origin, float tile, float clock, Color tone = COPPER)
{
    var p = Project(a, origin, tile, 7);
    var q = Project(b, origin, tile, 7);
    Draw.Line(p + float2(0, 2), q + float2(0, 2), 6, INK);
    Draw.Line(p, q, 3, on ? tone : Color(.24, .32, .31));
    if (on)
    {
        Draw.Line(p, q, 8, Color(tone.r, tone.g, tone.b, .08));
        var phase = Math.Frac(clock * .65);
        Draw.Circle(Math.Lerp(p, q, phase), 3, CREAM);
    }
}
void Robot(float2 cell, int index, bool active, float2 origin, float tile, float clock)
{
    var color = index == 0 ? COPPER : COIL;
    var at = Project(cell, origin, tile, 8);
    Draw.Ellipse(at + float2(0, 4), float2(tile * .55, tile * .20), Color(0, 0, 0, .24));
    if (active) Draw.WireEllipse(at + float2(0, 2), float2(tile * .65, tile * .29), 2, color);
    var bob = Math.Sin(clock * 3 + index * 2) * tile * .035;
    Block(cell + float2(-.16, .12), origin, tile, .18, tile * .16, Color(.17, .26, .28));
    Block(cell + float2(.16, -.12), origin, tile, .18, tile * .16, Color(.17, .26, .28));
    Block(cell, origin + float2(0, -tile * .13 + bob), tile, .43, tile * .56, color);
    Draw.RoundRect(at + float2(0, -tile * .50 + bob), float2(tile * .67, tile * .26), tile * .10, INK);
    Draw.Circle(at + float2(-tile * .16, -tile * .50 + bob), tile * .045, CREAM);
    Draw.Circle(at + float2(tile * .16, -tile * .50 + bob), tile * .045, CREAM);
    Draw.Line(at + float2(tile * .12, -tile * .73 + bob), at + float2(tile * .12, -tile * .99 + bob), 2, INK);
    Draw.Circle(at + float2(tile * .12, -tile * .99 + bob), tile * .07, color);
    Text(index == 0 ? "COPPER" : "COIL", at + float2(0, -tile * 1.30), Math.Max(9, tile * .28), color, Anchor.MiddleCenter);
}
[Before(Rooms.Pages, Interface)]
view Diorama(Station station, Session session, Lobby lobby, mut Desk desk)
{
    Draw.Clear(INK);
    Draw.SetScreen();
    var w = Screen.width;
    var h = Screen.height;
    var narrow = w < 850;
    var worldW = narrow ? w : w - 324;
    var availableH = narrow ? h * .38 : h - 240;
    var tile = Math.Min(worldW / 23, availableH / 11.5);
    var middle = float2(worldW * .52, narrow ? h * .285 : 110 + availableH * .48);
    var origin = middle - float2(2 * tile, 10 * tile * .46);
    var clock = desk.reducedMotion ? 0 : desk.clock;
    // Quiet factory skylight, floating dust and a suspended gantry.
    Draw.Shape(Shape { center = float2(worldW * .5, h * .45), size = float2(worldW * .85, h * .75), ellipse = true, color = Color(.18, .35, .32, .12), soft = 100 });
    for (var i = 0; i < 20; i++)
    {
        var x = ((i * 137 + 29) % 997) / 997.0 * worldW;
        var y = 100 + Math.Frac((i * 71 + clock * 3) / Math.Max(1, availableH)) * availableH;
        Draw.Circle(float2(x, y), 1, Color(.73, .84, .71, .15));
    }
    var circuit = station.circuit;
    for (var y = 1; y < 8; y++)
    {
        for (var x = 0; x < 13; x++)
        {
            var cell = Cell(x, y);
            var bridge = x >= 5 && x <= 7;
            if (!Floor(cell, true)) continue;
            if (bridge && !circuit.powered)
            {
                Block(float2(x, y), origin + float2(0, tile * .7), tile, .94, tile * .08, Color(.075, .14, .16));
                continue;
            }
            var top = bridge ? Color(.29, .50, .44) : (x + y) % 2 == 0 ? Color(.26, .36, .36) : Color(.23, .33, .33);
            Block(float2(x, y), origin, tile, .96, tile * .22, top);
            if (y == 7 || x == 0 || x == 12)
            {
                var at = Project(float2(x, y), origin, tile, tile * .24);
                Draw.Circle(at + float2(0, tile * .27), 1.5, DIM);
                if ((x + y) % 2 == 0) Draw.Line(at + float2(-tile * .50, 0), at + float2(-tile * .12, tile * .18), 2, Color(.53, .48, .27));
            }
        }
    }
    // A pair of stationary generator stacks frames the banks.
    for (var bank = 0; bank < 2; bank++)
    {
        var x = bank == 0 ? .4 : 11.6;
        Block(float2(x, 1), origin, tile, .74, tile * 1.6, Color(.20, .29, .30));
        var at = Project(float2(x, 1), origin, tile, tile * 1.1);
        Draw.RoundRect(at, float2(tile * .6, tile * .40), 3, INK);
        Text(bank == 0 ? "A" : "B", at, tile * .35, bank == 0 ? COPPER : COIL, Anchor.MiddleCenter);
        for (var stripe = 0; stripe < 3; stripe++) Draw.Line(at + float2(-tile * .22, tile * (.40 + stripe * .14)), at + float2(tile * .22, tile * (.40 + stripe * .14)), 2, DIM);
    }
    var rawA = (circuit.probe & 1) != 0;
    var rawB = (circuit.probe & 2) != 0;
    var a = Signal(circuit.gates[0], rawA, false);
    var b = Signal(circuit.gates[1], rawB, false);
    var mixed = Signal(circuit.gates[2], a, b);
    var out = Signal(circuit.gates[3], mixed, false);
    Cable(float2(1, 4), float2(1, 2), rawA, origin, tile, clock);
    Cable(float2(1, 2), float2(2, 2), rawA, origin, tile, clock);
    Cable(float2(2, 2), float2(4, 2), a, origin, tile, clock);
    Cable(float2(4, 2), float2(4, 3), a, origin, tile, clock);
    Cable(float2(11, 4), float2(11, 2), rawB, origin, tile, clock, COIL);
    Cable(float2(11, 2), float2(10, 2), rawB, origin, tile, clock, COIL);
    Cable(float2(10, 2), float2(10, 1.5), b, origin, tile, clock, COIL);
    Cable(float2(10, 1.5), float2(3.5, 1.5), b, origin, tile, clock, COIL);
    Cable(float2(3.5, 1.5), float2(3.5, 3), b, origin, tile, clock, COIL);
    Cable(float2(4, 3), float2(8, 3), mixed, origin, tile, clock, GOLD);
    Cable(float2(8, 3), float2(8, 4), out, origin, tile, clock, GOLD);
    if (station.level == 5)
    {
        Cable(float2(8, 4), float2(10, 4), out, origin, tile, clock, GOLD);
        Cable(float2(11, 6), float2(10, 6), (circuit.probe & 4) != 0, origin, tile, clock, COIL);
        Cable(float2(10, 6), float2(10, 4), (circuit.probe & 4) != 0, origin, tile, clock, COIL);
    }
    for (var robot = 0; robot < 2; robot++)
    {
        var cell = Pad(robot);
        var color = robot == 0 ? COPPER : COIL;
        var at = Project(float2(cell % WIDTH, cell / WIDTH), origin, tile, 8);
        var ready = circuit.robot[robot] == cell;
        Draw.Ellipse(at, float2(tile * .69, tile * .30), ready ? color : Color(.14, .24, .25));
        Draw.WireEllipse(at, float2(tile * .69, tile * .30), 2, color);
        Text("SYNC", at + float2(0, tile * .9), Math.Max(9, tile * .28), color, Anchor.MiddleCenter);
        var exit = Exit(robot);
        var foot = float2(exit % WIDTH, exit / WIDTH);
        if (circuit.powered) Block(foot, origin + float2(0, -3), tile, .85, 3, COIL);
        var lever = Lever(robot);
        var p = Project(float2(lever % WIDTH, lever / WIDTH), origin, tile, 11);
        Block(float2(lever % WIDTH, lever / WIDTH), origin, tile, .48, tile * .20, Color(.15, .24, .25));
        Draw.Line(p, p + float2((robot == 0 ? rawA : rawB) ? 9.0 : -9.0, -17), 5, color);
        Draw.Circle(p + float2((robot == 0 ? rawA : rawB) ? 9.0 : -9.0, -17), 5, CREAM);
    }
    for (var index = 0; index < (station.level == 5 ? 5 : 4); index++)
    {
        var cell = Socket(index);
        var foot = float2(cell % WIDTH, cell / WIDTH);
        var color = Editable(station.level, index) ? SocketOwner(index) == 0 ? COPPER : COIL : DIM;
        Block(foot, origin, tile, .74, tile * .56, Color(.15, .25, .27));
        var p = Project(foot, origin, tile, tile * .66);
        Draw.RoundRect(p, float2(tile * 1.16, tile * .54), 4, INK);
        Draw.WireRoundRect(p, float2(tile * 1.16, tile * .54), 4, 1, color);
        Text(GateName(circuit.gates[index]), p, Math.Max(9, tile * .29), color, Anchor.MiddleCenter);
        Text(SocketName(index), p + float2(0, -tile * .61), Math.Max(9, tile * .25), DIM, Anchor.MiddleCenter);
    }
    for (var robot = 0; robot < 2; robot++)
    {
        var cell = circuit.robot[robot];
        var goal = float2(cell % WIDTH, cell / WIDTH);
        if (desk.serial != station.serial) desk.drawn[robot] = goal;
        else desk.drawn[robot] = Math.Lerp(desk.drawn[robot], goal, desk.reducedMotion ? 1 : Math.Min(1, Frame.dt * 18));
        var active = Together(station) ? robot == Seat(station, session.player) : robot == desk.active || desk.couch;
        Robot(desk.drawn[robot], robot, active && lobby.page != Page.Title, origin, tile, clock);
    }
    desk.serial = station.serial;
    if (!narrow && lobby.page != Page.Title)
    {
        var y = h - 142;
        Text(circuit.powered ? "THE STATION IS WAKING UP" : "BUILD THE CIRCUIT. BRING THE LIGHT.", float2(worldW * .5, y), 11, DIM, Anchor.MiddleCenter);
        var amount = circuit.powered ? 1.0 : circuit.charge / 36.0;
        Draw.RoundRect(float2(worldW * .5, y + 19), float2(160, 5), 2, Color(.16, .27, .28));
        if (amount > 0) Draw.RoundRect(float2(worldW * .5 - 80 + amount * 80, y + 19), float2(160 * amount, 5), 2, COIL);
    }
}
