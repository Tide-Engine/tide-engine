using Rooms;

settings
{
    title = "Copper & Coil";
    appId = "dev.tideengine.coppercoil";
    tickRate = 30;
    maxPlayers = 2;
    hostMigration = true;
}

const int CHAMBERS = 6;
const int WIDTH = 13;
enum Gate { Wire, Not, And, Or, Xor }
enum Cue { Step, Change, Blocked, Power, Complete, Reset }

struct Circuit
{
    Gate[5] gates;
    int[2] robot;
    int probe;
    int moves;
    int charge;
    bool powered;
    bool solved;
}
singleton Station
{
    Circuit circuit;
    Circuit[128] history;
    int historyCount;
    int level;
    int serial;
    int completed;
    bool initialized;
    Map<PlayerID, int> seats;
    PlayerID[2] players;
    bool[2] present;
}
scene Main { }
command Operate { int serial; int robot; int action; }
command Probe { int serial; int row; }
command Rewind { int serial; }
command Restart { int serial; }
command Visit { int serial; int level; }
event Feedback { Cue kind; int robot; }

int Cell(int x, int y) { return y * WIDTH + x; }
int Socket(int index)
{
    switch (index)
    {
        case 0: return Cell(2, 2);
        case 1: return Cell(10, 2);
        case 2: return Cell(4, 3);
        case 3: return Cell(8, 3);
    }
    return Cell(10, 4);
}
int SocketOwner(int index) { return index == 0 || index == 2 ? 0 : 1; }
int Pad(int robot) { return Cell(robot == 0 ? 3 : 9, 6); }
int Exit(int robot) { return Cell(robot == 0 ? 5 : 7, 4); }
int Lever(int robot) { return Cell(robot == 0 ? 1 : 11, 4); }
int Distance(int a, int b) { return Math.Abs(a % WIDTH - b % WIDTH) + Math.Abs(a / WIDTH - b / WIDTH); }
int Rows(int level) { return level == 5 ? 8 : 4; }
int Target(int level)
{
    switch (level)
    {
        case 0: return 8;  // A AND B
        case 1: return 2;  // A AND NOT B
        case 2: return 6;  // A XOR B
        case 3: return 1;  // NOT (A OR B)
        case 4: return 9;  // A equals B
    }
    return 96;            // (A XOR B) AND C
}
bool Editable(int level, int socket)
{
    if (socket == 2) return true;
    if (socket == 0) return level >= 4;
    if (socket == 1) return level == 1 || level >= 4;
    if (socket == 3) return level >= 3;
    return socket == 4 && level == 5;
}
Gate NextGate(int socket, Gate gate)
{
    if (socket == 0 || socket == 1 || socket == 3) return gate == Gate.Wire ? Gate.Not : Gate.Wire;
    return gate == Gate.And ? Gate.Or : gate == Gate.Or ? Gate.Xor : Gate.And;
}
bool Signal(Gate gate, bool a, bool b)
{
    switch (gate)
    {
        case Gate.Not: return !a;
        case Gate.And: return a && b;
        case Gate.Or: return a || b;
        case Gate.Xor: return a != b;
    }
    return a;
}
bool Output(int level, Circuit circuit, int row)
{
    var a = Signal(circuit.gates[0], (row & 1) != 0, false);
    var b = Signal(circuit.gates[1], (row & 2) != 0, false);
    var mixed = Signal(circuit.gates[2], a, b);
    var out = Signal(circuit.gates[3], mixed, false);
    return level == 5 ? Signal(circuit.gates[4], out, (row & 4) != 0) : out;
}
int Truth(int level, Circuit circuit)
{
    mut var result = 0;
    for (var row = 0; row < Rows(level); row++) if (Output(level, circuit, row)) result |= 1 << row;
    return result;
}
bool Floor(int cell, bool powered)
{
    if (cell < 0 || cell >= 117) return false;
    var x = cell % WIDTH;
    var y = cell / WIDTH;
    if (y == 0 || y == 8) return false;
    if (x <= 4 || x >= 8) return true;
    return powered && (y == 4 || y == 5);
}
bool Obstacle(int cell, int level)
{
    for (var i = 0; i < (level == 5 ? 5 : 4); i++) if (cell == Socket(i)) return true;
    return cell == Lever(0) || cell == Lever(1) || level == 5 && cell == Cell(11, 6);
}
void Load(mut Station station, int level)
{
    station.level = Math.Clamp(level, 0, CHAMBERS - 1);
    station.serial++;
    station.historyCount = 0;
    station.initialized = true;
    station.circuit = Circuit { robot = [Cell(2, 6), Cell(10, 6)], gates = [Gate.Wire, Gate.Wire, Gate.Or, Gate.Wire, Gate.Or] };
    if (level == 2) station.circuit.gates[2] = Gate.And;
    if (level >= 3) station.circuit.gates[2] = Gate.Xor;
    if (level == 4) station.circuit.gates[2] = Gate.Or;
    if (level == 5) station.circuit.gates[2] = Gate.And;
}
int Seat(Station station, PlayerID player)
{
    if (!station.seats.Has(player)) return -1;
    var seat = station.seats[player];
    return seat >= 0 && seat < 2 && station.present[seat] ? seat : -1;
}
bool Together(Station station) { return station.present[0] && station.present[1]; }
bool Allowed(Station station, PlayerID sender, int serial)
{
    return station.initialized && station.serial == serial && Seat(station, sender) >= 0;
}
void Remember(mut Station station)
{
    if (station.historyCount == 128)
    {
        for (var i = 1; i < 128; i++) station.history[i - 1] = station.history[i];
        station.historyCount--;
    }
    station.history[station.historyCount++] = station.circuit;
}
int Nearby(int level, Circuit circuit, int robot)
{
    for (var i = 0; i < 5; i++)
        if (Editable(level, i) && SocketOwner(i) == robot && Distance(circuit.robot[robot], Socket(i)) <= 1) return i;
    if (Distance(circuit.robot[robot], Lever(robot)) <= 1) return 5 + robot;
    if (level == 5 && robot == 1 && Distance(circuit.robot[robot], Cell(11, 6)) <= 1) return 7;
    return -1;
}
bool Move(int level, mut Circuit circuit, int robot, int direction)
{
    var from = circuit.robot[robot];
    var x = from % WIDTH + (direction == 1 ? 1 : direction == 3 ? -1 : 0);
    var y = from / WIDTH + (direction == 2 ? 1 : direction == 0 ? -1 : 0);
    var to = Cell(x, y);
    if (x < 0 || x >= WIDTH || y < 0 || y >= 9 || !Floor(to, circuit.powered) || Obstacle(to, level)) return false;
    if (to == circuit.robot[1 - robot]) return false;
    circuit.robot[robot] = to;
    circuit.moves++;
    return true;
}
system Initialize(mut Station station)
{
    if (!station.initialized) Load(station, 0);
}
event(PlayerJoined joined) JoinStation(mut Station station)
{
    if (Seat(station, joined.player) >= 0) return;
    mut var seat = -1;
    if (station.seats.Has(joined.player)) seat = station.seats[joined.player];
    else
    {
        if (!station.present[0]) seat = 0;
        else if (!station.present[1]) seat = 1;
        if (seat < 0) return;
        station.seats.Remove(station.players[seat]);
        station.seats[joined.player] = seat;
    }
    if (seat < 0 || seat >= 2 || station.present[seat]) return;
    station.players[seat] = joined.player;
    station.present[seat] = true;
}
event(PlayerLeft left) LeaveStation(mut Station station)
{
    var seat = Seat(station, left.player);
    if (seat >= 0) station.present[seat] = false;
}
command(Operate action, PlayerID sender) Act(mut Station station)
{
    if (!Allowed(station, sender, action.serial) || action.robot < 0 || action.robot >= 2 || action.action < 0 || action.action > 4 || station.circuit.solved) return;
    if (Together(station) && action.robot != Seat(station, sender)) return;
    var before = station.circuit;
    mut var done = false;
    if (action.action < 4) done = Move(station.level, station.circuit, action.robot, action.action);
    else
    {
        var nearby = Nearby(station.level, station.circuit, action.robot);
        if (nearby >= 0 && nearby < 5 && !station.circuit.powered)
        {
            station.circuit.gates[nearby] = NextGate(nearby, station.circuit.gates[nearby]);
            station.circuit.charge = 0;
            station.circuit.moves++;
            done = true;
        }
        else if (nearby >= 5)
        {
            station.circuit.probe ^= 1 << (nearby - 5);
            done = true;
        }
    }
    if (done)
    {
        // Remember the state before the accepted action, including its charge.
        var after = station.circuit;
        station.circuit = before;
        Remember(station);
        station.circuit = after;
    }
    Send(Feedback { kind = !done ? Cue.Blocked : action.action == 4 ? Cue.Change : Cue.Step, robot = action.robot });
}
command(Probe probe, PlayerID sender) TestSignals(mut Station station)
{
    if (!Allowed(station, sender, probe.serial) || probe.row < 0 || probe.row >= Rows(station.level)) return;
    station.circuit.probe = probe.row;
    Send(Feedback { kind = Cue.Change, robot = Seat(station, sender) });
}
command(Rewind rewind, PlayerID sender) Undo(mut Station station)
{
    if (!Allowed(station, sender, rewind.serial) || station.historyCount == 0) return;
    station.circuit = station.history[--station.historyCount];
    Send(Feedback { kind = Cue.Reset, robot = Seat(station, sender) });
}
command(Restart restart, PlayerID sender) Reset(mut Station station)
{
    if (!Allowed(station, sender, restart.serial)) return;
    Load(station, station.level);
    Send(Feedback { kind = Cue.Reset, robot = Seat(station, sender) });
}
command(Visit visit, PlayerID sender) SelectChamber(mut Station station)
{
    if (!Allowed(station, sender, visit.serial) || visit.level < 0 || visit.level >= CHAMBERS) return;
    Load(station, visit.level);
    Send(Feedback { kind = Cue.Reset, robot = Seat(station, sender) });
}
system Commission(mut Station station)
{
    if (!station.initialized || station.circuit.solved) return;
    if (!station.circuit.powered)
    {
        var correct = Truth(station.level, station.circuit) == Target(station.level);
        var ready = station.circuit.robot[0] == Pad(0) && station.circuit.robot[1] == Pad(1);
        var live = Output(station.level, station.circuit, station.circuit.probe);
        station.circuit.charge = correct && ready && live ? station.circuit.charge + 1 : 0;
        if (station.circuit.charge >= 36)
        {
            station.circuit.charge = 0;
            Remember(station);
            station.circuit.charge = 36;
            station.circuit.powered = true;
            Send(Feedback { kind = Cue.Power, robot = 0 });
        }
    }
    else if (station.circuit.robot[0] == Exit(0) && station.circuit.robot[1] == Exit(1))
    {
        station.circuit.solved = true;
        station.completed |= 1 << station.level;
        Send(Feedback { kind = Cue.Complete, robot = 0 });
    }
}
