// CRACKED's mages, as one machine shows them: the Unity game's Magician,
// with its Mixamo clips (art/player/mage.glb, which tools/make_mage.py makes
// of the Unity project's files). The file has no materials: each corner's
// `uv.x` says which of the model's seven parts it's of, and the frag paints
// each as the Unity materials do, with the team's color on the shirt, the
// shield's state on the hood and the player's health as how full the glass
// head is. A dead mage has no head: the glass is in pieces (effects.tide).

// The parts, as `uv.x * 8` counts them.
const int PART_BUCKLE = 0;
const int PART_BOTTOMS = 1;
const int PART_SKIN = 2;
const int PART_GLASS = 3;
const int PART_HOOD = 4;
const int PART_SHIRT = 5;
const int PART_LIQUID = 6;

// The liquid in the head: Liquid.cs's numbers on the Magician prefab's LIQUID
// object, and Liquid.mat's for the LiquidEffect shader graph.
const float LIQUID_WOBBLE = 0.005;       // MaxWobble: the most a frame's movement adds to the tilt
const float LIQUID_SPEED = 2;            // WobbleSpeedMove: sloshes a second
const float LIQUID_RECOVERY = 1;         // Recovery: how fast it settles, a second
const float LIQUID_THICKNESS = 5;        // Thickness: the slowest the slosh follows its sine
const float LIQUID_AMPLITUDE = 0.22;     // _Amplitude: the ripple's height, times the tilt
const float LIQUID_FREQUENCY = 2.43;     // _Frequency: the ripple's turns along a meter
const float LIQUID_FOAM = 0.014;         // _FoamWidth: the white line under the surface, in meters
// Where the LIQUID object is from the head's bone, in the model's own units
const float3 LIQUID_ORIGIN = float3(0, 0.214, 0.007);

// UpperBody.mask's clip in the Unity animator: frames 20 to 41 of the throw.
const float THROW_FROM = 0.667;
const float THROW_LONG = 0.7;

struct Thread
{
    float3 position;
    float3 normal;
    float2 uv;           // x: which part. y: in the liquid, how high as it stands, 0 to 1 (not read)
}

asset SkinnedMesh<Thread> mage = "art/player/mage.glb";

// What one mage's draw says of its player.
struct Robe
{
    Color team = Color.white;
    Color hood = Color.white;
    Color liquidTop = Color.white;
    Color liquidBottom = Color.white;
    float flash;         // White from being hurt, 1 fading to 0
    float3 bowl;         // Where the liquid's own origin is in the world, in the head's middle
    float surface;       // How high over that its surface is, in meters: the player's health
    float wobbleX;       // How its surface tilts, as Liquid.cs gives the shader,
    float wobbleZ;
    float ripple;        // and the shader's clock, in radians
    float glass;         // 0 draws the body and the liquid, 1 the head's glass over them
    float headless;      // 1 once the head has shattered
}

// Each seat's clocks, which only this machine keeps.
local singleton Troupe
{
    float[SEATS] stride;     // Where in a jog's cycle it is, 0 to 1
    float[SEATS] idle;       // Seconds of the idle clip
    float[SEATS] hands;      // How far its hands are up for a reload, 0 to 1
    float[SEATS] moving;     // How much of the jog it shows, eased

    // The liquid in each head, as Liquid.cs keeps it: where the avatar was a
    // frame ago, how much it has been shaken (which settles), the wave that
    // makes a slosh of that, and the tilt the frag gets
    int[SEATS] life;         // The avatar these are of
    float3[SEATS] wasAt;
    quaternion[SEATS] wasTurned;
    float[SEATS] shakenX;    // wobbleAmountToAddX,
    float[SEATS] shakenZ;    // and Z
    float[SEATS] wave;       // sinewave
    float[SEATS] wobbleX;
    float[SEATS] wobbleZ;
    float[SEATS] level;      // How high its surface is, which follows the health (`comp`)
    float clock = 0.5;       // Liquid.cs's time, wrapped where its sine comes round
    float ripple;            // The shader's, in radians
}

frag MageLook(Thread thread, out Color color, Robe robe, Instance instance, Light light, Shadow shadow)
{
    int part = int(thread.uv.x * 8);
    float3 normal = instance.Normal(thread.normal);
    float3 toEye = Math.Normalize(light.eye - this.world);
    // A mage the camera is in, thrown about or against a wall, isn't in its way
    // (the Unity game cuts a hole in what hides its player): it thins out, a pixel here and a pixel there, and is gone
    float near = Math.Distance(light.eye, this.world);
    if (near < 1.9 && (Math.Hash(int2(int(this.position.x), int(this.position.y))) & 255) / 255.0 >= (near - 0.8) / 1.1) this.Discard();
    if (robe.glass > 0.5)
    {
        // The fishbowl: clear in its middle, the Unity material's cyan at its
        // edge, with the sun's glint on it
        if (part != PART_GLASS || robe.headless > 0.5) this.Discard();
        float edge = Math.Pow(1 - Math.Saturate(Math.Abs(Math.Dot(normal, toEye))), 1.8);
        float glint = Math.Pow(Math.Max(Math.Dot(normal, Math.Normalize(SUN + toEye)), 0), 60);
        float3 paint = float3(0.55, 1, 0.98) * (0.75 + 0.5 * edge) + float3(glint * 2);
        color = Color(paint.x, paint.y, paint.z, Math.Saturate(0.13 + 0.6 * edge + glint));
        return;
    }
    if (part == PART_GLASS) this.Discard();
    if (part == PART_LIQUID)
    {
        // The LiquidEffect shader graph. The liquid is what of its ball is
        // under a plane that's level in the world, however the head leans,
        // at the height the player's health says. The wobble tilts the
        // plane, and ripples it by as much as it's tilted, so it's flat when
        // it's still. Unlit: the body is one color with a rim to it, and
        // what shows through the cut, the ball's far side, is the top's
        // color, which reads as the surface. A white line of foam is under
        // the surface's edge.
        if (robe.headless > 0.5) this.Discard();
        float3 d = this.world - robe.bowl;
        float3 tilted = float3(d.x * (1 + robe.wobbleZ) - robe.wobbleX * d.y, d.y + robe.wobbleX * d.x - robe.wobbleZ * d.z,
                               d.z * (1 + robe.wobbleX) + robe.wobbleZ * d.y);
        float wave = Math.Sin(robe.ripple + LIQUID_FREQUENCY * (tilted.x + tilted.z));
        float fill = tilted.y + LIQUID_AMPLITUDE * (Math.Abs(robe.wobbleX) + Math.Abs(robe.wobbleZ)) * wave - robe.surface;
        if (fill > 0) this.Discard();
        if (Math.Dot(normal, toEye) < 0)
        {
            float ring = fill >= -0.1 * LIQUID_FOAM ? 1.0 : 0.0;
            color = Color(robe.liquidTop.r + ring, robe.liquidTop.g + ring, robe.liquidTop.b + ring, 1);
            return;
        }
        float foam = fill >= -LIQUID_FOAM ? 1.0 : 0.0;
        float rim = Math.Pow(1 - Math.Saturate(Math.Dot(normal, toEye)), 2);
        Color body = Mix(robe.liquidBottom, Color.white, foam);
        color = Color(body.r + 0.2211 * rim, body.g, body.b + rim, 1);
        return;
    }
    // The inside of the liquid's hollow is the only back face that shows
    mut Color paint = Color(0.2547, 0.0901, 0.0901);
    if (part == PART_BUCKLE) paint = Color(0.85, 0.62, 0.16);
    if (part == PART_SKIN) paint = Color(0.96, 0.95, 0.93);
    if (part == PART_HOOD) paint = robe.hood;
    if (part == PART_SHIRT) paint = Mix(robe.team, Color(1.6, 1.6, 1.6), robe.flash);
    else paint = Mix(paint, Color.white, robe.flash * 0.35);
    float sun = Sunlight(shadow.depth, this.world, normal, shadow.toLamp, shadow.step);
    color = Lit(paint, normal, this.world, light, sun, part == PART_BUCKLE ? 1.2 : 0.15);
}

// One bone of a pose turned towards another pose's.
void Take(mut Pose pose, Pose from, Bone bone, float weight)
{
    pose[bone].rotation = Math.Slerp(pose[bone].rotation, from[bone].rotation, weight);
}

// A pose's arms and upper back from another pose: the Unity animator's upper
// body layer.
void TakeUpper(mut Pose pose, Pose from, float weight)
{
    var bones = mage.skeleton.bones;
    Take(pose, from, bones.spine002, weight);
    Take(pose, from, bones.spine003, weight);
    Take(pose, from, bones.shoulderL, weight);
    Take(pose, from, bones.upper_armL, weight);
    Take(pose, from, bones.forearmL, weight);
    Take(pose, from, bones.handL, weight);
    Take(pose, from, bones.shoulderR, weight);
    Take(pose, from, bones.upper_armR, weight);
    Take(pose, from, bones.forearmR, weight);
    Take(pose, from, bones.handR, weight);
}

// A mage's pose: the idle, the jogs by which way it goes over the ground,
// the throw over its arms for a moment after a shot, its hands up while it
// reloads, and its upper body turned to where its player looks.
Pose MagePose(Seat seat, float stride, float idle, float moving, float threw, float hands)
{
    var clips = mage.animations;
    mut var pose = clips.idle.Sample(idle, Playback.Loop);
    if (seat.dead) return pose;
    if (moving > 0.01)
    {
        var speed = Math.Length(seat.localVelocity);
        var way = speed > 0.05 ? seat.localVelocity / speed : float2(0, 1);
        mut var jog = way.y >= 0 ? clips.jogForward.Sample(stride * clips.jogForward.duration, Playback.Loop)
                                 : clips.jogBackward.Sample(stride * clips.jogBackward.duration, Playback.Loop);
        var side = way.x >= 0 ? clips.strafeRight.Sample(stride * clips.strafeRight.duration, Playback.Loop)
                              : clips.strafeLeft.Sample(stride * clips.strafeLeft.duration, Playback.Loop);
        jog.Blend(side, Math.Abs(way.x) / Math.Max(Math.Abs(way.x) + Math.Abs(way.y), 0.001));
        pose.Blend(jog, Math.Saturate(moving));
    }
    if (hands > 0.01) TakeUpper(pose, clips.handsUp.Sample(0), Math.Saturate(hands));
    if (threw < THROW_LONG)
    {
        var weight = Math.Saturate(threw / 0.04) * Math.Saturate((THROW_LONG - threw) / 0.25);
        TakeUpper(pose, clips.throw.Sample(THROW_FROM + threw), weight);
    }
    // ShooterBase.UpdateView: the upper body follows the camera, a quarter turn at the most
    var ahead = Math.Rotate(seat.rotation, float3(0, 0, 1));
    mut var turn = seat.yaw - Math.Degrees(Math.Atan2(ahead.x, ahead.z));
    if (turn > 180) turn -= 360;
    if (turn < -180) turn += 360;
    var twist = quaternion.AxisAngle(float3(0, 1, 0), Math.Radians(Math.Clamp(turn, -90, 90)) * 0.5);
    var bones = mage.skeleton.bones;
    Twist(pose, bones.spine002, twist);
    Twist(pose, bones.spine003, twist);
    return pose;
}

// A bone turned about the model's own axes, whichever way the bone's are:
// the turn, taken into the bone's space as it stands in the model.
void Twist(mut Pose pose, Bone bone, quaternion turn)
{
    var stands = pose.Model(bone);
    var model = quaternion.LookRotation(Math.Normalize(Math.Rotate(stands, float3(0, 0, 1))), Math.Normalize(Math.Rotate(stands, float3(0, 1, 0))));
    pose[bone].rotation = Math.Mul(pose[bone].rotation, Math.Mul(Math.Conjugate(model), Math.Mul(turn, model)));
}

float4x4 MagePlace(Seat seat)
{
    return float4x4.TRS(seat.position, seat.rotation, float3(MODEL_SCALE * seat.settings.size));
}

// The hood says what the shield is doing: the Unity material's blue when
// it's ready, a bright cyan while it's up, and from black to white as it
// comes back.
Color HoodColor(Seat seat)
{
    if (seat.shieldActive) return Color(0.1, 0.9, 1);
    if (seat.shieldCooldown <= 0) return Color(0, 0.26, 1);
    var back = 1 - Math.Saturate(seat.shieldCooldown / Math.Max(seat.settings.shieldCooldown, 0.01));
    return Color(back * 0.85, back * 0.85, back * 0.85);
}

// PlayerHealth._healthCurve: how full the head is for a share of the health.
// A Unity curve's five keys, each a time, a value and a slope.
float Fullness(float health)
{
    if (health <= 0.05488) return Hermite(-0.00124, 0.21590, 1.84784, 0.05488, 0.31010, 1.26495, health);
    if (health <= 0.22690) return Hermite(0.05488, 0.31010, 1.26495, 0.22690, 0.49759, 0.84777, health);
    if (health <= 0.43988) return Hermite(0.22690, 0.49759, 0.84777, 0.43988, 0.64777, 0.53801, health);
    return Hermite(0.43988, 0.64777, 0.53801, 1, 1, 0.53223, health);
}

float Hermite(float t0, float v0, float m0, float t1, float v1, float m1, float at)
{
    var wide = t1 - t0;
    var t = Math.Saturate((at - t0) / wide);
    return (2 * t * t * t - 3 * t * t + 1) * v0 + (t * t * t - 2 * t * t + t) * wide * m0
         + (-2 * t * t * t + 3 * t * t) * v1 + (t * t * t - t * t) * wide * m1;
}

// How high the liquid's surface is over its origin, in meters, as Liquid.cs
// and PlayerHealth work `_FillAmount` out: a fill of 0.98 (and half of what
// the mage is bigger by), less what the health compensates of the bounds of
// the mesh the script was given, which is the asset pack's potion and not
// the head's (center 0.09177 up, 1.09979 from that to its lowest point).
// Empty with no health, and all but full with all of it.
float SurfaceHeight(Seat seat)
{
    var scale = MODEL_SCALE * seat.settings.size;
    var share = Math.Saturate(float(seat.health) / Math.Max(seat.maxHealth, 1));
    return 0.5 + scale * 0.09177 - (0.98 + (seat.settings.size - 1) * 0.5) + 0.45 * Fullness(share) * scale * 1.09979;
}

// Liquid.cs's Update for one seat: the liquid is shaken by how fast its
// mage moves and turns, a little more every frame and never more than
// MaxWobble a frame, settles by Recovery, and sloshes on a sine the faster
// the mage goes. The Unity script goes by its own object's place, under the
// head's bone; this goes by the avatar's, as this frame shows it.
void Slosh(mut Troupe troupe, int s, float3 at, quaternion turned, float dt)
{
    if (dt <= 0) return;
    troupe.shakenX[s] += (0 - troupe.shakenX[s]) * Math.Saturate(dt * LIQUID_RECOVERY);
    troupe.shakenZ[s] += (0 - troupe.shakenZ[s]) * Math.Saturate(dt * LIQUID_RECOVERY);
    var velocity = (troupe.wasAt[s] - at) / dt;
    // How fast it turns, in radians a second about each axis, from the turn since the last frame
    mut var between = Math.Mul(turned, Math.Conjugate(troupe.wasTurned[s])).value;
    mut var turning = float3(0);
    if (Math.Abs(between.w) <= 1023.5 / 1024.0)
    {
        if (between.w < 0) between = -between;
        var angle = Math.Acos(Math.Clamp(between.w, -1, 1));
        turning = float3(between.x, between.y, between.z) * (2 * angle / (Math.Sin(angle) * dt));
    }
    // The script reads last frame's speeds here, and works this frame's out after: a frame's difference
    var pulse = Math.TAU * LIQUID_SPEED;
    troupe.wave[s] += (Math.Sin(pulse * troupe.clock) - troupe.wave[s])
                    * Math.Saturate(dt * Math.Clamp(Math.Length(velocity) + Math.Length(turning), LIQUID_THICKNESS, 10));
    troupe.wobbleX[s] = troupe.shakenX[s] * troupe.wave[s];
    troupe.wobbleZ[s] = troupe.shakenZ[s] * troupe.wave[s];
    troupe.shakenX[s] += Math.Clamp((velocity.x + velocity.y * 0.2 + turning.z + turning.y) * LIQUID_WOBBLE, -LIQUID_WOBBLE, LIQUID_WOBBLE);
    troupe.shakenZ[s] += Math.Clamp((velocity.z + velocity.y * 0.2 + turning.x + turning.y) * LIQUID_WOBBLE, -LIQUID_WOBBLE, LIQUID_WOBBLE);
}

// The seats' clocks move on.
[Stage(Layers.Prepare, 2)]
view Paces(Arena arena, Shown shown, Fx fx, mut Troupe troupe)
{
    troupe.clock += fx.dt;
    if (troupe.clock > 1 / LIQUID_SPEED) troupe.clock -= 1 / LIQUID_SPEED;
    troupe.ripple += fx.dt;
    if (troupe.ripple > Math.TAU) troupe.ripple -= Math.TAU;
    for (var s = 0; s < SEATS; s++)
    {
        var seat = arena.seats[s];
        // Another avatar's liquid is still: it wasn't thrown here from where the last one fell
        if (seat.alive && troupe.life[s] == seat.life)
        {
            Slosh(troupe, s, shown.position[s], shown.rotation[s], fx.dt);
            troupe.level[s] += (SurfaceHeight(seat) - troupe.level[s]) * Math.Saturate(fx.dt * 10);
        }
        else
        {
            troupe.level[s] = SurfaceHeight(seat);
            troupe.shakenX[s] = 0;
            troupe.shakenZ[s] = 0;
            troupe.wobbleX[s] = 0;
            troupe.wobbleZ[s] = 0;
        }
        troupe.life[s] = seat.life;
        troupe.wasAt[s] = shown.position[s];
        troupe.wasTurned[s] = shown.rotation[s];
        if (!seat.alive || seat.dead) continue;
        var speed = Math.Length(seat.localVelocity);
        // A jog's cycle covers about 2.6 meters: slower feet under a slow body
        troupe.stride[s] = Math.Frac(troupe.stride[s] + fx.dt * Math.Clamp(speed / 2.6, 0.9, 2.4));
        troupe.idle[s] += fx.dt;
        if (troupe.idle[s] > mage.animations.idle.duration) troupe.idle[s] -= mage.animations.idle.duration;
        var moving = Math.Saturate(speed) * (seat.grounded ? 1 : 0.45);
        troupe.moving[s] += (moving - troupe.moving[s]) * Math.Saturate(fx.dt * 12);
        troupe.hands[s] += ((seat.reloading ? 1.0 : 0.0) - troupe.hands[s]) * Math.Saturate(fx.dt * 9);
    }
}

// The mages in the sun's image and in the eye's depth, after the blocks.
[Stage(Layers.Shadow, 2)]
view MageShadows(Arena arena, Shown shown, Air air, Troupe troupe, Shadow shadow, Depths depths)
{
    for (var s = 0; s < SEATS; s++)
    {
        if (!arena.seats[s].alive) continue;
        var seat = Seen(arena, shown, s);
        var pose = MagePose(seat, troupe.stride[s], troupe.idle[s], troupe.moving[s], air.threw[s], troupe.hands[s]);
        shadow.map.SkinnedMesh(mage, MagePlace(seat), pose);
        depths.map.SkinnedMesh(mage, MagePlace(seat), pose);
    }
}

// The mages: body and liquid first, then every head's glass over them, which
// is seen through and hides nothing.
[Stage(Layers.World, 2)]
view Mages(Arena arena, Shown shown, Air air, Troupe troupe, Post post)
{
    for (var pass = 0; pass < 2; pass++)
    {
        for (var s = 0; s < SEATS; s++)
        {
            if (!arena.seats[s].alive || (pass == 1 && arena.seats[s].dead)) continue;
            var seat = Seen(arena, shown, s);
            var pose = MagePose(seat, troupe.stride[s], troupe.idle[s], troupe.moving[s], air.threw[s], troupe.hands[s]);
            // PlayerHealth.UpdateView: the liquid goes green by how poisoned its player is
            var poisoned = Math.Saturate(seat.poisonLevel);
            var robe = Robe { team = TeamColor(seat.team), hood = HoodColor(seat),
                              liquidTop = Mix(Color(0.745, 0, 1), Color(0.678, 1, 0.184), poisoned),
                              liquidBottom = Mix(Color(1, 0, 0.0155), Color(0, 1, 0), poisoned),
                              flash = air.flash[s],
                              bowl = Math.Transform(Math.Mul(MagePlace(seat), pose.Model(mage.skeleton.bones.head)), LIQUID_ORIGIN),
                              surface = troupe.level[s], wobbleX = troupe.wobbleX[s], wobbleZ = troupe.wobbleZ[s], ripple = troupe.ripple,
                              glass = pass, headless = seat.dead ? 1 : 0 };
            if (pass == 0)
            {
                post.scene.Cull(Cull.None)
                {
                    post.scene.SkinnedMesh(mage, MagePlace(seat), pose, MageLook, robe);
                }
            }
            else
            {
                post.scene.Depth(Depth.Read)
                {
                    post.scene.SkinnedMesh(mage, MagePlace(seat), pose, MageLook, robe);
                }
            }
        }
    }
}
