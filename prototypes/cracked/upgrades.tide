// CRACKED: the upgrade database, in the Unity game's order (Upgrade
// Database.asset), each card as its asset has it: what it does to a player's
// stats (IPlayerModifier), and the modifiers and effects it adds.

enum Rarity { Common, Uncommon, Rare, Legendary }

Rarity UpgradeRarity(int upgrade)
{
    switch (upgrade)
    {
        case 0: case 1: case 4: case 7: case 8: case 11: case 13: case 16: case 20: case 23: case 28: case 30:
            return Rarity.Common;
        case 2: case 3: case 5: case 6: case 9: case 10: case 14: case 22: case 27: case 32: case 33: case 36: case 37:
            return Rarity.Uncommon;
    }
    return Rarity.Rare;
}

// UpgradeScriptable.weight: how likely a card is to be offered.
float UpgradeWeight(int upgrade)
{
    switch (UpgradeRarity(upgrade))
    {
        case Rarity.Common: return 100;
        case Rarity.Uncommon: return 60;
        case Rarity.Rare: return 25;
    }
    return 8;
}

