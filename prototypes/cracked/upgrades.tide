// A card's lines, as the Unity game's cards have them.
string UpgradeText(int upgrade)
{
    switch (upgrade)
    {
        case 0: return "- Block Cooldown\n+ HP";
        case 1: return "+ Bullet size\n+ Small player\n- Reload speed";
        case 2: return "+ 5 Bullets\n- Damage\n- Reload speed";
        case 3: return "Bullets fragment on impact\n- Bullet speed\n- Reload speed";
        case 4: return "+ HP\n- Attack speed\n- Reload speed";
        case 5: return "Dash on block";
        case 6: return "Second Delayed Block";
        case 7: return "+ HP\n+ Bullet speed\n- Reload speed";
        case 8: return "+ MORE Damage\n- Health\n- Reload speed";
        case 9: return "Slows and damages on block\n+ Faster Movement";
        case 10: return "Doubles Damage\n- 2 Bullets\n- Reload speed";
        case 11: return "Spreads incoming damage over time";
        case 12: return "+ Bullet speed\n+ Damage\n- Atk Speed\n- Reload speed";
        case 13: return "Half Speed On Bounce\n+ 2 Bounces\n+ Fire Rate\n- Reload speed";
        case 14: return "++ HP";
        case 15: return "Much Faster Reloading";
        case 16: return "+2 bounces\n- Reload speed";
        case 17: return "+ Mega attack speed\n+ 12 magazine size\n- DMG\n- Reload speed";
        case 18: return "+ Homing\n- Damage\n- Reload speed";
        case 19: return "Adds a shotgun vibe to your attack";
        case 20: return "+ Bullet speed\n- Reload speed";
        case 21: return "+ Damages over time\n+ Bullets grow\n- Reload speed";
        case 22: return "Doubles Damage\n- Atk spd\n- Reload speed";
        case 23: return "+ Bullet speed\n- Atk speed\n- Reload speed";
        case 24: return "+ Wall Penetration\n+ Damage";
        case 25: return "+ Jetpack";
        case 26: return "+ Bullets Create Poison";
        case 27: return "+ Bullet Knockback\n- Damage";
        case 28: return "+ Jump Height\n+ Reload Speed";
        case 29: return "+ Reload On Successful Hit\n- Reload Speed";
        case 30: return "+ Extra Jump";
        case 31: return "+ Stun Players\n+ Reload Speed";
        case 32: return "+ Shocks Nearby Players\n+ Faster Movement";
