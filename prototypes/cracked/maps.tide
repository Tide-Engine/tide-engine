Color MapPaint2(Paint paint)
{
    switch (paint)
    {
        case Paint.Green: return Color(0.29803923, 0.76862746, 0.13333334);
        case Paint.Grey: return Color(0.32941177, 0.32941177, 0.32941177);
        case Paint.Orange: return Color(1, 0.64708, 0);
        case Paint.Purple: return Color(0, 0.68235296, 1);
        case Paint.Red: return Color(1, 0, 0.07843113);
        case Paint.Blue: return Color(0, 0.526696, 0.7735849);
        case Paint.Brown: return Color(0.5372549, 0.25882354, 0.06666666);
        case Paint.Yellow: return Color(0.7921569, 0.67058825, 0);
    }
    return Color.white;
}

// Map6
void BuildMap3(mut List<Piece> pieces, mut List<Mover> movers, mut List<Block> blocks, mut List<SpawnLine> spawns)
{
    // 0: Map6/MovingPlatform-shielded
    movers.Add(Mover { kind = MoverKind.Slide, origin = float3(-5, 0.5, 11), travel = float3(0, 0, -16.5), speedMin = 0.6, speedMax = 0.6 });
    // 1: Map6/MovingPlatform-shielded (1)
    movers.Add(Mover { kind = MoverKind.Slide, origin = float3(5, 0.5, -5.5), travel = float3(0, 0, 16.5), speedMin = 0.6, speedMax = 0.6 });
    // 0: Map6/House (2)/Plane - Pushable (6)
    blocks.Add(Block { origin = float3(-4.92, 5.06, 2.0171), mass = 15, damping = 1, knockback = 0.5 });
    // 1: Map6/House (2)/Trapezoid - Pushable
    blocks.Add(Block { origin = float3(-10.05038, 6.57, 3.0471), mass = 60, damping = 1, knockback = 0.5 });
    // 2: Map6/House (2)/Cube L - Pushable (5)
    blocks.Add(Block { origin = float3(-8.05038, 2.53, 2.9971), originRotation = quaternion(0.70710635, -0.7071072, -0.0000004, 0.0000004), mass = 20, damping = 1, knockback = 0.5 });
    // 3: Map6/House (2)/Cube L - Pushable (7)
    blocks.Add(Block { origin = float3(-12.05038, 2.530005, 1.477101), originRotation = quaternion(0.0000001, -0.0000001, 0.7071072, -0.70710635), mass = 20, damping = 1, knockback = 0.5 });
    // 4: Map6/House (2)/Plane - Pushable
    blocks.Add(Block { origin = float3(-10.05038, 4.537, 2.0171), mass = 15, damping = 1, knockback = 0.5 });
    // 5: Map6/House (2)/Plane - Pushable (2)
    blocks.Add(Block { origin = float3(-12.76038, 2.764, 2.0171), originRotation = quaternion(0, 0, 0.70710707, 0.7071065), mass = 15, damping = 1, knockback = 0.5 });
