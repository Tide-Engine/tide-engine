    visuals.Add(Visual { mesh = BlockMesh.PlaneSquare, position = float3(14.61, 1.62, 13.63), scale = float3(0.5, 1, 1), paint = Paint.Blue });
}

Color MapPaint1(Paint paint)
{
    switch (paint)
    {
        case Paint.Green: return Color(0.29803923, 0.76862746, 0.13333334);
        case Paint.Grey: return Color(0.32941177, 0.32941177, 0.32941177);
        case Paint.Orange: return Color(1, 0.64708, 0);
        case Paint.Purple: return Color(0, 1, 0.7064221);
        case Paint.Red: return Color(1, 0, 0.0766139);
        case Paint.Blue: return Color(1, 0.33490568, 0.6655741);
        case Paint.Brown: return Color(0.5372549, 0.25882354, 0.06666666);
        case Paint.Yellow: return Color(0.7921569, 0.67058825, 0);
    }
    return Color.white;
}

