Color MapPaint4(Paint paint)
{
    switch (paint)
    {
        case Paint.Green: return Color(0.13333333, 0.7441021, 0.76862746);
        case Paint.Grey: return Color(0.32941177, 0.32941177, 0.32941177);
        case Paint.Orange: return Color(0.17664576, 1, 0);
        case Paint.Purple: return Color(1, 1, 1);
        case Paint.Red: return Color(0.7948343, 1, 0.11372548);
        case Paint.Blue: return Color(0, 0, 0);
        case Paint.Brown: return Color(0.20492667, 0.5372549, 0.06666666);
        case Paint.Yellow: return Color(0, 0.7921569, 0.11438642);
    }
    return Color.white;
}

