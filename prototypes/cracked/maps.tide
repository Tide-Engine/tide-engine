Color MapPaint0(Paint paint)
{
    switch (paint)
    {
        case Paint.Green: return Color(0.29803923, 0.76862746, 0.13333334);
        case Paint.Grey: return Color(0.32941177, 0.32941177, 0.32941177);
        case Paint.Orange: return Color(1, 0.52549016, 0);
        case Paint.Purple: return Color(0.7921569, 0.18823528, 0.592157);
        case Paint.Red: return Color(1, 0.11372548, 0.17254922);
        case Paint.Blue: return Color(0.01960785, 0.58823514, 0.67058825);
        case Paint.Brown: return Color(0.5372549, 0.25882354, 0.06666666);
        case Paint.Yellow: return Color(0.7921569, 0.67058825, 0);
    }
    return Color.white;
}

