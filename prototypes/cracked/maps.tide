// GENERATED by tools/make_maps.py from the Unity game's map prefabs: do not edit.
// To make it again: python tools/make_maps.py <the extracted maps folder>
// (Map1.json ... Map10.json and meshes/*.obj; it writes this file and art/blocks/*.obj).
//
// The rotation's seven maps, as state.tide has a map: a piece for each
// BoxCollider, what moves them, the blocks that can be pushed, the spawn
// lines, and what is drawn. Positions and rotations are Unity's as they are.
// A piece or a visual on a mover or a block is placed from it:
//   Slide and Lift: the mover's position + local, turned as localRotation says
//   HingeA, HingeB: pivot + the half's rotation * local, that rotation * localRotation
//   a block: its position + its rotation * local, its rotation * localRotation
// A visual has no local fields: on a mover or a block, its position and
// rotation are those. A piece's position and rotation are where it starts
// (a bridge's at its starting angle).

// Fills what the match needs of a map (lists are appended to; the caller clears them).
void BuildMap(int map, mut List<Piece> pieces, mut List<Mover> movers, mut List<Block> blocks, mut List<SpawnLine> spawns)
{
    switch (map)
    {
        case 0: BuildMap0(pieces, movers, blocks, spawns); break;
        case 1: BuildMap1(pieces, movers, blocks, spawns); break;
        case 2: BuildMap2(pieces, movers, blocks, spawns); break;
        case 3: BuildMap3(pieces, movers, blocks, spawns); break;
        case 4: BuildMap4(pieces, movers, blocks, spawns); break;
        case 5: BuildMap5(pieces, movers, blocks, spawns); break;
        case 6: BuildMap6(pieces, movers, blocks, spawns); break;
    }
}

// Fills what is drawn of a map.
void BuildMapVisuals(int map, mut List<Visual> visuals)
{
    switch (map)
    {
        case 0: BuildMapVisuals0(visuals); break;
        case 1: BuildMapVisuals1(visuals); break;
        case 2: BuildMapVisuals2(visuals); break;
        case 3: BuildMapVisuals3(visuals); break;
        case 4: BuildMapVisuals4(visuals); break;
        case 5: BuildMapVisuals5(visuals); break;
        case 6: BuildMapVisuals6(visuals); break;
    }
}

// The map's palette color for a paint (Paint.Own gives white).
Color MapPaint(int map, Paint paint)
{
    switch (map)
    {
        case 0: return MapPaint0(paint);
        case 1: return MapPaint1(paint);
        case 2: return MapPaint2(paint);
        case 3: return MapPaint3(paint);
        case 4: return MapPaint4(paint);
        case 5: return MapPaint5(paint);
        case 6: return MapPaint6(paint);
    }
    return Color.white;
}

string MapName(int map)
{
    switch (map)
    {
        case 0: return "Map1";
        case 1: return "Map2";
        case 2: return "Map4";
        case 3: return "Map6";
        case 4: return "Map7";
        case 5: return "Map9";
        case 6: return "Map10";
    }
    return "";
}

// Which sky a map has: its place in the rotation.
int MapSky(int map)
{
    return map;
}

// A map's light: the color its light override has, and that light's temperature and intensity.
Color MapLight(int map)
{
    switch (map)
    {
        case 0: return Color(1, 1, 1);
        case 1: return Color(1, 1, 1);
        case 2: return Color(1, 1, 1);
        case 3: return Color(1, 1, 1);
        case 4: return Color(1, 1, 1);
        case 5: return Color(1, 1, 1);
        case 6: return Color(1, 1, 1);
    }
    return Color.white;
}

float MapKelvin(int map)
{
    switch (map)
    {
        case 0: return 5000;
        case 1: return 20000;
        case 2: return 5000;
        case 3: return 1500;
        case 4: return 20000;
        case 5: return 6000;
        case 6: return 6000;
    }
    return 5000;
}

float MapIntensity(int map)
{
    switch (map)
    {
        case 0: return 2;
        case 1: return 1.5;
        case 2: return 2;
        case 3: return 2.5;
        case 4: return 1;
        case 5: return 1;
        case 6: return 1;
    }
    return 1;
}

