using Rooms;

// CRACKED: what's heard. The match's events are sounded by local handlers,
// which hear each once however often a correction runs its tick again, with
// the Unity game's clips at its volumes and pitches. What a player does
// themselves is heard as this machine
// predicts it; a death, a point and a card wait for the server's word
// (`verified`), so none is ever heard and then taken back. The steps, the
// jetpack, a healing mist and the music go on, so views say them each frame.
//
// A sound that has a place is played there, for the listener the camera
// sets; this machine's player's own are played plain, as they're at the
// listener. The master volume is the rooms menu's (Lobby.volume).

asset Clip sfxFire = "sfx/fire.ogg";
asset List<Clip> sfxDings = "sfx/ding*.ogg";
asset List<Clip> sfxShatters = "sfx/shatter*.ogg";
asset List<Clip> sfxSteps = "sfx/step*.ogg";
asset List<Clip> sfxSplashes = "sfx/splash*.ogg";
asset List<Clip> sfxBodies = "sfx/body*.ogg";
asset List<Clip> sfxConcretes = "sfx/concrete*.ogg";
asset List<Clip> sfxExplodes = "sfx/explode*.ogg";
asset List<Clip> sfxShields = "sfx/shield*.ogg";
asset List<Clip> sfxReadies = "sfx/ready*.ogg";
asset Clip sfxDeflect = "sfx/deflect.ogg";
asset Clip sfxPad = "sfx/pad.ogg";
asset Clip sfxFreeze = "sfx/freeze.ogg";
asset Clip sfxZap = "sfx/zap.ogg";
asset Clip sfxJetpack = "sfx/jetpack.ogg";
asset Clip sfxHealing = "sfx/healing.ogg";
asset Clip sfxMusic = "sfx/music.ogg";

// The scene's music volume.
const float MUSIC_VOLUME = 0.5;
// Within this far of the listener a sound is at its volume, about as far as
// the camera stands from its player, and it's gone past the other.
const float SOUND_NEAR = 7;
const float SOUND_FAR = 90;
// A step's length, in meters.
const float STRIDE = 1.9;

local singleton Heard
{
    int seat = -1;               // This machine's player's
    float3[SEATS] at;            // Where each seat was last frame, for a handler to play at
    float3[SEATS] was;           // ...and the frame before, for how far it walked
    float[SEATS] walked;
    bool[SEATS] grounded;
    float[SEATS] fall;           // How fast it was last falling
    float[SEATS] fuel;
    int[SEATS] health;
    bool shieldReady = true;
    List<int> pads;              // The jump pads that threw someone since the last frame
    Sound music;
    Sound jet;
    Sound mist;
}

// One of a glob's clips, at a volume and a pitch in a range, at a seat's
// place, or plain when the seat is this machine's player's.
void SoundSeat(Heard heard, int seat, Clip clip, float low, float high, float pitchLow, float pitchHigh)
{
    var volume = Random.NextFloat(low, high);
    var pitch = Random.NextFloat(pitchLow, pitchHigh);
    if (seat < 0 || seat >= SEATS || seat == heard.seat) Audio.Play(clip, volume, pitch);
    else Audio.Play(clip, heard.at[seat] + float3(0, 1, 0), volume, pitch);
}

// ShooterBase's fire feedback: the dry thud.
local event(Fired fired) SoundFired(Heard heard)
{
    SoundSeat(heard, fired.seat, sfxFire, 0.2, 0.25, 0.9, 1.5);
}

// The glass rings when it's hit: half the Unity game's 1.1 to 1.37, which
// is past what the mixer has room for over the music.
local event(Hurt hurt) SoundHurt(Heard heard)
{
    SoundSeat(heard, hurt.seat, sfxDings[Random.NextInt(sfxDings.count)], 0.55, 0.68, 0.9, 1.2);
}

// ...and breaks, once the server says it did.
local event(verified Died died) SoundDied(Heard heard)
{
    SoundSeat(heard, died.seat, sfxShatters[Random.NextInt(sfxShatters.count)], 0.6, 0.7, 0.9, 1.1);
}

local event(Shielded shielded) SoundShielded(Heard heard)
{
    SoundSeat(heard, shielded.seat, sfxShields[Random.NextInt(sfxShields.count)], 0.2, 0.3, 0.95, 1.1);
}

// The liquid in the glass, as its mage leaves the ground.
local event(Jumped jumped) SoundJumped(Heard heard)
{
    SoundSeat(heard, jumped.seat, sfxSplashes[Random.NextInt(sfxSplashes.count)], 0.05, 0.1, jumped.again ? 1.2 : 0.9, 1.5);
}

// A jump pad's own sound, at the pad. Where the pad is is in the match's
// list of pieces, which a handler doesn't hear, so the view that follows
// plays it (SoundScene).
local event(PadUsed used) SoundPad(mut Heard heard)
{
    heard.pads.Add(used.piece);
}

local event(FreezeBurst burst) SoundFreeze(Heard heard)
{
    SoundSeat(heard, burst.seat, sfxFreeze, 0.5, 0.6, 0.95, 1.05);
}

local event(Zapped zapped) SoundZapped(Heard heard)
{
    SoundSeat(heard, zapped.other, sfxZap, 0.2, 0.2, 0.9, 1.1);
}

// A bullet met something: a shield turned it, a player took it, or a wall
// did, and its last meeting is the louder one.
local event(BulletHit hit) SoundBulletHit()
{
    if (hit.what == 2) Audio.Play(sfxDeflect, hit.at, 0.4, Random.NextFloat(0.9, 1.1));
    else if (hit.seat >= 0) Audio.Play(sfxBodies[Random.NextInt(sfxBodies.count)], hit.at, Random.NextFloat(0.3, 0.4), Random.NextFloat(0.9, 1.1));
    else if (hit.what == 1) Audio.Play(sfxExplodes[Random.NextInt(sfxExplodes.count)], hit.at, Random.NextFloat(0.12, 0.16), Random.NextFloat(0.9, 1.2));
    else Audio.Play(sfxConcretes[Random.NextInt(sfxConcretes.count)], hit.at, Random.NextFloat(0.25, 0.3), Random.NextFloat(0.9, 1.2));
}

local event(CloudMade made) SoundCloud()
{
    Audio.Play(sfxSplashes[Random.NextInt(sfxSplashes.count)], made.at, 0.3, Random.NextFloat(0.7, 0.9));
}

// A card is taken: the note the shield plays when it's ready, lower.
local event(verified CardPicked picked) SoundCard()
{
    Audio.Play(sfxReadies[Random.NextInt(sfxReadies.count)], 0.25, 0.75);
}

local event(verified RoundWon won) SoundRoundWon()
{
    Audio.Play(sfxReadies[0], 0.3, won.scored ? 1.5 : 1.0);
    if (won.scored) Audio.Play(sfxReadies[sfxReadies.count - 1], 0.3, 1.0);
}

// What goes on: the music, each seat's steps and landings, a jetpack that
// burns, a mist that heals, and the shield that's ready again.
[Stage(Layers.Hud, 90)]
view SoundScene(Arena arena, Session session, Lobby lobby, mut Heard heard)
{
    Audio.SetFalloff(SOUND_NEAR, SOUND_FAR);
    heard.seat = arena.players.TryGet(session.player, out var seat) ? seat : -1;
    var here = heard.seat >= 0 ? arena.seats[heard.seat].position : float3(0);
    foreach (var pad in heard.pads)
        if (pad >= 0 && pad < arena.pieces.count) Audio.Play(sfxPad, arena.pieces[pad].position, 0.5, Random.NextFloat(0.95, 1.1));
    heard.pads.Clear();

    mut var jet = -1;
    mut var jetNear = 1e9;
    for (var s = 0; s < SEATS; s++)
    {
        var body = arena.seats[s];
        heard.was[s] = heard.at[s];
        heard.at[s] = body.position;
        if (!body.alive || body.dead)
        {
            heard.grounded[s] = false;
            heard.walked[s] = 0;
            heard.fuel[s] = 0;
            heard.health[s] = 0;
            continue;
        }
        var mine = s == heard.seat;
        // Steps: one a stride, while it walks on the ground
        var moved = float2(heard.at[s].x - heard.was[s].x, heard.at[s].z - heard.was[s].z);
        var far = Math.Length(moved);
        if (body.grounded && far < 2) heard.walked[s] += far;
        if (heard.walked[s] > STRIDE)
        {
            heard.walked[s] -= STRIDE;
            SoundSeat(heard, s, sfxSteps[Random.NextInt(sfxSteps.count)], 0.05, 0.1, 0.9, 1.5);
        }
        // A landing: a harder step, and the glass's liquid, by how fast it fell
        if (body.grounded && !heard.grounded[s] && heard.fall[s] > 3)
        {
            var hard = Math.Saturate(heard.fall[s] / 14);
            SoundSeat(heard, s, sfxSteps[Random.NextInt(sfxSteps.count)], 0.15 + 0.2 * hard, 0.2 + 0.25 * hard, 0.7, 0.9);
            SoundSeat(heard, s, sfxSplashes[Random.NextInt(sfxSplashes.count)], 0.08, 0.14, 0.8, 1.1);
        }
        heard.grounded[s] = body.grounded;
        if (!body.grounded) heard.fall[s] = Math.Max(0, -body.velocity.y);
        // Health that came back: a potion's gulp
        if (heard.health[s] > 0 && body.health >= heard.health[s] + 3) SoundSeat(heard, s, sfxSplashes[Random.NextInt(sfxSplashes.count)], 0.15, 0.2, 1.1, 1.3);
        heard.health[s] = body.health;
        // A jetpack burns while its fuel goes down: the nearest one is heard
        var burning = body.settings.hasJetpack && body.jetpackFuel < heard.fuel[s] - 0.0005 && !body.grounded;
        heard.fuel[s] = body.jetpackFuel;
        var near = mine ? 0.0 : Math.Distance(body.position, here);
        if (burning && near < jetNear)
        {
            jet = s;
            jetNear = near;
        }
    }
    heard.jet.clip = sfxJetpack;
    heard.jet.loop = true;
    heard.jet.volume = 0.3;
    heard.jet.spatial = jet >= 0 && jet != heard.seat;
    if (jet >= 0) heard.jet.position = arena.seats[jet].position + float3(0, 1, 0);
    heard.jet.playing = jet >= 0;

    // The nearest mist that heals hums
    mut var mist = false;
    mut var mistNear = 1e9;
    foreach (var cloud in arena.clouds)
    {
        if (cloud.kind != CloudKind.Heal) continue;
        var near = Math.Distance(cloud.position, here);
        if (near >= mistNear) continue;
        mist = true;
        mistNear = near;
        heard.mist.position = cloud.position;
    }
    heard.mist.clip = sfxHealing;
    heard.mist.loop = true;
    heard.mist.spatial = true;
    heard.mist.volume = 0.5;
    heard.mist.playing = mist;

    // The shield is ready again: its note
    if (heard.seat >= 0 && arena.seats[heard.seat].alive && !arena.seats[heard.seat].dead)
    {
        var ready = arena.seats[heard.seat].shieldCooldown <= 0 && !arena.seats[heard.seat].shieldActive;
        if (ready && !heard.shieldReady && lobby.page == Page.Playing) Audio.Play(sfxReadies[Random.NextInt(sfxReadies.count)], Random.NextFloat(0.2, 0.25), 1);
        heard.shieldReady = ready;
    }
    else heard.shieldReady = true;
}

// The music plays whatever page is up, and with no match too.
[Stage(Layers.Hud, 91)]
view SoundMusic(mut Heard heard)
{
    heard.music.clip = sfxMusic;
    heard.music.loop = true;
    heard.music.volume = MUSIC_VOLUME;
    heard.music.playing = true;
}
