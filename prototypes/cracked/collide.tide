// CRACKED: what touches what. A map's colliders are boxes (state.tide), a
// player a capsule and a bullet a ball, so every question the Unity game asks
// PhysX (a sphere cast, a ray, a sphere that's checked, a capsule pushed out
// of what it's in) is answered here from distances to boxes, with + - * / and
// square roots alone: the same on every machine.

const float SKIN = 0.0005;       // Nearer than this, a cast ball touches
const int TRACE_STEPS = 40;      // Steps a cast takes at the most

// The nearest of a shape's surface to a point: how far (under 0 inside),
// where, and which way the surface faces there.
struct Near
{
    float distance;
    float3 point;
    float3 normal;
}

// What a cast met: how far along its way, where the two touch, and the
// surface's normal there. `piece` is its place in the map's pieces.
struct Hit
{
    float distance;
    float3 point;
    float3 normal;
    int piece = -1;
}

Near NearBox(float3 at, float3 center, quaternion rotation, float3 half)
{
    var inverse = Math.Conjugate(rotation);
    var local = Math.Rotate(inverse, at - center);
    var out = Math.Abs(local) - half;
    var clamped = Math.Clamp(local, -half, half);
    if (out.x > 0 || out.y > 0 || out.z > 0)
    {
        var away = local - clamped;
        var far = Math.Length(away);
        return Near { distance = far, point = center + Math.Rotate(rotation, clamped),
                      normal = Math.Rotate(rotation, away / far) };
    }
    // Inside: out through the nearest face
    mut var normal = float3(local.x < 0 ? -1 : 1, 0, 0);
    mut var depth = out.x;
    mut var surface = float3(local.x < 0 ? -half.x : half.x, local.y, local.z);
    if (out.y > depth)
    {
        depth = out.y;
        normal = float3(0, local.y < 0 ? -1 : 1, 0);
        surface = float3(local.x, local.y < 0 ? -half.y : half.y, local.z);
    }
    if (out.z > depth)
    {
        depth = out.z;
        normal = float3(0, 0, local.z < 0 ? -1 : 1);
        surface = float3(local.x, local.y, local.z < 0 ? -half.z : half.z);
    }
    return Near { distance = depth, point = center + Math.Rotate(rotation, surface), normal = Math.Rotate(rotation, normal) };
}

float3 NearOnSegment(float3 at, float3 a, float3 b)
{
    var along = b - a;
    var whole = Math.Dot(along, along);
    if (whole <= 0.0000001) return a;
    return a + along * Math.Saturate(Math.Dot(at - a, along) / whole);
}

// A capsule's surface from a point: a segment, grown by a radius.
Near NearCapsule(float3 at, float3 a, float3 b, float radius)
{
    var on = NearOnSegment(at, a, b);
    var away = at - on;
    var far = Math.Length(away);
    var normal = far > 0.000001 ? away / far : float3(0, 1, 0);
    return Near { distance = far - radius, point = on + normal * radius, normal = normal };
}

// The two points of two segments that are nearest each other.
void NearSegments(float3 a0, float3 a1, float3 b0, float3 b1, out float3 onA, out float3 onB)
{
    onA = (a0 + a1) * 0.5;
    onB = NearOnSegment(onA, b0, b1);
    for (var round = 0; round < 6; round++)
    {
        onA = NearOnSegment(onB, a0, a1);
        onB = NearOnSegment(onA, b0, b1);
    }
}

// A ball moved along `way` (of length 1) for `length`, against one box:
// whether it touches it on the way, and where. A ball that starts in the box
// is met at 0, with the normal against its way, as PhysX says of a sweep that
// starts overlapping.
bool SweepBox(float3 from, float3 way, float length, float radius, float3 center, quaternion rotation, float3 half, out Hit hit)
{
    hit = Hit { };
    mut var gone = 0.0;
    for (var step = 0; step < TRACE_STEPS; step++)
    {
        var near = NearBox(from + way * gone, center, rotation, half);
        var gap = near.distance - radius;
        if (gap <= SKIN)
        {
            if (step == 0)
            {
                hit = Hit { distance = 0, point = from, normal = -way };
                return true;
            }
            // Moving away from it: a graze that isn't a hit
            if (Math.Dot(near.normal, way) >= 0) return false;
            hit = Hit { distance = gone, point = near.point, normal = near.normal };
            return true;
        }
        gone += gap;
        if (gone > length) return false;
    }
    return false;
}

// The same against a capsule: a player's hitbox.
bool SweepCapsule(float3 from, float3 way, float length, float radius, float3 a, float3 b, float capsuleRadius, out Hit hit)
{
    hit = Hit { };
    mut var gone = 0.0;
    for (var step = 0; step < TRACE_STEPS; step++)
    {
        var near = NearCapsule(from + way * gone, a, b, capsuleRadius);
        var gap = near.distance - radius;
        if (gap <= SKIN)
        {
            if (step == 0)
            {
                hit = Hit { distance = 0, point = from, normal = -way };
                return true;
            }
            if (Math.Dot(near.normal, way) >= 0) return false;
            hit = Hit { distance = gone, point = near.point, normal = near.normal };
            return true;
        }
        gone += gap;
        if (gone > length) return false;
    }
    return false;
}

// Whether a piece is in a cast's way at all: its ball against the ball
// around the whole of the cast.
bool Reaches(Piece piece, float3 from, float3 way, float length, float radius)
{
    var on = from + way * Math.Clamp(Math.Dot(piece.position - from, way), 0, length);
    var reach = piece.radius + radius + 0.01;
    return Math.DistanceSq(on, piece.position) <= reach * reach;
}

// What a bullet's cast asks of the map: Unity's Default and Ground layers,
// triggers too (QueryTriggerInteraction.Collide), so not the pieces on Ignore
// Raycast.
bool BulletSees(Piece piece)
{
    return !piece.ignoreRaycast;
}

// The nearest piece a bullet's ball meets, moved by `delta`.
bool CastBullet(List<Piece> pieces, float3 from, float3 delta, float radius, out Hit hit)
{
    hit = Hit { };
    var length = Math.Length(delta);
    if (length <= 0.0000001) return false;
    var way = delta / length;
    mut var found = false;
    for (var i = 0; i < pieces.count; i++)
    {
        if (!BulletSees(pieces[i]) || !Reaches(pieces[i], from, way, length, radius)) continue;
        if (!SweepBox(from, way, length, radius, pieces[i].position, pieces[i].rotation, pieces[i].half, out var met)) continue;
        if (found && met.distance >= hit.distance) continue;
        found = true;
        hit = met;
        hit.piece = i;
    }
    return found;
}

// Physics.CheckSphere against what a bullet sees of the map.
bool BulletInWall(List<Piece> pieces, float3 at, float radius)
{
    for (var i = 0; i < pieces.count; i++)
    {
        if (!BulletSees(pieces[i])) continue;
        var reach = pieces[i].radius + radius;
        if (Math.DistanceSq(at, pieces[i].position) > reach * reach) continue;
        if (NearBox(at, pieces[i].position, pieces[i].rotation, pieces[i].half).distance <= radius) return true;
    }
    return false;
}

// Physics.Raycast against the same.
bool RayBlocked(List<Piece> pieces, float3 from, float3 way, float length)
{
    return CastBullet(pieces, from, way * length, 0, out _);
}

// How fast a piece's surface goes at a point: its mover's speed there.
float3 PieceVelocity(Piece piece, List<Mover> movers, List<Block> blocks, float3 at)
{
    if (piece.mover >= 0)
        return movers[piece.mover].velocity + Math.Cross(movers[piece.mover].turning, at - movers[piece.mover].position);
    if (piece.block >= 0)
        return blocks[piece.block].velocity + Math.Cross(blocks[piece.block].turning, at - blocks[piece.block].position);
    return float3(0);
}
