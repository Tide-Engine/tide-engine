// Afterburn: this machine's camera, stadium, rally cars, effects and controls.
// All meshes and sounds are original. Only the match in game.tide is networked.
using Rooms;

enum Layers { Prepare, Shadow, Arena, Actors, Effects, Present, Hud }

asset Clip engineClip = "sfx/engine.wav";
asset Clip boostClip = "sfx/boost.wav";
asset Clip impactClip = "sfx/impact.wav";
asset Clip jumpClip = "sfx/jump.wav";
asset Clip kickoffClip = "sfx/kickoff.wav";
asset Clip goalClip = "sfx/goal.wav";

enum ControlProfile { Classic, Modern }

// These preferences and touch controls belong to this machine, not the match.
local singleton Hand
{
    ControlProfile profile = ControlProfile.Classic;
    bool settingsOpen;
    bool keyboardAerialSafety = true;
    bool pitchBlocked;
    float controllerDeadzone = 0.2;
    float dodgeDeadzone = 0.8;
    float throttle;
    float steer;
    float pitch;
    float yaw;
    float roll;
    bool jump;
    bool boost;
    bool handbrake;
    bool touch;
    float2 stick;
}

local singleton CameraPreferences
{
    // A wide gameplay preset, rather than a claim about the game's defaults.
    // FOV is horizontal at 16:9; Tide's perspective camera takes vertical FOV.
    float fov = 110;
    float distance = 2.7;
    float height = 1;
    float angle = -3;
    float stiffness = 0.5;
    float swivelSpeed = 5;
    float transitionSpeed = 1.2;
    bool shake;
}

float StickAxis(float value, float deadzone)
{
    return Math.Abs(value) <= deadzone ? 0 : (value < 0 ? -1 : 1) * (Math.Abs(value) - deadzone) / (1 - deadzone);
}

// A wall can compress the orbit and separate the ball's bearing from the
// car's. Keep the measured collider in automatic camera modes; free look
// deliberately bypasses this. These are camera bounds, never match physics.
bool CarFits(float yaw, float pitch, float3 eye, CarState car, float horizontalLimit, float verticalLimit)
{
    var right = CarRight(car);
    var center = car.position + car.forward * 0.138757 + car.up * 0.20755;
    var forward = float3(Math.Sin(yaw) * Math.Cos(pitch), Math.Sin(pitch), Math.Cos(yaw) * Math.Cos(pitch));
    var viewRight = float3(Math.Cos(yaw), 0, -Math.Sin(yaw));
    var viewUp = Math.Cross(forward, viewRight);
    for (var corner = 0; corner < 8; corner++)
    {
        var point = center + right * ((corner & 1) != 0 ? 0.433497 : -0.433497)
                  + car.up * ((corner & 2) != 0 ? 0.1932955 : -0.1932955)
                  + car.forward * ((corner & 4) != 0 ? 0.602535 : -0.602535) - eye;
        var depth = Math.Dot(point, forward);
        if (depth <= 0 || Math.Abs(Math.Atan2(Math.Dot(point, viewRight), depth)) > horizontalLimit
                       || Math.Abs(Math.Atan2(Math.Dot(point, viewUp), depth)) > verticalLimit) return false;
    }
    return true;
}

void FrameCar(mut float yaw, mut float pitch, float3 eye, CarState car, float horizontalLimit, float verticalLimit)
{
    if (CarFits(yaw, pitch, eye, car, horizontalLimit, verticalLimit)) return;
    var toCenter = car.position + car.forward * 0.138757 + car.up * 0.20755 - eye;
    var centerYaw = Math.Atan2(toCenter.x, toCenter.z);
    var centerPitch = Math.Atan2(toCenter.y, Math.Length(toCenter.xz));
    var turn = Math.Atan2(Math.Sin(centerYaw - yaw), Math.Cos(centerYaw - yaw));
    var tilt = centerPitch - pitch;
    mut var low = 0.0;
    mut var high = 1.0;
    for (var step = 0; step < 12; step++)
    {
        var middle = (low + high) * 0.5;
        if (CarFits(yaw + turn * middle, pitch + tilt * middle, eye, car, horizontalLimit, verticalLimit)) high = middle;
        else low = middle;
    }
    yaw += turn * high;
    pitch += tilt * high;
}

struct Ember
{
    float3 position;
    float3 velocity;
    Color color;
    float age;
    float life = 0.35;
    float size = 0.12;
}

local singleton SceneView
{
    bool made;
    bool cameraReady;
    bool ballCamera = true;
    bool wasBallCamera = true;
    bool rearView;
    bool wasRearView;
    bool wasPlaying;
    bool touch;
    float dt;
    float clock;
    float speed;
    float boost = 33;
    float shake;
    float goalFlash;
    int seat;
    int score = -1;
    int previousTouch = -1;
    int previousPhase = -1;
    float3 eye;
    float3 look;
    float3 forward = float3(0, 0, 1);
    float orbitYaw;
    float orbitPitch;
    float viewYaw;
    float viewPitch;
    float transition = 1;
    float2 swivel;
    float2 mouseLook;
    quaternion cameraRotation = quaternion.identity;
    float3 previousBallVelocity;
    float3 previousCarVelocity;
    float3 mine;
    float lastY;
    float lastSound;
    float playAge;
    RenderTarget scene;
    RenderTarget bright;
    RenderTarget blurred;
    Texture glow;
    float2 pixel;
    List<DrawPiece> cars;
    List<DrawPiece> wheels;
    List<DrawPiece> pads;
    List<DrawPiece> blots;
    List<DrawPiece> motes;
    List<Ember> sparks;
    Random random;
    Sound engine;
    Sound boostSound;
}

local singleton Sun
{
    bool made;
    RenderTarget map;
    DepthTexture depth;
    float4x4 toLight;
}

float3 SunDirection() { return Math.Normalize(float3(-0.42, 0.85, -0.24)); }

float SunVisibility(DepthTexture depth, float3 world, float3 normal, float4x4 toLight)
{
    var clip = Math.Mul(toLight, float4(world + normal * 0.09, 1));
    if (Math.Max(Math.Abs(clip.x), Math.Abs(clip.y)) > 1) return 1;
    var uv = float2(clip.x * 0.5 + 0.5, 0.5 - clip.y * 0.5);
    var z = clip.z * 0.5 + 0.5;
    float step = 0.00060;
    return (depth.Compare(uv + float2(-step, -step), z) + depth.Compare(uv + float2(step, -step), z)
          + depth.Compare(uv + float2(-step, step), z) + depth.Compare(uv + float2(step, step), z)) * 0.25;
}

Color LightPaint(Color paint, float3 normal, float3 world, float3 eye, float gloss, float glow, float sun)
{
    var lamp = SunDirection();
    var view = Math.Normalize(eye - world);
    var direct = Math.Max(0, Math.Dot(normal, lamp));
    var fill = Math.Max(0, Math.Dot(normal, Math.Normalize(float3(0.6, 0.35, 0.7))));
    var spec = Math.Pow(Math.Max(0, Math.Dot(normal, Math.Normalize(lamp + view))), 68) * gloss * sun;
    var edge = Math.Pow(1 - Math.Max(0, Math.Dot(normal, view)), 4) * gloss * 0.15;
    mut var rgb = float3(paint.r, paint.g, paint.b) * (0.40 + Math.Max(normal.y, 0) * 0.12 + direct * sun * 0.68 + glow)
        + float3(0.35, 0.60, 0.86) * fill * 0.13 + float3(spec) + float3(0.35, 0.65, 1) * edge;
    var far = Math.Saturate((Math.Distance(world, eye) - 65) / 190);
    rgb += (float3(0.29, 0.46, 0.61) - rgb) * far * far * 0.75;
    return Color(rgb.x, rgb.y, rgb.z, paint.a);
}

frag StadiumPaint(Surface surface, out Color color, Instance instance, SceneView scene)
{
    var normal = instance.Normal(surface.normal);
    mut var paint = surface.color;
    mut var glow = surface.material > 1.5 && surface.material < 2.5 ? 0.9 : 0.0;
    if (surface.material > 2.5 && surface.material < 3.5)
    {
        // Seats and thousands of spectators are sampled procedurally, without entities.
        var cell = Math.Floor(this.world * float3(2.8, 1.7, 2.8));
        var noise = Math.Frac(Math.Sin(Math.Dot(cell, float3(12.91, 57.31, 38.79))) * 4375.85);
        var cap = Math.Frac(this.world.y * 1.7);
        paint = cap > 0.56 ? Color(0.28 + noise * 0.48, 0.25 + noise * 0.29, 0.20 + noise * 0.25)
            : noise < 0.45 ? Color(0.035, 0.20 + noise * 0.3, 0.48 + noise * 0.5)
            : noise < 0.7 ? Color(0.8, 0.25, 0.06) : Color(0.13, 0.18, 0.22);
    }
    if (surface.material > 3.5 && surface.material < 4.5)
    {
        var line = Math.Frac(this.world.y * 14) < 0.3 ? 0.77 : 1.0;
        paint = Color(paint.r * line, paint.g * line, paint.b * line);
        glow = 0.65;
    }
    color = LightPaint(paint, normal, this.world, scene.eye, 0.22, glow, 1);
}

frag GrassPaint(Surface surface, out Color color, SceneView scene, Sun sun)
{
    var at = this.world.xz;
    var corner = Math.Max(Math.Abs(at) - float2(ARENA_X - CORNER_RADIUS, ARENA_Z - CORNER_RADIUS), float2(0));
    if (Math.Length(corner) > CORNER_RADIUS) this.Discard();
    var stripe = Math.Frac((at.y + ARENA_Z) / 12.8) < 0.5 ? 1.0 : 0.83;
    var cross = Math.Frac((at.x + ARENA_X) / 12.8) < 0.5 ? 1.0 : 0.97;
    var grain = Math.Frac(Math.Sin(Math.Dot(Math.Floor(at * 70), float2(12.9898, 78.233))) * 43758.5);
    mut var paint = float3(0.065, 0.265, 0.15) * stripe * cross * (0.94 + grain * 0.12);
    var ring = Math.Abs(Math.Length(at) - 9.15);
    var side = Math.Abs(Math.Abs(at.x) - (ARENA_X - 4.0));
    var end = Math.Abs(Math.Abs(at.y) - (ARENA_Z - 3.8));
    var line = Math.Abs(at.y) < 0.10 || ring < 0.105 || Math.Length(at) < 0.18
        || side < 0.10 && Math.Abs(at.y) < ARENA_Z - 3.8 || end < 0.10 && Math.Abs(at.x) < ARENA_X - 4.0;
    var box = Math.Abs(Math.Abs(at.y) - (ARENA_Z - 15)) < 0.10 && Math.Abs(at.x) < 20
        || Math.Abs(Math.Abs(at.x) - 20) < 0.10 && Math.Abs(at.y) > ARENA_Z - 15;
    var goalBox = Math.Abs(Math.Abs(at.y) - (ARENA_Z - 7.2)) < 0.10 && Math.Abs(at.x) < 12.5
        || Math.Abs(Math.Abs(at.x) - 12.5) < 0.10 && Math.Abs(at.y) > ARENA_Z - 7.2;
    if (line || box || goalBox) paint = float3(0.78, 0.87, 0.83);
    if (Math.Abs(at.y) > ARENA_Z - 3.75 && Math.Abs(at.x) < GOAL_X) paint = float3(0.45, 0.65, 0.58);
    var shadow = SunVisibility(sun.depth, this.world, float3(0, 1, 0), sun.toLight);
    color = LightPaint(Color(paint.x, paint.y, paint.z), float3(0, 1, 0), this.world, scene.eye, 0.10, 0, shadow);
}

frag CarPaint(Surface surface, out Color color, DrawPiece piece, Instance instance, SceneView scene, Sun sun)
{
    var normal = instance.Normal(surface.normal);
    mut var paint = surface.color;
    mut var gloss = 0.25;
    mut var glow = 0.0;
    if (surface.material > 4.5 && surface.material < 5.5)
    {
        paint = piece.tint;
        gloss = 1.3;
        // Metallic flake kept subtle at normal driving distance.
        var flake = Math.Frac(Math.Sin(Math.Dot(Math.Floor(surface.position * 200), float3(12.91, 57.31, 38.79))) * 4375.85);
        paint = Color(paint.r * (0.9 + flake * 0.16), paint.g * (0.9 + flake * 0.16), paint.b * (0.9 + flake * 0.16));
    }
    if (surface.material > 5.5 && surface.material < 6.5)
    {
        gloss = 1.5;
        var facing = Math.Pow(1 - Math.Max(0, Math.Dot(normal, Math.Normalize(scene.eye - this.world))), 3);
        paint = Color(0.025 + facing * 0.18, 0.075 + facing * 0.25, 0.13 + facing * 0.35);
    }
    if (surface.material > 7.5 && surface.material < 8.5)
    {
        var grooves = Math.Frac(Math.Atan2(surface.position.z, surface.position.y) * 7.6);
        paint = grooves < 0.14 ? Color(0.012, 0.016, 0.021) : Color(0.035, 0.040, 0.048);
        gloss = 0.1;
    }
    if (surface.material > 1.5 && surface.material < 2.5) glow = 1.0;
    var shadow = SunVisibility(sun.depth, this.world, normal, sun.toLight);
    color = LightPaint(paint, normal, this.world, scene.eye, gloss, glow, shadow);
}

frag BallPaint(Surface surface, out Color color, Instance instance, SceneView scene, Sun sun)
{
    var n = Math.Normalize(surface.position);
    // Spherical pentagonal plates have recessed dark joints and orange lamps.
    float phi = 1.618034;
    mut var best = -2.0;
    mut var second = -2.0;
    mut var tile = 0;
    for (var i = 0; i < 12; i++)
    {
        var a = i % 4 < 2 ? -1.0 : 1.0;
        var b = i % 2 == 0 ? -1.0 : 1.0;
        var point = i < 4 ? float3(0, a, b * phi) : i < 8 ? float3(a, b * phi, 0) : float3(b * phi, 0, a);
        var near = Math.Dot(n, Math.Normalize(point));
        if (near > best) { second = best; best = near; tile = i; }
        else if (near > second) second = near;
    }
    var seam = Math.SmoothStep(0.012, 0.027, best - second);
    var gray = tile % 3 == 0 ? 0.62 : 0.86;
    mut var paint = float3(gray, gray * 0.98, gray * 0.92) * (0.15 + seam * 0.85);
    var bolt = best > 0.999 ? 1.0 : 0.0;
    if (bolt > 0) paint = float3(1, 0.57, 0.17);
    var normal = instance.Normal(surface.normal);
    var shadow = SunVisibility(sun.depth, this.world, normal, sun.toLight);
    color = LightPaint(Color(paint.x, paint.y, paint.z), normal, this.world, scene.eye, 0.55, bolt * 0.8, shadow);
}

frag CagePaint(Surface surface, out Color color, SceneView scene)
{
    var normal = surface.normal;
    var uv = Math.Abs(normal.y) > 0.5 ? this.world.xz
        : Math.Abs(normal.x) > 0.5 ? float2(this.world.z, this.world.y) : float2(this.world.x, this.world.y);
    // A tiled hexagonal safety cage; clear between wires.
    mut var p = uv * float2(0.65, 0.75);
    var row = Math.Floor(p.y);
    p.x += Math.Frac(row * 0.5);
    var cell = float2(Math.Frac(p.x) - 0.5, Math.Frac(p.y) - 0.5);
    var edge = Math.Max(Math.Abs(cell.x), Math.Abs(cell.x) * 0.5 + Math.Abs(cell.y) * 0.866);
    var line = Math.SmoothStep(0.423, 0.448, edge);
    var goal = surface.material > 0.5;
    var opacity = line * (goal ? 0.52 : 0.16);
    if (opacity < 0.005) this.Discard();
    var far = Math.Saturate((Math.Distance(this.world, scene.eye) - 20) / 90);
    color = Color(surface.color.r, surface.color.g, surface.color.b, opacity * (1 - far * 0.65));
}

frag PadPaint(Surface surface, out Color color, DrawPiece piece)
{
    var r = Math.Length(surface.position.xz);
    if (r > 1) this.Discard();
    var rim = Math.SmoothStep(0.76, 0.87, r) * (1 - Math.SmoothStep(0.93, 1, r));
    var core = Math.Saturate((0.62 - r) * 2);
    var hex = Math.Frac(Math.Atan2(surface.position.z, surface.position.x) * 0.955) < 0.72 ? 1.0 : 0.4;
    color = Color(piece.tint.r, piece.tint.g, piece.tint.b, (rim * 0.8 + core * 0.42) * hex * piece.tint.a);
}

frag ShadowPaint(Surface surface, out Color color, DrawPiece piece)
{
    var edge = Math.Saturate((1 - Math.Length(surface.position.xz)) * 3);
    color = Color(0.008, 0.013, 0.018, edge * piece.tint.a);
}

frag SparkPaint(Surface surface, out Color color, DrawPiece piece, Instance instance, SceneView scene)
{
    var normal = instance.Normal(surface.normal);
    var facing = Math.Max(0, Math.Dot(normal, Math.Normalize(scene.eye - this.world)));
    var opacity = Math.SmoothStep(0, 0.65, facing) * piece.tint.a;
    if (opacity < 0.005) this.Discard();
    var core = Math.Pow(facing, 7);
    var rgb = float3(piece.tint.r, piece.tint.g, piece.tint.b) * (0.48 + core * 0.52)
            + float3(0.85, 0.75, 0.52) * core * 0.5;
    color = Color(rgb.x, rgb.y, rgb.z, opacity);
}

frag BrightPaint(Vertex vertex, Texture source, out Color color)
{
    var sampled = source.Sample(vertex.uv);
    var high = Math.Max(sampled.r, Math.Max(sampled.g, sampled.b));
    var shown = Math.Saturate((high - 0.72) * 3);
    color = Color(sampled.r * shown, sampled.g * shown, sampled.b * shown, 1);
}

struct BlurStep { float2 along; }
frag BlurPaint(Vertex vertex, Texture source, out Color color, BlurStep blur)
{
    color = source.Sample(vertex.uv) * 0.24
          + source.Sample(vertex.uv + blur.along * 1.4) * 0.25 + source.Sample(vertex.uv - blur.along * 1.4) * 0.25
          + source.Sample(vertex.uv + blur.along * 3.3) * 0.13 + source.Sample(vertex.uv - blur.along * 3.3) * 0.13;
}

frag PresentPaint(Vertex vertex, Texture source, out Color color, SceneView scene)
{
    var sampled = source.Sample(vertex.uv);
    var glow = scene.glow.Sample(vertex.uv);
    var center = vertex.uv * 2 - float2(1);
    var vignette = 1 - Math.Saturate(Math.Dot(center, center) * 0.08);
    var rgb = (float3(sampled.r, sampled.g, sampled.b) + float3(glow.r, glow.g, glow.b) * 0.14) * vignette;
    color = Color(rgb.x, rgb.y, rgb.z, 1);
}

float2 TouchStick(float2 screen) { return float2(82, screen.y - 118); }
float2 TouchBoost(float2 screen) { return float2(screen.x - 64, screen.y - 116); }
float2 TouchJump(float2 screen) { return float2(screen.x - 153, screen.y - 75); }
float2 TouchSlide(float2 screen) { return float2(screen.x - 64, screen.y - 211); }

void ControlTouch(mut Hand hand, float2 at, float2 start, float2 screen)
{
    if (Math.Distance(start, TouchStick(screen)) < 83)
    {
        mut var delta = (at - TouchStick(screen)) / 54;
        if (Math.Length(delta) > 1) delta = Math.Normalize(delta);
        hand.stick = delta;
        hand.throttle = -delta.y;
        hand.steer = delta.x;
        hand.pitch = delta.y;
        hand.yaw = delta.x;
    }
    if (Math.Distance(start, TouchBoost(screen)) < 46) hand.boost = true;
    if (Math.Distance(start, TouchJump(screen)) < 37) hand.jump = true;
    if (Math.Distance(start, TouchSlide(screen)) < 32) hand.handbrake = true;
}

void Emit(mut SceneView scene, float3 at, Color tone, int count, float force, float life)
{
    for (var i = 0; i < count; i++)
    {
        var way = scene.random.NextFloat3Direction();
        scene.sparks.Add(Ember { position = at, velocity = way * scene.random.NextFloat(force * 0.3, force), color = tone,
                                life = life * scene.random.NextFloat(0.7, 1.3), size = scene.random.NextFloat(0.025, 0.075) });
    }
}

[Stage(Layers.Prepare)]
view Prepare(mut Models models, mut SceneView scene, mut Hand hand, CameraPreferences camera, MatchState match, verified MatchState sure, Session session,
             Devices devices, Lobby lobby, query (Participant participant, Owner owner) players)
{
    if (!models.made) MakeModels(models);
    if (!scene.made)
    {
        scene.made = true;
        scene.scene = RenderTarget.Window(samples: 4);
        scene.bright = RenderTarget.Window(0.25);
        scene.blurred = RenderTarget.Window(0.25);
        scene.glow = scene.bright.color;
    }
    var screen = float2(Screen.width, Screen.height);
    scene.pixel = float2(1 / Math.Max(screen.x, 1), 1 / Math.Max(screen.y, 1));
    scene.dt = Math.Min(Frame.dt, 0.05);
    scene.clock += scene.dt;
    scene.shake = Math.Max(0, scene.shake - scene.dt * 2.5);
    scene.goalFlash = Math.Max(0, scene.goalFlash - scene.dt);
    scene.seat = 0;
    foreach (var player in players)
        if (player.owner.player == session.player) scene.seat = player.participant.seat;
    scene.cars.Clear(); scene.wheels.Clear(); scene.pads.Clear(); scene.blots.Clear(); scene.motes.Clear();
    var car = match.cars[scene.seat];
    if (scene.wasPlaying != lobby.playing) scene.cameraReady = false;
    scene.wasPlaying = lobby.playing;
    scene.mine = car.position;
    scene.speed = Math.Length(car.velocity);
    scene.boost = car.boost;
    hand.throttle = 0; hand.steer = 0; hand.pitch = 0; hand.yaw = 0; hand.roll = 0;
    hand.jump = false; hand.boost = false; hand.handbrake = false; hand.stick = float2(0);
    scene.touch = devices.touchscreen.connected;
    hand.touch = scene.touch;
    var keys = devices.keyboard;
    var classic = hand.profile == ControlProfile.Classic;
    var forwardHeld = keys.w.pressed || keys.upArrow.pressed;
    var pitchReleased = !forwardHeld || keys.w.up || keys.upArrow.up || keys.s.pressed || keys.downArrow.pressed || keys.q.pressed || keys.e.pressed
                     || (classic ? keys.leftShift.pressed : devices.mouse.right.pressed);
    if (car.grounded) hand.pitchBlocked = forwardHeld;
    if (pitchReleased || !hand.keyboardAerialSafety) hand.pitchBlocked = false;
    scene.rearView = false;
    if (lobby.playing && !hand.settingsOpen)
    {
        foreach (var touch in devices.touchscreen.touches)
            if (touch.press.pressed) ControlTouch(hand, Screen.Flip(touch.position), Screen.Flip(touch.startPosition), screen);
        var mouse = devices.mouse;
        if ((classic ? keys.space.down : mouse.middle.down) || devices.gamepad.buttonNorth.down) scene.ballCamera = !scene.ballCamera;
        scene.rearView = devices.gamepad.rightStickButton.pressed || (classic ? mouse.middle.pressed : keys.leftCtrl.pressed);
        foreach (var touch in devices.touchscreen.touches)
        {
            var at = Screen.Flip(touch.position);
            if (touch.press.down && at.x >= 14 && at.x <= 146 && at.y >= 76 && at.y <= 106) scene.ballCamera = !scene.ballCamera;
        }
        var mouseFree = !scene.touch && (hand.profile == ControlProfile.Modern || keys.leftAlt.pressed);
        if (mouseFree)
        {
            Cursor.Lock();
            scene.mouseLook.x += mouse.delta.x * 0.003;
            scene.mouseLook.x = Math.Atan2(Math.Sin(scene.mouseLook.x), Math.Cos(scene.mouseLook.x));
            scene.mouseLook.y = Math.Clamp(scene.mouseLook.y + mouse.delta.y * 0.003, -1.45, 1.45);
        }
        else scene.mouseLook *= Math.Exp(-scene.dt * camera.swivelSpeed * 2);
    }
    if (scene.wasBallCamera != scene.ballCamera || scene.wasRearView != scene.rearView)
    {
        scene.transition = 0;
        scene.mouseLook = float2(0);
    }
    scene.wasBallCamera = scene.ballCamera;
    scene.wasRearView = scene.rearView;
    var goal = sure.blueScore + sure.orangeScore;
    if (scene.score >= 0 && goal > scene.score)
    {
        scene.goalFlash = 1.7;
        scene.shake = 0.8;
        var tone = TeamColor(sure.lastScorer);
        var z = sure.lastScorer == 0 ? ARENA_Z - 0.6 : -ARENA_Z + 0.6;
        Emit(scene, float3(0, 3, z), tone, 160, 27, 1.5);
        Audio.Play(goalClip, 0.48);
    }
    scene.score = goal;
    if (scene.previousPhase != int(sure.phase) && sure.phase == MatchPhase.Playing) Audio.Play(kickoffClip, 0.35);
    scene.previousPhase = int(sure.phase);
    scene.playAge = match.phase == MatchPhase.Playing ? scene.playAge + scene.dt : 0;
    if (sure.ball.lastTouch >= 0 && sure.phase == MatchPhase.Playing
        && (scene.previousTouch != sure.ball.lastTouch || Math.Length(sure.ball.velocity - scene.previousBallVelocity) > 5)
        && scene.clock - scene.lastSound > 0.12)
    {
        Emit(scene, match.ball.position, Color(1, 0.87, 0.57), 8, 5, 0.3);
        Audio.Play(impactClip, match.ball.position, 0.5, 0.9 + scene.random.NextFloat() * 0.2);
        scene.shake = Math.Max(scene.shake, 0.18);
        scene.lastSound = scene.clock;
    }
    scene.previousTouch = sure.ball.lastTouch;
    scene.previousBallVelocity = sure.ball.velocity;
    if (car.position.y > scene.lastY + 0.045 && scene.lastY < CAR_HEIGHT + 0.1 && car.velocity.y > 2 && scene.clock - scene.lastSound > 0.3)
    {
        scene.lastSound = scene.clock;
        Audio.Play(jumpClip, 0.25);
    }
    scene.lastY = car.position.y;
    if (Math.Length(car.velocity - scene.previousCarVelocity) > 7 && scene.clock - scene.lastSound > 0.22)
    {
        scene.lastSound = scene.clock;
        Audio.Play(impactClip, car.position, 0.25);
        scene.shake = Math.Max(scene.shake, 0.25);
    }
    scene.previousCarVelocity = car.velocity;
    scene.engine.clip = engineClip; scene.engine.loop = true; scene.engine.playing = lobby.page == Page.Playing;
    scene.engine.volume = 0.10 + Math.Min(scene.speed / 46, 1) * 0.13;
    scene.engine.pitch = 0.65 + Math.Min(scene.speed / 30, 1) * 1.15;
    scene.boostSound.clip = boostClip; scene.boostSound.loop = true;
    scene.boostSound.playing = car.boosting && lobby.page == Page.Playing;
    scene.boostSound.volume = 0.23;
    // Car cam follows the car's heading with a stable horizon. Aerial rolls
    // don't roll the camera; a vertical nose keeps the last useful heading.
    var heading = UnitOr(float3(car.forward.x, 0, car.forward.z), scene.forward);
    var toBall = match.ball.position - car.position;
    var ballRange = Math.Length(toBall);
    mut var wantedYaw = Math.Atan2(heading.x, heading.z);
    mut var wantedPitch = 0.0;
    if (scene.ballCamera && !scene.rearView && ballRange > 0.25)
    {
        if (Math.LengthSq(toBall.xz) > 0.001) wantedYaw = Math.Atan2(toBall.x, toBall.z);
        else wantedYaw = scene.cameraReady ? scene.orbitYaw : wantedYaw;
        // The ball's actual height drives the orbit, including aerials. There
        // is no screen-space elevation clamp that hides a high ball.
        wantedPitch = Math.Atan2(toBall.y, Math.Length(toBall.xz));
    }
    if (scene.rearView) wantedYaw += Math.PI;
    mut var padLook = float2(StickAxis(devices.gamepad.rightStick.x, 0.1), StickAxis(devices.gamepad.rightStick.y, 0.1));
    if (!lobby.playing || hand.settingsOpen) padLook = float2(0);
    scene.swivel += (padLook * float2(Math.PI * 0.85, 1.15) - scene.swivel) * (1 - Math.Exp(-scene.dt * camera.swivelSpeed * 2));
    var freeLook = scene.swivel + scene.mouseLook;
    wantedYaw += freeLook.x;
    wantedPitch = Math.Clamp(wantedPitch + freeLook.y, -1.55, 1.55);
    if (!scene.cameraReady)
    {
        scene.orbitYaw = wantedYaw;
        scene.orbitPitch = wantedPitch;
    }
    scene.transition = Math.Min(1, scene.transition + scene.dt * camera.transitionSpeed);
    var followSpeed = scene.transition < 1 ? camera.transitionSpeed * 6 : 8 + camera.stiffness * 18;
    var ease = 1 - Math.Exp(-scene.dt * followSpeed);
    scene.orbitYaw += Math.Atan2(Math.Sin(wantedYaw - scene.orbitYaw), Math.Cos(wantedYaw - scene.orbitYaw)) * ease;
    scene.orbitPitch += (wantedPitch - scene.orbitPitch) * ease;
    scene.forward = float3(Math.Sin(scene.orbitYaw), 0, Math.Cos(scene.orbitYaw));
    var orbitForward = scene.forward * Math.Cos(scene.orbitPitch) + float3(0, Math.Sin(scene.orbitPitch), 0);
    var distance = camera.distance + scene.speed * (1 - camera.stiffness) * 0.035;
    mut var wantEye = car.position - orbitForward * distance + float3(0, camera.height, 0);
    // Resolve only a local camera probe against the same rounded arena and
    // goal recesses as physics. This never changes match state.
    mut var probeVelocity = float3(0);
    for (var probe = 0; probe < 3; probe++) ArenaContact(wantEye, probeVelocity, 0.12, 0);
    // Projection into a wall must not leave the camera pressed against the
    // car. Re-expand the corrected offset along the available wall tangent.
    var halfVertical = Math.Atan(Math.Tan(Math.Radians(camera.fov) * 0.5) / (16.0 / 9.0));
    var horizontalLimit = Math.Max(0.05, Math.Atan(Math.Tan(halfVertical) * screen.x / Math.Max(screen.y, 1)) - 0.035);
    var verticalLimit = Math.Max(0.05, halfVertical - 0.035);
    var automatic = !scene.rearView && Math.LengthSq(freeLook) < 0.0001;
    var requestedDistance = Math.Sqrt(distance * distance + camera.height * camera.height
                        - 2 * distance * camera.height * orbitForward.y);
    // A ball directly overhead can push the eye into the floor. Leave enough
    // room for the collider's .77m enclosing radius and .25m COM offset.
    var minimumDistance = 0.77 / Math.Sin(Math.Min(horizontalLimit, verticalLimit)) + 0.25;
    var orbitDistance = automatic ? Math.Max(requestedDistance, minimumDistance) : requestedDistance;
    for (var slide = 0; slide < 6; slide++)
    {
        var offset = wantEye - car.position;
        if (Math.LengthSq(offset) >= orbitDistance * orbitDistance * 0.999) break;
        wantEye = car.position + UnitOr(offset, float3(0, 1, 0)) * orbitDistance;
        for (var probe = 0; probe < 3; probe++) ArenaContact(wantEye, probeVelocity, 0.12, 0);
    }
    var angle = scene.orbitPitch + Math.Radians(camera.angle);
    var aim = scene.forward * Math.Cos(angle) + float3(0, Math.Sin(angle), 0);
    mut var wantLook = wantEye + aim * 100;
    if (scene.ballCamera && !scene.rearView)
    {
        // Aim at the full 3D ball position. Swivelling intentionally looks
        // away until the stick/Alt is released or ball cam is toggled again.
        var ballDirection = UnitOr(match.ball.position - wantEye, orbitForward);
        var ballYaw = Math.Atan2(ballDirection.x, ballDirection.z) + freeLook.x;
        var ballPitch = Math.Clamp(Math.Atan2(ballDirection.y, Math.Length(ballDirection.xz)) + freeLook.y, -1.56, 1.56);
        wantLook = wantEye + float3(Math.Sin(ballYaw) * Math.Cos(ballPitch), Math.Sin(ballPitch), Math.Cos(ballYaw) * Math.Cos(ballPitch)) * 100;
    }
    if (lobby.page == Page.Title)
    {
        var orbit = scene.clock * 0.027;
        wantEye = float3(Math.Sin(orbit) * 43, 32, -Math.Cos(orbit) * 54);
        wantLook = float3(0, 3.5, 0);
    }
    var wantedView = UnitOr(wantLook - wantEye, orbitForward);
    var viewYaw = Math.Atan2(wantedView.x, wantedView.z);
    var viewPitch = Math.Atan2(wantedView.y, Math.Length(wantedView.xz));
    if (!scene.cameraReady) { scene.viewYaw = viewYaw; scene.viewPitch = viewPitch; }
    scene.viewYaw += Math.Atan2(Math.Sin(viewYaw - scene.viewYaw), Math.Cos(viewYaw - scene.viewYaw)) * ease;
    scene.viewPitch += (viewPitch - scene.viewPitch) * ease;
    var verticalFov = Math.Degrees(halfVertical * 2);
    if (lobby.page != Page.Title && automatic)
        FrameCar(scene.viewYaw, scene.viewPitch, wantEye, car, horizontalLimit, verticalLimit);
    var viewDirection = float3(Math.Sin(scene.viewYaw) * Math.Cos(scene.viewPitch), Math.Sin(scene.viewPitch), Math.Cos(scene.viewYaw) * Math.Cos(scene.viewPitch));
    var viewUp = UnitOr(float3(0, 1, 0) - viewDirection * viewDirection.y, -scene.forward);
    scene.cameraRotation = quaternion.LookRotation(viewDirection, viewUp);
    // Only relative orbit and orientation lag. The interpolated car's world
    // position anchors every frame, so boost cannot outrun the camera.
    scene.eye = wantEye;
    scene.look = scene.eye + Math.Mul(scene.cameraRotation, float3(0, 0, 100));
    scene.cameraReady = true;
    var shake = camera.shake ? float3(Math.Sin(scene.clock * 71), Math.Sin(scene.clock * 63), 0) * scene.shake * scene.shake * 0.10 : float3(0);
    scene.scene.SetCamera(scene.eye + shake, scene.cameraRotation, verticalFov);
    Audio.SetListener(car.position + float3(0, 1, 0), quaternion.LookRotation(car.forward, car.up));
    for (var i = 0; i < 2; i++)
    {
        var playerCar = match.cars[i];
        if (playerCar.respawn > 0) continue;
        var turned = quaternion.LookRotation(playerCar.forward, playerCar.up);
        // The shell nose follows the collider's forward offset. Wheel centres
        // and radii use the measured Octane suspension geometry in metres.
        var root = playerCar.position + playerCar.forward * 0.138757 - playerCar.up * 0.0105;
        var transform = float4x4.TRS(root, turned, float3(0.38));
        scene.cars.Add(DrawPiece { transform = transform, tint = TeamColor(playerCar.team) });
        for (var side = -1; side <= 1; side += 2)
            for (var axle = -1; axle <= 1; axle += 2)
            {
                var wheelRadius = axle > 0 ? 0.125 : 0.15;
                var at = playerCar.position + Math.Mul(turned, float3(side * (axle > 0 ? 0.259 : 0.295),
                    wheelRadius - 0.1701, axle > 0 ? 0.5125 : -0.3375));
                var wheelRotation = Math.Mul(turned, quaternion.Euler(float3(playerCar.wheelSpin, axle > 0 ? playerCar.steer * 0.42 : 0, 0)));
                scene.wheels.Add(DrawPiece { transform = float4x4.TRS(at, wheelRotation, float3(0.38, wheelRadius / 0.39, wheelRadius / 0.39)), tint = Color.white });
            }
        scene.blots.Add(DrawPiece { transform = float4x4.TRS(float3(playerCar.position.x, 0.023, playerCar.position.z),
                          quaternion.AxisAngle(float3(0, 1, 0), Math.Atan2(playerCar.forward.x, playerCar.forward.z)), float3(0.49, 1, 0.75)),
                          tint = Color(0, 0, 0, Math.Saturate(0.3 - playerCar.position.y * 0.018)) });
        if (playerCar.boosting)
        {
            for (var exhaust = -1; exhaust <= 1; exhaust += 2)
                for (var tail = 0; tail < 5; tail++)
                {
                    var behind = root + Math.Mul(turned, float3(exhaust * 0.129, -0.023, -0.65 - tail * 0.13));
                    var color = tail < 2 ? Color(1, 0.82, 0.28, 0.9) : Color(1, 0.25, 0.025, 0.65 - tail * 0.1);
                    scene.motes.Add(DrawPiece { transform = float4x4.TRS(behind, turned, float3(0.052 - tail * 0.008, 0.040 - tail * 0.006, 0.17)), tint = color });
                }
            if (scene.sparks.count < 650)
                for (var exhaust = -1; exhaust <= 1; exhaust += 2)
                    scene.sparks.Add(Ember { position = root + Math.Mul(turned, float3(exhaust * 0.34, -0.06, -1.7) * 0.38),
                        velocity = -playerCar.forward * 5 + scene.random.NextFloat3Direction() * 1.6,
                        color = Color(1, 0.34, 0.025), life = 0.24, size = 0.045 });
        }
    }
    scene.blots.Add(DrawPiece { transform = float4x4.TRS(float3(match.ball.position.x, 0.025, match.ball.position.z), quaternion.identity,
        float3(BALL_RADIUS + match.ball.position.y * 0.045, 1, BALL_RADIUS + match.ball.position.y * 0.045)),
        tint = Color(0, 0, 0, Math.Saturate(0.36 - match.ball.position.y * 0.012)) });
    for (var pad = 0; pad < 34; pad++)
    {
        var large = PadLarge(pad);
        var at = PadPosition(pad);
        var ready = match.pads[pad] <= 0;
        scene.pads.Add(DrawPiece { transform = float4x4.TRS(float3(at.x, 0.035, at.z), quaternion.identity,
            float3(large ? 1.5 : 0.70, 1, large ? 1.5 : 0.70)), tint = ready ? Color(1, 0.64, 0.12, 1) : Color(0.36, 0.25, 0.11, 0.50) });
        if (large && ready)
            scene.motes.Add(DrawPiece { transform = float4x4.TRS(float3(at.x, 0.65 + Math.Sin(scene.clock * 3 + pad) * 0.10, at.z),
                quaternion.identity, float3(0.27)), tint = Color(1, 0.67, 0.16, 0.9) });
    }
    mut var index = 0;
    while (index < scene.sparks.count)
    {
        mut var spark = scene.sparks[index];
        spark.age += scene.dt;
        if (spark.age >= spark.life) { scene.sparks.RemoveAt(index); continue; }
        spark.position += spark.velocity * scene.dt;
        spark.velocity.y -= scene.dt * 3;
        scene.sparks[index] = spark;
        var left = 1 - spark.age / spark.life;
        var along = UnitOr(spark.velocity, float3(0, 0, 1));
        var guide = Math.Abs(along.y) > 0.95 ? float3(0, 0, 1) : float3(0, 1, 0);
        var radius = spark.size * left;
        scene.motes.Add(DrawPiece { transform = float4x4.TRS(spark.position, quaternion.LookRotation(along, guide),
            float3(radius, radius, radius * Math.Min(3, 1 + Math.Length(spark.velocity) * 0.08))),
            tint = Color(spark.color.r, spark.color.g, spark.color.b, left) });
        index++;
    }
}

[Stage(Layers.Shadow)]
view Cast(Models models, SceneView scene, MatchState match, mut Sun sun)
{
    if (!sun.made)
    {
        sun.made = true;
        sun.map = RenderTarget(2048, 2048, 1, Format.Depth);
        sun.depth = sun.map.depth;
    }
    var turned = quaternion.LookRotation(-SunDirection(), float3(0, 1, 0));
    var light = float4x4.TRS(Math.Mul(turned, float3(0, 4, -120)), turned, float3(1));
    sun.map.SetCamera(light, float4x4.Ortho(136, 136, 0, 240));
    sun.toLight = sun.map.WorldToClip();
    sun.map.Clear(Color.white);
    sun.map.Instanced(models.car, models.carFaces, scene.cars);
    sun.map.Instanced(models.wheel, models.wheelFaces, scene.wheels);
    sun.map.Mesh(models.ball, models.ballFaces, float4x4.TRS(match.ball.position, quaternion.identity, float3(BALL_RADIUS)));
}

[Stage(Layers.Arena)]
view Stadium(Models models, SceneView scene)
{
    if (!scene.made || !models.made) return;
    var screen = float2(Screen.width, Screen.height);
    scene.scene.Clear(Color(0.34, 0.52, 0.67));
    scene.scene.Screen()
    {
        scene.scene.Shape(Shape { center = screen * 0.5, size = screen, color = Color(0.075, 0.19, 0.35), color2 = Color(0.54, 0.69, 0.76) });
        scene.scene.Shape(Shape { center = float2(screen.x * 0.22, screen.y * 0.15), size = float2(screen.y * 0.5), ellipse = true,
            color = Color(1, 0.87, 0.62, 0.18), soft = screen.y * 0.45 });
    }
    scene.scene.Mesh(models.turf, models.turfFaces, float4x4.identity, GrassPaint);
    scene.scene.Mesh(models.arena, models.arenaFaces, float4x4.identity, StadiumPaint);
    scene.scene.Depth(Depth.Read)
    {
        scene.scene.Instanced(models.disc, models.discFaces, scene.blots, ShadowPaint);
        scene.scene.Instanced(models.disc, models.discFaces, scene.pads, PadPaint);
    }
}

[Stage(Layers.Actors)]
view Actors(Models models, SceneView scene, MatchState match)
{
    scene.scene.Instanced(models.car, models.carFaces, scene.cars, CarPaint);
    scene.scene.Instanced(models.wheel, models.wheelFaces, scene.wheels, CarPaint);
    var spin = quaternion.Euler(match.ball.spin);
    scene.scene.Mesh(models.ball, models.ballFaces, float4x4.TRS(match.ball.position, spin, float3(BALL_RADIUS)), BallPaint);
    scene.scene.Depth(Depth.Read), scene.scene.Cull(Cull.None)
    {
        scene.scene.Mesh(models.fence, models.fenceFaces, float4x4.identity, CagePaint);
    }
}

[Stage(Layers.Effects)]
view Effects(Models models, SceneView scene)
{
    if (!scene.made || !models.made) return;
    scene.scene.Blend(Blend.Add), scene.scene.Depth(Depth.Read), scene.scene.Cull(Cull.Back)
    {
        scene.scene.Instanced(models.glow, models.glowFaces, scene.motes, SparkPaint);
    }
}

[Stage(Layers.Present)]
view Present(SceneView scene)
{
    if (!scene.made) return;
    Draw.Blit(scene.scene.color, scene.bright, BrightPaint);
    Draw.Blit(scene.bright.color, scene.blurred, BlurPaint, BlurStep { along = float2(scene.pixel.x * 5, 0) });
    Draw.Blit(scene.blurred.color, scene.bright, BlurPaint, BlurStep { along = float2(0, scene.pixel.y * 5) });
    Draw.Blit(scene.scene.color, Draw.window, PresentPaint);
}

void TouchButton(float2 at, float radius, string text, bool held, Color tone)
{
    Draw.Shape(Shape { center = at, size = float2(radius * 2), ellipse = true, color = Color(0.025, 0.045, 0.07, 0.7),
                      outline = held ? 3.0 : 1.3, outlineColor = held ? Color.white : Color(tone.r, tone.g, tone.b, 0.8) });
    Draw.Text(text, at, radius * 0.31, held ? Color.white : tone, Anchor.MiddleCenter, Font.Bold);
}

[Stage(Layers.Hud)]
view Hud(MatchState match, SceneView scene, Hand hand, Lobby lobby)
{
    if (lobby.page != Page.Playing || hand.settingsOpen) return;
    Draw.SetScreen();
    var screen = float2(Screen.width, Screen.height);
    var narrow = screen.x < 600;
    var scale = narrow ? 0.80 : 1.0;
    var middle = screen.x * 0.5;
    var top = 29.0;
    // The blue/orange score panels flank a sober black match clock.
    Draw.RoundRect(float2(middle, top), float2(242 * scale, 52), 3, Color(0.018, 0.03, 0.047, 0.94));
    Draw.Rect(float2(middle - 89 * scale, top), float2(63 * scale, 52), Color(0.025, 0.27, 0.82, 0.94));
    Draw.Rect(float2(middle + 89 * scale, top), float2(63 * scale, 52), Color(0.86, 0.23, 0.025, 0.94));
    Draw.Rect(float2(middle - 89 * scale, top + 26), float2(63 * scale, 2), Color(0.22, 0.66, 1));
    Draw.Rect(float2(middle + 89 * scale, top + 26), float2(63 * scale, 2), Color(1, 0.63, 0.14));
    Draw.Text($"{match.blueScore}", float2(middle - 89 * scale, top - 1), 34, Color.white, Anchor.MiddleCenter, Font.Bold);
    Draw.Text($"{match.orangeScore}", float2(middle + 89 * scale, top - 1), 34, Color.white, Anchor.MiddleCenter, Font.Bold);
    var seconds = int(Math.Ceil(Math.Max(0, match.remaining)));
    var minutes = seconds / 60;
    var remainder = seconds % 60;
    var clock = remainder < 10 ? $"{minutes}:0{remainder}" : $"{minutes}:{remainder}";
    Draw.Text(match.overtime ? $"+{clock}" : clock, float2(middle, top - 1), narrow ? 24 : 27,
        match.remaining < 30 && !match.overtime ? Color(1, 0.65, 0.22) : Color.white, Anchor.MiddleCenter, Font.Bold);
    if (match.overtime) Draw.Text("OVERTIME", float2(middle, top + 36), 10, Color(1, 0.76, 0.29), Anchor.MiddleCenter, Font.Bold);
    Draw.Text(scene.ballCamera ? "BALL CAM  ON" : "BALL CAM  OFF", float2(20, 91), 12, scene.ballCamera ? Color(1, 0.47, 0.20) : Color.white,
        Anchor.MiddleLeft, Font.Bold);
    if (!narrow) Draw.Text(hand.profile == ControlProfile.Classic ? "SPACE TO TOGGLE" : "MIDDLE MOUSE TO TOGGLE",
        float2(20, 111), 9, Color(0.76, 0.83, 0.87), Anchor.MiddleLeft);
    // An amber circular boost gauge is readable at peripheral vision.
    var gauge = float2(screen.x - (narrow ? 61 : 83), screen.y - (scene.touch ? 318 : 82));
    var radius = narrow ? 43.0 : 56.0;
    Draw.Circle(gauge, radius + 4, Color(0.018, 0.03, 0.05, 0.65));
    Draw.Arc(gauge, radius, Math.PI * 0.72, Math.PI * 1.56, 5, Color(0.36, 0.25, 0.12, 0.7));
    Draw.Arc(gauge, radius, Math.PI * 0.72, Math.PI * 1.56 * Math.Saturate(scene.boost / 100), 5, Color(1, 0.62, 0.13));
    Draw.Text($"{int(scene.boost)}", gauge - float2(0, 1), narrow ? 27 : 38, Color(1, 0.75, 0.27), Anchor.MiddleCenter, Font.Bold);
    Draw.Text("BOOST", gauge + float2(0, radius * 0.47), 10, Color(1, 0.72, 0.30), Anchor.MiddleCenter, Font.Bold);
    if (!scene.touch)
    {
        Draw.Text($"{int(scene.speed * 3.6)} KM/H", gauge + float2(0, -radius - 18), 11, Color(0.9, 0.95, 1), Anchor.MiddleCenter);
        var help = hand.profile == ControlProfile.Classic
            ? (narrow ? "WASD  RMB jump  LMB boost  SPACE cam" : "WASD  Drive / Aerial     RMB  Jump / Dodge     LMB  Boost     SHIFT  Powerslide / Air roll     SPACE  Ball cam     MMB  Rear view")
            : (narrow ? "WASD  SPACE jump  SHIFT boost  MMB cam" : "WASD  Drive / Aerial     SPACE / LMB  Jump     SHIFT  Boost     RMB  Powerslide / Air roll     MMB  Ball cam     CTRL  Rear view");
        Draw.Text(help,
            float2(middle, screen.y - 22), narrow ? 9 : 11, Color(0.81, 0.87, 0.92), Anchor.MiddleCenter);
    }
    else
    {
        var stick = TouchStick(screen);
        Draw.Circle(stick, 55, Color(0.02, 0.04, 0.07, 0.53));
        Draw.WireCircle(stick, 54, 1.5, Color(0.60, 0.74, 0.85, 0.45));
        Draw.Circle(stick + hand.stick * 39, 23, Color(0.85, 0.92, 1, 0.36));
        Draw.Text("STEER", stick + float2(0, 72), 10, Color(0.76, 0.87, 0.94), Anchor.MiddleCenter, Font.Bold);
        TouchButton(TouchBoost(screen), 43, "BOOST", hand.boost, Color(1, 0.68, 0.21));
        TouchButton(TouchJump(screen), 34, "JUMP", hand.jump, Color(0.75, 0.89, 1));
        TouchButton(TouchSlide(screen), 28, "SLIDE", hand.handbrake, Color(0.75, 0.89, 1));
    }
    // Floating teammate/opponent markers stay sparse so the ball reads first.
    for (var i = 0; i < 2; i++)
    {
        if (i == scene.seat || match.cars[i].respawn > 0) continue;
        var p = scene.scene.WorldToScreen(match.cars[i].position + float3(0, 1.8, 0));
        if (p.z < 0 || p.z > 1 || p.x < 0 || p.x > screen.x || p.y < 65 || p.y > screen.y - 70) continue;
        Draw.RoundRect(p.xy, float2(65, 17), 2, Color(0.02, 0.04, 0.06, 0.75));
        Draw.Text(match.humans < 2 ? "BOT" : "RIVAL", p.xy, 10, TeamColor(i), Anchor.MiddleCenter, Font.Bold);
    }
    // When the ball leaves the view, a warm marker indicates its direction.
    var ballAt = scene.scene.WorldToScreen(match.ball.position);
    if (ballAt.z < 0 || ballAt.z > 1 || ballAt.x < 14 || ballAt.x > screen.x - 14 || ballAt.y < 65 || ballAt.y > screen.y - 20)
    {
        var at = float2(Math.Clamp(ballAt.x, 18, screen.x - 18), Math.Clamp(ballAt.y, 72, screen.y - 28));
        Draw.Circle(at, 8, Color(1, 0.82, 0.42));
        Draw.Circle(at, 4, Color(0.07, 0.09, 0.11));
    }
    mut var word = "";
    mut var under = "";
    mut var tone = Color(1, 0.75, 0.25);
    if (match.phase == MatchPhase.Kickoff) word = match.phaseTime > 2 ? "3" : match.phaseTime > 1 ? "2" : "1";
    if (match.phase == MatchPhase.Playing && scene.playAge < 0.85) word = "GO!";
    if (match.phase == MatchPhase.Goal)
    {
        word = match.lastScorer == 0 ? "BLUE SCORED!" : "ORANGE SCORED!";
        tone = match.lastScorer == 0 ? Color(0.45, 0.75, 1) : Color(1, 0.57, 0.18);
        under = "Next kickoff in a moment";
    }
    if (match.phase == MatchPhase.Finished)
    {
        word = match.winner == 0 ? "BLUE WINS!" : "ORANGE WINS!";
        under = "Menu > New game to play again";
        tone = match.winner == 0 ? Color(0.45, 0.75, 1) : Color(1, 0.57, 0.18);
    }
    if (word != "")
    {
        var at = float2(middle, screen.y * 0.30);
        var size = word == "1" || word == "2" || word == "3" ? 76.0 : Math.Min(51, screen.x * 0.095);
        Draw.Text(word, at + float2(2, 3), size, Color(0, 0.02, 0.04, 0.7), Anchor.MiddleCenter, Font.Bold);
        Draw.Text(word, at, size, tone, Anchor.MiddleCenter, Font.Bold);
        if (under != "") Draw.Text(under, at + float2(0, 45), 13, Color.white, Anchor.MiddleCenter);
    }
}

[Before(Rooms.Pages)]
view RoomTheme()
{
    GUI.SetTheme(GUITheme { text = Color(0.91, 0.95, 1), panel = Color(0.018, 0.033, 0.055),
        control = Color(0.055, 0.12, 0.20), hot = Color(0.10, 0.23, 0.37), pressed = Color(0.035, 0.08, 0.14),
        field = Color(0.012, 0.025, 0.045), fieldHot = Color(0.035, 0.075, 0.13), accent = Color(0.18, 0.57, 1), radius = 4 });
}

[After(Rooms.Pages)]
view RoomSetup(SceneView scene, mut Lobby lobby, query (Participant participant) players)
{
    mut var manned = 0;
    foreach (var player in players) manned |= 1 << player.participant.seat;
    lobby.seats = 2;
    lobby.manned = manned;
    lobby.mine = scene.seat;
    lobby.bots = true;
    lobby.offersNewGame = true;
    lobby.offersBots = false;
    if (lobby.newGame) Send(Restart { });
}

override string Rooms.Title() { return "AFTERBURN"; }
override string Rooms.Tagline() { return "Rocket-powered car soccer. Five minutes. One more goal."; }
override Rect Rooms.MenuButton(float2 screen) { return Rect(screen.x - 87, 10, 77, 32); }

[After(Rooms.Pages)]
view Preferences(mut Hand hand, mut CameraPreferences camera, mut SceneView scene, Devices devices)
{
    var screen = float2(Screen.width, Screen.height);
    if (!hand.settingsOpen)
    {
        if (GUI.Button(Rect(screen.x - 177, screen.x < 600 ? 64 : 49, 167, 30), "Controls / camera") || devices.keyboard.f2.down)
            hand.settingsOpen = true;
    }
    if (!hand.settingsOpen) return;
    GUILayout.Modal(Anchor.MiddleCenter, hand.settingsOpen)
    {
        GUILayout.Label("Controls / camera");
        var classic = hand.profile == ControlProfile.Classic;
        if (GUILayout.Button(classic ? "Keyboard: Classic" : "Keyboard: Modern"))
        {
            hand.profile = classic ? ControlProfile.Modern : ControlProfile.Classic;
            hand.pitchBlocked = false;
            scene.mouseLook = float2(0);
        }
        GUILayout.Label(hand.profile == ControlProfile.Classic ? "RMB jump / LMB boost" : "Space or LMB jump / Shift boost");
        GUILayout.Label(hand.profile == ControlProfile.Classic ? "Shift roll / Space ball cam" : "RMB roll / MMB ball cam");
        GUILayout.Slider("FOV", camera.fov, 60, 110);
        GUILayout.Slider("Distance (m)", camera.distance, 1, 4);
        GUILayout.Slider("Height (m)", camera.height, 0.4, 2);
        GUILayout.Slider("Angle", camera.angle, -45, 0);
        GUILayout.Slider("Stiffness", camera.stiffness, 0, 1);
        GUILayout.Slider("Swivel speed", camera.swivelSpeed, 1, 10);
        GUILayout.Slider("Transition", camera.transitionSpeed, 0.5, 3);
        GUILayout.Slider("Stick deadzone", hand.controllerDeadzone, 0.05, 0.75);
        GUILayout.Slider("Dodge deadzone", hand.dodgeDeadzone, 0.1, 1);
        GUILayout.Toggle("Keyboard aerial safety", hand.keyboardAerialSafety);
        GUILayout.Toggle("Camera shake", camera.shake);
        if (GUILayout.Button("Wide camera preset"))
        {
            camera.fov = 110; camera.distance = 2.7; camera.height = 1; camera.angle = -3;
            camera.stiffness = 0.5; camera.swivelSpeed = 5; camera.transitionSpeed = 1.2; camera.shake = false;
            scene.cameraReady = false;
        }
        if (GUILayout.Button("Back")) hand.settingsOpen = false;
    }
}
