using Rooms;

// Afterburn. One metre is one hundred arena units. Everything in this file
// belongs to the deterministic match; the stadium and cameras are local.
settings
{
    title = "Afterburn";
    appId = "dev.tide.private.afterburn";
    tickRate = 120;
    maxPlayers = 2;
    hostMigration = true;
}

const float ARENA_X = 40.96;
const float ARENA_Z = 51.2;
const float ARENA_HEIGHT = 20.48;
const float GOAL_X = 8.92755;
const float GOAL_HEIGHT = 6.42775;
const float GOAL_DEPTH = 8.8;
// smish.dev ball experiments and RocketSim RLConst/CarConfig. Values here
// are metres; their published Unreal-unit values are divided by one hundred.
const float BALL_RADIUS = 0.9125;
const float CAR_HEIGHT = 0.1701;
const float CAR_MASS = 180;
const float BALL_MASS = 30;
const float CAR_HALF_WIDTH = 0.433497;
const float CAR_HALF_HEIGHT = 0.1932955;
const float CAR_HALF_LENGTH = 0.602535;
const float CAR_OFFSET_FORWARD = 0.138757;
const float CAR_OFFSET_UP = 0.20755;
const float CORNER_RADIUS = 11.52;
const float RAMP_RADIUS = 2.56;
const int PAD_COUNT = 34;

enum MatchPhase { Kickoff, Playing, Goal, Finished }
enum MatchStages { Inputs, Simulation }

struct DriveInput
{
    float throttle;
    float steer;
    float pitch;
    float yaw;
    float roll;
    float dodgeDeadzone = 0.8;
    bool jump;
    bool boost;
    bool handbrake;
    bool suppressPitch;
}

struct CarState
{
    [Position] float3 position;
    float3 velocity;
    float3 forward = float3(0, 0, 1);
    float3 up = float3(0, 1, 0);
    // Local angular rates: pitch about right, yaw about up, roll about forward.
    float3 angularVelocity;
    float boost = 33.333333;
    bool grounded = true;
    bool boosting;
    bool jumpHeld;
    bool secondJump;
    bool hasJumped;
    bool jumpActive;
    bool supersonic;
    float airTime;
    float airTimeSinceJump;
    float jumpTime;
    float dodgeTime;
    float flipElapsed;
    float2 flipDirection;
    float boostTime;
    float powerslide;
    float supersonicTime;
    float ballHitCooldown;
    float bumpCooldown;
    float autoFlip;
    float autoFlipSign;
    int wheelContacts;
    int ballWheelContacts;
    float respawn;
    float wheelSpin;
    float steer;
    int team;
    int touches;
    int demolitions;
}

struct BallState
{
    [Position] float3 position = float3(0, BALL_RADIUS, 0);
    float3 velocity;
    float3 spin;
    int lastTouch = -1;
}

singleton MatchState
{
    CarState[2] cars;
    BallState ball;
    float[PAD_COUNT] pads;
    DriveInput[2] controls;
    bool[2] active;
    int blueScore;
    int orangeScore;
    float remaining = 300;
    float phaseTime;
    float elapsed;
    MatchPhase phase;
    bool overtime;
    int winner = -1;
    int lastScorer = -1;
    int humans;
    int occupied;
    bool initialized;
    bool ballGrounded;
    int kickoffs;
    Map<PlayerID, Entity> participants;
}

component Participant { int seat; }
scene Main { }
scene Match { }
command Restart { }

input Controls
{
    [Clamp(-1, 1)] float throttle;
    [Clamp(-1, 1)] float steer;
    [Clamp(-1, 1)] float pitch;
    [Clamp(-1, 1)] float yaw;
    [Clamp(-1, 1)] float roll;
    [Clamp(0.1, 1)] float dodgeDeadzone = 0.8;
    bool jump;
    bool boost;
    bool handbrake;
    bool suppressPitch;
    [Absolute] bool away = true;

    Sample(Devices devices, Lobby lobby, Hand hand)
    {
        if (!lobby.started) return;
        away = false;
        dodgeDeadzone = hand.dodgeDeadzone;
        if (!lobby.playing || hand.settingsOpen) return;
        var keys = devices.keyboard;
        var pad = devices.gamepad;
        var stickX = StickAxis(pad.leftStick.x, hand.controllerDeadzone);
        var stickY = StickAxis(pad.leftStick.y, hand.controllerDeadzone);
        var triggerRight = Math.Max(0, (pad.rightTrigger - 0.1) / 0.9);
        var triggerLeft = Math.Max(0, (pad.leftTrigger - 0.1) / 0.9);
        throttle = hand.throttle + triggerRight - triggerLeft;
        steer = hand.steer + stickX;
        pitch = hand.pitch - stickY;
        yaw = hand.yaw + stickX;
        roll = hand.roll;
        var classic = hand.profile == ControlProfile.Classic;
        var keyboardRoll = classic ? keys.leftShift.pressed : devices.mouse.right.pressed;
        var keyboardPitchFree = !hand.keyboardAerialSafety || !hand.pitchBlocked || keys.w.up || keys.upArrow.up || keys.s.pressed
                            || keys.downArrow.pressed || keys.q.pressed || keys.e.pressed || keyboardRoll;
        suppressPitch = !keyboardPitchFree && (keys.w.pressed || keys.upArrow.pressed) && stickY == 0 && hand.pitch == 0;
        if (keys.w.pressed || keys.upArrow.pressed) { throttle += 1; pitch -= 1; }
        if (keys.s.pressed || keys.downArrow.pressed) { throttle -= 1; pitch += 1; }
        if (keys.a.pressed || keys.leftArrow.pressed) { steer -= 1; yaw -= 1; }
        if (keys.d.pressed || keys.rightArrow.pressed) { steer += 1; yaw += 1; }
        if (keys.q.pressed) roll -= 1;
        if (keys.e.pressed) roll += 1;
        jump = hand.jump || pad.buttonSouth.pressed || (classic ? devices.mouse.right.pressed : keys.space.pressed || devices.mouse.left.pressed);
        boost = hand.boost || pad.buttonEast.pressed || (classic ? devices.mouse.left.pressed : keys.leftShift.pressed);
        handbrake = hand.handbrake || keyboardRoll || pad.buttonWest.pressed;
        // Standard controller air roll is LT. Powerslide remains X/Square;
        // only the keyboard and touch bind those two actions together.
        var airRoll = keyboardRoll || hand.handbrake || pad.leftTrigger > 0.1;
        if (airRoll) { roll += yaw; yaw = 0; }
    }
}

float3 UnitOr(float3 value, float3 fallback)
{
    var squared = Math.LengthSq(value);
    return squared > 0.000001 ? value / Math.Sqrt(squared) : fallback;
}

float3 CarRight(CarState car) { return UnitOr(Math.Cross(car.up, car.forward), float3(1, 0, 0)); }

float3 RotateVector(float3 value, float3 axis, float angle)
{
    var sine = Math.Sin(angle);
    var cosine = Math.Cos(angle);
    return value * cosine + Math.Cross(axis, value) * sine + axis * (Math.Dot(axis, value) * (1 - cosine));
}

void Orthonormalize(mut CarState car)
{
    car.forward = UnitOr(car.forward, float3(0, 0, 1));
    var right = UnitOr(Math.Cross(car.up, car.forward), float3(1, 0, 0));
    car.up = UnitOr(Math.Cross(car.forward, right), float3(0, 1, 0));
}

bool PadLarge(int index) { return index < 6; }

float3 PadPosition(int index)
{
    if (index < 4) return float3(index % 2 == 0 ? -30.72 : 30.72, 0, index < 2 ? -40.96 : 40.96);
    if (index < 6) return float3(index == 4 ? -35.84 : 35.84, 0, 0);
    // Exact standard Soccar pad centres, mirrored from the negative half.
    if (index == 32 || index == 33) return float3(index == 32 ? -10.24 : 10.24, 0, 0);
    var slot = (index - 6) % 13;
    var half = index < 19 ? -1 : 1;
    if (slot == 0) return float3(0, 0, half * 42.4);
    if (slot < 3) return float3(slot == 1 ? -17.92 : 17.92, 0, half * 41.84);
    if (slot < 5) return float3(slot == 3 ? -9.4 : 9.4, 0, half * 33.08);
    if (slot == 5) return float3(0, 0, half * 28.16);
    if (slot < 8) return float3(slot == 6 ? -35.84 : 35.84, 0, half * 24.84);
    if (slot < 10) return float3(slot == 8 ? -17.88 : 17.88, 0, half * 23);
    if (slot == 11) return float3(0, 0, half * 10.24);
    return float3(slot == 10 ? -20.48 : 20.48, 0, half * 10.36);
}

CarState KickoffCar(int seat, int kickoff)
{
    var sign = seat == 0 ? 1 : -1;
    // The five standard spawn slots, cycled without a hidden random source.
    var slot = kickoff % 5;
    var x = slot < 2 ? (slot == 0 ? -20.48 : 20.48) : slot < 4 ? (slot == 2 ? -2.56 : 2.56) : 0;
    var p = float3(x * sign, CAR_HEIGHT, -sign * (slot < 2 ? 25.6 : slot < 4 ? 38.4 : 46.08));
    var forward = slot < 2 ? UnitOr(float3(-x * sign, 0, sign * 20.48), float3(0, 0, sign)) : float3(0, 0, sign);
    return CarState { team = seat, position = p, forward = forward };
}

void ResetKickoff(mut MatchState state)
{
    state.kickoffs += 1;
    for (var seat = 0; seat < 2; seat++)
    {
        var old = state.cars[seat];
        state.cars[seat] = KickoffCar(seat, state.kickoffs);
        state.cars[seat].touches = old.touches;
        state.cars[seat].demolitions = old.demolitions;
    }
    state.ball = default;
    state.ballGrounded = true;
    for (var pad = 0; pad < PAD_COUNT; pad++) state.pads[pad] = 0;
    state.phase = MatchPhase.Kickoff;
    state.phaseTime = 3;
}

void NewMatch(mut MatchState state)
{
    state.blueScore = 0;
    state.orangeScore = 0;
    state.remaining = 300;
    state.elapsed = 0;
    state.overtime = false;
    state.winner = -1;
    state.lastScorer = -1;
    state.kickoffs = -1;
    state.cars[0] = default;
    state.cars[1] = default;
    state.initialized = true;
    ResetKickoff(state);
}

// Resolve a sphere against a plane, retaining the inward contact normal.
void PlaneContact(mut float3 position, mut float3 velocity, float3 normal,
                  float penetration, float restitution, mut float3 contact)
{
    if (penetration < -0.00001) return;
    position += normal * Math.Max(0, penetration);
    var incoming = Math.Dot(velocity, normal);
    if (incoming < 0) velocity -= normal * (incoming * (1 + restitution));
    contact = normal;
}

// Rounded horizontal corners and quarter-circle wall ramps make one closed
// playing volume. A goal is a real recess that cars and the ball can enter.
float3 ArenaContact(mut float3 position, mut float3 velocity, float radius, float restitution)
{
    mut var contact = float3(0);
    var sx = position.x < 0 ? -1 : 1;
    var sz = position.z < 0 ? -1 : 1;
    PlaneContact(position, velocity, float3(0, 1, 0), radius - position.y, restitution, contact);
    PlaneContact(position, velocity, float3(0, -1, 0), position.y - (ARENA_HEIGHT - radius), restitution, contact);
    PlaneContact(position, velocity, float3(-sx, 0, 0), Math.Abs(position.x) - (ARENA_X - radius), restitution, contact);
    var inMouth = Math.Abs(position.x) < GOAL_X - radius && position.y < GOAL_HEIGHT - radius;
    var pastLine = Math.Abs(position.z) > ARENA_Z;
    if (inMouth || pastLine && Math.Abs(position.x) < GOAL_X && position.y < GOAL_HEIGHT)
    {
        PlaneContact(position, velocity, float3(0, 0, -sz), Math.Abs(position.z) - (ARENA_Z + GOAL_DEPTH - radius), restitution, contact);
        if (pastLine)
        {
            PlaneContact(position, velocity, float3(-sx, 0, 0), Math.Abs(position.x) - (GOAL_X - radius), restitution, contact);
            PlaneContact(position, velocity, float3(0, -1, 0), position.y - (GOAL_HEIGHT - radius), restitution, contact);
        }
    }
    else PlaneContact(position, velocity, float3(0, 0, -sz), Math.Abs(position.z) - (ARENA_Z - radius), restitution, contact);

    var corner = float2(Math.Abs(position.x) - (ARENA_X - CORNER_RADIUS), Math.Abs(position.z) - (ARENA_Z - CORNER_RADIUS));
    if (corner.x > 0 && corner.y > 0)
    {
        var distance = Math.Length(corner);
        var normal = float3(-sx * corner.x / distance, 0, -sz * corner.y / distance);
        PlaneContact(position, velocity, normal, distance - (CORNER_RADIUS - radius), restitution, contact);
    }

    // Both the floor and ceiling blend into the walls. The centre of each
    // fillet is inside the field, so contact normals rotate continuously.
    for (var cap = 0; cap < 2; cap++)
    {
        var height = cap == 0 ? RAMP_RADIUS : ARENA_HEIGHT - RAMP_RADIUS;
        var nearCap = cap == 0 ? position.y < height : position.y > height;
        if (!nearCap) continue;
        var around = float2(Math.Abs(position.x) - (ARENA_X - CORNER_RADIUS), Math.Abs(position.z) - (ARENA_Z - CORNER_RADIUS));
        if (around.x > 0 && around.y > 0)
        {
            var radial = Math.Length(around);
            var bank = float2(radial - (CORNER_RADIUS - RAMP_RADIUS), position.y - height);
            if (bank.x > 0)
            {
                var distance = Math.Length(bank);
                var normal = float3(-sx * around.x / radial * bank.x / distance,
                    -bank.y / distance, -sz * around.y / radial * bank.x / distance);
                PlaneContact(position, velocity, normal, distance - (RAMP_RADIUS - radius), restitution, contact);
            }
        }
        var side = float2(Math.Abs(position.x) - (ARENA_X - RAMP_RADIUS), position.y - height);
        if (side.x > 0)
        {
            var distance = Math.Length(side);
            var normal = float3(-sx * side.x / distance, -side.y / distance, 0);
            PlaneContact(position, velocity, normal, distance - (RAMP_RADIUS - radius), restitution, contact);
        }
        var end = float2(Math.Abs(position.z) - (ARENA_Z - RAMP_RADIUS), position.y - height);
        if (end.x > 0 && !inMouth)
        {
            var distance = Math.Length(end);
            var normal = float3(0, -end.y / distance, -sz * end.x / distance);
            PlaneContact(position, velocity, normal, distance - (RAMP_RADIUS - radius), restitution, contact);
        }
    }
    return contact;
}

// Experimental coefficients: smish.dev/rocket_league/{ground_control,aerial_control}.
// Suspension geometry and jump/flip timing: RocketSim RLConst.h and CarConfig.cpp.
float ThrottleAcceleration(float speed)
{
    if (speed < 14) return 16 - speed * (14.4 / 14);
    if (speed < 14.1) return 1.6 * (14.1 - speed) / 0.1;
    return 0;
}

float SteeringAngle(float speed)
{
    if (speed < 5) return Math.Lerp(0.53356, 0.31930, speed / 5);
    if (speed < 10) return Math.Lerp(0.31930, 0.18203, (speed - 5) / 5);
    if (speed < 15) return Math.Lerp(0.18203, 0.10570, (speed - 10) / 5);
    if (speed < 17.5) return Math.Lerp(0.10570, 0.08507, (speed - 15) / 2.5);
    return Math.Lerp(0.08507, 0.03454, Math.Clamp((speed - 17.5) / 12.5, 0, 1));
}

float3 WorldAngular(CarState car)
{
    return CarRight(car) * car.angularVelocity.x + car.up * car.angularVelocity.y + car.forward * car.angularVelocity.z;
}

void SetWorldAngular(mut CarState car, float3 omega)
{
    var speed = Math.Length(omega);
    var limited = speed > 5.5 ? omega * (5.5 / speed) : omega;
    car.angularVelocity = float3(Math.Dot(limited, CarRight(car)), Math.Dot(limited, car.up), Math.Dot(limited, car.forward));
}

float3 InverseCarInertia(CarState car, float3 torque)
{
    var right = CarRight(car);
    var pitchInertia = CAR_MASS * (CAR_HALF_LENGTH * CAR_HALF_LENGTH + CAR_HALF_HEIGHT * CAR_HALF_HEIGHT) / 3;
    var yawInertia = CAR_MASS * (CAR_HALF_LENGTH * CAR_HALF_LENGTH + CAR_HALF_WIDTH * CAR_HALF_WIDTH) / 3;
    var rollInertia = CAR_MASS * (CAR_HALF_WIDTH * CAR_HALF_WIDTH + CAR_HALF_HEIGHT * CAR_HALF_HEIGHT) / 3;
    return right * (Math.Dot(torque, right) / pitchInertia) + car.up * (Math.Dot(torque, car.up) / yawInertia) + car.forward * (Math.Dot(torque, car.forward) / rollInertia);
}

void CarImpulse(mut CarState car, float3 impulse, float3 arm)
{
    car.velocity += impulse / CAR_MASS;
    SetWorldAngular(car, WorldAngular(car) + InverseCarInertia(car, Math.Cross(arm, impulse)));
}

struct WheelContact
{
    bool hit;
    float distance;
    float3 point;
    float3 normal;
}

// Cast the actual suspension ray against the same analytic stadium used by
// the sphere. Unlike a centre-of-mass sphere, a roof/side contact cannot turn
// into tyre grip. Bisection also follows the continuously curved wall banks.
WheelContact SurfaceRay(float3 origin, float3 direction, float length)
{
    mut var end = origin + direction * length;
    mut var velocity = float3(0);
    var normal = ArenaContact(end, velocity, 0, 0);
    if (Math.LengthSq(normal) < 0.5) return default;
    mut var low = 0.0;
    mut var high = length;
    for (var iteration = 0; iteration < 10; iteration++)
    {
        var middle = (low + high) * 0.5;
        mut var sample = origin + direction * middle;
        mut var unused = float3(0);
        var n = ArenaContact(sample, unused, 0, 0);
        if (Math.LengthSq(n) > 0.5) high = middle;
        else low = middle;
    }
    mut var point = origin + direction * high;
    mut var unused = float3(0);
    var n = ArenaContact(point, unused, 0, 0);
    return WheelContact { hit = true, distance = high, point = point, normal = n };
}

WheelContact BallRay(float3 origin, float3 direction, float length, BallState ball)
{
    var offset = origin - ball.position;
    var projection = Math.Dot(offset, direction);
    var discriminant = projection * projection - (Math.LengthSq(offset) - BALL_RADIUS * BALL_RADIUS);
    if (discriminant < 0) return default;
    var distance = -projection - Math.Sqrt(discriminant);
    if (distance < 0 || distance > length) return default;
    var point = origin + direction * distance;
    return WheelContact { hit = true, distance = distance, point = point,
        normal = UnitOr(point - ball.position, -direction) };
}

float3 WheelConnection(CarState car, int wheel)
{
    var front = wheel < 2;
    return car.position + car.up * CAR_OFFSET_UP + car.forward * (front ? 0.5125 : -0.3375) + CarRight(car) * ((wheel % 2 == 0 ? -1 : 1) * (front ? 0.259 : 0.295));
}

// The chassis is an offset oriented box, independently of the four wheels.
// Normal impulses use its inertia and contact lever arm, so landing on a
// corner or roof transfers rotation instead of snapping the car upright.
float3 ChassisContact(mut CarState car)
{
    mut var lastNormal = float3(0);
    for (var corner = 0; corner < 8; corner++)
    {
        var right = CarRight(car);
        var arm = right * ((corner & 1) == 0 ? -CAR_HALF_WIDTH : CAR_HALF_WIDTH) + car.up * (CAR_OFFSET_UP + ((corner & 2) == 0 ? -CAR_HALF_HEIGHT : CAR_HALF_HEIGHT)) + car.forward * (CAR_OFFSET_FORWARD + ((corner & 4) == 0 ? -CAR_HALF_LENGTH : CAR_HALF_LENGTH));
        var initial = car.position + arm;
        mut var point = initial;
        mut var unused = float3(0);
        var normal = ArenaContact(point, unused, 0.005, 0);
        if (Math.LengthSq(normal) < 0.5) continue;
        lastNormal = normal;
        car.position += point - initial;
        var contactVelocity = car.velocity + Math.Cross(WorldAngular(car), arm);
        var incoming = Math.Dot(contactVelocity, normal);
        if (incoming >= 0) continue;
        var effectiveMass = 1 / CAR_MASS + Math.Dot(normal, Math.Cross(InverseCarInertia(car, Math.Cross(arm, normal)), arm));
        mut var impulse = normal * (-incoming * 1.3 / effectiveMass);
        var tangent = contactVelocity - normal * incoming;
        var sliding = Math.Length(tangent);
        if (sliding > 0.0001)
        {
            var direction = tangent / sliding;
            var tangentMass = 1 / CAR_MASS + Math.Dot(direction, Math.Cross(InverseCarInertia(car, Math.Cross(arm, direction)), arm));
            impulse -= direction * Math.Min(sliding / tangentMass, Math.Length(impulse) * 0.3);
        }
        CarImpulse(car, impulse, arm);
    }
    return lastNormal;
}

void StepCar(mut CarState car, DriveInput control, float dt, BallState ball)
{
    if (car.respawn > 0)
    {
        car.respawn = Math.Max(0, car.respawn - dt);
        car.boosting = false;
        if (car.respawn == 0)
        {
            var team = car.team;
            var demos = car.demolitions;
            var touches = car.touches;
            car = KickoffCar(team, 4);
            car.position = float3(team == 0 ? -23.04 : 23.04, 0.36, team == 0 ? -46.08 : 46.08);
            car.demolitions = demos;
            car.touches = touches;
        }
        return;
    }
    var jumpPressed = control.jump && !car.jumpHeld;
    car.jumpHeld = control.jump;
    var initialChassisNormal = ChassisContact(car);
    if (jumpPressed && car.up.y < -0.94 && initialChassisNormal.y > 0.707 && car.autoFlip <= 0)
    {
        car.velocity -= car.up * 2;
        car.autoFlip = 0.4;
        car.autoFlipSign = Math.Dot(CarRight(car), float3(0, 1, 0)) >= 0 ? 1 : -1;
        car.secondJump = true;
    }
    car.steer = control.steer;
    car.ballHitCooldown = Math.Max(0, car.ballHitCooldown - dt);
    car.bumpCooldown = Math.Max(0, car.bumpCooldown - dt);
    car.powerslide = Math.Clamp(car.powerslide + (control.handbrake ? 5 : -2) * dt, 0, 1);

    // A tap burns for at least 0.1 seconds, and boosting always overrides the
    // throttle to full forward, even when reverse or no throttle is held.
    var continueBoost = car.boosting && car.boostTime < 0.1;
    car.boosting = car.boost > 0 && (control.boost || continueBoost);
    if (car.boosting) car.boostTime += dt;
    else car.boostTime = 0;
    var throttle = car.boosting ? 1 : control.throttle;
    var along = Math.Dot(car.velocity, car.forward);
    var right = CarRight(car);
    var oldOmega = WorldAngular(car);
    var wheelVelocity = car.velocity;
    mut var omega = oldOmega;
    mut var worldNormalSum = float3(0);
    mut var worldWheelContacts = 0;
    mut var suspensionImpulse = float3(0);
    mut var suspensionTorque = float3(0);
    mut WheelContact[4] wheelRays = default;
    mut bool[4] wheelOnBall = default;
    car.wheelContacts = 0;
    car.ballWheelContacts = 0;
    for (var wheel = 0; wheel < 4; wheel++)
    {
        var front = wheel < 2;
        var radius = front ? 0.125 : 0.15;
        var rest = front ? 0.26755 : 0.25055;
        var connection = WheelConnection(car, wheel);
        var length = rest + 0.12 + radius - 0.05;
        var worldRay = SurfaceRay(connection, -car.up, length);
        var sphereRay = BallRay(connection, -car.up, length, ball);
        var onBall = sphereRay.hit && (!worldRay.hit || sphereRay.distance < worldRay.distance);
        var ray = onBall ? sphereRay : worldRay;
        if (!ray.hit || Math.Dot(ray.normal, car.up) < 0.1) continue;
        wheelRays[wheel] = ray;
        wheelOnBall[wheel] = onBall;
        car.wheelContacts += 1;
        if (onBall)
        {
            car.ballWheelContacts += 1;
        }
        else
        {
            worldWheelContacts += 1;
            worldNormalSum += ray.normal;
        }
        // A held jump has left its wheels even while the suspension rays
        // can still reach the floor; do not add spring force to its impulse.
        if (car.jumpActive) continue;
        var arm = ray.point - car.position;
        var alignment = Math.Max(0.1, Math.Dot(ray.normal, car.up));
        // Pinned RocketSim damps chassis normal velocity even on a dynamic
        // wheel support; only tire friction reads the support's velocity.
        var relativeSpeed = Math.Dot(car.velocity + Math.Cross(omega, arm), ray.normal) / alignment;
        var springLength = Math.Clamp(ray.distance - radius, rest - 0.12, rest + 0.12);
        var spring = (rest - springLength) * 500 / alignment;
        var damping = (relativeSpeed < 0 ? 25 : 40) * relativeSpeed;
        var force = Math.Max(0, spring - damping) * (front ? 35.75 : 54.265);
        var impulse = ray.normal * (force * dt);
        suspensionImpulse += impulse;
        suspensionTorque += Math.Cross(arm, impulse);
    }
    car.grounded = car.wheelContacts >= 3 && !car.jumpActive;
    if (car.grounded)
    {
        car.airTime = 0;
        car.airTimeSinceJump = 0;
        car.secondJump = false;
        car.hasJumped = false;
        car.dodgeTime = 0;
        car.flipElapsed = 0;
        car.flipDirection = float2(0);
        car.jumpTime = 0;
    }
    else
    {
        car.airTime += dt;
        if (car.hasJumped && !car.jumpActive) car.airTimeSinceJump += dt;
        // Falling from a ceiling/wall without jumping never starts this
        // timer. A subsequent jump remains available however long the fall.
    }

    if (car.grounded && jumpPressed)
    {
        car.velocity += car.up * (875.0 / 300);
        car.hasJumped = true;
        car.jumpActive = true;
        car.jumpTime = 0;
        car.airTimeSinceJump = 0;
        car.grounded = false;
        suspensionImpulse = float3(0);
        suspensionTorque = float3(0);
    }
    else if (!car.grounded && jumpPressed && !car.secondJump && !car.jumpActive && car.airTimeSinceJump < 1.25 && car.autoFlip <= 0)
    {
        car.secondJump = true;
        var inputMagnitude = Math.Abs(control.pitch) + Math.Abs(control.yaw) + Math.Abs(control.roll);
        if (inputMagnitude >= control.dodgeDeadzone)
        {
            mut var direction = float2(-control.pitch, control.yaw + control.roll);
            if (Math.Abs(direction.x) < 0.1 && Math.Abs(direction.y) < 0.1) direction = float2(0);
            else direction = Math.Normalize(direction);
            car.flipDirection = direction;
            car.flipElapsed = 0;
            car.dodgeTime = 0.65;
            var ratio = Math.Abs(along) / 23;
            var backwards = Math.Abs(along) < 1 ? direction.x < 0 : (direction.x >= 0) != (along >= 0);
            var forwardImpulse = Math.Abs(direction.x) < 0.1 ? 0 : direction.x * 5 * (backwards ? (16.0 / 15) * (1 + 1.5 * ratio) : 1);
            var sidewaysImpulse = Math.Abs(direction.y) < 0.1 ? 0 : direction.y * 5 * (1 + 0.9 * ratio);
            var flatForward = UnitOr(float3(car.forward.x, 0, car.forward.z), float3(0, 0, 1));
            var flatRight = Math.Cross(float3(0, 1, 0), flatForward);
            car.velocity += flatForward * forwardImpulse + flatRight * sidewaysImpulse;
        }
        else car.velocity += car.up * (875.0 / 300);
    }

    if (car.jumpActive)
    {
        if (car.jumpTime < 0.2 && (control.jump || car.jumpTime < 0.025))
        {
            car.velocity += car.up * ((4375.0 / 300) * dt);
            // The measured three-frame sticky force acts opposite local up.
            if (car.jumpTime < 0.025) car.velocity -= car.up * (3.25 * dt);
            car.jumpTime += dt;
        }
        else car.jumpActive = false;
    }

    car.velocity += suspensionImpulse / CAR_MASS;
    omega += InverseCarInertia(car, suspensionTorque);
    if (car.wheelContacts > 0 && !car.jumpActive)
    {
        if (worldWheelContacts > 0)
        {
            var worldNormal = UnitOr(worldNormalSum, car.up);
            var sticky = 0.5 + ((Math.Abs(throttle) > 0.001 || Math.Abs(along) > 0.25) ? 1 - Math.Abs(worldNormal.y) : 0);
            car.velocity -= worldNormal * (6.5 * sticky * dt);
        }
        var powerslideAngle = Math.Lerp(0.39235, 0.12610, Math.Clamp(Math.Abs(along) / 25, 0, 1));
        var steerAngle = Math.Lerp(SteeringAngle(Math.Abs(along)), powerslideAngle, car.powerslide) * control.steer;
        mut var engineForce = throttle * ThrottleAcceleration(Math.Abs(along)) * CAR_MASS / 4 * (car.wheelContacts < 3 ? 0.25 : 1);
        mut var brake = 0.0;
        if (!control.handbrake)
        {
            if (Math.Abs(throttle) < 0.001)
            {
                engineForce = 0;
                brake = Math.Abs(along) < 0.25 ? 26.25 : 26.25 * 0.15;
            }
            else if (throttle * along < 0 && Math.Abs(along) > 0.25)
            {
                engineForce = 0;
                brake = 26.25;
            }
        }
        // Each steered front tire generates its own contact force and yaw
        // moment. RocketSim's bilateral tire solve includes both bodies'
        // point velocities/inertia, then applies the impulse to the car only.
        // Removing the local-up lever arm is the source's roll-influence rule.
        mut var tireImpulse = float3(0);
        mut var tireTorque = float3(0);
        for (var wheel = 0; wheel < 4; wheel++)
        {
            var ray = wheelRays[wheel];
            if (!ray.hit) continue;
            var axle = wheel < 2 ? RotateVector(right, car.up, steerAngle) : right;
            var side = UnitOr(axle - ray.normal * Math.Dot(axle, ray.normal), right);
            var forward = UnitOr(Math.Cross(side, ray.normal), car.forward);
            var arm = ray.point - car.position;
            var ballArm = ray.point - ball.position;
            var supportVelocity = wheelOnBall[wheel] ? ball.velocity + Math.Cross(ball.spin, ballArm) : float3(0);
            var relativeVelocity = wheelVelocity + Math.Cross(oldOmega, arm) - supportVelocity;
            var inverseMass = 1 / CAR_MASS + Math.Dot(side, Math.Cross(InverseCarInertia(car, Math.Cross(arm, side)), arm));
            var ballInverseInertia = 1 / (0.4 * BALL_MASS * BALL_RADIUS * BALL_RADIUS);
            var supportInverseMass = wheelOnBall[wheel] ? 1 / BALL_MASS + Math.Dot(side, Math.Cross(Math.Cross(ballArm, side) * ballInverseInertia, ballArm)) : 0;
            var sideImpulse = -0.2 * Math.Dot(relativeVelocity, side) / (inverseMass + supportInverseMass);
            var connectionVelocity = wheelVelocity + Math.Cross(oldOmega, WheelConnection(car, wheel) - car.position);
            var lateral = Math.Abs(Math.Dot(connectionVelocity, axle));
            var longitudinal = Math.Abs(Math.Dot(connectionVelocity, Math.Cross(axle, ray.normal)));
            var slip = lateral > 0.05 ? lateral / (longitudinal + lateral) : 0;
            var vertical = Math.Clamp(ray.normal.y, 0, 1);
            var passive = vertical < 0.7075 ? Math.Lerp(0.1, 0.5, vertical / 0.7075) : Math.Lerp(0.5, 1, (vertical - 0.7075) / 0.2925);
            var friction = throttle != 0 ? 1 : passive;
            var lateralGrip = (1 - 0.8 * slip) * (1 - 0.9 * car.powerslide) * friction;
            var longitudinalGrip = Math.Lerp(1, 0.5 + 0.4 * slip, car.powerslide) * friction;
            var driveForce = engineForce != 0 ? engineForce : Math.Clamp(-Math.Dot(relativeVelocity, forward) * 113.73963, -brake, brake) * (CAR_MASS / 3);
            var impulse = (forward * (driveForce * longitudinalGrip) + side * (sideImpulse * lateralGrip * CAR_MASS / 3)) * dt;
            var tireArm = arm - car.up * Math.Dot(car.up, arm);
            tireImpulse += impulse;
            tireTorque += Math.Cross(tireArm, impulse);
        }
        car.velocity += tireImpulse / CAR_MASS;
        omega += InverseCarInertia(car, tireTorque);
    }
    if (car.wheelContacts < 3)
    {
        // RL air throttle has no speed-dependent drag and reverse is half.
        car.velocity += car.forward * (control.throttle * (control.throttle < 0 ? 0.33334 : 0.666667) * dt);
    }

    if (!car.grounded)
    {
        mut var pitch = control.suppressPitch ? 0 : control.pitch;
        mut var allowAir = true;
        if (car.dodgeTime > 0)
        {
            var cancel = car.flipDirection.x * control.pitch > 0;
            var pitchScale = cancel ? 1 - Math.Abs(control.pitch) : 1;
            omega += (right * (car.flipDirection.x * 224 * pitchScale) - car.forward * (car.flipDirection.y * 260)) * dt;
            allowAir = cancel || Math.LengthSq(car.flipDirection) < 0.001;
            pitch = 0;
            car.flipElapsed += dt;
            car.dodgeTime = Math.Max(0, 0.65 - car.flipElapsed);
            if (car.flipElapsed >= 0.15 && (car.velocity.y < 0 || car.flipElapsed < 0.21)) car.velocity.y *= 0.65;
        }
        else if (car.flipElapsed > 0)
        {
            car.flipElapsed += dt;
            if (car.flipElapsed < 0.95) pitch = 0;
        }
        if (allowAir && car.autoFlip <= 0 && car.wheelContacts == 0)
        {
            var local = float3(Math.Dot(omega, right), Math.Dot(omega, car.up), Math.Dot(omega, car.forward));
            var acceleration = float3(-12.1459978 * pitch - 2.7981943 * (1 - Math.Abs(pitch)) * local.x,
                8.9196280 * control.yaw - 1.8864919 * (1 - Math.Abs(control.yaw)) * local.y,
                -36.0795662 * control.roll - 4.4716630 * local.z);
            omega += (right * acceleration.x + car.up * acceleration.y + car.forward * acceleration.z) * dt;
        }
    }
    if (car.autoFlip > 0)
    {
        omega += car.forward * (car.autoFlipSign * 50 * dt);
        car.autoFlip = Math.Max(0, car.autoFlip - dt);
    }
    if (car.boosting)
    {
        car.boost = Math.Max(0, car.boost - (100.0 / 3) * dt);
        car.velocity += car.forward * ((car.grounded ? 2975.0 / 300 : 3175.0 / 300) * dt);
    }
    car.velocity.y -= 6.5 * dt;
    var velocityLength = Math.Length(car.velocity);
    if (velocityLength > 23) car.velocity *= 23 / velocityLength;
    var angularSpeed = Math.Length(omega);
    if (angularSpeed > 5.5) omega *= 5.5 / angularSpeed;
    var averageOmega = (oldOmega + omega) * 0.5;
    var averageSpeed = Math.Length(averageOmega);
    if (averageSpeed > 0.000001)
    {
        var axis = averageOmega / averageSpeed;
        car.forward = RotateVector(car.forward, axis, averageSpeed * dt);
        car.up = RotateVector(car.up, axis, averageSpeed * dt);
    }
    Orthonormalize(car);
    SetWorldAngular(car, omega);
    car.position += car.velocity * dt;
    var chassisNormal = ChassisContact(car);
    if (jumpPressed && car.up.y < -0.94 && chassisNormal.y > 0.707 && car.autoFlip <= 0)
    {
        car.velocity -= car.up * 2;
        car.autoFlip = 0.4;
        car.autoFlipSign = Math.Dot(CarRight(car), float3(0, 1, 0)) >= 0 ? 1 : -1;
        car.secondJump = true;
    }
    car.wheelSpin += Math.Dot(car.velocity, car.forward) * dt / 0.14;
    if (Math.Abs(car.wheelSpin) > Math.TAU * 100) car.wheelSpin = 0;
}
float3 SolveColumns(float3 a, float3 b, float3 c, float3 value)
{
    var determinant = Math.Dot(a, Math.Cross(b, c));
    if (Math.Abs(determinant) < 0.00000001) return float3(0);
    return float3(Math.Dot(value, Math.Cross(b, c)), Math.Dot(a, Math.Cross(value, c)), Math.Dot(a, Math.Cross(b, value))) / determinant;
}

float3 ContactResponse(CarState car, float3 carArm, float3 ballArm, float3 impulse)
{
    var ballInverseInertia = 1 / (0.4 * BALL_MASS * BALL_RADIUS * BALL_RADIUS);
    return impulse * (1 / CAR_MASS + 1 / BALL_MASS) + Math.Cross(InverseCarInertia(car, Math.Cross(carArm, impulse)), carArm) + Math.Cross(Math.Cross(ballArm, impulse) * ballInverseInertia, ballArm);
}

// Rigid-body contact followed by the separate Psyonix extra ball impulse,
// measured in smish.dev/rocket_league/ball_simulation_3 and implemented in
// RocketSim Ball::_OnHit. The extra impulse is deliberately ball-only.
void TouchBall(mut CarState car, mut BallState ball, int seat)
{
    if (car.respawn > 0) return;
    var right = CarRight(car);
    var boxCentre = car.position + car.forward * CAR_OFFSET_FORWARD + car.up * CAR_OFFSET_UP;
    var offset = ball.position - boxCentre;
    var local = float3(Math.Dot(offset, right), Math.Dot(offset, car.up), Math.Dot(offset, car.forward));
    var closest = float3(Math.Clamp(local.x, -CAR_HALF_WIDTH, CAR_HALF_WIDTH), Math.Clamp(local.y, -CAR_HALF_HEIGHT, CAR_HALF_HEIGHT), Math.Clamp(local.z, -CAR_HALF_LENGTH, CAR_HALF_LENGTH));
    var point = boxCentre + right * closest.x + car.up * closest.y + car.forward * closest.z;
    var delta = ball.position - point;
    var distance = Math.Length(delta);
    if (distance >= BALL_RADIUS) return;
    var normal = UnitOr(delta, UnitOr(offset, float3(0, 1, 0)));
    var carArm = point - car.position;
    var ballArm = -normal * BALL_RADIUS;
    var preHitRelativeVelocity = car.velocity - ball.velocity;
    var preHitOffset = ball.position - car.position;
    var relativeVelocity = car.velocity + Math.Cross(WorldAngular(car), carArm) - ball.velocity - Math.Cross(ball.spin, ballArm);
    var closing = Math.Dot(relativeVelocity, normal);
    ball.position += normal * (BALL_RADIUS - distance + 0.0001);
    if (closing > 0)
    {
        var columnX = ContactResponse(car, carArm, ballArm, float3(1, 0, 0));
        var columnY = ContactResponse(car, carArm, ballArm, float3(0, 1, 0));
        var columnZ = ContactResponse(car, carArm, ballArm, float3(0, 0, 1));
        var solution = SolveColumns(columnX, columnY, columnZ, relativeVelocity);
        var normalMagnitude = Math.Max(0, Math.Dot(solution, normal));
        mut var tangent = solution - normal * Math.Dot(solution, normal);
        var tangentLength = Math.Length(tangent);
        if (tangentLength > normalMagnitude * 2 && tangentLength > 0.00001) tangent *= normalMagnitude * 2 / tangentLength;
        var impulse = normal * normalMagnitude + tangent;
        ball.velocity += impulse / BALL_MASS;
        ball.spin += Math.Cross(ballArm, impulse) / (0.4 * BALL_MASS * BALL_RADIUS * BALL_RADIUS);
        CarImpulse(car, -impulse, carArm);
    }
    if (car.ballHitCooldown <= 0)
    {
        var relativeSpeed = Math.Min(46, Math.Length(preHitRelativeVelocity));
        mut var hitDirection = preHitOffset;
        hitDirection.y *= 0.35;
        hitDirection = UnitOr(hitDirection, normal);
        hitDirection = UnitOr(hitDirection - car.forward * (Math.Dot(hitDirection, car.forward) * 0.35), normal);
        var factor = relativeSpeed < 5 ? 0.65 : relativeSpeed < 23 ? Math.Lerp(0.65, 0.55, (relativeSpeed - 5) / 18) : Math.Lerp(0.55, 0.3, (relativeSpeed - 23) / 23);
        ball.velocity += hitDirection * (relativeSpeed * factor);
        car.ballHitCooldown = 2.0 / 120;
        if (ball.lastTouch != seat || closing > 1) car.touches += 1;
    }
    var spinSpeed = Math.Length(ball.spin);
    if (spinSpeed > 6) ball.spin *= 6 / spinSpeed;
    ball.lastTouch = seat;
}
void ScoreGoal(mut MatchState state, int team)
{
    if (state.phase != MatchPhase.Playing) return;
    if (team == 0) state.blueScore += 1;
    else state.orangeScore += 1;
    state.lastScorer = team;
    state.phase = MatchPhase.Goal;
    state.phaseTime = 3.4;
    if (state.overtime || state.remaining <= 0)
    {
        if (state.blueScore != state.orangeScore)
            state.winner = state.blueScore > state.orangeScore ? 0 : 1;
    }
}

void StepBall(mut MatchState state, float dt)
{
    state.ball.velocity.y -= 6.5 * dt;
    state.ball.velocity *= Math.Max(0, 1 - 0.03 * dt);
    var speed = Math.Length(state.ball.velocity);
    if (speed > 60) state.ball.velocity *= 60 / speed;
    state.ball.position += state.ball.velocity * dt;
    // Keep the contact from before restitution: a ball bouncing at 0:00
    // ends regulation on its first floor hit, not when its bounces settle.
    state.ballGrounded = state.ball.position.y <= BALL_RADIUS + 0.008 && state.ball.velocity.y <= 0;
    for (var seat = 0; seat < 2; seat++)
    {
        mut var car = state.cars[seat];
        TouchBall(car, state.ball, seat);
        state.cars[seat] = car;
    }
    var struckSpeed = Math.Length(state.ball.velocity);
    if (struckSpeed > 60) state.ball.velocity *= 60 / struckSpeed;
    if (Math.Abs(state.ball.position.z) > ARENA_Z + BALL_RADIUS && Math.Abs(state.ball.position.x) < GOAL_X - BALL_RADIUS && state.ball.position.y < GOAL_HEIGHT - BALL_RADIUS)
        ScoreGoal(state, state.ball.position.z > 0 ? 0 : 1);
    var incoming = state.ball.velocity;
    mut var ignored = incoming;
    var contact = ArenaContact(state.ball.position, ignored, BALL_RADIUS, 0);
    if (Math.LengthSq(contact) > 0.5)
    {
        // Measured sphere bounce couples sliding speed and spin. The 0.285
        // slip coefficient and inertia factor3 are smish's model expressed
        // in metres (his angular factor0.0003 uses Unreal units squared).
        var normalSpeed = Math.Dot(incoming, contact);
        if (normalSpeed < 0)
        {
            var tangentialVelocity = incoming - contact * normalSpeed;
            var slip = tangentialVelocity + Math.Cross(contact, state.ball.spin) * BALL_RADIUS;
            var slipSpeed = Math.Length(slip);
            var slide = slipSpeed > 0.00001 ? -slip * (0.285 * Math.Min(1, 2 * Math.Abs(normalSpeed) / slipSpeed)) : float3(0);
            state.ball.velocity = incoming - contact * (1.6 * normalSpeed) + slide;
            state.ball.spin += Math.Cross(slide, contact) * (3 * BALL_RADIUS);
            if (Math.Abs(normalSpeed) < 0.08) state.ball.velocity -= contact * Math.Dot(state.ball.velocity, contact);
        }
    }
    var spin = Math.Length(state.ball.spin);
    if (spin > 6) state.ball.spin *= 6 / spin;
}

float3 CarBoxCentre(CarState car)
{
    return car.position + car.forward * CAR_OFFSET_FORWARD + car.up * CAR_OFFSET_UP;
}

float3 CarAxis(CarState car, int axis)
{
    return axis == 0 ? CarRight(car) : axis == 1 ? car.up : car.forward;
}

float CarProjection(CarState car, float3 normal)
{
    return Math.Abs(Math.Dot(CarRight(car), normal)) * CAR_HALF_WIDTH + Math.Abs(Math.Dot(car.up, normal)) * CAR_HALF_HEIGHT + Math.Abs(Math.Dot(car.forward, normal)) * CAR_HALF_LENGTH;
}

float3 ClosestCarPoint(CarState car, float3 point)
{
    var delta = point - CarBoxCentre(car);
    return CarBoxCentre(car) + CarRight(car) * Math.Clamp(Math.Dot(delta, CarRight(car)), -CAR_HALF_WIDTH, CAR_HALF_WIDTH) + car.up * Math.Clamp(Math.Dot(delta, car.up), -CAR_HALF_HEIGHT, CAR_HALF_HEIGHT) + car.forward * Math.Clamp(Math.Dot(delta, car.forward), -CAR_HALF_LENGTH, CAR_HALF_LENGTH);
}

float BumpCurve(float speed, float middle, float maximum, float zero)
{
    if (speed < 14) return Math.Lerp(zero, middle, Math.Max(0, speed) / 14);
    return Math.Lerp(middle, maximum, Math.Clamp((speed - 14) / 8, 0, 1));
}

void BumpCars(mut MatchState state)
{
    if (state.cars[0].respawn > 0 || state.cars[1].respawn > 0) return;
    var first = state.cars[0];
    var second = state.cars[1];
    var difference = CarBoxCentre(second) - CarBoxCentre(first);
    if (Math.LengthSq(difference) > 3) return;
    // The fifteen separating axes of two oriented boxes. Unlike a centre
    // sphere this distinguishes a roof landing, side swipe and bumper hit.
    mut var normal = float3(1, 0, 0);
    mut var depth = 100.0;
    for (var axis = 0; axis < 15; axis++)
    {
        var direction = axis < 3 ? CarAxis(first, axis) : axis < 6 ? CarAxis(second, axis - 3) : Math.Cross(CarAxis(first, (axis - 6) / 3), CarAxis(second, (axis - 6) % 3));
        var length = Math.Length(direction);
        if (length < 0.00001) continue;
        var unit = direction / length;
        var separation = Math.Dot(difference, unit);
        var overlap = CarProjection(first, unit) + CarProjection(second, unit) - Math.Abs(separation);
        if (overlap <= 0) return;
        if (overlap < depth)
        {
            depth = overlap;
            normal = separation < 0 ? -unit : unit;
        }
    }
    var point = (ClosestCarPoint(first, CarBoxCentre(second)) + ClosestCarPoint(second, CarBoxCentre(first))) * 0.5;
    var arm0 = point - first.position;
    var arm1 = point - second.position;
    // RocketSim's measured bumper-only addition and demolition gate. Capture
    // pre-contact velocities; resolving the rigid bodies must not change it.
    for (var attacker = 0; attacker < 2; attacker++)
    {
        var source = attacker == 0 ? first : second;
        var target = attacker == 0 ? second : first;
        var arm = ClosestCarPoint(source, CarBoxCentre(target)) - source.position;
        var toward = UnitOr(target.position - source.position, attacker == 0 ? normal : -normal);
        var velocityDirection = UnitOr(source.velocity, source.forward);
        var speedTowards = Math.Dot(source.velocity, toward);
        if (source.bumpCooldown > 0 || speedTowards <= 0 || speedTowards <= Math.Dot(target.velocity, velocityDirection) || Math.Dot(arm, source.forward) <= 0.645) continue;
        state.cars[attacker].bumpCooldown = 0.25;
        if (source.supersonic && source.team != target.team)
        {
            state.cars[1 - attacker].respawn = 3;
            state.cars[1 - attacker].velocity = float3(0);
            state.cars[attacker].demolitions += 1;
            return;
        }
        var amount = target.grounded ? BumpCurve(speedTowards, 11, 15.3, 0.008333333) : BumpCurve(speedTowards, 13.9, 19.45, 0.008333333);
        var upward = BumpCurve(speedTowards, 2.78, 4.17, 0.003333333);
        state.cars[1 - attacker].velocity += velocityDirection * amount + (target.grounded ? target.up : float3(0, 1, 0)) * upward;
    }
    state.cars[0].position -= normal * (depth * 0.5);
    state.cars[1].position += normal * (depth * 0.5);
    var relative = second.velocity + Math.Cross(WorldAngular(second), arm1) - first.velocity - Math.Cross(WorldAngular(first), arm0);
    var closing = Math.Dot(relative, normal);
    if (closing < 0)
    {
        var inverseMass = 2 / CAR_MASS + Math.Dot(normal, Math.Cross(InverseCarInertia(first, Math.Cross(arm0, normal)), arm0) + Math.Cross(InverseCarInertia(second, Math.Cross(arm1, normal)), arm1));
        var magnitude = -1.1 * closing / inverseMass;
        mut var impulse = normal * magnitude;
        var slip = relative - normal * closing;
        var slipSpeed = Math.Length(slip);
        if (slipSpeed > 0.00001)
        {
            var tangent = slip / slipSpeed;
            var tangentMass = 2 / CAR_MASS + Math.Dot(tangent, Math.Cross(InverseCarInertia(first, Math.Cross(arm0, tangent)), arm0) + Math.Cross(InverseCarInertia(second, Math.Cross(arm1, tangent)), arm1));
            impulse -= tangent * Math.Min(slipSpeed / tangentMass, magnitude * 0.09);
        }
        mut var resolvedFirst = state.cars[0];
        mut var resolvedSecond = state.cars[1];
        CarImpulse(resolvedFirst, -impulse, arm0);
        CarImpulse(resolvedSecond, impulse, arm1);
        state.cars[0] = resolvedFirst;
        state.cars[1] = resolvedSecond;
    }
}

void CollectPads(mut MatchState state, float dt)
{
    for (var pad = 0; pad < PAD_COUNT; pad++)
    {
        state.pads[pad] = Math.Max(0, state.pads[pad] - dt);
        if (state.pads[pad] > 0) continue;
        var at = PadPosition(pad);
        var reach = PadLarge(pad) ? 2.08 : 1.44;
        var height = PadLarge(pad) ? 1.68 : 1.65;
        for (var seat = 0; seat < 2; seat++)
        {
            var car = state.cars[seat];
            if (car.respawn > 0 || car.boost >= 100 || car.position.y > height) continue;
            var horizontal = float2(car.position.x - at.x, car.position.z - at.z);
            if (Math.LengthSq(horizontal) > reach * reach) continue;
            state.cars[seat].boost = Math.Min(100, car.boost + (PadLarge(pad) ? 100 : 12));
            state.pads[pad] = PadLarge(pad) ? 10 : 4;
            break;
        }
    }
}

DriveInput BotInput(MatchState state, int seat)
{
    var car = state.cars[seat];
    var sign = seat == 0 ? 1 : -1;
    var ball = state.ball;
    var right = CarRight(car);
    var speed = Math.Length(car.velocity);
    var flatBall = float3(ball.position.x, CAR_HEIGHT, ball.position.z);
    var distance = Math.Distance(car.position, flatBall);
    var lead = Math.Clamp(distance / (speed + 12), 0, 0.6);
    var predicted = float3(Math.Clamp(ball.position.x + ball.velocity.x * lead, -37, 37), CAR_HEIGHT,
        Math.Clamp(ball.position.z + ball.velocity.z * lead, -48, 48));
    // A shallow angle toward a goal corner gives each bot an actual shot
    // line. Their different preferred lanes also avoid symmetric kickoffs.
    var goal = float3(seat == 0 ? 2.5 : -1.5, CAR_HEIGHT, sign * (ARENA_Z + 2));
    var shot = UnitOr(goal - predicted, float3(0, 0, sign));
    var shotRight = Math.Cross(float3(0, 1, 0), shot);
    var relative = car.position - predicted;
    var behind = Math.Dot(relative, shot);
    var across = Math.Dot(relative, shotRight);
    // Continue a lined-up shot through contact. Repositioning two metres
    // before the ball makes the car turn away just outside bumper reach.
    var linedUp = behind <= 0.5 && Math.Abs(across) <= Math.Max(2, -behind * 0.55);
    mut var target = predicted + shot * 3;
    if (!linedUp)
    {
        // Get onto the goal-facing side before challenging, and take a wide
        // route around the sphere instead of hitting it toward our own end.
        var side = Math.Abs(across) > 0.2 ? Math.Sign(across) : seat == 0 ? 1 : -1;
        var around = behind > -1 ? 4.5 : 0;
        target = predicted - shot * 4 + shotRight * (side * around);
    }
    if (ball.position.z * sign < -30 && ball.velocity.z * sign < -4 && distance > 18)
        target = float3(Math.Clamp(ball.position.x * 0.4, -6, 6), CAR_HEIGHT, -sign * 44);
    if (car.boost < 18 && distance > 20 && ball.lastTouch >= 0)
    {
        mut var best = 1000.0;
        for (var pad = 0; pad < PAD_COUNT; pad++)
        {
            if (state.pads[pad] > 0) continue;
            var p = PadPosition(pad);
            var cost = Math.Distance(car.position, p) + Math.Distance(p, target) * 0.5 - (PadLarge(pad) ? 5 : 0);
            if (cost < best) { best = cost; target = p; }
        }
    }
    var heading = UnitOr(float3(target.x - car.position.x, 0, target.z - car.position.z), car.forward);
    var alignment = Math.Dot(heading, car.forward);
    var lateral = Math.Dot(heading, right);
    var angle = Math.Atan2(lateral, alignment);
    var targetDistance = Math.Distance(car.position, target);
    // Slow down while setting up a turn, but retain shot speed once aligned.
    var desiredSpeed = Math.Min(22, Math.Max(linedUp ? 12 : 4.5, targetDistance * 1.5)) * Math.Max(0.4, alignment);
    mut var input = DriveInput { throttle = 1,
        steer = Math.Clamp(angle * 2.5 - car.angularVelocity.y * 0.25, -1, 1) };
    input.handbrake = Math.Abs(angle) > 0.8 && speed > 5;
    if (speed > desiredSpeed + 1 && alignment > 0.3) input.throttle = -1;
    else if (alignment < 0.4) input.throttle = 0.65;
    input.boost = alignment > 0.97 && targetDistance > (linedUp ? 5 : 12) && distance > 3 && car.boost > 3;
    // Briefly reverse out of bumper deadlocks. The phased action is only
    // chosen when stationary and uses the same throttle/steering as a player.
    var recovery = state.elapsed + seat * 1.7;
    var cycle = recovery - Math.Floor(recovery / 5) * 5;
    if (car.grounded && speed < 4 && targetDistance > 6 && cycle > 3.9)
    {
        input.throttle = -1;
        input.steer = -input.steer;
        input.boost = false;
    }
    if (!car.grounded)
    {
        input.pitch = Math.Clamp(-car.forward.y * 3 + (ball.position.y > 3 && distance < 10 ? 0.4 : 0), -1, 1);
        input.yaw = Math.Clamp(angle * 1.5, -1, 1);
        input.roll = Math.Clamp(right.y * 3, -1, 1);
        input.boost = distance < 10 && ball.position.y > 3 && car.forward.y > 0.15 && alignment > 0.8;
        input.jump = car.airTime > 0.17 && car.airTime < 0.23 && !car.jumpHeld && distance < 4 && alignment > 0.9;
        if (input.jump) input.pitch = -1;
        if (car.up.y < -0.5)
        {
            input.roll = right.y >= 0 ? 1 : -1;
            input.pitch = Math.Clamp(-car.forward.y * 3, -1, 1);
            input.yaw = 0;
            input.boost = false;
            if (car.position.y < 0.8 && car.autoFlip <= 0) input.jump = !car.jumpHeld;
        }
    }
    else input.jump = distance < 4 && alignment > 0.9 && behind < -1 && ball.position.y > 1.7 && ball.position.y < 5;
    return input;
}
void AdvanceMatch(mut MatchState state, float dt)
{
    if (state.phase == MatchPhase.Finished) return;
    if (state.phase == MatchPhase.Kickoff)
    {
        state.phaseTime = Math.Max(0, state.phaseTime - dt);
        if (state.phaseTime == 0) state.phase = MatchPhase.Playing;
        return;
    }
    if (state.phase == MatchPhase.Goal)
    {
        state.phaseTime = Math.Max(0, state.phaseTime - dt);
        if (state.phaseTime > 0) return;
        if (state.winner >= 0) { state.phase = MatchPhase.Finished; return; }
        if (state.remaining <= 0 && state.blueScore == state.orangeScore) state.overtime = true;
        ResetKickoff(state);
        return;
    }
    state.elapsed += dt;
    if (!state.overtime) state.remaining = Math.Max(0, state.remaining - dt);
    // At 0:00 the final aerial remains live until the sphere touches ground.
    if (!state.overtime && state.remaining == 0 && state.ballGrounded)
    {
        if (state.blueScore == state.orangeScore)
        {
            state.overtime = true;
            ResetKickoff(state);
        }
        else
        {
            state.winner = state.blueScore > state.orangeScore ? 0 : 1;
            state.phase = MatchPhase.Finished;
        }
    }
}

event(PlayerJoined joined) Enter(mut MatchState state)
{
    if (state.participants.Has(joined.player) || state.humans >= 2) return;
    var seat = (state.occupied & 1) == 0 ? 0 : 1;
    state.occupied |= 1 << seat;
    state.humans += 1;
    state.participants[joined.player] = Spawn(Participant { seat = seat }, Owner { player = joined.player });
}

event(PlayerLeft left) Leave(mut MatchState state, World world)
{
    if (!state.participants.Has(left.player)) return;
    var entity = state.participants[left.player];
    var participant = world.Get<Participant>(entity);
    state.occupied &= ~(1 << participant.seat);
    state.active[participant.seat] = false;
    state.humans -= 1;
    entity.Destroy();
    state.participants.Remove(left.player);
}

command(Restart restart, PlayerID sender) StartAgain(mut MatchState state)
{
    if (!state.participants.Has(sender)) return;
    NewMatch(state);
}

[Stage(MatchStages.Inputs)]
system ClearControls(mut MatchState state)
{
    if (!state.initialized) NewMatch(state);
    state.active[0] = false;
    state.active[1] = false;
}

[Stage(MatchStages.Inputs), After(ClearControls)]
system ReadControls(Controls input, Participant participant, mut MatchState state, with Owner)
{
    var seat = participant.seat;
    if (seat < 0 || seat > 1 || input.away) return;
    state.active[seat] = true;
    state.controls[seat] = DriveInput { throttle = input.throttle, steer = input.steer,
        pitch = input.pitch, yaw = input.yaw, roll = input.roll,
        jump = input.jump, boost = input.boost, handbrake = input.handbrake, dodgeDeadzone = input.dodgeDeadzone, suppressPitch = input.suppressPitch };
}

[Stage(MatchStages.Simulation)]
system Simulate(mut MatchState state, Time time)
{
    var dt = time.dt;
    // Goal celebration leaves the ball and cars drifting under real physics.
    if (state.phase == MatchPhase.Playing || state.phase == MatchPhase.Goal)
    {
        for (var seat = 0; seat < 2; seat++)
        {
            var control = state.phase == MatchPhase.Goal ? DriveInput { } :
                state.active[seat] ? state.controls[seat] : BotInput(state, seat);
            mut var car = state.cars[seat];
            StepCar(car, control, dt, state.ball);
            state.cars[seat] = car;
        }
        BumpCars(state);
        StepBall(state, dt);
        // Contacts and the extra bumper impulse run after driving. Enforce
        // the published speed limit again at the completed physics tick.
        for (var seat = 0; seat < 2; seat++)
        {
            var speed = Math.Length(state.cars[seat].velocity);
            if (speed > 23) state.cars[seat].velocity *= 23 / speed;
            var angularSpeed = Math.Length(state.cars[seat].angularVelocity);
            if (angularSpeed > 5.5) state.cars[seat].angularVelocity *= 5.5 / angularSpeed;
            if (state.cars[seat].respawn > 0) continue;
            // RocketSim's grace belongs to the entire supersonic episode,
            // including time spent above22. Contacts must precede this test.
            var inGrace = state.cars[seat].supersonic && state.cars[seat].supersonicTime < 1;
            state.cars[seat].supersonic = speed >= (inGrace ? 21 : 22);
            if (state.cars[seat].supersonic) state.cars[seat].supersonicTime += dt;
            else state.cars[seat].supersonicTime = 0;
        }
        CollectPads(state, dt);
    }
    AdvanceMatch(state, dt);
}
