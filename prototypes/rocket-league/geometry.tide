// Original procedural arena and rally car geometry. Metres, y up, car nose +z.
struct Surface
{
    float3 position;
    float3 normal;
    Color color = Color.white;
    float material;
}

struct DrawPiece
{
    float4x4 transform = float4x4.identity;
    Color tint = Color.white;
    float glow;
}

local singleton Models
{
    bool made;
    List<Surface> arena;
    List<int> arenaFaces;
    List<Surface> turf;
    List<int> turfFaces;
    List<Surface> fence;
    List<int> fenceFaces;
    List<Surface> car;
    List<int> carFaces;
    List<Surface> wheel;
    List<int> wheelFaces;
    List<Surface> ball;
    List<int> ballFaces;
    List<Surface> glow;
    List<int> glowFaces;
    List<Surface> disc;
    List<int> discFaces;
}

Color Blue() { return Color(0.025, 0.36, 1); }
Color Orange() { return Color(1, 0.29, 0.025); }
Color TeamColor(int team) { return team == 0 ? Blue() : Orange(); }

void Face(mut List<Surface> vertices, mut List<int> indices, float3 a, float3 b, float3 c,
          float3 d, float3 normal, Color paint, float material = 0)
{
    var first = vertices.count;
    var forward = Math.Dot(Math.Cross(b - a, c - a), normal) > 0;
    vertices.Add(Surface { position = a, normal = normal, color = paint, material = material });
    vertices.Add(Surface { position = forward ? b : d, normal = normal, color = paint, material = material });
    vertices.Add(Surface { position = c, normal = normal, color = paint, material = material });
    vertices.Add(Surface { position = forward ? d : b, normal = normal, color = paint, material = material });
    indices.Add(first); indices.Add(first + 1); indices.Add(first + 2);
    indices.Add(first); indices.Add(first + 2); indices.Add(first + 3);
}

void Triangle(mut List<Surface> vertices, mut List<int> indices,
              float3 a, float3 b, float3 c, Color paint, float material = 0)
{
    var first = vertices.count;
    var normal = Math.Normalize(Math.Cross(b - a, c - a));
    vertices.Add(Surface { position = a, normal = normal, color = paint, material = material });
    vertices.Add(Surface { position = b, normal = normal, color = paint, material = material });
    vertices.Add(Surface { position = c, normal = normal, color = paint, material = material });
    indices.Add(first); indices.Add(first + 1); indices.Add(first + 2);
}

void Box(mut List<Surface> vertices, mut List<int> indices, float3 center, float3 size,
         Color paint, float material = 0)
{
    for (var face = 0; face < 6; face++)
    {
        var axis = face / 2;
        float way = face % 2 == 0 ? 1 : -1;
        var normal = float3(axis == 0 ? way : 0, axis == 1 ? way : 0, axis == 2 ? way : 0);
        var across = float3(axis == 1 ? 1 : 0, axis == 2 ? 1 : 0, axis == 0 ? 1 : 0);
        var up = Math.Cross(normal, across);
        Face(vertices, indices, center + (normal * 0.5 - across * 0.5 - up * 0.5) * size,
             center + (normal * 0.5 + across * 0.5 - up * 0.5) * size,
             center + (normal * 0.5 + across * 0.5 + up * 0.5) * size,
             center + (normal * 0.5 - across * 0.5 + up * 0.5) * size, normal, paint, material);
    }
}

// Chamfered sports-car shell, with independently authored upper and lower rings.
float2 BodyCorner(int i, float2 half)
{
    switch (i % 8)
    {
        case 0: return float2(-half.x * 0.75, -half.y);
        case 1: return float2(-half.x, -half.y * 0.72);
        case 2: return float2(-half.x, half.y * 0.72);
        case 3: return float2(-half.x * 0.75, half.y);
        case 4: return float2(half.x * 0.75, half.y);
        case 5: return float2(half.x, half.y * 0.72);
        case 6: return float2(half.x, -half.y * 0.72);
    }
    return float2(half.x * 0.75, -half.y);
}

void Shell(mut List<Surface> vertices, mut List<int> indices, float3 center, float2 lower,
           float2 upper, float height, float lean, Color paint, float material = 0)
{
    for (var i = 0; i < 8; i++)
    {
        var a = BodyCorner(i, lower); var b = BodyCorner(i + 1, lower);
        var c = BodyCorner(i + 1, upper); var d = BodyCorner(i, upper);
        var p = center + float3(a.x, -height * 0.5, a.y);
        var q = center + float3(b.x, -height * 0.5, b.y);
        var r = center + float3(c.x, height * 0.5, c.y + lean);
        var s = center + float3(d.x, height * 0.5, d.y + lean);
        var normal = Math.Normalize(Math.Cross(q - p, r - p));
        Face(vertices, indices, p, q, r, s, normal, paint, material);
        Triangle(vertices, indices, center - float3(0, height * 0.5, 0), q, p, paint, material);
        Triangle(vertices, indices, center + float3(0, height * 0.5, lean), s, r, paint, material);
    }
}

// A capped rod along any axis, used for pipes, cage members, axles and rims.
void Tube(mut List<Surface> vertices, mut List<int> indices, float3 from, float3 to,
          float radius, int segments, Color paint, float material = 0)
{
    var axis = Math.Normalize(to - from);
    var guide = Math.Abs(axis.y) > 0.95 ? float3(0, 0, 1) : float3(0, 1, 0);
    var across = Math.Normalize(Math.Cross(guide, axis));
    var around = Math.Cross(axis, across);
    for (var i = 0; i < segments; i++)
    {
        var a = i * Math.TAU / segments; var b = (i + 1) * Math.TAU / segments;
        var na = across * Math.Cos(a) + around * Math.Sin(a);
        var nb = across * Math.Cos(b) + around * Math.Sin(b);
        var first = vertices.count;
        vertices.Add(Surface { position = from + na * radius, normal = na, color = paint, material = material });
        vertices.Add(Surface { position = from + nb * radius, normal = nb, color = paint, material = material });
        vertices.Add(Surface { position = to + nb * radius, normal = nb, color = paint, material = material });
        vertices.Add(Surface { position = to + na * radius, normal = na, color = paint, material = material });
        indices.Add(first); indices.Add(first + 1); indices.Add(first + 2);
        indices.Add(first); indices.Add(first + 2); indices.Add(first + 3);
        Triangle(vertices, indices, from, from + nb * radius, from + na * radius, paint, material);
        Triangle(vertices, indices, to, to + na * radius, to + nb * radius, paint, material);
    }
}

void MakeCar(mut Models models)
{
    var dark = Color(0.025, 0.032, 0.045);
    var black = Color(0.009, 0.012, 0.018);
    var steel = Color(0.28, 0.34, 0.4);
    // Broad rally chassis, sculpted nose, glass cockpit and flared fenders.
    Shell(models.car, models.carFaces, float3(0, 0.09, 0), float2(0.91, 1.50), float2(0.86, 1.46), 0.34, 0, Color.white, 5);
    Shell(models.car, models.carFaces, float3(0, 0.33, 0.45), float2(0.82, 0.98), float2(0.68, 0.89), 0.23, -0.04, Color.white, 5);
    Shell(models.car, models.carFaces, float3(0, 0.57, -0.21), float2(0.73, 0.76), float2(0.53, 0.48), 0.48, -0.20, Color(0.055, 0.12, 0.18), 6);
    Shell(models.car, models.carFaces, float3(0, 0.83, -0.42), float2(0.54, 0.49), float2(0.53, 0.48), 0.055, 0, Color.white, 5);
    // Twin racing stripes run from bonnet to the roof; chrome pinlines sit beside them.
    for (var side = -1; side <= 1; side += 2)
    {
        Box(models.car, models.carFaces, float3(side * 0.16, 0.457, 0.73), float3(0.13, 0.018, 1.15), Color(0.88, 0.94, 1));
        Box(models.car, models.carFaces, float3(side * 0.16, 0.864, -0.42), float3(0.13, 0.012, 0.91), Color(0.88, 0.94, 1));
        Shell(models.car, models.carFaces, float3(side * 0.89, 0.16, 0.984), float2(0.21, 0.43), float2(0.18, 0.32), 0.39, 0, Color.white, 5);
        Shell(models.car, models.carFaces, float3(side * 0.89, 0.16, -1.253), float2(0.21, 0.36), float2(0.18, 0.29), 0.39, 0, Color.white, 5);
        Box(models.car, models.carFaces, float3(side * 0.87, -0.025, 0), float3(0.11, 0.14, 1.17), dark);
        Box(models.car, models.carFaces, float3(side * 0.55, 0.26, 1.48), float3(0.43, 0.15, 0.055), Color(0.68, 0.86, 1), 2);
        Box(models.car, models.carFaces, float3(side * 0.58, 0.25, -1.49), float3(0.42, 0.105, 0.045), Color(1, 0.035, 0.015), 2);
        Box(models.car, models.carFaces, float3(side * 0.73, 0.53, -1.16), float3(0.07, 0.48, 0.13), dark);
        Tube(models.car, models.carFaces, float3(side * 0.34, -0.06, -1.30), float3(side * 0.34, -0.06, -1.66), 0.135, 12, steel);
        Tube(models.car, models.carFaces, float3(side * 0.34, -0.06, -1.663), float3(side * 0.34, -0.06, -1.671), 0.10, 12, black);
        // Window pillars follow the windshield's slant.
        Tube(models.car, models.carFaces, float3(side * 0.72, 0.34, 0.49), float3(side * 0.52, 0.81, -0.12), 0.028, 6, dark);
        Tube(models.car, models.carFaces, float3(side * 0.71, 0.35, -0.84), float3(side * 0.52, 0.81, -0.90), 0.028, 6, dark);
        Box(models.car, models.carFaces, float3(side * 0.80, 0.45, 0.04), float3(0.20, 0.10, 0.22), dark);
        // Bonnet vents and flank scoops.
        for (var i = 0; i < 4; i++)
            Box(models.car, models.carFaces, float3(side * 0.54, 0.458, 0.36 + i * 0.15), float3(0.19, 0.016, 0.055), black);
        Box(models.car, models.carFaces, float3(side * 0.937, 0.15, -0.16), float3(0.018, 0.14, 0.47), black);
    }
    Box(models.car, models.carFaces, float3(0, 0.77, -1.23), float3(2.03, 0.10, 0.35), dark);
    Box(models.car, models.carFaces, float3(0, 0.829, -1.23), float3(2.05, 0.015, 0.31), Color.white, 5);
    Box(models.car, models.carFaces, float3(0, -0.065, 1.50), float3(1.51, 0.13, 0.13), dark);
    Box(models.car, models.carFaces, float3(0, 0.13, 1.526), float3(0.65, 0.13, 0.03), black);
    Box(models.car, models.carFaces, float3(0, -0.11, -1.47), float3(1.45, 0.16, 0.12), black);
    // Wheels' local axle is x. Tires, silver dish, radial spokes and hub.
    Tube(models.wheel, models.wheelFaces, float3(-0.15, 0, 0), float3(0.15, 0, 0), 0.39, 24, black, 8);
    for (var side = -1; side <= 1; side += 2)
    {
        Tube(models.wheel, models.wheelFaces, float3(side * 0.152, 0, 0), float3(side * 0.17, 0, 0), 0.255, 20, steel);
        Tube(models.wheel, models.wheelFaces, float3(side * 0.171, 0, 0), float3(side * 0.18, 0, 0), 0.16, 16, black);
        for (var spoke = 0; spoke < 5; spoke++)
        {
            var angle = spoke * Math.TAU / 5;
            Tube(models.wheel, models.wheelFaces, float3(side * 0.183, 0, 0),
                 float3(side * 0.183, Math.Cos(angle) * 0.235, Math.Sin(angle) * 0.235), 0.025, 5, Color(0.7, 0.79, 0.86));
        }
        Tube(models.wheel, models.wheelFaces, float3(side * 0.184, 0, 0), float3(side * 0.19, 0, 0), 0.065, 12, Color(0.85, 0.9, 0.95));
    }
}

void MakeBall(mut Models models)
{
    int rings = 24;
    int around = 40;
    for (var ring = 0; ring <= rings; ring++)
    {
        var tilt = ring * Math.PI / rings;
        for (var step = 0; step <= around; step++)
        {
            var angle = step * Math.TAU / around;
            var out = float3(Math.Sin(tilt) * Math.Cos(angle), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(angle));
            models.ball.Add(Surface { position = out, normal = out });
            if (ring == rings || step == around) continue;
            var at = ring * (around + 1) + step;
            models.ballFaces.Add(at); models.ballFaces.Add(at + around + 1); models.ballFaces.Add(at + 1);
            models.ballFaces.Add(at + 1); models.ballFaces.Add(at + around + 1); models.ballFaces.Add(at + around + 2);
        }
    }
}

void MakeGlow(mut Models models)
{
    // A small smooth sphere stretches into exhaust streaks without hard box
    // corners. It stays cheap even during a full goal celebration.
    int rings = 6;
    int around = 12;
    for (var ring = 0; ring <= rings; ring++)
        for (var step = 0; step <= around; step++)
        {
            var tilt = ring * Math.PI / rings;
            var angle = step * Math.TAU / around;
            var outward = float3(Math.Sin(tilt) * Math.Cos(angle), -Math.Cos(tilt), Math.Sin(tilt) * Math.Sin(angle));
            models.glow.Add(Surface { position = outward, normal = outward });
            if (ring == rings || step == around) continue;
            var at = ring * (around + 1) + step;
            models.glowFaces.Add(at); models.glowFaces.Add(at + around + 1); models.glowFaces.Add(at + 1);
            models.glowFaces.Add(at + 1); models.glowFaces.Add(at + around + 1); models.glowFaces.Add(at + around + 2);
        }
}

void GoalGeometry(mut Models models, int team)
{
    var sign = team == 0 ? -1.0 : 1.0;
    var z = sign * ARENA_Z;
    var back = sign * (ARENA_Z + GOAL_DEPTH);
    var tone = TeamColor(team);
    var dark = Color(0.018, 0.035, 0.055);
    Box(models.arena, models.arenaFaces, float3(0, -0.16, (z + back) * 0.5), float3(GOAL_X * 2, 0.3, GOAL_DEPTH), Color(0.035, 0.11, 0.12));
    for (var side = -1; side <= 1; side += 2)
    {
        Tube(models.arena, models.arenaFaces, float3(side * GOAL_X, 0, z), float3(side * GOAL_X, GOAL_HEIGHT, z), 0.22, 12, tone, 2);
        Tube(models.arena, models.arenaFaces, float3(side * GOAL_X, GOAL_HEIGHT, z), float3(side * GOAL_X, GOAL_HEIGHT, back), 0.13, 8, tone);
        Box(models.arena, models.arenaFaces, float3(side * (GOAL_X + 0.38), GOAL_HEIGHT * 0.5, (z + back) * 0.5),
            float3(0.55, GOAL_HEIGHT, GOAL_DEPTH + 1), dark);
        Face(models.fence, models.fenceFaces, float3(side * (GOAL_X - 0.05), 0, z), float3(side * (GOAL_X - 0.05), 0, back),
             float3(side * (GOAL_X - 0.05), GOAL_HEIGHT, back), float3(side * (GOAL_X - 0.05), GOAL_HEIGHT, z), float3(-side, 0, 0), tone, 1);
    }
    Tube(models.arena, models.arenaFaces, float3(-GOAL_X, GOAL_HEIGHT, z), float3(GOAL_X, GOAL_HEIGHT, z), 0.22, 12, tone, 2);
    Tube(models.arena, models.arenaFaces, float3(-GOAL_X, GOAL_HEIGHT, back), float3(GOAL_X, GOAL_HEIGHT, back), 0.13, 8, tone);
    Box(models.arena, models.arenaFaces, float3(0, GOAL_HEIGHT + 0.3, (z + back) * 0.5), float3(GOAL_X * 2 + 1, 0.45, GOAL_DEPTH + 1), dark);
    Face(models.fence, models.fenceFaces, float3(-GOAL_X, 0, back), float3(GOAL_X, 0, back),
         float3(GOAL_X, GOAL_HEIGHT, back), float3(-GOAL_X, GOAL_HEIGHT, back), float3(0, 0, -sign), tone, 1);
    Box(models.arena, models.arenaFaces, float3(0, 3, back + sign * 0.5), float3(GOAL_X * 2, 6, 0.5), Color(0.015, 0.035, 0.05));
}

void MakeStadium(mut Models models)
{
    var steel = Color(0.075, 0.10, 0.14);
    var dark = Color(0.012, 0.023, 0.04);
    Box(models.turf, models.turfFaces, float3(0, -0.16, 0), float3(ARENA_X * 2, 0.30, ARENA_Z * 2), Color.white, 1);
    // Continuous quarter-circle transition into each side wall.
    float ramp = RAMP_RADIUS;
    var straightZ = ARENA_Z - CORNER_RADIUS;
    var straightX = ARENA_X - CORNER_RADIUS;
    for (var side = -1; side <= 1; side += 2)
    {
        for (var step = 0; step < 16; step++)
        {
            var a = step * Math.PI * 0.5 / 16; var b = (step + 1) * Math.PI * 0.5 / 16;
            var x0 = side * (ARENA_X - ramp + ramp * Math.Sin(a));
            var x1 = side * (ARENA_X - ramp + ramp * Math.Sin(b));
            var y0 = ramp - ramp * Math.Cos(a); var y1 = ramp - ramp * Math.Cos(b);
            var n = Math.Normalize(float3(-side * Math.Sin((a + b) * 0.5), Math.Cos((a + b) * 0.5), 0));
            Face(models.arena, models.arenaFaces, float3(x0, y0, -straightZ), float3(x0, y0, straightZ),
                 float3(x1, y1, straightZ), float3(x1, y1, -straightZ), n, step < 8 ? Color(0.07, 0.18, 0.14) : steel);
        }
        Box(models.arena, models.arenaFaces, float3(side * (ARENA_X + 0.25), 4.15, 0), float3(0.5, 2.3, straightZ * 2), steel);
        for (var half = -1; half <= 1; half += 2)
        {
            var tone = half < 0 ? Blue() : Orange();
            Box(models.arena, models.arenaFaces, float3(side * (ARENA_X - 0.03), 3.15, half * straightZ * 0.5), float3(0.06, 0.12, straightZ), tone, 2);
            Box(models.arena, models.arenaFaces, float3(side * (ARENA_X - 0.04), 5.22, half * straightZ * 0.5), float3(0.07, 0.08, straightZ), tone, 2);
        }
        Face(models.fence, models.fenceFaces, float3(side * ARENA_X, 5.3, -straightZ), float3(side * ARENA_X, 5.3, straightZ),
             float3(side * ARENA_X, ARENA_HEIGHT, straightZ), float3(side * ARENA_X, ARENA_HEIGHT, -straightZ), float3(-side, 0, 0), Color(0.28, 0.55, 0.65));
        for (var z = -48; z <= 48; z += 12)
        {
            Tube(models.arena, models.arenaFaces, float3(side * (ARENA_X + 0.1), 4, z), float3(side * (ARENA_X + 0.1), 24, z), 0.13, 6, steel);
            // Grandstands rise outwards, rows separated by pale concrete risers.
            for (var row = 0; row < 8; row++)
            {
                var x = side * (ARENA_X + 3.8 + row * 1.35);
                var y = 5.8 + row * 1.0;
                Box(models.arena, models.arenaFaces, float3(x, y, z), float3(1.5, 0.24, 11.8), Color(0.09, 0.13, 0.17));
                Box(models.arena, models.arenaFaces, float3(x, y + 0.43, z), float3(0.65, 0.74, 11.3), row % 2 == 0 ? Color(0.11, 0.25, 0.38) : Color(0.045, 0.11, 0.18), 3);
            }
        }
        // Flying roof and luminous fascia, with visible supporting trusses.
        Box(models.arena, models.arenaFaces, float3(side * (ARENA_X + 12), 23.5, 0), float3(24, 1.4, ARENA_Z * 2 + 15), dark);
        Box(models.arena, models.arenaFaces, float3(side * (ARENA_X + 0.4), 23.0, 0), float3(0.22, 0.28, ARENA_Z * 2 + 12), Color(0.58, 0.78, 1), 2);
        for (var z = -44; z <= 44; z += 22)
        {
            Tube(models.arena, models.arenaFaces, float3(side * (ARENA_X + 16), 14, z), float3(side * (ARENA_X + 0.5), 23.3, z), 0.23, 6, steel);
            Box(models.arena, models.arenaFaces, float3(side * (ARENA_X - 0.25), 20.5, z), float3(0.8, 1.1, 7), steel);
            for (var lamp = 0; lamp < 7; lamp++)
                Box(models.arena, models.arenaFaces, float3(side * (ARENA_X - 0.70), 20.5, z - 2.7 + lamp * 0.9),
                    float3(0.06, 0.70, 0.63), Color(0.82, 0.9, 1), 2);
        }
    }
    for (var end = -1; end <= 1; end += 2)
    {
        var tone = end < 0 ? Blue() : Orange();
        for (var side = -1; side <= 1; side += 2)
        {
            var width = straightX - GOAL_X;
            Box(models.arena, models.arenaFaces, float3(side * (GOAL_X + width * 0.5), 1.8, end * (ARENA_Z + 0.2)), float3(width, 3.6, 0.4), steel);
            Box(models.arena, models.arenaFaces, float3(side * (GOAL_X + width * 0.5), 3.65, end * (ARENA_Z - 0.05)), float3(width, 0.13, 0.15), tone, 2);
            Face(models.fence, models.fenceFaces, float3(side * GOAL_X, 3.8, end * ARENA_Z), float3(side * straightX, 3.8, end * ARENA_Z),
                 float3(side * straightX, ARENA_HEIGHT, end * ARENA_Z), float3(side * GOAL_X, ARENA_HEIGHT, end * ARENA_Z), float3(0, 0, -end), tone);
            // The back wall has the same rideable quarter-circle, outside the goal mouth.
            for (var step = 0; step < 16; step++)
            {
                var a = step * Math.PI * 0.5 / 16; var b = (step + 1) * Math.PI * 0.5 / 16;
                var z0 = end * (ARENA_Z - ramp + ramp * Math.Sin(a));
                var z1 = end * (ARENA_Z - ramp + ramp * Math.Sin(b));
                var y0 = ramp - ramp * Math.Cos(a); var y1 = ramp - ramp * Math.Cos(b);
                var normal = Math.Normalize(float3(0, Math.Cos((a + b) * 0.5), -end * Math.Sin((a + b) * 0.5)));
                Face(models.arena, models.arenaFaces, float3(side * GOAL_X, y0, z0), float3(side * straightX, y0, z0),
                     float3(side * straightX, y1, z1), float3(side * GOAL_X, y1, z1), normal,
                     step < 8 ? Color(0.07, 0.18, 0.14) : steel);
            }
        }
        Face(models.fence, models.fenceFaces, float3(-GOAL_X, GOAL_HEIGHT + 0.6, end * ARENA_Z), float3(GOAL_X, GOAL_HEIGHT + 0.6, end * ARENA_Z),
             float3(GOAL_X, ARENA_HEIGHT, end * ARENA_Z), float3(-GOAL_X, ARENA_HEIGHT, end * ARENA_Z), float3(0, 0, -end), tone);
        // End stands and a giant inset blue/orange luminous screen.
        for (var row = 0; row < 8; row++)
        {
            var z = end * (ARENA_Z + GOAL_DEPTH + 3 + row * 1.3);
            var y = 6.2 + row;
            Box(models.arena, models.arenaFaces, float3(0, y, z), float3(ARENA_X * 2 + 14, 0.25, 1.5), Color(0.09, 0.12, 0.16));
            Box(models.arena, models.arenaFaces, float3(0, y + 0.45, z), float3(ARENA_X * 2 + 12, 0.75, 0.6), Color(0.12, 0.2, 0.26), 3);
        }
        Box(models.arena, models.arenaFaces, float3(0, 21.5, end * (ARENA_Z + 9)), float3(23, 7, 1), dark);
        Box(models.arena, models.arenaFaces, float3(0, 21.5, end * (ARENA_Z + 8.45)), float3(21.7, 5.8, 0.08), tone, 4);
        for (var i = -2; i <= 2; i++)
            Box(models.arena, models.arenaFaces, float3(i * 4.5, 21.5, end * (ARENA_Z + 8.38)), float3(0.045, 5.8, 0.05), Color(0.25, 0.6, 0.9));
        GoalGeometry(models, end < 0 ? 0 : 1);
    }
    // Rounded field corners continue the driveable bank and hex cage without gaps.
    for (var side = -1; side <= 1; side += 2)
        for (var end = -1; end <= 1; end += 2)
        {
            var tone = end < 0 ? Blue() : Orange();
            var center = float3(side * straightX, 0, end * straightZ);
            for (var arc = 0; arc < 16; arc++)
            {
                var a = arc * Math.PI * 0.5 / 16; var b = (arc + 1) * Math.PI * 0.5 / 16;
                var pa = float3(side * Math.Cos(a), 0, end * Math.Sin(a));
                var pb = float3(side * Math.Cos(b), 0, end * Math.Sin(b));
                var inward = -Math.Normalize(pa + pb);
                for (var rise = 0; rise < 10; rise++)
                {
                    var t0 = rise * Math.PI * 0.5 / 10; var t1 = (rise + 1) * Math.PI * 0.5 / 10;
                    var r0 = CORNER_RADIUS - ramp + ramp * Math.Sin(t0);
                    var r1 = CORNER_RADIUS - ramp + ramp * Math.Sin(t1);
                    var y0 = ramp - ramp * Math.Cos(t0); var y1 = ramp - ramp * Math.Cos(t1);
                    var normal = Math.Normalize(inward * Math.Sin((t0 + t1) * 0.5) + float3(0, Math.Cos((t0 + t1) * 0.5), 0));
                    Face(models.arena, models.arenaFaces, center + pa * r0 + float3(0, y0, 0), center + pb * r0 + float3(0, y0, 0),
                         center + pb * r1 + float3(0, y1, 0), center + pa * r1 + float3(0, y1, 0), normal,
                         rise < 5 ? Color(0.07, 0.18, 0.14) : steel);
                }
                Face(models.arena, models.arenaFaces, center + pa * CORNER_RADIUS + float3(0, ramp, 0), center + pb * CORNER_RADIUS + float3(0, ramp, 0),
                     center + pb * CORNER_RADIUS + float3(0, 5.3, 0), center + pa * CORNER_RADIUS + float3(0, 5.3, 0), inward, steel);
                Tube(models.arena, models.arenaFaces, center + pa * (CORNER_RADIUS - 0.04) + float3(0, 3.15, 0),
                     center + pb * (CORNER_RADIUS - 0.04) + float3(0, 3.15, 0), 0.07, 5, tone, 2);
                Tube(models.arena, models.arenaFaces, center + pa * (CORNER_RADIUS - 0.04) + float3(0, 5.22, 0),
                     center + pb * (CORNER_RADIUS - 0.04) + float3(0, 5.22, 0), 0.055, 5, tone, 2);
                Face(models.fence, models.fenceFaces, center + pa * CORNER_RADIUS + float3(0, 5.3, 0), center + pb * CORNER_RADIUS + float3(0, 5.3, 0),
                     center + pb * CORNER_RADIUS + float3(0, ARENA_HEIGHT, 0), center + pa * CORNER_RADIUS + float3(0, ARENA_HEIGHT, 0), inward, tone);
            }
    }
    // The roof is a transparent safety cage, at the simulation's exact ceiling.
    Face(models.fence, models.fenceFaces, float3(-ARENA_X, ARENA_HEIGHT, -ARENA_Z),
         float3(ARENA_X, ARENA_HEIGHT, -ARENA_Z), float3(ARENA_X, ARENA_HEIGHT, ARENA_Z),
         float3(-ARENA_X, ARENA_HEIGHT, ARENA_Z), float3(0, -1, 0), Color(0.30, 0.52, 0.65));
    // A city beyond the open roof gives a real horizon at car height.
    for (var i = 0; i < 44; i++)
    {
        var angle = i * Math.TAU / 44;
        var far = 119 + Math.Frac(i * 0.618) * 38;
        var high = 12 + Math.Frac(i * 0.371) * 48;
        var at = float3(Math.Cos(angle) * far, high * 0.5 - 5, Math.Sin(angle) * far);
        Box(models.arena, models.arenaFaces, at, float3(7 + Math.Frac(i * 0.77) * 8, high, 7), Color(0.09, 0.16, 0.23));
        Box(models.arena, models.arenaFaces, at + float3(0, high * 0.5, 0), float3(4, 0.2, 4), Color(0.27, 0.42, 0.49));
    }
}

void MakeModels(mut Models models)
{
    models.made = true;
    MakeCar(models);
    MakeBall(models);
    MakeGlow(models);
    MakeStadium(models);
    Face(models.disc, models.discFaces, float3(-1, 0, -1), float3(1, 0, -1), float3(1, 0, 1),
         float3(-1, 0, 1), float3(0, 1, 0), Color.white);
}
