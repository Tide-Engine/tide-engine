component Dot { int age; }
singleton State { int phase; Entity object; }
scene Main { }
event(Spawned) Setup(with Main, mut State state)
{
    state.object = Spawn(Dot);
#if ALL_VISIBLE
    Spawn(Visibility { group = Visibility.CreateGroup(Audience.All) });
#else
    Spawn(Visibility { group = Visibility.CreateGroup(Audience.None) });
#endif
}
system Step(mut State state)
{
    state.phase += 1;
    if (state.phase == 1) state.object.Destroy();
    if (state.phase == 2) state.object = Spawn(Dot);
}
system Age(mut Dot dot) { dot.age += 1; }
