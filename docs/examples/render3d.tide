settings { title = "Render3D: PBR, shadows and custom surfaces"; }
scene Main;

asset Render3D.Mesh3D sphere = "assets/render3d/sphere.obj";
asset Render3D.Mesh3D cube = "assets/render3d/cube.obj";

component Bands { local bool configured; }
component Sun { }
local singleton Controls
{
    bool lightsCreated;
    float exposure = 1;
    float sunlight = 5;
    bool shadows = true;
    float yaw = 0.64;
    float pitch = 0.38;
    float distance = 10.8;
    bool dragging;
    float pinch;
    int firstFinger;
    int secondFinger;
    bool open = true;
}

event(Spawned) BuildScene(with Main)
{
    Spawn(Render3D.MeshRenderer { mesh = cube },
          Render3D.Material { baseColor = Color(0.46, 0.49, 0.54), roughness = 0.9 },
          Transform { localPosition = float3(0, -0.15, 0), localScale = float3(10, 0.3, 7) });
    Spawn(Render3D.MeshRenderer { mesh = sphere },
          Render3D.Material { baseColor = Color(0.86, 0.2, 0.12), roughness = 0.25 },
          Transform { localPosition = float3(-2.1, 0.9, 0), localScale = float3(0.9) });
    Spawn(Render3D.MeshRenderer { mesh = sphere },
          Render3D.Material { baseColor = Color(1, 0.78, 0.33), metallic = 1, roughness = 0.22 },
          Transform { localPosition = float3(0, 0.9, 0), localScale = float3(0.9) });
    Spawn(Render3D.MeshRenderer { mesh = sphere }, Bands {},
          Render3D.Material { baseColor = Color(0.12, 0.72, 0.62), roughness = 0.5 },
          Transform { localPosition = float3(2.1, 0.9, 0), localScale = float3(0.9, 1.2, 0.9) });
    Spawn(Render3D.MeshRenderer { mesh = cube },
          Render3D.Material { baseColor = Color(0.23, 0.36, 0.65), roughness = 0.7 },
          Transform { localPosition = float3(0, 0.55, 2), localScale = float3(1.1),
                      localRotation = quaternion.Euler(float3(0, 30deg, 0)) });
}

// Local lights can be adjusted by this machine's UI.
[Before(Render3D.Stages.Prepare)]
view BuildLights(mut Controls controls)
{
    if (controls.lightsCreated) return;
    controls.lightsCreated = true;
    local Spawn(Sun {}, Render3D.DirectionalLight { direction = float3(-1, -2, 1), radiance = float3(5) });
    local Spawn(Render3D.DirectionalLight {
        direction = float3(1, -0.4, -1), radiance = float3(0.12, 0.18, 0.3), castShadows = false
    });
    local Spawn(Transform { localPosition = float3(2.1, 4, -1) }, Render3D.SpotLight {
        direction = float3(0, -1, 0.3), intensity = float3(10, 20, 30), range = 8,
        innerAngle = 25deg, outerAngle = 55deg, castShadows = true
    });
    local Spawn(Transform { localPosition = float3(-3, 2, -2) }, Render3D.PointLight {
        intensity = float3(6, 1.5, 0.5), range = 7
    });
}

// A material changes a numeric surface, while the package owns lighting/passes.
void Striped(Render3D.SurfaceInput input, mut Render3D.Surface surface)
{
    float band = Math.Sin(input.world.y * 10 + input.world.x * 2);
    surface.roughness = band > 0 ? 0.14 : 0.8;
    if (band < 0) surface.albedo *= 0.25;
}

[Before(Render3D.Stages.Prepare)]
view SetCustomSurface(mut Bands bands, mut Render3D.Material material)
{
    if (bands.configured) return;
    material.shader = Render3D.Lit { surface = Striped };
    bands.configured = true;
}

[Before(Render3D.Stages.Prepare)]
view ConfigureSun(mut local Render3D.DirectionalLight light, with local Sun, Controls controls)
{
    light.radiance = float3(controls.sunlight);
}

[Before(Render3D.Stages.Prepare)]
view CameraAndLight(mut Render3D.Renderer renderer, mut Controls controls, Devices devices)
{
    // GUI coordinates count down from the top; device coordinates count up.
    float panelTop = Screen.height - (controls.open ? 208 : 96);
    var pointer = devices.pointer;
    if (pointer.press.down) controls.dragging = Screen.Flip(pointer.position).y < panelTop;
    if (!pointer.press.pressed) controls.dragging = false;
    mut int fingers = 0;
    mut float2 firstPosition = float2(0);
    mut float2 secondPosition = float2(0);
    mut int firstId = 0;
    mut int secondId = 0;
    foreach (var touch in devices.touchscreen.touches)
    {
        if (!touch.press.pressed || Screen.Flip(touch.startPosition).y >= panelTop) continue;
        if (fingers == 0)
        {
            firstPosition = touch.position;
            firstId = touch.id;
        }
        if (fingers == 1)
        {
            secondPosition = touch.position;
            secondId = touch.id;
        }
        fingers += 1;
    }
    if (fingers >= 2)
    {
        float span = Math.Distance(firstPosition, secondPosition);
        if (controls.pinch > 0 && firstId == controls.firstFinger && secondId == controls.secondFinger)
            controls.distance *= controls.pinch / Math.Max(span, 1);
        controls.pinch = span;
        controls.firstFinger = firstId;
        controls.secondFinger = secondId;
        controls.dragging = false;
    }
    else
    {
        controls.pinch = 0;
        if (controls.dragging)
        {
            controls.yaw -= pointer.delta.x * 0.008;
            controls.pitch -= pointer.delta.y * 0.008;
        }
    }
    if (Screen.Flip(devices.mouse.position).y < panelTop)
        controls.distance *= Math.Pow(0.85, devices.mouse.scroll.y);
    controls.pitch = Math.Clamp(controls.pitch, 0.08, 1.35);
    controls.distance = Math.Clamp(controls.distance, 4, 18);
    float3 target = float3(0, controls.open ? -0.8 : 0.5, 0);
    float3 eye = target + float3(Math.Sin(controls.yaw) * Math.Cos(controls.pitch),
        Math.Sin(controls.pitch), -Math.Cos(controls.yaw) * Math.Cos(controls.pitch)) * controls.distance;
    renderer.camera = Render3D.Camera {
        position = eye,
        rotation = quaternion.LookRotation(target - eye, float3(0, 1, 0)),
        verticalFov = 45deg
    };
    renderer.exposure = controls.exposure;
    renderer.shadows = controls.shadows;
    // Cover the exhibits and their ground shadows at every zoom distance.
    renderer.shadowRange = controls.distance + 8;
    renderer.shadowDistance = 30;
}

[After(Render3D.Stages.Present)]
view Overlay(mut Controls controls)
{
    GUI.SetTheme(GUITheme { radius = 6 });
    // Leave the bottom-right stats line its own 40-pixel corner.
    GUILayout.Area(Rect(12, Screen.height - (controls.open ? 208 : 96), Screen.width - 24, controls.open ? 196 : 44))
    {
        GUILayout.Horizontal()
        {
            if (GUILayout.Button(controls.open ? "Hide controls" : "Controls")) controls.open = !controls.open;
            if (GUILayout.Button("Reset camera"))
            {
                controls.yaw = 0.64;
                controls.pitch = 0.38;
                controls.distance = 10.8;
            }
        }
        if (controls.open)
        {
            GUILayout.Label("Drag / swipe to orbit; pinch to zoom");
            GUILayout.Horizontal()
            {
                if (GUILayout.Button("Zoom +")) controls.distance = Math.Max(4, controls.distance - 1);
                if (GUILayout.Button("Zoom -")) controls.distance = Math.Min(18, controls.distance + 1);
            }
            GUILayout.Slider("Exposure", controls.exposure, 0.25, 3);
            GUILayout.Slider("Sunlight", controls.sunlight, 0, 12);
            GUILayout.Toggle("Shadows", controls.shadows);
        }
    }
}
