settings { title = "Random"; }

local scene Main { }

local singleton Dice
{
    int seed = 7;
    int dots = 400;
}

view Scatter(mut Dice dice)
{
    Draw.Clear(Color(0.086, 0.086, 0.094));
    Draw.SetCamera(float2(0, -0.25), 2.2);

    // A generator is a value. The same seed rolls the same numbers, on every
    // machine and in every frame: the dots stay where they are.
    mut var random = Random(dice.seed);
    for (var i = 0; i < dice.dots; i++)
    {
        var at = random.NextFloat2Direction() * Math.Sqrt(random.NextFloat()) * 1.5;
        var size = random.NextFloat(0.015, 0.05);
        Draw.Circle(at, size, Color(1, random.NextFloat(0.5, 0.85), random.NextFloat(0.1, 0.45)));
    }

    // Another generator with that seed starts the same sequence over.
    mut var die = Random(dice.seed);
    mut var rolls = $"Random({dice.seed}) rolls";
    for (var i = 0; i < 8; i++) rolls += $" {die.NextInt(1, 7)}";

    Draw.SetPixels();
    Draw.Text(rolls, float2(16, 14), 16, Color.white);
    GUI.SetTheme(GUITheme { radius = 6 });
    GUILayout.Area(Rect(12, Screen.height - 86, Screen.width - 24, 74))
    {
        GUILayout.IntSlider("Seed", dice.seed, 0, 20);
        GUILayout.IntSlider("Dots", dice.dots, 10, 2000);
    }
}
