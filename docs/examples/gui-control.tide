settings { title = "Controls"; }

local scene Main { }

local singleton Draft { int picked = -1; }

Color Shade(Color color, float light)
{
    return Color(color.r * light, color.g * light, color.b * light);
}

view Cards(mut Draft draft)
{
    Draw.Clear(Color(0.086, 0.086, 0.094));
    Draw.SetScreen();
    var width = (Screen.width - 64) / 3;
    for (var slot = 0; slot < 3; slot++)
    {
        // The GUI handles the rect's input as a button's, and draws nothing.
        var rect = Rect(16 + slot * (width + 16), 64, width, 200);
        var card = GUI.Control(rect);

        // Showing hover, focus and a press is the view's.
        var lit = card.hovered || card.focused;
        var lift = card.pressed && card.hovered ? 3 : lit ? -5 : 0;
        var center = float2(rect.x + rect.width * 0.5, rect.y + rect.height * 0.5 + lift);
        var size = float2(rect.width, rect.height);
        var tint = slot == 0 ? Color(0.98, 0.75, 0.14) : slot == 1 ? Color(0.98, 0.44, 0.52) : Color(0.18, 0.83, 0.75);
        var picked = draft.picked == slot;
        Draw.Shape(Shape { center = center + float2(0, 8), size = size, radius = 14, color = Color(0, 0, 0, 0.5), soft = 14 });
        Draw.Shape(Shape { center = center, size = size, radius = 14,
                             color = Shade(tint, lit ? 0.55 : 0.3), color2 = Shade(tint, 0.12),
                             outline = picked ? 3 : 1.5, outlineColor = picked || card.focused ? Color.white : tint });
        Draw.Circle(center - float2(0, 30), width * 0.24, tint);
        Draw.Text($"Card {slot + 1}", center + float2(0, 50), 16, Color.white, Anchor.MiddleCenter);
        if (card.clicked) draft.picked = slot;
    }
    Draw.Text(draft.picked < 0 ? "Pick a card" : $"You picked card {draft.picked + 1}",
                float2(Screen.width * 0.5, 30), 20, Color.white, Anchor.MiddleCenter);
    Draw.Text("The pointer, or Tab and Enter", float2(Screen.width * 0.5, 296), 13, Color(0.64, 0.64, 0.68), Anchor.MiddleCenter);
    GUI.SetTheme(GUITheme { radius = 6 });
    if (GUI.Button(Rect(16, Screen.height - 48, Screen.width - 32, 32), "Put it back")) draft.picked = -1;
}
