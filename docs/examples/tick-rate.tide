settings { title = "Tick rate"; tickRate = 5; maxPlayers = 1; } // Five ticks a second

component Mover
{
    float angle;
    float2 position;       // A view sees it blended between the last two ticks
    [Snap] float2 stepped; // Kept out of blending: as the last tick left it
}

scene Main { }

event(Spawned) Setup(with Main)
{
    Spawn(Mover { position = float2(1.3, 0), stepped = float2(1.3, 0) });
}

// The match only moves five times a second.
system Orbit(mut Mover mover, Time time)
{
    mover.angle += time.dt * 1.6;
    mover.position = float2(Math.Cos(mover.angle), Math.Sin(mover.angle)) * 1.3;
    mover.stepped = mover.position;
}

// Views run every frame, and draw the same match.
view Show(Mover mover, Time time)
{
    Draw2D.Clear(Color(0.04, 0.07, 0.12));
    Draw2D.Camera(float2(0, -0.1), 2.2);
    Draw2D.WireCircle(float2(0), 1.3, 0.02, Color(0.18, 0.24, 0.32));
    Draw2D.Circle(mover.stepped, 0.2, Color(1, 0.65, 0.3));
    Draw2D.Circle(mover.position, 0.14, Color(0.35, 0.9, 0.65));

    Draw2D.Screen();
    Draw2D.Text($"tick {time.tick}, at {time.tickRate} ticks a second", float2(16, 14), 18, Color.white);
    Draw2D.Text("float2 position: blended", float2(16, Screen.height - 50), 14, Color(0.35, 0.9, 0.65));
    Draw2D.Text("[Snap] float2 stepped: as the tick left it", float2(16, Screen.height - 30), 14, Color(1, 0.65, 0.3));
}
