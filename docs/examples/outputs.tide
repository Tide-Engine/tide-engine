settings { title = "Several colors"; }

local scene Main { }

// A vertex of our own: the engine has no lighting, so the normal is ours.
struct Corner
{
    float3 position;
    float3 normal;
}

// One for each thing drawn: where it is, and its color.
struct Block
{
    float4x4 transform;
    Color paint;
}

local singleton Stage
{
    RenderTarget scene;      // Three color images, each the window's size
    Texture normals;         // The second, as the frag that lights reads it
    Texture places;          // ...and the third
    List<Corner> cube;
    List<int> faces;
    List<Block> blocks;
    float2 at;               // Where the lamp is on the screen
    float3 lamp;             // ...and in the world
    float height = 1.2;
    float turn;
    int show;                // 0: lit. 1 to 3: one of the images, as it is
    bool moved;              // Not before the pointer was ever on this window
}

// One pass over the scene, and each pixel leaves three things: its paint, which
// way it faces, and where it is. Each `out Color` goes to the target's image
// that's its place among them. The last two aren't colors: their images are floats.
frag Fill(Corner corner, out Color paint, out Color normal, out Color place, Pixel pixel, Instance instance, Block block)
{
    float3 facing = Math.Normalize(Math.Rotate(instance.transform, corner.normal));
    paint = block.paint;
    normal = Color(facing.x, facing.y, facing.z);
    place = Color(pixel.world.x, pixel.world.y, pixel.world.z);
}

// A second pass, over the whole window, with nothing of the scene drawn again:
// each pixel is lit from what the first left there. The Blit's source is the
// first image, and the other two are the singleton's.
frag Light(Vertex vertex, out Color color, Texture source, Stage stage)
{
    Color paint = source.Sample(vertex.uv, Filter.Point);
    Color normal = stage.normals.Sample(vertex.uv, Filter.Point);
    Color place = stage.places.Sample(vertex.uv, Filter.Point);

    float3 toLamp = stage.lamp - float3(place.r, place.g, place.b);
    float facing = Math.Max(Math.Dot(float3(normal.r, normal.g, normal.b), Math.Normalize(toLamp)), 0);
    float reach = 1 / (1 + Math.Dot(toLamp, toLamp) * 0.15); // Dimmer the further the lamp is
    float shade = 0.3 + 1.6 * facing * reach;
    color = Color(paint.r * shade, paint.g * shade, paint.b * shade);

    if (stage.show == 1) color = paint;
    // A normal's parts go from -1 to 1, so half of each, from the middle
    if (stage.show == 2) color = Color(normal.r * 0.5 + 0.5, normal.g * 0.5 + 0.5, normal.b * 0.5 + 0.5);
    // A place is in meters, and goes much further: an eighth of each, from the middle
    if (stage.show == 3) color = Color(place.r * 0.125 + 0.5, place.g * 0.125 + 0.5, place.b * 0.125 + 0.5);
}

// A unit cube's side: four corners that share a normal, and two triangles,
// their corners clockwise as they're seen from outside: a triangle is drawn
// from that side alone.
void AddSide(mut Stage stage, float3 normal, float3 right, float3 up)
{
    int first = stage.cube.count;
    stage.cube.Add(Corner { position = (normal - right - up) * 0.5, normal = normal });
    stage.cube.Add(Corner { position = (normal + right - up) * 0.5, normal = normal });
    stage.cube.Add(Corner { position = (normal + right + up) * 0.5, normal = normal });
    stage.cube.Add(Corner { position = (normal - right + up) * 0.5, normal = normal });
    stage.faces.Add(first);
    stage.faces.Add(first + 2);
    stage.faces.Add(first + 1);
    stage.faces.Add(first);
    stage.faces.Add(first + 3);
    stage.faces.Add(first + 2);
}

view Show(mut Stage stage, Devices devices)
{
    if (stage.cube.count == 0)
    {
        AddSide(stage, float3(1, 0, 0), float3(0, 0, 1), float3(0, 1, 0));
        AddSide(stage, float3(-1, 0, 0), float3(0, 0, -1), float3(0, 1, 0));
        AddSide(stage, float3(0, 1, 0), float3(1, 0, 0), float3(0, 0, 1));
        AddSide(stage, float3(0, -1, 0), float3(1, 0, 0), float3(0, 0, -1));
        AddSide(stage, float3(0, 0, 1), float3(-1, 0, 0), float3(0, 1, 0));
        AddSide(stage, float3(0, 0, -1), float3(1, 0, 0), float3(0, 1, 0));
        // A color as it's looked at, and beside it two images of floats
        stage.scene = RenderTarget.Screen(Format.Color, Format.Float, Format.Float);
        stage.normals = stage.scene.colors[1];
        stage.places = stage.scene.colors[2];
    }
    stage.turn += Math.Min(Frame.dt, 0.05) * 0.6;
    if (stage.turn > Math.TAU) stage.turn -= Math.TAU;

    // A floor that goes past every edge of the picture, and blocks on it and over it
    var spin = quaternion.AxisAngle(float3(0, 1, 0), stage.turn);
    stage.blocks.Clear();
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(0, -0.1, 0), quaternion.identity, float3(80, 0.2, 80)), paint = Color(0.29, 0.29, 0.31) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(-1.6, 0.6, 0.4), spin, float3(1.2)), paint = Color(0.98, 0.75, 0.14) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(1.3, 0.4, -0.6), quaternion.identity, float3(0.8)), paint = Color(0.18, 0.83, 0.75) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(1.3, 1.5 + Math.Sin(stage.turn * 2) * 0.4, -0.6), spin, float3(1.4, 0.2, 1.4)),
                             paint = Color(0.98, 0.44, 0.52) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(-0.2, 0.25, -2.2), quaternion.identity, float3(2.6, 0.5, 0.5)), paint = Color(0.5, 0.5, 0.54) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(0.4, 1, 2.6), quaternion.identity, float3(0.5, 2, 0.5)), paint = Color(0.5, 0.5, 0.54) });

    // The first pass: a clear fills every image, and one draw writes all three
    var eye = float3(0, 6.5, -9.5);
    stage.scene.Clear(Color.black);
    stage.scene.SetCamera(eye, quaternion.LookRotation(Math.Normalize(float3(0, -1.6, 0) - eye), float3(0, 1, 0)), 45);
    stage.scene.Instanced(stage.cube, stage.faces, stage.blocks, Fill);

    // The lamp follows the pointer, and goes round by itself until there is one.
    // It's on the ray through its pixel, where that's as high over the floor as the slider says.
    var pointer = Screen.Flip(devices.pointer.position);
    if (Math.LengthSq(devices.pointer.delta) > 0 || devices.pointer.press.pressed) stage.moved = true;
    if (!stage.moved) stage.at = float2(Screen.width * (0.5 + Math.Cos(stage.turn * 2) * 0.3), Screen.height * (0.34 + Math.Sin(stage.turn * 2) * 0.14));
    else if (pointer.y < Screen.height - 132) stage.at = pointer;
    var from = stage.scene.ScreenRayOrigin(stage.at);
    var along = stage.scene.ScreenRayDirection(stage.at);
    if (along.y < -0.01) stage.lamp = from + along * ((stage.height - from.y) / along.y);

    // The second pass: the window gets the three images through the frag that lights
    Draw.Blit(stage.scene.color, Draw.window, Light);

    // The lamp, and the spot on the floor right under it
    Draw.SetScreen();
    var under = stage.scene.WorldToScreen(float3(stage.lamp.x, 0, stage.lamp.z));
    Draw.Line(float2(under.x, under.y), stage.at, 1, Color(0.64, 0.64, 0.68));
    Draw.Circle(stage.at, 7, Color(0.086, 0.086, 0.094));
    Draw.Circle(stage.at, 5, Color(0.98, 0.75, 0.14));

    mut string shown = "Lit, from all three images";
    if (stage.show == 1) shown = "The first image: paint";
    if (stage.show == 2) shown = "The second image: which way it faces";
    if (stage.show == 3) shown = "The third image: where it is";

    GUI.SetTheme(GUITheme { radius = 6 });
    GUILayout.Area(Rect(12, Screen.height - 124, Screen.width - 24, 112))
    {
        GUILayout.Label(shown);
        GUILayout.Slider("Lamp height", stage.height, 0.3, 3);
        GUILayout.Horizontal()
        {
            if (GUILayout.Button("Lit")) stage.show = 0;
            if (GUILayout.Button("Paint")) stage.show = 1;
            if (GUILayout.Button("Normals")) stage.show = 2;
            if (GUILayout.Button("Places")) stage.show = 3;
        }
    }
}
