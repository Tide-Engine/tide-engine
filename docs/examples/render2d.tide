settings { title = "Render2D: the lantern garden"; }
scene Main;

asset Texture floorMap = "assets/render2d/floor.png";
asset Texture plateMap = "assets/render2d/plate.png";
asset Texture fernMap = "assets/render2d/fern.png";
asset Texture lampMap = "assets/render2d/lamp.png";
[Raw] asset Texture floorNormal = "assets/render2d/floor-normal.png";
[Raw] asset Texture plateNormal = "assets/render2d/plate-normal.png";
[Raw] asset Texture fernNormal = "assets/render2d/fern-normal.png";

component Floor { }
component Plate { }
component Fern { }
component Lamp { }
component MovingLight { }

local singleton Controls
{
    bool started;
    bool normals = true;
    bool shadows = true;
    bool gi = true;
    bool bloom = true;
    bool animate = true;
    float phase;
}

event(Spawned) Garden(with Main)
{
    Spawn(Floor, Transform,
        Render2D.SpriteRenderer { size = float2(11, 8) },
        Render2D.Material { roughness = 0.85 });
    for (var y = 0; y < 2; y++)
    {
        for (var x = 0; x < 3; x++)
        {
            float2 at = float2(-3.4 + float(x) * 3.4, -2 + float(y) * 4);
            Spawn(Plate, Transform { localPosition = float3(at, 0.25) },
                Render2D.SpriteRenderer { size = float2(1.9) },
                Render2D.Material { metallic = 0.65, roughness = 0.32 });
            Spawn(Fern, Transform { localPosition = float3(at + float2(-0.12, 0.1), 1.1),
                                    localRotation = quaternion.Euler(0, 0, float(x + y) * 37deg) },
                Render2D.SpriteRenderer { size = float2(2.1) },
                Render2D.Material { roughness = 0.8 });
        }
    }
    // Thin elevated emissive cards: GI reaches the lower floor beside them.
    Spawn(Lamp, Transform { localPosition = float3(-1.8, 0, 1.8) },
        Render2D.SpriteRenderer { size = float2(1.1) },
        Render2D.Material { baseColor = Color(1, 0.66, 0.17), emission = float3(8, 3, 0.35) });
    Spawn(Lamp, Transform { localPosition = float3(1.8, 0, 2.3) },
        Render2D.SpriteRenderer { size = float2(1.1) },
        Render2D.Material { baseColor = Color(0.2, 0.85, 1), emission = float3(0.3, 4, 8) });
}

[Before(Render2D.Stages.Prepare)]
view Lighting(mut Controls controls, mut Render2D.Renderer renderer, mut Render2D.GlobalIllumination gi)
{
    if (!controls.started)
    {
        controls.started = true;
        local Spawn(MovingLight, Transform { localPosition = float3(-2, 0, 5) },
            Render2D.PointLight { intensity = float3(90, 48, 12), range = 18, castShadows = true });
        local Spawn(Transform { localPosition = float3(3, 1, 4) },
            Render2D.PointLight { intensity = float3(5, 35, 60), range = 15, castShadows = true });
    }
    if (controls.animate)
        controls.phase = Math.Frac((controls.phase + Frame.dt * 0.4) / (2 * Math.PI)) * (2 * Math.PI);
    float aspect = Math.Max(Screen.width, 1) / Math.Max(Screen.height, 1);
    // Fit the full garden above a compact control panel, also in a narrow embed.
    float usable = Math.Max(0.25, 1 - 132.0 / Math.Max(Screen.height, 1));
    float size = Math.Max(9 / usable, 12 / aspect);
    renderer.camera.verticalSize = size;
    renderer.camera.position = float2(0, -(1 - usable) * size * 0.5);
    renderer.background = Color(0.086, 0.086, 0.094);
    renderer.ambientIrradiance = float3(0.08, 0.10, 0.14);
    renderer.shadows = controls.shadows;
    renderer.maxShadowMaps = 12;
    renderer.shadowResolution = 512;
    renderer.exposure = 1.25;
    renderer.bloom.enabled = controls.bloom;
    renderer.bloom.intensity = 0.25;
    gi.enabled = controls.gi;
    gi.resolution = 128;
    gi.distance = 6;
}

[Before(Render2D.Stages.Prepare)]
view MoveLamp(local mut Transform transform, with local MovingLight, Controls controls)
{
    transform.localPosition = float3(-1.8 + Math.Sin(controls.phase) * 1.7, Math.Cos(controls.phase) * 2.0, 4.5);
}

[Before(Render2D.Stages.Prepare)]
view FloorMaps(mut Render2D.Material material, with Floor, Controls controls)
{
    material.baseMap = floorMap;
    if (controls.normals) material.normalMap = floorNormal;
    else material.normalMap = default;
}

[Before(Render2D.Stages.Prepare)]
view PlateMaps(mut Render2D.Material material, with Plate, Controls controls)
{
    material.baseMap = plateMap;
    if (controls.normals) material.normalMap = plateNormal;
    else material.normalMap = default;
}

[Before(Render2D.Stages.Prepare)]
view FernMaps(mut Render2D.Material material, with Fern, Controls controls)
{
    material.baseMap = fernMap;
    if (controls.normals) material.normalMap = fernNormal;
    else material.normalMap = default;
}

[Before(Render2D.Stages.Prepare)]
view LampMaps(mut Render2D.Material material, with Lamp)
{
    material.baseMap = lampMap;
}

[After(Render2D.Stages.Present)]
view Panel(mut Controls controls)
{
    GUI.SetTheme(GUITheme { radius = 6 });
    GUILayout.Area(Rect(12, Screen.height - 132, Screen.width - 24, 84))
    {
        GUILayout.Label("THE LANTERN GARDEN");
        GUILayout.Horizontal()
        {
            GUILayout.Toggle("Normals", controls.normals);
            GUILayout.Toggle("Shadows", controls.shadows);
            GUILayout.Toggle("GI", controls.gi);
        }
        GUILayout.Horizontal()
        {
            GUILayout.Toggle("Bloom", controls.bloom);
            GUILayout.Toggle("Move light", controls.animate);
        }
    }
}
