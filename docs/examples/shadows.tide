settings { title = "Shadows"; }

local scene Main { }

// A vertex of our own: the engine has no lighting, so the normal is ours.
struct Corner
{
    float3 position;
    float3 normal;
}

// One for each thing drawn: where it is, and its color.
struct Block
{
    float4x4 transform;
    Color paint;
}

local singleton Stage
{
    RenderTarget map;        // What's nearest the lamp: depth alone, 1024 pixels a side on any display
    DepthTexture shadow;     // ...as the frags read it
    float4x4 toLamp;         // From the world to the lamp's clip space
    float3 lampDirection;
    List<Corner> cube;
    List<int> faces;
    List<Block> blocks;
    List<Vertex> corner;     // Where the lamp's depth is shown
    float turn;
    float lampAngle = 0.9;
    bool soft = true;
    bool showDepth;
}

// Once for each pixel: its own light, and whether the lamp sees it.
frag Lit(Corner corner, out Color color, Pixel pixel, Instance instance, Block block, Stage stage)
{
    float3 normal = Math.Normalize(Math.Rotate(instance.transform, corner.normal));
    float facing = Math.Max(Math.Dot(normal, -stage.lampDirection), 0);

    // Where this pixel is in the lamp's image, and how far from the lamp
    float4 seen = Math.Mul(stage.toLamp, float4(pixel.world, 1));
    float2 uv = float2(seen.x * 0.5 + 0.5, 0.5 - seen.y * 0.5);
    // A little nearer than it is, so what the lamp sees isn't in its own shadow
    float depth = seen.z * 0.5 + 0.5 - 0.003;

    // 1 where nothing is nearer the lamp, 0 in shadow: the GPU blends the edge
    mut float lit = stage.shadow.Compare(uv, depth);
    if (stage.soft)
    {
        // ...and four of those, a pixel of the lamp's image apart, blend it wider
        float step = 1.5 / 1024;
        lit = (stage.shadow.Compare(uv + float2(-step, -step), depth) + stage.shadow.Compare(uv + float2(step, -step), depth)
             + stage.shadow.Compare(uv + float2(-step, step), depth) + stage.shadow.Compare(uv + float2(step, step), depth)) * 0.25;
    }
    float shade = 0.22 + 0.78 * facing * lit;
    color = Color(block.paint.r * shade, block.paint.g * shade, block.paint.b * shade);
}

// The lamp's image itself: near is dark, and what nothing was drawn on is white.
frag LampDepth(Vertex vertex, out Color color, Stage stage)
{
    float depth = stage.shadow.Sample(vertex.uv);
    color = Color(depth, depth, depth);
}

// A unit cube's side: four corners that share a normal, and two triangles.
void AddSide(mut Stage stage, float3 normal, float3 right, float3 up)
{
    int first = stage.cube.count;
    stage.cube.Add(Corner { position = (normal - right - up) * 0.5, normal = normal });
    stage.cube.Add(Corner { position = (normal + right - up) * 0.5, normal = normal });
    stage.cube.Add(Corner { position = (normal + right + up) * 0.5, normal = normal });
    stage.cube.Add(Corner { position = (normal - right + up) * 0.5, normal = normal });
    stage.faces.Add(first);
    stage.faces.Add(first + 1);
    stage.faces.Add(first + 2);
    stage.faces.Add(first);
    stage.faces.Add(first + 2);
    stage.faces.Add(first + 3);
}

view Show(mut Stage stage)
{
    if (stage.cube.count == 0)
    {
        AddSide(stage, float3(1, 0, 0), float3(0, 0, 1), float3(0, 1, 0));
        AddSide(stage, float3(-1, 0, 0), float3(0, 0, -1), float3(0, 1, 0));
        AddSide(stage, float3(0, 1, 0), float3(1, 0, 0), float3(0, 0, 1));
        AddSide(stage, float3(0, -1, 0), float3(1, 0, 0), float3(0, 0, -1));
        AddSide(stage, float3(0, 0, 1), float3(-1, 0, 0), float3(0, 1, 0));
        AddSide(stage, float3(0, 0, -1), float3(1, 0, 0), float3(0, 1, 0));
        // Depth alone: nothing looks at this target but the frags that read its depth
        stage.map = RenderTarget(1024, 1024, 1, Format.DepthOnly);
        stage.shadow = stage.map.depth;
        stage.corner = [Vertex { position = float2(12, 12) }, Vertex { position = float2(108, 12), uv = float2(1, 0) },
                        Vertex { position = float2(108, 108), uv = float2(1, 1) }, Vertex { position = float2(12, 108), uv = float2(0, 1) }];
    }
    stage.turn += Math.Min(Frame.dt, 0.05) * 0.6;
    if (stage.turn > Math.TAU) stage.turn -= Math.TAU;

    // A floor, and blocks on it and over it: one of them turns, one bobs
    var spin = quaternion.AxisAngle(float3(0, 1, 0), stage.turn);
    stage.blocks.Clear();
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(0, -0.1, 0), quaternion.identity, float3(9, 0.2, 9)), paint = Color(0.24, 0.25, 0.27) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(-1.6, 0.6, 0.4), spin, float3(1.2)), paint = Color(0.98, 0.75, 0.14) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(1.3, 0.4, -0.6), quaternion.identity, float3(0.8)), paint = Color(0.18, 0.83, 0.75) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(1.3, 1.5 + Math.Sin(stage.turn * 2) * 0.4, -0.6), spin, float3(1.4, 0.2, 1.4)),
                             paint = Color(0.98, 0.44, 0.52) });
    stage.blocks.Add(Block { transform = float4x4.TRS(float3(-0.2, 0.25, -2.2), quaternion.identity, float3(2.6, 0.5, 0.5)), paint = Color(0.64, 0.64, 0.68) });

    // The lamp looks down at the middle from 12 away, and sees a box 12 by 12 with no perspective
    stage.lampDirection = Math.Normalize(float3(Math.Cos(stage.lampAngle), -1.2, Math.Sin(stage.lampAngle)));
    var lamp = float4x4.TRS(stage.lampDirection * -12, quaternion.LookRotation(stage.lampDirection, float3(0, 1, 0)), float3(1));
    var sees = float4x4.Ortho(12, 12, 0.1, 30);
    // A camera looks along its +z, and clip space along -z: the world to the lamp's clip space is its
    // projection, after z turned around, after the lamp's transform undone
    stage.toLamp = Math.Mul(sees, Math.Mul(float4x4.TRS(float3(0), quaternion.identity, float3(1, 1, -1)), Math.Inverse(lamp)));

    // What casts, through the lamp's camera: no frag, as there's no color to write there
    stage.map.Clear(Color.white);
    stage.map.SetCamera(lamp, sees);
    stage.map.Instanced(stage.cube, stage.faces, stage.blocks);

    // Then the picture: every pixel asks the lamp's image whether the lamp sees it
    Draw2D.Clear(Color(0.086, 0.086, 0.094));
    var eye = float3(0, 6.5, -9.5);
    Draw3D.SetCamera(eye, quaternion.LookRotation(Math.Normalize(float3(0, -1.6, 0) - eye), float3(0, 1, 0)), 45);
    Draw3D.Instanced(stage.cube, stage.faces, stage.blocks, Lit);

    Draw2D.SetScreen();
    if (stage.showDepth) Draw2D.Mesh(stage.corner, [0, 1, 2, 0, 2, 3], LampDepth);

    GUI.SetTheme(GUITheme { radius = 6 });
    GUILayout.Area(Rect(12, Screen.height - 124, Screen.width - 24, 112))
    {
        GUILayout.Slider("Lamp", stage.lampAngle, 0, Math.TAU);
        GUILayout.Toggle("Soft edges", stage.soft);
        GUILayout.Toggle("The lamp's depth", stage.showDepth);
    }
}
