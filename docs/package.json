{
  "name": "tide-engine-docs",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && node server.js",
    "start": "node server.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:grammar": "node --test ../tools/tide-syntax/test/grammar.test.mjs",
    "test:access": "node --test tests/access.test.mjs",
    "test:access-http": "node --test tests/access-http.test.mjs",
    "test:releases": "node --test tests/releases.test.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs tests/admin.test.mjs",
    "test:admin-http": "node --test tests/admin-http.test.mjs",
    "test:examples": "node tests/examples.mjs && node --test tests/playground.test.mjs",
    "test:playground": "node --test tests/playground.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "markdown-it": "^15.0.2",
    "markdown-it-container": "^4.0.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.5.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.2",
    "yaml": "^2.9.1"
  }
}
