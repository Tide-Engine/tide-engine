// The Tide package's sample: each player is a ball in a box, rolled with WASD or a stick, Space to jump.
// Tide simulates, predicts and rolls back; Unity draws. Unity's prefabs and scenes holding TideEntity objects are
// Tide's, under UnityEngine: the ball is UnityEngine.Prefabs.Roller (Assets/Sample/Roller.prefab), the pillars are the
// scene UnityEngine.Scenes.Bounce's (Bounce.unity, Build Settings' first scene, which the match loads as Main starts).
using UnityEngine.Prefabs;
using UnityEngine.Scenes;

settings { title = "Bounce"; tickRate = 30; maxPlayers = 8; }

scene Main { }

component Spinner
{
    float speed = 1;
}

// Bonus.unity's entities, while a player has them: the match loads the scene, and Unity loads it with them
command ShowBonus
{
    bool on;
}

singleton Extras
{
    Entity bonus;
    Entity tossed;
}

// A ball nobody rolls, in and out of the box: a GameObject made and let go of as its entity comes and goes, which
// TideRunner's pool keeps for the next
command Toss
{
    bool on;
}

command(Toss toss, PlayerID sender) Tossing(mut Extras extras)
{
    if (toss.on && extras.tossed == default)
    {
        extras.tossed = Spawn(Roller, Ball { color = Color(1, 1, 1), seat = -1 }, Transform { localPosition = float3(0, 3, 0) });
    }
    if (!toss.on && extras.tossed != default)
    {
        extras.tossed.Destroy();
        extras.tossed = default;
    }
}

command(ShowBonus show, PlayerID sender) Toggle(mut Extras extras)
{
    if (show.on && extras.bonus == default) extras.bonus = Scene.Load(Bonus);
    if (!show.on && extras.bonus != default)
    {
        Scene.Unload(extras.bonus);
        extras.bonus = default;
    }
}

// Bonus's totem stands still: Unity's scenes are Tide's, and a system can leave one's entities out
system Spinning(Spinner spinner, mut Transform transform, Time time, without scene Bonus)
{
    transform.localRotation = Math.Normalize(Math.Mul(quaternion.Euler(0, spinner.speed * time.dt, 0), transform.localRotation));
}

input Roll
{
    [Clamp(-1, 1)] float2 move;
    bool jump;

    Sample(Devices devices)
    {
        var keys = devices.keyboard;
        if (keys.d.pressed || keys.rightArrow.pressed) move.x += 1;
        if (keys.a.pressed || keys.leftArrow.pressed) move.x -= 1;
        if (keys.w.pressed || keys.upArrow.pressed) move.y += 1;
        if (keys.s.pressed || keys.downArrow.pressed) move.y -= 1;
        move += devices.gamepad.leftStick;
        jump = keys.space.pressed || devices.gamepad.buttonSouth.pressed;
    }
}

component Ball
{
    float3 velocity;
    Color color;
    int seat;
    int bounces;
}

singleton Room
{
    int arrivals;
    Map<PlayerID, Entity> balls;
}

event(PlayerJoined joined) Arrive(mut Room room)
{
    var seat = room.arrivals;
    room.arrivals += 1;
    var hue = seat * 0.37 - int(seat * 0.37);
    var color = Color(0.5 + 0.5 * Math.Cos(hue * 6.283), 0.5 + 0.5 * Math.Cos((hue - 0.333) * 6.283), 0.5 + 0.5 * Math.Cos((hue + 0.333) * 6.283));
    room.balls[joined.player] = Spawn(Roller, Ball { color = color, seat = seat },
        Transform { localPosition = float3(seat % 4 * 1.5 - 2.25, 2, seat / 4 * 1.5) }, Owner { player = joined.player });
}

// Tide's own drawing, which Unity draws over its frame (TideRunner's drawTide)
view Hud(Room room)
{
    Draw.Text($"Balls: {room.arrivals}", float2(16, Screen.height - 30), 18, Color(1, 1, 1));
}

event(PlayerLeft left) Depart(mut Room room)
{
    room.balls[left.player].Destroy();
    room.balls.Remove(left.player);
}

system Rolling(Roll roll, mut Ball ball, mut Transform transform, Time time)
{
    mut var p = transform.localPosition;
    ball.velocity.x += roll.move.x * 12 * time.dt;
    ball.velocity.z += roll.move.y * 12 * time.dt;
    ball.velocity.x *= 0.98;
    ball.velocity.z *= 0.98;
    ball.velocity.y -= 20 * time.dt;
    if (roll.jump && p.y <= 0.501) ball.velocity.y = 8;
    p += ball.velocity * time.dt;
    if (p.y < 0.5)
    {
        p.y = 0.5;
        if (ball.velocity.y < -2) ball.bounces += 1;
        ball.velocity.y = -ball.velocity.y * 0.4;
    }
    if (Math.Abs(p.x) > 5) { p.x = Math.Clamp(p.x, -5, 5); ball.velocity.x = -ball.velocity.x * 0.8; }
    if (Math.Abs(p.z) > 5) { p.z = Math.Clamp(p.z, -5, 5); ball.velocity.z = -ball.velocity.z * 0.8; }
    transform.localPosition = p;
    // Rolling along the floor
    var travel = float2(ball.velocity.x, ball.velocity.z) * time.dt * 2;
    transform.localRotation = Math.Normalize(Math.Mul(quaternion.Euler(travel.y, 0, -travel.x), transform.localRotation));
}
