/* The graph editor's board (notes/visual-scripting.md, "The experience: one board"). Unity's own variables carry the
   editor's theme; the board's few colours of its own have a dark and a light value. */

.tg-root {
    --tg-board: #242424;
    --tg-surface: var(--unity-colors-window-background);
    --tg-head: var(--unity-colors-inspector_titlebar-background);
    --tg-border: #161616;
    --tg-line: rgba(255, 255, 255, 0.08);
    --tg-text: var(--unity-colors-default-text);
    --tg-muted: rgba(210, 210, 210, 0.58);
    --tg-faint: rgba(210, 210, 210, 0.34);
    --tg-accent: #58a6ff;
    --tg-accent-soft: rgba(88, 166, 255, 0.16);
    --tg-select: #ffb13b;
    --tg-error: #ff7468;
    --tg-error-soft: rgba(255, 116, 104, 0.14);
    --tg-warning: #f2c24b;
    --tg-ok: #6cc788;
    --tg-frame: rgba(255, 255, 255, 0.035);
    --tg-frame-border: rgba(255, 255, 255, 0.16);
    --tg-space: rgba(120, 170, 255, 0.06);
    --tg-hover: rgba(255, 255, 255, 0.07);
    --tg-data: #2f7d73;
    --tg-behaviour: #5568c9;
    --tg-more: #6b6b72;
    flex-grow: 1;
    color: var(--tg-text);
}

.tg-root.tg-light {
    --tg-board: #b2b2b2;
    --tg-border: #8a8a8a;
    --tg-line: rgba(0, 0, 0, 0.1);
    --tg-muted: rgba(9, 9, 9, 0.62);
    --tg-faint: rgba(9, 9, 9, 0.4);
    --tg-accent: #1565c0;
    --tg-accent-soft: rgba(21, 101, 192, 0.14);
    --tg-select: #c56a00;
    --tg-error: #b3261e;
    --tg-error-soft: rgba(179, 38, 30, 0.12);
    --tg-warning: #8a5a00;
    --tg-ok: #1f7a3d;
    --tg-frame: rgba(255, 255, 255, 0.28);
    --tg-frame-border: rgba(0, 0, 0, 0.3);
    --tg-space: rgba(21, 101, 192, 0.07);
    --tg-hover: rgba(0, 0, 0, 0.07);
}

/* ---- The bar ---- */

.tg-bar {
    flex-direction: row;
    background-color: var(--unity-colors-toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
    flex-shrink: 0;
    height: 28px;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.tg-bar-button {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    margin: 0 2px;
    border-radius: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--tg-text);
}

.tg-bar-button:hover {
    background-color: var(--tg-hover);
}

.tg-bar-button:focus {
    background-color: var(--tg-accent-soft);
}

.tg-bar-button--primary {
    background-color: var(--tg-accent-soft);
}

.tg-bar-button > .tg-icon {
    margin-right: 5px;
}

.tg-bar-button--bare > .tg-icon {
    margin-right: 0;
}

.tg-title {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: var(--tg-muted);
    overflow: hidden;
}

.tg-chip {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 9px 0 7px;
    margin: 0 4px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--tg-line);
    background-color: rgba(0, 0, 0, 0);
}

.tg-chip:hover {
    background-color: var(--tg-hover);
}

.tg-chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 6px;
    background-color: var(--tg-faint);
}

.tg-chip--ok > .tg-chip-dot {
    background-color: var(--tg-ok);
}

.tg-chip--bad {
    border-color: var(--tg-error);
    background-color: var(--tg-error-soft);
}

.tg-chip--bad > .tg-chip-dot {
    background-color: var(--tg-error);
}

.tg-chip--warn > .tg-chip-dot {
    background-color: var(--tg-warning);
}

/* ---- The board ---- */

.tg-board {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--tg-board);
}

.tg-layer {
    position: absolute;
    left: 0;
    top: 0;
}

.tg-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.tg-hint {
    position: absolute;
    left: 12px;
    bottom: 8px;
    color: var(--tg-faint);
    font-size: 11px;
}

.tg-select-box {
    position: absolute;
    background-color: var(--tg-accent-soft);
    border-width: 1px;
    border-color: var(--tg-accent);
}

.tg-muted {
    color: var(--tg-muted);
}

.tg-faint {
    color: var(--tg-faint);
}

.tg-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.tg-icon-button {
    width: 20px;
    height: 20px;
    padding: 3px;
    margin: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--tg-muted);
    flex-shrink: 0;
}

.tg-icon-button:hover {
    background-color: var(--tg-hover);
    color: var(--tg-text);
}

.tg-icon-button:focus {
    background-color: var(--tg-accent-soft);
}

/* What shows only while the pointer is on its row, card or node */
.tg-on-hover {
    opacity: 0;
}

.tg-row:hover .tg-on-hover,
.tg-card-head:hover .tg-on-hover,
.tg-frame-head:hover .tg-on-hover,
.tg-node:hover .tg-on-hover,
.tg-on-hover:focus {
    opacity: 1;
}

/* ---- Text edited where it's drawn ---- */

.tg-inline {
    margin: 0;
    flex-shrink: 1;
    min-width: 30px;
}

.tg-inline > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    padding: 1px 3px;
    border-radius: 3px;
    color: var(--tg-text);
}

.tg-inline:hover > .unity-base-text-field__input {
    border-color: var(--unity-colors-input_field-border);
    background-color: var(--tg-hover);
}

.tg-inline > .unity-base-text-field__input:focus {
    background-color: var(--unity-colors-input_field-background);
    border-color: var(--unity-colors-input_field-border-focus);
}

.tg-inline .unity-base-text-field__input--placeholder {
    color: var(--tg-faint);
}

.tg-inline--title > .unity-base-text-field__input {
    -unity-font-style: bold;
    font-size: 13px;
}

.tg-inline--value > .unity-base-text-field__input {
    background-color: var(--unity-colors-input_field-background);
    border-color: var(--unity-colors-input_field-border);
}

.tg-inline--bad > .unity-base-text-field__input {
    border-color: var(--tg-error);
}

.tg-inline--mono > .unity-base-text-field__input {
    white-space: pre;
}

.tg-text-area {
    margin: 0;
    flex-grow: 1;
}

.tg-text-area > .unity-base-text-field__input {
    white-space: pre-wrap;
    padding: 4px 6px;
    min-height: 44px;
}

/* ---- Small things ---- */

.tg-kind {
    font-size: 10px;
    padding: 1px 7px;
    border-radius: 8px;
    color: #ffffff;
    background-color: var(--tg-more);
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.tg-kind--Data {
    background-color: var(--tg-data);
}

.tg-kind--Behaviour {
    background-color: var(--tg-behaviour);
}

.tg-type {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 7px 0 5px;
    margin: 0 2px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--tg-line);
    background-color: var(--tg-hover);
    flex-shrink: 0;
    max-width: 150px;
}

.tg-type:hover {
    border-color: var(--tg-accent);
}

.tg-type:focus {
    border-color: var(--tg-accent);
    background-color: var(--tg-accent-soft);
}

.tg-type-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 5px;
    flex-shrink: 0;
}

.tg-type > Label {
    padding: 0;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.tg-type--unset > Label {
    color: var(--tg-faint);
    -unity-font-style: italic;
}

.tg-link {
    flex-direction: row;
    align-items: center;
    padding: 1px 6px;
    margin: 0 1px;
    border-radius: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--tg-accent);
}

.tg-link:hover {
    background-color: var(--tg-accent-soft);
}

.tg-link > .tg-icon {
    margin-right: 4px;
}

/* What's in an input: a chip with a name or a path (wobble.phase), in its type's colour; each part is clicked to
   change it from there on. "pick…" where nothing is. */

.tg-value {
    flex-direction: row;
    align-items: center;
    height: 18px;
    padding: 0 5px;
    margin: 1px 2px;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--tg-line);
    background-color: var(--tg-hover);
    flex-shrink: 0;
}

.tg-value:hover {
    background-color: var(--tg-accent-soft);
}

.tg-value.tg-lit {
    background-color: rgba(88, 166, 255, 0.34);
}

.tg-value--title {
    background-color: rgba(0, 0, 0, 0.28);
    margin-left: 4px;
    margin-right: 0;
}

.tg-value--title:hover {
    background-color: rgba(0, 0, 0, 0.45);
}

.tg-seg {
    padding: 0;
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 12px;
    -unity-font-style: bold;
}

.tg-seg:hover {
    background-color: var(--tg-hover);
}

.tg-value--title .tg-seg:hover {
    background-color: rgba(255, 255, 255, 0.18);
}

.tg-seg--none {
    -unity-font-style: italic;
    color: var(--tg-faint);
}

.tg-pick {
    height: 18px;
    padding: 0 7px;
    margin: 1px 2px;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--tg-faint);
    background-color: rgba(0, 0, 0, 0);
    color: var(--tg-muted);
    -unity-font-style: italic;
    font-size: 11px;
    flex-shrink: 0;
}

.tg-pick:hover,
.tg-pick:focus {
    border-color: var(--tg-accent);
    color: var(--tg-accent);
    background-color: var(--tg-accent-soft);
}

.tg-pick--title {
    color: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.5);
    margin-left: 4px;
}

.tg-port-row--problem .tg-pick,
.tg-value.tg-port-row--problem {
    border-color: var(--tg-error);
    color: var(--tg-error);
}

.tg-word.tg-op {
    -unity-font-style: bold;
    color: var(--tg-text);
    border-width: 1px;
    border-color: var(--tg-faint);
    min-width: 22px;
    margin-left: 3px;
    justify-content: center;
}

/* A parameter's row, the node that declares a local and the inputs that read it are lit together */

.tg-entry-row.tg-lit,
.tg-port-row.tg-lit {
    background-color: var(--tg-accent-soft);
}

.tg-link:focus {
    background-color: var(--tg-accent-soft);
}

.tg-word {
    flex-direction: row;
    align-items: center;
    padding: 1px 5px;
    margin: 0 1px;
    border-radius: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--tg-muted);
    flex-shrink: 0;
}

.tg-word:hover {
    background-color: var(--tg-hover);
    color: var(--tg-text);
}

.tg-word:focus {
    background-color: var(--tg-accent-soft);
}

.tg-note {
    color: var(--tg-muted);
    -unity-font-style: italic;
    font-size: 11px;
    white-space: normal;
    padding: 3px 10px 4px 10px;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: upper-left;
}

.tg-note:hover {
    color: var(--tg-text);
}

.tg-tag {
    font-size: 10px;
    padding: 0 6px;
    margin: 1px 2px;
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--tg-line);
    color: var(--tg-muted);
    flex-shrink: 0;
}

.tg-tags {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 0 8px 4px 8px;
}

.tg-problem-text {
    color: var(--tg-error);
    font-size: 11px;
    white-space: normal;
    padding: 1px 10px 3px 10px;
}

.tg-problem-text--warning {
    color: var(--tg-warning);
}

.tg-frame-head .tg-problems {
    flex-shrink: 1;
    overflow: hidden;
}

.tg-frame-head .tg-problem-text {
    white-space: nowrap;
    padding: 0 8px;
}

/* ---- A card: data ---- */

.tg-item {
    position: absolute;
}

.tg-card {
    width: 300px;
    background-color: var(--tg-surface);
    border-width: 1px;
    border-color: var(--tg-border);
    border-radius: 7px;
    padding-bottom: 3px;
}

.tg-item--far {
    align-items: center;
    justify-content: center;
}

.tg-frame.tg-item--far {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 1% 0 0 1%;
}

.tg-far-title {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--tg-text);
}

.tg-card-head {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 4px 0 8px;
    background-color: var(--tg-head);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--tg-line);
}

.tg-card-head > .tg-inline {
    flex-grow: 1;
    margin-left: 4px;
}

.tg-selected {
    border-color: var(--tg-select);
}

.tg-flash {
    border-color: var(--tg-accent);
    border-width: 2px;
}

.tg-has-problem {
    border-color: var(--tg-error);
}

.tg-row {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    padding: 0 4px 0 10px;
}

.tg-row:hover {
    background-color: var(--tg-hover);
}

.tg-row--problem {
    background-color: var(--tg-error-soft);
    border-left-width: 2px;
    border-left-color: var(--tg-error);
    padding-left: 4px;
}

.tg-row--warning {
    border-left-width: 2px;
    border-left-color: var(--tg-warning);
    padding-left: 4px;
}

.tg-row > .tg-inline {
    flex-grow: 1;
    flex-basis: 0;
}

.tg-row-value {
    flex-direction: row;
    align-items: center;
    width: 84px;
    flex-shrink: 0;
    margin-left: 2px;
}

.tg-row-value--wide {
    width: 150px;
}

.tg-row-value .unity-base-field {
    margin: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.tg-row-value .unity-base-text-field__input {
    padding: 1px 3px;
}

.tg-add-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding: 0 8px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--tg-accent);
    -unity-text-align: middle-left;
}

.tg-add-row:hover {
    background-color: var(--tg-accent-soft);
}

.tg-add-row:focus {
    background-color: var(--tg-accent-soft);
}

.tg-add-row > .tg-icon {
    margin-right: 5px;
}

.tg-empty {
    color: var(--tg-faint);
    white-space: normal;
    padding: 6px 10px 2px 10px;
    font-size: 11px;
}

.tg-sub {
    padding-left: 14px;
}

/* ---- A frame: code ---- */

.tg-frame {
    background-color: var(--tg-frame);
    border-width: 1px;
    border-color: var(--tg-frame-border);
    border-radius: 9px;
}

.tg-frame--value {
    background-color: var(--tg-surface);
    border-color: var(--tg-accent);
}

.tg-frame-head {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 6px 0 10px;
}

.tg-frame-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-left: 6px;
    color: var(--tg-text);
}

.tg-frame-head > .tg-inline {
    flex-grow: 0;
    margin-left: 2px;
    min-width: 60px;
}

.tg-frame-hint {
    position: absolute;
    color: var(--tg-faint);
    font-size: 12px;
    -unity-font-style: italic;
}

.tg-space {
    position: absolute;
    background-color: var(--tg-space);
    border-width: 1px;
    border-color: var(--tg-line);
    border-radius: 12px;
}

.tg-space-head {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 10px;
}

/* ---- A node ---- */

.tg-node {
    position: absolute;
    min-width: 110px;
    background-color: var(--tg-surface);
    border-width: 1px;
    border-color: var(--tg-border);
    border-radius: 6px;
}

.tg-node--unreached {
    opacity: 0.45;
}

.tg-node--small {
    min-width: 60px;
}

.tg-node-head {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 0 3px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.tg-node-title {
    flex-grow: 1;
    -unity-font-style: bold;
    color: #ffffff;
    padding: 0 4px;
    margin: 0;
}

.tg-node-head .tg-inline {
    flex-shrink: 0;
}

.tg-node-head .tg-inline > .unity-base-text-field__input {
    color: #ffffff;
    -unity-font-style: bold;
}

.tg-node-dot {
    flex-grow: 0;
    padding: 0 0 0 4px;
}

.tg-node-dot--after {
    padding: 0;
    margin: 0 -2px 0 1px;
}

.tg-node-head .tg-inline > .unity-base-text-field__input:focus {
    color: var(--tg-text);
}

.tg-node-head .tg-icon-button {
    color: rgba(255, 255, 255, 0.75);
}

.tg-node-body {
    padding: 3px 0 4px 0;
}

.tg-node-note {
    position: absolute;
    left: 0;
    bottom: 100%;
    max-width: 360px;
    color: var(--tg-muted);
    -unity-font-style: italic;
    font-size: 11px;
    white-space: normal;
    padding-bottom: 2px;
}

.tg-port-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    padding: 0 2px;
}

.tg-port-row--out {
    justify-content: flex-end;
}

.tg-port-row--problem {
    background-color: var(--tg-error-soft);
}

.tg-port-label {
    font-size: 11px;
    color: var(--tg-muted);
    margin: 0 3px;
    padding: 0;
    flex-shrink: 0;
}

.tg-port {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin: 0 1px;
}

/* While a wire is dragged: the pins it can go to are lit (a ring, and their row), the others dimmed */

.tg-port--cannot {
    opacity: 0.22;
}

.tg-port-row--can {
    background-color: var(--tg-accent-soft);
}

.tg-pin-value {
    flex-direction: row;
    align-items: center;
    max-width: 150px;
    min-width: 34px;
    margin: 0 2px;
}

.tg-pin-value--numbers {
    max-width: 230px;
}

.tg-pin-value--numbers > .tg-inline {
    margin-right: 3px;
}

.tg-pin-value.tg-pin-value--numbers .unity-color-field {
    min-width: 84px;
    width: 84px;
    flex-grow: 0;
    flex-shrink: 0;
}

.tg-pin-value .unity-base-field {
    margin: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.tg-pin-value .unity-base-text-field__input {
    padding: 0 3px;
    font-size: 11px;
}

.tg-node-field {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    padding: 0 6px;
}

.tg-node-field > .tg-inline {
    flex-grow: 1;
}

.tg-node-field .unity-base-popup-field {
    margin: 0;
    flex-grow: 1;
}

.tg-node-add {
    font-size: 11px;
    min-height: 20px;
    padding: 0 8px;
}

.tg-node-problem {
    position: absolute;
    left: 0;
    top: 100%;
    max-width: 320px;
    min-width: 140px;
    margin-top: 3px;
    padding: 2px 6px;
    border-radius: 4px;
    border-left-width: 2px;
    border-left-color: var(--tg-error);
    background-color: var(--tg-surface);
    color: var(--tg-error);
    font-size: 11px;
    white-space: normal;
}

.tg-node-problem--warning {
    border-left-color: var(--tg-warning);
    color: var(--tg-warning);
}

/* The entry of a frame: what its code takes */
.tg-entry {
    min-width: 230px;
}

.tg-entry-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding: 0 2px 0 6px;
}

.tg-entry-row:hover {
    background-color: var(--tg-hover);
}

.tg-entry-row:hover .tg-on-hover {
    opacity: 1;
}

.tg-entry-row > .tg-inline {
    flex-grow: 1;
}

.tg-entry-result {
    border-top-width: 1px;
    border-top-color: var(--tg-line);
    margin-top: 2px;
}

/* ---- Popups ---- */

.tg-shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.tg-popup {
    position: absolute;
    background-color: var(--tg-surface);
    border-width: 1px;
    border-color: var(--tg-border);
    border-radius: 7px;
    padding: 4px 0;
}

.tg-popup-head {
    padding: 4px 10px 2px 10px;
    -unity-font-style: bold;
}

.tg-popup-help {
    padding: 0 10px 4px 10px;
    color: var(--tg-muted);
    font-size: 11px;
    white-space: normal;
}

.tg-search {
    margin: 4px 6px 4px 6px;
}

.tg-search > .unity-base-text-field__input {
    padding: 3px 6px;
    border-radius: 4px;
}

.tg-section {
    flex-direction: row;
    align-items: flex-end;
    padding: 6px 10px 2px 10px;
}

.tg-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--tg-muted);
    padding: 0;
    margin: 0;
}

.tg-section-summary {
    font-size: 10px;
    color: var(--tg-faint);
    margin-left: 6px;
    padding: 0;
}

.tg-option {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    padding: 1px 10px;
}

.tg-option:hover {
    background-color: var(--tg-hover);
}

.tg-option--current {
    background-color: var(--unity-colors-highlight-background);
}

.tg-option--current .tg-option-title {
    color: #ffffff;
}

.tg-option--current .tg-option-detail {
    color: rgba(255, 255, 255, 0.78);
}

.tg-option--off {
    opacity: 0.45;
}

.tg-option-title {
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.tg-option-detail {
    padding: 0;
    margin: 0 0 0 8px;
    font-size: 11px;
    color: var(--tg-muted);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tg-option--tall {
    flex-direction: column;
    align-items: flex-start;
    padding: 4px 10px;
}

.tg-option--tall > .tg-option-detail {
    margin: 1px 0 0 0;
    white-space: normal;
}

.tg-option-check {
    width: 16px;
    flex-shrink: 0;
}

.tg-separator {
    height: 1px;
    margin: 4px 0;
    background-color: var(--tg-line);
}

/* ---- The start ---- */

.tg-start {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.tg-start-title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.tg-start-sub {
    color: var(--tg-muted);
    margin-bottom: 18px;
}

.tg-tiles {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 720px;
}

.tg-tile {
    width: 220px;
    min-height: 84px;
    margin: 6px;
    padding: 10px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--tg-border);
    background-color: var(--tg-surface);
    align-items: flex-start;
    justify-content: flex-start;
    white-space: normal;
}

.tg-tile:hover {
    border-color: var(--tg-accent);
    background-color: var(--tg-surface);
}

.tg-tile:focus {
    border-color: var(--tg-accent);
    background-color: var(--tg-accent-soft);
}

.tg-tile-title {
    font-size: 14px;
    -unity-font-style: bold;
    padding: 0;
    margin: 4px 0 3px 0;
    color: var(--tg-text);
}

.tg-tile-summary {
    color: var(--tg-muted);
    white-space: normal;
    padding: 0;
    margin: 0;
    -unity-text-align: upper-left;
}

/* ---- Panels at the board's sides ---- */

.tg-side {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: var(--tg-surface);
    border-color: var(--tg-border);
}

.tg-side--left {
    left: 0;
    width: 260px;
    border-right-width: 1px;
}

.tg-side--right {
    right: 0;
    width: 440px;
    border-left-width: 1px;
}

.tg-side-head {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 4px 0 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--tg-line);
    flex-shrink: 0;
}

.tg-side-title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.tg-tide {
    padding: 8px 10px;
    white-space: pre;
}

.tg-toast {
    position: absolute;
    bottom: 34px;
    align-self: center;
    max-width: 560px;
    padding: 6px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--tg-border);
    background-color: var(--tg-surface);
    white-space: normal;
}

.tg-toast--bad {
    border-color: var(--tg-error);
}

.tg-banner {
    flex-shrink: 0;
    padding: 6px 10px;
    white-space: normal;
    background-color: var(--tg-error-soft);
    border-bottom-width: 1px;
    border-bottom-color: var(--tg-error);
}

/* ---- Round three: names, selected rows, docked panels ---- */

/* A name: its text, which drags what it names; a double click makes it a field */
.tg-name {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 16px;
    overflow: hidden;
}

.tg-name-text {
    padding: 1px 3px;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--tg-text);
}

.tg-name > .tg-inline {
    flex-grow: 1;
    min-width: 80px;
}

.tg-name.tg-inline--title > .tg-name-text {
    -unity-font-style: bold;
    font-size: 13px;
}

.tg-name--empty > .tg-name-text {
    color: var(--tg-faint);
    -unity-font-style: italic;
}

.tg-node-head .tg-name-text {
    color: #ffffff;
    -unity-font-style: bold;
}

.tg-card-head > .tg-name {
    margin-left: 6px;
}

.tg-frame-head > .tg-name {
    margin-left: 4px;
}

.tg-row--selected,
.tg-row--selected:hover {
    background-color: var(--tg-accent-soft);
}

.tg-entry-row.tg-row--selected {
    background-color: var(--tg-accent-soft);
}

.tg-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.tg-board-area {
    overflow: hidden;
}

.tg-dock {
    flex-shrink: 0;
    background-color: var(--tg-surface);
    border-color: var(--tg-border);
}

.tg-dock--left {
    width: 250px;
    border-right-width: 1px;
}

.tg-dock--right {
    width: 300px;
    border-left-width: 1px;
}

.tg-dock-body {
    padding-bottom: 12px;
}

/* Details */

.tg-details-head {
    flex-direction: row;
    align-items: center;
    padding: 10px 10px 2px 10px;
}

.tg-details-line {
    padding: 4px 10px;
}

.tg-details-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.tg-details-label {
    width: 86px;
    flex-shrink: 0;
    color: var(--tg-muted);
    font-size: 11px;
    padding: 0;
    margin: 0;
    white-space: normal;
}

.tg-details-line > .tg-details-label {
    width: auto;
    margin-bottom: 3px;
}

.tg-details-help {
    color: var(--tg-faint);
    font-size: 11px;
    white-space: normal;
    padding: 2px 10px 0 10px;
    margin: 0;
}

.tg-details-line .tg-details-help {
    padding: 2px 0 0 0;
}

.tg-details-help--tick {
    padding: 0 0 0 20px;
}

.tg-details-tick {
    padding: 4px 10px;
}

.tg-details-toggle {
    margin: 0;
}

.tg-details-toggle > .unity-toggle__input {
    flex-grow: 1;
}

.tg-details-toggle .unity-toggle__text {
    margin-left: 4px;
}

.tg-dock .unity-base-text-field__input--placeholder,
.tg-dock .unity-text-element--placeholder {
    color: var(--tg-faint);
}

.tg-details-value > .tg-link {
    white-space: nowrap;
    flex-shrink: 0;
}

.tg-details-line > .tg-details-text {
    margin-top: 4px;
}

.tg-details-text {
    margin: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.tg-details-value {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.tg-details-value > .tg-row-value {
    width: 110px;
}

.tg-details-advanced {
    margin: 6px 4px 0 4px;
}

.tg-details-advanced > .unity-foldout__content {
    margin-left: 0;
}

.tg-details-advanced .tg-details-tick,
.tg-details-advanced .tg-details-line {
    padding-left: 6px;
}

.tg-dock-body .tg-text-area {
    margin-top: 2px;
}

.tg-dock-body .tg-link {
    align-self: flex-start;
    margin: 4px 8px;
}

.tg-dock-body .tg-tags {
    padding: 0;
}

/* My game */

.tg-mine-group {
    align-items: center;
    padding: 8px 4px 2px 10px;
}

.tg-mine-row {
    min-height: 24px;
}

.tg-mine-row.tg-lit {
    background-color: var(--tg-accent-soft);
}

.tg-mine-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--tg-more);
}

.tg-mine-dot--Data {
    background-color: var(--tg-data);
}

.tg-mine-dot--Behaviour {
    background-color: var(--tg-behaviour);
}

.tg-mine-space {
    margin: 0;
}

.tg-mine-ghost {
    position: absolute;
    padding: 3px 8px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--tg-accent);
    background-color: var(--tg-surface);
    color: var(--tg-text);
}

.tg-empty--card {
    padding-bottom: 6px;
}

/* An add row on a node or an entry: as wide as its words, so the space beside it drags what it's on */
.tg-add-row--compact {
    align-self: flex-start;
    border-radius: 4px;
    margin: 2px 4px;
    min-height: 22px;
    padding: 0 6px;
}
