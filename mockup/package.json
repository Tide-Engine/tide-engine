{
  "name": "mockup-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "node scripts/bundle.mjs && node --env-file-if-exists=.env index.mjs",
    "start": "node --env-file-if-exists=.env index.mjs",
    "build": "node scripts/bundle.mjs && node --env-file-if-exists=.env scripts/prepare-starter.mjs && node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:starter": "node --env-file-if-exists=.env scripts/test-starter.mjs"
  },
  "dependencies": {
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
