# Local development. Copy to .env; secrets stay on the server.
HOST=127.0.0.1
PORT=4173
PREVIEW_PORT=4174
# Passwordless sign-in. Configure at least one provider to allow sign-in.
# Register a Web application with each provider you enable.
# Callback URLs: <application origin>/api/auth/google/callback and /api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# On public HTTPS deployments, set the exact application and isolated preview origins.
# MOCKUP_PUBLIC_ORIGIN=https://mockup.games
# MOCKUP_PREVIEW_ORIGIN=https://preview.mockup.games
# MOCKUP_SECURE_COOKIES=1
# Install Tide and set this only if it is not on PATH.
# TIDE_BIN=C:/Users/you/AppData/Local/Tide/bin/tide.exe
# Generation is disabled until a key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional owner email allowlist; this narrows explicit admin grants only.
# Sign in socially, stop the service, then grant the admin flag with scripts/admin.mjs.
MOCKUP_ADMIN_EMAILS=
# Your contracted USD rates per million tokens. All three are required for cost estimates.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# Public deployments need isolated build workers and a TURN service first.
# MOCKUP_ICE_SERVERS=[{"urls":"turn:your-server","username":"...","credential":"..."}]
